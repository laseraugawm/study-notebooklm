{
  "title": "\uad6d\uc81c\uacbd\uc81c \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uad6d\uc81c \ubb34\uc5ed\uc758 \ud750\ub984 \ubc0f \uad00\ub828 \uac1c\ub150\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc138\uacc4 \ubb34\uc5ed \uae30\uad6c(WTO)\ub294 \ubb34\uc5ed \uaddc\uc81c\ub97c \uc644\ud654\ud558\uc5ec \uad6d\uc81c \ubb34\uc5ed\uc758 \uaddc\ubaa8\ub97c \ud06c\uac8c \ud655\ub300\ud558\ub294 \ub370 \uae30\uc5ec\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc138\uacc4 \ubb34\uc5ed \uae30\uad6c(WTO)\ub294 \uc790\uc720 \ubb34\uc5ed\uc758 \uc2e4\ud604\uc744 \ubaa9\ud45c\ub85c \uc124\ub9bd\ub418\uc5b4 \ubb34\uc5ed \uaddc\uc81c\ub97c \uc644\ud654\ud558\uace0 \uad6d\uc81c \uad50\uc5ed \uc99d\uc9c4\uc5d0 \uae30\uc5ec\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uacbd\uc81c \ube14\ub85d\uc740 \ube44\ud68c\uc6d0\uad6d\uc5d0\uac8c\ub3c4 \ud68c\uc6d0\uad6d\uacfc \ub3d9\uc77c\ud55c \uacbd\uc81c\uc801 \ud61c\ud0dd\uc744 \uc81c\uacf5\ud558\ub294 \uac1c\ubc29\uc801 \uacbd\uc81c\uad8c\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacbd\uc81c \ube14\ub85d\uc740 \ud68c\uc6d0\uad6d \uac04\uc5d0\ub294 \ud61c\ud0dd\uc744 \uc8fc\uace0\ubc1b\uc9c0\ub9cc \ube44\ud68c\uc6d0\uad6d\uc5d0\ub294 \ud61c\ud0dd\uc744 \uc8fc\uc9c0 \uc54a\ub294 \ubc30\ud0c0\uc801 \uc131\uaca9\uc758 \uacbd\uc81c\uad8c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ube44\uad00\uc138 \uc7a5\ubcbd\uc774\ub780 \uc218\uc785 \uc0c1\ud488\uc758 \uac00\uaca9\uc5d0 \ubd80\uacfc\ud558\ub294 \uc138\uae08\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc785 \uc0c1\ud488\uc5d0 \ubd80\uacfc\ud558\ub294 \uc138\uae08\uc740 \uad00\uc138\uc774\uba70, \ube44\uad00\uc138 \uc7a5\ubcbd\uc740 \uc218\uc785 \ud560\ub2f9\uc81c, \uc218\ucd9c \ubcf4\uc870\uae08 \uc9c0\uae09 \ub4f1 \uad00\uc138 \uc774\uc678\uc758 \ubb34\uc5ed \uc7a5\ubcbd\uc744 \ub73b\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc5ed\uc8fc\uc758 \ud750\ub984\uc740 \uad6d\uac00 \uac04 \uacbd\uc81c\uc801 \uc0c1\ud638 \uc758\uc874 \uad00\uacc4\ub97c \uc57d\ud654\uc2dc\ud0a4\ub294 \uc694\uc778\uc73c\ub85c \uc791\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uc5ed\uc8fc\uc758\ub294 \uc790\uc720 \ubb34\uc5ed \ud611\uc815(FTA) \uccb4\uacb0 \ub4f1\uc744 \ud1b5\ud574 \uad6d\uac00 \uac04 \uac70\ub798 \uc7a5\ubcbd\uc744 \uc644\ud654\ud558\ubbc0\ub85c \uacbd\uc81c\uc801 \uc0c1\ud638 \uc758\uc874 \uad00\uacc4\ub97c \ub354\uc6b1 \uac15\ud654\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "WTO, \uacbd\uc81c \ube14\ub85d, \ube44\uad00\uc138 \uc7a5\ubcbd \ub4f1\uc758 \uc815\ud655\ud55c \uc815\uc758\uc640 \uc5ed\ud560\uc744 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \ub2ec\uc131\ud558\uae30 \uc704\ud574 \uad6d\uc81c \ubb34\uc5ed\uc774 \ub098\uc544\uac00\uc57c \ud560 \ubc29\uc548\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc120\uc9c4\uad6d\uc740 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc774 \ud63c\uc790\uc758 \ud798\uc73c\ub85c \uacbd\uc81c \uc790\ub9bd\uc744 \uc774\ub8f0 \uc218 \uc788\ub3c4\ub85d \uae30\uc220 \uc9c0\uc6d0\uc744 \ucd95\uc18c\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \ud63c\uc790 \ud798\uc73c\ub85c \ud601\uc2e0\uc801\uc778 \uae30\uc220\uc744 \uac1c\ubc1c\ud558\uae30 \uc5b4\ub824\uc6b0\ubbc0\ub85c \uc120\uc9c4\uad6d\uc774 \uae30\uc220 \ubc1c\uc804\uc744 \uc9c0\uc6d0\ud558\uc5ec \uad6d\uac00 \uac04 \ubd88\ud3c9\ub4f1\uc744 \uc644\ud654\ud574\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud658\uacbd\uce5c\ud654\uc801\uc778 \uc0c1\ud488\uc744 \uac1c\ubc1c\ud558\uc5ec \uad50\uc5ed\ud568\uc73c\ub85c\uc368 \uc790\uc6d0 \uc808\uc57d\uacfc \ud658\uacbd \ubcf4\ud638\ub97c \ub3d9\uc2dc\uc5d0 \ub2ec\uc131\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud658\uacbd\uce5c\ud654\uc801 \uc0c1\ud488\uc758 \uc0dd\uc0b0 \ubc0f \uad50\uc5ed\uc740 \uc9c0\uc18d\uac00\ub2a5\ud55c \uc18c\ube44\uc640 \uc0dd\uc0b0\uc744 \ucd09\uc9c4\ud558\ub294 \uc62c\ubc14\ub978 \ubc29\uc548\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uc81c \ubb34\uc5ed\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ud61c\ud0dd\uc744 \uae30\uc5c5\ubfd0\ub9cc \uc544\ub2c8\ub77c \ub178\ub3d9\uc790, \uc9c0\uc5ed \uc0ac\ud68c\uc640\ub3c4 \uacf5\uc720\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub178\ub3d9\uc790\uc758 \uad8c\ub9ac\uc640 \uc801\uc815 \uc784\uae08 \ubcf4\uc7a5, \uc9c0\uc5ed \uc0ac\ud68c \uc790\uc6d0 \ud65c\uc6a9 \ub4f1 \ubb34\uc5ed \ud61c\ud0dd\uc758 \uad11\ubc94\uc704\ud55c \uacf5\uc720\ub294 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uc81c \uc0ac\ud68c\uac00 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \uc704\ud55c \ud611\uc815\uc744 \uccb4\uacb0\ud558\uace0 \uc774\ub97c \uc2e4\uc9c8\uc801\uc73c\ub85c \uc774\ud589\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\uc81c\uc801 \uc57d\uc18d\uc744 \uc2e4\uc81c \uc2e4\ud589\ud558\uace0 \uc774\ud589\ud558\ub294 \uad6d\uc81c \ud611\ub825\uc774 \ub4a4\ub530\ub77c\uc57c \uc6d0\ud558\ub294 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804 \uc131\uacfc\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d \uac04\uc758 \uae30\uc220 \uaca9\ucc28 \uc644\ud654 \ubc0f \uc9c0\uc6d0\uc758 \ud544\uc694\uc131\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc720\ub7fd \uc5f0\ud569(EU)\uc774 \ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4(CBAM)\ub97c \ub3c4\uc785\ud558\uaca0\ub2e4\uace0 \ubc1c\ud45c\ud558\uc600\uc744 \ub54c, \uc8fc\uc694 \uac1c\ubc1c\ub3c4\uc0c1\uad6d \ubc0f \ud0c4\uc18c \ubc30\ucd9c \uc0c1\uc704 \uad6d\uac00\uc9c0\uc5ed\ub4e4\uc774 \uac70\uc138\uac8c \ubc18\ubc1c\ud55c \ud575\uc2ec \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4\uac00 \uc790\uad6d \uc0b0\uc5c5\uc744 \ubcf4\ud638\ud558\ub824\ub294 '\uc2e0\ubcf4\ud638 \ubb34\uc5ed\uc8fc\uc758' \uc870\uce58\uc5d0 \ud574\ub2f9\ud55c\ub2e4\uace0 \ubcf4\uc558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc218\uc785\ud488\uc758 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc5d0 \uad00\uc138\ub97c \ubd80\uacfc\ud558\ub294 \uc870\uce58\uac00 \uc790\uad6d \uc0b0\uc5c5 \ubcf4\ud638\ub97c \uc704\ud55c \ub610 \ub2e4\ub978 \ubb34\uc5ed \uc7a5\ubcbd(\uc2e0\ubcf4\ud638\uc8fc\uc758)\uc73c\ub85c \uc791\uc6a9\ud55c\ub2e4\uace0 \ud310\ub2e8\ud558\uc600\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc720\ub7fd \uc5f0\ud569\uc774 \ubaa8\ub4e0 \uc790\uc720 \ubb34\uc5ed \ud611\uc815(FTA)\uc744 \uc77c\uad04 \ud30c\uae30\ud558\uaca0\ub2e4\uace0 \uc120\uc5b8\ud558\uc600\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "CBAM \ub17c\uc7c1\uc740 \uc218\uc785\ud488\uc5d0 \ub300\ud55c \ud0c4\uc18c \ubc30\ucd9c\ub7c9 \uad00\uc138 \ubd80\uacfc\uc5d0 \uad00\ud55c \uac83\uc774\uc9c0 FTA \uc77c\uad04 \ud30c\uae30\uc640\ub294 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \ubaa8\ub4e0 \uce5c\ud658\uacbd \uae30\uc220 \uc218\ucd9c\uc5d0 \ubcf4\uc870\uae08\uc744 \uc9c0\uae09\ud558\uae30\ub85c \ud569\uc758\ud558\uc600\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \uaddc\uc81c\uc640 \uad00\uc138 \ubd80\uacfc\uc5d0 \ubc18\ubc1c\ud55c \uac83\uc774\uba70, \ubcf4\uc870\uae08 \uc9c0\uae09 \ud569\uc758\uc5d0 \ub300\ud55c \ubc18\ubc1c\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4 \ubb34\uc5ed \uae30\uad6c(WTO)\uac00 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \ub192\uc740 \uad6d\uac00\uc5d0\ub9cc \ubb34\uc5ed \ud61c\ud0dd\uc744 \uc8fc\uae30\ub85c \uacb0\uc815\ud558\uc600\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "WTO\ub294 \ud0c4\uc18c \ubc30\ucd9c\uad6d\uc5d0 \ud61c\ud0dd\uc744 \ubd80\uc5ec\ud55c \uc801\uc774 \uc5c6\uc73c\uba70, \ubc30\ucd9c \uc0c1\uc704\uad6d\ub4e4\uc774 \ubc18\ubc1c\ud558\uc5ec WTO \uc9d1\ub2e8 \uc81c\uc18c\ub97c \uc900\ube44\ud558\ub294 \uc0c1\ud669\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud658\uacbd \uaddc\uc81c\uac00 \ub610 \ub2e4\ub978 \ubb34\uc5ed \uc7a5\ubcbd\uc73c\ub85c \uc791\uc6a9\ud55c\ub2e4\uace0 \ubcf4\ub294 \uc2dc\uac01\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "2023\ub144 \uc81c28\ucc28 \uad6d\uc81c \uc5f0\ud569(UN) \uae30\ud6c4\ubcc0\ud654 \ud611\uc57d \ub2f9\uc0ac\uad6d \ucd1d\ud68c(COP28)\uc5d0\uc11c \uacf5\uc2dd \ud0c0\uacb0\ub41c \uac00\uc7a5 \ud070 \uc131\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uae30\ud6c4 \uc7ac\ub09c\uc5d0 \ub530\ub978 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \ud53c\ud574\ub97c \ubcf4\uc0c1\ud558\uae30 \uc704\ud55c '\uc190\uc2e4\uacfc \ud53c\ud574 \uae30\uae08'\uc758 \uc138\ubd80 \uc2dc\ud589\uc548 \ud569\uc758",
          "isCorrect": true,
          "rationale": "COP28\uc5d0\uc11c\ub294 \uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d \uac04 \uc774\uacac\uc774 \uc788\uc5c8\ub358 '\uc190\uc2e4\uacfc \ud53c\ud574 \uae30\uae08'\uc758 \uc138\ubd80 \uc2dc\ud589\uc548\uc5d0 \ucd5c\uc885 \ud569\uc758\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4 \ubb34\uc5ed \uae30\uad6c(WTO)\uc758 \uc804\uba74 \ud574\uccb4 \ubc0f \uc0c8\ub85c\uc6b4 \ubc30\ud0c0\uc801 \uacbd\uc81c \ube14\ub85d \uacb0\uc131",
          "isCorrect": false,
          "rationale": "UN \uae30\ud6c4\ubcc0\ud654\ud611\uc57d \ub2f9\uc0ac\uad6d \ucd1d\ud68c(COP28)\ub294 \uae30\ud6c4\ubcc0\ud654 \ub300\uc751\uc744 \uc704\ud55c \ud68c\uc758\uc774\uba70 WTO \ud574\uccb4\uc640\ub294 \ubb34\uad00\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \uad6d\uac00 \uac04 \uad00\uc138 \ubc0f \ube44\uad00\uc138 \uc7a5\ubcbd\uc758 \uc804\uba74\uc801\uc778 \uc989\uc2dc \ucca0\ud3d0",
          "isCorrect": false,
          "rationale": "\ubb34\uc5ed \uc7a5\ubcbd \uc804\uba74 \ucca0\ud3d0\ub294 COP28\uc758 \uc131\uacfc\uac00 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\ud50c\ub77c\uc2a4\ud2f1\uc138\uc758 \uc804 \uc138\uacc4 \ub3d9\uc2dc \uc9d1\ud589 \ubc0f \ubcf4\ubcf5 \uad00\uc138 \ud569\uc758",
          "isCorrect": false,
          "rationale": "\ud50c\ub77c\uc2a4\ud2f1\uc138\ub294 EU \ub4f1 \uc77c\ubd80 \uc9c0\uc5ed \uc815\ucc45\uc774\uba70 COP28\uc758 \uc8fc\uc694 \ud0c0\uacb0 \uc131\uacfc\uac00 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\uae30\ud6c4 \uc7ac\ub09c\uc73c\ub85c \ud53c\ud574\ub97c \uc785\uc740 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc5d0 \ub300\ud55c \uae08\uc804\uc801 \ubcf4\uc0c1 \uae30\uae08 \uccb4\uacc4\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc790\ubcf8\uc8fc\uc758\uc758 \uc5ed\uc0ac\uc801 \uc804\uac1c \uacfc\uc815 \uc911 1929\ub144 '\uac80\uc740 \ubaa9\uc694\uc77c' \uc8fc\uac00 \ud3ed\ub77d\uc5d0\uc11c \uc2dc\uc791\ub41c \ub300\uacf5\ud669\uc758 \uc5ec\ud30c\ub85c \ud655\ub9bd\ub41c \uacbd\uc81c \uccb4\uc81c \uc720\ud615\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc218\uc815 \uc790\ubcf8\uc8fc\uc758",
          "isCorrect": true,
          "rationale": "\ub300\uacf5\ud669 \uadf9\ubcf5 \uacfc\uc815\uc5d0\uc11c \uc2dc\uc7a5\uc758 \ud55c\uacc4\ub97c \ubcf4\uc644\ud558\uae30 \uc704\ud574 \uc815\ubd80\uc758 \uc2dc\uc7a5 \uac1c\uc785\uc744 \uc778\uc815\ud558\ub294 \uc218\uc815 \uc790\ubcf8\uc8fc\uc758\uac00 \ub4f1\uc7a5\ud558\uc600\uc2b5\ub2c8\ub2e4."
