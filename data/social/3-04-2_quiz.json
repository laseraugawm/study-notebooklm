        {
          "text": "\uc0c1\uc5c5 \uc790\ubcf8\uc8fc\uc758",
          "isCorrect": false,
          "rationale": "\uc0c1\uc5c5 \uc790\ubcf8\uc8fc\uc758\ub294 \uc790\ubcf8\uc8fc\uc758 \ubc1c\uc804 \ucd08\uae30(\uc808\ub300\uc655\uc815 \uc2dc\uae30 \ubb34\uc5ed \uc911\uc2ec) \ub2e8\uacc4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e0\uc790\uc720\uc8fc\uc758",
          "isCorrect": false,
          "rationale": "\uc2e0\uc790\uc720\uc8fc\uc758\ub294 1970\ub144\ub300 \uc815\ubd80 \uc2e4\ud328 \ubc0f \uc11d\uc720 \ud30c\ub3d9 \uc774\ud6c4 \uc815\ubd80 \uac1c\uc785 \ucd95\uc18c\ub97c \uc8fc\uc7a5\ud558\uba70 \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc21c\uc218 \uacc4\ud68d\uacbd\uc81c \uccb4\uc81c",
          "isCorrect": false,
          "rationale": "\ub300\uacf5\ud669 \uc774\ud6c4 \uc11c\uad6c \uc790\ubcf8\uc8fc\uc758 \uc0ac\ud68c\ub294 \ud63c\ud569\uacbd\uc81c/\uc218\uc815 \uc790\ubcf8\uc8fc\uc758\ub97c \ub3c4\uc785\ud558\uc600\uc9c0 \uc804\uba74\uc801\uc778 \uacc4\ud68d\uacbd\uc81c\ub85c \uc804\ud658\ud55c \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc790\uc720\ubc29\uc784\uc8fc\uc758\uc801 \uc2dc\uc7a5\uacbd\uc81c\ub97c \ub118\uc5b4 \uc815\ubd80\uac00 \uc2dc\uc7a5\uc5d0 \uc801\uadf9\uc801\uc73c\ub85c \uac1c\uc785\ud558\uac8c \ub41c \uacc4\uae30\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uacbd\uc81c\ud559\uc790 \ucf00\uc778\uc2a4\uac00 \uc9c4\ub2e8\ud55c 1929\ub144 \ub300\uacf5\ud669\uc758 \uc8fc\uc694 \uc6d0\uc778\uacfc \uc774\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \ub098\ud0c0\ub09c \uc815\ubd80\uc758 \uc815\ucc45\uc801 \ubcc0\ud654\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc6d0\uc778: \uc18c\ube44 \uac10\uc18c\uc5d0 \ub530\ub978 \uc720\ud6a8 \uc218\uc694 \ubd80\uc871 / \ubcc0\ud654: \uc815\ubd80\uc758 \uc2dc\uc7a5 \uac1c\uc785 \ud5c8\uc6a9 \ubc0f \uc0ac\ud68c \ubcf4\uc7a5 \uc81c\ub3c4 \uac15\ud654",
          "isCorrect": true,
          "rationale": "\ucf00\uc778\uc2a4\ub294 \ub178\ub3d9\uc790 \uc784\uae08 \ubbf8\uc0c1\uc2b9\uacfc \uc18c\ube44 \uac10\uc18c\ub85c \uc778\ud55c \uc720\ud6a8 \uc218\uc694 \ubd80\uc871\uc744 \ub300\uacf5\ud669 \uc6d0\uc778\uc73c\ub85c \ubcf4\uc558\uace0, \uc815\ubd80\uc758 \uc801\uadf9\uc801 \uc2dc\uc7a5 \uac1c\uc785\uacfc \uc0ac\ud68c \ubcf4\uc7a5\uc81c \uac15\ud654\ub97c \ud574\uacb0\ucc45\uc73c\ub85c \uc81c\uc2dc\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc6d0\uc778: \uc815\ubd80\uc758 \uacfc\ub3c4\ud55c \uc2dc\uc7a5 \uaddc\uc81c / \ubcc0\ud654: \uacf5\uae30\uc5c5 \ubbfc\uc601\ud654 \ubc0f \uc138\uae08 \uac10\uba74",
          "isCorrect": false,
          "rationale": "\uc815\ubd80 \uac1c\uc785 \uc904\uc774\uae30\uc640 \uacf5\uae30\uc5c5 \ubbfc\uc601\ud654\ub294 \ub300\uacf5\ud669 \uadf9\ubcf5\uc774 \uc544\ub2cc \uc2e0\uc790\uc720\uc8fc\uc758\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc6d0\uc778: \ud658\uacbd \uc624\uc5fc \uc2ec\ud654 / \ubcc0\ud654: \ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4\uc758 \uc804 \uc138\uacc4\uc801 \ub3c4\uc785",
          "isCorrect": false,
          "rationale": "\ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4\ub294 \ucd5c\uadfc\uc758 \ud658\uacbd-\ubb34\uc5ed \uc774\uc288\uc774\uba70 \ub300\uacf5\ud669 \uc9c4\ub2e8 \ub0b4\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\uc6d0\uc778: \uad6d\uac00 \uac04 \uc790\uc720 \ubb34\uc5ed \ud611\uc815(FTA) \uacfc\ub2e4 \uccb4\uacb0 / \ubcc0\ud654: \ubaa8\ub4e0 \ubb34\uc5ed\uc758 \uc644\uc804 \uae08\uc9c0",
          "isCorrect": false,
          "rationale": "\ub300\uacf5\ud669\uc758 \uc6d0\uc778\uc740 \uc218\uc694 \ubd80\uc871 \ubb38\uc81c\uc600\uc73c\uba70 \ubb34\uc5ed \uc804\uba74 \uae08\uc9c0\ub85c \ud574\uacb0\ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0dd\uc0b0\ub7c9\uc5d0 \ube44\ud574 \ud131\uc5c6\uc774 \ubd80\uc871\ud588\ub358 \uc18c\ube44(\uc218\uc694) \uce21\uba74\uacfc \ub274\ub51c \uc815\ucc45 \uac19\uc740 \uc815\ubd80 \uc5ed\ud560\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc790\uc0b0 \uad00\ub9ac\uc758 3\ub300 \uc6d0\uce59(\uc218\uc775\uc131, \uc548\uc804\uc131, \uc720\ub3d9\uc131) \ubc0f \uae08\uc735 \uc790\uc0b0\uc758 \ud2b9\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud604\uc2e4 \uc138\uacc4\uc5d0\ub294 \uc218\uc775\uc131, \uc548\uc804\uc131, \uc720\ub3d9\uc131 \uc138 \uac00\uc9c0\ub97c \ubaa8\ub450 \uc644\ubcbd\ud558\uac8c \ucd5c\uace0 \uc218\uc900\uc73c\ub85c \ub9cc\uc871\ud558\ub294 \ud22c\uc790 \uc790\uc0b0\uc774 \uc874\uc7ac\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc218\uc775\uc131\uc774 \ub192\uc73c\uba74 \uc548\uc804\uc131\uc774 \ub5a8\uc5b4\uc9c0\ub294 \ub4f1 3\ub300 \uc6d0\uce59\uc740 \uc0c1\ucda9 \uad00\uacc4\uc5d0 \uc788\uc73c\ubbc0\ub85c, \uc138 \uac00\uc9c0\ub97c \ubaa8\ub450 \uc644\ubcbd\ud788 \uac16\ucd98 \ub2e8\uc77c \uc790\uc0b0\uc740 \uc874\uc7ac\ud558\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc548\uc804\uc131\uc740 \ud22c\uc790\ud55c \uc790\uc0b0\uc758 \uac00\uce58\uac00 \uc548\uc804\ud558\uac8c \ubcf4\ud638\ub420 \uc218 \uc788\ub294 \uc815\ub3c4\ub97c \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc548\uc804\uc131\uc5d0 \ub300\ud55c \uc62c\ubc14\ub978 \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc720\ub3d9\uc131\uc740 \ud544\uc694\ud560 \ub54c \uc790\uc0b0\uc744 \uc27d\uac8c \ud604\uae08\uc73c\ub85c \ubc14\uafc0 \uc218 \uc788\ub294 \uc815\ub3c4\ub97c \ub73b\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc720\ub3d9\uc131\uc5d0 \ub300\ud55c \uc62c\ubc14\ub978 \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc77c\ubc18\uc801\uc73c\ub85c \uc608\uae08\uc740 \uc8fc\uc2dd\uc5d0 \ube44\ud574 \uc218\uc775\uc131\uc740 \ub0ae\uc9c0\ub9cc \uc548\uc804\uc131\uc774 \ub192\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc608\uae08\uacfc \uc8fc\uc2dd\uc758 \uc0c1\ub300\uc801 \ud2b9\uc131\uc744 \uc62c\ubc14\ub974\uac8c \ube44\uad50\ud55c \uc124\uba85\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub192\uc740 \uc218\uc775\uc744 \uc5bb\uc73c\ub824\uba74 \uadf8\ub9cc\ud07c \uc704\ud5d8(\ub0ae\uc740 \uc548\uc804\uc131)\uc744 \uac10\uc218\ud574\uc57c \ud558\ub294 \uad00\uacc4\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ud45c\ub294 \uac11\uad6d\uacfc \uc744\uad6d\uc774 \ube75\uacfc \uace0\uae30 1\ub2e8\uc704\ub97c \uc0dd\uc0b0\ud558\ub294 \ub370 \ub4dc\ub294 \uc0dd\uc0b0\ube44(\ub2ec\ub7ec)\ub97c \ub098\ud0c0\ub0b8 \uac83\uc774\ub2e4.\n\n| \uad6c\ubd84 | \uac11\uad6d | \uc744\uad6d |\n| --- | --- | --- |\n| \ube75 | 10 | 40 |\n| \uace0\uae30 | 20 | 20 |\n\n\uc774 \uc790\ub8cc\uc5d0 \ub300\ud55c \ubd84\uc11d\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac11\uad6d\uc740 \ube75 \uc0dd\uc0b0\uc5d0 \ube44\uad50 \uc6b0\uc704\uac00 \uc788\uace0, \uc744\uad6d\uc740 \uace0\uae30 \uc0dd\uc0b0\uc5d0 \ube44\uad50 \uc6b0\uc704\uac00 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac11\uad6d\uc758 \ube75 1\ub2e8\uc704 \uae30\ud68c\ube44\uc6a9\uc740 \uace0\uae30 0.5\ub2e8\uc704\ub85c \uc744\uad6d(\uace0\uae30 2\ub2e8\uc704)\ubcf4\ub2e4 \uc791\uace0, \uc744\uad6d\uc758 \uace0\uae30 1\ub2e8\uc704 \uae30\ud68c\ube44\uc6a9\uc740 \ube75 0.5\ub2e8\uc704\ub85c \uac11\uad6d(\ube75 2\ub2e8\uc704)\ubcf4\ub2e4 \uc791\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uac11\uad6d\uc740 \ube75 1\ub2e8\uc704 \uc0dd\uc0b0\uc758 \uae30\ud68c\ube44\uc6a9\uc774 \uace0\uae30 2\ub2e8\uc704\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac11\uad6d\uc758 \ube75 1\ub2e8\uc704 \uae30\ud68c\ube44\uc6a9\uc740 10/20 = \uace0\uae30 0.5\ub2e8\uc704\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc744\uad6d\uc740 \ube75\uacfc \uace0\uae30 \ubaa8\ub450 \uc0dd\uc0b0\ube44\uac00 \ube44\uc2f8\ubbc0\ub85c \uc5b4\ub5a0\ud55c \uc7ac\ud654\uc5d0\ub3c4 \ube44\uad50 \uc6b0\uc704\ub97c \uac16\uc9c0 \ubabb\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc808\ub300 \uc6b0\uc704\uc5d0\uc11c\ub294 \ubaa8\ub450 \uc5f4\uc704\uc5d0 \uc788\ub354\ub77c\ub3c4, \uae30\ud68c\ube44\uc6a9\uc774 \ub354 \uc791\uc740 \uace0\uae30 \uc0dd\uc0b0\uc5d0\uc11c \uc744\uad6d\uc774 \ube44\uad50 \uc6b0\uc704\ub97c \uac00\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc744\uad6d\uc758 \ube75 1\ub2e8\uc704 \uc0dd\uc0b0\uc5d0 \ub300\ud55c \uae30\ud68c\ube44\uc6a9\uc740 \uace0\uae30 0.5\ub2e8\uc704\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc744\uad6d\uc758 \ube75 1\ub2e8\uc704 \uae30\ud68c\ube44\uc6a9\uc740 40/20 = \uace0\uae30 2\ub2e8\uc704\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uae30\ud68c\ube44\uc6a9 = (\ud574\ub2f9 \uc7ac\ud654 \uc0dd\uc0b0\ube44 / \ub2e4\ub978 \uc7ac\ud654 \uc0dd\uc0b0\ube44) \uacf5\uc2dd\uc744 \uc801\uc6a9\ud558\uc5ec \uac01\uad6d\uc758 \uae30\ud68c\ube44\uc6a9\uc744 \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc55e\uc120 \uc790\ub8cc(\ube75 1\ub2e8\uc704 \uc0dd\uc0b0\ube44: \uac11\uad6d 10\ub2ec\ub7ec, \uc744\uad6d 40\ub2ec\ub7ec / \uace0\uae30 1\ub2e8\uc704 \uc0dd\uc0b0\ube44: \uac11\uad6d 20\ub2ec\ub7ec, \uc744\uad6d 20\ub2ec\ub7ec) \uc0c1\ud669\uc5d0\uc11c \ub450 \ub098\ub77c\uac00 \uac01\uc790 \ubb34\uc5ed \uc804\uc5d0\ub294 \ube75 2\ub2e8\uc704, \uace0\uae30 2\ub2e8\uc704\uc529\uc744 \uc18c\ube44\ud558\uace0 \uc788\uc5c8\ub2e4. \uac01\uad6d\uc774 \ube44\uad50 \uc6b0\uc704 \uc7ac\ud654\ub9cc\uc744 \ud2b9\ud654\ud558\uc5ec 4\ub2e8\uc704 \uc0dd\uc0b0\ud55c \ud6c4 \uc0c1\ub300\uad6d\uacfc 2\ub2e8\uc704\uc529 \uad50\ud658\ud560 \ub54c, \uac11\uad6d\uacfc \uc744\uad6d\uc774 \ubb34\uc5ed\uc744 \ud1b5\ud574 \uac01\uac01 \uc5bb\ub294 \uc774\ub4dd(\ube44\uc6a9 \uc808\uac10\uc561)\uc740 \uc5bc\ub9c8\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uac11\uad6d: 20\ub2ec\ub7ec, \uc744\uad6d: 40\ub2ec\ub7ec",
          "isCorrect": true,
          "rationale": "\ubb34\uc5ed \uc804 \ube44\uc6a9: \uac11\uad6d 60\ub2ec\ub7ec(10*2+20*2), \uc744\uad6d 120\ub2ec\ub7ec(40*2+20*2). \ubb34\uc5ed \ud6c4 \ud2b9\ud654 \uc0dd\uc0b0 \ube44\uc6a9: \uac11\uad6d \ube75 4\ub2e8\uc704=40\ub2ec\ub7ec(\uc774\ub4dd 20\ub2ec\ub7ec), \uc744\uad6d \uace0\uae30 4\ub2e8\uc704=80\ub2ec\ub7ec(\uc774\ub4dd 40\ub2ec\ub7ec)\uac00 \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uac11\uad6d: 10\ub2ec\ub7ec, \uc744\uad6d: 20\ub2ec\ub7ec",
          "isCorrect": false,
          "rationale": "\ubb34\uc5ed \uc804\ud6c4\uc758 \ucd1d \uc0dd\uc0b0\ube44 \ucc28\uc774\ub97c \uc798\ubabb \uacc4\uc0b0\ud55c \uacb0\uacfc\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uac11\uad6d: 40\ub2ec\ub7ec, \uc744\uad6d: 20\ub2ec\ub7ec",
          "isCorrect": false,
          "rationale": "\uac11\uad6d\uacfc \uc744\uad6d\uc758 \ubb34\uc5ed \uc774\ub4dd \uc218\uce58\uac00 \uc11c\ub85c \ubc14\ub010 \uc120\ud0dd\uc9c0\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uac11\uad6d: 0\ub2ec\ub7ec, \uc744\uad6d: 60\ub2ec\ub7ec",
          "isCorrect": false,
          "rationale": "\uac11\uad6d \uc5ed\uc2dc \ud2b9\ud654\ub97c \ud1b5\ud574 \uc0dd\uc0b0\ube44\uac00 \uc808\uac10\ub418\ubbc0\ub85c 20\ub2ec\ub7ec\uc758 \ubb34\uc5ed \uc774\ub4dd\uc744 \uc5bb\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubb34\uc5ed \uc804 \ube75 2\ub2e8\uc704+\uace0\uae30 2\ub2e8\uc704\ub97c \ub9cc\ub4e4 \ub54c\uc758 \ucd1d \ube44\uc6a9\uacfc, \ud2b9\ud654 \ud6c4 4\ub2e8\uc704\ub97c \ub9cc\ub4e4 \ub54c\uc758 \ucd1d \ube44\uc6a9\uc744 \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\u2018\uc9c0\uc18d\uac00\ub2a5\ud55c \uc18c\ube44\uc640 \uc0dd\uc0b0\u2019 \uac1c\ub150\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\uc18d\uac00\ub2a5\ud55c \uc18c\ube44\ub294 \uc81c\ud488 \uad6c\ub9e4 \uc2dc \uac00\uaca9\ubfd0 \uc544\ub2c8\ub77c \ud658\uacbd\uacfc \uc0ac\ud68c\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uae4c\uc9c0 \uace0\ub824\ud558\ub294 \uc724\ub9ac\uc801 \uc18c\ube44 \ud65c\ub3d9\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc9c0\uc18d\uac00\ub2a5\ud55c \uc18c\ube44\ub294 \uc0c1\ud488 \uad6c\ub9e4 \ubc0f \uc18c\ube44 \uacfc\uc815\uc5d0\uc11c \ud658\uacbd\uc801\u00b7\uc0ac\ud68c\uc801 \uc601\ud5a5\uc744 \ud568\uaed8 \uace0\ub824\ud558\ub294 \ud589\ub3d9\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc18d\uac00\ub2a5\ud55c \uc0dd\uc0b0\uc774\ub780 \uc0dd\uc0b0 \uacfc\uc815\uc5d0\uc11c\uc758 \ud658\uacbd \uc624\uc5fc \ubc29\uc9c0\ubcf4\ub2e4\ub294 \uc0dd\uc0b0\ub7c9\uc758 \uadf9\ub300\ud654\uc5d0 \uc77c\ucc28\uc801 \ubaa9\uc801\uc744 \ub454\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uc18d\uac00\ub2a5\ud55c \uc0dd\uc0b0\uc740 \uc0c1\ud488 \uc0dd\uc0b0 \uacfc\uc815\uc5d0\uc11c \ud658\uacbd\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \uac83\uc774 \ud575\uc2ec \ubaa9\ud45c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc18d\uac00\ub2a5\ud55c \uc0dd\uc0b0\uc744 \uc704\ud574\uc11c\ub294 \uc81c\ud488 \uc0ac\uc6a9 \ud6c4 \uc7ac\ud65c\uc6a9\uc774 \ubd88\uac00\ub2a5\ud558\ub3c4\ub85d \uc124\uacc4\ud558\ub294 \uac83\uc774 \ud6a8\uc728\uc801\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc81c\ud488 \uc0ac\uc6a9 \ud6c4 \uc7ac\ud65c\uc6a9\uc774 \uac00\ub2a5\ud558\ub3c4\ub85d \uc124\uacc4\ud558\ub294 \uac83\uc774 \uc9c0\uc18d\uac00\ub2a5\ud55c \uc0dd\uc0b0\uc758 \uc911\uc694\ud55c \uc870\uac74\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc18d\uac00\ub2a5\ud55c \uc18c\ube44\ub294 \uae30\uc5c5\uc758 \uce5c\ud658\uacbd \uae30\uc220 \uac1c\ubc1c \ub178\ub825\uc744 \ubd88\ud544\uc694\ud558\uac8c \ub9cc\ub4e0\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\ube44\uc790\uc758 \uce5c\ud658\uacbd \uc18c\ube44 \uc99d\ub300\ub294 \uae30\uc5c5\uc774 \uce5c\ud658\uacbd \uc0dd\uc0b0 \uae30\uc220\uc744 \uac1c\ubc1c\ud558\ub3c4\ub85d \ucd09\uc9c4\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud658\uacbd \ubcf4\ud638\uc640 \uc0ac\ud68c\uc801 \ucc45\uc784\uc744 \uace0\ub824\ud558\ub294 \uc18c\ube44 \ubc0f \uc0dd\uc0b0 \ubc29\uc2dd\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    }
