          {
            "type": "text",
            "content": "\ucc28\ud2f0\uc2a4\ud2b8 \uc6b4\ub3d9 \ub2f9\uc2dc \ub178\ub3d9\uc790\ub4e4\uc774 \uc791\uc131\ud558\uc5ec \ubc1c\ud45c\ud55c \uc694\uad6c \uc11c\ub958\uc758 \uba85\uce6d\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ubbfc\ud5cc\uc7a5 (People's Charter)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c\uc758 \ubc1c\ub2ec \uacfc\uc815\uc5d0\uc11c \ucc38\uc815\uad8c \ud655\ub300 \uc6b4\ub3d9\uc774 \uc77c\uc5b4\ub09c \uc9c1\uc811\uc801\uc778 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85 \uc774\ud6c4\uc5d0\ub3c4 \uc7ac\uc0b0, \uc131\ubcc4 \ub4f1\uc5d0 \ub530\ub77c \uc120\uac70\uad8c\uc774 \uc81c\ud55c\ub418\uc5b4 \ub178\ub3d9\uc790, \ub18d\ubbfc, \uc5ec\uc131 \ub4f1\uc774 \uc815\uce58\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc5c8\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95 \uc81c\uc815 \uc774\uc804 \uc790\ubcf8\uc8fc\uc758 \uccb4\uc81c\uc5d0\uc11c \uc7ac\uc0b0\uad8c \ud589\uc0ac\uc5d0 \ub300\ud55c \uad00\uc810\uacfc \ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95 \uc81c\uc815 \uc774\ud6c4 \uad00\uc810\uc758 \ubcc0\ud654\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc804: \uc7ac\uc0b0\uad8c\uc744 \uc808\ub300\uc801\uc774\uace0 \uc2e0\uc131\ubd88\uac00\uce68\ud55c \uad8c\ub9ac\ub85c \ubd04 (\uac1c\uc778\uc8fc\uc758\uc801 \uc790\uc720\uad8c)\n\uc774\ud6c4: \uac1c\uc778\uc758 \uc7ac\uc0b0\uad8c \ud589\uc0ac\ub3c4 \uacf5\uacf5\ubcf5\ub9ac\uc5d0 \uc801\ud569\ud558\ub3c4\ub85d \uc81c\ud55c\ud560 \uc218 \uc788\uc74c\uc744 \uaddc\uc815\ud568 (\uc0ac\ud68c\uc801 \ucc45\ubb34 \uac15\uc870)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c \ubcf4\uc7a5\uc744 \uc704\ud55c \uad6d\uc81c\uc801 \ub178\ub825\uc5d0\uc11c \ub09c\ubbfc, \uc544\ub3d9, \uc5ec\uc131 \ub4f1 \uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \uad8c\ub9ac\ub97c \uc9c0\ud0a4\uae30 \uc704\ud574 \uac15\uc870\ub418\ub294 \uc778\ub958\uc758 \ud0dc\ub3c4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c\uc801 \uc5f0\ub300\uc640 \uacf5\ub3d9\uc758 \ub178\ub825"
          }
        ]
      }
    }
  ]
