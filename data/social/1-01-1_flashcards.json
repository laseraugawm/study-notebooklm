{
  "title": "Human Rights Flashcards",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c(Human Rights)\uc774\ub780 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc774 \uc778\uac04\ub2f5\uac8c \uc0b4\uae30 \uc704\ud574 \ub9c8\ub545\ud788 \ub204\ub824\uc57c \ud560 \uae30\ubcf8\uc801\uc778 \uad8c\ub9ac\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c\uc774 \ud0dc\uc5b4\ub098\uba74\uc11c\ubd80\ud130 \ub2f9\uc5f0\ud788 \uac00\uc9c0\ub294 \uad8c\ub9ac\ub85c\uc11c, \uad6d\uac00\uac00 \ubc95\uc73c\ub85c \ubcf4\uc7a5\ud558\uae30 \uc804\ubd80\ud130 \uc790\uc5f0\uc801\uc73c\ub85c \ubd80\uc5ec\ub41c \uad8c\ub9ac\ub77c\ub294 \ud2b9\uc131\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc9c\ubd80\uc778\uad8c\uc131 (\uc790\uc5f0\uad8c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c\uc774 \uc778\uc885, \uc131\ubcc4, \uc885\uad50, \uc5b8\uc5b4 \ub4f1\uacfc \uad00\uacc4\uc5c6\uc774 \uc778\uac04\uc774\ub77c\uba74 \ub204\uad6c\ub098 \uac00\uc9c0\ub294 \uad8c\ub9ac\ub77c\ub294 \ud2b9\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\ud3b8\uc131 (\ubcf4\ud3b8\uc801 \uad8c\ub9ac)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\ub098 \ub2e4\ub978 \uc0ac\ub78c\uc774 \ud568\ubd80\ub85c \ube7c\uc557\uac70\ub098 \uce68\ud574\ud560 \uc218 \uc5c6\ub294 \uc778\uad8c\uc758 \ud2b9\uc131\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\uac00\uce68\uc131 (\ubd88\uac00\uce68\uc758 \uad8c\ub9ac)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uad8c\ub825\uc774 \uad6d\ubbfc\uc758 \uad8c\ub9ac\ub97c \uce68\ud574\ud558\uac70\ub098 \uc815\uc758\ub86d\uc9c0 \ubabb\ud55c \uc815\ucc45\uc744 \uc6b4\uc6a9\ud560 \ub54c, \uc778\uad8c\uc740 \uc5b4\ub5a4 \uc5ed\ud560\uc744 \uc218\ud589\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uad8c\ub825\uc744 \ube44\ud310\ud558\uace0 \uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\ub97c \ub9cc\ub4e4\uae30 \uc704\ud55c \ud310\ub2e8 \uae30\uc900 \uc5ed\ud560\uc744 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucca0\ud559\uc790 \ud574\ub098 \uc544\ub80c\ud2b8(Arendt, H.)\ub294 \uc790\uc2e0\uc758 \ub9dd\uba85 \uacbd\ud5d8\uc744 \ubc14\ud0d5\uc73c\ub85c \uc5b4\ub5a4 \uc0ac\ub78c\ub4e4\uc758 \uc778\uad8c \ubb38\uc81c\ub97c \ube44\ud310\ud558\uc600\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uc218 \ubbfc\uc871, \ub09c\ubbfc, \ubb34\uad6d\uc801\uc790\ucc98\ub7fc \uad6d\uac00\ub098 \uc815\uce58 \uacf5\ub3d9\uccb4\uc5d0 \uc18c\uc18d\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc740 \uc0ac\ub78c\ub4e4\uc758 \uc778\uad8c \ubbf8\ubcf4\uc7a5 \ud604\uc2e4\uc744 \ube44\ud310\ud558\uc600\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\ub098 \uc544\ub80c\ud2b8\uc5d0 \ub530\ub974\uba74, \uad8c\ub9ac\ub97c \uc0c1\uc2e4\ud55c \ub09c\ubbfc\uc774\ub098 \ubb34\uad6d\uc801\uc790\ub4e4\uc774 \uacaa\ub294 \uac00\uc7a5 \uadfc\ubcf8\uc801\uc778 \uc7ac\ub09c\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub290 \uc815\uce58 \uacf5\ub3d9\uccb4\uc5d0\ub3c4 \uc18d\ud558\uc9c0 \uc54a\uc544\uc11c \uadf8\ub4e4\uc744 \ubcf4\ud638\ud560 \uc5b4\ub5a0\ud55c \ubc95\ub3c4 \uc874\uc7ac\ud558\uc9c0 \uc54a\ub294\ub2e4\ub294 \uc810\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub300 \uc774\uc804 \uc11c\uad6c \uc0ac\ud68c\uc758 \uc778\uad8c \uc0c1\ud669\uc740 \uc5b4\ub5a0\ud558\uc600\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc655\uacfc \uc18c\uc218\uc758 \uadc0\uc871\uc744 \uc81c\uc678\ud55c \ub300\ub2e4\uc218\uc758 \uc0ac\ud68c \uad6c\uc131\uc6d0\uc774 \uc5b5\uc555\uacfc \ucc28\ubcc4\uc744 \ubc1b\uc558\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\uad6d \uba85\uc608\ud601\uba85(1688) \uacb0\uacfc \uc2b9\uc778\ub41c \ubb38\uc11c\uc640 \uadf8 \uc815\uce58\uc801 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad8c\ub9ac \uc7a5\uc804(1689)\uc774 \uc2b9\uc778\ub418\uc5c8\uc73c\uba70, \uc758\ud68c \uc911\uc2ec\uc758 \uc785\ud5cc \uad70\uc8fc\uc81c\uac00 \ub4f1\uc7a5\ud558\uc5ec \uc2dc\ubbfc\uc758 \uc790\uc720\uc640 \uad8c\ub9ac\uac00 \ud655\ub300\ub418\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1689\ub144 \uc601\uad6d\uc758 \uad8c\ub9ac \uc7a5\uc804\uc5d0 \uba85\uc2dc\ub41c \ub300\ud45c\uc801\uc778 \uad8c\ub9ac \uaddc\uc815\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\ud68c\uc758 \ub3d9\uc758 \uc5c6\ub294 \uacfc\uc138 \uae08\uc9c0 \uaddc\uc815 \ub4f1 \uc758\ud68c\uc758 \uad8c\ud55c\uacfc \uc2dc\ubbfc\uc758 \uc790\uc720\ub97c \ubcf4\uc7a5\ud558\uc600\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc758 \uc774\uc131\uc73c\ub85c \ud3b8\uacac\uacfc \uc624\ub958\ub97c \uadf9\ubcf5\ud558\uace0 \uc0ac\ud68c\uc801 \ubaa8\uc21c\uacfc \ubd80\uc870\ub9ac\ub97c \ubc14\ub85c\uc7a1\uc744 \uc218 \uc788\ub2e4\uace0 \ubcf4\ub294 \uc0ac\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacc4\ubabd\uc0ac\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\ub86d\uace0 \ud3c9\ub4f1\ud55c \uc2dc\ubbfc \uac04\uc758 \uacc4\uc57d\uc744 \ubc14\ud0d5\uc73c\ub85c \uad6d\uac00 \uad8c\ub825\uc774 \ud615\uc131\ub418\uc5c8\ub2e4\uace0 \ubcf4\ub294 \uc0ac\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uacc4\uc57d\uc124"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "18\uc138\uae30 \ubd80\ub97c \ucd95\uc801\ud55c \uc2dc\ubbfc\ub4e4\uc5d0\uac8c \ud655\uc0b0\ub418\uc5b4 \uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc758 \uc0ac\uc0c1\uc801 \ubc30\uacbd\uc774 \ub41c \ub450 \uac00\uc9c0 \ud575\uc2ec \uc0ac\uc0c1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacc4\ubabd\uc0ac\uc0c1, \uc0ac\ud68c \uacc4\uc57d\uc124"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uad6d \ub3c5\ub9bd \uc120\uc5b8\ubb38(1776)\uc5d0 \uba85\uc2dc\ub41c \ub300\ud45c\uc801\uc778 \uc778\uad8c \ubc0f \uc815\uce58 \uc6d0\ub9ac \uc138 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ubbfc \uc8fc\uad8c\uc758 \uc6d0\ub9ac, \ud589\ubcf5 \ucd94\uad6c\uad8c, \uc800\ud56d\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub791\uc2a4 \ud601\uba85(1789)\uc758 \uacb0\uacfc\ub85c \ucc44\ud0dd\ub41c \uc120\uc5b8\ubb38\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uacfc \uc2dc\ubbfc\uc758 \uad8c\ub9ac \uc120\uc5b8 (\ud504\ub791\uc2a4 \uc778\uad8c \uc120\uc5b8)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub791\uc2a4 '\uc778\uac04\uacfc \uc2dc\ubbfc\uc758 \uad8c\ub9ac \uc120\uc5b8' \uc81c1\uc870\uc5d0 \uba85\uc2dc\ub41c \ud575\uc2ec \ub0b4\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc740 \uc790\uc720\ub86d\uac8c, \uadf8\ub9ac\uace0 \ud3c9\ub4f1\ud55c \uad8c\ub9ac\ub97c \ub204\ub9ac\uac8c \ud0dc\uc5b4\ub098\uace0 \ub610 \uadf8\ub807\uac8c \uc0dd\uc874\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub791\uc2a4 \uc778\uad8c \uc120\uc5b8 \uc81c2\uc870\uc5d0\uc11c \uce68\ud574\ud560 \uc218 \uc5c6\ub294 \uc790\uc5f0\uad8c\uc73c\ub85c \uc81c\uc2dc\ud55c \ub300\ud45c\uc801 \uad8c\ub9ac \uc911, \uc790\ubcf8\uc8fc\uc758 \ubc1c\uc804\uc5d0 \uae30\uc5ec\ud55c \uc131\uc2a4\ub7ec\uc6b4 \uad8c\ub9ac\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uc720\uad8c (\uc7ac\uc0b0\uad8c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub791\uc2a4 \uc778\uad8c \uc120\uc5b8 \uc81c6\uc870\uc5d0\uc11c '\ubc95'\uc744 \ubb34\uc5c7\uc758 \ud45c\ud604\uc774\ub77c\uace0 \uc815\uc758\ud558\uc600\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18 \uc758\uc9c0\uc758 \ud45c\ud604"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc744 \ud1b5\ud574 \ud655\ub9bd\ub418\uace0 \uc120\uc5b8\ubb38\ub4e4\uc5d0 \uc8fc\ub85c \uba85\uc2dc\ub41c \ud575\uc2ec\uc801\uc778 \ub450 \uac00\uc9c0 \uad8c\ub9ac\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uad8c, \ud3c9\ub4f1\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85 \uc9c1\ud6c4 \uc120\uac70\uad8c \ubcf4\uc7a5\uc758 \ud55c\uacc4\uc810\uc740 \ubb34\uc5c7\uc774\uc5c8\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7ac\uc0b0, \uc131\ubcc4, \uc9c1\uc5c5 \ub4f1\uc5d0 \ub530\ub77c \uc120\uac70\uad8c\uc774 \uc81c\ud55c\ub418\uc5b4 \ub178\ub3d9\uc790, \ub18d\ubbfc, \uc5ec\uc131 \ub4f1\uc740 \uc815\uce58\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc5c6\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "19\uc138\uae30 \uc911\ubc18 \uc601\uad6d \ub178\ub3d9\uc790\ub4e4\uc774 \uc120\uac70\uad8c \ud655\ub300\uc640 \ube44\ubc00 \ud22c\ud45c\ub97c \uc694\uad6c\ud558\uba70 \uc778\ubbfc\ud5cc\uc7a5\uc744 \ubc1c\ud45c\ud558\uace0 \uc804\uac1c\ud55c \uc6b4\ub3d9\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc28\ud2f0\uc2a4\ud2b8 \uc6b4\ub3d9 (1838~1848)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\uad6d\uc5d0\uc11c \uc5ec\uc131\uc774 \ubcf4\ud1b5 \uc120\uac70\uc5d0 \ucc38\uc5ec\ud558\uac8c \ub41c \uc2dc\uae30\ub294 \uc5b8\uc81c\ubd80\ud130\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1928\ub144"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc28\ud2f0\uc2a4\ud2b8 \uc6b4\ub3d9\uacfc \uc5ec\uc131 \ucc38\uc815\uad8c \uc6b4\ub3d9\uc758 \uacb0\uacfc\ub85c 20\uc138\uae30 \uc911\ubc18 \uc774\ud6c4 \ud655\ub9bd\ub41c \uc120\uac70 \uc81c\ub3c4\uc758 \uc6d0\uce59\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\ubcc4, \uc7ac\uc0b0, \uc778\uc885 \ub4f1\uc5d0 \uad00\uacc4\uc5c6\uc774 \uc77c\uc815 \uc5f0\ub839 \uc774\uc0c1\uc758 \uc2dc\ubbfc \ub204\uad6c\ub098 \ucc38\uc815\uad8c\uc744 \uac16\ub294 \ubcf4\ud1b5 \uc120\uac70 \uc81c\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc5c5 \ud601\uba85 \uc774\ud6c4 \uae09\uaca9\ud55c \uc790\ubcf8\uc8fc\uc758 \ubc1c\uc804 \uacfc\uc815\uc5d0\uc11c \uc0ac\ud68c\uc801 \uc57d\uc790\ub4e4\uc774 \uacaa\uc740 \ubb38\uc81c\uc810 \uc138 \uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f4\uc545\ud55c \ub178\ub3d9 \ud658\uacbd, \uc2e4\uc5c5 \ubc0f \ube48\uace4, \ube48\ubd80 \uaca9\ucc28 \uc2ec\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc5c5 \ud601\uba85 \uc774\ud6c4 \uc2ec\ud654\ub41c \uc0ac\ud68c\uc801 \ubd88\ud3c9\ub4f1\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574 \ud655\uc0b0\ub41c \uc778\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\ubbfc\uc774 \uc790\uc720\uc640 \uad8c\ub9ac\ub97c \uc2e4\uc9c8\uc801\uc73c\ub85c \ub204\ub9ac\ub824\uba74 \uad6d\uac00\uac00 \uc0ac\ud68c\uc801 \uc57d\uc790\ub97c \ubcf4\ud638\ud574\uc57c \ud55c\ub2e4\ub294 \uc778\uc2dd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \ucd5c\ucd08\ub85c \ubaa8\ub4e0 \uad6d\ubbfc\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c\uc744 \ubcf4\uc7a5\ud558\ub294 '\uc0ac\ud68c\uad8c'\uc744 \uba85\uc2dc\ud55c \ud5cc\ubc95\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc77c \ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95 (1919\ub144)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc77c \ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95 \uc81c151\uc870 \u2460\ud56d\uc5d0 \uaddc\uc815\ub41c \uacbd\uc81c\uc0dd\ud65c \uc9c8\uc11c\uc758 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
