    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\uad6d \ub7f0\ub358 \ub0b4\uc5d0\uc11c \ub9ce\uc740 \ub2e4\uad6d\uc801 \uae30\uc5c5\uacfc \uae08\uc735 \uae30\uc5c5\uc758 \ubcf8\uc0ac\uac00 \uc9d1\uc911\ud574 \uc788\ub294 \uc138\uacc4\uc801\uc778 \uae08\uc735 \uc911\uc2ec\uc9c0\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
