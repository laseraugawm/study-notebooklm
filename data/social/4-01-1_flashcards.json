{
  "title": "\uc138\uacc4\ud654 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\ud1b5\uacfc \ud1b5\uc2e0\uc758 \ubc1c\ub2ec\uc744 \uacc4\uae30\ub85c \uad6d\uac00 \uac04 \uc0c1\ud638 \uc758\uc874\uc131\uc774 \ucee4\uc9c0\uace0 \uc138\uacc4\uac00 \ud558\ub098\uc758 \uacf5\ub3d9\uccb4\ub85c \ud1b5\ud569\ub418\uc5b4 \uac00\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654\uc758 \uc9c4\ud589 \uacfc\uc815\uc5d0\uc11c \uad6d\uacbd\uc744 \ub118\uc5b4 \uc790\uc720\ub86d\uac8c \uc774\ub3d9\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc694\uc18c 4\uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ud488, \uc790\ubcf8, \uae30\uc220, \ubb38\ud654(\ub610\ub294 \uac00\uce58)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uc9c0\uc5ed\uc758 \ud2b9\uc218\ud55c \uc694\uc18c\uac00 \uc138\uacc4\uc801\uc778 \uc218\uc900\uc5d0\uc11c \uadf8 \uac00\uce58\ub97c \uc778\uc815\ubc1b\uace0 \uacbd\uc7c1\ub825\uc744 \uac16\ucd94\uac8c \ub418\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654 \uc2dc\ub300\uc5d0 \"\uac00\uc7a5 \uc9c0\uc5ed\uc801\uc778 \uac83\uc774 \uc138\uacc4\uc801\uc778 \uac83\uc774\ub2e4.\"\ub77c\ub294 \ud45c\uc5b4\uac00 \uc758\ubbf8\ud558\ub294 \uc138\uacc4\ud654\uc640 \uc9c0\uc5ed\ud654\uc758 \uad00\uacc4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed\ud654\ub294 \uc138\uacc4\ud654 \uc2dc\ub300\uc5d0 \uac01 \uc9c0\uc5ed\uc774 \uacbd\uc7c1\ub825\uc744 \uc9c0\ub2c8\ub294 \ubc11\uac70\ub984\uc774 \ub418\ubbc0\ub85c, \uc138\uacc4\ud654\uc640 \uc9c0\uc5ed\ud654\ub294 \ub3d9\uc2dc\uc5d0 \uc774\ub8e8\uc5b4\uc9c0\ub294 \uacbd\ud5a5\uc774 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ud488\uc758 \ud488\uc9c8\uc774\ub098 \uba85\uc131\uc774 \ud2b9\uc815 \uc9c0\uc5ed\uc758 \uc9c0\ub9ac\uc801 \ud2b9\uc131\uc5d0\uc11c \ube44\ub86f\ub418\uc5c8\uc74c\uc744 \uc99d\uba85\ud558\uace0 \uc774\ub97c \ud45c\uc2dc\u00b7\ubcf4\ud638\ud558\ub294 \uc81c\ub3c4\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ub9ac\uc801 \ud45c\uc2dc\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "0c6490a7-5a58-4b0c-946e-50c7818b2aae",
            "alt": "\uc81c\uc8fc \ud55c\ub77c\ubd09\uacfc \uc774\ud0c8\ub9ac\uc544 \uace0\ub974\uace4\uc878\ub77c \uce58\uc988 \uc0ac\uc9c4"
          },
          {
            "type": "text",
            "content": "\uc774 \uc0ac\uc9c4 \uc18d\uc5d0 \uc81c\uc2dc\ub41c \uc81c\uc8fc \ud55c\ub77c\ubd09\uacfc \uace0\ub974\uace4\uc878\ub77c \uce58\uc988\ub294 \uc5b4\ub5a4 \uc9c0\uc5ed\ud654 \uc804\ub7b5 \uc81c\ub3c4\uc758 \ub300\ud45c\uc801 \uc0ac\ub840\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ub9ac\uc801 \ud45c\uc2dc\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c \uc9c0\ub9ac\uc801 \ud45c\uc2dc \ub4f1\ub85d 100\ud638\uc5d0 \ud574\ub2f9\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc81c\uc8fc \uc9c0\uc5ed \ud2b9\uc0b0\ud488\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\uc8fc \ud55c\ub77c\ubd09"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ud0c8\ub9ac\uc544\uc758 \ud2b9\uc815 \uc9c0\ub9ac\uc801 \ud658\uacbd \ud2b9\uc131\uc744 \ubc18\uc601\ud558\uc5ec \uc9c0\ub9ac\uc801 \ud45c\uc2dc\uc81c\ub85c \ubcf4\ud638\ubc1b\ub294 \ub300\ud45c\uc801\uc778 \uce58\uc988\uc758 \uc774\ub984\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ub974\uace4\uc878\ub77c \uce58\uc988"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubcf8\uc758 \uc0bf\ud3ec\ub85c\ub294 \uc5b4\ub5a4 \uc790\uc5f0\uc9c0\ub9ac\uc801 \ud2b9\uc131\uc744 \ud65c\uc6a9\ud558\uc5ec \uc138\uacc4 3\ub300 \ucd95\uc81c \uc911 \ud558\ub098\ub97c \uac1c\ucd5c\ud558\uace0 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub208\uc774 \ub9ce\uc774 \ub0b4\ub9ac\ub294 '\ub208\uc758 \uc655\uad6d'\uc774\ub77c\ub294 \uae30\ud6c4\uc801\u00b7\uc9c0\uc5ed\uc801 \ud2b9\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "b6393c4a-6879-4b8a-a35a-d4992a709922",
            "alt": "\ub300\ud615 \ub208 \uc870\uac01\uc0c1\uacfc \uad00\uad11\uac1d\ub4e4\uc774 \uc788\ub294 \uc0bf\ud3ec\ub85c \ub208 \ucd95\uc81c \uc0ac\uc9c4"
          },
          {
            "type": "text",
            "content": "\uc774 \uc0ac\uc9c4\uc5d0\uc11c \ubcfc \uc218 \uc788\ub294 \uc138\uacc4 3\ub300 \ucd95\uc81c \uc911 \ud558\ub098\uc778 '\ub208 \ucd95\uc81c'\uac00 \uc5f4\ub9ac\ub294 \uc77c\ubcf8\uc758 \ub300\ud45c \ub3c4\uc2dc \uc774\ub984\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0bf\ud3ec\ub85c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\uc2a4\ud30c\ub0d0\uc758 \ubc14\ub974\uc140\ub85c\ub098\uac00 \uc138\uacc4\ud654 \uc2dc\ub300\uc5d0 \ub300\ud45c\uc801\uc778 \uc138\uacc4\uc801 \uad00\uad11\uc9c0\ub85c \uacbd\uc7c1\ub825\uc744 \uc9c0\ub2c8\uac8c \ub41c \uace0\uc720\ud55c \ud2b9\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uae30\uc758 \uac74\ucd95\uac00 \uac00\uc6b0\ub514\uac00 \uc124\uacc4\ud55c \uc0ac\uadf8\ub77c\ub2e4 \ud30c\ubc00\ub9ac\uc544 \uc131\ub2f9, \uce74\uc0ac \ubc00\ub77c \ub4f1 \ub3c5\ucc3d\uc801\uc778 \uac74\ucd95 \ubb38\ud654 \uc790\uc6d0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "9c1331d8-4556-4df4-bd26-84bbb182b09a",
            "alt": "\uc5d0\uc2a4\ud30c\ub0d0 \ubc14\ub974\uc140\ub85c\ub098\uc758 \uc0ac\uadf8\ub77c\ub2e4 \ud30c\ubc00\ub9ac\uc544 \uc131\ub2f9 \uc804\uacbd"
          },
          {
            "type": "text",
            "content": "\uc5d0\uc2a4\ud30c\ub0d0 \ubc14\ub974\uc140\ub85c\ub098\uc5d0 \uc704\uce58\ud55c \uac00\uc6b0\ub514\uc758 \ub300\ud45c\uc801\uc778 \uac74\ucd95\ubb3c\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uadf8\ub77c\ub2e4 \ud30c\ubc00\ub9ac\uc544 \uc131\ub2f9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uce58, \uacbd\uc81c, \ubb38\ud654 \ub4f1 \ub2e4\uc591\ud55c \uce21\uba74\uc5d0\uc11c \uc804 \uc138\uacc4\uc758 \uc911\uc2ec\uc9c0 \uc5ed\ud560\uc744 \uc218\ud589\ud558\uba70 \uc9c0\uad6c\ucd0c\uc5d0 \uac15\ub825\ud55c \uc601\ud5a5\ub825\uc744 \ud589\uc0ac\ud558\ub294 \ub3c4\uc2dc\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ub3c4\uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud45c\uc801\uc778 \uc138\uacc4\ub3c4\uc2dc\uc758 \uc608\uc2dc 4\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub274\uc695, \ub7f0\ub358, \ub3c4\ucfc4, \ud30c\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ub3c4\uc2dc\uc5d0 \uc9d1\uc911\ub418\uc5b4 \uc9c0\uad6c\ucd0c \uacbd\uc81c \ud65c\ub3d9\uc5d0 \ucee4\ub2e4\ub780 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \ud575\uc2ec \uacbd\uc81c\uc801 \uc694\uc18c 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uad6d\uc81c \uae08\uc735 \uc5c5\ubb34 \uae30\ub2a5\n2. \uc0dd\uc0b0\uc790 \uc11c\ube44\uc2a4 \uae30\ub2a5\n3. \ub2e4\uad6d\uc801 \uae30\uc5c5\uc758 \ubcf8\uc0ac \uc9d1\uc911"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ud488\uc758 \uc0dd\uc0b0 \ubc0f \uc720\ud1b5 \uacfc\uc815\uc5d0 \ud544\uc694\ud55c \uc11c\ube44\uc2a4\ub97c \ub73b\ud558\uba70, \uc8fc\ub85c \uc138\uacc4\ub3c4\uc2dc\uc5d0 \uc9d1\uc801\ud558\ub294 \uc11c\ube44\uc2a4\uc5c5\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\uc790 \uc11c\ube44\uc2a4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\uc790 \uc11c\ube44\uc2a4\uc5c5\uc5d0 \ud574\ub2f9\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc8fc\uc694 \uc5c5\uc885 5\uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae08\uc735, \ubcf4\ud5d8, \ubd80\ub3d9\uc0b0\uc5c5, \ud68c\uacc4 \uc11c\ube44\uc2a4, \uc5f0\uad6c \uac1c\ubc1c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ub3c4\uc2dc\uac00 \uad6d\uc81c \uc0ac\ud68c\uc758 \uc911\uc694\ud55c \uc758\uc0ac \uacb0\uc815\uacfc \uc8fc\uc694 \ubb38\uc81c \ub17c\uc758\uc758 \uc911\uc2ec\uc9c0 \uc5ed\ud560\uc744 \ud558\ub294 \uc8fc\uc694 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc5f0\ud569(UN) \ub4f1 \ub2e4\uc591\ud55c \uad6d\uc81c\uae30\uad6c\uc758 \ubcf8\ubd80\uac00 \uc790\ub9ac \uc7a1\uace0 \uc788\uace0, \uac01\uc885 \uad6d\uc81c\ud68c\uc758\uac00 \uc790\uc8fc \uac1c\ucd5c\ub418\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ub3c4\uc2dc\uac00 \ubb38\ud654\uc801 \uce21\uba74\uc5d0\uc11c \ub2f4\ub2f9\ud558\ub294 \uc911\uc694\ud55c \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\uc801\uc778 \uad50\ud1b5\u00b7\ud1b5\uc2e0\ub9dd\uc758 \uc911\uc2ec\uc9c0\ub85c\uc11c \uc608\uc220, \uc74c\uc545, \uc601\ud654, \ubb38\ud559 \ub4f1 \ub2e4\uc591\ud55c \ubd84\uc57c\uc758 \ubb38\ud654 \ud65c\ub3d9\uc744 \uc8fc\ub3c4\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uad6d \ub274\uc695\uc774 \uc138\uacc4 \uc815\uce58\uc758 \uc911\uc2ec\uc9c0\ub85c\uc11c \uc8fc\uc694\ud55c \uc704\uc0c1\uc744 \ucc28\uc9c0\ud558\uace0 \uc788\uc74c\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ub300\ud45c\uc801\uc778 \uad6d\uc81c\uae30\uad6c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc5f0\ud569(UN) \ubcf8\ubd80"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub274\uc695 \ub9e8\ud574\ud2bc \uc6d4\uac00\uc5d0 \uc704\uce58\ud558\uba70 \uc804 \uc138\uacc4 \uae08\uc735 \uc2dc\uc7a5\uc758 \ub3d9\ud5a5\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc138\uacc4 \ucd5c\ub300 \uaddc\ubaa8\uc758 \uc99d\uad8c \uac70\ub798\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub274\uc695 \uc99d\uad8c \uac70\ub798\uc18c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "336f00b5-04d3-401f-80e3-8e0879eeb28f",
            "alt": "\uc601\uad6d \ub7f0\ub358\uc758 \ud15c\uc2a4\uac15\uacfc \ud0c0\uc6cc\ube0c\ub9ac\uc9c0 \uc804\uacbd"
          },
          {
            "type": "text",
            "content": "\uae08\uc735 \uc911\uc2ec\uc9c0\uc778 '\ub354 \uc2dc\ud2f0'\ub97c \ubc14\ud0d5\uc73c\ub85c \ub274\uc695\uacfc \ud568\uaed8 \uc138\uacc4 \uae08\uc735 \uc2dc\uc7a5\uc758 \uc591\ub300 \ucd95\uc744 \uc774\ub8e8\ub294 \uc774 \uc601\uad6d\uc758 \uc138\uacc4\ub3c4\uc2dc\ub294 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub7f0\ub358"
