    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uac01\uc9c0\uc5d0 \uc790\ud68c\uc0ac \ubc0f \uc9c0\uc0ac, \uc0dd\uc0b0 \uacf5\uc7a5 \ub4f1\uc744 \ub450\uace0 \uc0dd\uc0b0\uacfc \ud310\ub9e4 \ud65c\ub3d9\uc744 \uc804 \uc138\uacc4\uc801\uc73c\ub85c \uc218\ud589\ud558\ub294 \uac70\ub300 \uae30\uc5c5\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
