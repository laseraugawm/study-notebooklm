{
  "title": "\uc0ac\ud68c \ud034\uc988",
  "questions": [
    {
      "question": "2023\ub144 \uae30\uc900 \ub300\ud55c\ubbfc\uad6d\uc758 \uc704\uc0c1 \uc9c0\ud45c\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb34\uc5ed \uaddc\ubaa8\ub294 \uc138\uacc4 13\uc704\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb34\uc5ed \uaddc\ubaa8\ub294 \uc138\uacc4 8\uc704\uc774\uba70, GDP\uac00 \uc138\uacc4 13\uc704\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
