        {
          "text": "\uc138\uacc4\uc720\uc0b0 \ub4f1\uc7ac \uac74\uc218\ub294 \ucd1d 10\uac74\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc81c\uc2dc\ub41c \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \uc11d\uad74\uc554, \ubd88\uad6d\uc0ac, \uc218\uc6d0 \ud654\uc131, \uac00\uc57c \uace0\ubd84\uad70 \ub4f1\uc744 \ud3ec\ud568\ud558\uc5ec \ucd1d 16\uac74\uc774\ub2e4."
        }
      ],
      "hint": "\uc81c\uc2dc\ub41c \uc790\ub8cc\uc758 \uacf5\uc801 \uac1c\ubc1c \uc6d0\uc870(ODA) \ubc0f \uacbd\uc81c \uc9c0\ud45c \uc21c\uc704\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ud55c\uad6d \uad6d\uc81c \ud611\ub825\ub2e8(KOICA)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc678\uad50\ubd80 \uc0b0\ud558\uc758 \uacf5\uacf5 \uae30\uad00\uc73c\ub85c \uc778\ub3c4\uc801 \ucc28\uc6d0\uc758 \ub300\uc678 \ubb34\uc0c1 \ud611\ub825 \uc0ac\uc5c5\uc744 \ucd94\uc9c4\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "KOICA\ub294 \uc678\uad50\ubd80 \uc0b0\ud558 \uacf5\uacf5 \uae30\uad00\uc73c\ub85c\uc11c \uad50\uc721, \ubcf4\uac74, \ub18d\ucd0c \uac1c\ubc1c \ub4f1 \ubb34\uc0c1 \uc9c0\uc6d0 \uc0ac\uc5c5\uc744 \uc218\ud589\ud55c\ub2e4."
        },
        {
          "text": "\uac1c\uc778\ub4e4\uc774 \uc790\ubc1c\uc801\uc73c\ub85c \ubaa8\uc5ec \ub9cc\ub4e0 \ub300\ud45c\uc801\uc778 \ube44\uc815\ubd80 \uae30\uad6c(NGO)\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "KOICA\ub294 \ubbfc\uac04 \ub2e8\uccb4\uac00 \uc544\ub2cc \uc815\ubd80 \uc678\uad50\ubd80 \uc0b0\ud558\uc758 \uacf5\uacf5 \uae30\uad00\uc774\ub2e4."
        },
        {
          "text": "\uc8fc\ub85c \ud574\uc678 \uc601\ub9ac \ubaa9\uc801\uc758 \uc5d0\ub108\uc9c0 \ubc0f \uc790\uc6d0 \uac1c\ubc1c \uc0ac\uc5c5\uc744 \uc8fc\ub3c4\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774 \uae30\uad00\uc740 \uc601\ub9ac \ubaa9\uc801\uc774 \uc544\ub2c8\ub77c \uc778\ub3c4\uc801 \ucc28\uc6d0\uc758 \ub300\uc678 \ubb34\uc0c1 \ud611\ub825 \uc0ac\uc5c5\uc744 \uc8fc\uc694 \uc5c5\ubb34\ub85c \ud55c\ub2e4."
        },
        {
          "text": "6\u00b725 \uc804\uc7c1 \uc9c1\ud6c4 \uad6d\uc81c \uc5f0\ud569(UN)\uc774 \uc6b0\ub9ac\ub098\ub77c\ub97c \uc9c0\uc6d0\ud558\uae30 \uc704\ud574 \uc9c1\uc811 \uc124\ub9bd\ud55c \uad6d\uc81c\uae30\uad6c\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "KOICA\ub294 \ub300\ud55c\ubbfc\uad6d \uc815\ubd80(\uc678\uad50\ubd80) \uc0b0\ud558\uc758 \uacf5\uacf5 \uae30\uad00\uc73c\ub85c \uc124\ub9bd\ub418\uc5c8\ub2e4."
        }
      ],
      "hint": "\uc774 \uae30\uad00\uc758 \uc18c\uc18d \uc815\ubd80 \ubd80\ucc98\uc640 \ucd94\uc9c4\ud558\ub294 \uc0ac\uc5c5\uc758 \uacf5\uc775\uc801 \uc131\uaca9\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ud3c9\ud654\uc758 \uc758\ubbf8\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc804\uc7c1\uc774\ub098 \ud14c\ub7ec, \uc2e0\uccb4\uc801 \ud3ed\ub825\uc774 \uc5c6\ub294 \uc0c1\ud0dc\ub97c \uc18c\uadf9\uc801 \ud3c9\ud654\ub77c\uace0 \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c1\uc811\uc801 \ud3ed\ub825\uc774 \uc81c\uac70\ub41c \uc0c1\ud0dc\ub294 \uc18c\uadf9\uc801 \ud3c9\ud654\uc758 \uc815\ud655\ud55c \uac1c\ub150\uc774\ub2e4."
        },
        {
          "text": "\uc801\uadf9\uc801 \ud3c9\ud654\ub294 \uc9c1\uc811\uc801 \ud3ed\ub825\ubfd0\ub9cc \uc544\ub2c8\ub77c \uac04\uc811\uc801 \ud3ed\ub825\uae4c\uc9c0 \ubaa8\ub450 \uc81c\uac70\ub41c \uc0c1\ud0dc\ub97c \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc801\uadf9\uc801 \ud3c9\ud654\ub294 \uc0ac\ud68c \uad6c\uc870\uc801 \uc694\uc778\uc5d0 \uc758\ud55c \uac04\uc811\uc801 \ud3ed\ub825\uae4c\uc9c0 \uc0ac\ub77c\uc9c4 \uc0c1\ud0dc\ub97c \ub73b\ud55c\ub2e4."
        },
        {
          "text": "\ube48\uace4, \uae30\uc544, \uc5b5\uc555, \ucc28\ubcc4 \ub4f1\uc740 \uac04\uc811\uc801 \ud3ed\ub825\uc758 \ub300\ud45c\uc801\uc778 \uc608\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\uc544, \ucc28\ubcc4, \uc5b5\uc555 \ub4f1\uc740 \uc0ac\ud68c \uad6c\uc870\uc5d0 \uc758\ud574 \ubc1c\uc0dd\ud558\ub294 \ub300\ud45c\uc801\uc778 \uac04\uc811\uc801 \ud3ed\ub825 \uc720\ud615\uc774\ub2e4."
        },
        {
          "text": "\uc18c\uadf9\uc801 \ud3c9\ud654\ub97c \ub2ec\uc131\ud558\uba74 \uc778\ub958\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uacfc \uc801\uadf9\uc801 \ud3c9\ud654\uac00 \uc790\ub3d9\uc73c\ub85c \uc2e4\ud604\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc18c\uadf9\uc801 \ud3c9\ud654(\uc804\uc7c1 \ubd80\uc7ac)\ub97c \uc774\ub8e8\ub354\ub77c\ub3c4 \ube48\uace4\uc774\ub098 \ucc28\ubcc4 \uac19\uc740 \uac04\uc811\uc801 \ud3ed\ub825\uc774 \ub0a8\uc544\uc788\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c \uc801\uadf9\uc801 \ud3c9\ud654\uac00 \uc790\ub3d9\uc73c\ub85c \ub2ec\uc131\ub418\uc9c0\ub294 \uc54a\ub294\ub2e4."
        }
      ],
      "hint": "\uc18c\uadf9\uc801 \ud3c9\ud654\uc640 \uc801\uadf9\uc801 \ud3c9\ud654\uac00 \uac01\uac01 \ub2e4\ub8e8\ub294 \ud3ed\ub825\uc758 \ubc94\uc704\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc138\uacc4\ud654 \ud604\uc0c1\uacfc \uadf8\uc5d0 \ub530\ub978 \ubb38\uc81c \ubc0f \ud574\uacb0 \ubc29\uc548\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc138\uacc4\ud654\ub294 \uad50\ud1b5\u00b7\ud1b5\uc2e0\uc758 \ubc1c\ub2ec\ub85c \uad6d\uac00 \uac04 \uc0c1\ud638 \uc758\uc874\uc131\uc774 \ucee4\uc9c0\uace0 \uc138\uacc4\uac00 \ud1b5\ud569\ub418\uc5b4 \uac00\ub294 \ud604\uc0c1\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uacc4\ud654\uc758 \uae30\ubcf8\uc801\uc778 \uc815\uc758\uc640 \ubc1c\uc0dd \ubc30\uacbd\uc744 \uc815\ud655\ud788 \uae30\uc220\ud558\uace0 \uc788\ub2e4."
        },
        {
          "text": "\uc138\uacc4\ud654\uc5d0 \ub530\ub77c \uad6d\uac00 \uac04 \ubd84\uc5c5\uc774 \ud65c\ubc1c\ud574\uc9c0\uba74\uc11c \uad6d\uac00 \uac04 \ube48\ubd80 \uaca9\ucc28\uac00 \uc904\uc5b4\ub4e4\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc138\uacc4\ud654\uc758 \uc9c4\ud589 \uacfc\uc815\uc5d0\uc11c \uad6d\uac00 \uac04 \uc2ec\ud654\ub41c \uacbd\uc7c1\uacfc \uacf5\uac04\uc801 \ubd84\uc5c5 \ud615\ud0dc\ub85c \uc778\ud574 \uc624\ud788\ub824 \uad6d\uac00 \uac04 \ube48\ubd80 \uaca9\ucc28\uac00 \uc2ec\ud654\ud558\ub294 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uace0 \uc788\ub2e4."
        },
        {
          "text": "\ubb38\ud654 \ud68d\uc77c\ud654\ub97c \ubc29\uc9c0\ud558\ub824\uba74 \uc790\uae30 \ubb38\ud654\uc758 \uc815\uccb4\uc131\uc744 \uc720\uc9c0\ud558\uba74\uc11c \uc678\ub798\ubb38\ud654\ub97c \ube44\ud310\uc801\uc73c\ub85c \uc218\uc6a9\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb38\ud654\uc758 \uc815\uccb4\uc131 \ubcf4\uc874\uacfc \ube44\ud310\uc801 \uc218\uc6a9\uc740 \ubb38\ud654 \ud68d\uc77c\ud654 \uc608\ubc29\uc744 \uc704\ud55c \ubc14\ub78c\uc9c1\ud55c \ud0dc\ub3c4\uc774\ub2e4."
        },
        {
          "text": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc740 \uacbd\uc7c1\ub825\uc744 \ud655\ubcf4\ud558\uace0 \uc774\uc724\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uacf5\uac04\uc801 \ubd84\uc5c5\uc744 \uc9c0\ud5a5\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc774 \uc790\ubcf8\uacfc \ub178\ub3d9\ub825\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ubc30\uce58\ud558\uae30 \uc704\ud574 \uacf5\uac04\uc801 \ubd84\uc5c5\uc744 \uc9c0\ud5a5\ud568\uc744 \uc633\uac8c \uc124\uba85\ud558\uace0 \uc788\ub2e4."
        }
      ],
      "hint": "\uc138\uacc4\ud654\uac00 \uc9c4\ud589\ub428\uc5d0 \ub530\ub77c \uad6d\uac00 \uac04 \uacbd\uc81c\uc801 \uaca9\ucc28\uc5d0 \uc5b4\ub5a0\ud55c \ubcc0\ud654\uac00 \uc0dd\uae30\ub294\uc9c0 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uad6d\uc81c \uc0ac\ud68c\uc758 \uc8fc\uc694 \ud589\uc704 \uc8fc\uccb4\uc778 '\uad6d\uac00(\uac00)'\uc640 '\ube44\uc815\ubd80 \uae30\uad6c(\ub098)'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\ub9cc\uc744 <\ubcf4\uae30>\uc5d0\uc11c \uace0\ub978 \uac83\uc740?\n\n<\ubcf4\uae30>\n\u3131. (\uac00)\ub294 \ub3c5\ub9bd\uc801\uc778 \uc8fc\uad8c\uc744 \uac00\uc9c4 \uad6d\uc81c \uc0ac\ud68c\uc758 \uac00\uc7a5 \uae30\ubcf8\uc801\uc778 \ud589\uc704 \uc8fc\uccb4\uc774\ub2e4.\n\u3134. (\ub098)\ub294 \uc815\ubd80 \uac04 \ud611\uc57d\uc5d0 \uc758\ud574 \uc124\ub9bd\ub41c \uad6d\uc81c\uae30\uad6c\uc774\ub2e4.\n\u3137. (\ub098)\ub294 \uc6d0\uce59\uc801\uc73c\ub85c \ud2b9\uc815 \uad6d\uac00\uc758 \uc774\uc775\uc5d0 \uc0c1\uad00\uc5c6\uc774 \uc9c0\uad6c\ucd0c \ubcf4\ud3b8\uc801 \uac00\uce58\ub97c \ucd94\uad6c\ud55c\ub2e4.\n\u3139. (\uac00)\uc640 (\ub098) \ubaa8\ub450 \uad6d\uac00\uc801 \uc774\uc775 \ub2ec\uc131\uc744 \ucd5c\uc6b0\uc120 \ubaa9\uc801\uc73c\ub85c \ud65c\ub3d9\ud55c\ub2e4.",
      "answerOptions": [
        {
          "text": "\u3131, \u3134",
          "isCorrect": false,
          "rationale": "\u3134\uc740 \ube44\uc815\ubd80 \uae30\uad6c\uac00 \uc544\ub2cc \uc815\ubd80 \uac04 \uad6d\uc81c\uae30\uad6c\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4."
        },
        {
          "text": "\u3131, \u3137",
          "isCorrect": true,
          "rationale": "\uad6d\uac00\ub294 \uc8fc\uad8c\uc744 \uac00\uc9c4 \uae30\ubcf8 \ud589\uc704 \uc8fc\uccb4\uc774\uba70, \ube44\uc815\ubd80 \uae30\uad6c(NGO)\ub294 \uad6d\uc775\uc744 \ub118\uc5b4 \ubcf4\ud3b8\uc801 \uac00\uce58\uc640 \uacf5\ud1b5 \ubb38\uc81c \ud574\uacb0\uc744 \uc9c0\ud5a5\ud55c\ub2e4."
        },
        {
          "text": "\u3134, \u3137",
          "isCorrect": false,
          "rationale": "\u3134\uc758 \uc815\ubd80 \uac04 \ud611\uc57d \uc124\ub9bd \uc8fc\uccb4\ub294 \ube44\uc815\ubd80 \uae30\uad6c\uac00 \uc544\ub2c8\ub77c \uad6d\uc81c\uae30\uad6c\uc774\ub2e4."
        },
        {
          "text": "\u3137, \u3139",
          "isCorrect": false,
          "rationale": "\u3139\uc758 \uad6d\uc775 \ucd5c\uc6b0\uc120Pursuit\ub294 \ube44\uc815\ubd80 \uae30\uad6c\uc758 \ubaa9\uc801\uacfc \ubd80\ud569\ud558\uc9c0 \uc54a\ub294\ub2e4."
        }
      ],
      "hint": "\uc8fc\uad8c\uc744 \ubcf4\uc720\ud55c \uc8fc\uccb4\uc640 \uac1c\uc778\u00b7\ubbfc\uac04\ub2e8\uccb4\ub97c \ubc14\ud0d5\uc73c\ub85c \uad6d\uc775\uacfc \ubb34\uad00\ud558\uac8c \ud65c\ub3d9\ud558\ub294 \uc8fc\uccb4\ub97c \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub3d9\uc544\uc2dc\uc544 \uc5ed\uc0ac \uac08\ub4f1 \uc0ac\ub840 \uc911 '\uc77c\ubcf8\uacfc\uc758 \uc5ed\uc0ac \uac08\ub4f1'\uc5d0 \ud574\ub2f9\ud558\ub294 \ub0b4\uc6a9\uc744 \uc633\uac8c \uace0\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub3d9\ubd81\uacf5\uc815\uc744 \ucd94\uc9c4\ud558\uc5ec \uace0\uc870\uc120\uacfc \uace0\uad6c\ub824\uc758 \uc5ed\uc0ac\ub97c \uc790\uad6d \uc5ed\uc0ac\ub85c \ud3b8\uc785\ud558\ub824 \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub3d9\ubd81\uacf5\uc815\uc740 \uc911\uad6d\uacfc\uc758 \uc5ed\uc0ac \uac08\ub4f1 \ub0b4\uc6a9\uc774\ub2e4."
        },
        {
          "text": "\ub3c5\ub3c4\uc758 \uc601\uc720\uad8c\uc744 \uc77c\ubc29\uc801\uc73c\ub85c \uc8fc\uc7a5\ud558\uace0 \uc5ed\uc0ac \uad50\uacfc\uc11c\ub97c \uc65c\uace1\ud558\uc5ec \uce68\ub7b5 \ud589\uc704\ub97c \uc815\ub2f9\ud654\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub3c5\ub3c4 \uc601\uc720\uad8c \uc8fc\uc7a5\uacfc \uad50\uacfc\uc11c \uc65c\uace1\uc740 \uc77c\ubcf8\uacfc\uc758 \ub300\ud45c\uc801\uc778 \ub3d9\uc544\uc2dc\uc544 \uc5ed\uc0ac \uac08\ub4f1 \uc694\uc18c\uc774\ub2e4."
        },
        {
          "text": "\ubc1c\ud574\ub97c \uc790\uad6d \uc9c0\ubc29 \uc815\uad8c\uc758 \uc5ed\uc0ac\ub77c\uace0 \uc8fc\uc7a5\ud558\uba70 \uc5ed\uc0ac \uc65c\uace1\uc744 \uc2dc\ub3c4\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc1c\ud574 \uc5ed\uc0ac\ub97c \uc790\uad6d \uc9c0\ubc29 \uc815\uad8c \uc5ed\uc0ac\ub85c \ud761\uc218\ud558\ub824\ub294 \uc2dc\ub3c4\ub294 \uc911\uad6d\uc758 \ub3d9\ubd81\uacf5\uc815\uacfc \uad00\ub828\ub41c \uac08\ub4f1\uc774\ub2e4."
        },
        {
          "text": "\uc720\ub77c\uc2dc\uc544 \ub300\ub959\uacfc \ud0dc\ud3c9\uc591\uc744 \uc5f0\uacb0\ud558\ub294 \uad00\ubb38\uc774\ub77c\ub294 \uc9c0\ub9ac\uc801 \ud2b9\uc131\uc744 \ubc14\ud0d5\uc73c\ub85c \ub3d9\uc544\uc2dc\uc544 \uc9c0\ubc30\uad8c\uc744 \uc694\uad6c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud55c\ubc18\ub3c4\uc758 \uc9c0\uc815\ud559\uc801 \uc704\uce58\uc5d0 \ub300\ud55c \uc124\uba85\uc774\uba70 \uc5ed\uc0ac \uac08\ub4f1 \uc0ac\uc548\uc774 \uc544\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub3c5\ub3c4 \ubb38\uc81c \ubc0f \uce68\ub7b5 \ud589\uc704\ub97c \uc815\ub2f9\ud654\ud558\ub294 \uc5ed\uc0ac \uad50\uacfc\uc11c \uc65c\uace1 \uc8fc\uccb4\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
