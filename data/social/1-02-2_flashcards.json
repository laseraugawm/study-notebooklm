        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uac70\uad8c, \uacf5\ubb34\ub2f4\uc784\uad8c \ub4f1\uc740 \uc5b4\ub5a4 \uae30\ubcf8\uad8c \uc720\ud615\uc5d0 \uc18d\ud558\ub294\uac00?"
