        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\uc721\uc744 \ubc1b\uc744 \uad8c\ub9ac, \uadfc\ub85c\uc758 \uad8c\ub9ac \ub4f1\uc740 \uc5b4\ub5a4 \uae30\ubcf8\uad8c \uc720\ud615\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
