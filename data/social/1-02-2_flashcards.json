    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \ubb38\uc81c\uc5d0 \ub300\ud55c \uc2dc\ubbfc\ub4e4\uc758 \uc778\uc2dd\uc744 \ub192\uc774\uace0 \ud589\ub3d9 \ubcc0\ud654\ub97c \ucd09\uad6c\ud558\uae30 \uc704\ud574 \uc801\uadf9\uc801\uc73c\ub85c \ud3bc\uce58\ub294 \ud64d\ubcf4\u00b7\ucc38\uc5ec \ud65c\ub3d9\uc740?"
