      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud569\ubc95\uc801\uc778 \uc218\ub2e8\ub9cc\uc73c\ub85c \ud574\uacb0\uc774 \ubd88\uac00\ub2a5\ud560 \ub54c \ud589\uc0ac\ud558\ub294 \ucd5c\ud6c4\uc758 \uc218\ub2e8\uc774\uc5b4\uc57c \ud55c\ub2e4."
