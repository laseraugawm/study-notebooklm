    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\ub098 \uc9c0\ubc29 \uc790\uce58 \ub2e8\uccb4\uc5d0 \ud53c\ud574 \uad6c\uc81c\ub098 \ubc95\ub960\u00b7\uc81c\ub3c4\uc758 \uc81c\uc815 \ubc0f \uac1c\uc815\uc744 \ubb38\uc11c\ub85c \uc694\uad6c\ud558\ub294 \ud589\uc704\ub294?"
