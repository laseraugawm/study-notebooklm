    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uccb4\uc758 \uc790\uc720, \uc591\uc2ec\uc758 \uc790\uc720 \ub4f1\uc740 \ud5cc\ubc95\uc774 \ubcf4\uc7a5\ud558\ub294 \uae30\ubcf8\uad8c \uc720\ud615 \uc911 \ubb34\uc5c7\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
