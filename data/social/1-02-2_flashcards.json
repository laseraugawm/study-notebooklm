    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ubc29 \uc790\uce58 \ub2e8\uccb4\uc5d0\uc11c \uc5b4\ub9b0\uc774 \ucd9c\uc785 \uc81c\ud55c \uacf5\uac04 \uc9c0\uc815\uc744 \uae08\uc9c0\ud558\ub294 \uc870\ub840 \uc81c\uc815\uc744 \ub17c\uc758\ud558\uac8c \ub41c \ubc30\uacbd\uc740 \ubb34\uc5c7\uc778\uac00?"
