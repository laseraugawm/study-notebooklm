    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc798\ubabb\ub41c \ubc95\uc774\ub098 \uc815\ucc45\uc744 \ubc14\ub85c\uc7a1\uae30 \uc704\ud574 \uc758\ub3c4\uc801\uc73c\ub85c \ubc95\uc5d0 \ub300\ud55c \ubcf5\uc885\uc744 \uac70\ubd80\ud558\ub294 \uc800\ud56d \ud589\uc704\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
