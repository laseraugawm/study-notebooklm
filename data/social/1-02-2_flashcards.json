      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc704"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \ubb38\uc81c \ud574\uacb0\uc774\ub098 \uc81c\ub3c4 \uac1c\uc120\uc744 \uc704\ud574 \ub2e4\uc218 \uc2dc\ubbfc\uc758 \ucc2c\uc131 \uc758\uc0ac\ub97c \ubaa8\uc544 \uc81c\ucd9c\ud558\ub294 \ucc38\uc5ec \ubc29\uc548\uc740?"
