          {
            "type": "text",
            "content": "\uacf5\uad8c\ub825\uc758 \ud589\uc0ac \ub610\ub294 \ubd88\ud589\uc0ac\ub85c \uc778\ud558\uc5ec \ud5cc\ubc95\uc0c1 \ubcf4\uc7a5\ub41c \uae30\ubcf8\uad8c\uc744 \uce68\ud574\ubc1b\uc740 \uad6d\ubbfc\uc774 \ud5cc\ubc95\uc7ac\ud310\uc18c\uc5d0 \uad6c\uc81c\ub97c \uccad\uad6c\ud558\ub294 \uc81c\ub3c4\ub294?"
