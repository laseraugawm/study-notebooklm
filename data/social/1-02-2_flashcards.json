        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\uc720\uc544 \ubc0f \uc5b4\ub9b0\uc774\uc640 \ud568\uaed8 \uc628 \uc190\ub2d8\uc758 \ucd9c\uc785\uc744 \uae08\uc9c0\ud558\ub294 \uc74c\uc2dd\uc810\uc774\ub098 \uce74\ud398 \ub4f1\uc744 \uc9c0\uce6d\ud558\ub294 \ub9d0\uc740?"
