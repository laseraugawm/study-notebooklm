    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub9b0\uc774\ub97c \uad50\ud1b5\uc0ac\uace0\uc758 \uc704\ud5d8\uc73c\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uace0\uc790 \ud559\uad50 \uc8fc\ubcc0 \ub4f1\uc5d0 \uc124\uc815\ud55c \uad6c\uc5ed\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
