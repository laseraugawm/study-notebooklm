    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub864\uc2a4(Rawls)\ub294 \uc2dc\ubbfc\ubd88\ubcf5\uc885\uc758 \uc704\uce58\ub97c \ubc95\uacfc\uc758 \uad00\uacc4 \uc18d\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uc815\uc758\ud558\uc600\ub294\uac00?"
