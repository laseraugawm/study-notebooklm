    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ucc45\uc774\ub098 \uc870\ub840 \uc81c\uc815 \uc804 \uad00\uacc4\uc790\uc640 \uc804\ubb38\uac00, \uc2dc\ubbfc\ub4e4\uc774 \uc758\uacac\uc744 \uad50\ud658\ud558\uace0 \uc218\ub834\ud558\ub294 \uacf5\uc2dd\uc801\uc778 \ub17c\uc758 \uc7a5\uc5d0 \ucc38\uc11d\ud558\ub294 \uac83\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uccad\ud68c \ucc38\uc5ec"
