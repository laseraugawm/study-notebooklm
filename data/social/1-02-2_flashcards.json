{
  "title": "\uc778\uad8c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\ubbfc\ub4e4\uc774 \uc778\uad8c \uc758\uc2dd\uc744 \ubc14\ud0d5\uc73c\ub85c \uad6d\uac00 \uae30\uad00\uc758 \uc815\ucc45 \uacb0\uc815 \uacfc\uc815\uc774\ub098 \uacf5\uacf5 \ubb38\uc81c \ud574\uacb0\uc5d0 \uc801\uadf9\uc801\uc73c\ub85c \ucc38\uc5ec\ud558\ub294 \ud589\uc704\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\ubbfc \ucc38\uc5ec"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95\uc5d0 \uc778\uad8c \ubcf4\uc7a5 \uc81c\ub3c4\uac00 \uaddc\uc815\ub418\uc5b4 \uc788\uc74c\uc5d0\ub3c4 \uc2dc\ubbfc \ucc38\uc5ec\uac00 \ud544\uc218\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\ub3c4\uc801 \uc7a5\uce58\ub9cc\uc73c\ub85c\ub294 \uc778\uad8c\uc774 \uc800\uc808\ub85c \ubcf4\uc7a5\ub418\uc9c0 \uc54a\uc73c\ubbc0\ub85c, \uc2dc\ubbfc\ub4e4\uc758 \ub2a5\ub3d9\uc801 \ucc38\uc5ec\ub97c \ud1b5\ud574 \ubd80\ub2f9\ud55c \uc81c\ub3c4\ub098 \uc815\ucc45\uc744 \ubc14\ub85c\uc7a1\uc544\uc57c \ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2012\ub144 \uc218\uc0ac \uae30\uad00\uc758 \uac1c\uc778\uc815\ubcf4 \uc218\uc9d1 \uc0ac\uac74\uc5d0\uc11c \uc2dc\ubbfc \ub2e8\uccb4\uac00 \uad8c\uc775 \uce68\ud574\ub97c \uc8fc\uc7a5\ud55c \ud575\uc2ec \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ub3d9 \ud1b5\uc2e0 \uc11c\ube44\uc2a4 \uc774\uc6a9\uc790\ub4e4\uc774 \ubcf8\uc778\uc758 \uc815\ubcf4\uac00 \uc218\uc0ac \uae30\uad00\uc5d0 \uc81c\uacf5\ub418\uc5c8\ub2e4\ub294 \uc0ac\uc2e4\uc744 \ud1b5\ubcf4\ubc1b\uc9c0 \ubabb\ud588\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc0ac \uae30\uad00\uc5d0 \uac1c\uc778\uc815\ubcf4 \uc81c\uacf5 \ud604\ud669\uc744 \uac70\ubd80\ud55c \uc774\ub3d9 \ud1b5\uc2e0\uc0ac\ub97c \uc0c1\ub300\ub85c \uc81c\uae30\ub41c \uc18c\uc1a1\uc5d0\uc11c 2\uc2ec \uc7ac\ud310\ubd80\ub294 \uc5b4\ub5a4 \ud310\uacb0\uc744 \ub0b4\ub838\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ub3d9 \ud1b5\uc2e0\uc0ac\uc758 \ud589\uc704\uac00 \ubd88\ubc95\uc774\ub77c\uace0 \ud310\uacb0\ud558\uc600\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\ub2f9\ud55c \uc81c\ub3c4\ub098 \ubc95\ub960\uc758 \uac1c\uc120\uc744 \uc694\uad6c\ud558\uae30 \uc704\ud574 \ud65c\uc6a9\ud560 \uc218 \uc788\ub294 \uc2dc\ubbfc \ucc38\uc5ec \ubc29\uc548\uc5d0\ub294 \ubb34\uc5c7\uc774 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uac70, \uc2dc\uc704, \uc11c\uba85 \uc6b4\ub3d9, \uacf5\uccad\ud68c \ucc38\uc5ec, \uccad\uc6d0, \ucea0\ud398\uc778 \ud65c\ub3d9 \ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud45c\uc790\ub97c \uc120\ucd9c\ud558\uc5ec \uad6d\uac00 \uc815\ucc45 \uacb0\uc815\uc5d0 \uac04\uc811\uc801\uc73c\ub85c \uc601\ud5a5\ub825\uc744 \ud589\uc0ac\ud558\ub294 \uac00\uc7a5 \uae30\ubcf8\uc801\uc778 \uc2dc\ubbfc \ucc38\uc5ec \ubc29\uc548\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uac70"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9d1\ub2e8\uc73c\ub85c \uc758\uc0ac\ub97c \ud45c\ud604\ud558\uc5ec \uc0ac\ud68c\uc801 \uc774\uc288\uc5d0 \ub300\ud55c \uc5ec\ub860\uc744 \ud615\uc131\ud558\uace0 \uc815\ubd80 \uc815\ucc45\uc5d0 \uc601\ud5a5\uc744 \uc8fc\ub294 \uc2dc\ubbfc \ucc38\uc5ec \ubc29\uc548\uc740?"
          }
        ]
