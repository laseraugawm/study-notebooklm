          {
            "type": "text",
            "content": "\ub864\uc2a4\uac00 \uc81c\uc2dc\ud55c \uc2dc\ubbfc\ubd88\ubcf5\uc885\uc758 \uc815\ub2f9\uc131 \uc694\uac74 \uc911 \ubaa9\uc801\uacfc \uad00\ub828\ub41c \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
