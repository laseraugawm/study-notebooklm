      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \uc5f0\ub839\ub300 \uace0\uac1d\uc758 \uc785\uc7a5 \uc790\uccb4\ub97c \uac70\ubd80\ud558\ub294 \uac83\uc740 \ucc28\ubcc4\uc774\ub77c\ub294 \uc2dc\ubbfc\ub4e4\uc758 \ubaa9\uc18c\ub9ac\uac00 \ucee4\uc84c\uae30 \ub54c\ubb38\uc774\ub2e4."
