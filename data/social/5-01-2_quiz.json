{
  "title": "\uc778\uad6c\ubb38\uc81c \ud034\uc988",
  "questions": [
    {
      "question": "\ucd5c\uadfc \ucd9c\uc0dd \uc778\uad6c\uac00 \uc904\uc5b4\ub4dc\ub294 \uc0ac\ud68c \uad6c\uc870\uc801 \uc6d0\uc778\uc5d0 \uc8fc\ubaa9\ud558\uc5ec '\uc544\uae30\uac00 \uc801\uac8c \ud0dc\uc5b4\ub09c\ub2e4'\ub294 \uc758\ubbf8\ub85c \uc8fc\ub85c \uc0ac\uc6a9\ub418\ub294 \uc6a9\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc800\ucd9c\uc0dd",
          "isCorrect": true,
          "rationale": "\uc800\ucd9c\uc0dd\uc740 \uc5ec\uc131\uc774 \uc544\ub2cc \uc544\uae30\uac00 \uc801\uac8c \ud0dc\uc5b4\ub098\ub294 \uc0ac\ud68c \uad6c\uc870\uc801 \uce21\uba74\uc5d0 \uc8fc\ubaa9\ud558\ub294 \uc6a9\uc5b4\ub85c \ucd5c\uadfc \uc8fc\ub85c \uc0ac\uc6a9\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc800\ucd9c\uc0b0",
          "isCorrect": false,
          "rationale": "\uc800\ucd9c\uc0b0\uc740 '\uc5ec\uc131\uc774 \uc544\uae30\ub97c \uc801\uac8c \ub0b3\ub294\ub2e4'\ub294 \uc758\ubbf8\ub97c \ub2f4\uace0 \uc788\uc5b4 \ucd5c\uadfc\uc5d0\ub294 \uc0ac\ud68c \uad6c\uc870\uc5d0 \uc8fc\ubaa9\ud558\ub294 \uc6a9\uc5b4\ub85c \ub300\uccb4\ub418\ub294 \uacbd\ud5a5\uc774 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uace0\ub839\ud654",
          "isCorrect": false,
          "rationale": "\uace0\ub839\ud654\ub294 \uc804\uccb4 \uc778\uad6c \uc911 65\uc138 \uc774\uc0c1 \ub178\ub144\uce35 \uc778\uad6c \ube44\uc728\uc774 \uc99d\uac00\ud558\ub294 \ud604\uc0c1\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uad6c \uacfc\uc789",
          "isCorrect": false,
          "rationale": "\uc778\uad6c \uacfc\uc789\uc740 \ubd80\uc591 \ub2a5\ub825\uc5d0 \ube44\ud574 \uc778\uad6c\uac00 \ub108\ubb34 \ub9ce\uc740 \uc0c1\ud0dc\ub97c \ub73b\ud558\uba70 \uc8fc\ub85c \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc5d0\uc11c \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc5ec\uc131\uc774 \uc544\uc774\ub97c \ub0b3\ub294 \uc8fc\uccb4\ub77c\ub294 \uc810\ubcf4\ub2e4 \uc0ac\ud68c \uc804\uccb4\uc5d0\uc11c \ud0dc\uc5b4\ub098\ub294 \uc544\uae30\uc758 \uc218\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd98 \uc6a9\uc5b4\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\uc77c\ucc0d \uc0b0\uc5c5\ud654\ub97c \uc774\ub8ec \uc720\ub7fd \ubc0f \ubd81\uc544\uba54\ub9ac\uce74 \ub4f1\uc758 \uc120\uc9c4\uad6d\uc5d0\uc11c \uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \ud604\uc0c1\uc774 \ub098\ud0c0\ub098\uac8c \ub41c \uc6d0\uc778\uc758 \uc870\ud569\uc73c\ub85c \uac00\uc7a5 \uc54c\ub9de\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uacb0\ud63c\uacfc \uc790\ub140\uc5d0 \ub300\ud55c \uac00\uce58\uad00 \ubcc0\ud654 \ubc0f \uc758\ud559 \uae30\uc220 \ubc1c\ub2ec\uacfc \uc0dd\ud65c \uc218\uc900 \ud5a5\uc0c1",
          "isCorrect": true,
          "rationale": "\uc120\uc9c4\uad6d\uc5d0\uc11c\ub294 \uac00\uce58\uad00 \ubcc0\ud654\ub85c \ucd9c\uc0dd\ub960\uc774 \uac10\uc18c\ud558\uace0 \uc758\ud559 \ubc1c\ub2ec \ubc0f \uc0dd\ud65c \uc218\uc900 \ud5a5\uc0c1\uc73c\ub85c \ud3c9\uade0 \uc218\uba85\uc774 \ub298\uc5b4\ub098 \uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654\uac00 \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub18d\ucd0c \uc9c0\uc5ed\uc73c\ub85c\uc758 \uc778\uad6c \uc720\ucd9c\uacfc \uc2dd\ub7c9 \uc0dd\uc0b0\ub7c9\uc758 \uae09\uaca9\ud55c \uac10\uc18c",
          "isCorrect": false,
          "rationale": "\uc120\uc9c4\uad6d\uc740 \ub3c4\uc2dc\ud654\uac00 \uc774\ubbf8 \uc9c4\uc804\ub41c \uc0c1\ud0dc\uc774\uba70 \uc2dd\ub7c9 \uac10\uc18c\uac00 \uc800\ucd9c\uc0dd\uc758 \uc9c1\uc811\uc801 \uc6d0\uc778\uc740 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\ucd0c\ub77d \uc0dd\ud65c \ud658\uacbd \uac1c\uc120 \uc815\ucc45 \ucd94\uc9c4\uacfc \uc0b0\uc544 \uc81c\ud55c \uc815\ucc45 \uac15\ud654",
          "isCorrect": false,
          "rationale": "\ucd0c\ub77d \ud658\uacbd \uac1c\uc120 \ubc0f \uc0b0\uc544 \uc81c\ud55c\uc740 \uc8fc\ub85c \uc778\uad6c \uacfc\uc789\uc744 \uacaa\ub294 \uac1c\ubc1c \ub3c4\uc0c1\uad6d \uad00\ub828 \uc778\uad6c \uc815\ucc45\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub192\uc740 \ucd9c\uc0dd\ub960 \uc720\uc9c0\uc640 \uc758\ud559 \uae30\uc220 \ubbf8\ube44\ub85c \uc778\ud55c \ub192\uc740 \uc0ac\ub9dd\ub960",
          "isCorrect": false,
          "rationale": "\ub192\uc740 \ucd9c\uc0dd\ub960\uacfc \ub192\uc740 \uc0ac\ub9dd\ub960\uc740 \uc0b0\uc5c5\ud654 \uc774\uc804\uc774\ub098 \uc77c\ubd80 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ucd9c\uc0dd\ub960 \uac10\uc18c\ub97c \uac00\uc838\uc628 \uac00\uce58\uad00\uc758 \ubcc0\ud654\uc640 \ud3c9\uade0 \uc218\uba85 \uc5f0\uc7a5\uc744 \uac00\uc838\uc628 \uc758\ud559\u00b7\uc0dd\ud65c \uc5ec\uac74 \uac1c\uc120\uc744 \uace0\ub824\ud558\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38 \ub0b4\uc6a9\uc5d0 \ub530\ub77c \uc120\uc9c4\uad6d\uc5d0\uc11c \uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \ud604\uc0c1\uc774 \uc9c0\uc18d\ub420 \ub54c \ubc1c\uc0dd\ud558\ub294 \uc0ac\ud68c\u00b7\uacbd\uc81c\uc801 \uc601\ud5a5\uc73c\ub85c \uc54c\ub9de\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc778\uad6c \uc790\uc5f0 \uc99d\uac00\uc728\uc774 \uae09\uc99d\ud558\uc5ec \uae30\uc544\uc640 \uc790\uc6d0 \ubd80\uc871 \ubb38\uc81c\uac00 \uc545\ud654\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\uc5f0 \uc99d\uac00\uc728 \uae09\uc99d\uacfc \uae30\uc544 \ubb38\uc81c\ub294 \uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654\ub97c \uacaa\ub294 \uc120\uc9c4\uad6d\uc774 \uc544\ub2cc \uc778\uad6c \uacfc\uc789\uc744 \uacaa\ub294 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc758 \ubb38\uc81c\uc810\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0 \uc5f0\ub839 \uc778\uad6c\uac00 \uc904\uc5b4\ub4e4\uc5b4 \ub178\ub3d9 \uc0dd\uc0b0\uc131\uc774 \uac10\uc18c\ud558\uace0 \uacbd\uae30\uac00 \uce68\uccb4\ub420 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uccad\uc7a5\ub144\uce35 \uc778\uad6c \uac10\uc18c\ub294 \ub178\ub3d9\ub825 \ubd80\uc871\uacfc \uacbd\uc81c \uc131\uc7a5 \ub454\ud654\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\ub178\ub144\uce35 \ube48\uace4 \ubc0f \ub178\uc778 \uc18c\uc678 \ubb38\uc81c\uac00 \uc2ec\uac01\ud574\uc9c8 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uace0\ub839 \uc0ac\ud68c\ub85c \uc811\uc5b4\ub4e4\uba74\uc11c \ub178\uc778 \ubcf5\uc9c0 \ubc0f \uc18c\uc678 \ubb38\uc81c\uac00 \uc8fc\uc694 \uc0ac\ud68c \ubb38\uc81c\ub85c \ub5a0\uc624\ub985\ub2c8\ub2e4."
        },
        {
          "text": "\uc77c\uc790\ub9ac\uc640 \ubd80\uc591 \ubd80\ub2f4\uc744 \ub458\ub7ec\uc2fc \uc138\ub300 \uac04 \uac08\ub4f1\uc774 \uc99d\uac00\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uccad\uc7a5\ub144\uce35\uc758 \ub178\ub144\uce35 \ubd80\uc591 \ubd80\ub2f4 \uc99d\uac00\ub85c \uc778\ud574 \uc138\ub300 \uac04 \uac08\ub4f1\uc774 \uc720\ubc1c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc778\uad6c \uc790\uc5f0 \uc99d\uac00\uc728\uc774 \ub192\uc544 \uc790\uc6d0\uc774 \ubd80\uc871\ud574\uc9c0\ub294 \uac83\uc740 \ucd9c\uc0dd\ub960\uc774 \ub192\uc740 \uad6d\uac00\uc758 \uc0c1\ud669\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\ub2c8\uc81c\ub974\uc640 \uac19\uc740 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc758 \uc778\uad6c \ubb38\uc81c \ubc0f \uc778\uad6c \uad6c\uc870\uc801 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ub9dd\ub960\uc740 \ub0ae\uc544\uc84c\uc73c\ub098 \ucd9c\uc0dd\ub960\uc774 \uc5ec\uc804\ud788 \ub192\uc544 \uc778\uad6c \uacfc\uc789 \ud604\uc0c1\uc774 \ub098\ud0c0\ub09c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc740 \uc758\ub8cc \uae30\uc220 \ub3c4\uc785 \ub4f1\uc73c\ub85c \uc0ac\ub9dd\ub960\uc774 \uac10\uc18c\ud588\uc9c0\ub9cc \ucd9c\uc0dd\ub960\uc774 \ub192\uac8c \uc720\uc9c0\ub418\uc5b4 \uc778\uad6c\uac00 \uae09\uaca9\ud788 \uc99d\uac00\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub178\ub144\uce35 \uc778\uad6c \ube44\uc728\uc774 \uc120\uc9c4\uad6d\ubcf4\ub2e4 \uc0c1\ub300\uc801\uc73c\ub85c \ub9e4\uc6b0 \ub192\uac8c \ub098\ud0c0\ub09c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub178\ub144\uce35(65\uc138 \uc774\uc0c1) \uc778\uad6c \ube44\uc728\uc740 \uacbd\uc81c\uac00 \ubc1c\ub2ec\ud55c \uc120\uc9c4\uad6d\uc5d0\uc11c \ub354 \ub192\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "\uc720\uc18c\ub144\uce35 \uc778\uad6c \ube44\uc728\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uac10\uc18c\ud558\uc5ec \ud559\uad50 \uc2dc\uc124 \ucd95\uc18c\uac00 \uc2dc\uae09\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc740 \uc120\uc9c4\uad6d\uc5d0 \ube44\ud574 \uc720\uc18c\ub144\uce35(0~14\uc138) \uc778\uad6c \ube44\uc728\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \ub192\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub178\ub3d9\ub825 \ubd80\uc871 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc774\uc8fc \ub178\ub3d9\uc790 \uc720\uc785 \uc815\ucc45\uc744 \uc2dc\ud589\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc740 \ub178\ub3d9\ub825 \ubd80\uc871\ubcf4\ub2e4\ub294 \uace0\uc6a9 \ucc3d\ucd9c \uc800\ud558\uc5d0 \ub530\ub978 \uc77c\uc790\ub9ac \ubd80\uc871 \ubb38\uc81c\ub97c \uacaa\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc758\ud559 \ubc1c\ub2ec \ub4f1\uc73c\ub85c \uc0ac\ub9dd\uc790\ub294 \uc904\uc5c8\uc73c\ub098 \ucd9c\uc0dd\uc544 \uc218\uac00 \uc904\uc5b4\ub4e4\uc9c0 \uc54a\uc544 \ubc1c\uc0dd\ud558\ub294 \ud604\uc0c1\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc778\ub3c4\uc758 \ub2e4\ub77c\ube44 \uc9c0\uc5ed \uc0ac\ub840\uc640 \uac19\uc774 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc5d0\uc11c \ub3c4\uc2dc \uc778\uad6c \uc9d1\uc911 \ubc0f \uae09\uaca9\ud55c \uc778\uad6c \uc99d\uac00\ub85c \uc778\ud574 \ub098\ud0c0\ub098\ub294 \ubb38\uc81c\uc810\uc774 \uc544\ub2cc \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub178\ub144\uce35 \uc778\uad6c \ubd80\uc591\uc744 \uc704\ud55c \uc0ac\ud68c \ubcf4\uc7a5 \uc5f0\uae08 \uc7ac\uc815\uc758 \uace0\uac08",
          "isCorrect": true,
          "rationale": "\uace0\ub839\ud654\uc5d0 \ub530\ub978 \uc5f0\uae08 \uc7ac\uc815 \ubb38\uc81c\ub294 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc758 \ub3c4\uc2dc \uc9d1\uc911 \ubb38\uc81c\ub77c\uae30\ubcf4\ub2e4 \uc120\uc9c4\uad6d\uc758 \uace0\ub839\ud654 \ud604\uc0c1\uc5d0 \ub530\ub978 \ubb38\uc81c\uc810\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc77c\uc790\ub9ac \ucc3d\ucd9c \uc18d\ub3c4\uac00 \uc778\uad6c \uc99d\uac00 \uc18d\ub3c4\ub97c \ub530\ub77c\uac00\uc9c0 \ubabb\ud558\ub294 \uc77c\uc790\ub9ac \ubd80\uc871 \ubb38\uc81c",
          "isCorrect": false,
          "rationale": "\uc778\uad6c \uc99d\uac00 \ubc0f \uc720\uc785 \uc18d\ub3c4\ubcf4\ub2e4 \uace0\uc6a9 \ucc3d\ucd9c \uc18d\ub3c4\uac00 \ub290\ub824 \uc77c\uc790\ub9ac \ubd80\uc871 \ubb38\uc81c\uac00 \uc2ec\ud654\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uac11\uc791\uc2a4\ub7ec\uc6b4 \uc778\uad6c \uc720\uc785\uc5d0 \ub530\ub978 \uc8fc\ud0dd \ubc0f \uc0ac\ud68c \uae30\ubc18 \uc2dc\uc124 \ubd80\uc871",
          "isCorrect": false,
          "rationale": "\ub3c4\uc2dc\ub85c \uacfc\ub3c4\ud55c \uc778\uad6c\uac00 \ubab0\ub9ac\uba74\uc11c \uc8fc\ud0dd \ubd80\uc871\uacfc \ub3c4\ub85c\u00b7\uc218\ub3c4 \ub4f1 \uae30\ubc18 \uc2dc\uc124 \ubd80\uc871\uc774 \ubc1c\uc0dd\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uad6c \uacfc\ubc00\ub85c \uc778\ud55c \uc8fc\uac70 \ud658\uacbd \uc545\ud654 \ubc0f \uc2ac\ub7fc \uc9c0\uc5ed \ud615\uc131",
          "isCorrect": false,
          "rationale": "\ub3c4\uc2dc\ub85c \uc3e0\ub9b0 \uc778\uad6c\ub85c \uc778\ud574 \uc5f4\uc545\ud55c \ud658\uacbd\uc758 \ube48\ubbfc \uc9c0\uc5ed(\uc2ac\ub7fc\uac00)\uc774 \ud615\uc131\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub3c4\uc2dc\ud654\uc640 \uc778\uad6c \uacfc\uc789\uc73c\ub85c \uc0dd\uae30\ub294 \uc790\uc6d0\u00b7\uc2dc\uc124 \ubd80\uc871\uc774 \uc544\ub2cc, \ub178\ub839\ud654 \uad00\ub828 \uad6d\uac00 \uc7ac\uc815 \ubb38\uc81c\ub97c \ucc3e\uc73c\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38\uc5d0 \uc81c\uc2dc\ub41c \uad6d\uac00\ubcc4 \uc778\uad6c \uc815\ucc45 \uc911 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc758 \uc778\uad6c \ubb38\uc81c \ud574\uacb0 \ubc29\uc548\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2dd\ub7c9 \uc99d\uc0b0 \uc815\ucc45, \uc0b0\uc544 \uc81c\ud55c \uc815\ucc45, \ucd0c\ub77d \ud658\uacbd \uac1c\uc120 \ubc0f \uc911\uc18c \ub3c4\uc2dc \uc721\uc131",
          "isCorrect": true,
          "rationale": "\uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc740 \uc778\uad6c \uacfc\uc789 \uadf9\ubcf5\uc744 \uc704\ud574 \uc2dd\ub7c9 \uc99d\uc0b0\uacfc \uc0b0\uc544 \uc81c\ud55c\uc744, \ub3c4\uc2dc \uc9d1\uc911 \ud574\uc18c\ub97c \uc704\ud574 \ucd0c\ub77d \uac1c\uc120 \ubc0f \uc911\uc18c \ub3c4\uc2dc \uc721\uc131\uc744 \ucd94\uc9c4\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ucd9c\uc0b0 \uc7a5\ub824\uae08 \uc9c0\uc6d0, \uc721\uc544 \ud734\uc9c1 \ubcf4\uc7a5, \uc720\uc5f0 \uadfc\ubb34\uc81c \ud655\ub300",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \uc800\ucd9c\uc0dd \ubb38\uc81c\ub97c \uacaa\uace0 \uc788\ub294 \uc120\uc9c4\uad6d\uc5d0\uc11c \uc8fc\ub85c \ucd94\uc9c4\ud558\ub294 \uc815\ucc45\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ub144 \uc5f0\uc7a5, \ub178\ub144\uce35 \uc77c\uc790\ub9ac \ud655\ub300, \uc548\uc815\uc801 \uc5f0\uae08 \uc81c\ub3c4 \uc6b4\uc601",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \uace0\ub839\ud654 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc120\uc9c4\uad6d \ub4f1\uc774 \ucd94\uc9c4\ud558\ub294 \ub178\ub144\uce35 \ub300\uc0c1 \uc815\ucc45\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uccad\ub144 \uc8fc\ud0dd \ud2b9\ubcc4 \uacf5\uae09 \ubc0f \uccad\ub144 \uc77c\uc790\ub9ac \ud655\ubcf4 \uc815\ucc45",
          "isCorrect": false,
