      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc608\uae08\uacfc \uc8fc\uc2dd \uac04\uc758 \uc218\uc775\uc131 \uaca9\ucc28\uac00 \uc904\uc5b4\ub4e4\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
