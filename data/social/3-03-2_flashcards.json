    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc900 \uae08\ub9ac \uc778\uc0c1\uc73c\ub85c \uc608\uae08 \uae08\ub9ac\uac00 \uc0c1\uc2b9\ud560 \ub54c, \uc8fc\uc2dd \uc2dc\uc7a5\uc758 \uc0c1\ub300\uc801 \ub9e4\ub825\uc774 \uac10\uc18c\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
