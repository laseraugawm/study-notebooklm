      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc608\uae08 \uae08\ub9ac\uc640 \ub300\ucd9c \uae08\ub9ac\uac00 \ubaa8\ub450 \uc0c1\uc2b9\ud569\ub2c8\ub2e4."
