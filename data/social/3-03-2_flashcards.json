          {
            "type": "text",
            "content": "2008\ub144 \uc138\uacc4 \uae08\uc735 \uc704\uae30\ub97c \uc720\ubc1c\ud55c \uc9c1\uc811\uc801\uc778 \uacc4\uae30\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
