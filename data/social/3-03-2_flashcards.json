      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uc758 \uc790\uae08 \uc870\ub2ec \ube44\uc6a9(\uc774\uc790 \ubd80\ub2f4)\uc774 \uc99d\uac00\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
