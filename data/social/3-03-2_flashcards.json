      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uacbd\uc81c\uc758 \ubcc0\ud654\uac00 \uc790\uad6d \uae08\uc735 \ud658\uacbd\uacfc \uac1c\uc778\uc758 \uae08\uc735 \uc758\uc0ac \uacb0\uc815\uc5d0 \ub354 \uac15\ud558\uac8c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4."
