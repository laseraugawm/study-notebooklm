          {
            "type": "text",
            "content": "\uc218\uc775\uc131\ubcf4\ub2e4\ub294 \uc548\uc804\uc131\uacfc \uc720\ub3d9\uc131\uc5d0 \ucd08\uc810\uc744 \ub450\uace0 \uae08\uc735 \uc758\uc0ac\ub97c \uacb0\uc815\ud574\uc57c \ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2020\ub144 \ucf54\ub85c\ub09819\uc640 \uac19\uc740 \uac10\uc5fc\ubcd1\uc774 \uc804 \uc138\uacc4\uc801\uc73c\ub85c \uc720\ud589\ud588\uc744 \ub54c \ud070 \ud53c\ud574(\uc8fc\uac00\u00b7\ucc44\uad8c \uac00\uaca9 \ud558\ub77d \ubc0f \ub3c4\uc0b0)\ub97c \uc785\uc740 \ub300\ud45c\uc801 \uc5c5\uc885 \ub450 \uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud56d\uacf5 \uad00\ub828 \uae30\uc5c5 \ubc0f \uad00\uad11 \uad00\ub828 \uae30\uc5c5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2020\ub144 \ud32c\ub370\ubbf9 \uc0c1\ud669\uc5d0\uc11c \uc624\ud788\ub824 \uc218\ud61c\ub97c \ubc1b\uc544 \uc8fc\uac00 \uc0c1\uc2b9\uc774\ub098 \ud22c\uc790 \uc774\ub4dd\uc744 \ubcf8 \uc5c5\uc885 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\ub2ec \ud50c\ub7ab\ud3fc, \uc628\ub77c\uc778 \uad50\uc721 \uc11c\ube44\uc2a4, \ubc14\uc774\uc624 \uad00\ub828 \uc5c5\uacc4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ub0b4 \ucf54\ub85c\ub09819 \ubc1c\uc0dd \ud6c4 1\ub144 \ub3d9\uc548 \ubc95\uc6d0\uc5d0 \uc811\uc218\ub41c \ubc95\uc778 \ud30c\uc0b0 \uc2e0\uccad \uac74\uc218\ub294 \uc804\ub144 \ub3d9\uae30 \ub300\ube44 \uc57d \uba87 % \uc99d\uac00\ud588\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc57d 11.7% \uc99d\uac00 (939\uac74\uc5d0\uc11c 1,049\uac74\uc73c\ub85c \uc99d\uac00)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ub0b4 \ucf54\ub85c\ub09819 \ubc1c\uc0dd \ud6c4 1\ub144 \ub3d9\uc548 \ubc95\uc6d0\uc5d0 \uc811\uc218\ub41c \uac1c\uc778 \ud30c\uc0b0 \uc2e0\uccad \uac74\uc218\ub294 \uc804\ub144 \ub3d9\uae30 \ub300\ube44 \uc57d \uba87 % \uc99d\uac00\ud588\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc57d 13% \uc99d\uac00 (45,081\uac74\uc5d0\uc11c 50,925\uac74\uc73c\ub85c \uc99d\uac00)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4\uc704\uae30\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud55c \ubc29\uc548\uc73c\ub85c \ub300\ub450\ub418\uc5c8\uc73c\uba70 \uce5c\ud658\uacbd \uc5d0\ub108\uc9c0 \uc0b0\uc5c5\uc758 \uc8fc\ubaa9\uc744 \uc774\ub048 \uacbd\uc81c \uc131\uc7a5 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\ud0c4\uc18c \ub179\uc0c9 \uc131\uc7a5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4\uc704\uae30 \ubc0f \uc800\ud0c4\uc18c \uc815\ucc45 \uc2ec\ud654\uc5d0 \ub530\ub978 \uce5c\ud658\uacbd \uc5d0\ub108\uc9c0 \uae30\uc5c5\uacfc \uc628\uc2e4\uac00\uc2a4 \ub2e4\ubc30\ucd9c \uae30\uc5c5\uc758 \ud22c\uc790 \uc218\uc775\ub960 \ubcc0\ud654 \ubc29\ud5a5\uc740 \uac01\uac01 \uc5b4\ub5a0\ud588\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce5c\ud658\uacbd \uc5d0\ub108\uc9c0 \uad00\ub828 \uae30\uc5c5\uc758 \ud22c\uc790 \uc218\uc775\ub960\uc740 \ub192\uc544\uc9c4 \ubc18\uba74, \uc628\uc2e4\uac00\uc2a4 \ub2e4\ubc30\ucd9c \uae30\uc5c5\uc758 \ud22c\uc790 \uc218\uc775\ub960\uc740 \ud558\ub77d\ud558\uc600\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uc774 \uacbd\uc601 \uc790\uae08\uc744 \ub9c8\ub828\ud558\uace0\uc790 \ud22c\uc790\uc790\ub85c\ubd80\ud130 \ub3c8\uc744 \ubc1b\uace0 \ubc1c\ud589\ud558\ub294 \uc99d\uc11c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc2dd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\uc720\ud55c \uc790\uc0b0\uc744 \ud544\uc694\ud560 \ub54c \uc27d\uac8c \ud604\uae08\uc73c\ub85c \ubc14\uafc0 \uc218 \uc788\ub294 \uc815\ub3c4\ub97c \ub098\ud0c0\ub0b4\ub294 \uc790\uc0b0 \uad00\ub9ac \uc6d0\uce59\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\ub3d9\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc0b0 \uad00\ub9ac 3\ub300 \uc6d0\uce59 \uc911 \ud22c\uc790 \uc6d0\uae08\uc5d0 \uc190\uc2e4\uc774 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\ub294 \uc815\ub3c4\ub97c \uac00\ub9ac\ud0a4\ub294 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc548\uc804\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2023\ub144 \ubbf8\uad6d \ubca4\ucc98 \ud22c\uc790 \uc804\ubb38 A \uc740\ud589\uc758 \ud30c\uc0b0 \ubc0f \uc2a4\uc704\uc2a4 B \uc740\ud589 \ud30c\uc0b0 \uc704\uae30 \uc18c\uc2dd\uc774 \uad6d\ub0b4\uc678 \uae08\uc735 \uc2dc\uc7a5\uc5d0 \ubbf8\uce5c \uacf5\ud1b5\uc801 \ud30c\uae09 \ud6a8\uacfc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uad6d\uacfc \uc720\ub7fd \uc740\ud589\uc758 \uc8fc\uac00\uac00 \ud06c\uac8c \ud558\ub77d\ud558\uace0 \uae08\uc735 \uc2dc\uc7a5 \uc804\uccb4\uc758 \ubcc0\ub3d9\uc131\uacfc \ubd88\uc548\uc815\uc131\uc774 \uae09\uaca9\ud788 \ud655\ub300\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae08\uc735 \ud658\uacbd \uc694\uc778\uc774 \ub04a\uc784\uc5c6\uc774 \ub2e4\uc591\ud558\uace0 \ubcf5\uc7a1\ud558\uac8c \ubcc0\ud560 \ub54c, \uac1c\uc778\uc758 \uc62c\ubc14\ub978 \uc790\uc0b0 \uad00\ub9ac \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7ac\ubb34 \ubaa9\ud45c\uc640 \uae08\uc735 \uc0dd\ud65c \uc124\uacc4\ub97c \uafb8\uc900\ud788 \uc810\uac80\ud558\uace0 \ud658\uacbd \ubcc0\ud654\uc5d0 \ub9de\ucdb0 \uc9c0\uc18d\uc801\uc73c\ub85c \uc218\uc815\u00b7\ubcf4\uc644\ud574\uc57c \ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc900 \uae08\ub9ac \uc678\uc5d0\ub3c4 \uac1c\uc778\uc758 \uae08\uc735 \uc758\uc0ac \uacb0\uc815\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc8fc\uc694 \uacbd\uc81c \uc694\uc778 3\uac00\uc9c0\ub97c \uc81c\uc2dc\ud574 \ubcf4\uc138\uc694."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uc728, \ubb34\uc5ed \uc218\uc9c0, \uad6d\uac00 \uc2e0\uc778\ub3c4 (\uae00\ub85c\ubc8c \uacbd\uae30 \ud750\ub984 \ub4f1)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc2dd\uacfc \uc608\uae08\uc744 \ube44\uad50\ud560 \ub54c, '\uc548\uc804\uc131'\uacfc '\uc218\uc775\uc131' \uce21\uba74\uc758 \uc0c1\ucda9 \uad00\uacc4(Trade-off)\ub97c \uc11c\uc220\ud574 \ubcf4\uc138\uc694."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc2dd\uc740 \uc608\uae08\ubcf4\ub2e4 \ub192\uc740 \uc218\uc775\uc131\uc744 \uae30\ub300\ud560 \uc218 \uc788\uc73c\ub098 \uc548\uc804\uc131\uc774 \ub0ae\uace0, \uc608\uae08\uc740 \ub192\uc740 \uc548\uc804\uc131\uc744 \uc9c0\ub2c8\uc9c0\ub9cc \uc0c1\ub300\uc801\uc73c\ub85c \uc218\uc775\uc131\uc774 \ub0ae\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\uc720 \ubc0f \uc6d0\uc790\uc7ac \uac00\uaca9 \uae09\ub4f1\uc73c\ub85c \uc778\ud50c\ub808\uc774\uc158 \uc555\ub825\uc774 \uc2ec\ud654\ub420 \ub54c \ubbfc\uac04 \uae30\uc5c5\uc758 \ud22c\uc790 \uc2ec\ub9ac\ub294 \uc5b4\ub5bb\uac8c \ubcc0\ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc6a9 \uc99d\uac00 \ubc0f \uc2e4\ubb3c \uacbd\uae30 \ubd88\uc548\uc73c\ub85c \uae30\uc5c5\ub4e4\uc740 \uc2e0\uaddc \ud22c\uc790\ub97c \ubcf4\ub958\ud558\uac70\ub098 \ucd95\uc18c\ud558\uac8c \ub429\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae08\uc735 \uc2dc\uc7a5 \ubd88\uc548\uae30\uc5d0 \uc720\ub3d9\uc131\uc774 \ub6f0\uc5b4\ub09c \uc790\uc0b0(\uc608: \ud604\uae08\uc131 \uc790\uc0b0)\uc758 \ubcf4\uc720 \uac00\uce58\uac00 \ub192\uc544\uc9c0\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc0b0 \uac00\uaca9\uc774 \ud558\ub77d\ud560 \ub54c \uae34\uae09 \uc790\uae08\uc744 \uc27d\uac8c \ud604\uae08\ud654\ud558\uc5ec \ud30c\uc0b0 \uc704\ud5d8\uc5d0 \ub300\uc751\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uad6d\uac00\uc758 \uad6d\uac00 \uc2e0\uc778\ub3c4\uac00 \ud558\ub77d\ud560 \uacbd\uc6b0 \uadf8 \uad6d\uac00\uc758 \uae30\uc5c5\ub4e4\uc774 \ud574\uc678 \uc2dc\uc7a5\uc5d0\uc11c \uc790\uae08\uc744 \uc870\ub2ec\ud560 \ub54c \ubc1c\uc0dd\ud558\ub294 \ubb38\uc81c\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uc678 \uc2e0\ub8b0\ub3c4\uac00 \ub5a8\uc5b4\uc838 \uc790\uae08\uc744 \ube4c\ub9b4 \ub54c \ub192\uc740 \uac00\uc0b0 \uae08\ub9ac\ub97c \uc9c0\ubd88\ud574\uc57c \ud558\ubbc0\ub85c \uc870\ub2ec \ube44\uc6a9\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae08\uc735 \uc758\uc0ac \uacb0\uc815\uc5d0 \ubbf8\uce58\ub294 \uc694\uc778\uc744 \uacbd\uc81c\uc801 \uc694\uc778, \uc815\uce58\uc801 \uc694\uc778, \uae30\ud0c0 \uc0ac\ud68c\u00b7\ud658\uacbd\uc801 \uc694\uc778\uc73c\ub85c \uad6c\ubd84\ud560 \ub54c \uac01 \uc694\uc778\uc758 \ub300\ud45c\uc801 \uc0ac\ub840\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\uc801 \uc694\uc778: \uae30\uc900 \uae08\ub9ac \uc778\uc0c1, \uc815\uce58\uc801 \uc694\uc778: \uc804\uc7c1\u00b7\ud601\uba85, \uae30\ud0c0 \uc694\uc778: \uac10\uc5fc\ubcd1 \uc720\ud589\u00b7\uae30\ud6c4 \uc704\uae30"
          }
        ]
      }
    }
  ]
}