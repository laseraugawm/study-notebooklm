      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\uc801 \ud658\uacbd \uc694\uc778\uacfc \uc815\uce58\uc801 \ud658\uacbd \uc694\uc778"
