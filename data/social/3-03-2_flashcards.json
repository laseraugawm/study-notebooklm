      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uccb4\ub85c \uc8fc\uc2dd \uc2dc\uc7a5\uc5d0 \ubd80\uc815\uc801\uc778 \uc601\ud5a5(\uc8fc\uac00 \ud558\ub77d)\uc744 \ubbf8\uce69\ub2c8\ub2e4."
