          {
            "type": "text",
            "content": "\ubbf8\uad6d\uc758 \uc9d1\uac12 \uae09\ub77d\uc73c\ub85c \uc778\ud55c \ub300\ucd9c\uc790 \ud30c\uc0b0\uacfc \uc774\uc5d0 \ub530\ub978 \ub300\ud615 \ud22c\uc790\uc740\ud589\ub4e4\uc758 \uc5f0\uc1c4 \ud30c\uc0b0"
