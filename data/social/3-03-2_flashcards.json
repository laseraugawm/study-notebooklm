    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ucd9c \uae08\ub9ac\uc758 \uc0c1\uc2b9\uc774 \uae30\uc5c5 \uc2e4\uc801\uc5d0 \ubd80\uc815\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc8fc\uc694 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
