    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18\uc801\uc73c\ub85c \uae30\uc900 \uae08\ub9ac\uac00 \uc0c1\uc2b9\ud558\uba74 \uc8fc\uc2dd \uc2dc\uc7a5\uc5d0\ub294 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?"
