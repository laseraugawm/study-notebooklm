    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d\uc740\ud589\uc774 \uae30\uc900 \uae08\ub9ac\ub97c \uc778\uc0c1\ud558\uba74 \uc2dc\uc911 \uc740\ud589\uc758 \uc608\uae08 \uae08\ub9ac\uc640 \ub300\ucd9c \uae08\ub9ac\ub294 \uc5b4\ub5bb\uac8c \ubcc0\ud558\ub098\uc694?"
