{
  "title": "\uac70\uc2dc\ud658\uacbd \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc774 \uae08\uc735 \uc758\uc0ac \uacb0\uc815\uc744 \ud560 \ub54c \uace0\ub824\ud574\uc57c \ud558\ub294 \uac70\uc2dc\uc801 \ud658\uacbd \uc694\uc778\uc758 \ub300\ud45c\uc801\uc778 \ub450 \uac00\uc9c0 \ubd84\uc57c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
