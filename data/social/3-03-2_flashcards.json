    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc5ed \uc758\uc874\ub3c4\uac00 \ub192\uc740 \uad6d\uac00\uc77c\uc218\ub85d \uae00\ub85c\ubc8c \uacbd\uc81c \ud750\ub984 \ubcc0\ud654\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubc1b\ub098\uc694?"
