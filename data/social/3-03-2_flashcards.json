    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ub0b4 \uacbd\uae30 \ubcc0\ub3d9\uc73c\ub85c \uc778\ud50c\ub808\uc774\uc158\uc774 \ubc1c\uc0dd\ud560 \ub54c \ud55c\uad6d\uc740\ud589(\uc911\uc559\uc740\ud589)\uc774 \uc8fc\ub85c \uacb0\uc815\ud558\ub294 \uae08\ub9ac \uc815\ucc45\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
