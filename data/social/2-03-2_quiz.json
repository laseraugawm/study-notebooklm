{
  "title": "\uc0ac\ud68c \uc815\uc758 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc6b0\ub9ac\ub098\ub77c\uc758 \uc8fc\uc694 \uc0ac\ud68c \ubcf5\uc9c0 \uc81c\ub3c4\ub294 \uc0ac\ud68c \ubcf4\ud5d8, \uacf5\uacf5 \ubd80\uc870, \uc0ac\ud68c \uc11c\ube44\uc2a4\ub85c \uad6c\ubd84\ub41c\ub2e4. \uc774 \uc138 \uc81c\ub3c4\uc758 \uc6b4\uc601 \uc6d0\uce59\uacfc \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ud68c \ubcf4\ud5d8\uacfc \uacf5\uacf5 \ubd80\uc870\ub294 \uae08\uc804\uc801 \uc9c0\uc6d0\uc744, \uc0ac\ud68c \uc11c\ube44\uc2a4\ub294 \ube44\uae08\uc804\uc801 \uc9c0\uc6d0\uc744 \uc6d0\uce59\uc73c\ub85c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\ud68c \ubcf4\ud5d8\uacfc \uacf5\uacf5 \ubd80\uc870\ub294 \uc5f0\uae08\uc774\ub098 \uae09\uc5ec \ub4f1 \uae08\uc804\uc801 \uc9c0\uc6d0\uc744 \uc81c\uacf5\ud558\ub294 \ubc18\uba74, \uc0ac\ud68c \uc11c\ube44\uc2a4\ub294 \uc0c1\ub2f4, \ub3cc\ubd04, \uc7ac\ud65c \ub4f1 \ube44\uae08\uc804\uc801 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\ub294 \uac83\uc744 \uc6d0\uce59\uc73c\ub85c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\uacf5 \ubd80\uc870\ub294 \ubbf8\ub798\uc5d0 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc0ac\ud68c\uc801 \uc704\ud5d8\uc5d0 \ub300\ube44\ud558\uae30 \uc704\ud55c \uc0ac\uc804 \uc608\ubc29\uc801 \uc131\uaca9\uc744 \uac00\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c8\ubcd1, \ub178\ub839, \uc2e4\uc5c5 \ub4f1 \ubbf8\ub798\uc758 \uc704\ud5d8\uc5d0 \ub300\ube44\ud558\ub294 \uc0ac\uc804 \uc608\ubc29\uc801 \uc81c\ub3c4\ub294 \uacf5\uacf5 \ubd80\uc870\uac00 \uc544\ub2c8\ub77c \uc0ac\ud68c \ubcf4\ud5d8\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c \uc11c\ube44\uc2a4\ub294 \uc0dd\ud65c \uc720\uc9c0 \ub2a5\ub825\uc774 \uc5c6\ub294 \uad6d\ubbfc\uc758 \ucd5c\uc800 \uc0dd\ud65c\uc744 \ubcf4\uc7a5\ud558\ub294 \uac83\uc744 \ucd5c\uc6b0\uc120 \ubaa9\uc801\uc73c\ub85c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\ud65c \uc720\uc9c0 \ub2a5\ub825\uc774 \uc5c6\ub294 \uad6d\ubbfc\uc758 \ucd5c\uc800 \uc0dd\ud65c\uc744 \ubcf4\uc7a5\ud558\uace0 \uc790\ub9bd\uc744 \ub3d5\ub294 \uc81c\ub3c4\ub294 \uacf5\uacf5 \ubd80\uc870\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c \ubcf4\ud5d8\uc740 \uad6d\uac00\uac00 \ube44\uc6a9\uc744 \uc804\uc561 \ubd80\ub2f4\ud558\uba70, \uc218\ud61c \ub300\uc0c1\uc790\ub294 \ube44\uc6a9\uc744 \uc804\ud600 \ubd80\ub2f4\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ud68c \ubcf4\ud5d8\uc740 \uc218\uc775\uc790 \ubd80\ub2f4 \uc6d0\uce59\uc5d0 \ub530\ub77c \uac00\uc785\uc790\uc640 \uc0ac\uc5c5\uc8fc \ub4f1\uc774 \ube44\uc6a9\uc744 \ubd84\ub2f4\ud558\uba70, \uad6d\uac00\uac00 \uc804\uc561 \ubd80\ub2f4\ud558\ub294 \uac83\uc740 \uacf5\uacf5 \ubd80\uc870\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac01 \ubcf5\uc9c0 \uc81c\ub3c4\uac00 \uc9c0\uc6d0\ud558\ub294 \ubc29\uc2dd(\uae08\uc804\uc801/\ube44\uae08\uc804\uc801)\uacfc \ub300\uc0c1\uc790 \ube44\uc6a9 \ubd80\ub2f4 \uc5ec\ubd80\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c (\uac00)\uc640 (\ub098) \uc0ac\ub840\uc5d0 \ud574\ub2f9\ud558\ub294 \ubcf5\uc9c0 \uc81c\ub3c4\uc758 \uc720\ud615\uc744 \uc21c\uc11c\ub300\ub85c \ubc14\ub974\uac8c \uc9dd\uc9c0\uc740 \uac83\uc740?\n\n(\uac00) \uacbd\uae30 \ubd88\ud669\uc73c\ub85c \ud574\uace0\ub41c \uadfc\ub85c\uc790\uc5d0\uac8c \uc2e4\uc5c5 \uae09\uc5ec\ub97c \uc9c0\uae09\ud558\uace0 \uc9c1\uc5c5 \ub2a5\ub825 \uac1c\ubc1c \uc0ac\uc5c5\uc744 \uc9c0\uc6d0\ud568.\n(\ub098) \uc0dd\ud65c\uc774 \uc5b4\ub824\uc6b4 \uc0ac\ub78c\uc5d0\uac8c \uc0dd\uacc4\u00b7\uc8fc\uac70\u00b7\uc758\ub8cc\u00b7\uad50\uc721 \uae09\uc5ec\ub97c \uc9c0\uae09\ud558\uc5ec \ucd5c\uc800 \uc0dd\ud65c\uc744 \ubcf4\uc7a5\ud568.",
      "answerOptions": [
        {
          "text": "(\uac00) \uc0ac\ud68c \ubcf4\ud5d8 - (\ub098) \uacf5\uacf5 \ubd80\uc870",
          "isCorrect": true,
          "rationale": "(\uac00)\uc758 \uace0\uc6a9 \ubcf4\ud5d8(\uc2e4\uc5c5 \uae09\uc5ec)\uc740 \uc0ac\ud68c \ubcf4\ud5d8\uc5d0 \ud574\ub2f9\ud558\uba70, (\ub098)\uc758 \uad6d\ubbfc \uae30\ucd08 \uc0dd\ud65c \ubcf4\uc7a5 \uc81c\ub3c4\ub294 \uacf5\uacf5 \ubd80\uc870\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "(\uac00) \uacf5\uacf5 \ubd80\uc870 - (\ub098) \uc0ac\ud68c \uc11c\ube44\uc2a4",
          "isCorrect": false,
          "rationale": "\uc2e4\uc5c5 \uae09\uc5ec \uc9c0\uae09\uc740 \uac15\uc81c \uac00\uc785 \uae30\ubc18\uc758 \uc0ac\ud68c \ubcf4\ud5d8\uc774\uba70, \ucd5c\uc800 \uc0dd\ud65c \ubcf4\uc7a5 \uae09\uc5ec \uc9c0\uae09\uc740 \uacf5\uacf5 \ubd80\uc870\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "(\uac00) \uc0ac\ud68c \uc11c\ube44\uc2a4 - (\ub098) \uc0ac\ud68c \ubcf4\ud5d8",
          "isCorrect": false,
          "rationale": "\uace0\uc6a9 \ubcf4\ud5d8\uc740 \uc0ac\ud68c \ubcf4\ud5d8\uc5d0 \uc18d\ud558\uba70, \uc0dd\uacc4\u00b7\uc8fc\uac70 \uae09\uc5ec \ub4f1 \ucd5c\uc800 \uc0dd\ud65c \ubcf4\uc7a5\uc740 \uacf5\uacf5 \ubd80\uc870\uc5d0 \uc18d\ud569\ub2c8\ub2e4."
        },
        {
          "text": "(\uac00) \uc0ac\ud68c \ubcf4\ud5d8 - (\ub098) \uc0ac\ud68c \uc11c\ube44\uc2a4",
          "isCorrect": false,
          "rationale": "(\ub098)\ub294 \uae08\uc804\uc801 \uae09\uc5ec\ub97c \ud1b5\ud574 \ucd5c\uc800 \uc0dd\ud65c\uc744 \ubcf4\uc7a5\ud558\ub294 \uacf5\uacf5 \ubd80\uc870 \uc0ac\ub840\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uace0\uc6a9 \ubcf4\ud5d8\uacfc \uad6d\ubbfc \uae30\ucd08 \uc0dd\ud65c \ubcf4\uc7a5 \uc81c\ub3c4\uac00 \uac01\uac01 \uc5b4\ub5a4 \ubcf5\uc9c0 \uc81c\ub3c4\uc5d0 \uc18d\ud558\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uae00\uc5d0\uc11c \uc124\uba85\ud558\ub294 \uc9c0\uc5ed \uaca9\ucc28 \uc644\ud654 \uc804\ub7b5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n\"\ud2b9\uc815 \uc9c0\uc5ed \uacf5\uac04\uc744 \uc0c1\ud488\ud654\ud558\uc5ec \uc9c0\uc5ed\uc758 \uc774\ubbf8\uc9c0\ub97c \ub192\uc774\uace0 \uc9c0\uc5ed \uacbd\uc81c\ub97c \ud65c\uc131\ud654\ud558\uae30 \uc704\ud55c \uc804\ub7b5\uc774\ub2e4. \uc774\ub97c \uc704\ud574 \uc9c0\uc5ed \uc774\ubbf8\uc9c0 \ud64d\ubcf4, \uc9c0\uc5ed\uc801 \ud2b9\uc131\uc744 \uc0b4\ub9b0 \ucd95\uc81c \uac1c\ucd5c, \uc608\uc220\u00b7\ubb38\ud654 \ud2b9\uad6c \uc9c0\uc815 \ub4f1\uc758 \ubc29\ubc95\uc744 \ud65c\uc6a9\ud55c\ub2e4. \uc6b0\ub9ac\ub098\ub77c\uc758 \ubcf4\uc131 \ub179\ucc28 \ubc2d, \ud568\ud3c9 \ub098\ube44 \ucd95\uc81c, \uac10\ucc9c \ubb38\ud654 \ub9c8\uc744 \ub4f1\uc774 \ub300\ud45c\uc801 \uc0ac\ub840\uc774\ub2e4.\"",
      "answerOptions": [
        {
          "text": "\uc7a5\uc18c \ub9c8\ucf00\ud305",
          "isCorrect": true,
          "rationale": "\uc7a5\uc18c \ub9c8\ucf00\ud305\uc740 \ud2b9\uc815 \uc9c0\uc5ed \uacf5\uac04\uc744 \uc0c1\ud488\ud654\ud558\uc5ec \uc774\ubbf8\uc9c0\ub97c \uc81c\uace0\ud558\uace0 \uacbd\uc81c\ub97c \ud65c\uc131\ud654\ud558\ub294 \uc804\ub7b5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud601\uc2e0\ub3c4\uc2dc \uc870\uc131 \uc815\ucc45",
          "isCorrect": false,
          "rationale": "\ud601\uc2e0 \ub3c4\uc2dc\ub294 \uc218\ub3c4\uad8c\uc758 \uacf5\uacf5\uae30\uad00\uc744 \uc9c0\ubc29\uc73c\ub85c \uc774\uc804\ud558\uc5ec \uc9c0\uc5ed \uade0\ud615 \ubc1c\uc804\uc744 \ucd94\uc9c4\ud558\ub294 \uc815\ucc45\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc801\uadf9\uc801 \ud3c9\ub4f1 \uc2e4\ud604 \uc870\uce58",
          "isCorrect": false,
          "rationale": "\uc801\uadf9\uc801 \ud3c9\ub4f1 \uc2e4\ud604 \uc870\uce58\ub294 \uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0\uac8c \ud61c\ud0dd\uc744 \ubd80\uc5ec\ud558\uc5ec \uc2e4\uc9c8\uc801 \ud3c9\ub4f1\uc744 \uc774\ub8e8\ub824\ub294 \uc81c\ub3c4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc131\uc7a5 \uac70\uc810 \uac1c\ubc1c \uc815\ucc45",
          "isCorrect": false,
          "rationale": "\uc131\uc7a5 \uac70\uc810 \uac1c\ubc1c\uc740 \ud2b9\uc815 \uc9c0\uc5ed\uc5d0 \uc790\uc6d0\uc744 \uc9d1\uc911 \ud22c\uc790\ud558\ub294 \ubc29\uc2dd\uc73c\ub85c, \uacf5\uac04 \ubd88\ud3c9\ub4f1\uc744 \ucd08\ub798\ud558\ub294 \uc6d0\uc778\uc774 \ub418\uae30\ub3c4 \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc9c0\uc5ed\uc758 \ud2b9\uc0b0\ud488\uc774\ub098 \ucd95\uc81c, \ubb38\ud654 \ub9c8\uc744 \ub4f1\uc744 \ud558\ub098\uc758 \uc0c1\ud488\ucc98\ub7fc \ube0c\ub79c\ub4dc\ud654\ud558\ub294 \uc804\ub7b5\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc2e4\uc9c8\uc801 \ud3c9\ub4f1\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c '\uc801\uadf9\uc801 \ud3c9\ub4f1 \uc2e4\ud604 \uc870\uce58(Affirmative Action)'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud61c\ud0dd\uc758 \uc815\ub3c4\uc640 \uc0c1\uad00\uc5c6\uc774 \uc2dc\ud589\ud560\uc218\ub85d \uc0ac\ud68c \uad6c\uc131\uc6d0 \uac04\uc758 \uac08\ub4f1\uc774 \uc644\uc804\ud788 \uc18c\uba78\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc801\uadf9\uc801 \ud3c9\ub4f1 \uc2e4\ud604 \uc870\uce58\ub294 \ud61c\ud0dd\uc758 \uc815\ub3c4\uac00 \uacfc\ub3c4\ud560 \uacbd\uc6b0 \ubc18\ub300\ud3b8\uc774 \ucc28\ubcc4\ubc1b\ub294 '\uc5ed\ucc28\ubcc4' \ubb38\uc81c\ub97c \uc77c\uc73c\ucf1c \uac08\ub4f1\uc744 \uc720\ubc1c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc801\uc73c\ub85c \ubd88\ub9ac\ud55c \uc704\uce58\uc5d0 \uc788\ub294 \uc57d\uc790\uc5d0\uac8c \uc77c\uc815\ud55c \ud61c\ud0dd\uc744 \uc81c\uacf5\ud558\ub294 \uc815\ucc45\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub204\uc801\ub41c \ucc28\ubcc4\uc744 \ud574\uc18c\ud558\uace0 \uc2e4\uc9c8\uc801 \ud3c9\ub4f1\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc57d\uc790\uc5d0\uac8c \ud61c\ud0dd\uc744 \ubd80\uc5ec\ud558\ub294 \uac83\uc774 \ud575\uc2ec \uac1c\ub150\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc7a5\uc560\uc778 \uc758\ubb34 \uace0\uc6a9\uc81c\ub098 \ube44\ub840\ub300\ud45c \uc758\uc6d0 \ud6c4\ubcf4 \ucd94\ucc9c \uc2dc \uc5ec\uc131 \uc758\ubb34 \ubc30\uc815\uc774 \ub300\ud45c\uc801 \uc0ac\ub840\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc7a5\uc560\uc778 \uace0\uc6a9 \uc758\ubb34 \ube44\uc728 \uc9c0\uc815\uacfc \uc5ec\uc131 \ube44\ub840\ub300\ud45c \ud560\ub2f9\uc81c\ub294 \ubaa8\ub450 \uc801\uadf9\uc801 \ud3c9\ub4f1 \uc2e4\ud604 \uc870\uce58\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud615\uc2dd\uc801 \uae30\ud68c\uc758 \ud3c9\ub4f1\uc744 \ub118\uc5b4 \uacb0\uacfc\uc758 \ud3c9\ub4f1 \ubc0f \uc2e4\uc9c8\uc801 \ud3c9\ub4f1\uc744 \ub2ec\uc131\ud558\uace0\uc790 \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e8\uc21c\ud788 \ub3d9\ub4f1\ud55c \uae30\ud68c\ub97c \uc8fc\ub294 \uac83\uc744 \ub118\uc5b4 \uc2e4\uc9c8\uc801 \uacb0\uacfc\uc758 \ubd88\ud3c9\ub4f1\uc744 \uc644\ud654\ud558\uae30 \uc704\ud55c \ubaa9\uc801\uc744 \uac00\uc9d1\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud61c\ud0dd\uc774 \uacfc\ub3c4\ud558\uac8c \uc81c\uacf5\ub420 \ub54c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \ubd80\uc791\uc6a9(\uc5ed\ucc28\ubcc4)\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ubd88\ud3c9\ub4f1 \uc644\ud654\ub97c \uc704\ud55c \uc138\uacc4 \uac01\uad6d\uc758 \ub2e4\uc591\ud55c \ub178\ub825\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\ub9cc\uc744 <\ubcf4\uae30>\uc5d0\uc11c \uc788\ub294 \ub300\ub85c \uace0\ub978 \uac83\uc740?\n\n<\ubcf4\uae30>\n\u3131. \ubca0\ub124\uc218\uc5d8\ub77c\uc758 '\uc5d8 \uc2dc\uc2a4\ud14c\ub9c8'\ub294 \ube48\ubbfc\uce35 \uccad\uc18c\ub144\uc5d0\uac8c \ubb34\uc0c1 \uc74c\uc545 \uad50\uc721\uc744 \uc81c\uacf5\ud558\uc5ec \ubc94\uc8c4 \uc720\ud639\uc744 \uc904\uc600\ub2e4.\n\u3134. \uc2a4\uc704\uc2a4 \uc0dd\uac08\ub80c\uc758 '\uc2dc\uac04 \ub3cc\ubd04 \uc2dc\uc2a4\ud15c'\uc740 \uc774\uc6c3\uc5d0\uac8c \ub3cc\ubd04\uc744 \uc81c\uacf5\ud558\uace0 \uc801\ub9bd\ud55c \uc2dc\uac04 \uad6c\ub9e4\uad8c\uc744 \ucd94\ud6c4 \uc790\uc2e0\uc774 \ub178\uc778\uc774 \ub418\uc5c8\uc744 \ub54c \uc0ac\uc6a9\ud558\ub294 \uc81c\ub3c4\uc774\ub2e4.\n\u3137. \ud0c0\uc774\uc644\uc758 '\ud5c8\uc6b0\ud1b5'\uc740 \uc1e0\ud1f4\ud558\ub358 \ud3d0\ud0c4\uad11 \ub9c8\uc744\uc744 \uace0\uc591\uc774 \ucf58\uc149\ud2b8\ub85c \uafb8\uba70 \uc9c0\uc5ed \uc7ac\uc0dd\uc5d0 \uc131\uacf5\ud558\uc600\ub2e4.\n\u3139. \uc11c\uc6b8\ud2b9\ubcc4\uc2dc\uc758 '\ucfe8\ub9c1\ud3ec\uadf8' \uc0ac\uc5c5\uc740 \uace0\uc18c\ub4dd \uc8fc\uac70\uc9c0\uc758 \ubbf8\uc138\uba3c\uc9c0\ub97c \ucc28\ub2e8\ud558\uae30 \uc704\ud55c \uace0\uae09 \ub300\uc911\uad50\ud1b5 \uc124\uce58 \uc0ac\uc5c5\uc774\ub2e4.",
      "answerOptions": [
        {
          "text": "\u3131, \u3134, \u3137",
          "isCorrect": true,
          "rationale": "\u3131, \u3134, \u3137\uc740 \ubaa8\ub450 \uac01 \uad6d\uc758 \ubd88\ud3c9\ub4f1 \uc644\ud654 \ubc0f \uc9c0\uc5ed \uc7ac\uc0dd \uc0ac\ub840\ub85c \ubcf8\ubb38 \ub0b4\uc6a9\uacfc \uc815\ud655\ud788 \uc77c\uce58\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\u3131, \u3137",
          "isCorrect": false,
          "rationale": "\uc2a4\uc704\uc2a4 \uc0dd\uac08\ub80c\uc758 \uc2dc\uac04 \ub3cc\ubd04 \uc2dc\uc2a4\ud15c(\u3134) \ub610\ud55c \ub178\uc778 \ubcf5\uc9c0\ub97c \uc704\ud55c \uc62c\ubc14\ub978 \uc0ac\ub840 \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\u3134, \u3139",
          "isCorrect": false,
          "rationale": "\uc11c\uc6b8\ud2b9\ubcc4\uc2dc\uc758 \ucfe8\ub9c1\ud3ec\uadf8(\u3139)\ub294 \uace0\uc18c\ub4dd \uc9c0\uc5ed\uc758 \ub300\uc911\uad50\ud1b5\uc774 \uc544\ub2c8\ub77c \ucabd\ubc29\ucd0c \ub4f1 \ud3ed\uc5fc \ucde8\uc57d \uacc4\uce35\uc758 \uc8fc\uac70 \ud658\uacbd \uac1c\uc120\uc744 \uc704\ud55c \uc778\uacf5 \uc548\uac1c \ub0c9\ubc29 \uc7a5\uce58\uc785\ub2c8\ub2e4."
