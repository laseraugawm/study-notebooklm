        {
          "text": "2023\ub144 \uc870\uc0ac\uc5d0\uc11c \uc6b0\ub9ac\ub098\ub77c\ub294 OECD \uc870\uc0ac \ub300\uc0c1 29\uac1c\uad6d \uc911 \ucd5c\ud558\uc704\uc778 29\uc704\ub97c \uae30\ub85d\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "2023\ub144 \uc601\uad6d \uc774\ucf54\ub178\ubbf8\uc2a4\ud2b8 \ubc1c\ud45c \uc790\ub8cc\uc5d0\uc11c \ud55c\uad6d\uc740 29\uac1c\uad6d \uc911 29\uc704\ub85c \ucd5c\ud558\uc704\uc600\uc2b5\ub2c8\ub2e4."
