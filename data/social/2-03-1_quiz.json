        {
          "text": "\ub0a8\ub140 \uace0\ub4f1 \uad50\uc721 \uaca9\ucc28, \uc18c\ub4dd \uaca9\ucc28, \uc5ec\uc131 \ub178\ub3d9 \ucc38\uc5ec\uc728, \uace0\uc704\uc9c1 \uc5ec\uc131 \ube44\uc728 \ub4f1\uc744 \uc885\ud569\ud558\uc5ec \uc0b0\ucd9c\ud55c\ub2e4.",
