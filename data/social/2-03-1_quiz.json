    {
      "type": "multiple_choice",
      "question": "\uacf5\uac04 \ubd88\ud3c9\ub4f1 \ud604\uc0c1\uc774 \uc9c0\uc18d\ub420 \ub54c \uc0ac\ud68c\uc801\uc73c\ub85c \ubc1c\uc0dd\ud558\ub294 \ubb38\uc81c\uc810\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc131\uc7a5 \uac70\uc810 \uac1c\ubc1c\uc758 \ud30c\uae09 \ud6a8\uacfc\ub85c \uc778\ud574 \ub099\ud6c4 \uc9c0\uc5ed\uc758 \uacbd\uc81c \ubc0f \ubb38\ud654\uc801 \uc790\ub9bd \uae30\ubc18\uc774 \uc790\ub3d9\uc801\uc73c\ub85c \uad6c\ucd95\ub41c\ub2e4.",
