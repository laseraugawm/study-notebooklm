    {
      "type": "multiple_choice",
      "question": "OECD \ud68c\uc6d0\uad6d\uc758 \uc77c\ud558\ub294 \uc5ec\uc131 \ud658\uacbd\uc744 \ud3c9\uac00\ud558\ub294 '\uc720\ub9ac \ucc9c\uc7a5 \uc9c0\uc218'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\uc218\uc758 \uc21c\uc704\uac00 \ub0ae\uc744\uc218\ub85d \uc9c1\uc7a5 \ub0b4 \uc5ec\uc131\uc5d0 \ub300\ud55c \ucc28\ubcc4\uc774 \uc801\uace0 \uc591\uc131\ud3c9\ub4f1\ud55c \uadfc\ubb34 \ud658\uacbd\uc784\uc744 \ub098\ud0c0\ub0b8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc720\ub9ac \ucc9c\uc7a5 \uc9c0\uc218\ub294 \uc21c\uc704\uac00 \ub0ae\uc744\uc218\ub85d \uc9c1\uc7a5 \ub0b4 \uc5ec\uc131 \ucc28\ubcc4\uc774 \uc2ec\ud568\uc744 \uc758\ubbf8\ud558\ubbc0\ub85c \uc633\uc9c0 \uc54a\uc740 \uc124\uba85\uc785\ub2c8\ub2e4."
