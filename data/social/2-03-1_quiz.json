{
  "title": "\uc0ac\ud68c\uacf5\uac04\ubd88\ud3c9\ub4f1 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc0ac\ud68c\uc801 \ud76c\uc18c\uac00\uce58\uc758 \ucc28\ub4f1 \ubd84\ubc30\ub85c \uc778\ud574 \ub098\ud0c0\ub098\ub294 \ubd88\ud3c9\ub4f1 \ud604\uc0c1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubd80, \uad8c\ub825, \uc9c0\uc704 \ub4f1 \ud55c\uc815\ub41c \uc0ac\ud68c\uc801 \ud76c\uc18c\uac00\uce58\ub97c \ub2e4\ud22c\ub294 \uacfc\uc815\uc5d0\uc11c \ucc28\ub4f1 \ubd84\ubc30\uac00 \ubc1c\uc0dd\ud558\uc5ec \ubd88\ud3c9\ub4f1\uc774 \ud615\uc131\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\ud68c\uc801\uc73c\ub85c \uac00\uce58 \uc788\ub294 \uc7ac\ud654\ub098 \uc9c0\uc704\ub294 \ud55c\uc815\ub418\uc5b4 \uc788\uc5b4 \uad6c\uc131\uc6d0 \uac04 \uacbd\uc7c1\uc744 \uac70\uccd0 \ucc28\ub4f1 \ubd84\ubc30\ub428\uc73c\ub85c\uc368 \ubd88\ud3c9\ub4f1\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "\ubd88\ud3c9\ub4f1 \ud604\uc0c1\uc740 \ud2b9\uc815 \uc2dc\uae30\ub098 \uc77c\ubd80 \ud2b9\uc218\ud55c \uc0ac\ud68c \uad6c\uc870\uc5d0\uc11c\ub9cc \ud55c\uc2dc\uc801\uc73c\ub85c \ub098\ud0c0\ub098\ub294 \uc608\uc678\uc801 \ud604\uc0c1\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd88\ud3c9\ub4f1 \ud604\uc0c1\uc740 \uc77c\ubd80 \ud2b9\uc218 \uc0ac\ud68c\uc5d0 \uad6d\ud55c\ub418\uc9c0 \uc54a\uace0 \uc5b4\ub290 \uc0ac\ud68c\uc5d0\uc11c\ub098 \ub098\ud0c0\ub098\ub294 \ubcf4\ud3b8\uc801\uc778 \ud604\uc0c1\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\ub098\uce5c \uc0ac\ud68c\uc801 \ubd88\ud3c9\ub4f1\uc740 \uad6c\uc131\uc6d0 \uac04 \uacbd\uc7c1\uc744 \ucd09\uc9c4\ud558\uc5ec \uc0ac\ud68c \uc815\uc758 \uc2e4\ud604\uc744 \ub3d5\ub294 \ud544\uc218 \uc694\uc778\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\ub098\uce5c \ubd88\ud3c9\ub4f1\uc740 \uad6c\uc131\uc6d0 \uac04 \uc704\ud654\uac10\uc744 \uc870\uc131\ud558\uace0 \uc0ac\ud68c \uc815\uc758 \uc2e4\ud604\uc744 \uc800\ud574\ud558\ub294 \uc694\uc778\uc73c\ub85c \uc791\uc6a9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc801 \ud76c\uc18c\uac00\uce58\uc758 \uc591\uc740 \ubb34\ud55c\ud558\ubbc0\ub85c \uac1c\uc778\uc758 \ub178\ub825\uc774 \uc788\ub2e4\uba74 \ubd88\ud3c9\ub4f1\uc740 \uc804\ud600 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd80, \uad8c\ub825, \ucf8c\uc801\ud55c \uacf5\uac04 \ub4f1 \uc0ac\ud68c\uc801 \ud76c\uc18c\uac00\uce58\ub294 \ud55c\uc815\ub418\uc5b4 \uc788\uae30 \ub54c\ubb38\uc5d0 \uacbd\uc7c1\uacfc \ucc28\ub4f1 \ubd84\ubc30\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0ac\ud68c\uc801 \ud76c\uc18c\uac00\uce58\uc758 \ud76c\uc18c\uc131\uacfc \ubd84\ubc30\uc758 \ud2b9\uc131\uc5d0 \ub300\ud574 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ubd80\ubaa8 \uc138\ub300\uc758 \ud559\ub825 \ubc0f \uc18c\ub4dd\uacfc \uc790\ub140 \uc138\ub300\uc758 \uc0ac\uad50\uc721\ube44\u00b7\uacc4\uce35 \ub300\ubb3c\ub9bc \uac04\uc758 \uad00\uacc4\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubd80\ubaa8 \uc138\ub300\uc758 \ucd5c\uc885 \ud559\ub825\uc774 \ub192\uc744\uc218\ub85d \uac00\uad6c \uc18c\ub4dd\uc774 \ud558\uc704 \ubd84\uc704\uc5d0 \uc9d1\uc911\ub418\ub294 \uacbd\ud5a5\uc744 \ubcf4\uc778\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud1b5\uacc4 \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \ub300\uc878 \uc774\uc0c1 \ud559\ub825\uc758 \uac00\uad6c\uc8fc\ub294 \uc18c\ub4dd 5\ubd84\uc704(\uc0c1\uc704 20%)\uc5d0 \uac00\uc7a5 \ub9ce\uc774 \ubd84\ud3ec\ud558\uc5ec \ud559\ub825\uc774 \ub192\uc744\uc218\ub85d \uc18c\ub4dd \ubd84\uc704\uac00 \ub192\uc544\uc9c0\ub294 \uacbd\ud5a5\uc744 \ubcf4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubd80\ubaa8 \uc138\ub300\uc758 \uac00\uad6c \uc18c\ub4dd \ubd84\uc704\uac00 \ub192\uc544\uc9c8\uc218\ub85d \uc790\ub140\uc5d0\uac8c \uc9c0\ucd9c\ud558\ub294 \uc6d4\ud3c9\uade0 \uc0ac\uad50\uc721\ube44\uac00 \uc99d\uac00\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\ub4dd 1\ubd84\uc704\uc758 \uc6d4 \uc0ac\uad50\uc721\ube44\ub294 108,000\uc6d0\uc778 \ubc18\uba74 5\ubd84\uc704\ub294 872,000\uc6d0\uc73c\ub85c \uc18c\ub4dd\uc774 \ub192\uc744\uc218\ub85d \uc0ac\uad50\uc721\ube44 \uc9c0\ucd9c\uc774 \ud07d\ub2c8\ub2e4."
        },
        {
          "text": "\ubd80\ubaa8\uc758 \uacbd\uc81c\uc801 \uaca9\ucc28\ub85c \uc778\ud55c \uc790\ub140\uc758 \uad50\uc721 \uae30\ud68c \ucc28\uc774\ub294 \uacc4\uce35\uc758 \ub300\ubb3c\ub9bc \ud604\uc0c1\uc744 \ucd08\ub798\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\ub4dd \uaca9\ucc28\uac00 \uad50\uc721 \uaca9\ucc28\ub97c \ucd08\ub798\ud558\uace0, \ub2e4\uc2dc \uad50\uc721 \uaca9\ucc28\uac00 \uc790\ub140\uc758 \uc18c\ub4dd \uaca9\ucc28\ub85c \uc774\uc5b4\uc9c0\ub294 \uc21c\ud658 \uad6c\uc870\uac00 \ud615\uc131\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ube44\uc815\uaddc\uc9c1 \uadfc\ub85c\uc790\uc758 \uc99d\uac00\ub85c \uc778\ud55c \uc784\uae08 \uaca9\ucc28 \ubc1c\uc0dd\uc740 \uc0ac\ud68c \uacc4\uce35\uc758 \uc591\uadf9\ud654\ub97c \uac00\uc838\uc624\ub294 \uc8fc\ub41c \uc694\uc778 \uc911 \ud558\ub098\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uace0\uc6a9 \ud615\ud0dc\uc5d0 \ub530\ub978 \uc784\uae08 \uaca9\ucc28\ub294 \uc18c\ub4dd \uc591\uadf9\ud654\ub97c \uc720\ubc1c\ud558\uace0 \uc591\uadf9\ub2e8\uc73c\ub85c\uc758 \uacc4\uce35 \uc774\ub3d9\uc744 \ucd09\uc9c4\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubd80\ubaa8\uc758 \ud559\ub825\uacfc \uc18c\ub4dd \ubd84\uc704 \ubd84\ud3ec \uac04\uc758 \ube44\ub840 \uad00\uacc4\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc6b0\ub9ac\ub098\ub77c\uc5d0\uc11c \uc218\ub3c4\uad8c\uacfc \ube44\uc218\ub3c4\uad8c \uac04 \uacf5\uac04 \ubd88\ud3c9\ub4f1\uc744 \uc2ec\ud654\uc2dc\ud0a8 \uc8fc\ub41c \uc694\uc778\uc778 '\uc131\uc7a5 \uac70\uc810 \uac1c\ubc1c'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc815\ubd80 \uc8fc\ub3c4\ub85c \uc131\uc7a5 \uc7a0\uc7ac\ub825\uc774 \ub192\uc740 \uc9c0\uc5ed\uc744 \uc9d1\uc911 \uac1c\ubc1c\ud558\uc5ec \uadf8 \ud6a8\uacfc\uac00 \uc8fc\ubcc0\uc73c\ub85c \ud655\uc0b0\ub418\ub3c4\ub85d \uc720\ub3c4\ud558\ub294 \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc131\uc7a5 \uac70\uc810 \uac1c\ubc1c\uc740 \ud55c\uc815\ub41c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \ube60\ub978 \uacbd\uc81c \uc131\uc7a5\uc744 \uc774\ub8e8\uae30 \uc704\ud574 \ud2b9\uc815 \uc9c0\uc5ed\uc744 \uc9d1\uc911 \uac1c\ubc1c\ud558\ub294 \ubc29\uc2dd\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc804\uad6d \uac01 \uc9c0\uc5ed\uc5d0 \uad6d\uc720 \uc790\uae08\uc744 \uade0\ub4f1\ud558\uac8c \ubc30\ubd84\ud558\uc5ec \uad6d\ud1a0\uc758 \uade0\ud615 \uc788\ub294 \ub3d9\uc2dc \ubc1c\uc804\uc744 \ub3c4\ubaa8\ud558\ub294 \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc6d0\uc744 \uc804 \uad6d\ud1a0\uc5d0 \uade0\ub4f1\ud558\uac8c \ubc30\ubd84\ud558\ub294 \ubc29\uc2dd\uc740 \uade0\ud615 \uac1c\ubc1c \ubc29\uc2dd\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ube44\uc218\ub3c4\uad8c\uc758 \ub099\ud6c4\ub41c \ub18d\ucd0c \uc9c0\uc5ed\uc744 \uc6b0\uc120 \uac1c\ubc1c\ud568\uc73c\ub85c\uc368 \uc218\ub3c4\uad8c\uc73c\ub85c\uc758 \uc778\uad6c \ubc0f \uc790\ubcf8 \uc720\uc785\uc744 \ub9c9\uace0\uc790 \ud55c \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc131\uc7a5 \uac70\uc810 \uac1c\ubc1c\uc740 \uac70\uc810 \uc9c0\uc5ed(\uc218\ub3c4\uad8c \ub4f1)\uc5d0 \uc778\uad6c\uc640 \uc790\ubcf8\uc774 \uc9d1\uc911\ub418\ub294 \uacb0\uacfc\ub97c \ucd08\ub798\ud558\uc5ec \ube44\uc218\ub3c4\uad8c\uc758 \uc815\uccb4\ub97c \uac00\uc838\uc654\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubbfc\uac04 \uae30\uc5c5\uc774 \uc790\uc728\uc801\uc73c\ub85c \ud22c\uc790 \ub300\uc0c1 \uc9c0\uc5ed\uc744 \uacb0\uc815\ud558\uc5ec \uc218\ub3c4\uad8c \uc774\uc678 \uc9c0\ubc29 \ub3c4\uc2dc\uc758 \uc131\uc7a5\uc744 \uc774\ub048 \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc131\uc7a5 \uac70\uc810 \uac1c\ubc1c\uc740 \ubbfc\uac04 \uc8fc\ub3c4\uac00 \uc544\ub2cc \uc815\ubd80 \uc8fc\ub3c4\ub85c \ucd94\uc9c4\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ube60\ub978 \uacbd\uc81c \uc131\uc7a5\uc744 \ubaa9\ud45c\ub85c \ud2b9\uc815 \uc9c0\uc5ed\uc5d0 \uc790\uc6d0\uc744 \uc9d1\uc911\uc2dc\ucf30\ub358 \uac1c\ubc1c \uc804\ub7b5\uc758 \ud2b9\uc131\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc218\ub3c4\uad8c\uacfc \ube44\uc218\ub3c4\uad8c\uc758 \uc8fc\uc694 \uc9c0\ud45c \ube44\uad50 \uc790\ub8cc\ub97c \ubc14\ud0d5\uc73c\ub85c \ub3c4\ucd9c\ud560 \uc218 \uc788\ub294 \uc62c\ubc14\ub978 \ubd84\uc11d\uc740?",
      "answerOptions": [
        {
          "text": "\ube44\uc218\ub3c4\uad8c\uc740 \ub300\ud559\uad50 \uc218\uc758 \ube44\uc911\uc774 \uc218\ub3c4\uad8c\ubcf4\ub2e4 \ub192\uc9c0\ub9cc, 1,000\ub300 \uae30\uc5c5 \uc218 \ubc0f \uccad\ub144 \uc778\uad6c \ube44\uc911\uc740 \uc218\ub3c4\uad8c\uc5d0 \ube44\ud574 \ud06c\uac8c \ub0ae\ub2e4.",
          "isCorrect": true,
          "rationale": "\ube44\uc218\ub3c4\uad8c\uc758 \ub300\ud559\uad50 \ube44\uc911\uc740 62.7%\ub85c \uc218\ub3c4\uad8c(37.3%)\ubcf4\ub2e4 \ub192\uc73c\ub098, 1,000\ub300 \uae30\uc5c5 \ube44\uc911(25.8%)\uacfc \uccad\ub144 \uc778\uad6c \ube44\uc911(44.3%)\uc740 \uc218\ub3c4\uad8c\ubcf4\ub2e4 \ud604\uc800\ud788 \ub0ae\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc218\ub3c4\uad8c\uc740 \uc804 \uad6d\ud1a0 \uba74\uc801\uc758 \uc808\ubc18 \uc774\uc0c1\uc744 \ucc28\uc9c0\ud558\uace0 \uc788\uc5b4 \uc778\uad6c\uc640 \uacbd\uc81c \uc2dc\uc124\uc774 \ubc00\uc9d1\ud558\uae30\uc5d0 \uc6a9\uc774\ud55c \uc5ec\uac74\uc744 \uac16\ucd94\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\ub3c4\uad8c\uc758 \uba74\uc801\uc740 \uc804 \uad6d\ud1a0\uc758 12.1%\uc5d0 \ubd88\uacfc\ud568\uc5d0\ub3c4 \uc778\uad6c\uc640 \uc8fc\uc694 \uc2dc\uc124\uc774 \uacfc\ub3c4\ud558\uac8c \ubc00\uc9d1\ud574 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ube44\uc218\ub3c4\uad8c\uc758 \uc758\ub8cc \uae30\uad00 \ube44\uc911\uc740 \uacfc\ubc18\uc744 \ucc28\uc9c0\ud558\ubbc0\ub85c \uc218\ub3c4\uad8c\uc5d0 \ube44\ud574 \uc758\ub8cc \uc11c\ube44\uc2a4 \uc811\uadfc\uc131\uc774 \uc6d4\ub4f1\ud788 \uc6b0\uc218\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube44\uc218\ub3c4\uad8c\uc758 \uc758\ub8cc \uae30\uad00 \ube44\uc911\uc740 49.1%\ub85c \uad6d\ud1a0 \uba74\uc801(87.9%) \ub300\ube44 \uc758\ub8cc \uae30\uad00 \uc218\uac00 \ubd80\uc871\ud55c \ud3b8\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uccad\ub144 \uc778\uad6c(20~39\uc138) \ube44\uc911\uc740 \ube44\uc218\ub3c4\uad8c\uc774 \uacfc\ubc18\uc744 \ucc28\uc9c0\ud558\uc5ec \ube44\uc218\ub3c4\uad8c\uc758 \uc778\uad6c \uad6c\uc870\uac00 \uc218\ub3c4\uad8c\ubcf4\ub2e4 \uc80a\ub2e4.",
          "isCorrect": false,
          "rationale": "\uccad\ub144 \uc778\uad6c \ube44\uc911\uc740 \uc218\ub3c4\uad8c\uc774 55.7%, \ube44\uc218\ub3c4\uad8c\uc774 44.3%\ub85c \uc218\ub3c4\uad8c \uc9d1\uc911 \ud604\uc0c1\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac01 \uc9c0\uc5ed\uc758 \uba74\uc801 \ube44\uc728 \ub300\ube44 \uc778\uad6c, \uae30\uc5c5, \ub300\ud559 \ub4f1 \uc8fc\uc694 \uc778\ud504\ub77c\uc758 \ube44\uc911\uc744 \ub300\uc870\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc9c0\uc790\uccb4\uc758 \uc778\uad6c \uac10\uc18c \ubc0f \uc18c\uba78 \uc704\ud5d8 \uc815\ub3c4\ub97c \ub098\ud0c0\ub0b4\ub294 '\uc778\uad6c \uc18c\uba78 \uc704\ud5d8 \uc9c0\uc218'\ub97c \uc0b0\ucd9c\ud558\ub294 \uae30\uc900\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "20~39\uc138 \uc5ec\uc131 \uc778\uad6c\ub97c 65\uc138 \uc774\uc0c1 \uace0\ub839 \uc778\uad6c\ub85c \ub098\ub208 \uac12",
          "isCorrect": true,
          "rationale": "\uc778\uad6c \uc18c\uba78 \uc704\ud5d8 \uc9c0\uc218\ub294 \uac00\uc784 \uac00\ub2a5\uc131\uc774 \ub192\uc740 20~39\uc138 \uc5ec\uc131 \uc778\uad6c\uc218\ub97c 65\uc138 \uc774\uc0c1 \uace0\ub839 \uc778\uad6c\uc218\ub85c \ub098\ub204\uc5b4 \uacc4\uc0b0\ud558\uba70, 0.5 \ubbf8\ub9cc\uc77c \ub54c \uc18c\uba78 \uc704\ud5d8 \uc9c0\uc5ed\uc73c\ub85c \ubd84\ub958\ud569\ub2c8\ub2e4."
        },
        {
          "text": "65\uc138 \uc774\uc0c1 \uace0\ub839 \uc778\uad6c\ub97c 20~39\uc138 \uc5ec\uc131 \uc778\uad6c\ub85c \ub098\ub208 \uac12",
          "isCorrect": false,
          "rationale": "\ubd84\ubaa8\uc640 \ubd84\uc790\uac00 \ubc14\ub010 \uacf5\uc2dd\uc774\uba70, \uace0\ub839 \uc778\uad6c \ub300\ube44 \uccad\ub144 \uc5ec\uc131 \uc778\uad6c \ube44\uc728\uc744 \uce21\uc815\ud558\ub294 \uac83\uc774 \uc815\ub2f5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc5f0\uac04 \ucd1d \ucd9c\uc0dd\uc544 \uc218\ub97c \uc5f0\uac04 \ucd1d \uc0ac\ub9dd\uc790 \uc218\ub85c \ub098\ub208 \uac12",
          "isCorrect": false,
          "rationale": "\ucd9c\uc0dd\uc544 \uc218 \ub300\ube44 \uc0ac\ub9dd\uc790 \uc218\ub294 \uc790\uc5f0 \uc99d\uac10 \ube44\uc728\uc774\uba70 \uc778\uad6c \uc18c\uba78 \uc704\ud5d8 \uc9c0\uc218\uc758 \uc9c1\uc811\uc801 \uc0b0\ucd9c\uc2dd\uc740 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "20~39\uc138 \uccad\ub144 \uc778\uad6c \uc804\uccb4\ub97c \ud574\ub2f9 \uc9c0\uc5ed\uc758 \uc804\uccb4 \ucd1d\uc778\uad6c\ub85c \ub098\ub208 \uac12",
          "isCorrect": false,
          "rationale": "\uccad\ub144 \uc778\uad6c \ube44\uc728\uc774 \uc544\ub2cc, \uace0\ub839 \uc778\uad6c \ub300\ube44 20~39\uc138 \uc5ec\uc131 \uc778\uad6c\uc758 \ube44\ub97c \uce21\uc815\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc9c0\uc218\uac00 \ub0ae\uc744\uc218\ub85d \uc704\ud5d8\uc774 \ucee4\uc9c0\uba70, \ubd84\uc790\uc5d0\ub294 \ud2b9\uc815 \uc5f0\ub839\ub300\uc758 \uc5ec\uc131 \uc778\uad6c\uac00 \ub4e4\uc5b4\uac11\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "'\uc0ac\ud68c\uc801 \uc57d\uc790'\uc640 '\uc0ac\ud68c\uc801 \uc18c\uc218\uc790'\uc758 \uad00\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub294 \uc2a4\uc2a4\ub85c \uc18c\uc218\uc790 \uc9d1\ub2e8\uc774\ub77c\ub294 \uc758\uc2dd\uc744 \uac00\uc838\uc57c \ud558\ubbc0\ub85c, '\uc5b4\ub9b0\uc774'\ub294 \uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0\ub294 \ud574\ub2f9\ud558\uc9c0\ub9cc \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc5d0\ub294 \uc18d\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub294 \ubd88\ud3c9\ub4f1\ud55c \ub300\uc6b0 \uc678\uc5d0\ub3c4 \uc18c\uc218\uc790 \uc9d1\ub2e8\uc73c\ub85c\uc11c\uc758 \uc8fc\uad00\uc801 \uc758\uc2dd\uc774 \ud544\uc694\ud558\ubbc0\ub85c, \uc774 \uc758\uc2dd\uc774 \ubd80\uc871\ud55c \uc5b4\ub9b0\uc774\ub294 \uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0\ub9cc \ud574\ub2f9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0 \ud574\ub2f9\ud558\ub294 \uc0ac\ub78c\uc740 \uc8fc\uad00\uc801 \uc758\uc2dd \ubcf4\uc720 \uc5ec\ubd80\uc640 \uad00\uacc4\uc5c6\uc774 \ubaa8\ub450 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc5d0 \uc790\ub3d9 \ud3ec\ud568\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub294 \uc790\uc758\uc2dd(\uc9d1\ub2e8 \uad6c\uc131\uc6d0 \uc758\uc2dd)\uc744 \uc694\uac74\uc73c\ub85c \ud558\ubbc0\ub85c \ubaa8\ub4e0 \uc0ac\ud68c\uc801 \uc57d\uc790\uac00 \uc18c\uc218\uc790\uc778 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc801 \uc57d\uc790\ub294 \uc9d1\ub2e8\uc758 \uc218\uc801(\u6578\u7684) \uc778\uc6d0\uc774 \uc804\uccb4 \uc0ac\ud68c\uc5d0\uc11c \ubc18\ub4dc\uc2dc \uc808\ub300\uc801 \uc18c\uc218\uc774\uc5b4\uc57c\ub9cc \uc131\ub9bd\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc801\uc73c\ub85c \ub2e4\uc218\uc774\ub354\ub77c\ub3c4 \uc0ac\ud68c\uc801\uc73c\ub85c \ubd88\ub9ac\ud55c \uc704\uce58\ub098 \ucc28\ubcc4\uc744 \ubc1b\ub294\ub2e4\uba74(\uc608: \ud2b9\uc815 \uc0ac\ud68c\uc758 \uc5ec\uc131 \ub4f1) \uc0ac\ud68c\uc801 \uc57d\uc790\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc758 \ubc94\uc8fc\ub294 \uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \ubc94\uc8fc\ubcf4\ub2e4 \ub354 \ub113\uc5b4 \uc0ac\ud68c\uc801 \uc57d\uc790 \uc804\uccb4\ub97c \ud3ec\uad04\ud55c\ub2e4.",
