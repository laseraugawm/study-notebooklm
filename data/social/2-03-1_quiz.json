        {
          "text": "\ubc1c\uc804\ub41c \uc9c0\uc5ed \uc8fc\ubbfc\uacfc \ub099\ud6c4 \uc9c0\uc5ed \uc8fc\ubbfc \uac04\uc758 \uc0c1\ub300\uc801 \ubc15\ud0c8\uac10\uacfc \uac08\ub4f1\uc774 \uc720\ubc1c\ub418\uc5b4 \uc0ac\ud68c \ud1b5\ud569\uc744 \uc800\ud574\ud55c\ub2e4.",
