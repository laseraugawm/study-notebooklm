    {
      "type": "multiple_choice",
      "question": "\uc0ac\ud68c \uacc4\uce35\uc758 \uc591\uadf9\ud654 \ud604\uc0c1\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \ub0b4\uc6a9\ub9cc\uc744 <\ubcf4\uae30>\uc5d0\uc11c \uace0\ub978 \uac83\uc740?\n\n<\ubcf4\uae30>\n\u3131. \uc911\uce35\uc758 \ube44\uc911\uc774 \uc904\uc5b4\ub4e4\uace0 \uc0ac\ud68c \uacc4\uce35\uc758 \uc591\uadf9\ub2e8\uc778 \uc0c1\uce35\uacfc \ud558\uce35\uc73c\ub85c \uc0ac\ub78c\ub4e4\uc774 \ubab0\ub9ac\ub294 \ud604\uc0c1\uc774\ub2e4.\n\u3134. \ubd80\ubaa8\uc758 \uacbd\uc81c\uc801 \uaca9\ucc28\uac00 \uad50\uc721 \uae30\ud68c\uc758 \uaca9\ucc28\ub85c \uc774\uc5b4\uc9c0\ub294 \ubd80\uc758 \ub300\ubb3c\ub9bc\uc774 \uc8fc\uc694 \uc6d0\uc778 \uc911 \ud558\ub098\uc774\ub2e4.\n\u3137. \uacc4\uce35 \uc591\uadf9\ud654\uac00 \uc2ec\ud654\ub418\uba74 \uacc4\uce35 \uac04 \uc704\ud654\uac10\uc774 \uc870\uc131\ub418\uc5b4 \uc0ac\ud68c \ubc1c\uc804\uc758 \ub3d9\ub825\uc774 \uc57d\ud654\ub420 \uc218 \uc788\ub2e4.\n\u3139. \uc591\uadf9\ud654\uac00 \uc9c4\ud589\ub420\uc218\ub85d \uc911\ub4f1 \ud559\ub825\uc790\uc758 \ube44\uc728\uc774 \uae09\uc99d\ud558\uc5ec \uc911\uc0b0\uce35 \uc911\uc2ec\uc758 \uc0ac\ud68c \uad6c\uc870\uac00 \ud655\ub9bd\ub41c\ub2e4.",
      "answerOptions": [
        {
          "text": "\u3131, \u3134, \u3137",
          "isCorrect": true,
