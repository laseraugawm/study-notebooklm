        {
          "text": "\uc815\ubd80 \uc2e4\ud328",
          "isCorrect": false,
          "rationale": "\uc815\ubd80\uc758 \uc2dc\uc7a5 \uac1c\uc785\uc774 \ud6a8\uc728\uc801 \uc790\uc6d0 \ubc30\ubd84\uc744 \uc800\ud574\ud558\ub294 \uc815\ubd80 \uc2e4\ud328 \ud604\uc0c1\uacfc\ub294 \ubb34\uad00\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ucc3d\uc870\uc801 \ud30c\uad34",
          "isCorrect": false,
          "rationale": "\uae30\uc5c5\uac00\uc758 \uae30\uc220 \ud601\uc2e0 \uc911\uc2ec\uc778 \ucc3d\uc870\uc801 \ud30c\uad34\ubcf4\ub2e4\ub294 \uc18c\ube44\uc790\uc758 \uad6c\ub9e4\ub825\uc774 \uc0dd\uc0b0\uc744 \uacb0\uc815\ud558\ub294 \ud604\uc0c1\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc5d0\uc11c \ubb34\uc5c7\uc744 \uc5b4\ub5bb\uac8c \uc0dd\uc0b0\ud560\uc9c0 \uacb0\uc815\ud558\ub294 \ucd5c\uc885 \uad8c\ud55c\uc774 \uc18c\ube44\uc790\uc5d0\uac8c \uc788\uc74c\uc744 \ub098\ud0c0\ub0b4\ub294 \uc6a9\uc5b4\uc785\ub2c8\ub2e4."
