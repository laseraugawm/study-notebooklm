{
  "title": "\uc9c0\uc18d\uac00\ub2a5\uacbd\uc81c \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \uc704\ud55c \uc815\ubd80\uc758 \uc5ed\ud560\uacfc \uc815\ucc45\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2dc\uc7a5 \uae30\ub2a5\uc774 \uc6d0\ud65c\ud558\uac8c \uc791\ub3d9\ud558\uc9c0 \ubabb\ud560 \ub54c \uc801\uadf9\uc801\uc73c\ub85c \uc2dc\uc7a5\uc5d0 \ucc38\uc5ec\ud558\uc5ec \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30\ub3c4 \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\uc7a5 \uc2e4\ud328\uac00 \ubc1c\uc0dd\ud560 \uacbd\uc6b0 \uc815\ubd80\ub294 \uc2dc\uc7a5\uc5d0 \uc801\uadf9\uc801\uc73c\ub85c \uac1c\uc785\ud558\uc5ec \ud6a8\uc728\uc801 \uc790\uc6d0 \ubc30\ubd84\uc744 \ub3c4\ubaa8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\uacf5\uc7ac\ub97c \uc9c1\uc811 \uc0dd\uc0b0\ud558\uace0 \uad00\ub9ac\ud568\uc73c\ub85c\uc368 \uc790\uc6d0\uc758 \ud6a8\uc728\uc801 \ubc30\ubd84\uc5d0 \uc774\ubc14\uc9c0\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\uc7a5\uacbd\uc81c\uc5d0\uc11c \ubb34\uc784\uc2b9\ucc28 \ubb38\uc81c \ub4f1\uc73c\ub85c \uc81c\ub300\ub85c \uacf5\uae09\ub418\uae30 \uc5b4\ub824\uc6b4 \uacf5\uacf5\uc7ac\ub294 \uc815\ubd80\uac00 \uc9c1\uc811 \uc0dd\uc0b0\u00b7\uad00\ub9ac\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc801\uac8c \ub098\ud0c0\ub098\ub294 \uacbd\uc81c\ud65c\ub3d9\uc5d0\ub294 \uc138\uae08\uc744 \ubd80\uacfc\ud558\uc5ec \uc0dd\uc0b0\uc744 \uc5b5\uc81c\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc801\uac8c \ub098\ud0c0\ub098\ub294 \uacbd\uc81c\ud65c\ub3d9\uc5d0\ub294 \uc138\uae08\uc774 \uc544\ub2c8\ub77c \ubcf4\uc870\uae08\uc744 \uc9c0\uae09\ud558\uc5ec \ud574\ub2f9 \ud65c\ub3d9\uc744 \uc7a5\ub824\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\u300c\ub3c5\uc810 \uaddc\uc81c \ubc0f \uacf5\uc815 \uac70\ub798\uc5d0 \uad00\ud55c \ubc95\ub960\u300d\uc744 \uc81c\uc815\ud558\uc5ec \ubd88\uacf5\uc815 \uac70\ub798 \ud589\uc704\ub97c \uaddc\uc81c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ubd80\ub294 \ubc95\ub960 \uc81c\uc815\uacfc \uae30\uad00 \uc124\uce58\ub97c \ud1b5\ud574 \uc2dc\uc7a5 \ub0b4 \ub2f4\ud569\uacfc \uac19\uc740 \ubd88\uacf5\uc815 \uac70\ub798\ub97c \uc81c\uc7ac\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc801\uc815 \uc218\uc900\ubcf4\ub2e4 \ubd80\uc871\ud558\uac8c \uc774\ub8e8\uc5b4\uc9c0\ub294 \uacbd\uc81c \ud65c\ub3d9\uc744 \uc7a5\ub824\ud558\uae30 \uc704\ud574 \uc815\ubd80\uac00 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc81c\uc801 \uc720\uc778 \uc218\ub2e8\uc5d0 \uc720\uc758\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uacf5\uc815 \uac70\ub798 \uc704\uc6d0\ud68c\uac00 \uad6d\ub0b4 \ube59\uacfc\ub958 \uc81c\uc870\u00b7\ud310\ub9e4 \uc5c5\uccb4\ub4e4\uc758 \uac00\uaca9 \ub2f4\ud569 \ud589\uc704\ub97c \uc801\ubc1c\ud558\uace0 \ub300\uaddc\ubaa8 \uacfc\uc9d5\uae08\uc744 \ubd80\uacfc\ud55c \uc8fc\uc694 \uc774\uc720\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ube59\uacfc\ub958\uc758 \uacfc\ub3c4\ud55c \uc0dd\uc0b0\uc73c\ub85c \uc778\ud55c \ud658\uacbd \uc624\uc5fc \ubb38\uc81c\ub97c \uc81c\uc7ac\ud558\uae30 \uc704\ud558\uc5ec",
          "isCorrect": false,
          "rationale": "\ub2f4\ud569 \ud589\uc704 \uc81c\uc7ac\ub294 \ud658\uacbd \uc624\uc5fc \uc5b5\uc81c\uac00 \uc544\ub2cc \ubd88\uacf5\uc815 \uac70\ub798 \ud589\uc704 \uad50\uc815\uc744 \ubaa9\uc801\uc73c\ub85c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub2f4\ud569\uc774\ub77c\ub294 \ubd88\uacf5\uc815 \uac70\ub798 \ud589\uc704\ub97c \uc81c\uc7ac\ud558\uc5ec \uacf5\uc815\ud55c \uacbd\uc7c1 \ud658\uacbd\uc744 \uc870\uc131\ud558\uae30 \uc704\ud558\uc5ec",
          "isCorrect": true,
          "rationale": "\uac00\uaca9 \ubc0f \uac70\ub798\ucc98 \ub2f4\ud569\uc740 \uc2dc\uc7a5\uc758 \uc790\uc720\ub86d\uace0 \uacf5\uc815\ud55c \uacbd\uc7c1\uc744 \uc800\ud574\ud558\ubbc0\ub85c \uacf5\uc815 \uac70\ub798 \uc704\uc6d0\ud68c\uac00 \uc774\ub97c \uaddc\uc81c\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\uae30\uc5c5\uc774 \uc774\uc724 \uadf9\ub300\ud654\ub97c \ucd94\uad6c\ud558\ub294 \ud589\uc704 \uc790\uccb4\ub97c \ubc95\uc801\uc73c\ub85c \uae08\uc9c0\ud558\uae30 \uc704\ud558\uc5ec",
          "isCorrect": false,
          "rationale": "\uc2dc\uc7a5\uacbd\uc81c\uc5d0\uc11c \uae30\uc5c5\uc758 \ud569\ub9ac\uc801\uc778 \uc774\uc724 \uadf9\ub300\ud654 \ucd94\uad6c \uc790\uccb4\ub294 \uc815\ub2f9\ud55c \uacbd\uc81c \ud65c\ub3d9\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ube59\uacfc\ub958 \uc218\uc785\ub7c9\uc744 \ub298\ub824 \uad6d\ub0b4 \uc5c5\uccb4\uc758 \uc2dc\uc7a5 \uc810\uc720\uc728\uc744 \uac15\uc81c\ub85c \ub0ae\ucd94\uae30 \uc704\ud558\uc5ec",
          "isCorrect": false,
          "rationale": "\uacf5\uc815 \uac70\ub798 \uc704\uc6d0\ud68c\uc758 \ubaa9\uc801\uc740 \ud2b9\uc815 \uc5c5\uccb4\uc758 \uc810\uc720\uc728 \uac15\uc81c \uc778\ud558\ub098 \uc218\uc785 \ud655\ub300\uac00 \uc544\ub2c8\ub77c \ubd88\uacf5\uc815 \ud589\uc704 \uc2dc\uc815\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uae30\uc5c5 \uac04 \uc0ac\uc801 \ud569\uc758\ub97c \ud1b5\ud574 \uac00\uaca9\uc744 \uc870\uc791\ud558\ub294 \ub2f4\ud569 \ud589\uc704\uac00 \uc2dc\uc7a5 \uacbd\uc7c1\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc5d0 \ub300\ud574 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uacbd\uc81c\ud559\uc790 \uc298\ud398\ud130(J. A. Schumpeter)\uac00 \uc8fc\uc7a5\ud55c '\uae30\uc5c5\uac00 \uc815\uc2e0'\uc758 \ud575\uc2ec \uac1c\ub150\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc704\ud5d8\uacfc \ubd88\ud655\uc2e4\uc131\uc744 \ud53c\ud558\uace0 \uae30\uc874 \uc2dc\uc7a5\uc5d0\uc11c\uc758 \uc9c0\ubc30\ub825 \uc720\uc9c0\ub97c \ucd5c\uc6b0\uc120\uc73c\ub85c \ud558\ub294 \ud0dc\ub3c4\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc298\ud398\ud130\uc758 \uae30\uc5c5\uac00 \uc815\uc2e0\uc740 \uc704\ud5d8\uc744 \ud68c\ud53c\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc704\ud5d8\uc744 \ubb34\ub985\uc4f0\uace0 \ub3c4\uc804\ud558\ub294 \uc815\uc2e0\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc704\ud5d8\uc744 \ubb34\ub985\uc4f0\uace0 \uc0c8\ub85c\uc6b4 \uc2dc\uc7a5\uc744 \uac1c\ucc99\ud558\ub294 \ucc3d\uc870\uc801 \ud30c\uad34, \uc989 \ud601\uc2e0\uc5d0 \uae30\ucd08\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc298\ud398\ud130\ub294 \uae30\uc5c5\uac00 \uc815\uc2e0\uc758 \ud575\uc2ec\uc744 '\ucc3d\uc870\uc801 \ud30c\uad34'\ub77c\ub294 \ud601\uc2e0\uc73c\ub85c \ubcf4\uc558\uc73c\uba70, \uc774\uac83\uc774 \uc2dc\uc7a5\uacbd\uc81c\ub97c \uc5ed\ub3d9\uc801\uc73c\ub85c \ub9cc\ub4dc\ub294 \uc6d0\ucc9c\uc774\ub77c\uace0 \uac15\uc870\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80\uc758 \uaddc\uc81c \uc5c6\uc774 \uae30\uc5c5\uc758 \ubaa8\ub4e0 \ubc95\uc801\u00b7\uc724\ub9ac\uc801 \ucc45\uc784\uc744 \uba74\uc81c\ubc1b\ub294 \uad8c\ub9ac\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\uc5c5\uac00 \uc815\uc2e0\uc740 \ubc95\uc801\u00b7\uc724\ub9ac\uc801 \ucc45\uc784 \uba74\uc81c\ub97c \uc758\ubbf8\ud558\ub294 \uac83\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\ube44\uc790\uc758 \uc695\uad6c\uc640 \ubb34\uad00\ud558\uac8c \uc0dd\uc0b0\ubb3c\uc758 \uc885\ub958\uc640 \uc218\ub7c9\uc744 \ub3c5\ub2e8\uc801\uc73c\ub85c \uacb0\uc815\ud558\ub294 \uad8c\ud55c\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\uc0b0\ubb3c\uc758 \uc885\ub958\uc640 \uc218\ub7c9\uc744 \ucd5c\uc885 \uacb0\uc815\ud558\ub294 \uad8c\ud55c\uc740 \uc18c\ube44\uc790 \uc8fc\uad8c\uc5d0 \ud574\ub2f9\ud558\uba70, \uae30\uc5c5\uac00 \uc815\uc2e0\uacfc\ub294 \ub2e4\ub985\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc298\ud398\ud130\uac00 '\ucc3d\uc870\ub294 \ud30c\uad34\uc758 \ub610 \ub2e4\ub978 \uc774\ub984'\uc774\ub77c\uba70 \uc704\ud5d8 \ubb34\ub985\uc4f0\uae30\uc640 \ud568\uaed8 \uac15\uc870\ud55c \ud575\uc2ec \ub2e8\uc5b4\ub97c \uc5f0\uc0c1\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uce90\ub864(A. Carroll)\uc758 '\uae30\uc5c5\uc758 \uc0ac\ud68c\uc801 \ucc45\uc784 \ud53c\ub77c\ubbf8\ub4dc'\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uae30\uc5c5\uc774 \uc9c0\ub294 \uac00\uc7a5 \uae30\ucd08\uc801\uc778 \ub2e8\uacc4\uc758 \ucc45\uc784\uc740 \uc774\uc724 \uadf9\ub300\ud654\ub97c \ucd94\uad6c\ud558\ub294 '\uacbd\uc81c\uc801 \ucc45\uc784'\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud53c\ub77c\ubbf8\ub4dc\uc758 \ucd5c\ud558\ub2e8 \uae30\ud2c0\uc744 \uc774\ub8e8\ub294 \uac83\uc740 \uc774\uc724\uc744 \ucc3d\ucd9c\ud558\ub294 \uacbd\uc81c\uc801 \ucc45\uc784\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\uc5c5\uc758 \uc0ac\ud68c\uc801 \uc601\ud5a5\ub825\uc774 \ucee4\uc9d0\uc5d0 \ub530\ub77c \uacbd\uc81c\uc801 \ucc45\uc784 \uc678\uc5d0\ub3c4 \ubc95\uc801, \uc724\ub9ac\uc801, \uc790\uc120\uc801 \ucc45\uc784\uc774 \uc694\uad6c\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc624\ub298\ub0a0 \uae30\uc5c5\uc740 \ub2e8\uc21c\ud55c \uacbd\uc81c\uc801 \uc774\uc724 \ucc3d\ucd9c\uc744 \ub118\uc5b4 \ub2e4\uc591\ud55c \ub2e8\uacc4\uc758 \uc0ac\ud68c\uc801 \ucc45\uc784\uc744 \uc694\uad6c\ubc1b\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc5ed \uc0ac\ud68c \uacf5\ud5cc\ud65c\ub3d9\uc774\ub098 \ub098\ub214 \ud589\uc0ac\ub294 '\uc790\uc120\uc801 \ucc45\uc784' \ub2e8\uacc4\uc5d0 \uc18d\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uc5ed \uc0ac\ud68c\uc5d0 \uae30\uc5ec\ud558\uace0 \uacf5\ud5cc\ud558\ub294 \ud65c\ub3d9\uc740 \ud53c\ub77c\ubbf8\ub4dc\uc758 \ucd5c\uc0c1\uc704 \ub2e8\uacc4\uc778 \uc790\uc120\uc801 \ucc45\uc784\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\uc5c5\uc758 \uc724\ub9ac\uc801 \uae30\uc900 \uc900\uc218\ub294 \uac00\uc7a5 \uae30\ucd08\uac00 \ub418\ub294 \ub2e8\uacc4\ub85c, \uc774\uc724 \uadf9\ub300\ud654\ubcf4\ub2e4 \uba3c\uc800 \ub2ec\uc131\ub418\uc5b4\uc57c \ud558\ub294 \ubc95\uc801 \uc758\ubb34\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uce90\ub864\uc758 \ud53c\ub77c\ubbf8\ub4dc\uc5d0\uc11c \uac00\uc7a5 \uae30\ucd08\uac00 \ub418\ub294 \ucc45\uc784\uc740 '\uacbd\uc81c\uc801 \ucc45\uc784'\uc774\uba70, \uc724\ub9ac\uc801 \ucc45\uc784\uc740 \uacbd\uc81c\uc801\u00b7\ubc95\uc801 \ucc45\uc784 \uc704\uc758 \ub2e8\uacc4\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud53c\ub77c\ubbf8\ub4dc\uc758 \ub9e8 \uc544\ub798 \uae30\ucd08\ub97c \uc774\ub8e8\ub294 \ub2e8\uacc4\uc640 \uadf8 \uc704\ub85c \uc313\uc5ec\uac00\ub294 \ucc45\uc784\uc758 \ub2e8\uacc4\ubcc4 \uc21c\uc11c\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ucd5c\uadfc \uae30\uc5c5\uc758 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uacfc \uad00\ub828\ud558\uc5ec \uc911\uc694\ud558\uac8c \ub5a0\uc624\ub974\uace0 \uc788\ub294 'ESG \uacbd\uc601' \ubc0f 'RE100'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "ESG \uacbd\uc601\uc740 \uae30\uc5c5\uc758 \ub2e8\uae30\uc801 \uc7ac\ubb34 \uc131\uacfc\ub9cc\uc744 \uadf9\ub300\ud654\ud558\ub824\ub294 \uacbd\uc601 \ubc29\uc2dd\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "ESG \uacbd\uc601\uc740 \ub2e8\uc21c \uc7ac\ubb34 \uc131\uacfc\uac00 \uc544\ub2cc \ube44\uc7ac\ubb34\uc801 \uc694\uc18c\ub97c \uc885\ud569\uc801\uc73c\ub85c \uace0\ub824\ud558\ub294 \uacbd\uc601 \ubc29\uc2dd\uc785\ub2c8\ub2e4."
        },
        {
          "text": "RE100\uc740 2050\ub144\uae4c\uc9c0 \uae30\uc5c5 \uc0ac\uc6a9 \uc804\ub825\ub7c9\uc758 100%\ub97c \uc6d0\uc790\ub825 \ubc1c\uc804\uc73c\ub85c \ub300\uccb4\ud558\uaca0\ub2e4\ub294 \uad6d\uc81c \ucea0\ud398\uc778\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "RE100\uc740 \uc6d0\uc790\ub825\uc774 \uc544\ub2c8\ub77c \ud48d\ub825, \ud0dc\uc591\uad11 \ub4f1 '\uc7ac\uc0dd \uc5d0\ub108\uc9c0'\ub85c \uc804\ub825\ub7c9\uc758 100%\ub97c \ucda9\ub2f9\ud558\uaca0\ub2e4\ub294 \ucea0\ud398\uc778\uc785\ub2c8\ub2e4."
        },
        {
          "text": "ESG \uacbd\uc601\uc758 \ube44\uc7ac\ubb34\uc801 \uc694\uc18c 3\uac00\uc9c0\ub294 \ud658\uacbd(Environment), \uc0ac\ud68c(Social), \uc9c0\ubc30 \uad6c\uc870(Governance)\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "ESG\ub294 \ud658\uacbd, \uc0ac\ud68c\uc801 \ucc45\uc784, \ud22c\uba85\ud55c \uc9c0\ubc30 \uad6c\uc870 \uac1c\uc120\uc744 \ud575\uc2ec \ube44\uc7ac\ubb34\uc801 \uc694\uc18c\ub85c \ub2e4\ub8f9\ub2c8\ub2e4."
        },
        {
          "text": "ESG \uacbd\uc601\uacfc RE100\uc740 \uac1c\ubcc4 \uae30\uc5c5\uc758 \uc120\ud0dd \uc0ac\ud56d\uc77c \ubfd0 \uad6d\uac00\uc758 \uacbd\uc7c1\ub825\uacfc\ub294 \ubb34\uad00\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc624\ub298\ub0a0 ESG \uacbd\uc601\uc740 \uac1c\ubcc4 \uae30\uc5c5 \ucc28\uc6d0\uc744 \ub118\uc5b4 \uad6d\uac00\uc758 \uc131\ud328\uc640 \uc9c1\uacb0\ub41c \uc911\uc694\ud55c \uac1c\ub150\uc73c\ub85c \ud3c9\uac00\ubc1b\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "ESG\uc758 \uc601\ubb38 \ucca0\uc790 \uc138 \uac1c\uac00 \uac01\uac01 \uc0c1\uc9d5\ud558\ub294 \ud658\uacbd\u00b7\uc0ac\ud68c\u00b7\ud22c\uba85 \uc9c0\ubc30 \uad6c\uc870\uc758 \ube44\uc7ac\ubb34\uc801 \uc758\ubbf8\ub97c \ud655\uc778\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud5cc\ubc95\uc5d0 \ubcf4\uc7a5\ub41c \ub178\ub3d9\uc790\uc758 \uad8c\ub9ac\uc640 \ucc45\ubb34\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub178\ub3d9 3\uad8c\uc5d0\ub294 \uadfc\ub85c\uad8c, \ub2e8\uacb0\uad8c, \ub2e8\uccb4 \uad50\uc12d\uad8c\uc774 \ud3ec\ud568\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uadfc\ub85c\uad8c\uc740 \uc77c\ud560 \uae30\ud68c \uc81c\uacf5\uc744 \uc694\uad6c\ud558\ub294 \ubcc4\ub3c4\uc758 \uad8c\ub9ac\uc774\uba70, \ub178\ub3d9 3\uad8c\uc740 \ub2e8\uacb0\uad8c, \ub2e8\uccb4 \uad50\uc12d\uad8c, \ub2e8\uccb4 \ud589\ub3d9\uad8c\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ub178\ub3d9\uc790\ub294 \uc0ac\uc6a9\uc790\uc640 \ub300\ub4f1\ud55c \uc704\uce58\uc5d0\uc11c \ud611\uc0c1\ud560 \uc218 \uc788\ub3c4\ub85d \ub178\ub3d9 3\uad8c\uc744 \ubcf4\uc7a5\ubc1b\ub294\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0c1\ub300\uc801 \uc57d\uc790\uc778 \ub178\ub3d9\uc790\uac00 \uc0ac\uc6a9\uc790\uc640 \ub300\ub4f1\ud55c \uc9c0\uc704\uc5d0\uc11c \uadfc\ub85c \uc870\uac74\uc744 \ud611\uc0c1\ud560 \uc218 \uc788\ub3c4\ub85d \ub178\ub3d9 3\uad8c\uc774 \ud5cc\ubc95\uc73c\ub85c \ubcf4\uc7a5\ub429\ub2c8\ub2e4."
