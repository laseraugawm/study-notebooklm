        {
          "text": "\uadfc\ub85c\uad8c\uc774\ub780 \ub178\ub3d9\uc790\uac00 \uc0ac\uc6a9\uc790\uc5d0 \ub9de\uc11c \uc9d1\ub2e8\uc73c\ub85c \ud589\ub3d9\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\ub97c \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9d1\ub2e8\uc73c\ub85c \ud589\ub3d9\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\ub294 \ub178\ub3d9 3\uad8c \uc911 '\ub2e8\uccb4 \ud589\ub3d9\uad8c'\uc5d0 \ud574\ub2f9\ud558\uba70, \uadfc\ub85c\uad8c\uc740 \uc77c\ud560 \uae30\ud68c\uc758 \uc81c\uacf5\uc744 \uc694\uad6c\ud558\ub294 \uad8c\ub9ac\uc785\ub2c8\ub2e4."
