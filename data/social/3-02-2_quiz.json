    {
      "type": "multiple_choice",
      "question": "\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \ub3c4\ubaa8\ud558\uae30 \uc704\ud55c '\uc724\ub9ac\uc801 \uc18c\ube44'\uc758 \uc62c\ubc14\ub978 \ubaa8\uc2b5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0c1\ud488\uc758 \uc6d0\ub8cc \uc7ac\ubc30\ubd80\ud130 \uc0dd\uc0b0, \uc720\ud1b5, \ucc98\ub9ac \uc804 \uacfc\uc815\uc774 \ub098\uc758 \uc18c\ube44\uc640 \uc5f0\uacb0\ub418\uc5b4 \uc788\uc74c\uc744 \uc778\uc2dd\ud558\uace0 \uad6c\ub9e4\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc724\ub9ac\uc801 \uc18c\ube44\ub294 \uc0c1\ud488\uc758 \uc804 \uacfc\uc815\uc774 \uc5f0\uacb0\ub418\uc5b4 \uc788\uc74c\uc744 \uc778\uc9c0\ud558\uace0 \uce5c\ud658\uacbd \uc81c\ud488\uc774\ub098 \uacf5\uc815 \ubb34\uc5ed \uc81c\ud488 \ub4f1 \uc724\ub9ac\uc801\uc73c\ub85c \uc0dd\uc0b0\ub41c \uc0c1\ud488\uc744 \uad6c\ub9e4\ud558\ub294 \ud589\ub3d9\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub2e4\ub978 \uc694\uc778\uc740 \uace0\ub824\ud558\uc9c0 \uc54a\uace0 \uc624\uc9c1 \uc0c1\ud488\uc758 \uac00\uaca9\uc774 \uac00\uc7a5 \uc800\ub834\ud55c \uac83\ub9cc\uc744 \uc6b0\uc120 \uc120\ud0dd\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac00\uaca9\ub9cc\uc744 \uae30\uc900\uc73c\ub85c \uc0bc\ub294 \uac83\uc740 \ub2e8\uc21c \ube44\uc6a9 \ucd5c\uc18c\ud654 \ubc29\uc2dd\uc774\uba70 \uc724\ub9ac\uc801 \uc18c\ube44\uc758 \uac00\uce58\uad00\uacfc\ub294 \ucc28\uc774\uac00 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc2e0\uc758 \uc18c\ub4dd \uc218\uc900\uc774\ub098 \uacc4\ud68d\uacfc \uc0c1\uad00\uc5c6\uc774 \uacfc\uc2dc\ub97c \uc704\ud574 \uace0\uac00\uc758 \uba85\ud488\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \uc18c\ube44\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacfc\uc2dc\uc801 \uc18c\ube44\ub098 \ubb34\uacc4\ud68d\uc801\uc778 \uacfc\uc18c\ube44\ub294 \ud569\ub9ac\uc801 \uc18c\ube44 \ubc0f \uc724\ub9ac\uc801 \uc18c\ube44\uc5d0 \ubc18\ud558\ub294 \ud589\ub3d9\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\uc5c5\uc774 \uc0dd\uc0b0 \uacfc\uc815\uc5d0\uc11c \ud658\uacbd\uc744 \uc624\uc5fc\uc2dc\ud0a4\ub354\ub77c\ub3c4 \uc81c\ud488\uc758 \uc131\ub2a5\uc774 \ub6f0\uc5b4\ub098\ub2e4\uba74 \uc801\uadf9 \uad6c\ub9e4\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc724\ub9ac\uc801 \uc18c\ube44\uc790\ub294 \uc0dd\uc0b0 \uacfc\uc815\uc5d0\uc11c\uc758 \ud658\uacbd \ubcf4\ud638\ub098 \uacf5\uc815\uc131 \ub4f1 \uc724\ub9ac\uc801 \uc2e0\ub150\uc744 \ubc18\uc601\ud558\uc5ec \uc81c\ud488\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc724\ub9ac\uc801 \uc18c\ube44\ub294 \uc81c\ud488\uc758 \ub2e8\uc21c\ud55c \uac00\uaca9\uc774\ub098 \ud6a8\uc6a9\uc744 \ub118\uc5b4, \uc0dd\uc0b0 \ubc0f \uc720\ud1b5 \uc804 \uacfc\uc815\uc5d0 \ub2f4\uae34 \uc0ac\ud68c\uc801\u00b7\ud658\uacbd\uc801 \uac00\uce58\ub97c \uace0\ub824\ud569\ub2c8\ub2e4."
