    {
      "type": "multiple_choice",
      "question": "\uc678\ubd80 \ud6a8\uacfc \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc815\ubd80\uac00 \ucde8\ud560 \uc218 \uc788\ub294 \ubc14\ub78c\uc9c1\ud55c \uc815\ucc45 \uc218\ub2e8\uc73c\ub85c \uc633\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
