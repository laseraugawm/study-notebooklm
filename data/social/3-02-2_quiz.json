        {
          "text": "\uc9c0\uc5ed \uc0ac\ud68c \uacf5\ud5cc \ubc0f \ud611\ub825\uc0ac\uc640\uc758 \uc0c1\uc0dd\uc744 \ub3c4\ubaa8\ud558\ub294 '\uc790\uc120\uc801 \ubc0f \uc724\ub9ac\uc801 \ucc45\uc784'",
          "isCorrect": true,
          "rationale": "\ud611\ub825\uc0ac\uc758 \uc790\uae08 \ubd80\ub2f4\uc744 \uc644\ud654\ud574 \uc8fc\uace0 \uba85\uc808 \ub098\ub214\uc744 \uc2e4\ucc9c\ud558\ub294 \uac83\uc740 \uae30\uc5c5\uc774 \uc0ac\ud68c\uc801 \uc601\ud5a5\ub825\uc744 \uace0\ub824\ud558\uc5ec \uc2e4\ucc9c\ud558\ub294 \uc724\ub9ac\uc801\u00b7\uc790\uc120\uc801 \ucc45\uc784 \ub2e8\uacc4\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80\uc758 \ud589\uc815 \uba85\ub839\uc5d0 \ub530\ub77c compulsory\ud558\uac8c \uc774\ud589\ud558\ub294 '\ud589\uc815\uc801 \ucc45\uc784'",
          "isCorrect": false,
          "rationale": "\ud574\ub2f9 \uc0ac\ub840\ub294 \uae30\uc5c5\uc774 \uc790\ubc1c\uc801\uc778 \uc870\uce58\uc758 \uc77c\ud658\uc73c\ub85c \ucd94\uc9c4\ud574 \uc628 \uc0c1\uc0dd \ud611\ub825 \ud65c\ub3d9\uc785\ub2c8\ub2e4."
