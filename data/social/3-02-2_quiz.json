    {
      "type": "multiple_choice",
      "question": "\uad6d\uac00 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804 \ubaa9\ud45c(K-SDGs)\uc5d0 \uae30\ubc18\ud558\uc5ec \uc6b0\ub9ac\ub098\ub77c \uc815\ubd80\uac00 \ucd94\uc9c4\ud558\ub294 \uc8fc\uc694 \uacbd\uc81c \uad00\ub828 \uc815\ucc45 \ub0b4\uc6a9\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5d0\ub108\uc9c0\uc758 \uce5c\ud658\uacbd\uc801 \uc0dd\uc0b0\uacfc \uc18c\ube44 \uc2e4\ud604",
          "isCorrect": false,
          "rationale": "\uce5c\ud658\uacbd \uc5d0\ub108\uc9c0 \uc0dd\uc0b0 \ubc0f \uc18c\ube44\ub294 K-SDGs\uc758 \uacbd\uc81c \ubd84\uc57c \uc138\ubd80 \ubaa9\ud45c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc88b\uc740 \uc77c\uc790\ub9ac \ud655\ub300 \ubc0f \uc9c0\uc18d\uac00\ub2a5\ud55c \uc0dd\uc0b0\uacfc \uc18c\ube44 \ucd94\uc9c4",
          "isCorrect": false,
          "rationale": "\uc77c\uc790\ub9ac \ucc3d\ucd9c \ubc0f \uc9c0\uc18d\uac00\ub2a5\ud55c \uacbd\uc81c \uad6c\uc870 \uad6c\ucd95\uc740 K-SDGs\uc758 \ud575\uc2ec \uc815\ucc45 \ubc29\ud5a5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0b0\uc5c5\uc758 \uc131\uc7a5\uacfc \ud601\uc2e0 \ud65c\uc131\ud654 \ubc0f \uc0ac\ud68c \uae30\ubc18 \uc2dc\uc124 \uad6c\ucd95",
