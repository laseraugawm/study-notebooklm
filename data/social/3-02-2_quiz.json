        {
          "text": "\ub178\ub3d9\uc790\ub294 \uae30\uc5c5\uc758 \uc874\ub9bd \uc5ec\ubd80\uc640 \uc0c1\uad00\uc5c6\uc774 \uc624\uc9c1 \uc790\uc2e0\uc758 \uacbd\uc81c\uc801 \uc774\uc775 \ubcf4\uc7a5\ub9cc\uc744 \uc801\uadf9 \uc694\uad6c\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub178\ub3d9\uc790\ub294 \uae30\uc5c5\uc774 \uc874\ub9bd\ud558\uc9c0 \uc54a\uc73c\uba74 \uc77c\uc790\ub9ac\uac00 \uc720\uc9c0\ub420 \uc218 \uc5c6\uc74c\uc744 \uc778\uc2dd\ud558\uace0 \uae30\uc5c5\uac00\uc640 \uc0c1\ud638 \ub3d9\ubc18\uc790 \uc758\uc2dd\uc744 \uac00\uc838\uc57c \ud569\ub2c8\ub2e4."
