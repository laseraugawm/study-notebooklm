    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc0ac\ub840\uc5d0\uc11c \ub098\ud0c0\ub09c \uc2dc\uc7a5\uacbd\uc81c\uc758 \ud575\uc2ec \uac1c\ub150\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n\"\ucc44\uc2dd\uc8fc\uc758 \uc18c\ube44 \uacbd\ud5a5\uc774 \ud654\uc7a5\ud488 \uc5c5\uacc4\ub85c \ud655\ub300\ub418\uba74\uc11c \ud658\uacbd\uce5c\ud654\uc801\uc73c\ub85c \ub9cc\ub4e0 \ud654\uc7a5\ud488\uc744 \uc120\ud638\ud558\ub294 \uc18c\ube44\uc790\ub4e4\uc774 \ub298\uace0 \uc788\ub2e4. \uc774\uc5d0 \ud654\uc7a5\ud488 \uc5c5\uacc4\ub294 \ub3d9\ubb3c \uc2e4\ud5d8\uacfc \ub3d9\ubb3c\uc131 \uc6d0\ub8cc\ub97c \uc9c0\uc591\ud558\uace0, \uce5c\ud658\uacbd \uc885\uc774 \ud3ec\uc7a5\uc7ac\ub85c \ub300\uccb4\ud558\uace0 \uc788\ub2e4.\"",
      "answerOptions": [
        {
          "text": "\uae30\ud68c\ube44\uc6a9",
          "isCorrect": false,
          "rationale": "\uc5b4\ub5a4 \uc120\ud0dd\uc73c\ub85c \uc778\ud574 \ud3ec\uae30\ud558\ub294 \uac00\uce58\ub97c \uc758\ubbf8\ud558\ub294 \uae30\ud68c\ube44\uc6a9\uacfc\ub294 \uc9c1\uc811\uc801 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\ube44\uc790 \uc8fc\uad8c",
          "isCorrect": true,
          "rationale": "\uc18c\ube44\uc790\ub4e4\uc758 \uc120\ud638\uc640 \uc724\ub9ac\uc801 \uac00\uce58\ub97c \ubc18\uc601\ud55c \uc18c\ube44 \uc120\ud0dd\uc774 \uae30\uc5c5\uc758 \uc0dd\uc0b0 \ubc29\uc2dd \ubc0f \uc0c1\ud488 \uc885\ub958 \uacb0\uc815\uc5d0 \ucd5c\uc885\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce5c\ub2e4\ub294 \uac83\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc18c\ube44\uc790 \uc8fc\uad8c \uc0ac\ub840\uc785\ub2c8\ub2e4."
