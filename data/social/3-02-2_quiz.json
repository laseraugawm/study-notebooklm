        {
          "text": "\uc8fc\uc8fc\uc5d0\uac8c \uc774\uc775\uc744 \ubc30\ub2f9\ud558\uace0 \uc774\uc724\uc744 \uadf9\ub300\ud654\ud558\ub294 '\uacbd\uc81c\uc801 \ucc45\uc784'",
          "isCorrect": false,
          "rationale": "\uc790\uae08 \uc0ac\uc815\uc774 \uc5b4\ub824\uc6b4 \ud611\ub825\uc0ac\ub97c \ubc30\ub824\ud558\uc5ec \uba85\uc808 \uc804 \uc870\uae30 \uc9c0\uae09\ud558\ub294 \uc0c1\uc0dd \ud589\uc704\ub294 \ub2e8\uc21c \uc774\uc724 \uadf9\ub300\ud654 \ud589\uc704\uc640 \uad6c\ubd84\ub429\ub2c8\ub2e4."
