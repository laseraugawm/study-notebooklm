    {
      "type": "multiple_choice",
      "question": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc774\ub8e8\uae30 \uc704\ud574 \uc11c\ub85c \uade0\ud615\uacfc \uc870\ud654\ub97c \uc774\ub8e8\uc5b4\uc57c \ud558\ub294 3\ub300 \ud575\uc2ec \uc601\uc5ed\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uacbd\uc81c \ubc1c\uc804, \uc0ac\ud68c \uc548\uc815\uacfc \ud1b5\ud569, \ud658\uacbd \ubcf4\uc804",
          "rationale": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc740 \uacbd\uc81c \uc131\uc7a5, \uc0ac\ud68c\uc801 \ud1b5\ud569 \ubc0f \uc548\uc815, \uadf8\ub9ac\uace0 \uc790\uc5f0 \ud658\uacbd \ubcf4\uc804\uc774\ub77c\ub294 \uc138 \uac00\uc9c0 \uce21\uba74\uc774 \uade0\ud615\uc744 \uc774\ub8f0 \ub54c \ub2ec\uc131\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc0b0\uc5c5 \uac1c\ubc1c, \uacfc\ud559\uae30\uc220 \ubc1c\ub2ec, \uc778\uad6c \uc99d\uac00",
          "rationale": "\uc0b0\uc5c5 \uac1c\ubc1c, \uae30\uc220 \ubc1c\ub2ec, \uc778\uad6c \uc99d\uac00\ub294 \uc0b0\uc5c5\ud654 \uacfc\uc815\uc5d0\uc11c \uc77c\uc5b4\ub09c \ud604\uc0c1\uc73c\ub85c \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc758 3\ub300 \uc870\ud654 \uc601\uc5ed\uc774 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3c4\uc2dc\ud654, \ud1a0\uc9c0 \uac1c\ubc1c, \uc790\uc6d0 \uace0\uac08",
          "rationale": "\ub3c4\uc2dc\ud654, \ud1a0\uc9c0 \uac1c\ubc1c, \uc790\uc6d0 \uace0\uac08\uc740 \uae30\ud6c4\ubcc0\ud654 \ubc0f \uc0dd\ud0dc\uacc4 \ud30c\uad34\ub97c \ucd08\ub798\ud558\ub294 \uc6d0\uc778\uc774\ub098 \uacb0\uacfc\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubb34\uc5ed \ud655\ub300, \uad00\uc138 \ubd80\uacfc, \ubc30\ucd9c\uad8c \ub9e4\ub9e4",
          "rationale": "\uad00\uc138 \ubd80\uacfc \ubc0f \ubc30\ucd9c\uad8c \ub9e4\ub9e4\ub294 \ud658\uacbd \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \ud65c\uc6a9\ub418\ub294 \ud2b9\uc815 \uc815\ucc45 \uc218\ub2e8 \ubc0f \uc218\ub2e8\uc801 \uc81c\ub3c4\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804 \ubca4\ub2e4\uc774\uc5b4\uadf8\ub7a8\uc5d0 \ub098\ud0c0\ub09c \uacbd\uc81c, \uc0ac\ud68c, \ud658\uacbd \ucc28\uc6d0\uc758 \uade0\ud615 \uc694\uc18c\ub97c \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "2015\ub144 \uc81c70\ucc28 \uad6d\uc81c \uc5f0\ud569(UN) \ucd1d\ud68c\uc5d0\uc11c \ucc44\ud0dd\ub41c '\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804 \ubaa9\ud45c(SDGs)'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ube48\uace4 \ud1f4\uce58\ub97c \ube44\ub86f\ud574 \uc591\uadf9\ud654, \ubd88\ud3c9\ub4f1, \ud658\uacbd \ubb38\uc81c \ub4f1\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud55c 17\uac1c \ubaa9\ud45c\uc640 169\uac1c \uc138\ubd80 \ubaa9\ud45c\ub97c \ub2f4\uace0 \uc788\ub2e4.",
          "rationale": "SDGs\ub294 \uacbd\uc81c\u00b7\uc0ac\ud68c\uc801 \ubd88\ud3c9\ub4f1\uacfc \ud658\uacbd \ubb38\uc81c\ub97c \uc885\ud569\uc801\uc73c\ub85c \ud574\uacb0\ud558\uae30 \uc704\ud574 17\uac1c\uc758 \ubaa9\ud45c\uc640 169\uac1c\uc758 \uc138\ubd80 \ubaa9\ud45c\ub85c \uad6c\uc131\ub418\uc5b4 2030\ub144\uae4c\uc9c0 \ub2ec\uc131\ud558\uae30\ub85c \ucc44\ud0dd\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc120\uc9c4\uad6d\uc5d0\ub9cc \uc628\uc2e4\uac00\uc2a4 \uac10\ucd95 \uc758\ubb34\ub97c \ubd80\uacfc\ud558\uace0 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \uc774\ud589 \ub300\uc0c1\uc5d0\uc11c \uc804\uba74 \uc81c\uc678\ud558\uc600\ub2e4.",
          "rationale": "SDGs\ub294 \uc120\uc9c4\uad6d\ubfd0\ub9cc \uc544\ub2c8\ub77c 2030\ub144\uae4c\uc9c0 \ubaa8\ub4e0 \uad6d\uac00\uac00 \ud568\uaed8 \ub2ec\uc131\ud558\uae30\ub85c \uacb0\uc758\ud55c \ubc94\uc9c0\uad6c\uc801 \ubaa9\ud45c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud658\uacbd \ubcf4\ud638\uc5d0\ub9cc \uc9d1\uc911\ud558\uc5ec \uacbd\uc81c\uc801 \uc131\uc7a5\uc5d0 \uad00\ud55c \uc138\ubd80 \ubaa9\ud45c\ub294 \uc804\ud600 \ud3ec\ud568\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "rationale": "SDGs\uc5d0\ub294 \uc591\uc9c8\uc758 \uc77c\uc790\ub9ac\uc640 \uacbd\uc81c \uc131\uc7a5, \uc0b0\uc5c5 \uc778\ud504\ub77c \ub4f1 \uacbd\uc81c\u00b7\uc0ac\ud68c\uc801 \uc7c1\uc810\uc774 \ud1b5\ud569\uc801\uc73c\ub85c \ubc18\uc601\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc720\ub7fd \uc5f0\ud569(EU) \uc5ed\uc678 \uc218\ucd9c \uae30\uc5c5\ub4e4\uc5d0 \ud0c4\uc18c \uad00\uc138\ub97c \ubd80\uacfc\ud558\ub294 \uc815\ucc45\uc73c\ub85c \uccb4\uacb0\ub418\uc5c8\ub2e4.",
          "rationale": "\uc218\ucd9c \ud488\ubaa9 \uc0dd\uc0b0 \uc2dc \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc5d0 \uad00\uc138\ub97c \ub9e4\uae30\ub294 \uc815\ucc45\uc740 EU\uc758 \ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4(CBAM)\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "UN \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804 \ubaa9\ud45c\uac00 \ub2f4\uace0 \uc788\ub294 \uc885\ud569\uc801\uc778 \ubb38\uc81c \ud574\uacb0 \uacfc\uc81c\uc758 \uc218\uc640 \uc138\ubd80 \ubaa9\ud45c\uc758 \uad6c\uc131 \ubc29\uc2dd\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc704\ud55c \uac1c\uc778\uc801 \uc2e4\ucc9c \ud589\ub3d9 \uc911 '\ub85c\uceec \ud478\ub4dc(Local Food)' \uad6c\ub9e4\uac00 \uc628\uc2e4\uac00\uc2a4 \uac10\ucd95\uacfc \ud658\uacbd \ubcf4\ud638\uc5d0 \uae30\uc5ec\ud558\ub294 \uc8fc\uc694 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ub18d\uc0b0\ubb3c\uc758 \uc7a5\uac70\ub9ac \uc6b4\uc1a1 \uacfc\uc815\uc744 \uac70\uce58\uc9c0 \uc54a\uc544 \uc6b4\uc1a1 \uc218\ub2e8\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc628\uc2e4\uac00\uc2a4 \ubc0f \uc624\uc5fc \ubb3c\uc9c8\uc744 \uc904\uc77c \uc218 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ub85c\uceec \ud478\ub4dc\ub294 \uc9c0\uc5ed \ub18d\uc0b0\ubb3c\uc744 \uc18c\ube44\ud568\uc73c\ub85c\uc368 \uc7a5\uac70\ub9ac \uc218\uc1a1 \uc2dc \uc774\ub3d9 \uc218\ub2e8(\ud2b8\ub7ed, \ubc30, \ube44\ud589\uae30 \ub4f1)\uc5d0\uc11c \ubc30\ucd9c\ub418\ub294 \uc628\uc2e4\uac00\uc2a4\ub97c \ud06c\uac8c \uc904\uc5ec \uc90d\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud574\uc678 \uc720\uae30\ub18d \uc778\uc99d \uae30\uad00\uc758 \uc5c4\uaca9\ud55c \uac00\uacf5 \uc2ec\uc0ac\ub97c \uac70\uccd0 \uc218\uc785\ub418\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ub85c\uceec \ud478\ub4dc\ub294 \uba3c \uac70\ub9ac \uc218\uc1a1\uc744 \uac70\uce58\uc9c0 \uc54a\uc740 \uc9c0\uc5ed \uc0dd\uc0b0 \ub18d\uc0b0\ubb3c\uc744 \uc758\ubbf8\ud558\ubbc0\ub85c \ud574\uc678 \uc218\uc785\ud488\uacfc \uac70\ub9ac\uac00 \uba49\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c \ud560\ub2f9\ub7c9\uc744 \uc2dc\uc7a5\uc5d0\uc11c \uc790\uc720\ub86d\uac8c \uc0ac\uace0\ud314 \uc218 \uc788\ub294 \uc790\uaca9\uc744 \ubd80\uc5ec\ubc1b\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c\uad8c \uac70\ub798\ub294 \uad6d\uac00\ub098 \uae30\uc5c5 \uac04\uc5d0 \ubc30\ucd9c \ud560\ub2f9\ub7c9\uc744 \ub9e4\ub9e4\ud558\ub294 \uc81c\ub3c4\uc801 \uc7a5\uce58\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3c4\uc2dc \uac1c\ubc1c\uacfc \ud1a0\uc9c0 \uc774\uc6a9 \ud655\ub300\ub97c \ucd09\uc9c4\ud558\ub294 \ud575\uc2ec \uc0b0\uc5c5\uc774\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ud1a0\uc9c0 \uac1c\ubc1c \ubc0f \ub3c4\uc2dc\ud654\uc758 \ubb34\ubd84\ubcc4\ud55c \ud655\ub300\ub294 \uc628\uc2e4\uac00\uc2a4 \uc99d\uac00\uc640 \ud1a0\uc9c0 \ud658\uacbd \ud30c\uad34\uc758 \uc778\uc704\uc801 \uc6d0\uc778\uc774 \ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc2dd\ud488\uc774 \uc0dd\uc0b0\uc9c0\uc5d0\uc11c \uc18c\ube44\uc790\uc758 \uc2dd\ud0c1\uae4c\uc9c0 \uc774\ub3d9\ud558\ub294 '\uc6b4\uc1a1 \uac70\ub9ac'\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "1992\ub144 \uad6d\uc81c \uc5f0\ud569 \ud658\uacbd \uac1c\ubc1c \ud68c\uc758(UNCED)\uc5d0\uc11c \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud574 \ucc44\ud0dd\ud55c \ud589\ub3d9 \uc9c0\uce68\uc73c\ub85c, \uc790\uc5f0\uc790\uc6d0\uc758 \ubcf4\uc804\uacfc \uad00\ub9ac\ubfd0 \uc544\ub2c8\ub77c \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \uc7c1\uc810\uae4c\uc9c0 \ud3ed\ub113\uac8c \ub2e4\ub8ec \uac83\uc740?",
      "answerOptions": [
