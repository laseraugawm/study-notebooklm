    {
      "type": "multiple_choice",
      "question": "'\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804'\uc758 \uc62c\ubc14\ub978 \uc758\ubbf8\ub97c \uc124\uba85\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubbf8\ub798 \uc138\ub300\uac00 \uc0ac\uc6a9\ud560 \uc790\uc6d0\uc744 \ub0ad\ube44\ud558\uac70\ub098 \ud658\uacbd\uc744 \ud6fc\uc190\ud558\uc9c0 \uc54a\uc73c\uba74\uc11c \ud604\uc7ac \uc138\ub300\uc758 \ud544\uc694\ub97c \ucda9\uc871\ud558\ub294 \ubc1c\uc804\uc774\ub2e4.",
          "rationale": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc740 \ubbf8\ub798 \uc138\ub300\uc758 \uc0dd\uc874 \uae30\ubc18\uc744 \uce68\ud574\ud558\uc9c0 \uc54a\ub294 \ubc94\uc704 \ub0b4\uc5d0\uc11c \ud604\uc7ac \uc138\ub300\uc758 \ud544\uc694\ub97c \uc870\ud654\ub86d\uac8c \ucda9\uc871\ud558\ub294 \ubc1c\uc804\uc744 \ub73b\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubbf8\ub798 \uc138\ub300\uc758 \uc790\uc6d0 \uc0ac\uc6a9\uc744 \uc81c\ud55c\ud558\ub354\ub77c\ub3c4 \ud604\uc7ac \uc138\ub300\uc758 \ubb34\ubd84\ubcc4\ud55c \uacbd\uc81c\uc801 \uc131\uc7a5\uc744 \ucd5c\uc6b0\uc120\uc73c\ub85c \ub3c4\ubaa8\ud558\ub294 \ubc1c\uc804\uc774\ub2e4.",
          "rationale": "\ud604\uc7ac \uc138\ub300\uc758 \ubb34\ubd84\ubcc4\ud55c \uc790\uc6d0 \uace0\uac08\uacfc \ud658\uacbd \ud30c\uad34\ub97c \uc9c0\uc591\ud558\uace0 \ubbf8\ub798 \uc138\ub300\ub97c \ubc30\ub824\ud558\ub294 \uac83\uc774 \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud658\uacbd \ubcf4\uc874\ub9cc\uc744 \uc720\uc77c\ud55c \ubaa9\uc801\uc73c\ub85c \uc0bc\uc544 \uacbd\uc81c \uac1c\ubc1c\uacfc \uc0ac\ud68c\uc801 \uacf5\uc815\uc131 \ub17c\uc758\ub97c \uc804\uba74 \uc911\ub2e8\ud558\ub294 \ubc1c\uc804\uc774\ub2e4.",
          "rationale": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc740 \ud658\uacbd \ubcf4\uc874\ubfd0\ub9cc \uc544\ub2c8\ub77c \uacbd\uc81c \ubc1c\uc804\uacfc \uc0ac\ud68c \uc548\uc815\u00b7\ud1b5\ud569\uc758 \uade0\ud615\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uac1c\ubc1c\uc744 \uc9c0\uc591\ud558\uace0 \ud55c\uc815\ub41c \ud654\uc11d \uc5d0\ub108\uc9c0 \uc790\uc6d0\uc758 \ub2e8\uae30\uc801 \uc18c\ube44\uc728\uc744 \uadf9\ub300\ud654\ud558\ub294 \ubc1c\uc804\uc774\ub2e4.",
          "rationale": "\ud654\uc11d \uc5d0\ub108\uc9c0\uc758 \ubb34\ubd84\ubcc4\ud55c \uc0ac\uc6a9\uc740 \uc790\uc6d0 \uace0\uac08\uacfc \uae30\ud6c4\ubcc0\ud654\ub97c \uc720\ubc1c\ud558\uc5ec \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc800\ud574\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ud604\uc7ac \uc138\ub300\uc758 \uc695\uad6c \ucda9\uc871\uacfc \ubbf8\ub798 \uc138\ub300\uc758 \uc0b6\uc758 \ud658\uacbd \ubcf4\uc804 \uac04\uc758 \uad00\uacc4\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
