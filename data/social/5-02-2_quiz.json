{
  "title": "\uae30\ud6c4\ubcc0\ud654 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \uae30\ud6c4\ubcc0\ud654\uac00 \uc77c\uc5b4\ub098\ub294 \uc6d0\uc778 \uac00\uc6b4\ub370 \uc790\uc5f0\uc801 \uc6d0\uc778\uc73c\ub85c\ub9cc \ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud0dc\uc591 \ud65c\ub3d9\uc758 \ubcc0\ud654, \ub300\uaddc\ubaa8 \ud654\uc0b0 \ud65c\ub3d9",
          "rationale": "\ud0dc\uc591 \ud65c\ub3d9\uc758 \ubcc0\ud654\uc640 \ub300\uaddc\ubaa8 \ud654\uc0b0 \ud65c\ub3d9\uc740 \uc778\uac04\uc758 \uac1c\uc785 \uc5c6\uc774 \uc9c0\uad6c \uc678\ubd80\ub098 \ub0b4\ubd80\uc758 \uc790\uc5f0 \ud604\uc0c1\uc73c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \uae30\ud6c4\ubcc0\ud654 \uc694\uc778\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud654\uc11d \uc5d0\ub108\uc9c0 \uc0ac\uc6a9 \uc99d\uac00, \ub3c4\uc2dc\ud654\uc640 \ud1a0\uc9c0 \uac1c\ubc1c",
          "rationale": "\ud654\uc11d \uc5d0\ub108\uc9c0 \uc0ac\uc6a9\uacfc \ub3c4\uc2dc\ud654 \ubc0f \ud1a0\uc9c0 \uac1c\ubc1c\uc740 \uc778\uac04\uc758 \uc0ac\ud68c\u00b7\uacbd\uc81c \ud65c\ub3d9\uc73c\ub85c \uc778\ud574 \ub098\ud0c0\ub098\ub294 \ub300\ud45c\uc801\uc778 \uc778\uc704\uc801 \uc6d0\uc778\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3c4\uc2dc\ud654\uc5d0 \ub530\ub978 \ud1a0\uc9c0 \uc774\uc6a9\ub3c4 \ubcc0\ud654, \ub300\uaddc\ubaa8 \ud654\uc0b0 \ud65c\ub3d9",
          "rationale": "\ub300\uaddc\ubaa8 \ud654\uc0b0 \ud65c\ub3d9\uc740 \uc790\uc5f0\uc801 \uc6d0\uc778\uc774 \ub9de\uc9c0\ub9cc, \ud1a0\uc9c0 \uc774\uc6a9\ub3c4 \ubcc0\ud654\ub294 \uc778\uac04\uc758 \ud1a0\uc9c0 \uac1c\ubc1c\uc5d0 \uc758\ud55c \uc778\uc704\uc801 \uc6d0\uc778\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c\ub7c9 \uc99d\uac00, \ud0dc\uc591\uacfc \uc9c0\uad6c\uc758 \uc704\uce58 \ubcc0\ud654",
          "rationale": "\ud0dc\uc591\uacfc \uc9c0\uad6c\uc758 \uc704\uce58 \ubcc0\ud654\ub294 \uc790\uc5f0\uc801 \uc6d0\uc778\uc774\uc9c0\ub9cc, \ud654\uc11d \uc5d0\ub108\uc9c0 \uc0ac\uc6a9\uc5d0 \ub530\ub978 \uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c\ub7c9 \uc99d\uac00\ub294 \uc778\uc704\uc801 \uc6d0\uc778\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc778\uac04\uc758 \uc0ac\ud68c\u00b7\uacbd\uc81c\uc801 \ud65c\ub3d9\uc774\ub098 \ub3c4\uc2dc \uac1c\ubc1c\uacfc \uc0c1\uad00\uc5c6\uc774 \ubc1c\uc0dd\ud558\ub294 \uc9c0\uad6c \uc548\ud30e\uc758 \uc790\uc5f0 \ud604\uc0c1\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uae30\ud6c4\ubcc0\ud654 \ud574\uacb0\uc744 \uc704\ud574 \uad6d\uc81c \uc0ac\ud68c\uac00 \ub9fa\uc740 \ud611\uc57d \ubc0f \uc81c\ub3c4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud30c\ub9ac \ud611\uc815\uc740 \uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc774 \ubaa8\ub450 \uc628\uc2e4\uac00\uc2a4 \uac10\ucd95 \uc758\ubb34\uc5d0 \ub3d9\ucc38\ud558\ub3c4\ub85d \uaddc\uc815\ud558\uc600\ub2e4.",
          "rationale": "\ud30c\ub9ac \ud611\uc815\uc740 \uae30\uc874\uacfc \ub2ec\ub9ac \uc120\uc9c4\uad6d\ubfd0\ub9cc \uc544\ub2c8\ub77c \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc744 \ud3ec\ud568\ud55c \ubaa8\ub4e0 \ub2f9\uc0ac\uad6d\uc774 \uc628\uc2e4\uac00\uc2a4 \uac10\ucd95 \uc758\ubb34\uc5d0 \ub3d9\ucc38\ud558\ub3c4\ub85d \ucc44\ud0dd\ub41c \ud611\uc57d\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uad50\ud1a0 \uc758\uc815\uc11c\ub294 \uc720\ub7fd \uc5f0\ud569 \uc5ed\uc678 \uae30\uc5c5\uc758 \uc218\uc785\ud488\uc5d0 \ud0c4\uc18c \uad00\uc138\ub97c \ubd80\uacfc\ud558\ub294 \ub0b4\uc6a9\uc744 \uace8\uc790\ub85c \ud55c\ub2e4.",
          "rationale": "\uc720\ub7fd \uc5f0\ud569 \uc5ed\uc678 \uae30\uc5c5\uc758 \uc218\uc785 \ud488\ubaa9 \uc0dd\uc0b0 \uc2dc \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc744 \ucd94\uc815\ud558\uc5ec \uad00\uc138\ub97c \ubd80\uacfc\ud558\ub294 \uc81c\ub3c4\ub294 EU\uc758 \ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4(CBAM)\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud30c\ub9ac \ud611\uc815\uc5d0\uc11c \uad6d\uac00 \uac04 \ubc30\ucd9c \ud560\ub2f9\ub7c9\uc744 \uc0ac\uace0\ud314 \uc218 \uc788\ub294 \uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c \uac70\ub798\uad8c \uc81c\ub3c4\uac00 \ucc98\uc74c \ub3c4\uc785\ub418\uc5c8\ub2e4.",
          "rationale": "\uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c\uad8c\uc5d0 \uc808\uac10 \uc758\ubb34\uac00 \uc788\ub294 \uad6d\uac00\ub4e4\uc5d0\uac8c \ud560\ub2f9\ub7c9\uc744 \uc124\uc815\ud558\uace0 \uc774\ub97c \uac70\ub798\ud558\ub3c4\ub85d \ud5c8\uc6a9\ud55c \uac83\uc740 \uad50\ud1a0 \uc758\uc815\uc11c \uccb4\uacb0 \ub2f9\uc2dc \ub3c4\uc785\ub41c \uc81c\ub3c4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad50\ud1a0 \uc758\uc815\uc11c\ub294 2015\ub144 \uc81c70\ucc28 UN \ucd1d\ud68c\uc5d0\uc11c \ucc44\ud0dd\ub41c 17\uac1c \uc138\ubd80 \ubaa9\ud45c\ub97c \ud3ec\ud568\ud558\uace0 \uc788\ub2e4.",
          "rationale": "2015\ub144 \uc81c70\ucc28 UN \ucd1d\ud68c\uc5d0\uc11c 17\uac1c \ubaa9\ud45c\uc640 169\uac1c \uc138\ubd80 \ubaa9\ud45c\ub85c \ucc44\ud0dd\ub41c \uac83\uc740 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804 \ubaa9\ud45c(SDGs)\uc5d0 \uad00\ud55c \uc124\uba85\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc774 \ud568\uaed8 \uc628\uc2e4\uac00\uc2a4 \uac10\ucd95\uc5d0 \ub3d9\ucc38\ud558\uae30\ub85c \uc57d\uc18d\ud55c \ud611\uc57d\uc774 \ubb34\uc5c7\uc778\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc720\ub7fd \uc5f0\ud569(EU)\uc774 \uc81c\uc2dc\ud55c '\ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4(CBAM)'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc720\ub7fd \uc5f0\ud569 \uc5ed\ub0b4 \uae30\uc5c5\ub4e4\uc774 \ud574\uc678\ub85c \uacf5\uc7a5\uc744 \uc774\uc804\ud560 \ub54c \ubd80\uacfc\ub418\ub294 \uacfc\uc9d5\uae08 \uc81c\ub3c4\uc774\ub2e4.",
          "rationale": "\ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4\ub294 \uc5ed\ub0b4 \uae30\uc5c5\uc758 \ud574\uc678 \uc774\uc804\uc744 \ub2e8\uc18d\ud558\ub294 \uacfc\uc9d5\uae08\uc774 \uc544\ub2c8\ub77c, \uc5ed\uc678 \uae30\uc5c5\uc774 \ucca0\uac15\u00b7\uc804\uae30\u00b7\uc2dc\uba58\ud2b8 \ub4f1\uc758 \uc81c\ud488\uc744 EU\ub85c \uc218\ucd9c\ud560 \ub54c \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc5d0 \ubd80\uacfc\ud558\ub294 \ud0c4\uc18c \uad00\uc138 \uc815\ucc45\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc720\ub7fd \uc5f0\ud569 \uc5ed\uc678 \uae30\uc5c5\ub4e4\uc774 \ucca0\uac15, \uc804\uae30, \uc2dc\uba58\ud2b8 \ub4f1 6\uac1c \ud488\ubaa9\uc744 \uc218\ucd9c\ud560 \ub54c \uc801\uc6a9\ub41c\ub2e4.",
          "rationale": "\ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4\ub294 \uc9c0\uc815\ub41c 6\uac1c \uc758\ubb34 \ubcf4\uace0 \ud488\ubaa9\uc744 EU\ub85c \uc218\ucd9c\ud558\ub294 \uc5ed\uc678 \uae30\uc5c5\uc744 \ub300\uc0c1\uc73c\ub85c \uc2dc\ud589\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc218\ucd9c \uae30\uc5c5\ub4e4\uc740 \uc900\ube44 \uae30\uac04\ubd80\ud130 \uc758\ubb34 \ubcf4\uace0 \ud488\ubaa9\uc5d0 \ub300\ud55c \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc744 \ubcf4\uace0\ud574\uc57c \ud55c\ub2e4.",
          "rationale": "EU\uc5d0 \uc81c\ud488\uc744 \uc218\ucd9c\ud558\ub294 \uae30\uc5c5\uc740 \uc900\ube44 \uae30\uac04 \uc2dc\uc791 \uc2dc\uc810\ubd80\ud130 \ud574\ub2f9 \ud488\ubaa9\uc758 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc744 \ubcf4\uace0\ud574\uc57c \ud560 \uc758\ubb34\uac00 \uc0dd\uae41\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad6d\uc81c\uae30\uad6c \ucc28\uc6d0\uc5d0\uc11c \uae30\ud6c4\ubcc0\ud654 \ub300\uc751\uc744 \uc704\ud574 \ub9c8\ub828\ub41c \ub300\ud45c\uc801\uc778 \uc81c\ub3c4\uc801 \ubc29\uc548 \uc911 \ud558\ub098\uc774\ub2e4.",
          "rationale": "\uc720\ub7fd \uc5f0\ud569\uc774\ub77c\ub294 \uad6d\uc81c\uae30\uad6c\uac00 \uc5ed\uc678 \uc218\ucd9c\ud488\uc758 \ud0c4\uc18c \ubc30\ucd9c\uc744 \uaddc\uc81c\ud558\uae30 \uc704\ud574 \ub9c8\ub828\ud55c \ub300\ud45c\uc801\uc778 \uc81c\ub3c4\uc801 \uc7a5\uce58\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc774 \uc81c\ub3c4\uac00 \ub204\uad6c\uc5d0\uac8c, \uc5b4\ub5a4 \uacc4\uae30\ub85c \uad00\uc138\ub97c \ub0b4\uac8c \ud558\ub294 \uc815\ucc45\uc778\uc9c0 \ub300\uc0c1\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc5ed\uc0ac \uc18d \uae30\ud6c4\ubcc0\ud654 \uc0ac\ub840\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "13\uc138\uae30 \ucd08 \uc628\ub09c\ud558\uace0 \uac15\uc218\ub7c9\uc774 \ub9ce\uc558\ub358 \uc911\uc138 \uc628\ub09c\uae30\uc758 \uae30\ud6c4 \uc870\uac74\uc774 \uce6d\uae30\uc988 \uce78\uc758 \ubabd\uace8 \uc81c\uad6d \uac74\uc124\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc5c8\ub2e4.",
          "rationale": "13\uc138\uae30 \ucd08 \uc911\uc138 \uc628\ub09c\uae30\uc758 \ud48d\ubd80\ud55c \uac15\uc218\ub7c9\uacfc\u6eab\u6696\ud55c \uae30\ud6c4\ub294 \ucd08\uc6d0\uc758 \ud480\uc744 \ubb34\uc131\ud558\uac8c \ub9cc\ub4e4\uc5b4 \ubabd\uace8 \uae30\ubcd1\uc758 \ub9d0\uacfc \uad70\uc0ac\uc758 \uc601\uc591 \uc0c1\ud0dc\ub97c \uc88b\uac8c \ud558\ub294 \ubc30\uacbd\uc774 \ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uae30\uc6d0\uc804 6000\ub144\uacbd \uc0ac\ud558\ub77c \uc0ac\ub9c9\uc740 \uadf9\ub3c4\ub85c \uac74\uc870\ud574\uc838 \ub098\uc77c\uac15 \ubd80\uadfc\uc758 \uc778\uad6c\uac00 \ubaa8\ub450 \ub2e4\ub978 \uc9c0\uc5ed\uc73c\ub85c \uc774\uc8fc\ud558\uc600\ub2e4.",
          "rationale": "\uae30\uc6d0\uc804 6000~3000\ub144\uacbd \uae30\ud6c4 \ucd5c\uc801\uae30\uc758 \uc0ac\ud558\ub77c \uc0ac\ub9c9\uc740 \ud604\uc7ac\ubcf4\ub2e4 \ud6e8\uc52c \uc2b5\uc724\ud558\uc5ec \ubb3c\uc18c\uc640 \ud558\ub9c8\uac00 \uc11c\uc2dd\ud588\uc73c\uba70 \uc774\uc9d1\ud2b8 \ubb38\uba85 \ubc1c\uc804\uc758 \uc6d0\ub3d9\ub825\uc774 \ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc18c\ube59\ud558\uae30 \ub3d9\uc548 \uc544\uc774\uc2ac\ub780\ub4dc \uc8fc\ubcc0 \uae30\uc628\uc774 \uc0c1\uc2b9\ud558\uc5ec \ub18d\uacbd\uc9c0\uac00 \ud655\ub300\ub418\uace0 \uc778\uad6c\uac00 \ub450 \ubc30\ub85c \ub298\uc5b4\ub0ac\ub2e4.",
          "rationale": "1300~1900\ub144 \uc0ac\uc774\uc758 \uc18c\ube59\ud558\uae30\uc5d0\ub294 \ud55c\ub7ad \ub2e4\uc2b5\ud55c \uae30\ud6c4\ub85c \uc544\uc774\uc2ac\ub780\ub4dc \uc8fc\ubcc0\uc774 \ube59\ud558\ub85c \ub36e\uc5ec \uc778\uad6c\uac00 \uc808\ubc18\uc73c\ub85c \uc904\uc5b4\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc911\uc138 \uc628\ub09c\uae30 \uc720\ub7fd\uc5d0\uc11c\ub294 \uaca8\uc6b8\ucca0 \ucd94\uc704\ub97c \ub9c9\uae30 \uc704\ud574 \ubcbd\uc774 \ub450\uaecd\uace0 \ucc3d\ubb38\uc774 \uc791\uc740 \ubc14\ub85c\ud06c \uc591\uc2dd\uc758 \uac74\ucd95\uc774 \uc720\ud589\ud558\uc600\ub2e4.",
          "rationale": "\ubcbd\uc774 \ub450\uaecd\uace0 \ucc3d\ubb38\uc774 \uc791\uc740 \ubc14\ub85c\ud06c \uac74\ucd95 \uc591\uc2dd\uc774 \ubc1c\ub2ec\ud55c \uac83\uc740 \uc911\uc138 \uc628\ub09c\uae30\uac00 \uc544\ub2cc \uc18c\ube59\ud558\uae30\uc758 \ud639\ud55c\uc5d0 \uc801\uc751\ud558\uae30 \uc704\ud55c \uacb0\uacfc\uc600\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uce6d\uae30\uc988 \uce78\uc774 \uc815\ubcf5 \ud65c\ub3d9\uc744 \ubcf8\uaca9\ud654\ud55c 13\uc138\uae30 \ucd08\uc758 \uae30\ud6c4\uc801 \ud2b9\uc9d5\uacfc \uc720\ubaa9 \uc0dd\ud65c \ud658\uacbd\uc758 \uad00\uacc4\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "1300~1900\ub144 \uc0ac\uc774 \uc720\ub7fd\uc744 \uc911\uc2ec\uc73c\ub85c \ub098\ud0c0\ub09c '\uc18c\ube59\ud558\uae30'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ud558\ub77c \uc0ac\ub9c9 \uc9c0\uc5ed\uc774 \uc628\ub09c \ub2e4\uc2b5\ud574\uc838 \ub3d9\uad74 \ubcbd\ud654\uc5d0 \ubb3c\uc18c\uc640 \ud558\ub9c8\uac00 \uadf8\ub824\uc84c\ub2e4.",
          "rationale": "\uc0ac\ud558\ub77c \uc0ac\ub9c9 \ub3d9\uad74 \ubcbd\ud654\uc5d0 \ubb3c\uc18c\uc640 \ud558\ub9c8\uac00 \uadf8\ub824\uc9c4 \uc2dc\uae30\ub294 \uae30\uc6d0\uc804 6000~3000\ub144 \uc0ac\uc774\uc758 '\uae30\ud6c4 \ucd5c\uc801\uae30'\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub2f9\uc2dc \ud55c\ub7ad \ub2e4\uc2b5\ud588\ub358 \uae30\ud6c4\ub85c \uc778\ud574 \uc544\uc774\uc2ac\ub780\ub4dc \uc8fc\ubcc0\uc774 \ube59\ud558\ub85c \ub36e\uc5ec \uc778\uad6c\uac00 \ud06c\uac8c \uac10\uc18c\ud558\uc600\ub2e4.",
          "rationale": "\uc18c\ube59\ud558\uae30\uc758 \ucd94\uc704\ub85c \uc544\uc774\uc2ac\ub780\ub4dc \uc8fc\ubcc0 \ud658\uacbd\uc774 \uc545\ud654\ub418\uc5b4 \uc778\uad6c\uac00 \ubc18\uc73c\ub85c \uc904\uc5b4\ub4dc\ub294 \ud53c\ud574\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ucd94\uc704\uc5d0 \ub300\ube44\ud574 \ubcbd\uc774 \ub450\uaecd\uace0 \ucc3d\ubb38\uc774 \uc791\uc740 \ubc14\ub85c\ud06c \uac74\ucd95 \uc591\uc2dd\uc774 \ubc1c\ub2ec\ud558\uc600\ub2e4.",
          "rationale": "\uc18c\ube59\ud558\uae30\uc758 \ud639\ub3c5\ud55c \uaca8\uc6b8 \uae30\ud6c4\uc5d0 \uc801\uc751\ud558\uba74\uc11c \ucc28\uac00\uc6b4 \ubc14\ub78c\uc744 \ub9c9\uae30 \uc704\ud55c \ubc14\ub85c\ud06c \uc591\uc2dd\uc758 \uac74\ucd95\uc774 \ubc1c\ub2ec\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ube0c\ub93c\ud5d0\uc758 \u300c\ub208 \uc18d\uc758 \uc0ac\ub0e5\uafbc\u300d\uacfc \uac19\uc774 \ubca8\uae30\uc5d0 \ud50c\ub77c\ub9dd \uc9c0\ubc29\uc758 \ucda5\uace0 \ub208 \ub36e\uc778 \uaca8\uc6b8 \ud48d\uacbd\uc774 \ud654\ud3ed\uc5d0 \ub2f4\uacbc\ub2e4.",
          "rationale": "\ud604\uc7ac\ub294 \uc628\ub09c\ud55c \ubca8\uae30\uc5d0 \ud50c\ub77c\ub9dd \uc9c0\ubc29\uc774 \ub2f9\uc2dc\uc5d0\ub294 \ub208\uc73c\ub85c \ub36e\uc77c \ub9cc\ud07c \uaca8\uc6b8\uc774 \ucd94\uc6e0\uc74c\uc744 \ub098\ud0c0\ub0b4\ub294 \ubbf8\uc220\uc801 \uc99d\uac70\uc785\ub2c8\ub2e4.",
