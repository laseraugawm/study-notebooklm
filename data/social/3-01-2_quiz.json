{
  "title": "\uacbd\uc81c\uccb4\uc81c \ud034\uc988",
  "questions": [
    {
      "question": "\uc0dd\uc0b0\ubb3c\uc758 \uc885\ub958\uc640 \uc218\ub7c9, \uc0dd\uc0b0 \ubc29\ubc95, \ubd84\ubc30 \ubc29\uc2dd \ub4f1 \uae30\ubcf8\uc801\uc778 \uacbd\uc81c \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \ud569\uc758\ub41c \uc81c\ub3c4\ub098 \ubc29\uc2dd\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?",
      "answerOptions": [
        {
          "text": "\uacbd\uc81c \uccb4\uc81c",
          "isCorrect": true,
          "rationale": "\ubcf8\ubb38\uc5d0 \ub530\ub974\uba74 \uc0ac\ud68c\uac00 \uae30\ubcf8\uc801\uc778 \uacbd\uc81c \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc815\ud55c \uc81c\ub3c4\ub098 \ubc29\uc2dd\uc744 \uacbd\uc81c \uccb4\uc81c\ub77c\uace0 \ubd80\ub985\ub2c8\ub2e4."
        },
        {
          "text": "\uae08\uc735 \uc81c\ub3c4",
          "isCorrect": false,
          "rationale": "\uae08\uc735 \uc81c\ub3c4\ub294 \uc790\uae08\uc758 \uc218\uc694\uc640 \uacf5\uae09\uc744 \uc911\uac1c\ud558\ub294 \uc2dc\uc2a4\ud15c\uc73c\ub85c, \uacbd\uc81c \ubb38\uc81c \ud574\uacb0\uc758 \uc804\ubc18\uc801\uc778 \uc0ac\ud68c\uc801 \ud2c0 \uc804\uccb4\ub97c \uc758\ubbf8\ud558\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc870\uc138 \uc81c\ub3c4",
          "isCorrect": false,
          "rationale": "\uc870\uc138 \uc81c\ub3c4\ub294 \uad6d\uac00 \uc7ac\uc815 \uc218\uc785 \ud655\ubcf4\uc640 \uc7ac\ubd84\ubc30\ub97c \uc704\ud574 \uc138\uae08\uc744 \uac70\ub450\ub294 \uc81c\ub3c4\ub85c, \uc0dd\uc0b0\uacfc \ubc30\ubd84\uc744 \uacb0\uc815\ud558\ub294 \uc885\ud569\uc801 \uacbd\uc81c \uad6c\uc870\uc640\ub294 \ub2e4\ub985\ub2c8\ub2e4."
        },
        {
          "text": "\ubcf5\uc9c0 \uccb4\uc81c",
          "isCorrect": false,
          "rationale": "\ubcf5\uc9c0 \uccb4\uc81c\ub294 \uad6d\ubbfc\uc758 \ucd5c\uc800 \uc0dd\ud65c \ubcf4\uc7a5\uacfc \uc0b6\uc758 \uc9c8 \ud5a5\uc0c1\uc744 \uc704\ud55c \uc0ac\ud68c\uc801 \uc548\uc804\ub9dd\uc5d0 \uc9d1\uc911\ub41c \uac1c\ub150\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud76c\uc18c\ud55c \uc790\uc6d0\uc744 \uc5b4\ub5bb\uac8c \uc0dd\uc0b0\ud558\uace0 \ubc30\ubd84\ud560\uc9c0 \uacb0\uc815\ud558\ub294 \uc0ac\ud68c \uc804\uccb4\uc758 \uad6c\uc870\uc801 \ud2c0\uc744 \ub73b\ud569\ub2c8\ub2e4."
    },
    {
      "question": "\uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac00\uacc4\ub098 \uae30\uc5c5\uacfc \uac19\uc740 \ubbfc\uac04 \uacbd\uc81c \uc8fc\uccb4\uac00 \uacbd\uc81c\ud65c\ub3d9\uc758 \uc911\uc2ec\uc774 \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc5d0\uc11c\ub294 \ubbfc\uac04 \uacbd\uc81c \uc8fc\uccb4\uac00 \uc790\uc728\uc801\uc73c\ub85c \uc0ac\uc801 \uc774\uc775\uc744 \ucd94\uad6c\ud558\uba70 \ud65c\ub3d9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc758 \ub2a5\ub825\uacfc \ucc3d\uc758\uc131\uc744 \ubc1c\ud718\ud560 \uc218 \uc788\ub294 \ubc14\ud0d5\uc744 \uc81c\uacf5\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc720\ub85c\uc6b4 \uacbd\uc81c\ud65c\ub3d9\uc774 \ubcf4\uc7a5\ub418\ubbc0\ub85c \uac1c\uc778\uc774 \uc790\uc2e0\uc758 \uc5ed\ub7c9\uacfc \ucc3d\uc758\uc131\uc744 \ubc1c\ud718\ud558\uae30 \uc720\ub9ac\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\uc720 \uc7ac\uc0b0\uad8c\uc744 \ubd80\uc815\ud558\uace0 \uc815\ubd80\uc758 \ud1b5\uc81c\uc5d0 \uc758\ud574 \uc0dd\uc0b0 \uc218\ub2e8\uc744 \uc6b4\uc6a9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\uc720 \uc7ac\uc0b0\uad8c\uc744 \ubd80\uc815\ud558\uace0 \uc815\ubd80\uc758 \uac15\ub825\ud55c \ud1b5\uc81c\uc640 \uacc4\ud68d\uc5d0 \ub530\ub974\ub294 \uac83\uc740 \uacc4\ud68d\uacbd\uc81c \uccb4\uc81c\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "'\ubcf4\uc774\uc9c0 \uc54a\ub294 \uc190'\uc5d0 \uc758\ud55c \uc2dc\uc7a5 \uac00\uaca9\uc758 \uc791\ub3d9\uc73c\ub85c \uc790\uc6d0 \ubc30\ubd84\uc774 \uc774\ub8e8\uc5b4\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\uc7a5 \uac00\uaca9\uc758 \uc790\uc728\uc801 \uc2e0\ud638\uc5d0 \uc758\ud574 \uc790\uc6d0\uc774 \ud6a8\uc728\uc801\uc73c\ub85c \ubc30\ubd84\ub418\ub294 \uac83\uc774 \uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc758 \ud575\uc2ec \uc6d0\ub9ac\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\ub294 \uc790\ubcf8\uc8fc\uc758\uc640 \uacb0\ud569\ud558\uc5ec \uac01 \uacbd\uc81c \uc8fc\uccb4\uc758 \uc790\uc720\ub85c\uc6b4 \uc758\uc0ac \uacb0\uc815\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."
    },
    {
      "question": "\ubcf8\ubb38\uc5d0\uc11c \uc81c\uc2dc\ub41c \ud3f4\ub354\ube14 \uc2a4\ub9c8\ud2b8\ud3f0\uc758 \uac00\uaca9 \ubcc0\ud654 \uc0ac\ub840\ub97c \ud1b5\ud574 \uc124\uba85\ud558\uace0\uc790 \ud558\ub294 \uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc758 \uc6d0\ub9ac\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2dc\uc7a5 \uac00\uaca9\uc774 \uc2e0\ud638\ub4f1 \uc5ed\ud560\uc744 \ud558\uc5ec \uc790\uc6d0 \ubc30\ubd84\uc744 \uc790\uc728\uc801\uc73c\ub85c \uc870\uc728\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc18c\ube44\uc790 \uc120\ud638\uc640 \uacbd\uc7c1\uc790 \uc9c4\uc785\uc5d0 \ub530\ub978 \uac00\uaca9 \ubcc0\ud654\uac00 \ub204\uad70\uac00\uc758 \uc9c0\uc2dc \uc5c6\uc774\ub3c4 \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \ubc30\ubd84\uc744 \uc774\ub04c\uc5b4\ub0c4\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80\uc758 \uac00\uaca9 \ud1b5\uc81c\uac00 \uc18c\ube44\uc790 \ud6c4\uc0dd\uc744 \uc9c1\uc811\uc801\uc73c\ub85c \uc99d\ub300\uc2dc\ud0a8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ub9c8\ud2b8\ud3f0 \uc0ac\ub840\ub294 \uc815\ubd80\uc758 \ud1b5\uc81c\uac00 \uc544\ub2cc \uc2dc\uc7a5 \ub0b4 \uc218\uc6a9\uc640 \uacf5\uae09, \uacbd\uc7c1\uc5d0 \uc758\ud55c \uc790\uc728\uc801 \uac00\uaca9 \uc870\uc815\uc744 \uc124\uba85\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\uc220 \uac1c\ubc1c\uc774 \uc774\ub8e8\uc5b4\uc9c0\uba74 \ub3c5\uc810 \uae30\uc5c5\uc774 \uac00\uaca9 \uacb0\uc815\uad8c\uc744 \ub3c5\uc810\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\ub9ce\uc740 \uc0dd\uc0b0\uc790\uac00 \uacbd\uc7c1\uc5d0 \ub6f0\uc5b4\ub4e4\uba74\uc11c \uac00\uaca9\uc774 \ud558\ub77d\ud55c\ub2e4\uace0 \uc124\uba85\ud558\uc600\uc73c\ubbc0\ub85c \ub3c5\uc810\ud654\uc640\ub294 \uac70\ub9ac\uac00 \ub055\ub2c8\ub2e4."
        },
        {
          "text": "\uc218\uc694\uac00 \uc99d\uac00\ud558\uba74 \uc2dc\uc7a5 \uac00\uaca9\uc740 \ud56d\uc0c1 \uc9c0\uc18d\ud574\uc11c \uc0c1\uc2b9\ud558\uae30\ub9cc \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucd08\uae30\uc5d0\ub294 \uac00\uaca9\uc774 \uc0c1\uc2b9\ud560 \uc218 \uc788\uc9c0\ub9cc \uacbd\uc7c1 \ucd09\uc9c4\uacfc \uc0dd\uc0b0 \ube44\uc6a9 \uc808\uac10\uc73c\ub85c \uc778\ud574 \ub2e4\uc2dc \uac00\uaca9\uc774 \ud558\ub77d\ud560 \uc218 \uc788\uc74c\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub204\uad70\uac00\uc758 \uc9c0\uc2dc\ub098 \uacc4\ud68d \uc5c6\uc774\ub3c4 \uacbd\uc81c \uc8fc\uccb4\ub4e4\uc774 \uc790\uc728\uc801\uc73c\ub85c \ubc18\uc751\ud558\uac8c \ub9cc\ub4dc\ub294 \ub9e4\uac1c\uccb4\uc5d0 \uc8fc\ubaa9\ud558\uc138\uc694."
    },
    {
      "question": "\uacc4\ud68d\uacbd\uc81c \uccb4\uc81c\uc758 \uc7a5\uc810\uacfc \ud55c\uacc4\ub97c \uc62c\ubc14\ub974\uac8c \uc9dd\uc9c0\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc7a5\uc810: \ubd84\ubc30\uc758 \ud615\ud3c9\uc131 \uc2e4\ud604 / \ud55c\uacc4: \uadfc\ub85c \uc758\uc695 \uc800\ud558 \ubc0f \uacbd\uc81c \ud65c\ub825 \uac10\uc18c",
          "isCorrect": true,
          "rationale": "\uad6d\uac00\uc758 \uacc4\ud68d\uc744 \ud1b5\ud574 \ube48\uace4\uce35 \uc9c0\uc6d0 \ubc0f \ud615\ud3c9\uc131\uc744 \ub2ec\uc131\ud560 \uc218 \uc788\uc73c\ub098, \uc77c\ud55c \ub9cc\ud07c \ubcf4\uc0c1\ubc1b\uc9c0 \ubabb\ud574 \uadfc\ub85c \uc758\uc695\uacfc \ud6a8\uc728\uc131\uc774 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc7a5\uc810: \uadfc\ub85c \uc758\uc695 \uc99d\uc9c4 / \ud55c\uacc4: \ube48\ubd80 \uaca9\ucc28 \uc2ec\ud654",
          "isCorrect": false,
          "rationale": "\uadfc\ub85c \uc758\uc695 \uc99d\uc9c4\uacfc \ube48\ubd80 \uaca9\ucc28 \uc2ec\ud654\ub294 \uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc640 \uad00\ub828\ub41c \ud2b9\uc9d5\uc5d0 \uac00\uae5d\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc7a5\uc810: \uac1c\uc778\uc758 \ucc3d\uc758\uc131 \ubc1c\ud718 / \ud55c\uacc4: \uae09\uaca9\ud55c \uc778\ud50c\ub808\uc774\uc158 \ubc1c\uc0dd",
          "isCorrect": false,
          "rationale": "\uacc4\ud68d\uacbd\uc81c\uc5d0\uc11c\ub294 \uad6d\uac00\uc758 \uac15\ub825\ud55c \uc81c\uc57d\uc73c\ub85c \uac1c\uc778\uc758 \ucc3d\uc758\uc131\uc774 \ubc1c\ud718\ub418\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc7a5\uc810: \uc18c\ube44\uc790\uc758 \ub2e4\uc591\ud55c \uc695\uad6c \ubc18\uc601 / \ud55c\uacc4: \uad6d\uac00 \uc815\ucc45 \ubaa9\ud45c \ub2ec\uc131\uc758 \uc5b4\ub824\uc6c0",
          "isCorrect": false,
          "rationale": "\uacc4\ud68d\uacbd\uc81c\ub294 \uad6d\uac00 \uc815\ucc45 \ubaa9\ud45c \ub2ec\uc131\uc774 \uc6a9\uc774\ud55c \ubc18\uba74, \uc18c\ube44\uc790\uc758 \ub2e4\uc591\ud55c \uc695\uad6c\ub97c \ubaa8\ub450 \ubc18\uc601\ud558\ub294 \ub370 \ud55c\uacc4\uac00 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubaa8\ub4e0 \uc0ac\ub78c\uc758 \ud544\uc694\uc5d0 \ub9de\ucd98 \ud615\ud3c9\uc131 \ucd94\uad6c\uac00 \uac1c\uac1c\uc778\uc758 \uc77c\ud560 \uc758\uc695\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub9c8\ub974\ud06c\uc2a4(Marx, K.)\uac00 \ucc9c\uba85\ud55c \uc0ac\ud68c\uc8fc\uc758 \ub178\ub3d9 \ubd84\ubc30\uc758 \uc6d0\uce59\uc73c\ub85c \ubcf8\ubb38\uc5d0 \uba85\uc2dc\ub41c \ub0b4\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ub2a5\ub825\uc5d0 \ub530\ub77c \uc77c\ud558\uace0, \ud544\uc694\uc5d0 \ub530\ub77c \ubd84\ubc30\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub9c8\ub974\ud06c\uc2a4\ub294 \uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc758 \ubd84\ubc30\ub97c \ube44\ud310\ud558\uba70 \uc0ac\ud68c\uc801 \uc57d\uc790\ub97c \uace0\ub824\ud55c \ud544\uc694 \uc911\uc2ec\uc758 \ubd84\ubc30 \uc6d0\uce59\uc744 \uc81c\uc2dc\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub2a5\ub825\uc5d0 \ub530\ub77c \uc77c\ud558\uace0, \uc2e4\uc801\uc5d0 \ub530\ub77c \ubd84\ubc30\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e4\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30\ub294 \uc5c5\uc801\uc774\ub098 \uc0dd\uc0b0\uc131\uc5d0 \ub530\ub978 \ucc28\ub4f1 \ubcf4\uc0c1\uc744 \uc758\ubbf8\ud558\ubbc0\ub85c \ub9c8\ub974\ud06c\uc2a4\uc758 \ud544\uc694 \uc911\uc2ec \ubd84\ubc30 \uc6d0\uce59\uacfc \ub2e4\ub985\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\uc720\uc5d0 \ub530\ub77c \uc77c\ud558\uace0, \ub2a5\ub825\uc5d0 \ub530\ub77c \ubd84\ubc30\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub9c8\ub974\ud06c\uc2a4\ub294 \uc0dd\uc0b0 \uc218\ub2e8\uc758 \uc18c\uc720 \uc790\uccb4\ub97c \ubd80\uc815\ud558\uc600\uc73c\ubbc0\ub85c \uc18c\uc720\uc5d0 \ub530\ub978 \ubd84\ubc30 \uccb4\uacc4\ub97c \uc639\ud638\ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80 \uc9c0\uc2dc\uc5d0 \ub530\ub77c \uc77c\ud558\uace0, \uade0\ub4f1\ud558\uac8c \ub3d9\uc77c \ubd84\ubc30\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e8\uc21c\ud55c \uae30\uacc4\uc801 \uade0\ub4f1 \ubd84\ubc30\uac00 \uc544\ub2c8\ub77c \uac01\uc790\uc758 '\ud544\uc694'\uc5d0 \ub9de\ucdb0 \ubc30\ubd84\ud55c\ub2e4\ub294 \uc810\uc744 \uac15\uc870\ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc2dc\uc7a5\uacbd\uc81c\uc758 \uc131\uacfc \uc911\uc2ec \ubd84\ubc30\ub97c \ube44\ud310\ud558\uba70 \uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \uae30\ubcf8\uc801\uc778 \uc0b6\uc744 \uc601\uc704\ud558\uae30 \uc704\ud574 \uac15\uc870\ud55c \ubb38\uad6c\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\ubcf8\ubb38\uc758 [1\uc790\ub8cc](A\uad6d \u25ef\u25ef \uc528\uc758 \uc77c\uae30)\uc5d0\uc11c \uc54c \uc218 \uc788\ub294 A\uad6d \uacbd\uc81c \uccb4\uc81c\uc758 \ud2b9\uc9d5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc815\ubd80\uac00 \uad6d\ubc29\uacfc \uce58\uc548\ub9cc \ub2f4\ub2f9\ud558\uace0 \uacbd\uc81c \ubb38\uc81c\uc5d0\ub294 \uac1c\uc785\ud558\uc9c0 \uc54a\ub294 \uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\uc778\uc774 \uc790\uc728\uc801\uc73c\ub85c \ub3c8\uc744 \ubaa8\uc544 \ucc28\ub97c \uc0ac\ub294 \ub4f1 \uc790\uc728\uc131\uc774 \ubcf4\uc7a5\ub418\ub294 \ud55c\ud3b8, \uc815\ubd80\ub294 \uc8fc\ud0dd \uac00\uaca9\uc774\ub098 \uae08\ub9ac \uc870\uc815 \ub4f1\uc5d0 \uc77c\uc808 \uac1c\uc785\ud558\uc9c0 \uc54a\ub294 \uc804\ud615\uc801\uc778 \uc57c\uacbd\uad6d\uac00\ud615 \uc2dc\uc7a5\uacbd\uc81c\ub97c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80\uac00 \uc8fc\ud0dd \ubc0f \ub300\ucd9c \uae08\ub9ac\ub97c \uc9c1\uc811 \ud1b5\uc81c\ud558\ub294 \uacc4\ud68d\uacbd\uc81c \uccb4\uc81c\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc77c\uae30\uc5d0\uc11c \uc815\ubd80\ub294 \uc774\ub7ec\ud55c \uc9d1\uac12\uc774\ub098 \uae08\ub9ac \ubb38\uc81c\uc5d0 \uc77c\uc808 \uac1c\uc785\ud558\uc9c0 \uc54a\ub294\ub2e4\uace0 \uba85\uc2dc\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00\uac00 \uc9c1\uc5c5\uc744 \ubc30\uc815\ud558\uace0 \uc0dd\ud544\ud488\uc744 \uc77c\ub960\uc801\uc73c\ub85c \ubc30\uae09\ud558\ub294 \ud63c\ud569 \uacbd\uc81c \uccb4\uc81c\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c1\uc5c5\uc744 \ubc30\uc815\ud558\uace0 \ubc30\uae09\uc744 \uc2e4\uc2dc\ud558\ub294 \uac83\uc740 [2\uc790\ub8cc] B\uad6d\uc758 \uacc4\ud68d\uacbd\uc81c \uccb4\uc81c \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
