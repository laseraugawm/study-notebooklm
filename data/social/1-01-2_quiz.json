{
  "title": "\uc778\uad8c \ubc95\ud559 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ud504\ub791\uc2a4\uc758 \ubc95\ud559\uc790 \uce74\ub810 \ubc14\uc791(Vasak, K.)\uc774 \uad6c\ubd84\ud55c \uc778\uad8c\uc758 \ubc1c\uc804 \ub2e8\uacc4 \uc911 \u20183\uc138\ub300 \uc778\uad8c(\uc5f0\ub300\uad8c)\u2019\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc744 \ud1b5\ud574 \ud615\uc131\ub418\uc5c8\uc73c\uba70, \uac1c\uc778\uc758 \uc790\uc720\ub97c \ucd5c\uc6b0\uc120\uc73c\ub85c \ud558\uc5ec \uad6d\uac00\uc758 \uac1c\uc785\uc744 \uacbd\uacc4\ud55c\ub2e4.",
          "rationale": "\uc774\ub294 \uad6d\uac00\uc758 \uac1c\uc785\uc744 \uacbd\uacc4\ud558\uace0 \uac1c\uc778\uc758 \uc790\uc728\uc131\uc744 \uc218\ud638\ud558\ub824\ub294 1\uc138\ub300 \uc778\uad8c(\uc790\uc720\uad8c)\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uad6d\uac00\uc758 \uc801\uadf9\uc801\uc778 \uac1c\uc785\uc744 \ud544\uc694\ub85c \ud55c\ub2e4.",
          "rationale": "\uc774\ub294 \ucd5c\uc18c\ud55c\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c\uc744 \uc704\ud574 \uad6d\uac00\uc758 \uc8fc\ub3c4\uc801 \uc5ed\ud560\uc744 \uc694\uad6c\ud558\ub294 2\uc138\ub300 \uc778\uad8c(\uc0ac\ud68c\uad8c)\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc778\uc885 \ucc28\ubcc4\uc774\ub098 \ube48\ubd80 \uaca9\ucc28 \ub4f1\uc758 \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574 \uad6d\uac00\uc640 \uac1c\uc778\uc758 \uad00\uacc4\ub97c \ub118\uc5b4\uc120 \uc804 \uc9c0\uad6c\uc801 \ucc28\uc6d0\uc758 \uc9d1\ub2e8\uc801 \uad8c\ub9ac\uc774\ub2e4.",
          "rationale": "3\uc138\ub300 \uc778\uad8c\uc740 \uc9c0\uad6c\ucd0c \ucc28\uc6d0\uc758 \uc778\uad8c \ubb38\uc81c \uadf9\ubcf5\uc744 \uc704\ud574 \uad6d\uc81c\uc801 \ud611\ub825\uacfc \uc5f0\ub300\ub97c \ubc14\ud0d5\uc73c\ub85c \ud615\uc131\ub41c \uc9d1\ub2e8\uc801 \uad8c\ub9ac\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc2e0\uccb4\uc758 \uc790\uc720, \uc0ac\uc0c1 \ubc0f \uc885\uad50\uc758 \uc790\uc720, \uc790\uc720\ub85c\uc6b4 \uc120\uac70 \ucc38\uc5ec\uad8c \ub4f1\uc774 \ub300\ud45c\uc801\uc778 \uc608\uc2dc\uc774\ub2e4.",
          "rationale": "\uc81c\uc2dc\ub41c \uad8c\ub9ac\ub4e4\uc740 \uad6d\uac00\ub85c\ubd80\ud130\uc758 \uc790\uc720\ub97c \uac15\uc870\ud588\ub358 1\uc138\ub300 \uc790\uc720\uad8c\uc758 \uc138\ubd80 \uad8c\ub9ac \ubaa9\ub85d\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uad6d\uac00\uc640 \uac1c\uc778\uc758 \uc77c\ub300\uc77c \uad00\uacc4\ub97c \ub118\uc5b4\uc120 \uad6d\uc81c\uc801 \ud611\ub825\uacfc \uc804 \uc9c0\uad6c\uc801 \ucc28\uc6d0\uc758 \uad8c\ub9ac\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ud604\ub300 \uc0ac\ud68c\uc5d0 \uc0c8\ub86d\uac8c \ub4f1\uc7a5\ud55c \uc778\uad8c\uacfc \uc774\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc6b0\ub9ac\ub098\ub77c\uc5d0\uc11c \uc81c\uc815 \ubc0f \uc6b4\uc6a9 \uc911\uc778 \ubc95\ub960\uc758 \uc5f0\uacb0\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc8fc\uac70\uad8c - \u300c\ud658\uacbd \uc815\ucc45 \uae30\ubcf8\ubc95\u300d",
          "rationale": "\u300c\ud658\uacbd \uc815\ucc45 \uae30\ubcf8\ubc95\u300d\uc740 \uad6d\ubbfc\uc774 \uac74\uac15\ud558\uace0 \ucf8c\uc801\ud55c \ud658\uacbd\uc5d0\uc11c \uc0b4 \uad8c\ub9ac\uc778 \ud658\uacbd\uad8c\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \ubc95\ub960\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc815\ubcf4 \uad00\ub828 \uad8c\ub9ac - \u300c\uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638\ubc95\u300d",
          "rationale": "\uc815\ubcf4 \uc0ac\ud68c\uc5d0\uc11c \uac15\uc870\ub418\ub294 \uac1c\uc778 \uc815\ubcf4 \uc790\uae30 \uacb0\uc815\uad8c \ub4f1 \uc815\ubcf4\uc640 \uad00\ub828\ub41c \uad8c\ub9ac\ub97c \ubcf4\ud638\ud558\uae30 \uc704\ud574 \u300c\uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638\ubc95\u300d\uc774 \uc81c\uc815\ub418\uc5b4 \uc6b4\uc6a9\ub429\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud658\uacbd\uad8c - \u300c\uc8fc\uac70 \uae30\ubcf8\ubc95\u300d",
          "rationale": "\u300c\uc8fc\uac70 \uae30\ubcf8\ubc95\u300d\uc740 \uad6d\ubbfc\uc758 \uc548\uc815\uc801\uc778 \uc8fc\uac70 \uc0dd\ud65c\uacfc \ucf8c\uc801\ud55c \uc8fc\uac70 \ud658\uacbd \ud655\ub9bd(\uc8fc\uac70\uad8c)\uc744 \ubaa9\uc801\uc73c\ub85c \ubc95\uc81c\ud654\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc548\uc804\uad8c - \u300c\uacf5\uacf5 \uae30\uad00\uc758 \uc815\ubcf4 \uacf5\uac1c\uc5d0 \uad00\ud55c \ubc95\ub960\u300d",
          "rationale": "\u300c\uacf5\uacf5 \uae30\uad00\uc758 \uc815\ubcf4 \uacf5\uac1c\uc5d0 \uad00\ud55c \ubc95\ub960\u300d\uc740 \uc815\ubcf4 \uc811\uadfc\uad8c \ubc0f \uad6d\ubbfc\uc758 \uc54c\uad8c\ub9ac\ub97c \uc2e4\uc9c8\uc801\uc73c\ub85c \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \ubc95\ub960\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc815\ubcf4 \uc0ac\ud68c\uc758 \uc9c4\uc804\uc5d0 \ub530\ub77c \uac1c\uc778 \uc815\ubcf4\uc758 \ubb34\ub2e8 \ud65c\uc6a9\uc744 \ub9c9\uace0 \uc790\uc728\uc801 \uacb0\uc815\uad8c\uc744 \ubcf4\uc7a5\ud558\ub294 \ubc95\ub960\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uce74\ub810 \ubc14\uc791\uc758 \uc778\uad8c \uad6c\ubd84 \uae30\uc900\uc5d0 \ub530\ub97c \ub54c, \u20182\uc138\ub300 \uc778\uad8c(\uc0ac\ud68c\uad8c)\u2019\uc5d0 \ud574\ub2f9\ud558\ub294 \uc138\ubd80 \uad8c\ub9ac \ud56d\ubaa9\uc73c\ub85c \uc62c\ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2e0\uccb4\uc758 \uc790\uc720, \uc0ac\uc0c1\u00b7\uc591\uc2ec\u00b7\uc885\uad50\uc758 \uc790\uc720",
          "rationale": "\uad6d\uac00\uc758 \uac04\uc12d\uc744 \ubc30\uc81c\ud558\uace0 \uac1c\uc778\uc758 \uc790\uc728\uc744 \uc911\uc2dc\ud558\ub294 1\uc138\ub300 \uc790\uc720\uad8c\uc758 \ud575\uc2ec \ud56d\ubaa9\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uadfc\ub85c\uc758 \uad8c\ub9ac, \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c\uc744 \ud560 \uad8c\ub9ac",
          "rationale": "\uad6d\uac00\uc758 \uc801\uadf9\uc801\uc778 \uac1c\uc785\uc744 \ud1b5\ud574 \uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uacfc \uae30\ubcf8\uc801 \ubcf5\uc9c0\ub97c \ubcf4\uc7a5\ud558\ub824\ub294 2\uc138\ub300 \uc0ac\ud68c\uad8c\uc758 \ub300\ud45c \ud56d\ubaa9\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc790\uacb0\uad8c, \ubc1c\uc804\uc758 \uad8c\ub9ac",
          "rationale": "\uac01 \ubbfc\uc871\uc758 \uc2a4\uc2a4\ub85c \uacb0\uc815\ud560 \uad8c\ub9ac \ubc0f \uac1c\ubc1c\uc5d0 \uad00\ud55c \uad8c\ub9ac\ub85c \uc804 \uc9c0\uad6c\uc801 \ud611\ub825\uc774 \uc694\uad6c\ub418\ub294 3\uc138\ub300 \uc5f0\ub300\uad8c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc7ac\ub09c\uc73c\ub85c\ubd80\ud130 \uad6c\uc81c\ubc1b\uc744 \uad8c\ub9ac, \uc9c0\uc18d\uac00\ub2a5\ud55c \ud658\uacbd\uc5d0 \ub300\ud55c \uad8c\ub9ac",
          "rationale": "\uad6d\uc81c \uc0ac\ud68c \uc804\uccb4\uac00 \ud611\ub825\ud558\uc5ec \uc7ac\ud574 \ubc0f \ud658\uacbd \uc704\uae30\uc5d0 \ub300\uc751\ud558\uc790\ub294 3\uc138\ub300 \uc5f0\ub300\uad8c\uc758 \uc138\ubd80 \ud56d\ubaa9\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uad6d\uac00\uac00 \uc801\uadf9 \uac1c\uc785\ud558\uc5ec \uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \uae30\ubcf8\uc801\uc778 \uc0b6\uc758 \uc9c8\uacfc \ubcf5\uc9c0\ub97c \ub192\uc774\uae30 \uc704\ud55c \uad8c\ub9ac\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc0ac\ub840\uc5d0\uc11c \uc81c\uc2dc\ub41c \uc778\uad8c\uc758 \uc720\ud615\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n\"\uad6d\uc81c \uacbd\uae30\ub97c \uc8fc\ucd5c\ud558\ub294 \uae30\uad00\uc5d0\uc11c\ub294 \ucc38\uac00 \uc120\uc218\ub4e4\uc758 \ub2e4\uc591\ud55c \uc885\uad50 \ubc0f \uc0dd\ud65c\uc591\uc2dd\uc744 \uc874\uc911\ud558\uae30 \uc704\ud574 \ud560\ub784 \uc74c\uc2dd\uc774\ub098 \ucc44\uc2dd\uc744 \uc81c\uacf5\ud55c\ub2e4. \ub610\ud55c, \uc8fc\ub958 \uc9d1\ub2e8\uc758 \ubb38\ud654\uc640 \uc5b8\uc5b4 \uc678\uc5d0\ub3c4 \uc0ac\ud68c \uad6c\uc131\uc6d0 \uac01\uc790\uc758 \uace0\uc720\ud55c \uc5b8\uc5b4\uc640 \ubb38\ud654\uc801 \ud2b9\uc131\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \ub178\ub825\uc774 \ub2e4\uac01\ub3c4\ub85c \uc774\uc5b4\uc9c0\uace0 \uc788\ub2e4.\"",
      "answerOptions": [
        {
          "text": "\uc8fc\uac70\uad8c",
          "rationale": "\ucf8c\uc801\ud55c \uc8fc\ud0dd \ud658\uacbd \ubc0f \uc8fc\uac70 \uc0dd\ud65c\uc758 \uc548\uc815\uc744 \ub204\ub9b4 \uad8c\ub9ac\ub97c \ub73b\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc548\uc804\uad8c",
          "rationale": "\uac01\uc885 \uc7ac\ub09c, \uc804\uc5fc\ubcd1, \ubc94\uc8c4 \ub4f1\uc758 \uc704\ud611\uc73c\ub85c\ubd80\ud130 \uc2e0\uccb4\uc640 \uc0dd\uba85\uc744 \uc9c0\ud0ac \uad8c\ub9ac\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubb38\ud654\uad8c",
          "rationale": "\uc790\uc720\ub86d\uac8c \ubb38\ud654 \ud65c\ub3d9\uc5d0 \ucc38\uc5ec\ud568\uc740 \ubb3c\ub860, \uc18c\uc218 \uc9d1\ub2e8\uc758 \uace0\uc720\ud55c \uc5b8\uc5b4, \uc885\uad50, \uc2dd\uc2b5\uad00 \ubc0f \uc0dd\ud65c\uc591\uc2dd\uc744 \uc874\uc911\ubc1b\uace0 \ub204\ub9b4 \uad8c\ub9ac\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud658\uacbd\uad8c",
          "rationale": "\ub300\uae30 \uc624\uc5fc, \uc18c\uc74c \uacf5\ud574 \ub4f1\uc73c\ub85c\ubd80\ud130 \ubc97\uc5b4\ub098 \uac74\uac15\ud558\uace0 \ucf8c\uc801\ud55c \uc790\uc5f0\ud658\uacbd\uc5d0\uc11c \uc0dd\ud65c\ud560 \uad8c\ub9ac\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub2e4\uc591\ud55c \ubc30\uacbd\uc744 \uac00\uc9c4 \uac1c\uc778\uc774\ub098 \uc9d1\ub2e8\uc774 \uace0\uc720\ud55c \uc0dd\ud65c\uc591\uc2dd\uacfc \uc815\uccb4\uc131\uc744 \ub204\ub9b4 \uad8c\ub9ac\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc815\ubcf4 \uc0ac\ud68c\uc758 \uc9c4\uc804\uacfc \ud568\uaed8 \uc0c8\ub86d\uac8c \uc8fc\ubaa9\ubc1b\uace0 \uc788\ub294 '\uc78a\ud790 \uad8c\ub9ac'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uac00\uae30\uad00\uc774 \uc18c\uc7a5\ud558\uace0 \uc788\ub294 \uacf5\uacf5 \uc815\ubcf4\ub97c \uc790\uc720\ub86d\uac8c \uccad\uad6c\ud558\uc5ec \uc54c \uc218 \uc788\ub294 \uad8c\ub9ac\uc774\ub2e4.",
          "rationale": "\uc774\ub294 \uc815\ubcf4 \uacf5\uac1c \uccad\uad6c\uad8c \ubc0f \uad6d\ubbfc\uc758 \uc54c\uad8c\ub9ac\uc5d0 \ub300\ud55c \uc815\uc758\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc790\uc2e0\uc758 \uac1c\uc778 \uc815\ubcf4\uac00 \uc5b8\uc81c, \ub204\uad6c\uc5d0\uac8c, \uc5b4\ub290 \ubc94\uc704\uae4c\uc9c0 \uacf5\uac1c\ub420\uc9c0 \uc2a4\uc2a4\ub85c \uacb0\uc815\ud558\ub294 \uad8c\ub9ac\uc774\ub2e4.",
          "rationale": "\uc774\ub294 \uc815\ubcf4\uc758 \uc8fc\uccb4\ub85c\uc11c \uc2a4\uc2a4\ub85c \uad00\ub9ac\ud558\ub294 \uac1c\uc778 \uc815\ubcf4 \uc790\uae30 \uacb0\uc815\uad8c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc778\ud130\ub137\uc0c1\uc5d0\uc11c \uac1c\uc778\uc774 \uc790\uc2e0\uacfc \uad00\ub828\ub41c \uac01\uc885 \uc815\ubcf4\uc758 \uc18c\uc720\uad8c\uc744 \uac15\ud654\ud558\uc5ec \uc218\uc815\uc774\ub098 \uc601\uad6c \uc0ad\uc81c\ub97c \uc694\uccad\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\uc774\ub2e4.",
          "rationale": "\uc628\ub77c\uc778 \ub9e4\uccb4 \ub4f1\uc5d0 \uc720\ud1b5\ub418\ub294 \uc790\uc2e0\uacfc \uad00\ub828\ub41c \uc815\ubcf4\uc5d0 \ub300\ud574 \uc0ad\uc81c \ubc0f \uc218\uc815\uc744 \uc694\uad6c\ud558\ub294 \uc78a\ud790 \uad8c\ub9ac\uc758 \uac1c\ub150\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub204\uad6c\ub098 \ucc28\ubcc4 \uc5c6\uc774 \uc815\ubcf4\ud1b5\uc2e0\ub9dd\uacfc \uad00\ub828 \uae30\uae30\uc5d0 \uc6a9\uc774\ud558\uac8c \uc811\uadfc\ud558\uc5ec \ud65c\uc6a9\ud560 \uad8c\ub9ac\uc774\ub2e4.",
          "rationale": "\uc774\ub294 \uc815\ubcf4 \uaca9\ucc28 \ud574\uc18c\uc640 \uad00\ub828\ub41c \uc815\ubcf4 \uc811\uadfc\uad8c\uc758 \uac1c\ub150\uc5d0 \uac00\uae5d\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc628\ub77c\uc778 \uacf5\uac04\uc5d0 \ub0a8\uc544\uc788\ub294 \uac1c\uc778\uc801 \uc815\ubcf4\uc758 \uc18c\uc720\uad8c\uc744 \uac15\ud654\ud558\uace0 \uc81c3\uc790\uc5d0\uac8c \uc0ad\uc81c\ub97c \uc694\uad6c\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ubcf4\uae30\uc758 \uc0c1\ud669 ( \u3260 ) ~ ( \u3263 )\uc5d0 \ub4e4\uc5b4\uac08 \uc778\uad8c\uc758 \uc885\ub958\uac00 \uc798\ubabb \uc5f0\uacb0\ub41c \uac83\uc740?\n\n\u2022 ( \u3260 ): \ubbf8\uc138 \uba3c\uc9c0 \ubc0f \ub300\uae30 \uc624\uc5fc\uc758 \uc2ec\ud654\ub85c \uc778\ud574 \ub9d1\uc740 \uacf5\uae30\ub97c \ub9c8\uc2e4 \uad8c\ub9ac\ub97c \uce68\ud574\ub2f9\ud588\ub2e4.\n\u2022 ( \u3261 ): \uc2ec\uc57c \uc2dc\uac04\ub300 \ud749\uc545 \ubc94\uc8c4 \uc6b0\ub824\uac00 \ucee4\uc9c0\uc790 \uc9c0\uc790\uccb4\uc5d0\uc11c \uc548\uc2ec \uadc0\uac00 \uc2a4\uce74\uc6b0\ud2b8 \uc81c\ub3c4\ub97c \uc2dc\ud589\ud558\uc600\ub2e4.\n\u2022 ( \u3262 ): \uccad\ub144\ub4e4\uc774 \ub300\ud559\uac00 \uc784\ub300\ub8cc \ubd80\ub2f4\uc744 \uc644\ud654\ud574 \uc904 \uc784\ub300 \uc8fc\ud0dd \uacf5\uae09 \uc815\ucc45\uc744 \uc694\uad6c\ud558\uc600\ub2e4.\n\u2022 ( \u3263 ): \ube44\uc218\ub3c4\uad8c \uc9c0\uc5ed\uc5d0 \uac70\uc8fc\ud558\ub294 \uc8fc\ubbfc\ub4e4\uc774 \uc218\ub3c4\uad8c\uc5d0 \uc9d1\uc911\ub41c \uacf5\uc5f0\uacfc \uc804\uc2dc \ud61c\ud0dd\uc758 \uaca9\ucc28 \ud574\uc18c\ub97c \uc8fc\uc7a5\ud558\uc600\ub2e4.",
      "answerOptions": [
        {
          "text": "\u3260 - \ud658\uacbd\uad8c",
          "rationale": "\ub300\uae30 \uc624\uc5fc\uacfc \ubbf8\uc138 \uba3c\uc9c0\ub85c \uc778\ud55c \ud53c\ud574 \ub300\uc751\uc740 \uac74\uac15\ud558\uace0 \ucf8c\uc801\ud55c \ud658\uacbd\uc744 \ub204\ub9b4 \ud658\uacbd\uad8c \ubcf4\uc7a5 \uc774\uc288\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\u3261 - \uc548\uc804\uad8c",
          "rationale": "\ud749\uc545 \ubc94\uc8c4 \uc608\ubc29 \ubc0f \uc548\uc2ec \uadc0\uac00 \uc9c0\uc6d0\uc740 \uc704\ud5d8 \uc694\uc18c\ub85c\ubd80\ud130 \uc548\uc804\uc744 \ubcf4\ud638\ubc1b\uc744 \uc548\uc804\uad8c \ud589\uc0ac \uc0ac\ub840\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\u3262 - \uc8fc\uac70\uad8c",
          "rationale": "\uc784\ub300\ub8cc \ubd80\ub2f4 \uc644\ud654 \ubc0f \uccad\ub144 \uc784\ub300 \uc8fc\ud0dd \uc81c\uacf5\uc740 \uc8fc\uac70\ube44 \ubd80\ub2f4\uc744 \ub0ae\ucd94\uace0 \uc8fc\uac70\uad8c\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \ubc29\uc548\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\u3263 - \uc5f0\ub300\uad8c",
          "rationale": "\uc9c0\uc5ed \uac04 \ubb38\ud654\uc801 \ud61c\ud0dd \ucc28\uc774 \ud574\uc18c\uc640 \uacf5\uc5f0\u00b7\uc804\uc2dc \uc811\uadfc\uc131 \ubcf4\uc7a5\uc740 \uc5f0\ub300\uad8c\uc774 \uc544\ub2cc \ubb38\ud654\uad8c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\ube44\uc218\ub3c4\uad8c \uc8fc\ubbfc\uc758 \uc608\uc220\u00b7\uc804\uc2dc \ub4f1 \ubb38\ud654 \ud61c\ud0dd \ub204\ub9bc\uacfc \uad00\ub828\ub41c \uc778\uad8c\uc744 \uc810\uac80\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud604\ub300 \uc0ac\ud68c\uc5d0\uc11c\uc758 \uc8fc\uac70 \ubb38\uc81c\uc640 '\uc8fc\uac70\uad8c'\uc5d0 \uad00\ud55c \uc124\uba85 \uc911 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0b0\uc5c5\ud654\uc640 \ub3c4\uc2dc\ud654\ub85c \uc218\ub3c4\uad8c \uc778\uad6c \ubc00\uc9d1\uc774 \uc9c4\ud589\ub418\uba70 \uce35\uac04 \uc18c\uc74c, \uc77c\uc870\uad8c \ub4f1\uc758 \uc8fc\uac70 \ubb38\uc81c\uac00 \uc57c\uae30\ub418\uc5c8\ub2e4.",
          "rationale": "\uae09\uaca9\ud55c \uc778\uad6c \uc9d1\uc911\uacfc \uc544\ud30c\ud2b8 \ub4f1 \uacf5\ub3d9 \uc8fc\ud0dd \ubcf4\uae09 \ud655\ub300\ub85c \uc8fc\uac70\uc640 \uad00\ub828\ub41c \ubd84\uc7c1\uacfc \ubd88\ud3b8\uc774 \uc2e4\uc81c\ub85c \uc2ec\ud654\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc8fc\uac70\uad8c\uc740 \ub2e8\uc9c0 \ubb3c\ub9ac\uc801 \uacf5\uac04\uc73c\ub85c\uc11c\uc758 \uc9d1 \uc18c\uc720\ub97c \ub118\uc5b4 \uc801\uc808\ud55c \ud1b5\ud48d, \uc870\uba85, \ud3b8\ub9ac\ud55c \uc704\uce58 \ub4f1 \uc885\ud569\uc801 \ud658\uacbd\uc744 \ud3ec\ud568\ud55c\ub2e4.",
          "rationale": "\uc0ac\uc0dd\ud65c \ubcf4\uc7a5, \uae30\ubcf8 \uc2dc\uc124 \uc774\uc6a9 \ud3b8\uc758, \ucf8c\uc801\ud55c \uc8fc\uac70 \ud658\uacbd \ub4f1\uc774 \uac16\ucd94\uc5b4\uc838\uc57c \uc8fc\uac70\uad8c\uc774 \uc2e4\uc9c8\uc801\uc73c\ub85c \ubcf4\uc7a5\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc6b0\ub9ac\ub098\ub77c\ub294 \u300c\uc8fc\uac70 \uae30\ubcf8\ubc95\u300d\uc744 \ud1b5\ud574 \uad6d\ubbfc\uc758 \uc8fc\uac70\uad8c\uc744 \uaddc\uc815\ud558\uace0 \uc8fc\uac70\ube44 \ubd80\ub2f4 \uac10\uc18c \uc870\uce58\ub97c \ucd94\uc9c4\ud558\uace0 \uc788\ub2e4.",
          "rationale": "\uad6d\uac00\ub294 \ubc95\ub960 \uc81c\uc815\uc744 \ud1b5\ud574 \uc8fc\uac70 \ud658\uacbd\uc744 \uc815\ube44\ud558\uace0 \uc800\uc18c\ub4dd\uce35 \ub4f1\uc758 \uc8fc\uac70 \ubd80\ub2f4\uc744 \uacbd\uac10\ud558\uace0\uc790 \ub178\ub825\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc8fc\uac70\uad8c\uc740 \uac1c\uc778 \uac04\uc758 \uc0ac\uc801\uc778 \uac70\ub798 \ubc0f \uc18c\uc720\uc758 \uc601\uc5ed\uc774\ubbc0\ub85c \uc815\ubd80\uc758 \ubc95\uc801 \uc815\ube44\ub098 \uc9c0\uc6d0 \ub300\uc0c1\uc774 \ub420 \uc218 \uc5c6\ub2e4.",
          "rationale": "\uc8fc\uac70\uad8c\uc740 \uc778\uac04\ub2e4\uc6b4 \uc8fc\uac70 \uc0dd\ud65c\uc744 \ub3c4\ubaa8\ud558\uae30 \uc704\ud55c \ud5cc\ubc95\uc801\u00b7\ubc95\ub960\uc801 \uc778\uad8c\uc73c\ub85c, \uad6d\uac00\uc758 \uc801\uadf9\uc801\uc778 \uc81c\ub3c4 \uac1c\uc120\uacfc \uc0ac\ud68c\uc801 \uc9c0\uc6d0 \ub300\uc0c1\uc5d0 \ud3ec\ud568\ub429\ub2c8\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\uc8fc\uac70\uad8c\uc774 \ubc95\ub960(\uc8fc\uac70 \uae30\ubcf8\ubc95)\uc5d0 \uba85\uc2dc\ub41c \uacf5\uc801 \uc778\uad8c\uc73c\ub85c\uc11c \uad6d\uac00\uc758 \ubcf4\uc7a5 \uc758\ubb34 \ub300\uc0c1\uc774\ub77c\ub294 \uc810\uc744 \uace0\ub824\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc81c\uc2dc\ubb38\uc774 \ub73b\ud558\ub294 \uc778\uad8c \uac1c\ub150\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n\"\ubbfc\uc871\uc774\ub098 \uc9d1\ub2e8 \ucc28\uc6d0\uc5d0\uc11c \uc804 \uc138\uacc4\uc801\uc778 \ud658\uacbd \uc624\uc5fc\uc774\ub098 \ube48\ubd80 \uaca9\ucc28 \ubb38\uc81c\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud574 \uc694\uad6c\ub418\ub294 \uad8c\ub9ac\ub85c\uc11c, \uac1c\ubcc4 \uad6d\uac00 \ub0b4\ubd80\uc758 \ubc95\uc801 \uaddc\uc728\uc744 \ub118\uc5b4 \uad6d\uac00 \uac04 \uc5f0\ub300\uc640 \uc804 \uc9c0\uad6c\uc801 \ud611\ub825\uc744 \ud544\uc218\ub85c \ud55c\ub2e4.\"",
      "answerOptions": [
        {
          "text": "\uc790\uc720\uad8c",
          "rationale": "\uc790\uc720\uad8c\uc740 \uad6d\uac00\uc758 \uad8c\ub825\uc801 \uac1c\uc785\uc774\ub098 \uce68\ud574\ub85c\ubd80\ud130 \uac1c\uc778\uc774 \uc2e0\uccb4\uc801, \uc815\uc2e0\uc801 \uc790\uc720\ub97c \uc720\uc9c0\ud560 \uad8c\ub9ac\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0ac\ud68c\uad8c",
          "rationale": "\uc0ac\ud68c\uad8c\uc740 \uad6d\uac00\uc5d0 \ub300\ud574 \ubcf5\uc9c0 \ubc0f \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c\uc758 \ubcf4\uc7a5\uc744 \uc801\uadf9 \uc694\uad6c\ud558\ub294 \uad8c\ub9ac\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc5f0\ub300\uad8c",
          "rationale": "\uad6d\uc81c\uc801 \ud611\ub825\uacfc \uc804 \uc9c0\uad6c\uc801 \ub300\uc751\uc744 \ubc14\ud0d5\uc73c\ub85c \uc804 \uc138\uacc4 \uc778\ub958\uc758 \uacf5\ud1b5 \uacfc\uc81c\ub97c \uadf9\ubcf5\ud558\uace0\uc790 \ud558\ub294 \uc9d1\ub2e8\uc801 \uad8c\ub9ac\uc778 \uc5f0\ub300\uad8c(3\uc138\ub300 \uc778\uad8c)\uc758 \uc124\uba85\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uccad\uad6c\uad8c",
          "rationale": "\uccad\uad6c\uad8c\uc740 \uae30\ubcf8\uad8c\uc774 \uce68\ud574\ub418\uc5c8\uc744 \ub54c \uad6d\uac00\uc5d0 \ub300\ud574 \uad6c\uc81c\ub098 \uc77c\uc815\ud55c \ud589\uc704\ub97c \uc694\uad6c\ud560 \uc218 \uc788\ub294 \uc218\ub2e8\uc801 \uad8c\ub9ac\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc804 \uc9c0\uad6c\uc801 \ubb38\uc81c \ud574\uacb0\uc5d0 \ub300\uc751\ud558\ub294 \uad6d\uc81c \ud611\ub825 \uae30\ubc18\uc758 \uad8c\ub9ac\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ud604\ub300 \uc0ac\ud68c\uc758 '\uc548\uc804\uad8c'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc5f0\uc7ac\ud574\ub9cc\uc744 \ubcf4\ud638 \ub300\uc0c1\uc73c\ub85c \uc0bc\uc73c\uba70, \ucca8\ub2e8 \uae30\uc220\uc5d0 \uc758\ud55c \uc778\uc704\uc801 \uc0ac\uace0\ub294 \ub300\uc0c1\uc5d0\uc11c \uc81c\uc9c0\ub41c\ub2e4.",
          "rationale": "\uc548\uc804\uad8c\uc740 \ud0dc\ud48d\u00b7\uc9c0\uc9c4 \ub4f1 \uc790\uc5f0\uc7ac\ud574\ubfd0\ub9cc \uc544\ub2c8\ub77c \uacfc\ud559\uae30\uc220 \ubc1c\uc804\uc5d0 \ub530\ub978 \uc2dc\uc124\ubb3c \uc0ac\uace0, \uc778\uc704\uc801 \uc704\ud611\uae4c\uc9c0 \ud3ec\ud568\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3c4\uc2dc\ud654\ub85c \uc778\uad6c \ubc00\ub3c4\uac00 \ub192\uc544\uc9c4 \uc9c0\uc5ed\uc5d0\uc11c\ub294 \uc7ac\ud574, \uc804\uc5fc\ubcd1, \ubc94\uc8c4 \ubc1c\uc0dd \uc2dc \ud53c\ud574 \uc704\ud5d8\uc774 \ucee4\uc838 \uc548\uc804\uad8c \ubcf4\uc7a5\uc758 \ud544\uc694\uc131\uc774 \ub354 \uac15\uc870\ub41c\ub2e4.",
          "rationale": "\uace0\ubc00\ub3c4 \ub3c4\uc2dc \uacf5\uac04\uc5d0\uc11c\ub294 \uc0ac\uac74\u00b7\uc0ac\uace0\uc758 \ub300\ud615\ud654 \uac00\ub2a5\uc131\uc774 \ub192\uae30 \ub54c\ubb38\uc5d0 \uc608\ubc29 \uccb4\uacc4 \uc815\ube44\uc640 \uc2dc\ubbfc\uc758 \uc548\uc804 \uc758\uc2dd\uc774 \uac15\uc870\ub429\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85 \uc2dc\uae30 \uad6d\uac00 \uad8c\ub825\uc758 \uc218\ud0c8\uc744 \uc800\uc9c0\ud558\uae30 \uc704\ud574 1\uc138\ub300\ub85c \uc6b0\uc120 \uc815\ub9bd\ub41c \uad8c\ub9ac\uc774\ub2e4.",
          "rationale": "\uc548\uc804\uad8c\uc740 \ud604\ub300 \uc0ac\ud68c\uc758 \ubcf5\uc7a1\uc131 \ubc0f \uac01\uc885 \uc7ac\ub09c\u00b7\ubc94\uc8c4 \ubb38\uc81c\uc5d0 \ub300\uc751\ud558\uc5ec \uc0c8\ub86d\uac8c \ub300\ub450\ub41c \uc2e0\uc885 \uc778\uad8c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc548\uc804\uad8c\uc758 \ubcf4\uc7a5\uc740 \uac1c\uc778 \ucc28\uc6d0\uc758 \ub178\ub825\ub9cc\uc73c\ub85c \ud574\uacb0 \uac00\ub2a5\ud558\ubbc0\ub85c \uc815\ubd80 \ucc28\uc6d0\uc758 \uc81c\ub3c4\uc801 \uc608\ubc29\ucc45 \uc870\uce58\ub294 \uc694\uad6c\ub418\uc9c0 \uc54a\ub294\ub2e4.",
          "rationale": "\uc815\ubd80\ub294 \ubc95\ub839 \uc815\ube44, \uc608\ubc29 \uc81c\ub3c4 \uc6b4\uc6a9(\uc548\uc2ec \uadc0\uac00 \uc11c\ube44\uc2a4 \ub4f1)\uc744 \ud1b5\ud574 \uad6d\ubbfc\uc758 \uc548\uc804\uc744 \uc801\uadf9 \ubcf4\ud638\ud560 \ucc45\ubb34\uac00 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc778\uad6c \ubc00\uc9d1\ub3c4\uac00 \ub192\uc740 \ud604\ub300 \ub3c4\uc2dc\uc758 \ud2b9\uc131\uacfc \uc7ac\ud574\u00b7\ubc94\uc8c4 \ubc1c\uc0dd \uc704\ud5d8\uc758 \uad00\uacc4\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "3\uc138\ub300 \uc778\uad8c\uc778 '\uc5f0\ub300\uad8c(\uc9d1\ub2e8\uad8c)'\uc5d0 \uc18d\ud558\ub294 \uc138\ubd80 \uad8c\ub9ac \ud56d\ubaa9\ub9cc\uc73c\ub85c \ubc14\ub974\uac8c \ub098\uc5f4\ub41c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9d1\ud68c \ubc0f \uacb0\uc0ac\uc758 \uc790\uc720, \ud45c\ud604\uc758 \uc790\uc720, \uc2e0\uccb4\uc758 \uc790\uc720",
          "rationale": "\uac1c\uc778\uc758 \uc790\uc720\ub97c \uad6d\uac00 \uad8c\ub825\uc758 \uce68\ud574\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uae30 \uc704\ud55c 1\uc138\ub300 \uc790\uc720\uad8c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uadfc\ub85c\uc758 \uad8c\ub9ac, \uad50\uc721\uc5d0 \ub300\ud55c \uad8c\ub9ac, \uc0ac\ud68c \ubcf4\uc7a5\uc744 \ubc1b\uc744 \uad8c\ub9ac",
          "rationale": "\uad6d\uac00\uac00 \ucd5c\uc18c\ud55c\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc744 \ubcf4\uc7a5\ud558\ub3c4\ub85d \uc694\uad6c\ud558\ub294 2\uc138\ub300 \uc0ac\ud68c\uad8c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc790\uacb0\uad8c, \ubc1c\uc804\uc758 \uad8c\ub9ac, \ud3c9\ud654\uc758 \uad8c\ub9ac, \uc7ac\ub09c\uc73c\ub85c\ubd80\ud130 \uad6c\uc81c\ubc1b\uc744 \uad8c\ub9ac",
          "rationale": "\uac01 \ubbfc\uc871\uacfc \uc9d1\ub2e8\uc758 \uacb0\uc815\uad8c, \uc9c0\uad6c\ucd0c \ud3c9\ud654, \uc7ac\ub09c \uad6c\uc81c \ubc0f \uc9c0\uc18d\uac00\ub2a5 \ud658\uacbd \ub4f1 \uad6d\uc81c\uc801 \uc5f0\ub300\ub97c \ubc14\ud0d5\uc73c\ub85c \ud558\ub294 3\uc138\ub300 \uc5f0\ub300\uad8c\uc758 \ud575\uc2ec \ud56d\ubaa9\ub4e4\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ucf8c\uc801\ud55c \uc8fc\uac70 \uc0dd\ud65c\uc744 \ud560 \uad8c\ub9ac, \uac74\uac15\ud558\uace0 \ucf8c\uc801\ud55c \ud658\uacbd\uc5d0\uc11c \uc0b4 \uad8c\ub9ac",
          "rationale": "\ubcf5\uc9c0 \uad6d\uac00\uc801 \uac1c\uc785 \ubc0f \ucf8c\uc801\ud55c \uc0dd\ud65c \uc870\uac74\uacfc \uc5f0\uacc4\ub41c 2\uc138\ub300 \uc0ac\ud68c\uad8c \ub610\ub294 \ud604\ub300\uc801 \uc2e0\uc885 \uc0ac\ud68c\uad8c \uc601\uc5ed\uc5d0 \uc8fc\ub85c \uc18d\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubbfc\uc871\uc801 \uc790\uacb0, \uad6d\uc81c \ud3c9\ud654, \uc9c0\uad6c\ucd0c \ucc28\uc6d0\uc758 \uc7ac\ub09c \uad6c\uc81c \ubc0f \uc9c0\uc18d \uac00\ub2a5\ud55c \ubc1c\uc804\uacfc \uad00\ub828\ub41c \ud56d\ubaa9\uc744 \uc120\ud0dd\ud558\uc138\uc694."
    }
  ]
}