        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \ubb34\uc5ed\uc774 \uc0dd\uc0b0\uc790\uc5d0\uac8c \ub354 \ub9ce\uc740 \uc774\uc775\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\ub294 \uc720\ud1b5 \ubc29\uc2dd\uc0c1\uc758 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uac04 \uc720\ud1b5 \uacfc\uc815\uc744 \uc904\uc5ec \uc0dd\uc0b0\uc790\uc5d0\uac8c \ub354 \ub9ce\uc740 \uc774\uc775\uc774 \ub3cc\uc544\uac00\uac8c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ud589\uc790\uc5d0\uac8c\ub294 \ubb38\ud654 \uccb4\ud5d8\uc744, \ud604\uc9c0\uc778\uc5d0\uac8c\ub294 \uacbd\uc81c\uc801 \ud61c\ud0dd\uc744 \uc81c\uacf5\ud558\uba70 \ud658\uacbd \ubcf4\ud638\ub97c \uc2e4\ucc9c\ud558\ub294 \uc5ec\ud589 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \uc5ec\ud589 (Fair Travel)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \uc5ec\ud589\uc744 \ud560 \ub54c \ud658\uacbd \ubcf4\ud638\ub97c \uc704\ud574 \uc2e4\ucc9c\ud574\uc57c \ud558\ub294 \uad6c\uccb4\uc801\uc778 \uc9c0\uce68\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ud68c\uc6a9\ud488 \uc0ac\uc6a9\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \uc790\uc6d0\uc744 \uc808\uc57d\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \uc5ec\ud589 \uc911 \ud604\uc9c0\uc778\uc5d0\uac8c \uc2e4\uc9c8\uc801\uc778 \uacbd\uc81c\uc801 \ud61c\ud0dd\uc744 \uc8fc\uae30 \uc704\ud55c \uc18c\ube44 \ud589\ub3d9 \uc9c0\uce68\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\uc9c0\uc778\uc774 \uc6b4\uc601\ud558\ub294 \uc2dd\ub2f9\uacfc \uc219\uc18c\ub97c \uc774\uc6a9\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \uadf8\ub9bc\uc774 \ub098\ud0c0\ub0b4\ub294 \uacf5\uc815 \uc5ec\ud589\uc758 \ud575\uc2ec \uc2e4\ucc9c \uc218\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
          },
          {
            "type": "image",
            "reference": "bff0696b-e08c-4e93-8c35-8674f390c02e",
            "alt": "\uc77c\ud68c\uc6a9 \uc6a9\uae30 \uae08\uc9c0 \ud45c\uc2dc\uac00 \ubd99\uc740 \ubc30\ub0ad\uc744 \uba58 \uc5ec\ud589\uc790\uc640 \uc720\uc801\uc9c0 \uc77c\ub7ec\uc2a4\ud2b8"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ud68c\uc6a9\ud488 \uc0ac\uc6a9\uc744 \ucd5c\uc18c\ud654\ud558\uc5ec \uc790\uc6d0\uc744 \uc808\uc57d\ud558\uace0 \ud658\uacbd\uc744 \ubcf4\ud638\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uc9c0\uc5ed\uc758 \ud2b9\uc218\ud55c \uc694\uc18c\ub4e4\uc774 \uc138\uacc4\uc801\uc778 \ucc28\uc6d0\uc5d0\uc11c \uac00\uce58\ub97c \uc778\uc815\ubc1b\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc5d0\uc11c \uacbd\uc601 \uc804\ub7b5\uc744 \uc138\uc6b0\uace0 \ubcf8\uc0ac \uae30\ub2a5\uc744 \uc218\ud589\ud558\ub294 \uc0ac\uc5c5\uc7a5\uc740 \uc8fc\ub85c \uc5b4\ub514\uc5d0 \uc785\uc9c0\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf8\uad6d\uc758 \ub300\ub3c4\uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc758 \uc0dd\uc0b0 \uacf5\uc7a5\uc740 \uc8fc\ub85c \uc5b4\ub5a4 \uc9c0\uc5ed\uc801 \uc870\uac74\uc744 \uac16\ucd98 \uacf3\uc5d0 \uc124\ub9bd\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9\ub825\uc774 \uc800\ub834\ud558\uac70\ub098 \uc2dc\uc7a5 \uc811\uadfc\uc131\uc774 \uc88b\uc740 \uacf3"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654 \ud750\ub984 \uc18d\uc5d0\uc11c \uc815\uce58, \uacbd\uc81c, \uae08\uc735, \ubb38\ud654 \ub4f1\uc758 \uae00\ub85c\ubc8c \uc911\uc2ec\uc9c0 \uc5ed\ud560\uc744 \ud558\ub294 \ub3c4\uc2dc\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ub3c4\uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub098\ub098\uac00 \uc218\ud655\ub418\uc5b4 \uc18c\ube44\uc790\uc5d0\uac8c \ub3c4\ub2ec\ud558\uae30\uae4c\uc9c0 \uac70\uce58\ub294 5\uac00\uc9c0 \ubb34\uc5ed \uc8fc\uccb4\ub97c \uc21c\uc11c\ub300\ub85c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub098\ub098 \ub18d\ubd80 \u2192 \ubc14\ub098\ub098 \ub18d\uc7a5 \uc8fc\uc778 \u2192 \uc120\uc801 \ucc98\ub9ac\uc5c5\uc790 \u2192 \uc218\uc785\uc5c5\uc790 \u2192 \ub300\ud615 \ud560\uc778\uc810"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub098\ub098 \ub18d\ubd80\ub4e4\uc774 \ud604\uc7a5\uc5d0\uc11c \uacaa\ub294 \uace0\ub41c \ub178\ub3d9 \ud658\uacbd \uc870\uac74 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud558\ub8e8 12~14\uc2dc\uac04\uc529 \ub354\uc704 \uc18d\uc5d0\uc11c \ub178\ub3d9\ud558\uba70, \ubb34\uac70\uc6b4 \ubc14\ub098\ub098\ub97c \uc9c1\uc811 \uc6b4\ubc18\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub098\ub098 \ub18d\ubd80\uac00 \uc791\uc5c5\uc744 \uc9c4\ud589\ud558\uba74\uc11c \ub178\ucd9c\ub418\ub294 \uc8fc\uc694 \uac74\uac15 \uc704\ud5d8 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\ub8cc\uc640 \uc0b4\ucda9\uc81c\uc5d0 \ubb34\ubc29\ube44\ub85c \ub178\ucd9c\ub418\uc5b4 \uc9c8\ubcd1\uc5d0 \uac78\ub9b4 \uc704\ud5d8\uc774 \ud06c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub098\ub098 \ub18d\uc7a5 \uc8fc\uc778\uc774 \ub18d\uc7a5\uc744 \uc6b4\uc601\ud558\uba74\uc11c \uc9c0\ucd9c\ud574\uc57c \ud558\ub294 \uc8fc\uc694 \ube44\uc6a9 \ubd80\ub2f4 \ud56d\ubaa9 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub18d\ubd80 \uc784\uae08 \uc9c0\uae09, \ub18d\uc7a5 \uc6b4\uc601\ube44 \ubc0f \uc2dc\uc124 \ud604\ub300\ud654\u00b7\ud1a0\uc9c0 \uad00\ub9ac \ube44\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub098\ub098 \ub18d\uc7a5 \uc8fc\uc778\uc774 \uc0ac\uc5c5\uc744 \uacbd\uc601\ud558\uba74\uc11c \ubd80\ub2f4\ud574\uc57c \ud558\ub294 \uc6b0\ubc1c\uc801 \uc190\uc2e4 \uc704\ud5d8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\ud655 \ubd80\uc9c4\uc73c\ub85c \uc778\ud55c \uc190\uc2e4, \uc790\uc5f0\uc7ac\ud574\ub098 \ud574\ucda9\uc5d0 \uc758\ud55c \ud53c\ud574"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc801 \ucc98\ub9ac\uc5c5\uc790\uac00 \ud574\uc0c1 \uc6b4\uc1a1\uc744 \uc704\ud574 \uc9c0\ucd9c\ud574\uc57c \ud558\ub294 \uc8fc\ub41c \ube44\uc6a9 \ud56d\ubaa9 \uc138 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ubb3c\uc120 \uad6c\ub9e4 \ubc0f \uc720\uc9c0\ube44, \ud654\ubb3c\uc120 \uc5f0\ub8cc\ube44, \ud654\ubb3c \ubcf4\ud5d8\ub8cc(\ub0c9\uc7a5 \ubcf4\uad00\ube44 \ud3ec\ud568)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub098\ub098 \uc218\uc785\uc5c5\uc790\uac00 \uad6d\ub0b4 \uc218\uc785 \ud6c4 \ub9e4\uc7a5 \uacf5\uae09 \uc804\uae4c\uc9c0 \uc804\ub2f4\ud558\ub294 \uac00\uacf5 \ubc0f \uad00\ub9ac \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud56d\uad6c\uc5d0\uc11c \ub300\ud615 \ud560\uc778\uc810\uae4c\uc9c0 \uc6b4\ubc18, \ubc14\ub098\ub098\uc758 \uc219\uc131\uacfc \ud3ec\uc7a5, \uc219\uc131 \uc13c\ud130 \ubc0f \ucc3d\uace0 \uad00\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud615 \ud560\uc778\uc810\uc774 \ubc14\ub098\ub098 \ud310\ub9e4 \uacfc\uc815\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc0c1\ud488 \uc190\uc2e4\uacfc \uad00\ub828\ud558\uc5ec \ubd80\ub2f4\ud558\ub294 \ube44\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c4\uc5f4 \uad00\ub9ac \uc911 \ud314\ub9ac\uc9c0 \uc54a\uace0 \uc0c1\ud55c \ubc14\ub098\ub098\ub97c \ud3d0\uae30 \ucc98\ubd84\ud558\ub294 \ube44\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud615 \ud560\uc778\uc810\uc774 \uace0\uac1d \ud655\ubcf4 \ubc0f \ud310\ub9e4 \ud655\ub300\ub97c \uc704\ud574 \uc9c0\ucd9c\ud558\ub294 \ube44\uc6a9 \ud56d\ubaa9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\uace0\ube44"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18\uc801\uc778 \ubc14\ub098\ub098 \ubb34\uc5ed\uc758 \uc218\uc775 \ubd84\ubc30 \uad6c\uc870\uc5d0\uc11c \uac00\uc7a5 \ubd88\uacf5\uc815\ud558\ub2e4\uace0 \uc9c0\uc801\ubc1b\ub294 \ubd80\ubd84\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc7a5 \ud798\ub4e4\uace0 \uc704\ud5d8\ud55c \ub178\ub3d9\uc744 \ud558\ub294 \ubc14\ub098\ub098 \ub18d\ubd80\uc5d0\uac8c \ubd84\ubc30\ub418\ub294 \uc18c\ub4dd \ubaab\uc774 \uc9c0\ub098\uce58\uac8c \uc801\ub2e4\ub294 \uc810"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790\uac00 \uac00\uaca9\uc774 \ub2e4\uc18c \ub192\ub354\ub77c\ub3c4 \uacf5\uc815 \ubb34\uc5ed \ubc14\ub098\ub098\ub97c \uad6c\ub9e4\ud560 \ub54c \ubc1c\uc0dd\ud558\ub294 \uae0d\uc815\uc801 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d \ub18d\ubd80\uc758 \uc18c\ub4dd\uc774 \ub298\uc5b4\ub098 \uc790\ub9bd\uc744 \ub3d5\uace0 \uc0dd\ud65c \uc218\uc900\uc744 \uac1c\uc120\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc801 \uac1c\ubc1c \uc6d0\uc870(ODA)\uc758 \uad81\uadf9\uc801\uc778 \ucd94\uc9c4 \ubaa9\ud45c \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \uacbd\uc81c \ubc1c\uc804\uacfc \uc0ac\ud68c \ubcf5\uc9c0 \uc99d\uc9c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720 \ubb34\uc5ed\uc774 \uc9c0\ub2cc \ube48\ubd80 \uaca9\ucc28 \ubb38\uc81c\ub97c \uc644\ud654\ud558\uae30 \uc704\ud574 \uc18c\ube44\uc790\uc640 \uc0dd\uc0b0\uc790\uac00 \ud568\uaed8 \uc0c1\uc0dd\ud558\ub294 \uac70\ub798 \ud615\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \ubb34\uc5ed"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed\uc758 \uace0\uc720\ud55c \ud2b9\uc131\uc744 \uc0b4\ub824 \uc804 \uc138\uacc4\uc801\uc778 \uac00\uce58\ub97c \ucc3d\ucd9c\ud558\ub294 '\uc9c0\uc5ed\ud654'\uc758 \uc608\uc2dc\ub97c \uc11c\uc220\ud558\ub294 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uc9c0\uc5ed\uc758 \ubb38\ud654\ub098 \uc0dd\uc0b0\ubb3c\uc774 \uc138\uacc4\ud654 \uacfc\uc815\uc744 \uac70\uccd0 \ub3c5\uc790\uc801 \uac00\uce58\ub97c \uc778\uc815\ubc1b\ub294 \ud604\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \uc0ac\ud68c\uac00 \uc790\uad6d\uc758 \ud2b9\uc218 \uc724\ub9ac\ub9cc\uc744 \uace0\uc9d1\ud558\uc5ec \uc778\ub958\uc758 \ubcf4\ud3b8 \uc724\ub9ac\ub97c \uce68\ud574\ud560 \ub54c \ubc1c\uc0dd\ud558\ub294 \uc724\ub9ac\uc801 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04 \uc874\uc5c4\uc131, \uc790\uc720, \ud3c9\ub4f1\uacfc \uac19\uc740 \uc778\ub958 \ubcf4\ud3b8\uc801 \uac00\uce58\uac00 \ud6fc\uc190\ub420 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \uc0ac\ud68c\uc758 \ud2b9\uc218 \uc724\ub9ac\ub97c \ubb34\uc2dc\ud558\uace0 \uac15\uc81c\ub85c \ubcf4\ud3b8 \uc724\ub9ac\ub9cc\uc744 \uc801\uc6a9\ud560 \ub54c \ub098\ud0c0\ub0a0 \uc218 \uc788\ub294 \ubd80\uc815\uc801 \uc601\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\ub2f9 \uc0ac\ud68c\uc758 \uc804\ud1b5\uacfc \ubb38\ud654\uc801 \ub9e5\ub77d\uc744 \ubb34\uc2dc\ud558\uc5ec \uc2ec\uac01\ud55c \uc724\ub9ac\uc801 \ucda9\ub3cc\uacfc \uac08\ub4f1\uc744 \uc77c\uc73c\ud0ac \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\ub85c\ubc8c \ube48\ubd80 \uaca9\ucc28 \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574 \uc138\uacc4\uc2dc\ubbfc\uc73c\ub85c\uc11c \uac1c\uc778\uc774 \uc774\ud589\ud560 \uc218 \uc788\ub294 \uc2e4\ucc9c \ubc29\uc548 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \ubb34\uc5ed \uc81c\ud488 \uc18c\ube44\ud558\uae30, \uacf5\uc815 \uc5ec\ud589 \uc218\uce59 \uc900\uc218\ud558\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \uc5ec\ud589\uc774 \uc5ec\ud589 \uacfc\uc815\uc5d0\uc11c \ud2b9\ud788 \uac15\uc870\ud558\uc5ec \uc2e4\ucc9c\ud558\ub294 \uac00\uce58 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0 \uc808\uc57d\uacfc \ud658\uacbd \ubcf4\ud638"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub098\ub098 \ub18d\ubd80\uc758 \uacbd\uc81c\uc801 \uc5b4\ub824\uc6c0\uc744 \ud574\uc18c\ud558\uae30 \uc704\ud574 \ubc14\ub098\ub098 \uc720\ud1b5 \uac00\uaca9 \uad6c\uc870\uc5d0\uc11c \uc870\uc815\ub418\uc5b4\uc57c \ud560 \ubc29\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uac04 \uc720\ud1b5 \ub2e8\uacc4\uc758 \uacfc\ub3c4\ud55c \ub9c8\uc9c4\uc744 \uc904\uc5ec \uc0dd\uc0b0\uc790\uc778 \ub18d\ubd80\uc5d0\uac8c \uc9c0\uae09\ub418\ub294 \uc784\uae08\uacfc \ubaab\uc744 \ub298\ub824\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uba78 \uc704\uae30 \uc5b8\uc5b4\uac00 \uc99d\uac00\ud560 \ub54c \uad81\uadf9\uc801\uc73c\ub85c \uac10\uc18c\ud558\uac8c \ub418\ub294 \uc778\ub958 \uc804\uccb4\uc758 \uc790\uc0b0\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\ud654 \ub2e4\uc591\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654 \ubb38\uc81c\uc810 \uadf9\ubcf5\uc744 \uc704\ud55c \uc138\uacc4\uc2dc\ubbfc \uc758\uc2dd\uc758 \ud575\uc2ec \uad6c\uc131 \uc694\uc18c \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uad6c\ucd0c \ubb38\uc81c\uc5d0 \ub300\ud55c \ucc45\uc784 \uc758\uc2dd\uacfc \uc774\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud55c \uc801\uadf9\uc801\uc778 \ud589\ub3d9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc774 \uc9c0\uc18d \uac00\ub2a5\ud55c \uacbd\uc81c \uc131\uc7a5\uc744 \uc774\ub8e8\uae30 \uc704\ud574 \uacf5\uc801 \uac1c\ubc1c \uc6d0\uc870(ODA)\ub97c \ud65c\uc6a9\ud558\uc5ec \ub2ec\uc131\ud574\uc57c \ud558\ub294 \uc0c1\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\uc801 \uc790\ub9bd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\ud654 \ud68d\uc77c\ud654\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc678\ub798\ubb38\ud654\ub97c \uc218\uc6a9\ud560 \ub54c \uc8fc\uccb4\uc801\uc778 \uc911\uc2ec\uc810\uc774 \ub418\uc5b4\uc57c \ud558\ub294 \uac83\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uae30 \ubb38\ud654\uc758 \uc815\uccb4\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub098\ub098 \ubb34\uc5ed\uc5d0\uc11c \uc720\ud1b5 \ub2e8\uacc4\uac00 \uae38\uc5b4\uc9c8\uc218\ub85d \uc77c\uc5b4\ub098\ub294 \uc77c\ubc18\uc801\uc778 \uc218\uc775 \ubd84\ubc30\uc758 \ubcc0\ud654 \uacbd\ud5a5\uc740 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uac04 \uc720\ud1b5 \uc5c5\uc790\uc640 \ud310\ub9e4\ucc98\uac00 \uac00\uc838\uac00\ub294 \uc218\uc775 \ube44\uc911\uc774 \ub192\uc544\uc9c0\uace0 1\ucc28 \uc0dd\uc0b0\uc790\uc758 \ubaab\uc740 \uc904\uc5b4\ub4e0\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654\uc5d0 \ub530\ub978 \ubcf4\ud3b8 \uc724\ub9ac\uc640 \ud2b9\uc218 \uc724\ub9ac\uc758 \ucda9\ub3cc\uc744 \ubc14\ub974\uac8c \ud574\uacb0\ud558\uae30 \uc704\ud55c \ud575\uc2ec \uc6d0\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ub300 \uc0ac\ud68c\uc758 \ud2b9\uc218\uc131\uc744 \ub9e5\ub77d\uc801\uc73c\ub85c \uc774\ud574\ud558\ub418, \ubcf4\ud3b8\uc801 \uc778\uad8c\uacfc \uac00\uce58\ub97c \uae30\uc900\uc73c\ub85c \uc131\ucc30\ud558\ub294 \uac83\uc774\ub2e4."
          }
        ]
      }
    }
  ]
}