    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc790\uc6d0\uc744 \uacf5\uc815\ud558\uac8c \ubd84\ubc30\ud558\ub294 \uc6d0\uce59\uacfc \uad00\ub828\ub41c \uc815\uc758\uc758 \uc720\ud615\uc740 \ubb34\uc5c7\uc778\uac00?"
