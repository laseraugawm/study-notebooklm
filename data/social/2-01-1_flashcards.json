    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud50c\ub77c\ud1a4\uc774 \uc0dd\uac01\ud55c \uc815\uc758\uc758 \ud575\uc2ec \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01\uc790 \ud0c0\uace0\ub09c \uc131\ud5a5\uc5d0 \ub530\ub77c \uc790\uc2e0\uc758 \uc77c\uc744 \ub2e4\ud558\ub294 \uac83"
