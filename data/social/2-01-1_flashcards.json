            "alt": "\ub0a8\uc544\ud504\ub9ac\uce74 \uacf5\ud654\uad6d\uc758 \uc544\ud30c\ub974\ud2b8\ud5e4\uc774\ud2b8 \uc2dc\ud589 \ub2f9\uc2dc \ubc31\uc778 \uc804\uc6a9 \uc2dc\uc124 \uc54c\ub9bc \ud45c\uc9c0\ud310"
