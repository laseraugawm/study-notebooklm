      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c1\uc5c5 \uc120\ud0dd\uc758 \uc81c\ud55c, \ubc31\uc778\uacfc\uc758 \uacb0\ud63c \uae08\uc9c0, \uacf5\uacf5\uc2dc\uc124 \ubc0f \uc2b9\ucc28 \uacf5\uac04\uc758 \uad6c\ubd84 \uc81c\ud55c \ub4f1"
