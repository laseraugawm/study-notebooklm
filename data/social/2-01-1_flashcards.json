    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc798\ubabb\uc744 \uc800\uc9c0\ub978 \uc0ac\ub78c\uc774 \ud569\ub2f9\ud55c \ucc98\ubc8c\uc744 \ubc1b\uc9c0 \uc54a\ub294 \uc0ac\ud68c\uc5d0\uc11c \uac00\uc7a5 \uba3c\uc800 \ubb34\ub108\uc9c0\uac8c \ub418\ub294 \uc0ac\ud68c\uc801 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
