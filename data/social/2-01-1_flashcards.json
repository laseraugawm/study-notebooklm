        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\uacf5\uc815\ud55c \ud589\uc704\ub098 \uc798\ubabb\ub41c \ud589\ub3d9\uc744 \ubc14\ub85c\uc7a1\uace0, \uc798\ubabb\uc5d0 \ub300\ud55c \ub300\uc751\uc758 \uacf5\uc815\uc131\uc744 \ub2e4\ub8e8\ub294 \uc815\uc758\uc758 \uc720\ud615\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
