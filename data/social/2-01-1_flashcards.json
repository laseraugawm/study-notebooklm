    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\uc5d0\uc11c\ub294 \uad6c\uc131\uc6d0\ub4e4\uc774 \uc131\ubcc4, \uc778\uc885, \uc0ac\ud68c\u00b7\uacbd\uc81c\uc801 \uc9c0\uc704 \ub4f1\uc744 \uc774\uc720\ub85c _____\ubc1b\uc9c0 \uc54a\uace0, \uacf5\uc815\ud55c \uc808\ucc28\uc640 \uae30\uc900\uc5d0 \ub530\ub77c \uc790\uae30 \ubaab\uc744 \ubc1b\ub294\ub2e4."
