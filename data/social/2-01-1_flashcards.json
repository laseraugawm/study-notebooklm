{
  "title": "\uc815\uc758 \uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18\uc801\uc73c\ub85c \uc0ac\ud68c\uc5d0\uc11c '\uc815\uc758(\u6b63\u7fa9)'\uac00 \uac00\uc9c0\ub294 \ub300\ud45c\uc801\uc778 \uc138 \uac00\uc9c0 \uc8fc\uc694 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc62c\ubc14\ub984, \uacf5\uc815\ud568, \ud3c9\ub4f1\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc591 \uc0ac\uc0c1\uac00\ub4e4\uc774 \uc8fc\ub85c \ubc14\ub77c\ubcf8 '\uc815\uc758'\uc758 \ud575\uc2ec \uad00\uc810 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc62c\ubc14\ub978 \ud589\ub3d9\uc744 \ud558\ub294 \uac83, \uc0ac\uc801 \uc774\uc775\uc774\ub098 \uacb0\uacfc\uc5d0 \uc5bd\ub9e4\uc774\uc9c0 \uc54a\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\uc591 \uc0ac\uc0c1\uac00\ub4e4\uc774 \uc8fc\ub85c \ubc14\ub77c\ubcf8 '\uc815\uc758'\uc758 \ud575\uc2ec \uad00\uc810 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01\uc790\uc5d0\uac8c \uacf5\uc815\ud55c \ubaab\uc744 \uc8fc\ub294 \uac83, \uc790\uc2e0\uc774 \ub9e1\uc740 \uc5ed\ud560\uc744 \ucda9\uc2e4\ud788 \uc218\ud589\ud558\ub294 \uac83"
          }
        ]
