      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\uc6b8\uc740 \uacf5\ud3c9\ud558\uace0 \uacf5\uc815\ud55c \ud310\ub2e8\uc744, \uce7c\uc740 \uac15\ub825\ud55c \uc81c\uc7ac\ub97c \uc758\ubbf8\ud568"
