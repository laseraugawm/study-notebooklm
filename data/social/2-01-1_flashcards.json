            "type": "text",
            "content": "\uad6c\uc131\uc6d0 \uac04 \uc2e0\ub8b0\uc640 \ud611\ub825 \ud615\uc131, \uc0ac\ud68c \ud1b5\ud569 \ubc0f \ubc1c\uc804"
