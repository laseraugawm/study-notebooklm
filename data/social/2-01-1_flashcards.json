    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\uc5d0\uc11c \uacf5\uc815\ud55c \ubc95 \uc9d1\ud589\uacfc \uc801\uc808\ud55c \ucc98\ubc8c\uc774 \uc774\ub8e8\uc5b4\uc9c8 \ub54c \uae30\ub300\ud560 \uc218 \uc788\ub294 \uc0ac\ud68c\uc801 \ud6a8\uacfc \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
