    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\uc591\uc758 \uc815\uc758\uc758 \uc5ec\uc2e0\uc0c1\uc5d0\uc11c '\uc800\uc6b8'\uc774 \uc0c1\uc9d5\ud558\ub294 \uc0ac\ud68c\uc801 \uac00\uce58\ub294 \ubb34\uc5c7\uc778\uac00?"
