      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\ub4f1\ud558\ub2e4\uba74 \ub3d9\ub4f1\ud55c \ubaab\uc744, \ub3d9\ub4f1\ud558\uc9c0 \uc54a\ub2e4\uba74 \ub3d9\ub4f1\ud558\uc9c0 \uc54a\uc740 \ubaab\uc744 \uac00\uc9c0\ub294 \uac83"
          }
        ]
