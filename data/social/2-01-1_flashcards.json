    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ub2f9\ud55c \uc774\uc720 \uc5c6\uc774 \ucc28\ubcc4\ubc1b\ub294 \ubd88\uc758\ud55c \uc0ac\ud68c\uc5d0\uc11c\ub294 \uc0ac\ud68c \uad6c\uc131\uc6d0\uc758 \uc5b4\ub5a4 \ud575\uc2ec\uc801 \uac00\uce58\uac00 \uc720\uc9c0\ub418\uae30 \uc5b4\ub824\uc6b4\uac00?"
