    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9f9\uc790\ub294 '\uc758(\u7fa9)'\uc5d0 \ub300\ud574 \uc5b4\ub5bb\uac8c \uc815\uc758\ud558\uc600\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc798\ubabb\uc744 \ubd80\ub044\ub7ec\uc6cc\ud558\uace0 \uc774\uc775\uc5d0 \uc9d1\ucc29\ud558\uc9c0 \uc54a\ub294 \uc62c\uace7\uc74c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\uac00 \uc81c\uc2dc\ud55c \uc815\uc758\uc758 \ud575\uc2ec \uc6d0\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
