          {
            "type": "text",
            "content": "\uc774 \ud45c\uc9c0\ud310\uacfc \uad00\ub828\ub41c \uc544\ud30c\ub974\ud2b8\ud5e4\uc774\ud2b8 \uc815\ucc45 \uc544\ub798\uc5d0\uc11c \ud751\uc778\ub4e4\uc774 \uacaa\uc740 \ucc28\ubcc4 \uc0ac\ub840 \ub450 \uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
