          {
            "type": "text",
            "content": "\ucf00\uc774\ud06c \ub098\ub204\uae30 \ubb38\uc81c\uc5d0\uc11c \uc790\ub974\ub294 \uc0ac\ub78c\uc774 \ubcf8\uc778\uc758 \ubaab\uc744 \ubcf4\uc7a5\ubc1b\uae30 \uc704\ud574 \uc790\uc5f0\uc2a4\ub7fd\uac8c \uade0\ub4f1\ud558\uac8c \uc790\ub974\uac8c \ub418\ub294 \uc2ec\ub9ac\uc801 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc778\uc774 \uba3c\uc800 \uc120\ud0dd\uad8c\uc744 \uac00\uc9c0\ubbc0\ub85c, \ubd88\uade0\ub4f1\ud558\uac8c \uc790\ub974\uba74 \ubcf8\uc778\uc5d0\uac8c \uac00\uc7a5 \uc791\uc740 \uc870\uac01\uc774 \ub0a8\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc98\uce60 \uc218\uc0c1\uc774 \ub2e8\uc18d\ub418\uc5c8\uc744 \ub54c \uad50\ud1b5\uacbd\ucc30\uc774 \ubc1d\ud78c \ubc95 \uc9d1\ud589\uc758 \uae30\ubcf8 \uc6d0\uce59\uc740 \ubb34\uc5c7\uc774\uc5c8\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc95 \uc801\uc6a9\uc5d0 \uc608\uc678\ub294 \uc5c6\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\uc640 \ud50c\ub77c\ud1a4\uc758 \uc815\uc758\uad00\uc758 \uacf5\ud1b5\uc810\uc740 \ub3d9\uc591/\uc11c\uc591 \uc911 \uc5b4\ub290 \uc0ac\uc0c1\uc801 \uc804\ud1b5\uc5d0 \uc18d\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\uc591 \uc0ac\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud50c\ub77c\ud1a4\uc5d0 \ub530\ub974\uba74 \uc0ac\ud68c \uc804\uccb4\uc758 \uc815\uc758\ub294 \uac1c\uc778\ub4e4\uc774 \ubb34\uc5c7\uc744 \ud560 \ub54c \uc774\ub8e8\uc5b4\uc9c0\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01\uc790 \ud0c0\uace0\ub09c \uc131\ud5a5\uc5d0 \ub530\ub77c \uc790\uc2e0\uc758 \uc5ed\ud560(\uc77c)\uc744 \ucda9\uc2e4\ud788 \ub2e4\ud560 \ub54c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9f9\uc790\uc5d0 \ub530\ub974\uba74 \uc62c\ubc14\ub978 \ud589\ub3d9\uc744 \ud558\uace0 \uc774\uc775\uc5d0 \uc9d1\ucc29\ud558\uc9c0 \uc54a\ub294 \uc62c\uace7\uc74c\uc744 \ubb34\uc5c7\uc774\ub77c \ubd80\ub974\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758(\u7fa9)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\uac00 \uc0ac\ud68c\ub97c \uad6c\uc131\ud558\uace0 \uc720\uc9c0\ud558\ub294 \ub370 \uc788\uc5b4 \uac16\ub294 \uc704\uce58\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815\ud55c \uc0ac\ud68c\uac00 \uc9c0\ud5a5\ud574\uc57c \ud560 \ud575\uc2ec \uac00\uce58\uc774\uc790 \uc0ac\ud68c \uc720\uc9c0\uc758 \uae30\ubcf8 \uc6d0\uce59"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc94\uce59\uae08 \ubd80\uacfc \uc0ac\ub840\uc5d0\uc11c \uad50\ud1b5\uacbd\ucc30\uc774 \uc218\uc0c1\uc774 \ud0c4 \ucc28\ub77c\ub294 \uc774\uc720\ub85c \uc608\uc678\ub97c \ub450\uc5c8\ub2e4\uba74 \ubb34\ub108\uc84c\uc744 \uc815\uc758\uc758 \uc885\ub958\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\uc815\uc801 \uc815\uc758 (\ub610\ub294 \ubc95 \uc9d1\ud589\uc758 \uacf5\uc815\uc131)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a8\uc544\ud504\ub9ac\uce74 \uacf5\ud654\uad6d\uc758 '\uc544\ud30c\ub974\ud2b8\ud5e4\uc774\ud2b8' \uc0ac\ub840\ub294 \uc5b4\ub5a4 \uce21\uba74\uc758 \uc815\uc758\uac00 \ud6fc\uc190\ub41c \ub300\ud45c\uc801 \uc608\uc2dc\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c \ubcf4\uc7a5 \ubc0f \ud3c9\ub4f1\uc131, \ubd84\ubc30\uc801\u00b7\uc0ac\ud68c\uc801 \uc815\uc758\uc758 \ud6fc\uc190"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ub3d9\ub4f1\ud558\uc9c0 \uc54a\ub2e4\uba74 \ub3d9\ub4f1\ud558\uc9c0 \uc54a\uc740 \ubaab\uc744 \uac00\uc9c0\ub294 \uac83'\uc774\ub77c\ub294 \uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\uc758 \uc8fc\uc7a5\uc774 \uc758\ubbf8\ud558\ub294 \uac83\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc28\uc774\uc640 \uc5c5\uc801, \uac00\uce58 \ub4f1\uc758 \ucc28\uc774\uc5d0 \ub530\ub978 \ucc28\ub4f1\uc801(\ube44\ub840\uc801) \ubd84\ubc30\uc758 \uc778\uc815"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4 \ubcc0\ud654 \ubb38\uc81c\ub098 \ud0c4\uc18c \uc911\ub9bd \uc804\ud658 \uacfc\uc815\uc5d0\uc11c \uc77c\uc790\ub9ac\ub97c \uc783\ub294 \ub178\ub3d9\uc790\ub97c \ubcf4\ud638\ud558\ub824\ub294 \ub17c\uc758\ub294 \uc5b4\ub5a4 \uc815\uc758 \uac1c\ub150\uacfc \uc5f0\uad00\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4 \uc815\uc758 \ubc0f \uc815\uc758\ub85c\uc6b4 \uc804\ud658(\uc0ac\ud68c\uc801\u00b7\ubd84\ubc30\uc801 \uc815\uc758)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc591 \uc0ac\uc0c1\uc5d0\uc11c \uc815\uc758\ub97c \ub2e4\ub8f0 \ub54c \uacf5\ud1b5\uc801\uc73c\ub85c \ubc30\uc81c\ud558\uace0\uc790 \ud55c \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc801 \uc774\uc775\uc774\ub098 \uacb0\uacfc\uc5d0 \ub300\ud55c \uc9d1\ucc29"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\uc591 \uc0ac\uc0c1\uc5d0\uc11c \uc815\uc758\ub97c \ub2e4\ub8f0 \ub54c \ud575\uc2ec\uc801\uc73c\ub85c \uac15\uc870\ub41c \uac1c\uc778\uc758 \ubaab \ubc0f \uc758\ubb34 \uad00\ub828 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815\ud55c \ubaab \ubd84\ubc30 \ubc0f \ud0c0\uace0\ub09c \uc131\ud5a5\uc5d0 \ub530\ub978 \uc790\uc2e0\uc758 \uc5ed\ud560 \uc218\ud589"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ubc30\uc801 \uc815\uc758\uac00 \uacf5\uc815\ud558\uac8c \uc774\ub8e8\uc5b4\uc9c0\uc9c0 \uc54a\uc744 \uacbd\uc6b0 \uc0ac\ud68c \uad6c\uc131\uc6d0 \uac04 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0 \ubd84\ubc30\uc5d0 \ub300\ud55c \ubd88\ub9cc, \uc0c1\ub300\uc801 \ubc15\ud0c8\uac10 \ubc0f \uc0ac\ud68c\uc801 \uac08\ub4f1 \ubc1c\uc0dd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\uc815\uc801 \uc815\uc758\uac00 \uc81c\ub300\ub85c \uc791\ub3d9\ud558\uc9c0 \uc54a\uc744 \ub54c \ubc1c\uc0dd\ud558\ub294 \uce58\uba85\uc801\uc778 \uc0ac\ud68c\uc801 \uacb0\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc95\uacfc \uc9c8\uc11c\uc758 \ubd95\uad34 \ubc0f \uc0c1\ud638 \uc2e0\ub8b0\uc758 \uc0c1\uc2e4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ud30c\ub974\ud2b8\ud5e4\uc774\ud2b8 \uc815\ucc45 \ub2f9\uc2dc \ud751\uc778\uacfc \ubc31\uc778\uc758 \uacb0\ud63c\uc774 \uae08\uc9c0\ub41c \uac83\uc740 \uac1c\uc778\uc758 \uc5b4\ub5a4 \uc790\uc720\uad8c\uc801 \uae30\ubcf8\uad8c\uc744 \uce68\ud574\ud55c \uac83\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud63c\uc778\uc758 \uc790\uc720 \ubc0f \uc778\uac04\uc73c\ub85c\uc11c\uc758 \uae30\ubcf8\uc801 \uad8c\ub9ac(\uc874\uc5c4\uc131)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc790\uc6d0\uc744 \ubd84\ubc30\ud560 \ub54c \uacb0\uacfc\uc758 \ub3d9\uc77c\ud568\ubfd0\ub9cc \uc544\ub2c8\ub77c \ubd84\ubc30\uc5d0 \uc774\ub974\ub294 \uacfc\uc815\uc758 _____\uc774 \uac15\uc870\ub41c\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc808\ucc28\uc801 \uacf5\uc815\uc131(\ub610\ub294 \uacf5\uc815\ud55c \uc808\ucc28\uc640 \uae30\uc900)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucf00\uc774\ud06c \ub098\ub204\uae30 \uc0ac\ub840\uc5d0\uc11c '\uc808\ucc28\uc801 \uacf5\uc815\uc131'\uc744 \ud655\ubcf4\ud568\uc73c\ub85c\uc368 \ub3c4\ub2ec\ud558\uac8c \ub418\ub294 \ucd5c\uc885\uc801\uc778 \uacb0\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uade0\ub4f1\ud558\uace0 \uacf5\uc815\ud55c \ubd84\ubc30 \uacb0\uacfc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\ud638 \uc704\ubc18\uc744 \ud55c \uc218\uc0c1\uc5d0\uac8c \ubc94\uce59\uae08\uc744 \ubd80\uacfc\ud55c \uad50\ud1b5\uacbd\ucc30 \uc0ac\ub840\uac00 \uc8fc\ub294 \uad50\ud6c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc704\ub098 \uad8c\ub825\uc5d0 \uad6c\uc560\ubc1b\uc9c0 \uc54a\ub294 \uacf5\uc815\ud55c \ubc95 \uc9d1\ud589\uc774 \uc815\uc758 \uc0ac\ud68c\uc758 \uae30\ubcf8 \uc870\uac74\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\uac00 \uc2e4\ud604\ub418\uba74 \uad6c\uc131\uc6d0\ub4e4\uc774 \uc11c\ub85c \uc2e0\ub8b0\ud558\uc5ec \ub3c4\ub2ec\ud560 \uc218 \uc788\ub294 \uc0ac\ud68c\uc758 \uc0c1\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ud1b5\ud569 \ubc0f \uc9c0\uc18d\uc801\uc778 \ubc1c\uc804"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9f9\uc790\uc758 \uc0ac\uc0c1\uc5d0\uc11c \uc798\ubabb\uc744 \ubd80\ub044\ub7ec\uc6cc\ud558\ub294 \ub9c8\uc74c\uc778 '\uc218\uc624\uc9c0\uc2ec'\uc740 \ubb34\uc5c7\uc744 \uc2e4\ucc9c\ud558\ub294 \ubc14\ud0d5\uc774 \ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758(\u7fa9), \uc989 \uc815\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud50c\ub77c\ud1a4\uc758 \uc815\uc758\uad00\uc5d0\uc11c \uac1c\uc778\uc758 \uc131\ud5a5\uacfc \ub2a5\ub825\uc5d0 \ub530\ub77c \ucd5c\uc120\uc744 \ub2e4\ud574\uc57c \ud55c\ub2e4\ub294 \uc6d0\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc758 \uc77c(\uc5ed\ud560)\uc744 \ub2e4\ud558\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\uac00 \ub9d0\ud55c '\ub3d9\ub4f1\ud568'\uc740 \ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \uc870\uac74 \uc5c6\uc774 \uc815\ub7c9\uc801\uc73c\ub85c \ub611\uac19\uc774 \ub098\ub220\uc8fc\ub294 \uac83\ub9cc\uc744 \uc758\ubbf8\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub2c8\ub2e4. \ub3d9\ub4f1\ud558\uc9c0 \uc54a\uc740 \uc790\uc5d0\uac8c\ub294 \uadf8 \ucc28\uc774\uc5d0 \ubd80\ud569\ud558\ub294 \ube44\ub840\uc801 \ubaab\uc744 \uc8fc\ub294 \uac83\ub3c4 \uc815\uc758\ub85c \ubcf4\uc558\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\uc758 \uc758\ubbf8\uc5d0 \ub300\ud55c \ub3d9\uc11c\uc591 \uc0ac\uc0c1\uac00\uc758 \ube44\uad50 \uc911, \uc0ac\uc801 \uc774\uc775\uc758 \ubc30\uc81c\uc640 \uc62c\uace7\uc740 \ub3c4\ub355\uc801 \ud589\ub3d9\uc744 \uc0c1\ub300\uc801\uc73c\ub85c \ub354 \uac15\uc870\ud55c \ucabd\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc591 \uc0ac\uc0c1\uac00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\uc758 \uc758\ubbf8\uc5d0 \ub300\ud55c \ub3d9\uc11c\uc591 \uc0ac\uc0c1\uac00\uc758 \ube44\uad50 \uc911, \uac01\uc790\uc758 \uacf5\uc815\ud55c \ubaab\uc774\ub098 \uc0ac\ud68c\uc801 \uc5ed\ud560 \uc218\ud589\uc744 \uc0c1\ub300\uc801\uc73c\ub85c \ub354 \uac15\uc870\ud55c \ucabd\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\uc591 \uc0ac\uc0c1\uac00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\uac00 \uacb0\uc5ec\ub41c \uc0ac\ud68c\uc5d0\uc11c \uac1c\uc778\ub4e4\uc774 \uc9c1\uba74\ud558\uac8c \ub418\ub294 \uc778\uad8c\uc801 \uc704\ud5d8\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\ub2f9\ud55c \ucc28\ubcc4\uacfc \uae30\ubcf8\uad8c \uce68\ud574\ub85c \uc778\ud574 \uc778\uac04\uc73c\ub85c\uc11c\uc758 \uc874\uc5c4\uc131\uc744 \uc783\uac8c \ub428"
