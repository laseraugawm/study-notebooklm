      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\uc815\uc801 \uc815\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "b370a2e5-19cb-41be-9dfa-964f39dd462d",
            "alt": "\uc11c\uc591\uc758 \uc815\uc758\uc758 \uc5ec\uc2e0\uc0c1"
          },
          {
            "type": "text",
            "content": "\uc0ac\uc9c4 \uc18d \uc815\uc758\uc758 \uc5ec\uc2e0\uc0c1\uc774 \ud55c \uc190\uc5d0 \ub4e0 \uc800\uc6b8\uacfc \ub2e4\ub978 \uc190\uc5d0 \ub4e0 \uce7c\uc740 \uac01\uac01 \ubb34\uc5c7\uc744 \uc758\ubbf8\ud558\ub294\uac00?"
