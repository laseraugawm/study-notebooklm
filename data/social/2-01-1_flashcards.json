        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "20\uc138\uae30 \ud6c4\ubc18\uae4c\uc9c0 \ub0a8\uc544\ud504\ub9ac\uce74 \uacf5\ud654\uad6d\uc5d0\uc11c \uc2dc\ud589\ub418\uc5c8\ub358 \uadf9\ub2e8\uc801\uc778 \uc778\uc885 \ubd84\ub9ac \uc815\ucc45\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
