    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \ubb34\uc5ed \ud6a8\uc728\uc131\uc744 \uacfc\ub3c4\ud558\uac8c \uc911\uc2dc\ud560 \ub54c \uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d \uac04\uc5d0 \ubc1c\uc0dd\ud558\ub294 \uacbd\uc81c\uc801 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
