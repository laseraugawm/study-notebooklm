    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2023\ub144 \uc81c28\ucc28 UN \uae30\ud6c4\ubcc0\ud654 \ud611\uc57d \ub2f9\uc0ac\uad6d \ucd1d\ud68c(COP28)\uc5d0\uc11c \uae30\ud6c4 \uc7ac\ub09c\uc744 \uc785\uc740 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc744 \uae08\uc804\uc801\uc73c\ub85c \ubcf4\uc0c1\ud558\uae30 \uc704\ud574 \ud0c0\uacb0\ub41c \uae30\uae08\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
