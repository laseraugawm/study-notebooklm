      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd \ubcf4\ud638\ub97c \ube4c\ubbf8\ub85c \uc790\uad6d \uc0b0\uc5c5\uc744 \ubcf4\ud638\ud558\ub824\ub294 '\uc2e0\ubcf4\ud638 \ubb34\uc5ed\uc8fc\uc758' \uc870\uce58\ub77c\ub294 \uc810"
          }
        ]
