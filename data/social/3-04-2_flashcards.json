    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \ubb34\uc5ed \ud61c\ud0dd\uc744 \uae30\uc5c5\ubfd0\ub9cc \uc544\ub2c8\ub77c \ub178\ub3d9\uc790\uc640 \uc9c0\uc5ed \uc0ac\ud68c\uc5d0 \uad11\ubc94\uc704\ud558\uac8c \uacf5\uc720\ud558\uae30 \uc704\ud55c \uad6c\uccb4\uc801 \ubc29\uc548 2\uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
