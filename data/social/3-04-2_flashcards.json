    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uac04 \ubd88\ud3c9\ub4f1\uc744 \uc644\ud654\ud558\uace0 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \uacbd\uc81c\uc801 \uc790\ub9bd\uc744 \ub3d5\uae30 \uc704\ud574 \uc120\uc9c4\uad6d\uc774 \uc81c\uacf5\ud574\uc57c \ud558\ub294 \uc9c0\uc6d0\uc740 \ubb34\uc5c7\uc778\uac00?"
