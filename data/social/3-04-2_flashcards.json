    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce5c\ud658\uacbd \uc0dd\uc0b0 \uae30\uc220\uc744 \uac1c\ubc1c\ud558\uace0 \uc81c\ud488 \uc7ac\ud65c\uc6a9\uc774 \uac00\ub2a5\ud558\ub3c4\ub85d \uc124\uacc4\ud558\ub294 \ub4f1 \uc0c1\ud488 \uc0dd\uc0b0 \uc2dc \ud658\uacbd \uc601\ud5a5\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \uc0dd\uc0b0 \ubc29\uc2dd\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
