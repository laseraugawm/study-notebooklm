    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\ub7fd \uc5f0\ud569(EU)\uc774 \ubc1c\ud45c\ud55c, \ud658\uacbd \uc624\uc5fc \uc720\ubc1c \uc218\uc785\ud488\uc5d0 \ub300\ud574 \uc81c\ud488 \uc0dd\uc0b0 \uc2dc \ubc1c\uc0dd\ud55c \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc744 \ucd94\uc815\ud558\uc5ec \uad00\uc138\ub97c \ubd80\uacfc\ud558\ub294 \uc81c\ub3c4\uc758 \uc57d\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
