    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\ub7fd \uc5f0\ud569\uc774 \uc7ac\ud65c\uc6a9\uc774 \ubd88\uac00\ub2a5\ud55c \ud50c\ub77c\uc2a4\ud2f1 \ud3d0\uae30\ubb3c\uc5d0 \ub300\ud574 kg\ub2f9 80\uc13c\ud2b8\ub97c \ubd80\uacfc\ud558\uae30\ub85c \ud55c \uc138\uae08\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
