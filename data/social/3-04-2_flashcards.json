      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud50c\ub77c\uc2a4\ud2f1\uc138"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud558\ub8e8 \ub3d9\uc548 \uc0dd\uc0b0 \uac00\ub2a5\ud55c \ucd5c\ub300\ub7c9\uc774 \ub2e4\uc74c\uacfc \uac19\uc744 \ub54c, \uac11\uacfc \uc744\uc758 \ubb3c\uace0\uae30 1\ub9c8\ub9ac \uc0dd\uc0b0\uc5d0 \ub300\ud55c \uae30\ud68c\ube44\uc6a9\uc744 \uac01\uac01 \uad6c\ud558\uc2dc\uc624.\n- \uac11: \ubb3c\uace0\uae30 15\ub9c8\ub9ac \ub610\ub294 \uc5f4\ub9e4 30\uac1c\n- \uc744: \ubb3c\uace0\uae30 10\ub9c8\ub9ac \ub610\ub294 \uc5f4\ub9e4 10\uac1c"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11: \uc5f4\ub9e4 2\uac1c ($30 / 15$)\n\uc744: \uc5f4\ub9e4 1\uac1c ($10 / 10$)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud558\ub8e8 \ub3d9\uc548 \uc0dd\uc0b0 \uac00\ub2a5\ud55c \ucd5c\ub300\ub7c9\uc774 \ub2e4\uc74c\uacfc \uac19\uc744 \ub54c, \uac11\uacfc \uc744\uc774 \uac01\uac01 \ube44\uad50 \uc6b0\uc704\ub97c \uac16\ub294 \uc7ac\ud654\ub294 \ubb34\uc5c7\uc778\uac00?\n- \uac11: \ubb3c\uace0\uae30 15\ub9c8\ub9ac \ub610\ub294 \uc5f4\ub9e4 30\uac1c\n- \uc744: \ubb3c\uace0\uae30 10\ub9c8\ub9ac \ub610\ub294 \uc5f4\ub9e4 10\uac1c"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11: \uc5f4\ub9e4 (\uc5f4\ub9e4 1\uac1c \uc0dd\uc0b0 \uae30\ud68c\ube44\uc6a9 \ubb3c\uace0\uae30 0.5\ub9c8\ub9ac\ub85c \uc744\ubcf4\ub2e4 \uc791\uc74c)\n\uc744: \ubb3c\uace0\uae30 (\ubb3c\uace0\uae30 1\ub9c8\ub9ac \uc0dd\uc0b0 \uae30\ud68c\ube44\uc6a9 \uc5f4\ub9e4 1\uac1c\ub85c \uac11\ubcf4\ub2e4 \uc791\uc74c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11\uad6d\uacfc \uc744\uad6d\uc758 \ube75 1\ub2e8\uc704 \uc0dd\uc0b0\ube44\uac00 \ub2e4\uc74c\uacfc \uac19\uc744 \ub54c, \uac01\uad6d\uc758 \ube75 1\ub2e8\uc704 \uc0dd\uc0b0\uc5d0 \ub300\ud55c \uae30\ud68c\ube44\uc6a9\uc744 \uad6c\ud558\uc2dc\uc624.\n- \ube75 1\ub2e8\uc704 \uc0dd\uc0b0\ube44: \uac11\uad6d 10\ub2ec\ub7ec, \uc744\uad6d 40\ub2ec\ub7ec\n- \uace0\uae30 1\ub2e8\uc704 \uc0dd\uc0b0\ube44: \uac11\uad6d 20\ub2ec\ub7ec, \uc744\uad6d 20\ub2ec\ub7ec"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11\uad6d: \uace0\uae30 0.5\ub2e8\uc704 ($10 / 20$)\n\uc744\uad6d: \uace0\uae30 2\ub2e8\uc704 ($40 / 20$)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11\uad6d\uacfc \uc744\uad6d\uc758 \uc7ac\ud654 1\ub2e8\uc704 \uc0dd\uc0b0\ube44\uac00 \ub2e4\uc74c\uacfc \uac19\uc744 \ub54c, \uc591\uad6d\uc774 \uac01\uac01 \ube44\uad50 \uc6b0\uc704\ub97c \uac16\ub294 \uc7ac\ud654\ub97c \uc4f0\uc2dc\uc624.\n- \ube75: \uac11\uad6d 10\ub2ec\ub7ec, \uc744\uad6d 40\ub2ec\ub7ec\n- \uace0\uae30: \uac11\uad6d 20\ub2ec\ub7ec, \uc744\uad6d 20\ub2ec\ub7ec"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11\uad6d: \ube75 (\uae30\ud68c\ube44\uc6a9 \uace0\uae30 0.5\ub2e8\uc704 < 2\ub2e8\uc704)\n\uc744\uad6d: \uace0\uae30 (\uae30\ud68c\ube44\uc6a9 \ube75 0.5\ub2e8\uc704 < 2\ub2e8\uc704)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \ub098\ub77c(\uac11\uad6d, \uc744\uad6d)\uac00 \uac01\uac01 \ube75\uacfc \uace0\uae30\ub97c 2\ub2e8\uc704\uc529 \uc790\uae09 \uc18c\ube44\ud558\ub358 \uc0c1\ud669\uc5d0\uc11c, \ube44\uad50 \uc6b0\uc704 \uc7ac\ud654\ub9cc 4\ub2e8\uc704 \ud2b9\ud654 \uc0dd\uc0b0 \ud6c4 2\ub2e8\uc704\uc529 \uc0c1\ud638 \uad50\ud658\ud560 \ub54c \uc5bb\ub294 \ubb34\uc5ed \uc774\ub4dd\uc744 \uacc4\uc0b0\ud558\uc2dc\uc624.\n(\uc0dd\uc0b0\ube44: \ube75-\uac11 10\ub2ec\ub7ec/\uc744 40\ub2ec\ub7ec, \uace0\uae30-\uac11 20\ub2ec\ub7ec/\uc744 20\ub2ec\ub7ec)"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11\uad6d: 20\ub2ec\ub7ec \uc774\ub4dd (\uc790\uae09 \uc2dc 60\ub2ec\ub7ec \uc18c\uc694 \u2192 \ud2b9\ud654 \ud6c4 40\ub2ec\ub7ec \uc18c\uc694)\n\uc744\uad6d: 40\ub2ec\ub7ec \uc774\ub4dd (\uc790\uae09 \uc2dc 120\ub2ec\ub7ec \uc18c\uc694 \u2192 \ud2b9\ud654 \ud6c4 80\ub2ec\ub7ec \uc18c\uc694)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub290 \ub098\ub77c\uac00 \ub2e4\ub978 \ub098\ub77c\ubcf4\ub2e4 \ubaa8\ub4e0 \uc0c1\ud488\uc744 Absolute \ube44\uc6a9\uc5d0\uc11c \ub354 \uc801\uac8c \ub4e4\uc5ec \uc0dd\uc0b0\ud560 \ub54c \ubb34\uc5ed\uc774 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\ub294\ub2e4\ub294 \uc8fc\uc7a5\uc740 \ub9de\ub294\uc9c0 \ud2c0\ub9b0\uc9c0 \ud310\ub2e8\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2c0\ub9ac\ub2e4 (X). \ud55c \ub098\ub77c\uac00 \ubaa8\ub4e0 \uc7ac\ud654 \uc0dd\uc0b0\uc5d0 \uc808\ub300 \uc6b0\uc704\uac00 \uc788\ub354\ub77c\ub3c4, \uc0c1\ub300\uc801 \uae30\ud68c\ube44\uc6a9 \ucc28\uc774\uc5d0 \ub530\ub978 '\ube44\uad50 \uc6b0\uc704'\uac00 \uc874\uc7ac\ud558\uba74 \ubb34\uc5ed\uc774 \ubc1c\uc0dd\ud558\uc5ec \uc591\uad6d \ubaa8\ub450 \uc774\ub4dd\uc744 \uc5bb\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ub4f1\ud559\uc0dd \uac11\uc774 \uc601\ud654 \uad00\ub78c\ub8cc 10,000\uc6d0\uc744 \uacb0\uc81c \ud6c4 1,000\uc6d0\uc758 \ubc84\uc2a4\ube44\ub97c \ub0b4\uace0 \uc774\ub3d9 \uc911, 50,000\uc6d0\uc744 \ubc1b\ub294 \uc54c\ubc14 \uc81c\uc758\ub97c \ubc1b\uc558\ub2e4. \uc601\ud654\ud45c\ub294 \uc804\uc561 \ud658\ubd88 \uac00\ub2a5\ud558\uace0 9,000\uc6d0 \ud0dd\uc2dc\ub97c \ud0c0\uace0 \uc774\ub3d9\ud558\uba74 \uc54c\ubc14\uac00 \uac00\ub2a5\ud558\ub2e4. \uac11\uc774 \uc601\ud654 \uad00\ub78c\uc744 \uc120\ud0dd\ud560 \ub54c \ud3ec\uae30\ud55c \uc21c\uc774\uc775(\uae30\ud68c\ube44\uc6a9)\uc744 \uad6c\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "51,000\uc6d0 (\uc54c\ubc14 \uc218\uc785 50,000\uc6d0 - \ud0dd\uc2dc\ube44 9,000\uc6d0 + \uc601\ud654\ud45c \ud658\ubd88\uae08 10,000\uc6d0 = 51,000\uc6d0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720 \ubb34\uc5ed \ud655\ub300\ub97c \ubaa9\ud45c\ub85c \uaddc\uc81c \uc644\ud654\ub97c \ucd94\uc9c4\ud558\ub294 \uad6d\uc81c\uae30\uad6c(WTO)\uc758 \ucd9c\ubc94\uc774 \uc138\uacc4 \ubb34\uc5ed \uaddc\ubaa8\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc744 \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc5ed\uc5d0 \ub300\ud55c \uad00\uc138 \ubc0f \ube44\uad00\uc138 \uaddc\uc81c\uac00 \uc644\ud654\ub418\uc5b4 \uad6d\uc81c \ubb34\uc5ed\uc758 \uaddc\ubaa8\uac00 \ud06c\uac8c \ud655\ub300\ub418\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720 \ubb34\uc5ed \ud611\uc815(FTA) \uccb4\uacb0\uc774 \uccb4\uacb0\uad6d \uac04\uc758 \uacbd\uc81c\uc801 \uad00\uacc4\uc5d0 \ubbf8\uce58\ub294 \uc8fc\uc694 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uac04 \uac70\ub798\uc5d0\uc11c \uad00\uc138 \ubc0f \ube44\uad00\uc138 \uc7a5\ubcbd\uc744 \uc644\ud654\ud558\uc5ec \uacbd\uc81c\uc801 \uc0c1\ud638 \uc758\uc874 \uad00\uacc4\ub97c \ub354\uc6b1 \uac15\ud654\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c \ube14\ub85d\uc758 \ud68c\uc6d0\uad6d\uacfc \ube44\ud68c\uc6d0\uad6d \uc0ac\uc774\uc5d0\uc11c \ub098\ud0c0\ub098\ub294 \ucc28\ubcc4\uc801 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud68c\uc6d0\uad6d \uac04\uc5d0\ub294 \uc5ec\ub7ec \uacbd\uc81c\uc801 \ud61c\ud0dd\uc744 \uc8fc\uace0\ubc1b\uc9c0\ub9cc, \ube44\ud68c\uc6d0\uad6d\uc5d0\ub294 \uc774\ub7ec\ud55c \ud61c\ud0dd\uc744 \uc81c\uacf5\ud558\uc9c0 \uc54a\ub294 \ubc30\ud0c0\uc131\uc744 \ub764\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc785 \ud560\ub2f9\uc81c\ub098 \uc218\ucd9c \ubcf4\uc870\uae08 \uc9c0\uae09\uc740 \ubb34\uc5ed \uc7a5\ubcbd \uc911 \uc5b4\ub514\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uad00\uc138 \uc7a5\ubcbd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \ubb34\uc5ed\uc774 \uc18c\ube44\uc790\uc640 \uc0dd\uc0b0\uc790\uc758 \uacbd\uc81c\ud65c\ub3d9 \ubc0f \uad6d\uac00 \uacbd\uc81c \uc804\ubc18\uc5d0 \ubbf8\uce58\ub294 \uae0d\uc815\uc801 \uc601\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790\uc758 \uc0c1\ud488 \uc120\ud0dd \ud3ed\uc744 \ub113\ud788\uace0, \uc0dd\uc0b0\uc790\uc758 \uc2dc\uc7a5\uc744 \ud655\ub300\ud558\uba70, \uad6d\uac00 \uc804\uccb4\uc758 \uacbd\uc81c \uc131\uc7a5\uc5d0 \uae30\uc5ec\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \uc800\ud574\ud558\ub294 \uad6d\uc81c \ubb34\uc5ed \ub0b4 \uacbd\uc7c1 \uc2ec\ud654\uc758 \uc8fc\uc694 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc7c1\uc5d0\uc11c \uc0b4\uc544\ub0a8\uae30 \uc704\ud574 \uc9c0\ub098\uce58\uac8c \ud6a8\uc728\uc131\ub9cc\uc744 \uc911\uc2dc\ud558\ub294 \uacfc\uc815"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd\uce5c\ud654\uc801\uc778 \uc0c1\ud488\uc744 \uac1c\ubc1c\u00b7\uc0dd\uc0b0\ud558\uace0 \uc774\ub97c \uad50\uc5ed\ud568\uc73c\ub85c\uc368 \ub3d9\uc2dc \ub2ec\uc131\ud560 \uc218 \uc788\ub294 2\uac00\uc9c0 \ubaa9\ud45c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0 \uc808\uc57d\uacfc \ud658\uacbd \ubcf4\ud638"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc774 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \uc704\ud55c \ud601\uc2e0\uc801 \uce5c\ud658\uacbd \uc81c\ud488 \uc0dd\uc0b0 \uae30\uc220\uc744 \ub3c5\uc790\uc801\uc73c\ub85c \uc774\ub8e9\ud558\uae30 \uc5b4\ub824\uc6b4 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc220\uc801\u00b7\uc790\ubcf8\uc801 \ud55c\uacc4\ub85c \uc778\ud574 \uc790\uccb4\uc801\uc778 \uae30\uc220 \uac1c\ubc1c \uc5ed\ub7c9\uc774 \ubd80\uc871\ud558\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70 \uc774\uc0b0\ud654 \ud0c4\uc18c \ubc30\ucd9c \uac10\ucd95\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d \uc9c0\uc6d0\uc744 \uc704\ud55c \uad6d\uc81c\uc801 \uc57d\uc18d\uc774 \uc131\uacfc\ub97c \uac70\ub450\uc9c0 \ubabb\ud55c \uac00\uc7a5 \ud070 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubd80 \uad6d\uac00\ub4e4\uc758 \ube44\ud611\uc870 \ubc0f \uc57d\uc18d \ubbf8\uc774\ud589"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \uc704\ud55c \uad6d\uc81c \ud611\uc815\uc774 \uc2e4\uc81c \uad6d\uc81c \ubb34\uc5ed\uc758 \uc9c0\uc18d\uac00\ub2a5\uc131\uc5d0 \uae30\uc5ec\ud558\uae30 \uc704\ud574 \ubc18\ub4dc\uc2dc \uc804\uc81c\ub418\uc5b4\uc57c \ud558\ub294 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc0ac\ud68c\uac00 \uccb4\uacb0\ud55c \ud611\uc815\uc744 \uc2e4\uc9c8\uc801\uc73c\ub85c \uc774\ud589\ud558\uace0 \uc900\uc218\ud558\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ubcf8\uc8fc\uc758 \uc5ed\uc0ac \uc911 '\uc815\ubd80\uc758 \uc801\uadf9\uc801\uc778 \uc2dc\uc7a5 \uac1c\uc785'\uc744 \uac15\uc870\ud55c \uc2dc\uae30\uc5d0 \ud574\ub2f9\ud558\ub294 \uc790\ubcf8\uc8fc\uc758 \uc720\ud615\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc815 \uc790\ubcf8\uc8fc\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80 \uac1c\uc785\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \uc790\uc728\uc801\uc778 \uc2dc\uc7a5 \uacbd\uc7c1\uacfc \uc815\ubd80 \uaddc\uc81c \uc644\ud654, \ubbfc\uc601\ud654 \ub4f1\uc744 \uac15\uc870\ud55c \uc790\ubcf8\uc8fc\uc758 \uc0ac\uc870\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc790\uc720\uc8fc\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790\uac00 \uc790\uc2e0\uc758 \uad8c\uc775\uc744 \ubcf4\ud638\ud558\uace0 \uc2dc\uc7a5\uc5d0 \uc601\ud5a5\ub825\uc744 \ud589\uc0ac\ud560 \uc218 \uc788\ub294 \uae30\ubcf8\uc801 \uad8c\ub9ac\ub97c \ub73b\ud558\ub294 \uc6a9\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790 \uc8fc\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9\uc790\uac00 \uae30\uc5c5\uac00\uc640\uc758 \uad00\uacc4\uc5d0\uc11c \uc815\ub2f9\ud55c \ub178\ub3d9 \uc870\uac74 \ubcf4\uc7a5\uacfc \uad8c\ub9ac \ud589\uc0ac\ub97c \uc704\ud574 \uac00\uc838\uc57c \ud560 \uae30\ubcf8 \uc758\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uac00\uc640\uc758 \uc0c1\ud638 \ub3d9\ubc18\uc790 \uc758\uc2dd (\uadfc\ub85c\uad8c \ubc0f \ub178\ub3d9 3\uad8c \ud589\uc0ac \ud3ec\ud568)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc774 \uc7ac\ubb34 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \ube44\uc6a9\uc744 \uc0b0\uc815\ud558\uace0 \uc800\ucd95 \ubc0f \ud22c\uc790 \uacc4\ud68d\uc744 \uc218\ub9bd\ud558\ub294 \uc77c\ub828\uc758 \uacfc\uc815\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae08\uc735 \uc0dd\ud65c \uc124\uacc4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uad50\uc801 \uc5ed\ud560\uc744 \uc218\ud589\ud558\ub294 \uad6d\uc81c \uad50\uc5ed \ud750\ub984 \uc18d\uc5d0\uc11c \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \ub2ec\uc131\ud558\uae30 \uc704\ud574 \uad6d\uc81c\uc0ac\ud68c\uac00 \ucde8\ud574\uc57c \ud560 \ucd5c\uc885\uc801 \ud544\uc218 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uac04 \uacf5\uc870\uc640 \uc774\ud589 \uc870\uce58\uac00 \uc218\ubc18\ub41c '\uad6d\uc81c \ud611\ub825 \uccb4\uc81c \uad6c\ucd95'"
          }
        ]
      }
    }
  ]
}