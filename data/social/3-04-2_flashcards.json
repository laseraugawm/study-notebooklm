      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d \uac04 \uacbd\uc81c\uc801 \ubd88\ud3c9\ub4f1 \uc2ec\ud654"
