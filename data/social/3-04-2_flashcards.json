      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4 (CBAM)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\ub7fd \uc5f0\ud569\uc758 \ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4(CBAM) \ub3c4\uc785 \ubc1c\ud45c\uc5d0 \ub300\ud574 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\ub4e4\uc774 \ubc18\ubc1c\ud558\uba70 \ube44\ud310\ud55c \ud575\uc2ec \uba85\ubd84\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
