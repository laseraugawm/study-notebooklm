      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9\uc790\uc758 \uad8c\ub9ac \ubc0f \uc801\uc815 \uc784\uae08 \ubcf4\uc7a5, \uac1c\ubc1c\ub3c4\uc0c1\uad6d \uc0dd\uc0b0\uc790\uc5d0 \ub300\ud55c \uc815\ub2f9\ud55c \ub300\uac00 \uc9c0\uae09"
