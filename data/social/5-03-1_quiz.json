    {
      "type": "multiple_choice",
      "question": "\ubbf8\ub798\uc758 \ub3c4\uc2dc \ud658\uacbd \ubc0f \uce5c\ud658\uacbd \uae30\uc220\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
