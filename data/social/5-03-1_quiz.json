    {
      "type": "multiple_choice",
      "question": "\ubbf8\ub798\uc758 \uc2dd\ub7c9 \ubc0f \uc5d0\ub108\uc9c0 \ubb38\uc81c\uc5d0 \ub300\ucc98\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \ud65c\uc6a9 \uc0ac\ub840\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2dd\ubb3c \uacf5\uc7a5\uc740 \uacc4\uc808\uacfc \uae30\ud6c4 \ub4f1 \uc678\ubd80 \ud658\uacbd\uc758 \uc601\ud5a5 \uc5c6\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uc2dd\ubb3c\uc744 \ub300\ub7c9 \uc0dd\uc0b0\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucd5c\ucca8\ub2e8 \uae30\uc220\uc774 \uc735\ud569\ub41c \uc790\ub3d9\ud654 \ub18d\uc5c5\uc744 \ud1b5\ud574 \uae30\ud6c4\uc5d0 \uad6c\uc560\ubc1b\uc9c0 \uc54a\uace0 \uc2dd\ub7c9\uc744 \uc548\uc815\uc801\uc73c\ub85c \uacf5\uae09\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
