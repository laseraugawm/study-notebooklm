        {
          "text": "\uc9c0\uad6c \uc628\ub09c\ud654\uac00 \uc644\ud654\ub418\uba74\uc11c \uc5f4\ub300\ub9bc \ud30c\uad34 \ubc0f \uc0ac\ub9c9\ud654 \uc18d\ub3c4\uac00 \ub300\ud3ed \uc904\uc5b4\ub4e4 \uac83\uc73c\ub85c \uc608\uc0c1\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\ud6c4\ubcc0\ud654, \uc5f4\ub300\ub9bc \ud30c\uad34, \uc0ac\ub9c9\ud654 \uc18d\ub3c4\uac00 \uc624\ud788\ub824 \ube68\ub77c\uc838 \uc0dd\ubb3c\uccb4\uc758 \uc0dd\uc874\uc744 \uc704\ud611\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud658\uacbd \uc624\uc5fc\uc744 \uc904\uc774\uae30 \uc704\ud574 \uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0\uc758 \uc0ac\uc6a9\uc744 \ucd95\uc18c\ud558\uace0 \uae30\uc874 \ud654\uc11d \uc5f0\ub8cc\ub85c \uc804\ud658\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud658\uacbd \uc624\uc5fc \uac1c\uc120\uc744 \uc704\ud574 \uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uc0ac\uc6a9\uc744 \ub298\ub9ac\uace0 \uce5c\ud658\uacbd \uad50\ud1b5\uc218\ub2e8\uc744 \uac1c\ubc1c\ud574\uc57c \ud569\ub2c8\ub2e4."
