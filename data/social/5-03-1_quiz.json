        {
          "text": "\uc5d0\ub108\uc9c0 \uc2a4\ud1a0\ub9ac\uc9c0\ub294 \uc624\uc9c1 \ub300\uaddc\ubaa8 \ud654\uc11d \uc5f0\ub8cc \ubc1c\uc804\uc18c\uc5d0\uc11c\ub9cc \uc124\uce58\ud560 \uc218 \uc788\ub294 \ud2b9\uc218 \uc7a5\uce58\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uc758 \uc9d1\uc774\ub098 \uac74\ubb3c\uc5d0\uc11c\ub3c4 \ud0dc\uc591\uad11\u00b7\ud48d\ub825 \uc2dc\uc124\uacfc \uc5f0\uacc4\ud558\uc5ec \uc5d0\ub108\uc9c0 \uc2a4\ud1a0\ub9ac\uc9c0\uc758 \ud65c\uc6a9\uc774 \ud655\ub300\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
