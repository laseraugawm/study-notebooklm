      "question": "\ubbf8\ub798 \uc0ac\ud68c\uc758 \uc0dd\ud0dc\ud658\uacbd \ubcc0\ud654 \uc608\uce21\uacfc \uc774\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud55c \uacfc\ud559\uae30\uc220\uc758 \ud65c\uc6a9 \ubc29\uc548\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uacfc\ud559\uae30\uc220\uc744 \ud65c\uc6a9\ud558\uc5ec \uba78\uc885 \uc704\uae30\uc5d0 \ucc98\ud588\uac70\ub098 \uc0ac\ub77c\uc9c4 \uc0dd\ubb3c\uc885\uc744 \ubcf5\uc6d0\ud558\ub294 \uc0ac\uc5c5\uc744 \uc9c4\ud589\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
