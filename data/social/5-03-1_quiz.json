{
  "title": "\ubbf8\ub798\uc0ac\ud68c \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ubbf8\ub798 \uc0ac\ud68c \uc608\uce21\uc758 \ud544\uc694\uc131\uacfc \uc8fc\uccb4\ubcc4 \ub300\uc751 \ubc29\uc548\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uae30\uc5c5\uc740 \uc138\uacc4 \uc2dc\uc7a5\uc758 \ubcc0\ud654\ub97c \uc608\uce21\ud558\uc5ec \uc704\uae30\uad00\ub9ac \uc804\ub7b5\uc744 \uc138\uc6b0\uace0 \ubbf8\ub798\uc758 \uae30\ud68c\ub97c \uc801\uadf9 \ud65c\uc6a9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uae30\uc5c5\uc740 \uc138\uacc4 \uc2dc\uc7a5 \uc608\uce21\uc744 \ud1b5\ud574 \uae09\uaca9\ud55c \ubcc0\ud654\ub098 \uacbd\uc81c \uc704\uae30\uc5d0 \ub300\ucc98\ud558\uace0 \uc131\uc7a5\uc758 \uae30\ud68c\ub97c \uc120\uc810\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80\ub294 \uc2dc\uc7a5 \ubcc0\ud654\ub97c \uc608\uce21\ud558\uc5ec \uac1c\ubcc4 \uae30\uc5c5\uc758 \uc704\uae30\uad00\ub9ac \uc804\ub7b5\uc744 \uc9c1\uc811 \uc791\uc131\ud574 \uc900\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ubd80\ub294 \ubbf8\ub798 \ud658\uacbd \ubcc0\ud654\uc5d0 \ub9de\ucdb0 \uc5d0\ub108\uc9c0 \uc815\ucc45\uc774\ub098 \ud658\uacbd \ubcf4\ud638 \ub300\ucc45\uc744 \uc218\ub9bd\ud558\uc5ec \uc2dc\ubbfc\uc758 \uc548\uc804\uc744 \uc9c0\ud0a4\ub294 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc740 \uc778\uacf5\uc9c0\ub2a5 \uae30\uc220\uc758 \ubc1c\uc804 \uc18d\uc5d0\uc11c\ub3c4 \uae30\uc874\uc758 \uc804\ud1b5 \uc9c1\uc5c5\ub9cc\uc744 \uace0\uc218\ud558\ub294 \uad50\uc721\uc744 \ubc1b\uc544\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uc740 \uae30\uc220 \ubc1c\uc804\uc744 \ub0b4\ub2e4\ubcf4\uba70 \uc0c8\ub85c \uc0dd\uae38 \uc9c1\uc5c5\uc774\ub098 \uc720\ub9dd \uc9c1\uc5c5\uc5d0 \ub9de\ucdb0 \uc804\ubb38\uc131\uc744 \uae30\ub974\uace0 \uc900\ube44\ud574\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubbf8\ub798 \uc0ac\ud68c \uc608\uce21\uc740 \ubbf8\ub798\ub97c 100% \uc815\ud655\ud558\uac8c \ud655\uc815\ud558\uace0 \ud1b5\uc81c\ud558\uae30 \uc704\ud574 \uc218\ud589\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubbf8\ub798\ub97c \uc644\ubcbd\ud558\uac8c \uc608\uce21\ud558\ub294 \uac83\uc740 \ubd88\uac00\ub2a5\ud558\uba70, \ubd88\ud655\uc2e4\ud55c \ubbf8\ub798\uc5d0 \uc720\uc5f0\ud558\uac8c \ub300\uc751\ud558\uace0 \uc704\ud5d8\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \uac83\uc774 \uc608\uce21\uc758 \ubaa9\uc801\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac01 \uc8fc\uccb4(\uc815\ubd80, \uae30\uc5c5, \uac1c\uc778)\uac00 \ubbf8\ub798 \uc608\uce21\uc744 \ud1b5\ud574 \uc5b4\ub5a0\ud55c \uc774\uc810\uc744 \uc5bb\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ubbf8\ub798\ud559(Futures Studies)\uc758 \ud2b9\uc9d5\uacfc \ubbf8\ub798 \uc5f0\uad6c\ub97c \ub300\ud558\ub294 \ud0dc\ub3c4\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uacfc\uac70\uc640 \ud604\uc7ac\uc758 \uc0ac\ud68c \ubcc0\ub3d9 \uc591\uc0c1\uc744 \ubd84\uc11d\ud558\uc5ec \ubbf8\ub798 \uc0ac\ud68c\uc758 \ubaa8\ub378\uc744 \uc81c\uacf5\ud558\ub294 \ud559\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubbf8\ub798\ud559\uc740 \ucd95\uc801\ub41c \uacfc\uac70 \ubc0f \ud604\uc7ac\uc758 \uc0c1\ud669\uc744 \ubc14\ud0d5\uc73c\ub85c \ub2e4\uac00\uc62c \uc0ac\ud68c \ubcc0\ud654\ub97c \uc608\uce21\ud558\uace0 \uadf8\ub824 \ub0b4\ub294 \ud559\ubb38\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubbf8\ub798 \uc0ac\ud68c\ub294 \uacb0\uc815\ub418\uc5b4 \uc788\uc73c\ubbc0\ub85c \uc804\ubb38\uac00\uc758 \uc608\uce21 \uacb0\uacfc\ub97c \ubb34\uc870\uac74\uc801\uc73c\ub85c \uc218\uc6a9\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubbf8\ub798 \uc0ac\ud68c\ub294 \uc870\uac74\uacfc \uc804\uac1c \uc0c1\ud669\uc5d0 \ub530\ub77c \ubcc0\ud558\ubbc0\ub85c \ubb34\uc870\uac74 \uc218\uc6a9\ud558\uae30\ubcf4\ub2e4 \uc720\uc5f0\ud558\uac8c \ub300\uc751\ud574\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ucca8\ub2e8 \uacfc\ud559\uae30\uc220\uc758 \ubc1c\uc804\uc73c\ub85c \ubbf8\ub798 \uc0ac\ud68c\uc5d0 \ub300\ud55c \uc644\ubcbd\ud558\uace0 \uc624\ucc28 \uc5c6\ub294 \uc608\uce21\uc774 \uac00\ub2a5\ud574\uc84c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubbf8\ub798\uc758 \ubd88\ud655\uc2e4\uc131\uc774 \ub192\uae30 \ub54c\ubb38\uc5d0 \ubbf8\ub798\ub97c \uc644\uc804\ud558\uac8c \uc815\ud655\ud788 \uc608\uce21\ud558\ub294 \uac83\uc740 \ubd88\uac00\ub2a5\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubbf8\ub798\ud559\uc790\ub4e4\uc740 \uacfc\uac70 \ub370\uc774\ud130 \ubd84\uc11d\uc744 \ubc30\uc81c\ud558\uace0 \uc21c\uc218\ud55c \uc9c1\uad00\uc5d0 \uc758\ud574\uc11c\ub9cc \uc608\uce21\uc744 \uc218\ud589\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubbf8\ub798\ud559\uc790\ub4e4\uc740 \uacfc\uac70\uc640 \ud604\uc7ac\uc758 \uc0ac\ud68c \ubcc0\ub3d9 \uc591\uc0c1\uc744 \uc815\ubc00\ud558\uac8c \ubd84\uc11d\ud558\uc5ec \uc608\uce21\uc744 \uc9c4\ud589\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubbf8\ub798\ud559\uc774 \ubd84\uc11d\uc5d0 \uc0ac\uc6a9\ud558\ub294 \uc790\ub8cc\uc640 \uc608\uce21 \uacb0\uacfc\uc758 \uac00\ubcc0\uc131\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "'\uc2a4\ubc1c\ubc14\ub974 \uad6d\uc81c \uc885\uc790 \uc800\uc7a5\uace0'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc5f0\uc7ac\ud574, \ud575 \uc804\uc7c1, \ud14c\ub7ec \ub4f1 \uc608\uce21\ud560 \uc218 \uc5c6\ub294 \ubbf8\ub798 \uc704\ud5d8\uc5d0 \ub300\ube44\ud574 \uc2dd\ub7c9 \uc885\uc790\ub97c \ubcf4\uc874\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc608\uce21 \ubd88\uac00\ub2a5\ud55c \ubbf8\ub798\uc758 \uadf9\ub2e8\uc801\uc778 \ube44\uc0c1 \uc0c1\ud669\uc5d0\uc11c \uc778\ub958\uc758 \uc2dd\ub7c9\uc744 \uc9c0\ud0a4\uae30 \uc704\ud55c \ubc29\uc8fc \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc804\uae30\uac00 \ub04a\uae30\uba74 \uc989\uc2dc \ub0c9\ub3d9 \uae30\ub2a5\uc774 \uc815\uc9c0\ub418\ubbc0\ub85c \ube44\uc0c1 \ubc1c\uc804\uae30\uc5d0\ub9cc \uc758\uc874\ud558\ub294 \uad6c\uc870\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804\ub825\uc774 \ub04a\uaca8\ub3c4 \uc528\uc557\uc774 \ucd5c\ub300 200\ub144 \ub3d9\uc548 \uc790\uc5f0 \ub0c9\ub3d9 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc0c1 120m \ub192\uc774\uc5d0 \uc704\uce58\ud55c \uad6c\uc870\ubb3c\ub85c \ud574\uc218\uba74 \uc0c1\uc2b9 \ud53c\ud574\ub97c \ubc29\uc9c0\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uc0c1\uc774 \uc544\ub2c8\ub77c \uc9c0\ud558 120m \uae4a\uc774\uc5d0 \uc704\uce58\ud558\uc5ec \uc9c0\uc9c4\uc774\ub098 \ud575\ud3ed\ubc1c\uc5d0\ub3c4 \uacac\ub51c \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc720\uc804\uc790 \ubcc0\ud615 \uae30\uc220\uc744 \ud65c\uc6a9\ud558\uc5ec \uc2e0\uc885 \uc0c1\uc5c5\uc6a9 \uace1\ubb3c\uc744 \ub300\ub7c9 \uc0dd\uc0b0\ud558\ub294 \uac83\uc744 \ubaa9\uc801\uc73c\ub85c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e0\uc885 \uace1\ubb3c \ub300\ub7c9 \uc0dd\uc0b0\uc774 \uc544\ub2cc, \uae30\uc874 \uc2dd\ubb3c \uc885\uc790\uc758 \ubcf4\uc874\uc744 \ubaa9\uc801\uc73c\ub85c \uc124\ub9bd\ub41c \uc2dc\uc124\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc2dc\uc124\uc758 \uc704\uce58\uc801 \ud2b9\uc9d5\uacfc \uc785\uc9c0 \ubc30\uacbd, \uadf8\ub9ac\uace0 \uc804\ub825\uc774 \ub04a\uacbc\uc744 \ub54c\uc758 \uc791\ub3d9 \ubc29\uc2dd\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ubbf8\ub798 \uc0ac\ud68c\uc758 \uc815\uce58\uc801\u00b7\uacbd\uc81c\uc801 \ubcc0\ud654 \uc591\uc0c1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uac00 \uac04 \uacbd\uc81c\uc801 \uac08\ub4f1\uc744 \ud574\uacb0\ud558\uace0 \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc774\ub8e8\uae30 \uc704\ud55c \uad6d\uc81c\uc801 \ud611\ub825\uc774 \uac15\ud654\ub420 \uac83\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac08\ub4f1 \uc2ec\ud654\uc5d0 \ub300\uc751\ud558\uc5ec \uad6d\uac00 \uac04 \ud611\uc815\uacfc \uc870\uc57d\uc744 \uccb4\uacb0\ud558\uace0 \ub2e4\uc591\ud55c \ud611\ub825 \ud504\ub85c\uadf8\ub7a8\uc744 \ub9c8\ub828\ud558\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc720 \ubb34\uc5ed\uc758 \ud655\ub300\ub85c \ubaa8\ub4e0 \uad6d\uac00\uac00 \uade0\ub4f1\ud558\uac8c \ubd80\ub97c \ubd84\ubc30\ubc1b\uc544 \ube48\ubd80 \uaca9\ucc28\uac00 \uac10\uc18c\ud560 \uac83\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\uc218 \uad6d\uac00\uac00 \uacbd\uc81c\ub97c \ub3c5\uc810\ud558\uba74\uc11c \uad6d\uac00 \uac04 \ube48\ubd80 \uaca9\ucc28\uac00 \uc624\ud788\ub824 \ucee4\uc9c8 \uac83\uc73c\ub85c \uc608\uce21\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ubb34\uc5ed \uacbd\uc7c1\uc73c\ub85c \ubc1c\uc0dd\ud55c \uacbd\uc81c\uc801 \uac08\ub4f1\uc740 \uc815\uce58\uc801\u00b7\ubb38\ud654\uc801 \uac08\ub4f1\uc73c\ub85c \ud655\ub300\ub418\uc9c0 \uc54a\uace0 \ucc28\ub2e8\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacbd\uc81c\uc801 \uac08\ub4f1\uc774 \uc815\uce58\uc801 \uac08\ub4f1\uc73c\ub85c \ubc88\uc9c0\uba74\uc11c \uc601\ud1a0 \ubd84\uc7c1\uacfc \ubb38\ud654\uc801 \uac08\ub4f1\uc774 \uc2ec\ud574\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uce58\uc5f4\ud55c \ubb34\uc5ed \uacbd\uc7c1\uc73c\ub85c \uc778\ud574 \uad6d\uac00 \uac04\uc758 \uc678\uad50\uc801 \uc870\uc57d \uccb4\uacb0 \ubc0f \ud611\ub825 \uad00\uacc4\uac00 \uc804\uba74 \uc911\ub2e8\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac08\ub4f1\uc744 \uc608\ubc29\ud558\uace0 \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc678\uad50\uc801 \ud611\uc815\uacfc \uc870\uc57d \uccb4\uacb0 \ub4f1 \uad6d\uac00 \uac04 \ud611\ub825\uc774 \ub354 \uac15\ud654\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac08\ub4f1\uc758 \uc2ec\ud654 \uce21\uba74\uacfc \ud568\uaed8 \uc774\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud55c \uad6d\uc81c\uc0ac\ud68c\uc758 \ub178\ub825 \uce21\uba74\uc744 \ud568\uaed8 \uace0\ub824\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uacfc\ud559\uae30\uc220\uc758 \ubc1c\uc804\uc5d0 \ub530\ub77c \ub098\ud0c0\ub0a0 \uc218 \uc788\ub294 \ubd80\uc815\uc801 \uc601\ud5a5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc778\uacf5\uc9c0\ub2a5\uc744 \ud559\uc2b5\uc2dc\ud0a4\ub294 \ub370\uc774\ud130\uc5d0 \uc0ac\ub78c\uc774\ub098 \uc0ac\ud68c\uc758 \ud3b8\uacac\uc774 \ubc18\uc601\ub418\uc5b4 \ub370\uc774\ud130 \ud3b8\ud5a5\uc131\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud559\uc2b5 \ub370\uc774\ud130 \uc790\uccb4\uc5d0 \uc0ac\ud68c\uc801 \ud3b8\uacac\uc774 \ud3ec\ud568\ub420 \uacbd\uc6b0 \uc778\uacf5\uc9c0\ub2a5\uc774 \ud3b8\ud5a5\ub41c \uacb0\uacfc\ub97c \ub3c4\ucd9c\ud558\ub294 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uad50\ud1b5 \ubc0f \uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220\uc758 \ubc1c\uc804\uc73c\ub85c \uc778\uac04\uc758 \ud65c\ub3d9 \ubc94\uc704\uac00 \uc2ec\uac01\ud558\uac8c \ucd95\uc18c\ub420 \uac83\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\uac04\uacfc \uacf5\uac04\uc758 \uc81c\uc57d\uc774 \uc904\uc5b4\ub4e4\uba74\uc11c \uc0ac\ub78c\ub4e4\uc758 \ud65c\ub3d9 \ubc94\uc704\ub294 \uc624\ud788\ub824 \ud655\ub300\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uba85 \uacf5\ud559\uc758 \ubc1c\ub2ec\ub85c \uc720\uc804\uc790 \uce58\ub8cc\uac00 \uc77c\ubc18\ud654\ub418\uba74\uc11c \uc724\ub9ac\uc801 \ud63c\ub780\uc774\ub098 \ub3c4\ub355\uc801 \uac00\uce58 \uac08\ub4f1\uc774 \uc18c\uba78\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\uba85 \ubcf5\uc81c\ub098 \uc720\uc804\uc790 \uce58\ub8cc \ub4f1\uc740 \uc778\uac04\uc758 \uc815\uccb4\uc131\uacfc \ub3c4\ub355\uc801 \uac00\uce58\uc5d0 \ud63c\ub780\uc744 \uac00\uc838\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220\uc758 \uace0\ub3c4\ud654\ub85c \uc0ac\ud68c \uad6c\uc131\uc6d0 \uac04\uc758 \uc815\ubcf4 \uaca9\ucc28\uc640 \uc778\ud130\ub137 \uc911\ub3c5 \ubb38\uc81c\uac00 \uc644\uc804\ud788 \ud574\uacb0\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ubcf4 \ud1b5\uc2e0\uc758 \ubc1c\ub2ec\ub85c \uc815\ubcf4 \uaca9\ucc28, \uc778\ud130\ub137 \uc911\ub3c5, \uc804\uc790 \uac10\uc2dc \ub4f1\uc758 \ubb38\uc81c\uac00 \uc2ec\uac01\ud574\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc778\uacf5\uc9c0\ub2a5 \uc54c\uace0\ub9ac\uc998\uc774 \ud559\uc2b5\ud558\ub294 \uae30\ucd08 \uc790\ub8cc\uc758 \ud2b9\uc131\uacfc \uc5f0\uad00\ub41c \ubd80\uc791\uc6a9\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uad6d\uac00\ub098 \uae30\uc5c5 \ub4f1\uc758 \uac10\uc2dc\uc790\uac00 \ucd95\uc801\ub41c \ub370\uc774\ud130\ub97c \ud65c\uc6a9\ud558\uc5ec \uac1c\uac1c\uc778\uc758 \ud589\ub3d9\uc774\ub098 \uc0dd\uac01\uc744 \uac10\uc2dc\ud558\ub294 \ud604\uc0c1\uc744 \ub73b\ud558\ub294 \uc6a9\uc5b4\ub294?",
      "answerOptions": [
        {
          "text": "\uc804\uc790 \uac10\uc2dc",
          "isCorrect": true,
          "rationale": "\uc77c\uc815 \uae30\uac04 \ucd95\uc801\ub41c \ub370\uc774\ud130\ubca0\uc774\uc2a4\ub97c \ud65c\uc6a9\ud558\uc5ec \uac1c\uc778\uc758 \uc0dd\uac01\uacfc \ud589\ub3d9\uc744 \ud1b5\uc81c\u00b7\uac10\ub3c5\ud558\ub294 \ud604\uc0c1\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub370\uc774\ud130 \ud3b8\ud5a5\uc131",
          "isCorrect": false,
          "rationale": "\uae30\uacc4\ub098 AI \ud559\uc2b5\uc6a9 \ub370\uc774\ud130\uc5d0 \uc0ac\ub78c\uc774\ub098 \uc0ac\ud68c\uc758 \ud3b8\uacac\uc774 \ub4e4\uc5b4\uac00\ub294 \uac83\uc744 \ub73b\ud569\ub2c8\ub2e4."
