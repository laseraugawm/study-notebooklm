        {
          "text": "\uc5d0\ub108\uc9c0 \uc2a4\ud1a0\ub9ac\uc9c0\ub294 \ud0dc\uc591\uad11\uc774\ub098 \ud48d\ub825\uc73c\ub85c \uc0dd\uc131\ub41c \uc5ec\ubd84\uc758 \uc804\ub825\uc744 \ubc84\ub9bc\uc73c\ub85c\uc368 \uc790\uc6d0\uc744 \uc808\uc57d\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5d0\ub108\uc9c0 \uc2a4\ud1a0\ub9ac\uc9c0\ub294 \uc0dd\uc0b0\ub41c \uc5d0\ub108\uc9c0\ub97c \ubc84\ub9ac\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc800\uc7a5\ud558\uc5ec \ub0ad\ube44\ub97c \uc904\uc774\ub294 \uc2dc\uc124\uc785\ub2c8\ub2e4."
