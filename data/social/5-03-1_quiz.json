        },
        {
          "text": "\uc778\uad6c \uc99d\uac00\uc640 \uacbd\uc81c \uc131\uc7a5\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \uc9c0\uad6c\uc758 \uc790\uc815 \ub2a5\ub825 \ub355\ubd84\uc5d0 \ud658\uacbd \uc624\uc5fc\uc740 \uc790\uc5f0 \uac10\uc18c\ud560 \uac83\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc6d0 \uc18c\ube44\uac00 \ub298\uc5b4 \uc9c0\uad6c\uc758 \uc790\uc815 \ub2a5\ub825\uc744 \ub118\uc5b4\uc11c\ub294 \uc2ec\uac01\ud55c \ud658\uacbd \uc624\uc5fc\uc774 \ub098\ud0c0\ub0a0 \uac83\uc73c\ub85c \uc608\uce21\ub429\ub2c8\ub2e4."
