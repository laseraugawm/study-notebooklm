        {
          "text": "\uc2dd\ubb3c \uacf5\uc7a5\uc758 \ub3c4\uc785\uc740 \uacc4\uc808 \ubcc0\ud654\uc5d0 \ub530\ub978 \ub18d\uc791\ubb3c \uc0dd\uc0b0\ub7c9\uc758 \ubcc0\ub3d9 \ud3ed\uc744 \uadf9\ub300\ud654\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dd\ubb3c \uacf5\uc7a5\uc740 \uc678\ubd80 \ud658\uacbd\uc758 \uc601\ud5a5 \uc5c6\uc774 continuous\ud558\uace0 \uc548\uc815\uc801\uc778 \uc2dd\ubb3c \uc0dd\uc0b0\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4."
