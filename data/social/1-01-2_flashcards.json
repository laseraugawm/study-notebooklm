    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\uc7ac\ud574\ubfd0\ub9cc \uc544\ub2c8\ub77c \uacfc\ud559\uae30\uc220 \ubc1c\uc804\uc5d0 \ub530\ub978 \uc778\uc704\uc801 \uc704\ud5d8 \ub4f1 \uac01\uc885 \uc704\ud5d8\uc73c\ub85c\ubd80\ud130 \uc548\uc804\uc744 \ubcf4\ud638\ubc1b\uc744 \uad8c\ub9ac\ub294?"
