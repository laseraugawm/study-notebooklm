    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c\uc740 \ud2b9\uc815 \uacc4\uce35\uc5d0\ub9cc \uc801\uc6a9\ub418\ub294\uac00, \uc544\ub2c8\uba74 \ub204\uad6c\uc5d0\uac8c\ub098 \ubcf4\uc7a5\ub418\ub294\uac00?"
