    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "3\uc138\ub300 \uc778\uad8c(\uc5f0\ub300\uad8c)\uc5d0 \uc18d\ud558\ub294 \ub300\ud45c\uc801\uc778 \uad8c\ub9ac\ub4e4\uc744 \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uacb0\uad8c, \ubc1c\uc804\uc758 \uad8c\ub9ac, \ud3c9\ud654\uc758 \uad8c\ub9ac, \uc7ac\ub09c\uc73c\ub85c\ubd80\ud130 \uad6c\uc81c\ubc1b\uc744 \uad8c\ub9ac, \uc9c0\uc18d\uac00\ub2a5\ud55c \ud658\uacbd\uc5d0 \ub300\ud55c \uad8c\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \ubbfc\uc871\uc774\ub098 \uc9d1\ub2e8\uc774 \uc790\uc2e0\ub4e4\uc758 \uc77c\uc744 \uc2a4\uc2a4\ub85c \ud574\uacb0\ud558\uace0 \uacb0\uc815\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
