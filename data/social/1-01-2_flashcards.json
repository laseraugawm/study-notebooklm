    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c\uc5d0\uc11c \uad6d\ubbfc\uc758 \uc8fc\uac70\uad8c\uc744 \uba85\uc2dc\ud558\uace0 \uc8fc\uac70 \ud658\uacbd \uc815\ube44 \ubc0f \uc8fc\uac70\ube44 \ubd80\ub2f4 \uac10\ucd95\uc744 \uc704\ud574 \uc81c\uc815\ud55c \ubc95\ub960\uc740?"
