    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \ubc00\ub3c4\uac00 \ub192\uc740 \ub3c4\uc2dc \uc9c0\uc5ed\uc5d0\uc11c \uc7ac\ud574\ub098 \uc804\uc5fc\ubcd1, \ubc94\uc8c4 \ub4f1\uc758 \ubc1c\uc0dd \uc2dc \uc548\uc804\uad8c \uce68\ud574 \uc704\ud5d8\uc774 \ud070 \uc774\uc720\ub294?"
