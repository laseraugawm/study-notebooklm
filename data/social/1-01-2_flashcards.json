    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\ub2ec \ub9c8\uc9c0\ub9c9 \uc218\uc694\uc77c\uc774 \ud3ec\ud568\ub41c \uc8fc\uac04\uc5d0 \uc601\ud654\uad00, \ubc15\ubb3c\uad00 \ub4f1\uc5d0\uc11c \ud560\uc778\uc774\ub098 \ubb34\ub8cc \uad00\ub78c \ud61c\ud0dd\uc744 \uc81c\uacf5\ud558\ub294 \uc81c\ub3c4\uc758 \uba85\uce6d\uacfc \uad00\ub828 \uc778\uad8c\uc740?"
