    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ud130\ub137\uc0c1\uc5d0\uc11c \uac1c\uc778\uc774 \uc790\uc2e0\uacfc \uad00\ub828\ub41c \uac01\uc885 \uc815\ubcf4\uc758 \uc18c\uc720\uad8c\uc744 \uac15\ud654\ud558\uace0, \uc218\uc815\uc774\ub098 \uc601\uad6c\uc801\uc778 \uc0ad\uc81c\ub97c \uc694\uccad\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\ub294?"
