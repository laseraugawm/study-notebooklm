    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub298\ub0a0 \uc815\ubcf4 \uc0ac\ud68c\ub85c \uc9c4\uc804\ub428\uc5d0 \ub530\ub77c \uc911\uc694\ud558\uac8c \ubd80\uac01\ub41c \ub300\ud45c\uc801\uc778 \uc815\ubcf4 \uad00\ub828 \uad8c\ub9ac 3\uac00\uc9c0\ub294?"
