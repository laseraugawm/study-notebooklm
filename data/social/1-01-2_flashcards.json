        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub300\uad8c\uc744 \uc2e4\ud604\ud558\uae30 \uc704\ud574 \ubbfc\uc871 \ubc0f \uad6d\uac00 \uac04\uc5d0 \ud544\uc218\uc801\uc73c\ub85c \uc694\uad6c\ub418\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
