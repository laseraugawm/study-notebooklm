    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc218\ub3c4\uad8c \uc9c0\uc5ed\uc5d0 \uacf5\uc5f0\uc774\ub098 \uc804\uc2dc \ub4f1\uc758 \ubb38\ud654 \uae30\ubc18 \uc2dc\uc124 \ud655\ucda9\uc744 \uc694\uad6c\ud558\ub294 \ubaa9\uc18c\ub9ac\ub294 \uc5b4\ub5a4 \uc778\uad8c\uacfc \uad00\ub828\ub418\ub294\uac00?"
