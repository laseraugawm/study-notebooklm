    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3ed\uc6b0\ub85c \ud558\uc218\uad00 \ub69c\uaed1\uc774 \uc5f4\ub824 \uc548\uc804\uc0ac\uace0\uac00 \ubc1c\uc0dd\ud558\uac70\ub098 \ubc94\uc8c4 \uc704\ud5d8\uc774 \ucee4\uc9c0\ub294 \ud604\uc0c1\uc740 \uc5b4\ub5a4 \uc778\uad8c\uc758 \ubcf4\uc7a5 \ud544\uc694\uc131\uc744 \ubcf4\uc5ec\uc8fc\ub294\uac00?"
