    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2\uc138\ub300 \uc778\uad8c(\uc0ac\ud68c\uad8c)\uc5d0 \uc18d\ud558\ub294 \ub300\ud45c\uc801\uc778 \uad8c\ub9ac\ub4e4\uc744 \uc4f0\uc2dc\uc624."
