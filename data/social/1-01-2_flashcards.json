    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubd80 \uc9c0\ubc29 \uc790\uce58 \ub2e8\uccb4\uc5d0\uc11c \uc2ec\uc57c \uc2dc\uac04\uc5d0 \uc2dc\ubbfc\ub4e4\uc758 \uc548\uc804\ud55c \uadc0\uac00\ub97c \ub3d5\uae30 \uc704\ud574 \uc6b4\uc6a9\ud558\ub294 \uc548\uc2ec \uadc0\uac00 \uc2a4\uce74\uc6b0\ud2b8 \uc81c\ub3c4\ub294 \uc5b4\ub5a4 \uc778\uad8c\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud568\uc778\uac00?"
