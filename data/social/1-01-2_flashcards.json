      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c\uac00 \ubc00\uc9d1\ub418\uc5b4 \ud53c\ud574\uac00 \ud06c\uace0, \ub2e4\uc591\ud55c \uc0ac\ub78c\uc774 \ubaa8\uc5ec \uc0b4\uc544 \uac08\ub4f1\uc774\ub098 \ubc94\uc8c4 \ubc1c\uc0dd \uac00\ub2a5\uc131\uc774 \ub192\uae30 \ub54c\ubb38"
