        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c\uc758 \uad8c\ub9ac, \uad50\uc721\uc5d0 \ub300\ud55c \uad8c\ub9ac, \uc0ac\ud68c \ubcf4\uc7a5\uc744 \ubc1b\uc744 \uad8c\ub9ac, \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c\uc744 \ud560 \uad8c\ub9ac, \ucf8c\uc801\ud55c \ud658\uacbd\uc5d0\uc11c \uc0dd\ud65c\ud560 \uad8c\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ub810 \ubc14\uc791\uc758 \uad6c\ubd84 \uc911 3\uc138\ub300 \uc778\uad8c\uc758 \uba85\uce6d\uacfc \ud575\uc2ec \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub300\uad8c(\ub610\ub294 \uc9d1\ub2e8\uad8c) \u2014 \uad6d\uac00\uc640 \uac1c\uc778\uc758 \uad00\uacc4\ub97c \ub118\uc5b4\uc120 \uc804 \uc9c0\uad6c\uc801 \ucc28\uc6d0\uc758 \uc9d1\ub2e8\uc801 \uad8c\ub9ac"
