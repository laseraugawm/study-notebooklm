    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uac70\uad8c\uc774 \uc2e4\uc9c8\uc801\uc73c\ub85c \ubcf4\uc7a5\ub418\uae30 \uc704\ud574 \uac16\ucd94\uc5b4\uc838\uc57c \ud560 \ub300\ud45c\uc801\uc778 \uc0dd\ud65c \uc870\uac74 3\uac00\uc9c0\ub294?"
