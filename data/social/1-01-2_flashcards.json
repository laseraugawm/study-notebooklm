{
  "title": "\uc778\uad8c \ud50c\ub798\uc2dc\uce74\ub514",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbfc\uc871\uc774\ub098 \uc9d1\ub2e8 \ucc28\uc6d0\uc5d0\uc11c \uc804 \uc138\uacc4\uc801\uc778 \ud658\uacbd \ubb38\uc81c\ub098 \ube48\ubd80 \uaca9\ucc28 \ubb38\uc81c\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud574 \uad6d\uc81c\uc801 \ud611\ub825\uc744 \uac15\uc870\ud558\ub294 \uad8c\ub9ac\ub294?"
