      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc0dd\ud65c \ubcf4\uc7a5, \uc801\uc808\ud55c \uc870\uba85\uacfc \ud1b5\ud48d, \uae30\ubcf8 \uc2dc\uc124\uc744 \uc774\uc6a9\ud558\uae30\uc5d0 \ud3b8\ub9ac\ud55c \uc704\uce58"
