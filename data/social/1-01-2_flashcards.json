        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1960\ub144\ub300 \uc774\ud6c4 \uc6b0\ub9ac\ub098\ub77c\uc5d0\uc11c \uce35\uac04 \uc18c\uc74c, \uc77c\uc870\uad8c \ubb38\uc81c, \uae30\ubc18 \uc2dc\uc124 \ubd80\uc871 \ub4f1\uc758 \uc8fc\uac70 \ubb38\uc81c\uac00 \ubcf8\uaca9\uc801\uc73c\ub85c \ubc1c\uc0dd\ud55c \uc0ac\ud68c\uc801 \ubc30\uacbd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae09\uaca9\ud55c \uc0b0\uc5c5\ud654\uc640 \ub3c4\uc2dc\ud654\ub85c \uc778\ud55c \uc218\ub3c4\uad8c \uc778\uad6c \ubc00\uc9d1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub791\uc2a4 \ubc95\ud559\uc790 \uce74\ub810 \ubc14\uc791(Vasak, K.)\uc774 \uad6c\ubd84\ud55c 1\uc138\ub300 \uc778\uad8c\uc758 \uba85\uce6d\uacfc \ud575\uc2ec \uac00\uce58\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uad8c (\uac1c\uc778\uc758 \uc790\uc720 \ucd5c\uc6b0\uc120 \ubcf4\uc7a5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc73c\ub85c \ud655\ub9bd\ub41c 1\uc138\ub300 \uc778\uad8c(\uc790\uc720\uad8c)\uc5d0\uc11c \uad6d\uac00\uc758 \uc5ed\ud560\uc5d0 \ub300\ud55c \uae30\ubcf8 \uad00\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc758 \uc790\uc720\ub97c \uce68\ud574\ud558\uc9c0 \uc54a\ub3c4\ub85d \uad6d\uac00\uc758 \uac1c\uc785\uc744 \uacbd\uacc4\ud568 (\uc18c\uadf9\uc801 \uad6d\uac00)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\uc138\ub300 \uc778\uad8c(\uc790\uc720\uad8c)\uc5d0 \uc18d\ud558\ub294 \ub300\ud45c\uc801\uc778 \uad8c\ub9ac 4\uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uccb4\uc758 \uc790\uc720, \uc0ac\uc0c1\u00b7\uc591\uc2ec\u00b7\uc885\uad50\uc758 \uc790\uc720, \uc9d1\ud68c \ubc0f \uacb0\uc0ac\u00b7\ud45c\ud604\uc758 \uc790\uc720, \uc120\uac70\ub97c \ud1b5\ud574 \uc815\ubd80\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ub810 \ubc14\uc791\uc758 \uc778\uad8c \uad6c\ubd84 \uc911 2\uc138\ub300 \uc778\uad8c\uc758 \uba85\uce6d\uacfc \ud575\uc2ec \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uad8c (\uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0b6 \ubcf4\uc7a5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2\uc138\ub300 \uc778\uad8c(\uc0ac\ud68c\uad8c)\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc694\uad6c\ub418\ub294 \uad6d\uac00\uc758 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uad6d\uac00\uc758 \uc801\uadf9\uc801\uc778 \uac1c\uc785"
          }
        ]
