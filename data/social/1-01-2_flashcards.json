    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucf8c\uc801\ud558\uace0 \uc548\uc815\uc801\uc778 \uc8fc\uac70 \ud658\uacbd\uc5d0\uc11c \uc778\uac04\ub2e4\uc6b4 \uc8fc\uac70 \uc0dd\ud65c\uc744 \ud560 \uad8c\ub9ac\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
