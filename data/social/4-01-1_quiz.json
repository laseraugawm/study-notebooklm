{
  "title": "\uc138\uacc4\ud654 \ud034\uc988",
  "questions": [
    {
      "question": "\uc138\uacc4\ud654(Globalization)\uc758 \uc758\ubbf8\uc640 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad50\ud1b5\uacfc \ud1b5\uc2e0\uc758 \ubc1c\ub2ec\uc744 \uacc4\uae30\ub85c \uc0c1\ud488, \uc790\ubcf8, \uae30\uc220, \ubb38\ud654 \ub4f1\uc774 \uad6d\uacbd\uc744 \ub118\uc5b4 \uc790\uc720\ub86d\uac8c \uc774\ub3d9\ud558\uba70 \uc138\uacc4\uac00 \ud1b5\ud569\ub418\uc5b4 \uac00\ub294 \ud604\uc0c1\uc774\ub2e4.",
          "rationale": "\uad50\ud1b5\u00b7\ud1b5\uc2e0\uc758 \ubc1c\ub2ec\ub85c \uad6d\uac00 \uac04 \uc0c1\ud638 \uc758\uc874\uc131\uc774 \uc99d\ub300\ub418\uace0 \uc9c0\uad6c\ucd0c\uc774 \ud558\ub098\uc758 \uc2dc\uc7a5 \ubc0f \uc0dd\ud65c\uad8c\uc73c\ub85c \ud1b5\ud569\ub418\ub294 \uc138\uacc4\ud654\uc758 \ud575\uc2ec \uc815\uc758\ub97c \uc815\ud655\ud788 \uc124\uba85\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uac01 \uc9c0\uc5ed\uc758 \ud2b9\uc218\ud55c \uc694\uc18c\uac00 \uad6d\uac00 \ub0b4\ubd80\uc758 \ud2b9\uc815 \uc9c0\uc5ed \uc218\uc900\uc5d0\ub9cc \uba38\ubb34\ub974\ub3c4\ub85d \ubcf4\ud638\ud558\ub294 \ud604\uc0c1\uc774\ub2e4.",
          "rationale": "\uc9c0\uc5ed\uc758 \ud2b9\uc131\uc774 \uad6d\uac00 \uc218\uc900\uc744 \ub118\uc5b4 \uc804 \uc138\uacc4\uc801\uc73c\ub85c \uc778\uc815\ubc1b\ub294 \uc9c0\uc5ed\ud654 \ubc0f \uc138\uacc4\ud654\uc758 \ud750\ub984\uacfc \ubc18\ub300\ub418\ub294 \uc124\uba85\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad6d\uac00 \uac04 \ubb34\uc5ed \uc7a5\ubcbd\uc774 \ub354\uc6b1 \uac15\ud654\ub418\uace0 \uacbd\uc81c\uc801 \uc0c1\ud638 \uc758\uc874\uc131\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uac10\uc18c\ud558\ub294 \ud604\uc0c1\uc774\ub2e4.",
          "rationale": "\uc138\uacc4\ud654\ub294 \uad6d\uacbd\uc744 \ub118\uc5b4 \uc790\uc720\ub85c\uc6b4 \uc774\ub3d9\uacfc \uc0c1\ud638 \uc758\uc874\uc131\uc758 \uc99d\ub300\ub97c \uac00\uc838\uc624\ubbc0\ub85c \ubb34\uc5ed \uc7a5\ubcbd \uac15\ud654\ub098 \uc758\uc874\uc131 \uac10\uc18c\uc640\ub294 \uac70\ub9ac\uac00 \ub5b1\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc9c0\uc5ed\uc758 \uace0\uc720 \ubb38\ud654\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc678\uad6d\uc0b0 \uc81c\ud488\uacfc \uc678\ubd80 \ubb38\ud654\uc758 \uc720\uc785\uc744 \uc778\uc704\uc801\uc73c\ub85c \ucc28\ub2e8\ud558\ub294 \uacfc\uc815\uc774\ub2e4.",
          "rationale": "\uc138\uacc4\ud654\ub294 \ubb38\ud654, \uc0c1\ud488, \uac00\uce58 \ub4f1\uc758 \uad6d\uacbd \uc5c6\ub294 \uad50\ub958\ub97c \ud3ec\ud568\ud558\ubbc0\ub85c \uc678\ubd80 \uc720\uc785 \ucc28\ub2e8\uacfc\ub294 \uc0c1\ubc18\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uad50\ud1b5\uacfc \ud1b5\uc2e0\uc758 \ubc1c\ub2ec\ub85c \uad6d\uac00 \uac04 \uad6d\uacbd\uc758 \uc7a5\ubcbd\uc774 \ub0ae\uc544\uc9c0\uace0 \uc0c1\ud638 \uc758\uc874\uc131\uc774 \ub192\uc544\uc9c0\ub294 \ud604\uc0c1\uc5d0 \uc8fc\ubaa9\ud558\uc138\uc694."
    },
    {
      "question": "\uc9c0\ub9ac\uc801 \ud45c\uc2dc\uc81c\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0c1\ud488\uc758 \ud488\uc9c8\uc774\ub098 \uba85\uc131\uc774 \ud2b9\uc815 \uc9c0\uc5ed\uc758 \uc9c0\ub9ac\uc801 \ud2b9\uc131\uc5d0\uc11c \ube44\ub86f\ub420 \ub54c \uadf8 \uc9c0\uc5ed\uc758 \uc0dd\uc0b0\ud488\uc784\uc744 \uc99d\uba85\ud558\uace0 \ud45c\uc2dc\ud558\ub294 \uc81c\ub3c4\uc774\ub2e4.",
          "rationale": "\uc9c0\ub9ac\uc801 \ud45c\uc2dc\uc81c\ub294 \uc9c0\uc5ed\uc758 \uc9c0\ub9ac\uc801 \ud658\uacbd\uacfc \uba85\uc131\uc744 \uacb0\ud569\ud558\uc5ec \ub3c5\uc790\uc801\uc778 \uc0c1\ud488 \uac00\uce58\ub97c \uc785\uc99d\ud558\uace0 \ubcf4\ud638\ud558\ub294 \uc9c0\uc5ed\ud654 \uc804\ub7b5\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc774 \uc120\uc9c4\uad6d\uc5d0 \uacf5\uc7a5\uc744 \uc138\uc6b8 \ub54c \ud604\uc9c0 \uc815\ubd80\ub85c\ubd80\ud130 \uc138\uae08 \uac10\uba74\uc744 \ubc1b\uae30 \uc704\ud574 \uc2e0\uccad\ud558\ub294 \uc11c\ub958 \uc81c\ub3c4\uc774\ub2e4.",
          "rationale": "\uc9c0\ub9ac\uc801 \ud45c\uc2dc\uc81c\ub294 \ud2b9\uc0b0\ud488\uc758 \uc9c0\ub9ac\uc801 \uc720\ub798\uc640 \ud488\uc9c8\uc744 \uc99d\uba85\ud558\ub294 \uc81c\ub3c4\uc774\uba70, \uae30\uc5c5\uc758 \uacf5\uc7a5 \uc785\uc9c0 \uc138\uc81c \ud61c\ud0dd\uacfc\ub294 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc138\uacc4\ub3c4\uc2dc \uac04\uc758 \ubb34\uc5ed \ubd84\uc7c1\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud558\uc5ec \uad6d\uc81c \uc5f0\ud569(UN)\uc5d0\uc11c \uc9c0\uc815\ud558\ub294 \uad6d\uc81c \ubc95\ub960 \uc81c\ub3c4\uc774\ub2e4.",
          "rationale": "\uc774\ub294 \uc9c0\uc5ed \ub18d\ud2b9\uc0b0\ubb3c \ub4f1\uc758 \uace0\uc720\ud55c \ud488\uc9c8\uacfc \uc9c0\ub9ac\uc801 \uc5f0\uad00\uc131\uc744 \uc778\uc815\ud558\ub294 \uc81c\ub3c4\uc774\ubbc0\ub85c UN\uc758 \ubb34\uc5ed \ubd84\uc7c1 \ud574\uacb0 \uc808\ucc28\uc640 \ubb34\uad00\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc804 \uc138\uacc4 \ubaa8\ub4e0 \uacf5\uc0b0\ud488\uc758 \uc0dd\uc0b0 \uc704\uce58\ub97c GPS \uc88c\ud45c\ub85c \uc758\ubb34 \ud45c\uc2dc\ud558\ub3c4\ub85d \uaddc\uc81c\ud558\ub294 \ud1b5\uc81c \uc815\ucc45\uc774\ub2e4.",
          "rationale": "\uc9c0\ub9ac\uc801 \ud45c\uc2dc\uc81c\ub294 \ud2b9\uc815 \uc9c0\uc5ed\uc758 \ud2b9\uc0b0\ud488 \uba85\uc131\uacfc \ud488\uc9c8\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uc81c\ub3c4\ub85c, \ubaa8\ub4e0 \uacf5\uc0b0\ud488\uc758 \uc704\uce58 \ucd94\uc801 \uaddc\uc81c\uc640\ub294 \ub2e4\ub985\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc81c\uc8fc \ud55c\ub77c\ubd09\uc774\ub098 \uc774\ud0c8\ub9ac\uc544 \uace0\ub974\uace4\uc878\ub77c \uce58\uc988\ucc98\ub7fc \uc9c0\uc5ed \uace0\uc720\uc758 \ud2b9\uc131\uc744 \uc0c1\ud488 \uba85\uc131\uacfc \uc5f0\uacb0\ud558\ub294 \uc81c\ub3c4\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc81c\uc2dc\ub41c \uc790\ub8cc\uc5d0\uc11c \uc0bf\ud3ec\ub85c\uc640 \ubc14\ub974\uc140\ub85c\ub098\uac00 \uc138\uacc4\ud654 \uc2dc\ub300\uc5d0 \uc9c0\uc5ed \uacbd\uc7c1\ub825\uc744 \ud655\ubcf4\ud558\uac8c \ub41c \uc694\uc778\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0bf\ud3ec\ub85c\ub294 \ub9ce\uc740 \ub208\uc774 \ub0b4\ub9ac\ub294 \uae30\ud6c4\uc801 \ud2b9\uc131\uc744, \ubc14\ub974\uc140\ub85c\ub098\ub294 \uac00\uc6b0\ub514\uc758 \ub3c5\ucc3d\uc801 \uac74\ucd95\ubb3c\uc774\ub77c\ub294 \uc9c0\uc5ed \uc720\uc0b0\uc744 \ud65c\uc6a9\ud558\uc600\ub2e4.",
          "rationale": "\uac01 \uc9c0\uc5ed\ub9cc\uc774 \uac00\uc9c4 \uace0\uc720\ud55c \uc790\uc5f0 \ud658\uacbd\uc801 \ud2b9\uc131\uacfc \ub3c5\ud2b9\ud55c \ubb38\ud654\uc720\uc0b0\uc744 \uac00\uce58\ud654\ud558\uc5ec \uc138\uacc4\uc801\uc778 \uad00\uad11\uc9c0\ub85c \uc131\uc7a5\uc2dc\ucf30\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc0bf\ud3ec\ub85c\ub294 \uad6d\uc81c \uae08\uc735 \uc2dc\uc7a5\uc758 \uc911\uc2ec\uc9c0\ub85c \ubc1c\uc804\ud558\uc600\uace0, \ubc14\ub974\uc140\ub85c\ub098\ub294 \ub300\uaddc\ubaa8 \ub2e4\uad6d\uc801 \uae30\uc5c5 \uacf5\uc7a5\uc744 \uc720\uce58\ud558\uc600\ub2e4.",
          "rationale": "\ubcf8\ubb38 \uc790\ub8cc\uc5d0\uc11c \uc0bf\ud3ec\ub85c\ub294 \ub208 \ucd95\uc81c, \ubc14\ub974\uc140\ub85c\ub098\ub294 \uac00\uc6b0\ub514\uc758 \uac74\ucd95\ubb3c(\uc0ac\uadf8\ub77c\ub2e4 \ud30c\ubc00\ub9ac\uc544 \uc131\ub2f9 \ub4f1)\uc744 \uc8fc\uc694 \uacbd\uc7c1\ub825\uc73c\ub85c \uc5b8\uae09\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub450 \ub3c4\uc2dc \ubaa8\ub450 \uad6d\uc81c \uc5f0\ud569(UN) \ubcf8\ubd80\ub97c \uc720\uce58\ud558\uc5ec \uc138\uacc4 \uc815\uce58\uc758 \ud575\uc2ec \uc758\uc0ac \uacb0\uc815 \uc7a5\uc18c\ub85c \uc9c0\uc815\ub418\uc5c8\ub2e4.",
          "rationale": "UN \ubcf8\ubd80\uac00 \uc704\uce58\ud55c \uc138\uacc4\ub3c4\uc2dc\ub294 \ub274\uc695\uc774\uba70, \uc0bf\ud3ec\ub85c\uc640 \ubc14\ub974\uc140\ub85c\ub098\ub294 \uc9c0\uc5ed\uc801 \ud2b9\uc0c9\uc744 \uc0b4\ub9b0 \uad00\uad11 \ubc0f \ubb38\ud654\ub85c \uc138\uacc4\ud654\uc5d0 \ub300\uc751\ud55c \uc0ac\ub840\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub450 \ub3c4\uc2dc \ubaa8\ub450 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \uc800\ub834\ud55c \ub178\ub3d9\ub825\uc744 \ub3c4\uc785\ud558\uc5ec \uc138\uacc4 \ucd5c\ub300\uc758 \uacf5\uc5c5 \ub2e8\uc9c0\ub97c \uc870\uc131\ud558\uc600\ub2e4.",
          "rationale": "\ub450 \ub3c4\uc2dc\ub294 \uc81c\uc870\uc5c5 \ub2e8\uc9c0 \uc870\uc131\uc774 \uc544\ub2c8\ub77c \uc9c0\uc5ed\uc758 \uace0\uc720\ud55c \ud2b9\uc131\uc744 \uc138\uacc4\uc5d0 \uc54c\ub9ac\ub294 \uc9c0\uc5ed\ud654 \uc804\ub7b5\uc744 \ud3bc\ucce4\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc0bf\ud3ec\ub85c\uc758 \uc790\uc5f0\uc801 \uae30\ud6c4 \ud658\uacbd\uacfc \ubc14\ub974\uc140\ub85c\ub098\uc758 \ub3c5\ucc3d\uc801\uc778 \uac74\ucd95 \ubb38\ud654\uc720\uc0b0\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc138\uacc4\ud654\uc640 \uc9c0\uc5ed\ud654\uc758 \uad00\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac00\uc7a5 \uc9c0\uc5ed\uc801\uc778 \uac83\uc774 \uc138\uacc4\uc801\uc778 \uac83\uc774\ub77c\ub294 \ub9d0\ucc98\ub7fc, \uc9c0\uc5ed\ud654\ub294 \uc138\uacc4\ud654 \uc2dc\ub300\uc5d0 \uacbd\uc7c1\ub825\uc744 \uac16\ucd94\ub294 \ubc11\uac70\ub984\uc774 \ub418\uc5b4 \ub450 \ud604\uc0c1\uc774 \ub3d9\uc2dc\uc5d0 \uc9c4\ud589\ub41c\ub2e4.",
          "rationale": "\uc138\uacc4\ud654 \uc18d\uc5d0\uc11c \uac01 \uc9c0\uc5ed\uc774 \uace0\uc720\ud55c \ud2b9\uc131\uc744 \uc0b4\ub824 \uc138\uacc4\uc801 \uac00\uce58\ub97c \uc778\uc815\ubc1b\ub294 \uc9c0\uc5ed\ud654\ub97c \ucd94\uc9c4\ud558\ubbc0\ub85c \ub450 \ud604\uc0c1\uc740 \uc0c1\ud638 \ubcf4\uc644\uc801\uc73c\ub85c \ub3d9\uc2dc \ucd94\uc9c4\ub429\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc138\uacc4\ud654\uac00 \uc9c4\uc804\ub420\uc218\ub85d \uc9c0\uc5ed \uace0\uc720\uc758 \ud2b9\uc0c9\uc774 \uc644\uc804\ud788 \uc18c\uba78\ud558\ubbc0\ub85c \ub450 \ud604\uc0c1\uc740 \uc0c1\ud638 \ubc30\ucc99\ud558\ub294 \ub300\ub9bd \uad00\uacc4\uc774\ub2e4.",
          "rationale": "\uc138\uacc4\ud654\uac00 \uc9c4\ud589\ub420\uc218\ub85d \uc624\ud788\ub824 \uc790\uae30 \uc9c0\uc5ed\uc758 \uace0\uc720\ud55c \ud2b9\uc131\uc744 \uc138\uacc4\uc5d0 \uc54c\ub9ac\ub824\ub294 \uc9c0\uc5ed\ud654 \uacbd\ud5a5\uc774 \uac15\ud574\uc9d1\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc138\uacc4\ud654\uac00 \uc644\uc804\ud788 \ub05d\ub09c \uc774\ud6c4\uc5d0\ub9cc \uc9c0\uc5ed\ud654\uac00 \uc2dc\uc791\ub420 \uc218 \uc788\ub294 \ub2e8\uacc4\uc801\u00b7\uc21c\ucc28\uc801 \uad00\uacc4\uc774\ub2e4.",
          "rationale": "\uc9c0\uc5ed\ud654\uc640 \uc138\uacc4\ud654\ub294 \uc11c\ub85c \uc5f0\uacc4\ub418\uc5b4 \ub3d9\uc2dc\uc5d0 \uc774\ub8e8\uc5b4\uc9c0\ub294 \uacbd\ud5a5\uc744 \ubcf4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc138\uacc4\ud654\ub294 \uc624\uc9c1 \uc815\uce58\uc801 \uce21\uba74\uc5d0\uc11c\ub9cc \ub098\ud0c0\ub098\uace0, \uc9c0\uc5ed\ud654\ub294 \uc624\uc9c1 \uacbd\uc81c\uc801 \uce21\uba74\uc5d0\uc11c\ub9cc \ub098\ud0c0\ub09c\ub2e4.",
          "rationale": "\uc138\uacc4\ud654\uc640 \uc9c0\uc5ed\ud654 \ubaa8\ub450 \uc815\uce58, \uacbd\uc81c, \ubb38\ud654 \ub4f1 \ub2e4\uc591\ud55c \ubd84\uc57c\uc5d0\uc11c \ubcf5\ud569\uc801\uc73c\ub85c \ub098\ud0c0\ub0a9\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "'\uac00\uc7a5 \uc9c0\uc5ed\uc801\uc778 \uac83\uc774 \uc138\uacc4\uc801\uc778 \uac83\uc774\ub2e4'\ub77c\ub294 \uad6c\uc808\uc774 \uc758\ubbf8\ud558\ub294 \ubc14\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc138\uacc4\ub3c4\uc2dc(World City)\uc758 \uc8fc\uc694 \uae30\ub2a5\uacfc \ud2b9\uc9d5\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud574\ub2f9 \uad6d\uac00 \ub0b4\ubd80\uc758 \uc9c0\ubc29 \ub3c4\uc2dc\ub4e4\uacfc\ub9cc \uad50\ub958\ud558\uba70 \uc911\uc2ec\uc9c0 \uc5ed\ud560\uc774 \uad6d\uacbd \ub0b4\ub85c \uc81c\ud55c\ub41c\ub2e4.",
          "rationale": "\uc138\uacc4\ub3c4\uc2dc\ub294 \uc804 \uc9c0\uad6c\uc801 \ucc28\uc6d0\uc5d0\uc11c \uc815\uce58, \uacbd\uc81c, \ubb38\ud654\uc758 \uc911\uc2ec\uc9c0 \uc5ed\ud560\uc744 \ud558\uba70 \uc138\uacc4\uc801\uc778 \uad50\ud1b5\u00b7\ud1b5\uc2e0\ub9dd\uc744 \ud1b5\ud574 \ub2e4\ub978 \uc138\uacc4 \uc9c0\uc5ed\uacfc \ud65c\ubc1c\ud788 \uc0c1\ud638 \uc791\uc6a9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uad6d\uc81c \uae08\uc735 \uc5c5\ubb34 \uae30\ub2a5\uacfc \uae08\uc735, \ud68c\uacc4 \ub4f1 \uc0dd\uc0b0\uc790 \uc11c\ube44\uc2a4 \uae30\ub2a5\uc774 \ub192\uac8c \uc9d1\uc911\ub418\uc5b4 \uc788\ub2e4.",
          "rationale": "\uc138\uacc4\ub3c4\uc2dc\ub294 \uae08\uc735 \ubc0f \uae30\uc5c5 \uc9c0\uc6d0 \uc11c\ube44\uc2a4 \ub4f1\uc774 \ubc00\uc9d1\ud558\uc5ec \uc9c0\uad6c\ucd0c \uacbd\uc81c\ub97c \uc8fc\ub3c4\ud558\ub294 \ud575\uc2ec \uac70\uc810\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc758 \ubcf8\uc0ac\uac00 \uc704\uce58\ud558\uace0 \uc8fc\uc694 \uad6d\uc81c\uae30\uad6c \ubcf8\ubd80\ub098 \uad6d\uc81c\ud68c\uc758\uac00 \uac1c\ucd5c\ub41c\ub2e4.",
          "rationale": "\uc138\uacc4\ub3c4\uc2dc\ub294 \uc138\uacc4 \uacbd\uc81c\ub97c \uc6c0\uc9c1\uc774\ub294 \ub2e4\uad6d\uc801 \uae30\uc5c5 \ubcf8\uc0ac\uc640 \uae00\ub85c\ubc8c \uc758\uc0ac \uacb0\uc815\uc774 \uc774\ub8e8\uc5b4\uc9c0\ub294 \uad6d\uc81c\uae30\uad6c\uac00 \uc9d1\uc911\ub418\ub294 \uc7a5\uc18c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc138\uacc4\uc801\uc778 \uad50\ud1b5\u00b7\ud1b5\uc2e0\ub9dd\uc758 \uc911\uc2ec\uc9c0\ub85c\uc11c \uc608\uc220, \uc74c\uc545, \uc601\ud654 \ub4f1 \ubb38\ud654 \ud65c\ub3d9\uc744 \uc8fc\ub3c4\ud55c\ub2e4.",
          "rationale": "\uc138\uacc4\ub3c4\uc2dc\ub294 \ubb3c\ub958\uc640 \uc815\ubcf4\uc758 \ud5c8\ube0c\uc774\uc790 \uc138\uacc4\uc801\uc778 \ubb38\ud654 \ud750\ub984\uc744 \uc774\ub044\ub294 \uc911\uc2ec\uc9c0\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc138\uacc4\ub3c4\uc2dc\uac00 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uacf5\uac04\uc801 \ubc94\uc704\uac00 \ub2e8\uc9c0 \ud558\ub098\uc758 \uad6d\uac00 \ub0b4\ubd80\ub85c \ud55c\uc815\ub418\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 \ubcf8\ubb38\uc5d0 \uc81c\uc2dc\ub41c '\uc0dd\uc0b0\uc790 \uc11c\ube44\uc2a4'\uc758 \uc608\uc2dc\uc5d0 \ud574\ub2f9\ud558\ub294 \ud56d\ubaa9\uc73c\ub85c\ub9cc \uc633\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uae08\uc735, \ubcf4\ud5d8, \ubd80\ub3d9\uc0b0\uc5c5, \ud68c\uacc4 \uc11c\ube44\uc2a4, \uc5f0\uad6c \uac1c\ubc1c",
          "rationale": "\uc0dd\uc0b0\uc790 \uc11c\ube44\uc2a4\ub294 \uc0c1\ud488\uc758 \uc0dd\uc0b0 \ubc0f \uc720\ud1b5 \uacfc\uc815\uc5d0 \ud544\uc694\ud55c \uc804\ubb38\uc801 \uc11c\ube44\uc2a4 \uc5c5\ubb34\ub4e4\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ucd08\ub4f1 \uad50\uc721, \uac1c\uc778 \ubbf8\uc6a9, \uac00\uc0ac \ub300\ud589, \uac1c\uc778 \uac04\ubcd1",
          "rationale": "\uc774 \ud56d\ubaa9\ub4e4\uc740 \uac1c\uc778\uc758 \uc18c\ube44\uc640 \uc0dd\ud65c \ud3b8\uc758\ub97c \uc704\ud55c \uc18c\ube44\uc790 \uc11c\ube44\uc2a4\uc5d0 \uac00\uae5d\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub18d\uc791\ubb3c \uc7ac\ubc30, \uc784\uc5c5, \uc218\uc0b0\uc5c5, \uad11\ubb3c \ucc44\uad74",
          "rationale": "\uc774 \ud56d\ubaa9\ub4e4\uc740 1\ucc28 \uc0b0\uc5c5\uc778 \uc6d0\uc790\uc7ac \ubc0f \uc2dd\ub7c9 \uc0dd\uc0b0 \ud65c\ub3d9\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc804\ud1b5\uc2dc\uc7a5 \uc18c\ub9e4, \uac00\uc804\uc81c\ud488 \uac1c\uc778 \uc218\ub9ac, \uc74c\uc2dd\uc810 \uc601\uc5c5",
          "rationale": "\uc774 \ud56d\ubaa9\ub4e4\uc740 \uc8fc\ub85c \uac1c\uc778 \uc18c\ube44\uc790\ub97c \ub300\uc0c1\uc73c\ub85c \ud558\ub294 \uc11c\ube44\uc2a4\uc5c5\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uae30\uc5c5\uc774 \uc0c1\ud488\uc744 \ub9cc\ub4e4\uace0 \uc720\ud1b5\ud558\ub294 \uacfc\uc815\uc5d0 \uc9c0\uc6d0\ub418\ub294 \uc804\ubb38\uc801\uc778 \uc11c\ube44\uc2a4 \uc5c5\uc885\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "\uad50\uacfc\uc11c \ubcf8\ubb38\uc5d0 \uc18c\uac1c\ub41c \uc8fc\uc694 \uc138\uacc4\ub3c4\uc2dc\uc778 '\ub274\uc695'\uacfc '\ub7f0\ub358'\uc758 \uc5ed\ud560 \ubc0f \uc704\uc0c1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub274\uc695\uc5d0\ub294 UN \ubcf8\ubd80\uc640 \uc6d4\uac00\uac00 \uc788\uc73c\uba70, \ub7f0\ub358\uc740 '\ub354 \uc2dc\ud2f0'\ub97c \uc911\uc2ec\uc73c\ub85c \ub274\uc695\uacfc \ud568\uaed8 \uc138\uacc4 \uae08\uc735 \uc2dc\uc7a5\uc758 \uc591\ub300 \ucd95\uc744 \uc774\ub8ec\ub2e4.",
          "rationale": "\ub274\uc695\uc740 \uad6d\uc81c \uc5f0\ud569 \ubcf8\ubd80\uc640 \uc138\uacc4 \ucd5c\ub300 \uc99d\uad8c \uac70\ub798\uc18c\uac00 \uc704\uce58\ud558\uace0, \ub7f0\ub358\uc740 \ub354 \uc2dc\ud2f0\ub97c \uc911\uc2ec\uc73c\ub85c \uae00\ub85c\ubc8c \uae08\uc735\uacfc \ub2e4\uad6d\uc801 \uae30\uc5c5 \ubcf8\uc0ac\uac00 \ubc00\uc9d1\ud574 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub274\uc695\uc740 \uc138\uacc4\uc801\uc778 \ub18d\uc5c5 \uc0dd\uc0b0\uc758 \uc911\uc2ec\uc9c0\uc774\uba70, \ub7f0\ub358\uc740 \uc911\ud654\ud559 \uacf5\uc5c5 \uacf5\uc7a5\uc774 \ubc00\uc9d1\ud55c \uacf5\uc5c5 \ub3c4\uc2dc\uc774\ub2e4.",
          "rationale": "\ub450 \ub3c4\uc2dc \ubaa8\ub450 \uc81c\uc870\uc5c5\uc774\ub098 \ub18d\uc5c5 \uc911\uc2ec\uc9c0\uac00 \uc544\ub2c8\ub77c \uae00\ub85c\ubc8c \uae08\uc735, \uc815\uce58, \ubb38\ud654, \uace0\uae09 \uc11c\ube44\uc2a4 \uae30\ub2a5\uc774 \uc9d1\uc911\ub41c \uc138\uacc4\ub3c4\uc2dc\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub7f0\ub358\uc5d0\ub294 UN \uae34\uae09 \ud2b9\ubcc4 \ucd1d\ud68c\uac00 \uc5f4\ub9ac\ub294 UN \ubcf8\ubd80\uac00 \uc704\uce58\ud558\uc5ec \uc138\uacc4 \uc815\uce58\uc758 \uc720\uc77c\ud55c \uc911\uc2ec\uc9c0 \uc5ed\ud560\uc744 \ud55c\ub2e4.",
          "rationale": "UN \ubcf8\ubd80\ub294 \ub7f0\ub358\uc774 \uc544\ub2c8\ub77c \ub274\uc695 \ub9e8\ud574\ud2bc\uc5d0 \uc704\uce58\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub274\uc695 \uc99d\uad8c \uac70\ub798\uc18c\uc758 \uc8fc\uac00 \uc9c0\uc218 \ubcc0\ub3d9\uc740 \ud0c0\uad6d\uc758 \uae08\uc735 \uc2dc\uc7a5\uc774\ub098 \uc8fc\uac00\uc5d0 \uc804\ud600 \uc601\ud5a5\uc744 \ubbf8\uce58\uc9c0 \uc54a\ub294\ub2e4.",
          "rationale": "\uc138\uacc4 \uae08\uc735\uc758 \uc911\uc2ec\uc9c0\uc778 \ub274\uc695 \uc99d\uc2dc\uc758 \ubcc0\ud654\ub294 \uc6b0\ub9ac\ub098\ub77c\ub97c \ube44\ub86f\ud55c \uc804 \uc138\uacc4 \uc8fc\uac00 \uc9c0\uc218\uc640 \ud22c\uc790 \uc2ec\ub9ac\uc5d0 \ud070 \uc601\ud5a5\uc744 \uc90d\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub274\uc695\uc758 \uc6d4\uac00\uc640 UN \ubcf8\ubd80, \ub7f0\ub358\uc758 '\ub354 \uc2dc\ud2f0'\uc758 \uae08\uc735 \uae30\ub2a5\uc5d0 \ub300\ud574 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc758 '\uacf5\uac04\uc801 \ubd84\uc5c5'\uc5d0\uc11c \ubcf8\uc0ac\uc640 \uc5f0\uad6c\uc18c\uac00 \uc704\uce58\ud558\ub294 \uc8fc\ub41c \uc9c0\uc5ed\uacfc \uc785\uc9c0 \uc694\uc778\uc774 \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ub41c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubcf8\uc0ac\ub294 \uacbd\uc601 \uc804\ub7b5 \uc218\ub9bd\uc744 \uc704\ud574 \ubcf8\uad6d\uc758 \ub300\ub3c4\uc2dc\uc5d0, \uc5f0\uad6c\uc18c\ub294 \uc6b0\uc218 \uc778\ub825 \ud655\ubcf4\uc640 \uc815\ubcf4 \uc218\uc9d1\uc774 \uc720\ub9ac\ud55c \uc120\uc9c4\uad6d\uc5d0 \uc785\uc9c0\ud55c\ub2e4.",
          "rationale": "\uae30\uc5c5 \uc804\uccb4 \uad00\ub9ac\uc640 \uc804\ub7b5 \uc218\ub9bd\uc5d0 \uc720\ub9ac\ud55c \ub300\ub3c4\uc2dc\uc5d0 \ubcf8\uc0ac\uac00 \uc704\uce58\ud558\uace0, \uace0\uae09 \uc5f0\uad6c \uc778\ub825\uacfc \uc815\ubcf4\uac00 \ud48d\ubd80\ud55c \uc120\uc9c4\uad6d\uc5d0 \uc5f0\uad6c\uc18c\uac00 \uc704\uce58\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubcf8\uc0ac\ub294 \ud1a0\uc9c0 \uac00\uaca9\uc774 \uc800\ub834\ud55c \uad50\uc678 \ub18d\ucd0c\uc5d0, \uc5f0\uad6c\uc18c\ub294 \ubbf8\uc219\ub828 \ub178\ub3d9\ub825\uc774 \ud48d\ubd80\ud55c \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc5d0 \uc785\uc9c0\ud55c\ub2e4.",
          "rationale": "\ubcf8\uc0ac\ub294 \uc758\uc0ac\uacb0\uc815\uacfc \uace0\uae09 \uc815\ubcf4 \uc811\uadfc\uc774 \uc26c\uc6b4 \ub300\ub3c4\uc2dc\uc5d0, \uc5f0\uad6c\uc18c\ub294 \uc6b0\uc218\ud55c \uae30\uc220 \uc778\ub825\uc774 \uc788\ub294 \uc120\uc9c4\uad6d\uc5d0 \uc704\uce58\ud558\ub294 \uac83\uc774 \uc77c\ubc18\uc801\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubcf8\uc0ac\uc640 \uc5f0\uad6c\uc18c\ub294 \uad00\uc138\ub97c \uc804\uba74 \uba74\uc81c\ubc1b\uae30 \uc704\ud574 \ubc18\ub4dc\uc2dc \uc0dd\uc0b0 \uacf5\uc7a5\uacfc \ub3d9\uc77c\ud55c \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc5d0 \ud1b5\ud569 \uc785\uc9c0\ud55c\ub2e4.",
          "rationale": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc740 \uac01 \uae30\ub2a5\uc758 \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ubcf8\uc0ac, \uc5f0\uad6c\uc18c, \uacf5\uc7a5\uc744 \uacf5\uac04\uc801\uc73c\ub85c \ubd84\ub9ac\ud558\uc5ec \uc785\uc9c0\uc2dc\ud0b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubcf8\uc0ac\ub294 \uc6d0\ub8cc \ucc44\uad74\uc9c0\uc5d0, \uc5f0\uad6c\uc18c\ub294 \ub2e8\uc21c \uc18c\ube44 \uc2dc\uc7a5 \ubd80\uadfc\uc758 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc5d0 \uc785\uc9c0\ud55c\ub2e4.",
          "rationale": "\ubcf8\uc0ac\uc640 \uc5f0\uad6c\uc18c\uc758 \uc785\uc9c0 \uacb0\uc815 \uc694\uc778\uc740 \uc6d0\ub8cc \ucc44\uad74\uc774\ub098 \ub2e8\uc21c \uc18c\ube44 \uc2dc\uc7a5\ubcf4\ub2e4\ub294 \uace0\uae09 \uc778\ub825, \uc815\ubcf4 \uc218\uc9d1, \uacbd\uc601 \ud6a8\uc728\uc131\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uacbd\uc601 \uc804\ub7b5 \uad00\ub9ac \ubc0f \uc5f0\uad6c \uac1c\ubc1c \uc778\ub825 \ud655\ubcf4\uc5d0 \ucd5c\uc801\ud654\ub41c \uc7a5\uc18c\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc774 \uc0dd\uc0b0 \uacf5\uc7a5\uc744 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc774 \uc544\ub2cc '\uc120\uc9c4\uad6d'\uc5d0 \uc124\ub9bd\ud558\ub294 \uc8fc\ub41c \uc694\uc778\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud574\ub2f9 \uc120\uc9c4\uad6d\uc758 \uad00\uc138 \ubd80\uacfc \ub4f1 \ubb34\uc5ed \uc7a5\ubcbd\uc744 \uadf9\ubcf5\ud558\uace0 \ud604\uc9c0 \uc2dc\uc7a5 \uc218\uc694\uc5d0 \ube60\ub974\uac8c \ub300\uc751\ud558\uae30 \uc704\ud574\uc11c\uc774\ub2e4.",
          "rationale": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \uc800\ub834\ud55c \uc784\uae08\uc744 \ub178\ub9ac\uace0 \uc9c4\ucd9c\ud558\ub294 \ubc18\uba74, \uc120\uc9c4\uad6d \uacf5\uc7a5 \uc124\ub9bd\uc740 \ubb34\uc5ed \uc7a5\ubcbd \ud68c\ud53c\uc640 \ud604\uc9c0 \uc2dc\uc7a5 \ubc00\ucc29 \ub300\uc751\uc774 \uc8fc\ub41c \ubaa9\uc801\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc120\uc9c4\uad6d\uc758 \ubbf8\uc219\ub828 \ub178\ub3d9\uc790 \uc784\uae08\uc774 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\ubcf4\ub2e4 \ud6e8\uc52c \uc800\ub834\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc120\uc9c4\uad6d\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uac1c\ubc1c\ub3c4\uc0c1\uad6d\ubcf4\ub2e4 \ub178\ub3d9\uc790 \uc784\uae08 \uc218\uc900\uc774 \ud604\uc800\ud788 \ub192\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc120\uc9c4\uad6d \uc815\ubd80\uac00 \ubaa8\ub4e0 \ub2e4\uad6d\uc801 \uae30\uc5c5\uc758 \ubcf8\uc0ac\ub97c \uc790\uad6d\uc73c\ub85c \uac15\uc81c \uc774\uc804\uc2dc\ud0a4\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc0dd\uc0b0 \uacf5\uc7a5 \uc124\ub9bd\uc774 \ubcf8\uc0ac\uc758 \uac15\uc81c \uc774\uc804\uc744 \uc758\ubbf8\ud558\uac70\ub098 \uc774\uc5d0 \uc758\ud574 \uacb0\uc815\ub418\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \uc2dc\uc7a5 \uaddc\ubaa8\uac00 \uc120\uc9c4\uad6d\ubcf4\ub2e4 \uc9c0\ub098\uce58\uac8c \ucee4\uc11c \uacf5\uc7a5 \ubd80\uc9c0\ub97c \ud655\ubcf4\ud560 \uc218 \uc5c6\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \ubcf4\ud1b5 \uc800\uc784\uae08 \ud65c\uc6a9\uc774\ub098 \ubd80\uc9c0 \ud655\ubcf4\uac00 \uc6a9\uc774\ud558\uba70, \uc120\uc9c4\uad6d\uc5d0 \uacf5\uc7a5\uc744 \uc9d3\ub294 \uac83\uc740 \ubb34\uc5ed \uc7a5\ubcbd \uadf9\ubcf5 \ubc0f \ud604\uc9c0 \uc2dc\uc7a5 \uacf5\ub7b5 \ubaa9\uc801\uc774 \ud07d\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc218\uc785\ud488\uc5d0 \ub300\ud55c \uad00\uc138 \uc7a5\ubcbd \ud68c\ud53c\uc640 \ud604\uc9c0 \uc18c\ube44\uc790\uc758 \uc694\uad6c\uc5d0 \uc989\uac01 \ub300\uc751\ud558\ub824\ub294 \ubaa9\uc801\uc744 \uace0\ub824\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38 \uc790\ub8cc\uc758 \uc6b0\ub9ac\ub098\ub77c \ub2e4\uad6d\uc801 \uae30\uc5c5 'OO\uc0ac'\uac00 \ubbf8\uad6d \uc870\uc9c0\uc544\uc8fc\uc5d0 \uc804\uae30\ucc28 \uc0dd\uc0b0 \uacf5\uc7a5\uc744 \uac74\uc124\ud558\uae30\ub85c \ud55c \uc774\uc720\ub85c \ubcf4\uae30 \uc5b4\ub824\uc6b4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubbf8\uad6d\uc758 \uc800\ub834\ud55c \ud48d\ubd80\ud55c \ubbf8\uc219\ub828 \ub178\ub3d9\ub825\uc744 \ud65c\uc6a9\ud558\uc5ec \uc0dd\uc0b0 \ub2e8\uac00\ub97c \ucd5c\ub300\ub85c \ub0ae\ucd94\uae30 \uc704\ud574",
          "rationale": "\ubbf8\uad6d\uc740 \uc120\uc9c4\uad6d\uc73c\ub85c\uc11c \uc800\uc784\uae08 \ubbf8\uc219\ub828 \ub178\ub3d9\ub825 \ud655\ubcf4\ubcf4\ub2e4\ub294 \ubb34\uc5ed \uc7a5\ubcbd \uadf9\ubcf5, \ud604\uc9c0 \uc2dc\uc7a5 \ub300\uc751, \uacf5\uae09\ub9dd \uad00\ub9ac\uac00 \uc8fc\ub41c \uc9c4\ucd9c \uc774\uc720\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud604\uc9c0 \uace0\uac1d\uc758 \ub2e4\uc591\ud55c \uc218\uc694\uc5d0 \ud0c4\ub825\uc801\uc774\uace0 \ube60\ub974\uac8c \ub300\uc751\ud558\uae30 \uc704\ud574",
          "rationale": "\ubbf8\uad6d \ud604\uc9c0 \uacf5\uc7a5\uc744 \ud1b5\ud574 \ud604\uc9c0 \uc18c\ube44\uc790\ub4e4\uc758 \ucc28\uc885 \uc218\uc694\uc5d0 \ube60\ub974\uac8c \ub9de\ucd94\uc5b4 \uc0dd\uc0b0 \uccb4\uacc4\ub97c \uc6b4\uc6a9\ud558\uace0\uc790 \ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc778\uc811\ud55c \uc0dd\uc0b0 \uac70\uc810 \uac04\uc758 \ubd80\ud488 \uc870\ub2ec \ubc0f \uacf5\uae09\ub9dd \uad00\ub9ac\uc5d0\uc11c \uacbd\uc81c\uc801 \uc774\uc810\uc744 \uc5bb\uae30 \uc704\ud574",
          "rationale": "\uc0dd\uc0b0 \uac70\uc810\uc774 \uc11c\ub85c \uac00\uae4c\uc774 \uc704\uce58\ud558\uba74 \ubd80\ud488 \uc870\ub2ec\uacfc \uc804\uccb4 \uacf5\uae09\ub9dd \uad00\ub9ac\uac00 \ud6e8\uc52c \ud6a8\uc728\uc801\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
