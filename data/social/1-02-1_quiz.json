{
  "title": "\uc778\uad8c\ubc95 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc778\uad8c\uacfc \uae30\ubcf8\uad8c\uc758 \uac1c\ub150 \ubc0f \ub458 \uc0ac\uc774\uc758 \uad00\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud5cc\ubc95\uc5d0 \uaddc\uc815\ub418\uc5b4 \uad6d\uac00\uac00 \ubc95\uc801\uc73c\ub85c \ubcf4\uc7a5\ud558\ub294 \uae30\ubcf8\uc801\uc778 \uc778\uad8c\uc744 \uae30\ubcf8\uad8c\uc774\ub77c\uace0 \ud55c\ub2e4.",
          "rationale": "\uae30\ubcf8\uad8c\uc740 \uc778\uac04\uc73c\ub85c\uc11c \ub2f9\uc5f0\ud788 \ub204\ub824\uc57c \ud560 \ubcf4\ud3b8\uc801 \uad8c\ub9ac\uc778 \uc778\uad8c\uc774 \uad6d\uac00\uc758 \ucd5c\uace0\ubc95\uc778 \ud5cc\ubc95\uc5d0 \uba85\uc2dc\ub418\uc5b4 \uc2e4\uc9c8\uc801\uc73c\ub85c \ubcf4\uc7a5\ub418\ub294 \uad8c\ub9ac\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc778\uad8c\uc740 \uad6d\uac00\uc758 \ucd5c\uace0\ubc95\uc778 \ud5cc\ubc95\uc5d0 \uba85\uc2dc\ub428\uc73c\ub85c\uc368 \ube44\ub85c\uc18c \ubc1c\uc0dd\ud558\ub294 \ubc95\uc801 \uad8c\ub9ac\uc774\ub2e4.",
          "rationale": "\uc778\uad8c\uc740 \ud0dc\uc5b4\ub0a0 \ub54c\ubd80\ud130 \ub204\uad6c\ub098 \ub2f9\uc5f0\ud788 \uac00\uc9c0\ub294 \ubcf4\ud3b8\uc801 \uad8c\ub9ac\uc774\uba70, \ud5cc\ubc95 \uba85\uc2dc \uc5ec\ubd80\uc640 \uad00\uacc4\uc5c6\uc774 \uc874\uc7ac\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uae30\ubcf8\uad8c\uc740 \uad6d\uac00\uc758 \uc131\ub9bd \uc5ec\ubd80\uc640 \uad00\uacc4\uc5c6\uc774 \ud589\uc0ac\ud560 \uc218 \uc788\ub294 \ucd08\uad6d\uac00\uc801 \uad8c\ub9ac\uc774\ub2e4.",
          "rationale": "\ucd08\uad6d\uac00\uc801\u00b7\ubcf4\ud3b8\uc801 \uc131\uaca9\uc744 \ub760\ub294 \uac83\uc740 \uc778\uad8c\uc774\uba70, \uae30\ubcf8\uad8c\uc740 \ud2b9\uc815 \uad6d\uac00\uc758 \ud5cc\ubc95 \uaddc\uc815\uc744 \ud1b5\ud574 \uad6c\uccb4\uc801\uc73c\ub85c \uc2e4\ud604\ub418\ub294 \uad8c\ub9ac\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc778\uac04\uc758 \uc874\uc5c4\uacfc \uac00\uce58\ub294 \uae30\ubcf8\uad8c\uc5d0 \ud3ec\ud568\ub418\uc9c0 \uc54a\ub294 \ud5cc\ubc95 \uc678\uc801 \ucd94\uc0c1\uc801 \uac1c\ub150\uc5d0 \ubd88\uacfc\ud558\ub2e4.",
          "rationale": "\ud5cc\ubc95 \uc81c10\uc870\ub294 \uc778\uac04\uc758 \uc874\uc5c4\uacfc \uac00\uce58\ub97c \ud5cc\ubc95\uc758 \ud575\uc2ec\uc801 \uac00\uce58\uc774\uc790 \uae30\ubcf8 \uc6d0\ub9ac\ub85c \uc9c1\uc811 \uaddc\uc815\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc778\uad8c\uc774 \ubcf4\ud3b8\uc801\uc778 \uad8c\ub9ac\ub77c\uba74, \uae30\ubcf8\uad8c\uc740 \ucd5c\uace0 \uaddc\ubc94\uc5d0 \uaddc\uc815\ub418\uc5b4 \ubcf4\uc7a5\ubc1b\ub294 \uad8c\ub9ac\uc784\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub300\ud55c\ubbfc\uad6d \ud5cc\ubc95\uc774 \uc785\ud5cc\uc8fc\uc758 \uc6d0\ub9ac\ub97c \ucc44\ud0dd\ud558\uc5ec \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c\uc744 \ubcf4\uc7a5\ud558\ub294 \ubaa9\uc801\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uac00\uc758 \ubaa8\ub4e0 \uad8c\ub825\uc774 \ud5cc\ubc95\uc5d0 \ub530\ub974\ub3c4\ub85d \ud568\uc73c\ub85c\uc368 \uad8c\ub825\uc758 \uc790\uc758\uc801 \ud589\uc0ac\ub97c \ub9c9\uace0 \uc778\uad8c\uc744 \uc2e4\uc9c8\uc801\uc73c\ub85c \ubcf4\uc7a5\ud55c\ub2e4.",
          "rationale": "\uc785\ud5cc\uc8fc\uc758\ub294 \uad6d\uac00 \uad8c\ub825 \ud1b5\uc81c\ub97c \ud1b5\ud574 \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c \uce68\ud574\ub97c \ubc29\uc9c0\ud558\uace0 \uc2e4\uc9c8\uc801\uc778 \uc778\uad8c \ubcf4\uc7a5\uc744 \ub3c4\ubaa8\ud558\ub294 \uc815\uce58 \uc6d0\ub9ac\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud589\uc815\uad8c\uc774 \uc785\ubc95\uad8c\uacfc \uc0ac\ubc95\uad8c\ubcf4\ub2e4 \uc6b0\uc704\uc5d0 \uc11c\uc11c \uad6d\uac00 \uc6b4\uc601\uc758 \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\ub3c4\ub85d \uc9c0\uc6d0\ud55c\ub2e4.",
          "rationale": "\uc785\ud5cc\uc8fc\uc758\ub294 \uad8c\ub825\uc758 \ub0a8\uc6a9\uc744 \ub9c9\uae30 \uc704\ud55c \uac83\uc774\uc9c0, \ud2b9\uc815 \uad8c\ub825 \uae30\uad00\uc758 \uc6b0\uc704\ub098 \ud6a8\uc728\uc131\ub9cc\uc744 \ucd94\uad6c\ud558\ub294 \uc6d0\ub9ac\uac00 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c \ubcf4\uc7a5\ubcf4\ub2e4 \ud1b5\uce58 \uc870\uc9c1\uc758 \uad8c\ud55c \ud655\ub9bd\uc744 \ucd5c\uc6b0\uc120 \uacfc\uc81c\ub85c \uc124\uc815\ud558\uae30 \uc704\ud568\uc774\ub2e4.",
          "rationale": "\ud5cc\ubc95\uc5d0 \ud1b5\uce58 \uc870\uc9c1\uacfc \uc6b4\uc601 \uc6d0\ub9ac\ub97c \uba85\uc2dc\ud558\ub294 \ud575\uc2ec \ubaa9\uc801\uc740 \uad8c\ub825 \ud589\uc0ac \uc790\uccb4\uac00 \uc544\ub2c8\ub77c \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c \ubcf4\uc7a5\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad6d\uac00 \uc548\ubcf4\ub098 \uc9c8\uc11c \uc720\uc9c0\uac00 \ud544\uc694\ud560 \ub54c \ud5cc\ubc95 \uc870\ud56d\uc744 \uc790\uc758\uc801\uc73c\ub85c \uc218\uc815\u00b7\uc801\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uae30 \uc704\ud568\uc774\ub2e4.",
          "rationale": "\uc785\ud5cc\uc8fc\uc758\ub294 \ubaa8\ub4e0 \uad6d\uac00 \uad8c\ub825\uc774 \ud5cc\ubc95 \uaddc\ubc94\uc5d0 \uad6c\uc18d\ub418\ub3c4\ub85d \ud558\uc5ec \uc790\uc758\uc801\uc778 \uad8c\ub825 \ud589\uc0ac\ub97c \ubc29\uc9c0\ud558\uace0\uc790 \ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ud5cc\ubc95\uc774 \ucd5c\uace0\ubc95\uc73c\ub85c\uc11c \uad6d\uac00 \uad8c\ub825\uc758 \ud589\uc0ac \ubc29\ud5a5\uc744 \uc81c\ud55c\ud558\ub294 \uc774\uc720\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc81c\uc2dc\ub41c \ud5cc\ubc95 \uc870\ud56d\uacfc \uae30\ubcf8\uad8c\uc758 \uc885\ub958\uac00 \uc62c\ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?\n\n(\uac00) \uc81c11\uc870 \u2460 \ubaa8\ub4e0 \uad6d\ubbfc\uc740 \ubc95 \uc55e\uc5d0 \ud3c9\ub4f1\ud558\ub2e4.\n(\ub098) \uc81c12\uc870 \u2460 \ubaa8\ub4e0 \uad6d\ubbfc\uc740 \uc2e0\uccb4\uc758 \uc790\uc720\ub97c \uac00\uc9c4\ub2e4.\n(\ub2e4) \uc81c24\uc870 \ubaa8\ub4e0 \uad6d\ubbfc\uc740 \ubc95\ub960\uc774 \uc815\ud558\ub294 \ubc14\uc5d0 \uc758\ud558\uc5ec \uc120\uac70\uad8c\uc744 \uac00\uc9c4\ub2e4.\n(\ub77c) \uc81c34\uc870 \u2460 \ubaa8\ub4e0 \uad6d\ubbfc\uc740 \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c\uc744 \ud560 \uad8c\ub9ac\ub97c \uac00\uc9c4\ub2e4.",
      "answerOptions": [
        {
          "text": "(\uac00) \ud3c9\ub4f1\uad8c, (\ub098) \uc790\uc720\uad8c, (\ub2e4) \ucc38\uc815\uad8c, (\ub77c) \uc0ac\ud68c\uad8c",
          "rationale": "\ubc95 \uc55e\uc758 \ub300\uc6b0\ub294 \ud3c9\ub4f1\uad8c, \uc2e0\uccb4\uc758 \uad6c\uc18d\uc73c\ub85c\ubd80\ud130 \ubc97\uc5b4\ub0a8\uc740 \uc790\uc720\uad8c, \uc120\uac70\uad8c\uc740 \ucc38\uc815\uad8c, \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c \ubcf4\uc7a5\uc740 \uc0ac\ud68c\uad8c\uc5d0 \uac01\uac01 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "(\uac00) \uc790\uc720\uad8c, (\ub098) \ud3c9\ub4f1\uad8c, (\ub2e4) \uccad\uad6c\uad8c, (\ub77c) \ucc38\uc815\uad8c",
          "rationale": "\uc81c11\uc870\ub294 \ud3c9\ub4f1\uad8c, \uc81c12\uc870\ub294 \uc790\uc720\uad8c, \uc81c24\uc870\ub294 \ucc38\uc815\uad8c, \uc81c34\uc870\ub294 \uc0ac\ud68c\uad8c\uc5d0 \ud574\ub2f9\ud558\ubbc0\ub85c \ubd84\ub958\uac00 \uc633\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "(\uac00) \ud3c9\ub4f1\uad8c, (\ub098) \uc0ac\ud68c\uad8c, (\ub2e4) \ucc38\uc815\uad8c, (\ub77c) \uccad\uad6c\uad8c",
          "rationale": "\uc81c12\uc870\uc758 \uc2e0\uccb4\uc758 \uc790\uc720\ub294 \uc0ac\ud68c\uad8c\uc774 \uc544\ub2cc \uc790\uc720\uad8c\uc774\uba70, \uc81c34\uc870\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c\uc740 \uccad\uad6c\uad8c\uc774 \uc544\ub2cc \uc0ac\ud68c\uad8c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "(\uac00) \ucc38\uc815\uad8c, (\ub098) \uc790\uc720\uad8c, (\ub2e4) \uccad\uad6c\uad8c, (\ub77c) \uc0ac\ud68c\uad8c",
          "rationale": "\uc81c11\uc870\uc758 \ubc95 \uc55e\uc758 \ud3c9\ub4f1\uc740 \ucc38\uc815\uad8c\uc774 \uc544\ub2cc \ud3c9\ub4f1\uad8c\uc774\uba70, \uc81c24\uc870\uc758 \uc120\uac70\uad8c\uc740 \uccad\uad6c\uad8c\uc774 \uc544\ub2cc \ucc38\uc815\uad8c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uac01 \uc870\ud56d\uc774 \ub2f4\uace0 \uc788\ub294 \ud575\uc2ec \uad8c\ub9ac\uc758 \uc131\uaca9(\ucc28\ubcc4 \uc5c6\uc74c, \uac04\uc12d\ubc1b\uc9c0 \uc54a\uc74c, \uc815\uce58 \ucc38\uc5ec, \uc778\uac04\ub2e4\uc6b4 \uc0b6)\uc744 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub300\ud55c\ubbfc\uad6d \ud5cc\ubc95 \uc81c37\uc870 \uc81c1\ud56d(\"\uad6d\ubbfc\uc758 \uc790\uc720\uc640 \uad8c\ub9ac\ub294 \ud5cc\ubc95\uc5d0 \uc5f4\uac70\ub418\uc9c0 \uc544\ub2c8\ud55c \uc774\uc720\ub85c \uacbd\uc2dc\ub418\uc9c0 \uc544\ub2c8\ud55c\ub2e4.\")\uc758 \uc758\ubbf8\uc5d0 \ub300\ud55c \ud574\uc11d\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc77c\uc870\uad8c, \uc218\uba74\uad8c, \ubb38\ud654\uad8c\ucc98\ub7fc \ud5cc\ubc95\uc5d0 \uba85\uc2dc\ub418\uc9c0 \uc54a\uc740 \uad8c\ub9ac\ub77c\ub3c4 \uc778\uac04 \uc874\uc5c4\uc131 \uc2e4\ud604\uc5d0 \ud544\uc694\ud558\ub2e4\uba74 \ubcf4\uc7a5\ub41c\ub2e4.",
          "rationale": "\ud5cc\ubc95\uc5d0 \ubaa8\ub4e0 \uad8c\ub9ac\ub97c \uc77c\uc77c\uc774 \uc5f4\uac70\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c, \uba85\uc2dc\ub418\uc9c0 \uc54a\uc558\ub354\ub77c\ub3c4 \ud544\uc694\ud55c \uad8c\ub9ac\ub294 \uacbd\uc2dc\ub418\uc9c0 \uc54a\uace0 \ubcf4\uc7a5\ub429\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud5cc\ubc95 \uc870\ubb38\uc5d0 \uba85\ud655\ud788 \uba85\uc2dc\ub418\uc5b4 \uc788\ub294 \uc5f4\uac70\uc801 \uad8c\ub9ac\ub9cc\uc774 \ubc95\uc801\uc778 \uad6c\uc81c \ub300\uc0c1\uc774 \ub41c\ub2e4.",
          "rationale": "\uc81c37\uc870 \uc81c1\ud56d\uc740 \ud5cc\ubc95\uc5d0 \uc5f4\uac70\ub418\uc9c0 \uc54a\uc558\ub2e4\ub294 \uc774\uc720\ub85c \uad8c\ub9ac\ub97c \ubb34\uc2dc\ud558\uac70\ub098 \uc81c\uc678\ud574\uc11c\ub294 \uc548 \ub41c\ub2e4\ub294 \uc810\uc744 \uba85\uc2dc\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud5cc\ubc95\uc5d0 \uba85\uc2dc\ub418\uc9c0 \uc54a\uc740 \uad8c\ub9ac\ub294 \uad6d\ud68c\uac00 \ubcc4\ub3c4\uc758 \uac1c\ud5cc \uc808\ucc28\ub97c \uac70\uccd0 \ud655\uc815\ud574\uc57c\ub9cc \ubcf4\ud638\ubc1b\uc744 \uc218 \uc788\ub2e4.",
          "rationale": "\uac1c\ud5cc \uc808\ucc28 \uc5c6\uc774\ub3c4 \ud5cc\ubc95 \uc81c37\uc870 \uc81c1\ud56d\uc5d0 \uc758\ud574 \uc5f4\uac70\ub418\uc9c0 \uc54a\uc740 \uae30\ubcf8\uad8c\uc73c\ub85c\uc11c \uc9c1\uc811 \ubcf4\uc7a5\ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad6d\ubbfc\uc758 \ubaa8\ub4e0 \uad8c\ub9ac\ub294 \ubc95\ub960\uc5d0 \uad6c\uccb4\uc801\uc778 \ucc98\ubc8c \uc870\ud56d\uc774 \uc874\uc7ac\ud558\ub294 \uacbd\uc6b0\uc5d0\ub9cc \uc81c\ud55c\uc801\uc73c\ub85c \uc778\uc815\ub41c\ub2e4.",
          "rationale": "\uae30\ubcf8\uad8c\uc740 \uad6d\uac00 \ubc95\ub960\ub85c \ucc98\ubc8c \uc870\ud56d\uc744 \ub9cc\ub4e4\uc5b4\uc57c \uc778\uc815\ub418\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ud5cc\ubc95\uc5d0 \uc758\ud574 \uadfc\ubcf8\uc801\uc73c\ub85c \ubcf4\uc7a5\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubaa8\ub4e0 \uc778\uac04\uc758 \uad8c\ub9ac\ub97c \ud5cc\ubc95 \uc870\ud56d\uc5d0 \uc804\ubd80 \ub098\uc5f4\ud558\uae30 \uc5b4\ub835\ub2e4\ub294 \ud604\uc2e4\uc801 \ud55c\uacc4\ub97c \uc5b4\ub5bb\uac8c \ubcf4\uc644\ud558\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud5cc\ubc95 \uc81c37\uc870 \uc81c2\ud56d\uc5d0 \uba85\uc2dc\ub41c \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c \uc81c\ud55c \uc870\uac74\uacfc \ud55c\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uac00 \uc548\uc804 \ubcf4\uc7a5, \uc9c8\uc11c \uc720\uc9c0, \uacf5\uacf5\ubcf5\ub9ac\ub97c \uc704\ud574 \ud544\uc694\ud55c \uacbd\uc6b0\uc5d0 \ud55c\ud558\uc5ec \ubc95\ub960\ub85c\uc368 \uc81c\ud55c\ud560 \uc218 \uc788\uc9c0\ub9cc \ubcf8\uc9c8\uc801\uc778 \ub0b4\uc6a9\uc740 \uce68\ud574\ud560 \uc218 \uc5c6\ub2e4.",
          "rationale": "\uae30\ubcf8\uad8c \uc81c\ud55c\uc740 \uba85\ud655\ud55c 3\uac00\uc9c0 \ubaa9\uc801, \uad6d\ud68c\uac00 \uc81c\uc815\ud55c '\ubc95\ub960'\uc774\ub77c\ub294 \ud615\uc2dd, \uadf8\ub9ac\uace0 '\ubcf8\uc9c8\uc801 \ub0b4\uc6a9 \uce68\ud574 \uae08\uc9c0'\ub77c\ub294 \ud55c\uacc4\ub97c \uc900\uc218\ud574\uc57c \ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud589\uc815\ubd80\uc758 \uae34\uae09\uc131 \ud310\ub2e8\uc5d0 \ub530\ub77c \ub300\ud1b5\ub839\ub839\uc774\ub098 \ubd80\ub839 \ub4f1 \ud589\uc815 \uc785\ubc95\uc73c\ub85c \uc5b8\uc81c\ub4e0\uc9c0 \uc9c1\uc811 \uc81c\ud55c\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\uae30\ubcf8\uad8c \uc81c\ud55c\uc740 \ud589\uc815\ubd80\uc758 \uba85\ub839\uc774 \uc544\ub2c8\ub77c \uad6d\ubbfc\uc758 \ub300\ud45c \uae30\uad00\uc778 \uad6d\ud68c\uac00 \uc81c\uc815\ud55c '\ubc95\ub960'\ub85c\uc368\ub9cc \uac00\ub2a5\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uacf5\uacf5\ubcf5\ub9ac\ub77c\ub294 \ubaa9\uc801\uc774 \ub2ec\uc131\ub41c\ub2e4\uba74 \uae30\ubcf8\uad8c\uc758 \ubcf8\uc9c8\uc801\uc778 \ub0b4\uc6a9\uae4c\uc9c0\ub3c4 \uc804\uba74 \uae08\uc9c0\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\uae30\ubcf8\uad8c\uc744 \uc81c\ud55c\ud558\ub294 \uacbd\uc6b0\uc5d0\ub3c4 \uc790\uc720\uc640 \uad8c\ub9ac\uc758 \ubcf8\uc9c8\uc801\uc778 \ub0b4\uc6a9\uc740 \uce68\ud574\ud560 \uc218 \uc5c6\ub3c4\ub85d \ud5cc\ubc95\uc774 \uc81c\ud55c\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac1c\uc778\uc758 \uae30\ubcf8\uad8c \ud589\uc0ac\uac00 \ud0c0\uc778\uc758 \uad8c\ub9ac\ub97c \uce68\ud574\ud558\ub354\ub77c\ub3c4 \uad6d\uac00 \uad8c\ub825\uc740 \uae30\ubcf8\uad8c\uc744 \uc77c\uccb4 \uc81c\ud55c\ud560 \uc218 \uc5c6\ub2e4.",
          "rationale": "\uacf5\ub3d9\uccb4 \uc774\uc775\uc774\ub098 \ud0c0\uc778\uc758 \uae30\ubcf8\uad8c \uce68\ud574\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \uacbd\uc6b0 \ubc95\ub960\ub85c\uc368 \uae30\ubcf8\uad8c\uc744 \uc81c\ud55c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uae30\ubcf8\uad8c\uc744 \uc81c\ud55c\ud560 \uc218 \uc788\ub294 3\uac00\uc9c0 \ubaa9\uc801, \uc81c\uc815 \ud615\uc2dd(\uc8fc\uccb4), \uadf8\ub9ac\uace0 \uce68\ud574\ud560 \uc218 \uc5c6\ub294 \ud55c\uacc4\ub97c \uad6c\uccb4\uc801\uc73c\ub85c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc778\uad8c \ubcf4\uc7a5\uc744 \uc704\ud55c \ud5cc\ubc95\uc0c1\uc758 \uc81c\ub3c4 \uc911 \ud558\ub098\uc778 '\uc601\uc7a5\uc8fc\uc758'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uccb4\ud3ec, \uad6c\uc18d, \uc555\uc218, \uc218\uc0c9 \uc2dc \uc801\ubc95\ud55c \uc808\ucc28\uc5d0 \ub530\ub77c \uac80\uc0ac\uc758 \uccad\uad6c\uc5d0 \uc758\ud574 \ubc95\uad00\uc774 \ubc1c\ubd80\ud55c \uc601\uc7a5\uc744 \uc81c\uc2dc\ud574\uc57c \ud558\ub294 \uc6d0\uce59\uc774\ub2e4.",
          "rationale": "\uc601\uc7a5\uc8fc\uc758\ub294 \uc218\uc0ac \uae30\uad00\uc758 \uc790\uc758\uc801\uc778 \uac15\uc81c \ucc98\ubd84\uc744 \ub9c9\uae30 \uc704\ud574 \uac80\uc0ac\uc758 \uccad\uad6c\uc640 \ubc95\uad00\uc758 \ubc1c\ubd80 \uc808\ucc28\ub97c \uac70\uce58\ub3c4\ub85d \uaddc\uc815\ud55c \uc790\uc720\uad8c \ubcf4\uc7a5 \uc7a5\uce58\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubc94\uc8c4 \ud610\uc758\uac00 \uc0c1\ub2f9\ud55c \ud53c\uc758\uc790\uc5d0 \ub300\ud574 \uacbd\ucc30\uad00\uc774 \ud604\uc7a5\uc5d0\uc11c \uc989\uc2dc \uc790\uccb4\uc801\uc73c\ub85c \uc601\uc7a5\uc744 \uc791\uc131\ud574 \uc9d1\ud589\ud558\ub294 \uc81c\ub3c4\uc774\ub2e4.",
          "rationale": "\uc601\uc7a5\uc740 \uc218\uc0ac \uae30\uad00(\uacbd\ucc30\u00b7\uac80\uc0ac)\uc774 \uc2a4\uc2a4\ub85c \ubc1c\ubd80\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc911\ub9bd\uc801\uc778 \ubc95\uad00\uc774 \ubc1c\ubd80\ud574\uc57c \ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc5b5\uc6b8\ud558\uac8c \uad6c\uae08\ub418\uc5c8\ub358 \ud53c\uace0\uc778\uc774 \ubb34\uc8c4 \ud310\uacb0\uc744 \ubc1b\uc558\uc744 \ub54c \uad6d\uac00\uc5d0 \ubb3c\uc9c8\uc801 \ubcf4\uc0c1\uc744 \uc694\uad6c\ud560 \uc218 \uc788\ub294 \uc6d0\uce59\uc774\ub2e4.",
          "rationale": "\ubb34\uc8c4 \ud310\uacb0\uc744 \ubc1b\uc740 \uc790\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc740 \uc601\uc7a5\uc8fc\uc758\uac00 \uc544\ub2cc '\ud615\uc0ac \ubcf4\uc0c1 \uc81c\ub3c4'\uc5d0 \ub300\ud55c \uc124\uba85\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uae30\ubcf8\uad8c\uc744 \uce68\ud574\ub2f9\ud55c \uad6d\ubbfc\uc774 \ub300\ubc95\uc6d0\uc5d0 \uc9c1\uc811 \ucc98\ubd84\uc758 \ucde8\uc18c\ub97c \uad6c\ud558\ub294 \ubc95\ub960 \uad6c\uc81c \uc218\ub2e8\uc774\ub2e4.",
          "rationale": "\uc601\uc7a5\uc8fc\uc758\ub294 \ud615\uc0ac \uc808\ucc28\uc5d0\uc11c \uc2e0\uccb4\uc758 \uc790\uc720 \ub4f1\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uc218\uc0ac \uc808\ucc28\uc0c1\uc758 \ubc95\uc801 \uc6d0\uce59\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc218\uc0ac \uae30\uad00\uc774 \uc2e0\uccb4\ub098 \uc7ac\uc0b0\uc744 \uac15\uc81c\ub85c \uc81c\ud55c\ud560 \ub54c \ub204\uad6c\uc758 \ud310\ub2e8\uacfc \ubc1c\ubd80 \uc808\ucc28\ub97c \uac70\uccd0\uc57c \ud558\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud5cc\ubc95\uc7ac\ud310\uc18c\uc5d0\uc11c \ub2f4\ub2f9\ud558\ub294 \uc8fc\uc694 \uc2ec\ud310 \uc911 '\uc704\ud5cc \ubc95\ub960 \uc2ec\ud310'\uacfc '\ud5cc\ubc95\uc18c\uc6d0 \uc2ec\ud310'\uc758 \ucc28\uc774\uc810\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc704\ud5cc \ubc95\ub960 \uc2ec\ud310\uc740 \uc7ac\ud310\uc758 \uc804\uc81c\uac00 \ub41c \ubc95\ub960\uc758 \uc704\ud5cc\uc131\uc744 \ud310\ub2e8\ud558\uace0, \ud5cc\ubc95\uc18c\uc6d0 \uc2ec\ud310\uc740 \uacf5\uad8c\ub825\uc5d0 \uc758\ud55c \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c \uce68\ud574 \uc5ec\ubd80\ub97c \ud310\ub2e8\ud55c\ub2e4.",
          "rationale": "\uc704\ud5cc \ubc95\ub960 \uc2ec\ud310\uc740 \ubc95\uc6d0\uc758 \uc7ac\ud310 \uc9c4\ud589 \uc911 \ud574\ub2f9 \ubc95\ub960\uc758 \ud5cc\ubc95 \uc704\ubc18 \uc5ec\ubd80\ub97c \uac00\ub9ac\uba70, \ud5cc\ubc95\uc18c\uc6d0\uc740 \ubc95\ub960\uc774\ub098 \uacf5\uad8c\ub825 \ud589\uc0ac\ub85c \uae30\ubcf8\uad8c\uc744 \uce68\ud574\ub2f9\ud55c \uad6d\ubbfc\uc774 \uc9c1\uc811 \uccad\uad6c\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc704\ud5cc \ubc95\ub960 \uc2ec\ud310\uc740 \uad6d\ubbfc\uc774 \uc9c1\uc811 \uccad\uad6c\ud558\uba70, \ud5cc\ubc95\uc18c\uc6d0 \uc2ec\ud310\uc740 \uad6d\ud68c\uac00 \ud5cc\ubc95\uc7ac\ud310\uc18c\uc5d0 \uc81c\uccad\ud55c\ub2e4.",
          "rationale": "\uad6d\ubbfc\uc774 \uc9c1\uc811 \uae30\ubcf8\uad8c \uad6c\uc81c\ub97c \uc704\ud574 \uccad\uad6c\ud558\ub294 \uac83\uc740 \ud5cc\ubc95\uc18c\uc6d0 \uc2ec\ud310\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc704\ud5cc \ubc95\ub960 \uc2ec\ud310\uc740 \ub300\ubc95\uc6d0\uc774 \ucd5c\uc885 \ub2f4\ub2f9\ud558\uace0, \ud5cc\ubc95\uc18c\uc6d0 \uc2ec\ud310\ub9cc \ud5cc\ubc95\uc7ac\ud310\uc18c\uac00 \uc804\ub2f4\ud55c\ub2e4.",
          "rationale": "\ub450 \uc2ec\ud310 \ubaa8\ub450 \ub300\ubc95\uc6d0\uc774 \uc544\ub2cc \ub3c5\ub9bd\ub41c \uae30\uad00\uc778 \ud5cc\ubc95\uc7ac\ud310\uc18c\uc5d0\uc11c \ub2f4\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub450 \uc2ec\ud310 \ubaa8\ub450 \ubc95\uc6d0\uc758 \ud310\uacb0\uc5d0 \ubd88\ubcf5\ud560 \ub54c \uad6d\ubbfc\uc774 \ub300\ubc95\uc6d0\uc5d0 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc0c1\uace0\ud558\ub294 \uc808\ucc28\uc774\ub2e4.",
          "rationale": "\ud5cc\ubc95\uc7ac\ud310\uc18c\uc758 \uc2ec\ud310\uc740 \uc77c\ubc18 \ubc95\uc6d0\uc758 \uc7ac\ud310 \uc0c1\uc18c \uc808\ucc28\uc640 \ubcc4\ub3c4\ub85c \ud5cc\ubc95\uc744 \uae30\uc900\uc73c\ub85c \ubd84\uc7c1\uc744 \uc2ec\ud310\ud558\ub294 \uc81c\ub3c4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "'\uc7ac\ud310\uc758 \uc804\uc81c\uac00 \ub41c \ubc95\ub960\uc758 \uc704\ud5cc\uc131 \ud310\ub2e8'\uacfc '\uacf5\uad8c\ub825\uc73c\ub85c \uc778\ud55c \uae30\ubcf8\uad8c \uc9c1\uc811 \uad6c\uc81c'\ub77c\ub294 \uac01\uac01\uc758 \ub300\uc0c1\uc744 \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub300\ud55c\ubbfc\uad6d\uc758 \uad8c\ub825 \ubd84\ub9bd \uad6c\uc870\uc5d0\uc11c \uc785\ubc95\ubd80(\uad6d\ud68c)\uac00 \ud589\uc815\ubd80(\uc815\ubd80)\ub098 \uc0ac\ubc95\ubd80(\ubc95\uc6d0)\ub97c \uacac\uc81c\ud558\uae30 \uc704\ud574 \ud589\uc0ac\ud558\ub294 \uad8c\ud55c\uc758 \uc870\ud569\uc73c\ub85c \uc633\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud589\uc815\ubd80\uc5d0 \ub300\ud574 \uad6d\uc815 \uac10\uc0ac \ubc0f \uc870\uc0ac\uad8c \ud589\uc0ac / \uc0ac\ubc95\ubd80\uc5d0 \ub300\ud574 \ub300\ubc95\uc6d0\uc7a5 \ubc0f \ub300\ubc95\uad00 \uc784\uba85 \ub3d9\uc758\uad8c \ud589\uc0ac",
          "rationale": "\uc785\ubc95\ubd80\ub294 \ud589\uc815\ubd80\ub97c \uad6d\uc815 \uac10\uc0ac \ubc0f \uc870\uc0ac\uad8c\uc73c\ub85c \uacac\uc81c\ud558\uace0, \uc0ac\ubc95\ubd80\uc758 \uc218\uc7a5 \ubc0f \ub300\ubc95\uad00 \uc784\uba85\uc5d0 \ub300\ud574 \ub3d9\uc758\uad8c\uc744 \ud589\uc0ac\ud558\uc5ec \uacac\uc81c\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud589\uc815\ubd80\uc5d0 \ub300\ud574 \ubc95\ub960\uc548 \uac70\ubd80\uad8c \ud589\uc0ac / \uc0ac\ubc95\ubd80\uc5d0 \ub300\ud574 \uba85\ub839\u00b7\uaddc\uce59\u00b7\ucc98\ubd84 \uc2ec\uc0ac\uad8c \ud589\uc0ac",
          "rationale": "\ubc95\ub960\uc548 \uac70\ubd80\uad8c\uc740 \ud589\uc815\ubd80\uac00 \uc785\ubc95\ubd80\ub97c \uacac\uc81c\ud558\ub294 \uad8c\ud55c\uc774\uba70, \uba85\ub839\u00b7\uaddc\uce59\u00b7\ucc98\ubd84 \uc2ec\uc0ac\uad8c\uc740 \uc0ac\ubc95\ubd80\uac00 \ud589\uc815\ubd80\ub97c \uacac\uc81c\ud558\ub294 \uad8c\ud55c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud589\uc815\ubd80\uc5d0 \ub300\ud574 \uc704\ud5cc \ubc95\ub960 \uc2ec\ud310 \uc81c\uccad\uad8c \ud589\uc0ac / \uc0ac\ubc95\ubd80\uc5d0 \ub300\ud574 \ub300\ubc95\uad00 \uc9c1\uc811 \uc784\uba85\uad8c \ud589\uc0ac",
          "rationale": "\uc704\ud5cc \ubc95\ub960 \uc2ec\ud310 \uc81c\uccad\uad8c\uc740 \uc0ac\ubc95\ubd80(\ubc95\uc6d0)\uc758 \uad8c\ud55c\uc774\uba70, \ub300\ubc95\uad00 \uc784\uba85\uad8c\uc740 \ud589\uc815\ubd80(\ub300\ud1b5\ub839)\uc758 \uad8c\ud55c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud589\uc815\ubd80\uc5d0 \ub300\ud574 \ub300\ubc95\uc6d0\uc7a5 \uc784\uba85\uad8c \ud589\uc0ac / \uc0ac\ubc95\ubd80\uc5d0 \ub300\ud574 \uad6d\uc815 \uac10\uc0ac\uad8c \ud589\uc0ac",
          "rationale": "\ub300\ubc95\uc6d0\uc7a5 \uc784\uba85\uad8c\uc740 \ud589\uc815\ubd80\uc758 \uad8c\ud55c\uc774\uba70, \uc785\ubc95\ubd80\ub294 \uc774\uc5d0 \ub300\ud55c '\uc784\uba85 \ub3d9\uc758\uad8c'\uc744 \uac00\uc9d1\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uad6d\ud68c\uac00 \uc815\ubd80\ub97c \uc0c1\ub300\ub85c \uad6d\uc815\uc744 \uc870\uc0ac\ud558\uace0, \ub300\ubc95\uc6d0\uc7a5 \uc784\uba85 \uc2dc \uac16\uace0 \uc788\ub294 \uc2b9\uc778 \uc808\ucc28 \uad8c\ud55c\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uae30\ubcf8\uad8c \uc911 \uce68\ud574\ub41c \uad8c\ub9ac\ub97c \uad6c\uc81c\ubc1b\uae30 \uc704\ud55c \uc218\ub2e8\uc801\u00b7\uc808\ucc28\uc801 \uc131\uaca9\uc744 \uc9c0\ub2cc '\uccad\uad6c\uad8c'\uc744 \ubcf4\uc7a5\ud558\uace0\uc790 \ud5cc\ubc95\uc5d0 \uaddc\uc815\ub41c \uc81c\ub3c4\uc801 \uc7a5\uce58\ub9cc\uc744 \ubcf4\uae30\uc5d0\uc11c \ubaa8\ub450 \uace0\ub978 \uac83\uc740?\n\n[\ubcf4\uae30]\n\u3131. \uc2e0\uc18d\ud55c \uc7ac\ud310\uc744 \ubc1b\uc744 \uad8c\ub9ac \ubc0f \uacf5\uac1c \uc7ac\ud310\uc744 \ubc1b\uc744 \uad8c\ub9ac\n\u3134. \uc131\ubcc4\u00b7\uc885\uad50\u00b7\uc0ac\ud68c\uc801 \uc2e0\ubd84\uc5d0 \ub530\ub978 \ucc28\ubcc4 \uae08\uc9c0 \uba85\uc2dc\n\u3137. \ud615\uc0ac \ubcf4\uc0c1 \uc81c\ub3c4 \ubc0f \uad6d\uac00 \ubc30\uc0c1 \uc81c\ub3c4\n\u3139. \uadfc\ub85c\uc790\uc758 \uace0\uc6a9 \uc99d\uc9c4 \ubc0f \uc801\uc815 \uc784\uae08 \ubcf4\uc7a5 \uc758\ubb34",
      "answerOptions": [
        {
          "text": "\u3131, \u3137",
          "rationale": "\uc7ac\ud310\uc744 \ubc1b\uc744 \uad8c\ub9ac, \ud615\uc0ac \ubcf4\uc0c1 \ubc0f \uad6d\uac00 \ubc30\uc0c1 \uc81c\ub3c4\ub294 \uccad\uad6c\uad8c\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \ub300\ud45c\uc801\uc778 \uc81c\ub3c4\uc801 \uc7a5\uce58\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\u3131, \u3134",
          "rationale": "\u3134\uc758 \ucc28\ubcc4 \uae08\uc9c0\ub294 \ud3c9\ub4f1\uad8c\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uc81c\ub3c4\uc801 \uc7a5\uce58\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\u3134, \u3139",
          "rationale": "\u3134\uc740 \ud3c9\ub4f1\uad8c, \u3139\uc740 \uc0ac\ud68c\uad8c\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uaddc\uc815\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\u3137, \u3139",
          "rationale": "\u3139\uc740 \uc0ac\ud68c\uad8c\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uc81c\ub3c4\uc801 \uc7a5\uce58\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uad8c\ub9ac\uac00 \uce68\ud574\ub418\uc5c8\uc744 \ub54c \uc774\ub97c \uad6c\uc81c\ubc1b\uae30 \uc704\ud55c '\uc218\ub2e8'\uc73c\ub85c\uc11c \uc81c\uacf5\ub418\ub294 \uc81c\ub3c4\uc5d0 \ud574\ub2f9\ud558\ub294\uc9c0 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ud310\ub840 \uc0ac\ub840\uc5d0\uc11c \uccad\uad6c\uc778\ub4e4\uc774 \ud5cc\ubc95\uc7ac\ud310\uc18c\uc758 \uc704\ud5cc \uacb0\uc815\uc744 \ud1b5\ud574 \ucd5c\uc885\uc801\uc73c\ub85c \uad6c\uc81c\ubc1b\uc740 \uae30\ubcf8\uad8c\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n[\uc0ac\ub840]\n\ube44\uc778\uac00 \ub300\uc548 \ud559\uad50 \uc878\uc5c5 \ud6c4 \uac80\uc815\uace0\uc2dc\ub85c \uace0\uad50 \ud559\ub825\uc744 \ucde8\ub4dd\ud55c \uccad\uad6c\uc778\ub4e4\uc740 \uad6d\ub9bd \uad50\uc721 \ub300\ud559\uad50\ub4e4\uc758 \uc218\uc2dc \ubaa8\uc9d1 \uc694\uac15\uc5d0\uc11c \uac80\uc815\uace0\uc2dc \ucd9c\uc2e0\uc790\uc758 \uc9c0\uc6d0 \uc790\uaca9\uc744 \uc81c\ud55c\ud55c \uac83\uc5d0 \ub300\ud574 \ud5cc\ubc95\uc18c\uc6d0 \uc2ec\ud310\uc744 \uccad\uad6c\ud558\uc600\ub2e4. \ud5cc\ubc95\uc7ac\ud310\uc18c\ub294 \ud574\ub2f9 \uc218\uc2dc \uc694\uac15\uc774 \uac80\uc815\uace0\uc2dc \ucd9c\uc2e0\uc790\uc758 \ub300\ud559 \uc785\ud559 \uae30\ud68c\ub97c \uc77c\ub960\uc801\uc73c\ub85c \ubc15\ud0c8\ud558\uc5ec \ud5cc\ubc95\uc5d0 \uc704\ubc18\ub41c\ub2e4\uace0 \uacb0\uc815\ud558\uc600\ub2e4.",
      "answerOptions": [
