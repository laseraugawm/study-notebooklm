{
  "title": "\uacbd\uc81c \ud034\uc988",
  "questions": [
    {
      "question": "\ud55c\uad6d\uc740\ud589\uc774 \uc778\ud50c\ub808\uc774\uc158\uc744 \uc5b5\uc81c\ud558\uae30 \uc704\ud574 \uae30\uc900 \uae08\ub9ac\ub97c \uc778\uc0c1\ud560 \ub54c, \uae08\uc735 \uc2dc\uc7a5\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub300\ucd9c \uae08\ub9ac\uac00 \uc0c1\uc2b9\ud558\uc5ec \uae30\uc5c5\uc758 \uc790\uae08 \uc870\ub2ec \ube44\uc6a9\uc774 \ub298\uc5b4\ub098\uace0 \uc8fc\uc2dd \uc2dc\uc7a5\uc5d0 \ub300\uccb4\ub85c \ubd80\uc815\uc801\uc778 \uc601\ud5a5\uc744 \uc900\ub2e4.",
          "isCorrect": true,
          "rationale": "\uae08\ub9ac\uac00 \uc624\ub974\uba74 \ub300\ucd9c \uc774\uc790 \ubd80\ub2f4\uc774 \ucee4\uc838 \uae30\uc5c5 \uc2e4\uc801\uc5d0 \uc545\uc601\ud5a5\uc744 \uc8fc\uace0, \uc608\uae08 \uc218\uc775\uc131\uc774 \uc62c\ub77c \uc0c1\ub300\uc801\uc73c\ub85c \uc8fc\uc2dd\uc758 \ud22c\uc790 \ub9e4\ub825\uc774 \uac10\uc18c\ud558\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc608\uae08 \uae08\ub9ac\uac00 \uc0c1\uc2b9\ud568\uc5d0 \ub530\ub77c \uc8fc\uc2dd\uacfc \uc608\uae08 \uac04\uc758 \uc218\uc775\uc131 \uaca9\ucc28\uac00 \ud655\ub300\ub418\uc5b4 \uc8fc\uc2dd \ud22c\uc790 \ub9e4\ub825\uc774 \uc99d\uac00\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc608\uae08 \uae08\ub9ac\uac00 \uc624\ub974\uba74 \uc8fc\uc2dd\uacfc\uc758 \uc218\uc775\uc131 \uaca9\ucc28\uac00 \uc904\uc5b4\ub4e4\uc5b4 \uc8fc\uc2dd \uc2dc\uc7a5\uc758 \uc0c1\ub300\uc801\uc778 \ub9e4\ub825\uc774 \uc624\ud788\ub824 \uac10\uc18c\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc2dc\uc911 \uc740\ud589\uc758 \ub300\ucd9c \uae08\ub9ac\uac00 \ud558\ub77d\ud558\uc5ec \uae30\uc5c5\uc758 \uc2e4\uc801\uc774 \uac1c\uc120\ub418\uace0 \uc8fc\uac00\uac00 \ub300\ud3ed \uc0c1\uc2b9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud55c\uad6d\uc740\ud589\uc774 \uae30\uc900 \uae08\ub9ac\ub97c \uc62c\ub9ac\uba74 \uc2dc\uc911 \uc740\ud589\ub3c4 \ub300\ucd9c \uae08\ub9ac\ub97c \uc62c\ub9ac\ubbc0\ub85c \uae30\uc5c5\uc758 \uc790\uae08 \uc870\ub2ec \ube44\uc6a9\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc608\uae08 \uae08\ub9ac \uc778\ud558\ub85c \uc778\ud574 \uac1c\uc778 \uc790\uae08\uc774 \uc608\uae08\uc5d0\uc11c \uc774\ud0c8\ud558\uc5ec \uc8fc\uc2dd \uc2dc\uc7a5\uc73c\ub85c \uc720\uc785\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\uc900 \uae08\ub9ac\uac00 \uc778\uc0c1\ub418\uba74 \uc2dc\uc911 \uc740\ud589\uc758 \uc608\uae08 \uae08\ub9ac\ub3c4 \ud568\uaed8 \uc0c1\uc2b9\ud558\ubbc0\ub85c \uc608\uae08 \uae08\ub9ac\uac00 \uc778\ud558\ub41c\ub2e4\ub294 \uc124\uba85\uc740 \uc633\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uae08\ub9ac \uc778\uc0c1\uc740 \uc2dc\uc911 \uc740\ud589\uc758 \uc608\uae08 \ubc0f \ub300\ucd9c \uae08\ub9ac\ub97c \ud568\uaed8 \uc62c\ub9ac\ub294 \ud6a8\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4."
    },
    {
      "question": "2008\ub144 \uc138\uacc4 \uae08\uc735 \uc704\uae30\ub098 2011\ub144 \uc720\ub7fd \uc7ac\uc815 \uc704\uae30\uc640 \uac19\uc774 \uc138\uacc4 \uacbd\uc81c\uac00 \uae09\uaca9\ud788 \uce68\uccb4\ub420 \ub54c, \uac1c\uc778\uc758 \uc77c\ubc18\uc801\uc778 \uae08\uc735 \uc758\uc0ac \uacb0\uc815 \uacbd\ud5a5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc218\uc775\uc131\ubcf4\ub2e4 \uc790\uc0b0\uc758 \uc548\uc804\uc131\uacfc \uc720\ub3d9\uc131\uc5d0 \ucd08\uc810\uc744 \ub450\uace0 \uae08\uc735 \uc758\uc0ac\ub97c \uacb0\uc815\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uacbd\uae30 \uce68\uccb4\uae30\uc5d0\ub294 \uc790\uc0b0 \uc190\uc2e4 \uc704\ud5d8\uc774 \ucee4\uc9c0\ubbc0\ub85c \uc6d0\uae08\uc744 \uc548\uc804\ud558\uac8c \uc9c0\ud0a4\uace0 \uc989\uc2dc \ud604\uae08\ud654\ud560 \uc218 \uc788\ub294 \uc790\uc0b0\uc744 \uc120\ud638\ud558\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc548\uc804\uc131\ubcf4\ub2e4\ub294 \ub192\uc740 \uc218\uc775\ub960\uc744 \uae30\ub300\ud560 \uc218 \uc788\ub294 \uace0\uc704\ud5d8 \uc790\uc0b0\uc5d0 \ub300\ud55c \ud22c\uc790\ub97c \ub300\ud3ed \ub298\ub9b0\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uacc4 \uacbd\uc81c\uac00 \ubd88\uc548\uc815\ud55c \uc0c1\ud669\uc5d0\uc11c\ub294 \uc704\ud5d8\uc131\uc774 \ub192\uc740 \uace0\uc218\uc775 \uc0c1\ud488\ubcf4\ub2e4\ub294 \uc548\uc804\ud55c \uc790\uc0b0\uc5d0 \ub300\ud55c \uc120\ud638\ub3c4\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\ubb34\uc5ed \uc758\uc874\ub3c4\uac00 \ub192\uace0 \ud658\uc728 \ubcc0\ub3d9\uc131\uc774 \ud070 \uc704\ud5d8 \uad6d\uac00\uc758 \uc8fc\uc2dd\uc744 \uc9d1\uc911\uc801\uc73c\ub85c \ub9e4\uc218\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacbd\uc81c \uc704\uae30 \uc0c1\ud669\uc5d0\uc11c\ub294 \ubcc0\ub3d9\uc131\uc774 \ud070 \uc790\uc0b0\ubcf4\ub2e4 \uc548\uc815\uc801\uc778 \uae08\uc735 \uc0c1\ud488\uc744 \ucc3e\ub294 \uac83\uc774 \uc77c\ubc18\uc801\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud604\uae08\uc73c\ub85c \ubc14\uafb8\uae30 \uc5b4\ub824\uc6b4 \uc7a5\uae30 \ubd80\ub3d9\uc0b0 \uc790\uc0b0\uc5d0 \ub300\ubd80\ubd84\uc758 \uc790\uae08\uc744 \ubc30\ubd84\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd88\ud655\uc2e4\uc131\uc774 \ub192\uc740 \uacbd\uc81c \uc0c1\ud669\uc5d0\uc11c\ub294 \ud544\uc694\ud560 \ub54c \ubc14\ub85c \ud604\uae08\ud654\ud560 \uc218 \uc788\ub294 \uc720\ub3d9\uc131 \ub192\uc740 \uc790\uc0b0\uc744 \uc6b0\uc120\uc2dc\ud558\uac8c \ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc704\uae30 \uc0c1\ud669\uc5d0\uc11c\ub294 \uc218\uc775\uc744 \ub9ce\uc774 \ub0b4\ub294 \uac83\ubcf4\ub2e4 \uc790\uc0b0\uc744 \uc9c0\ud0a4\uace0 \ud604\uae08\ud654\ud558\uae30 \uc27d\uac8c \uc720\uc9c0\ud558\ub294 \uac83\uc774 \uc911\uc694\ud574\uc9d1\ub2c8\ub2e4."
    },
    {
      "question": "1970\ub144\ub300 \uc911\ub3d9 \uc9c0\uc5ed\uc758 \uc815\uc138 \ubd88\uc548\uacfc \uc774\ub780 \ud601\uba85\uc774 \uc138\uacc4 \uacbd\uc81c \ubc0f \uae08\uc735 \ud658\uacbd\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc774\ub780\uc758 \uc11d\uc720 \uc0dd\uc0b0 \ucd95\uc18c\ub85c \uad6d\uc81c \uc720\uac00\uac00 \ud3ed\ub4f1\ud558\uba70 \ub450 \ucc28\ub840\uc758 \uc11d\uc720 \ud30c\ub3d9\uc774 \ubc1c\uc0dd\ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc815\uce58\uc801 \ubd88\uc548\uc73c\ub85c \uc774\ub780\uc774 \uc11d\uc720 \uc0dd\uc0b0\uc744 \uc904\uc774\uc790 \uacf5\uae09 \ubd80\uc871\uc73c\ub85c \uc720\uac00\uac00 \ud3ed\ub4f1\ud558\uba70 \uc138\uacc4\uc801\uc778 \uc11d\uc720 \ud30c\ub3d9\uc744 \uc77c\uc73c\ucf30\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc11d\uc720 \uac00\uaca9\uc758 \uc9c0\uc18d\uc801\uc778 \ud558\ub77d\uc73c\ub85c \uc778\ud574 \uc138\uacc4\uc801\uc778 \uacbd\uae30 \ud638\ud669\uacfc \ubb3c\uac00 \uc548\uc815\uc774 \uc720\ub3c4\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\ub780 \ud601\uba85\uacfc \uc911\ub3d9 \uc815\uc138 \ubd88\uc548\uc740 \uc6d0\uc720 \uacf5\uae09\uc744 \uc904\uc5ec \uad6d\uc81c \uc720\uac00\ub97c \ud3ed\ub4f1\uc2dc\ucf30\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc911\ub3d9 \uad6d\uac00\ub4e4\uc758 \ubb34\uc5ed \uc758\uc874\ub3c4\uac00 \ub0ae\uc544\uc838 \uc138\uacc4 \uc8fc\uc2dd \uc2dc\uc7a5\uc774 \uc815\uce58\uc801 \uc694\uc778\uc73c\ub85c\ubd80\ud130 \uc644\uc804 \ud0c8\ud53c\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc911\ub3d9\uc758 \uc815\uce58\uc801 \ubd88\uc548\uc740 \uc720\uac00 \ud3ed\ub4f1\uc744 \uac70\uccd0 \uc804 \uc138\uacc4 \uae08\uc735 \uc2dc\uc7a5\uc5d0 \ub9c9\ub300\ud55c \uc545\uc601\ud5a5\uc744 \ubbf8\ucce4\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc911\ub3d9 \uc9c0\uc5ed\uc758 \uc815\uc138 \ubd88\uc548\uc73c\ub85c \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uc0b0\uc5c5\uc774 \uc989\uc2dc \uc11d\uc720 \uc2dc\uc7a5\uc744 \uc644\uc804\ud788 \ub300\uccb4\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "1970\ub144\ub300 \uc11d\uc720 \ud30c\ub3d9 \ub2f9\uc2dc \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\uac00 \uc11d\uc720\ub97c \uc644\uc804\ud788 \ub300\uccb4\ud558\uc9c0\ub294 \ubabb\ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc911\ub3d9 \uc815\uc138\uc758 \ubd88\uc548\uc740 \uc6d0\uc720 \uacf5\uae09 \ucd95\uc18c\ub85c \uc774\uc5b4\uc838 \uc6d0\uc790\uc7ac \uac00\uaca9\uc5d0 \ud070 \uc601\ud5a5\uc744 \uc8fc\uc5c8\uc2b5\ub2c8\ub2e4."
    },
    {
      "question": "\ub7ec\uc2dc\uc544-\uc6b0\ud06c\ub77c\uc774\ub098 \uc804\uc7c1 \ubc1c\ubc1c \ub2f9\uc2dc \ub098\ud0c0\ub09c \uad6d\ub0b4\uc678 \uacbd\uc81c \uc9c0\ud45c \ubc0f \uae08\uc735 \ud658\uacbd\uc758 \ubcc0\ud654\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uc81c \uc5d0\ub108\uc9c0\uc640 \uc6d0\uc790\uc7ac \uac00\uaca9\uc774 \uc0c1\uc2b9\ud558\uba70 \uc778\ud50c\ub808\uc774\uc158 \uc555\ub825\uc774 \ucee4\uc9c0\uace0 \uad6d\ub0b4 \uc8fc\uac00 \uc9c0\uc218\ub294 \ud558\ub77d\ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc804\uc7c1\uacfc \uadf8\uc5d0 \ub530\ub978 \uc81c\uc7ac\ub85c \uc5d0\ub108\uc9c0\u00b7\uc6d0\uc790\uc7ac \uac00\uaca9\uc774 \uae09\ub4f1\ud574 \ubb3c\uac00 \uc0c1\uc2b9 \uc555\ub825\uc774 \ucee4\uc84c\uc73c\uba70, \ubd88\ud655\uc2e4\uc131 \uc99d\ub300\ub85c \uc8fc\uac00 \uc9c0\uc218\ub294 \ud558\ub77d\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uc81c \uc720\uac00\uac00 \uae09\uaca9\ud788 \ud558\ub77d\ud558\uc5ec \uad6d\ub0b4 \uae30\uc5c5\uc758 \uc6d0\uac00 \ubd80\ub2f4\uc774 \uc904\uc5b4\ub4e4\uace0 \uc18c\ube44\uac00 \ud06c\uac8c \ud655\ub300\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub7ec\uc2dc\uc544-\uc6b0\ud06c\ub77c\uc774\ub098 \uc804\uc7c1 \ubc1c\ubc1c \ub2f9\uc2dc \uad6d\uc81c \uc720\uac00\ub294 \uacf5\uae09 \ubd88\uc548\uc73c\ub85c \uc778\ud574 \ud3ed\ub4f1\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc804\uc7c1\uc73c\ub85c \uc778\ud574 \uae08\uc735 \uc2dc\uc7a5\uc758 \ud22c\uba85\uc131\uc774 \ud655\ubcf4\ub418\uc5b4 \uae30\uc5c5\ub4e4\uc758 \ud22c\uc790 \ud65c\ub3d9\uc774 \ub300\ud3ed \uc99d\uac00\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804\uc7c1\uc740 \uad6d\uc81c \uae08\uc735 \uc2dc\uc7a5\uc758 \ubd88\ud655\uc2e4\uc131\uc744 \ub192\uc5ec \ud22c\uc790\uc790\uc640 \uae30\uc5c5\ub4e4\uc774 \ud22c\uc790\ub97c \uc704\ucd95\uc2dc\ud0a4\uac8c \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\ub0b4 \uc8fc\uac00 \uc9c0\uc218(\ucf54\uc2a4\ud53c)\uc640 \uad6d\uc81c \uc720\uac00\uac00 \ubaa8\ub450 \uc9c0\uc18d\uc801\uc778 \ub3d9\ubc18 \uc0c1\uc2b9\uc138\ub97c \ub098\ud0c0\ub0c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804\uc7c1 \ubc1c\ubc1c \uc804\ud6c4\ub85c \uc6d0\uac00 \ubd80\ub2f4 \uc99d\ub300\uc640 \ubd88\ud655\uc2e4\uc131 \ub54c\ubb38\uc5d0 \uc8fc\uac00 \uc9c0\uc218\ub294 \ud558\ub77d\ud558\uace0 \uad6d\uc81c \uc720\uac00\ub294 \uc0c1\uc2b9\ud558\ub294 \ubc18\ub300 \uc591\uc0c1\uc744 \ubcf4\uc600\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc9c0\uc815\ud559\uc801 \ub9ac\uc2a4\ud06c\uac00 \ubc1c\uc0dd\ud558\uba74 \uc5d0\ub108\uc9c0\ub97c \ube44\ub86f\ud55c \uc6d0\uc790\uc7ac \uac00\uaca9\uc740 \uc624\ub974\uace0 \uc8fc\uc2dd \uc2dc\uc7a5\uc740 \uc704\ucd95\ub418\ub294 \uacbd\ud5a5\uc774 \uc788\uc2b5\ub2c8\ub2e4."
    },
    {
      "question": "\uad50\uacfc\uc11c\uc5d0 \uc81c\uc2dc\ub41c '\uc5d4\uc800(\u5186\u4f4e)' \ud604\uc0c1\uc774 \ud55c\uad6d \uc18c\ube44\uc790\uc758 \ud589\ub3d9 \ubc0f \uc5ec\ud589 \uc2dc\uc7a5\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5d4\ud654 \uac00\uce58\uac00 \uc0c1\ub300\uc801\uc73c\ub85c \ub0ae\uc544\uc838 \uc5ec\ud589 \uc2dc \ubb3c\uac00 \ubd80\ub2f4\uc774 \uc904\uc5b4\ub4e6\uc5d0 \ub530\ub77c \uc77c\ubcf8\uc774 \uc778\uae30 \uc5ec\ud589\uc9c0\ub85c \uae09\ubd80\uc0c1\ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc5d4\ud654 \uac00\uce58 \ud558\ub77d\uc740 \uc5d4\ud654 \ud658\uc728 \ud558\ub77d\uc744 \uc758\ubbf8\ud558\ubbc0\ub85c \ud55c\uad6d \uc5ec\ud589\uac1d \uc785\uc7a5\uc5d0\uc11c \uc77c\ubcf8 \uc5ec\ud589 \ube44\uc6a9 \ubd80\ub2f4\uc774 \ub35c\ud574\uc838 \uc218\uc694\uac00 \uae09\uc99d\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc5d4\ud654 \uac00\uce58\uc758 \uae09\uc0c1\uc2b9\uc73c\ub85c \uc77c\ubcf8 \uc5ec\ud589 \ube44\uc6a9\uc774 \ub298\uc5b4\ub098 \uc5ec\ud589 \uc218\uc694\uac00 \ub3d9\ub0a8\uc544\uc2dc\uc544\ub85c\ub9cc \uc804\uba74 \uad50\uccb4\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5d4\uc800 \ud604\uc0c1\uc740 \uc5d4\ud654 \uac00\uce58\uac00 \ub5a8\uc5b4\uc9c4 \uc0c1\ud0dc\ub97c \uc758\ubbf8\ud558\ubbc0\ub85c \uc5ec\ud589 \ube44\uc6a9 \ubd80\ub2f4\uc744 \uc904\uc5ec\uc8fc\ub294 \uc694\uc778\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc5d4\ud654 \uac00\uce58 \ubcc0\ub3d9\uc5d0 \ub530\ub77c \ubbf8\uc8fc\ub098 \uc720\ub7fd \ub4f1 \uba3c \uac70\ub9ac \uc5ec\ud589\uc9c0 \uc120\ud0dd \ube44\uc728\uc774 \uc808\ub300\uc801 1\uc704\ub97c \uae30\ub85d\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc81c\uc2dc\ub41c \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \ud574\uc678 \ud56d\uacf5\uad8c \uc608\uc57d \uc21c\uc704 1~3\uc704\uac00 \ubaa8\ub450 \uc77c\ubcf8 \ub3c4\uc11c \ub3c4\uc2dc(\uc624\uc0ac\uce74, \ub3c4\ucfc4, \ud6c4\ucfe0\uc624\uce74)\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc77c\ubcf8\uc758 \ud654\ud3d0 \uac00\uce58\uac00 \ub5a8\uc5b4\uc9c0\uba74\uc11c \ud55c\uad6d\uc778\uc758 \ubaa8\ub4e0 \ud574\uc678 \uc5ec\ud589 \uc218\uc694\uac00 \uc644\uc804\ud788 \uc911\ub2e8\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5d4\uc800\ub85c \uc778\ud574 \ubd80\ub2f4\uc774 \uc904\uc5b4\ub4e0 \uc77c\ubcf8 \ub4f1 \uadfc\uac70\ub9ac \ud574\uc678 \uc5ec\ud589\uc9c0\uc758 \uc778\uae30\uac00 \ud06c\uac8c \uc0c1\uc2b9\ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud2b9\uc815 \uad6d\uac00 \ud654\ud3d0\uc758 \uac00\uce58\uac00 \ub5a8\uc5b4\uc9c0\uba74 \uadf8 \ub098\ub77c\ub85c \uc5ec\ud589\ud560 \ub54c \ub290\ub07c\ub294 \uac00\uaca9 \ubd80\ub2f4\uc774 \uac10\uc18c\ud569\ub2c8\ub2e4."
    },
    {
      "question": "2020\ub144 \uc804 \uc138\uacc4\uc801\uc778 \uac10\uc5fc\ubcd1(\ucf54\ub85c\ub09819) \uc720\ud589\uc774 \uae08\uc735 \ud658\uacbd\uacfc \uac01 \uc0b0\uc5c5\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubc30\ub2ec \ud50c\ub7ab\ud3fc, \uc628\ub77c\uc778 \uad50\uc721 \uc11c\ube44\uc2a4, \ubc14\uc774\uc624 \uad00\ub828 \uc5c5\uc885\uc740 \ubc18\uc0ac \uc774\uc775\uc744 \uc5bb\uc5b4 \ud22c\uc790 \uc218\uc775\ub960\uc774 \uc62c\ub77c\uac00\uae30\ub3c4 \ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac10\uc5fc\ubcd1 \uc720\ud589\uc73c\ub85c \ube44\ub300\uba74 \uc11c\ube44\uc2a4 \ubc0f \ubc14\uc774\uc624 \uad00\ub828 \uc0b0\uc5c5 \uc218\uc694\uac00 \ud06c\uac8c \uc62c\ub77c \ud574\ub2f9 \ubd84\uc57c \ud22c\uc790\uc790\ub4e4\uc774 \uc774\ub4dd\uc744 \ubcf4\uc558\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ube44\ub300\uba74 \ubb38\ud654\uc758 \ud655\uc0b0\uc73c\ub85c \uc778\ud574 \uc628\ub77c\uc778 \uad50\uc721 \ubc0f \ubc30\ub2ec \ud50c\ub7ab\ud3fc \uae30\uc5c5\uc758 \uc8fc\uac00\uac00 \ud06c\uac8c \ud558\ub77d\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube44\ub300\uba74 \uc11c\ube44\uc2a4\ub294 \uac10\uc5fc\ubcd1 \uc720\ud589 \uae30\uac04 \ub3d9\uc548 \uc218\ud61c\ub97c \uc785\uc5b4 \uae30\uc5c5 \uac00\uce58\uc640 \uc8fc\uac00\uac00 \uc0c1\uc2b9\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud56d\uacf5 \ubc0f \uad00\uad11 \uad00\ub828 \uae30\uc5c5\uc758 \uc8fc\uac00\uc640 \ucc44\uad8c \uac00\uaca9\uc774 \ud3ed\ub4f1\ud558\uc5ec \uad00\ub828 \ud22c\uc790\uc790\ub4e4\uc774 \ud070 \uc774\ub4dd\uc744 \uc62c\ub838\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\ub3d9 \uc81c\ud55c\uacfc \uc5ec\ud589 \uac10\uc18c\ub85c \ud56d\uacf5 \ubc0f \uad00\uad11 \uc5c5\uacc4\ub294 \uc2e4\uc801 \ud0c0\uaca9\uc744 \ubc1b\uc544 \uc8fc\uac00\uc640 \ucc44\uad8c \uac00\uaca9\uc774 \ud558\ub77d\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80\uc758 \uc7ac\ub09c \uc9c0\uc6d0\ucc45 \ub355\ubd84\uc5d0 \uac10\uc5fc\ubcd1 \uc720\ud589 \uae30\uac04 \ub3d9\uc548 \uac1c\uc778 \ubc0f \ubc95\uc778\uc758 \ud30c\uc0b0 \uc2e0\uccad \uac74\uc218\uac00 \uae09\uac10\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc81c\uc2dc\ub41c \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \ucf54\ub85c\ub09819 \ubc1c\uc0dd \ud6c4 1\ub144 \ub3d9\uc548 \uc804\uad6d \ubc95\uc6d0\uc5d0 \uc811\uc218\ub41c \ubc95\uc778 \ubc0f \uac1c\uc778 \ud30c\uc0b0 \uc2e0\uccad\uc740 10% \uc774\uc0c1 \uae09\uc99d\ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub300\uba74 \ud65c\ub3d9 \uc911\uc2ec \uc0b0\uc5c5\uacfc \ube44\ub300\uba74\u00b7\ubc14\uc774\uc624 \uc911\uc2ec \uc0b0\uc5c5\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc774 \uc11c\ub85c \uc0c1\ubc18\ub418\uac8c \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4."
    },
    {
      "question": "\uae30\ud6c4 \uc704\uae30 \uadf9\ubcf5\uc744 \uc704\ud55c \uc800\ud0c4\uc18c \ub179\uc0c9 \uc131\uc7a5 \uc815\ucc45\uc774 \uac15\uc870\ub418\uba74\uc11c \uae08\uc735 \uc2dc\uc7a5\uc5d0\uc11c \ub098\ud0c0\ub09c \ubcc0\ud654\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uce5c\ud658\uacbd \uc5d0\ub108\uc9c0 \uad00\ub828 \uae30\uc5c5\uc5d0 \ub300\ud55c \ud22c\uc790 \uc218\uc775\ub960\uc740 \ub192\uc544\uc9c4 \ubc18\uba74 \uc628\uc2e4\uac00\uc2a4 \ub2e4\ubc30\ucd9c \uae30\uc5c5\uc758 \ud22c\uc790 \uc218\uc775\ub960\uc740 \ub5a8\uc5b4\uc84c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud658\uacbd \uc815\ucc45 \uac15\ud654\ub85c \ub179\uc0c9 \uc0b0\uc5c5 \uae30\uc5c5\ub4e4\uc774 \uc8fc\ubaa9\ubc1b\uc544 \ud22c\uc790 \uc218\uc775\ub960\uc774 \uc62c\ub77c\uac14\uc9c0\ub9cc, \uc628\uc2e4\uac00\uc2a4\ub97c \ub9ce\uc774 \ubc30\ucd9c\ud558\ub294 \uae30\uc5c5\uc758 \uc218\uc775\ub960\uc740 \uc0c1\ub300\uc801\uc73c\ub85c \uc800\ud558\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc628\uc2e4\uac00\uc2a4\ub97c \ub9ce\uc774 \ubc30\ucd9c\ud558\ub294 \uc804\ud1b5 \uc81c\uc870\uc5c5 \uae30\uc5c5\uc5d0 \uc790\uae08\uc774 \uc9d1\uc911\ub418\uc5b4 \ucc44\uad8c \uac00\uaca9\uc774 \uae09\uc0c1\uc2b9\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c\ub7c9\uc774 \ub9ce\uc740 \uae30\uc5c5\uc740 \uaddc\uc81c \uac15\ud654\uc640 \uce5c\ud658\uacbd \uc804\ud658 \uc694\uad6c\ub85c \uc778\ud574 \ud22c\uc790 \uc218\uc775\ub960\uc774 \ud558\ub77d\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uce5c\ud658\uacbd \uc5d0\ub108\uc9c0 \uae30\uc5c5\uc758 \uc790\uae08 \uc870\ub2ec \ube44\uc6a9\uc774 \uc99d\uac00\ud558\uc5ec \ud22c\uc790 \uc2dc\uc7a5\uc5d0\uc11c \uc9c0\uc18d\uc801\uc73c\ub85c \uc678\uba74\ubc1b\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc800\ud0c4\uc18c \ub179\uc0c9 \uc131\uc7a5 \uae30\uc870 \uc18d\uc5d0\uc11c \uce5c\ud658\uacbd \uc5d0\ub108\uc9c0 \uc0b0\uc5c5\uc740 \ud22c\uc790\uc790\ub4e4\uc758 \uc8fc\ubaa9\uc744 \ubc1b\uc73c\uba70 \uc131\uc7a5\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\ud6c4 \uc704\uae30 \ub300\uc751 \ubc29\uc548\uc73c\ub85c \uc778\ud574 \ubaa8\ub4e0 \uae08\uc735 \uc790\uc0b0\uc758 \uc548\uc804\uc131\uacfc \uc720\ub3d9\uc131 \uc9c0\ud45c\uac00 \ubb34\uc758\ubbf8\ud574\uc84c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\ud6c4 \uc704\uae30\ub294 \ud2b9\uc815 \uc0b0\uc5c5\uacfc \uae30\uc5c5\uc758 \uc218\uc775\uc131\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\ucce4\uc744 \ubfd0 \uae08\uc735 \uc790\uc0b0 \uad00\ub9ac\uc758 \uae30\ubcf8 \uc6d0\uce59\uc744 \ubb34\ub825\ud654\ud558\uc9c0\ub294 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uce5c\ud658\uacbd\u00b7\uc800\ud0c4\uc18c \ud750\ub984\uc5d0 \ubd80\ud569\ud558\ub294 \uae30\uc5c5\uacfc \uadf8\ub807\uc9c0 \uc54a\uc740 \uae30\uc5c5\uc5d0 \ub300\ud55c \uc2dc\uc7a5\uc758 \ud3c9\uac00 \ubc0f \uc218\uc775\uc131\uc774 \uc5c7\uac08\ub838\uc2b5\ub2c8\ub2e4."
    },
    {
      "question": "\ub2e4\uc74c \uacbd\uc81c \uac1c\ub150 \ubc0f \uc6a9\uc5b4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uac00 \uc2e0\uc778\ub3c4\ub294 \uc815\uce58\u00b7\uacbd\uc81c\u00b7\uc0ac\ud68c \ubd84\uc57c\ub97c \uc885\ud569\uc801\uc73c\ub85c \ud3c9\uac00\ud558\uc5ec \ud574\ub2f9 \uad6d\uac00\uc5d0 \ub300\ud55c \ub300\uc678 \uc2e0\ub8b0\ub3c4\ub97c \ub098\ud0c0\ub0b4\ub294 \uc9c0\ud45c\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uad6d\uac00 \uc2e0\uc778\ub3c4\ub294 \ud55c \uad6d\uac00\uc758 \ub2e4\uc591\ud55c \uc694\uc18c\ub97c \uc885\ud569 \ud3c9\uac00\ud574 \uc678\ubd80\uc5d0\uc11c \uadf8 \ub098\ub77c\ub97c \uc5bc\ub9c8\ub098 \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294\uc9c0 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
