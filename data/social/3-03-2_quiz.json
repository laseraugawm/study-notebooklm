        {
          "text": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc73c\ub85c \uc815\uce58\uc801 \uc548\uc815\uc744 \uc774\ub8ec \uc601\uad6d\uc740 \uacbd\uc81c \ubd88\uc548\uc73c\ub85c \uc0b0\uc5c5 \ud601\uba85\uc774 \uac00\uc7a5 \ub2a6\uac8c \uc77c\uc5b4\ub0ac\ub2e4.",
