        {
          "text": "9\u00b711 \ud14c\ub7ec\ub098 \uc804\uc7c1 \uac19\uc740 \uc815\uce58\uc801 \ud63c\ub780\uc740 \uad6d\ub0b4 \uc8fc\uac00 \uc9c0\uc218\ub098 \uad6d\uc81c \uc720\uac00\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud14c\ub7ec\ub098 \uc804\uc7c1 \ub4f1 \uc2ec\uac01\ud55c \uc815\uce58\uc801 \ud63c\ub780\uc740 \uad6d\uc81c \uc720\uac00 \uc0c1\uc2b9, \ubb3c\uac00 \ubd88\uc548, \uc8fc\uac00 \ud3ed\ub77d \ub4f1 \uae08\uc735 \ud658\uacbd\uc5d0 \uc9c1\uc811\uc801\uc778 \ud0c0\uaca9\uc744 \uc90d\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc815\uce58\uac00 \uc548\uc815\ub41c \ud658\uacbd\uacfc \ubd88\uc548\uc815\ud55c \ud658\uacbd\uc5d0\uc11c \ud22c\uc790\uc790\ub4e4\uc774 \uc6b0\uc120\uc2dc\ud558\ub294 \uc790\uc0b0 \uad00\ub9ac\uc758 \ubaa9\ud45c\uac00 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4."
    },
    {
      "question": "\ubcf5\uc7a1\ud558\uac8c \ubcc0\ud654\ud558\ub294 \uae08\uc735 \ud658\uacbd \uc18d\uc5d0\uc11c \uac1c\uc778\uc758 \uc62c\ubc14\ub978 \uc790\uc0b0 \uad00\ub9ac \ubc0f \uae08\uc735 \uc0dd\ud65c \uc790\uc138\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc124\uc815\ud574 \ub454 \uc7ac\ubb34 \ubaa9\ud45c\uc640 \uae08\uc735 \uc0dd\ud65c \uc124\uacc4\uc758 \uc801\uc808\uc131\uc744 \uafb8\uc900\ud788 \uc810\uac80\ud558\uace0 \uc774\ub97c \ubc14\ud0d5\uc73c\ub85c \uc218\uc815\ud574 \ub098\uac04\ub2e4.",
          "isCorrect": true,
          "rationale": "\uae08\uc735 \ud658\uacbd\uc744 \ub458\ub7ec\uc2fc \uc694\uc778\ub4e4\uc740 \ub9e4\uc6b0 \ub2e4\uc591\ud558\uace0 \uac00\ubcc0\uc801\uc774\ubbc0\ub85c \uc790\uc2e0\uc758 \uc7ac\ubb34 \ubaa9\ud45c\uc640 \uc124\uacc4\ub97c \uc815\uae30\uc801\uc73c\ub85c \ud655\uc778\ud558\uace0 \uc810\uac80\u00b7\uc218\uc815\ud574\uc57c \ud569\ub2c8\ub2e4."
