        {
          "text": "\ubb34\uc5ed \uc758\uc874\ub3c4\ub294 \ud55c \uad6d\uac00\uc758 \uad6d\ub0b4 \ucd1d\uc0dd\uc0b0(GDP)\uc5d0\uc11c \uc218\ucd9c\uc561\uc774 \ucc28\uc9c0\ud558\ub294 \ube44\uc728\ub9cc\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb34\uc5ed \uc758\uc874\ub3c4\ub294 GDP\uc5d0\uc11c '\uc218\ucd9c\uc561\uacfc \uc218\uc785\uc561\uc758 \ud569'\uc774 \ucc28\uc9c0\ud558\ub294 \ube44\uc728\uc744 \ub73b\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc720\ub3d9\uc131\uc740 \ud22c\uc790 \uc6d0\uae08\uacfc \uc774\uc790\uac00 \uc190\uc2e4\ub418\uc9c0 \uc54a\uace0 \ud655\uc2e4\ud558\uac8c \ubcf4\uc7a5\ub418\ub294 \uc548\uc804\ud55c \uc815\ub3c4\ub9cc\uc744 \uac00\ub9ac\ud0a8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc6d0\uae08 \uc190\uc2e4\uc774 \uc5c6\ub294 \uc131\uc9c8\uc740 '\uc548\uc804\uc131'\uc774\uba70, \ud544\uc694\ud560 \ub54c \uc27d\uac8c \ud604\uae08\uc73c\ub85c \ubc14\uafc0 \uc218 \uc788\ub294 \uc815\ub3c4\ub294 '\uc720\ub3d9\uc131'\uc785\ub2c8\ub2e4."
        },
        {
          "text": "2008\ub144 \uc138\uacc4 \uae08\uc735 \uc704\uae30\ub294 \uc720\ub7fd \uc7ac\uc815 \uc704\uae30\uac00 \ubbf8\uad6d \uc8fc\ud0dd \uc2dc\uc7a5\uc73c\ub85c \uc804\ud30c\ub418\uba74\uc11c \uc2dc\uc791\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "2008\ub144 \uc138\uacc4 \uae08\uc735 \uc704\uae30\ub294 \ubbf8\uad6d\uc758 \uc9d1\uac12 \uae09\ub77d \ubc0f \ub300\ud615 \ud22c\uc790 \uc740\ud589 \ud30c\uc0b0\uc5d0\uc11c \uc2dc\uc791\ud558\uc5ec \uc804 \uc138\uacc4\ub85c \ud655\uc0b0\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud55c \uad6d\uac00\uc758 \uc804\ubc18\uc801\uc778 \uc0c1\ud0dc\ub97c \ud3c9\uac00\ud558\uc5ec \ub300\uc678\uc801\uc73c\ub85c \uc5bc\ub9c8\ub9cc\ud07c \ubbff\uc744 \uc218 \uc788\ub294\uc9c0 \ub098\ud0c0\ub0b4\ub294 \uc9c0\ud45c\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc815\uce58\uc801 \uc0c1\ud669\uc758 \ubcc0\ud654\uac00 \uae08\uc735 \uc758\uc0ac \uacb0\uc815\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc815\uce58\uac00 \uc548\uc815\ub418\uba74 \uacbd\uc81c \uc131\uc7a5 \uac00\ub2a5\uc131\uc774 \ub192\uc544\uc838 \uc218\uc775\uc131 \uc704\uc8fc\uc758 \uc801\uadf9\uc801\uc778 \ud22c\uc790\ub97c \uace0\ub824\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc815\uce58\uc801 \uc548\uc815\uc774 \ubc14\ud0d5\uc774 \ub418\uba74 \uacbd\uc81c \ubd88\uc548\uc815\uc131\uc774 \uc904\uc5b4\ub4e4\uc5b4 \ud22c\uc790\uc790\ub4e4\uc774 \uc801\uadf9\uc801\uc73c\ub85c \uc218\uc775\uc744 \ucd94\uad6c\ud558\ub294 \uae08\uc735 \uacb0\uc815\uc744 \ub0b4\ub9ac\uae30 \uc6a9\uc774\ud574\uc9d1\ub2c8\ub2e4."
