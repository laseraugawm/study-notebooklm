        {
          "text": "\ud55c \ubc88 \uc218\ub9bd\ud55c \uc7ac\ubb34 \ubaa9\ud45c\uc640 \uc124\uacc4\ub294 \uc5b4\ub5a0\ud55c \uc815\uce58\u00b7\uacbd\uc81c\uc801 \ubcc0\ub3d9\uc774 \uc0dd\uae30\ub354\ub77c\ub3c4 \uc808\ub300\ub85c \ubcc0\uacbd\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac70\uc2dc\uc801 \uae08\uc735 \ud658\uacbd\uc774 \ubcc0\ud654\ud568\uc5d0 \ub530\ub77c \uac1c\uc778\ub3c4 \uae30\uc874\uc758 \ubaa9\ud45c\uc640 \uacc4\ud68d\uc744 \uc720\uc5f0\ud558\uac8c \uc810\uac80\ud558\uace0 \uc218\uc815\ud574\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uacbd\uae30 \uce68\uccb4\uac00 \uc608\uc0c1\ub418\uba74 \ubb34\uc870\uac74 \uace0\uc704\ud5d8\u00b7\uace0\uc218\uc775 \uc8fc\uc2dd\ud615 \uc790\uc0b0\uc5d0 \uc790\uae08\uc744 \ubab0\uc544\ub123\uc5b4 \uc804\uba74 \ud22c\uc790\ud55c\ub2e4.",
