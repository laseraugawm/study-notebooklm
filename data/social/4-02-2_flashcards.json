{
  "title": "\uad6d\uc81c\uc0ac\ud68c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub298\ub0a0 \uc9c0\uad6c\ucd0c \uc804\uccb4\uc758 \uc0c1\ud638 \uc758\uc874\uc131\uc774 \ub192\uc544\uc9c0\uba74\uc11c \ub098\ud0c0\ub09c \uad6d\uc81c \uc0ac\ud68c \uad50\ub958\uc758 \uc8fc\uc694 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uce58, \uacbd\uc81c, \uc0ac\ud68c, \ubb38\ud654 \ub4f1 \ub9ce\uc740 \ubd84\uc57c\uc5d0\uc11c \ubc00\uc811\ud558\uac8c \uad50\ub958\ud558\uba70, \uc5ec\ub7ec \ud589\uc704 \uc8fc\uccb4 \uac04\uc758 \uac08\ub4f1\uacfc \ud611\ub825\uc774 \ub3d9\uc2dc\uc5d0 \ub098\ud0c0\ub09c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc0ac\ud68c\ub97c '\ud604\uc2e4\uc801\uc73c\ub85c \ubc14\ub77c\ubcf4\ub294 \uad00\uc810(\ud604\uc2e4\uc8fc\uc758)'\uc5d0\uc11c\ub294 \uad6d\uac00\uc758 \ud589\ub3d9 \ub3d9\uae30\ub97c \uc5b4\ub5bb\uac8c \ubcf4\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uad6d\uac00\uac00 \uc790\uad6d\uc758 \uc774\uc775(\uad6d\uc775)\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ucd94\uad6c\ud558\uba70 \uc11c\ub85c \uacbd\uc7c1\ud55c\ub2e4\uace0 \ubcf8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\uc2e4\uc8fc\uc758 \uad00\uc810\uc5d0 \ub530\ub97c \ub54c \uad6d\uc81c \uc0ac\ud68c\uc5d0\uc11c \uac08\ub4f1\uc774\ub098 \ubd84\uc7c1\uc774 \ubc1c\uc0dd\ud558\ub294 \uadfc\ubcf8 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uad6d\uac00\uac00 \uc790\uad6d\uc758 \uc774\uc775\uc744 \ucd5c\uc6b0\uc120\uc73c\ub85c \ucd94\uad6c\ud558\uba70 \uacbd\uc7c1\ud558\ub294 \uacfc\uc815\uc5d0\uc11c \uc774\ud574\uad00\uacc4\uac00 \ucda9\ub3cc\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc0ac\ud68c\uc5d0\uc11c \uac08\ub4f1\uc744 \uc77c\uc73c\ud0a4\ub294 \ubcf5\ud569\uc801 \uc6d0\uc778 5\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ud1a0, \uc790\uc6d0, \ubbfc\uc871, \uc885\uad50, \ubb38\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc0ac\ud68c\ub97c '\uc774\uc0c1\uc801\uc73c\ub85c \ubc14\ub77c\ubcf4\ub294 \uad00\uc810(\uc774\uc0c1\uc8fc\uc758)'\uc5d0\uc11c \ubc14\ub77c\ubcf4\ub294 \uad6d\uac00\uc758 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uad6d\uac00\uac00 \ud569\ub9ac\uc801\uc73c\ub85c \ud589\ub3d9\ud560 \uc218 \uc788\uc73c\uba70, \uc138\uacc4 \ud3c9\ud654\uc640 \uc548\uc815\uc744 \uc704\ud574 \uc11c\ub85c \ud611\ub825\ud560 \uc218 \uc788\ub2e4\uace0 \ubcf8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc0c1\uc8fc\uc758 \uad00\uc810\uc5d0\uc11c \uc624\ub298\ub0a0 \uad6d\uc81c \uc0ac\ud68c\uc758 \uc5f0\ub300\uc640 \ud611\ub825\uc774 \ubc18\ub4dc\uc2dc \ud544\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc7c1, \uc804\uc5fc\ubcd1, \uc790\uc5f0\uc7ac\ud574 \ub4f1 \uc5b4\ub290 \ud55c \uad6d\uac00\uc758 \ub178\ub825\ub9cc\uc73c\ub85c\ub294 \ud574\uacb0\ud558\uae30 \uc5b4\ub824\uc6b4 \ubb38\uc81c\ub4e4\uc774 \uc99d\uac00\ud558\uace0 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc0ac\ud68c\ub97c \ubc14\ub77c\ubcf4\ub294 '\ud604\uc2e4\uc8fc\uc758 \uad00\uc810'\uacfc '\uc774\uc0c1\uc8fc\uc758 \uad00\uc810'\uc758 \ud575\uc2ec \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\uc2e4\uc8fc\uc758\ub294 \uc790\uad6d \uc774\uc775 \ucd94\uad6c\uc640 \uacbd\uc7c1\uc5d0 \ub530\ub978 \uac08\ub4f1\uc5d0 \uc8fc\ubaa9\ud558\ub294 \ubc18\uba74, \uc774\uc0c1\uc8fc\uc758\ub294 \ud569\ub9ac\uc801 \ud589\ub3d9\uc744 \ubc14\ud0d5\uc73c\ub85c \ud55c \ud3c9\ud654\uc640 \ud611\ub825 \uac00\ub2a5\uc131\uc5d0 \uc8fc\ubaa9\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a8\uc911\uad6d\ud574\uac00 \uc5ec\ub7ec \uad6d\uac00 \uac04 \uac08\ub4f1\uc758 \ub300\uc0c1\uc774 \ub418\ub294 \uc8fc\uc694 \uac00\uce58 \ubc0f \uc774\uc810 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc57d 2,500\uc885\uc758 \ud574\uc591 \uc0dd\ubb3c \uc11c\uc2dd\n2. \uc6d0\uc720 \ubc0f \ucc9c\uc5f0\uac00\uc2a4 \ub4f1 \ud48d\ubd80\ud55c \uc9c0\ud558\uc790\uc6d0 \ub9e4\uc7a5\n3. \uc804\ub7b5\uc801\uc73c\ub85c \uac00\uce58\uac00 \ub9e4\uc6b0 \ub192\uc740 \ud574\uc0c1 \uad50\ud1b5\ub85c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a8\uc911\uad6d\ud574\uc0c1\uc758 \uc601\uc720\uad8c \ubc0f \ud574\uc591 \uad00\ud560\uad8c\uc744 \ub450\uace0 \ub300\ub9bd\ud558\ub294 \ub300\ud45c\uc801\uc778 \uad6d\uac00\ub4e4\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uad6d, \ubca0\ud2b8\ub0a8, \ud544\ub9ac\ud540, \ub9d0\ub808\uc774\uc2dc\uc544, \ube0c\ub8e8\ub098\uc774 \ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a8\uc911\uad6d\ud574 \ubd84\uc7c1 \uacfc\uc815\uc5d0\uc11c \uc911\uad6d\uc774 \ud589\ud55c \uc8fc\uc694 \ud589\ub3d9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a8\uc911\uad6d\ud574\uc0c1\uc758 \uc778\uacf5 \uc12c\uc744 \uac74\uc124\ud558\uace0 \uc774\ub97c \uad70\uc0ac \uc2dc\uc124\ub85c \ubcc0\ubaa8\uc2dc\ud0a4\uba70 \uc601\uc720\uad8c\uc744 \uac15\ud654\ud558\ub824 \ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce90\ub098\ub2e4 \ud018\ubca1\uc8fc \uc0b0\ubd88 \uc0ac\ub840\uc5d0\uc11c \uc0b0\ubd88 \uc5f0\uae30\uac00 \ucd08\ub798\ud55c \ud53c\ud574\uc758 \ubc94\uc704\ub294 \uc5b4\ub5a0\ud588\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uacbd\uc744 \ub118\uc5b4 \ubbf8\uad6d\uc5d0 \uc2ec\uac01\ud55c \ub300\uae30 \uc624\uc5fc\uc744 \ucd08\ub798\ud588\uc744 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc218\ucc9c km \ub5a8\uc5b4\uc9c4 \uc720\ub7fd\uc5d0\uae4c\uc9c0 \uc601\ud5a5\uc744 \ubbf8\ucce4\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce90\ub098\ub2e4 \uc0b0\ubd88 \uc9c4\ud654\ub97c \uc704\ud574 \uc9c0\uc6d0\uc5d0 \ub098\uc120 \ub300\ud45c\uc801\uc778 \uad6d\uac00 \ubc0f \uad6c\ud638 \ub2e8\uccb4 \uc0ac\ub840\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uad6d(\uc18c\ubc29\uad00 600\uc5ec \uba85 \ubc0f \uc18c\ubc29 \ud56d\uacf5\uae30 \uae09\ud30c), \ud504\ub791\uc2a4, \ud3ec\ub974\ud22c\uac08, \uc5d0\uc2a4\ud30c\ub0d0, \ub0a8\uc544\ud504\ub9ac\uce74 \uacf5\ud654\uad6d, \uc624\uc2a4\ud2b8\ub808\uc77c\ub9ac\uc544, \ub300\ud55c\ubbfc\uad6d(\ud574\uc678 \uae34\uae09 \uad6c\ud638\ub300) \ub4f1\uc758 \uc18c\ubc29\uad00 \ubc0f \uad6c\ud638\ub300 \ud30c\uacac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce90\ub098\ub2e4 \uc0b0\ubd88 \uc9c4\ud654 \ud611\ub825 \uc0ac\ub840\uac00 \ubcf4\uc5ec\uc8fc\ub294 \uc624\ub298\ub0a0 \uc9c0\uad6c\ucd0c \uc7ac\ub09c \ud574\uacb0\uc758 \uc2dc\uc0ac\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uacbd\uc744 \ub118\uc5b4 \ubc1c\uc0dd\ud558\ub294 \ub300\uaddc\ubaa8 \ud658\uacbd \uc7ac\ub09c\uc740 \ub2e8\uc77c \uad6d\uac00\uc758 \ub178\ub825\ub9cc\uc73c\ub85c \ud574\uacb0\ud560 \uc218 \uc5c6\uc73c\uba70 \uad6d\uc81c \uc0ac\ud68c\uc758 \uc5f0\ub300\uc640 \ud611\ub825\uc774 \ud544\uc218\uc801\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub7ec\uc2dc\uc544\uc640 \uc77c\ubcf8\uc774 \uc601\ud1a0\uc5d0 \ub300\ud55c \uc601\uc720\uad8c\uc744 \uc8fc\uc7a5\ud558\uba70 \ub300\ub9bd\ud558\ub294 \ubd84\uc7c1\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a8\ucfe0\ub9b4 \uc5f4\ub3c4(\ubd81\ubc29 \uc601\ud1a0) \ubd84\uc7c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3ec\ud074\ub79c\ub4dc(\ub9d0\ube44\ub098\uc2a4) \uc81c\ub3c4\ub97c \ub458\ub7ec\uc2f8\uace0 \uc601\uc720\uad8c\uc744 \uc8fc\uc7a5\ud558\uba70 \ub300\ub9bd\ud558\ub294 \ub450 \uad6d\uac00\ub294 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub974\ud5e8\ud2f0\ub098\uc640 \uc601\uad6d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3ec\ud074\ub79c\ub4dc(\ub9d0\ube44\ub098\uc2a4) \uc81c\ub3c4 \ubd84\uc7c1\uc774 \uc77c\uc5b4\ub098\ub294 \uc704\uce58(\ud574\uc5ed)\ub294 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a8\ub300\uc11c\uc591"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\uc2a4\ud30c\ub0d0 \ub0b4\ubd80\uc5d0\uc11c \ubd84\ub9ac\uc8fc\uc758 \uc6b4\ub3d9\uc774 \uc9c4\ud589\ub418\ub294 \uc8fc\uccb4\uc640 \uadf8 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\uc2a4\ud30c\ub0d0 \ub0b4 \ubc14\uc2a4\ud06c \ubbfc\uc871\uc774 \uc790\uce58\ub97c \uc694\uad6c\ud558\uba70 \ubd84\ub9ac\uc8fc\uc758 \uc6b4\ub3d9\uc744 \uc9c4\ud589\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\uc0ac\ud558\ub77c \ubd84\uc7c1\uc5d0\uc11c \ub300\ub9bd\ud558\ub294 \ub450 \uc8fc\uccb4\uc640 \uac01\uac01\uc758 \uc8fc\uc7a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\ub85c\ucf54(\uc601\uc720\uad8c \uc8fc\uc7a5)\uc640 \ud604\uc9c0\uc778(\ub3c5\ub9bd \uc8fc\uc7a5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc2a4\ub77c\uc5d8-\ud314\ub808\uc2a4\ud0c0\uc778 \ubd84\uc7c1\uc758 \uc8fc\uc694 \ub300\ub9bd \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud314\ub808\uc2a4\ud0c0\uc778 \uc9c0\uc5ed\uc744 \ub458\ub7ec\uc2fc \uc774\uc2a4\ub77c\uc5d8\uacfc \ud314\ub808\uc2a4\ud0c0\uc778 \uac04\uc758 \uc601\ud1a0, \uc885\uad50, \ubbfc\uc871\uc801 \uac08\ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uad6d-\uc778\ub3c4 \ubd84\uc7c1\uc758 \ud575\uc2ec \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uad6d\uacfc \uc778\ub3c4\uc758 \uc601\ud1a0\uac00 \ub9de\ub2ff\uc740 \uc9c0\uc5ed\uc5d0\uc11c \uc11c\ub85c \ub2e4\ub978 \uad6d\uacbd\uc744 \uc8fc\uc7a5\ud558\uba70 \ub300\ub9bd\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub798 \uc9c0\ub3c4\ub97c \ucc38\uace0\ud560 \ub54c, '\ubbfc\uc871 \uc790\uce58 \ubc0f \ub3c5\ub9bd \uc694\uad6c'\uac00 \uc8fc\uc694 \uc6d0\uc778\uc774 \ub418\ub294 \ub300\ud45c\uc801\uc778 \ubd84\uc7c1 2\uac00\uc9c0\ub294?"
          },
          {
            "type": "image",
            "reference": "70706a8c-df16-4780-a391-a69b1848961b",
            "alt": "\uc138\uacc4\uc758 \uc8fc\uc694 \ubd84\uc7c1 \uc9c0\uc5ed \uc9c0\ub3c4"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc5d0\uc2a4\ud30c\ub0d0-\ubc14\uc2a4\ud06c \ubd84\ub9ac\uc8fc\uc758 \uc6b4\ub3d9 (\ubc14\uc2a4\ud06c \ubbfc\uc871\uc758 \uc790\uce58 \uc694\uad6c)\n2. \uc11c\uc0ac\ud558\ub77c \ubd84\uc7c1 (\ud604\uc9c0\uc778\uc758 \ub3c5\ub9bd \uc694\uad6c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub798 \uc9c0\ub3c4\ub97c \ucc38\uace0\ud560 \ub54c, \uad6d\uac00 \uac04 '\uc601\ud1a0 \uc601\uc720\uad8c \ub300\ub9bd'\uc774 \uba85\ud655\ud55c \ub300\ud45c\uc801\uc778 \ubd84\uc7c1 \uc0ac\ub840 3\uac00\uc9c0\uc640 \ub2f9\uc0ac\uad6d\uc740?"
          },
          {
            "type": "image",
            "reference": "70706a8c-df16-4780-a391-a69b1848961b",
            "alt": "\uc138\uacc4\uc758 \uc8fc\uc694 \ubd84\uc7c1 \uc9c0\uc5ed \uc9c0\ub3c4"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ub0a8\ucfe0\ub9b4 \uc5f4\ub3c4 \ubd84\uc7c1 (\ub7ec\uc2dc\uc544 - \uc77c\ubcf8)\n2. \ud3ec\ud074\ub79c\ub4dc \ubd84\uc7c1 (\uc544\ub974\ud5e8\ud2f0\ub098 - \uc601\uad6d)\n3. \uc911\uad6d-\uc778\ub3c4 \ubd84\uc7c1 (\uc911\uad6d - \uc778\ub3c4)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
