    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\ub974\ud06c\uc2a4\uc758 \uc0ac\ud68c\uc8fc\uc758 \ubd84\ubc30 \uc6d0\uce59\uc774 \uac00\uc84c\ub358 \uae0d\uc815\uc801 \ud6a8\uacfc\uc640 \ubd80\uc815\uc801 \uacb0\uacfc\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
