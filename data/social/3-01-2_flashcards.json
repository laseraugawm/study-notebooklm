        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u201c\ub2a5\ub825\uc5d0 \ub530\ub77c \uc77c\ud558\uace0, \ud544\uc694\uc5d0 \ub530\ub77c \ubd84\ubc30\ud55c\ub2e4.\u201d"
