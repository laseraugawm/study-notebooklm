      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae0d\uc815\uc801 \ud6a8\uacfc: \ubd84\ubc30\uc758 \ud615\ud3c9\uc131 \uc2e4\ud604\uc73c\ub85c \uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \uae30\ubcf8 \uc0dd\ud65c \ubcf4\uc7a5\n\ubd80\uc815\uc801 \uacb0\uacfc: \ub3d9\uae30 \ubd80\uc5ec \ubd80\uc871\uc73c\ub85c \uc9c0\uc2dc\ub41c \uc77c\ub9cc \uc218\ud589\ud558\uc5ec \uc0dd\uc0b0\uc131 \ub454\ud654 \ubc0f \uacbd\uc81c \ud65c\ub825 \uc800\ud558"
