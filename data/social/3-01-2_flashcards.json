    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc758 \uc694\uc18c\uc640 \uacc4\ud68d\uacbd\uc81c \uccb4\uc81c\uc758 \uc694\uc18c\ub97c \uc808\ucda9\ud558\uc5ec \uc6b4\uc6a9\ud558\ub294 \uacbd\uc81c \uccb4\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
