          {
            "type": "text",
            "content": "\uacc4\ud68d\uacbd\uc81c \uccb4\uc81c\uc5d0\uc11c \uadfc\ub85c \uc758\uc695\uc774 \uc800\ud558\ub418\uace0 \uacbd\uc81c\ud65c\ub3d9\uc758 \ud6a8\uc728\uc131\uc774 \ub5a8\uc5b4\uc9c0\ub294 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
