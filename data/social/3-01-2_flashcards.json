    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacc4\ud68d\uacbd\uc81c \uccb4\uc81c\uac00 \uac16\ub294 \ub300\ud45c\uc801\uc778 \uc7a5\uc810 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
