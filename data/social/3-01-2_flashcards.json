    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub298\ub0a0 \ub300\ubd80\ubd84\uc758 \uad6d\uac00\uac00 \ud63c\ud569 \uacbd\uc81c \uccb4\uc81c\ub97c \ucc44\ud0dd\ud558\uace0 \uc788\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
