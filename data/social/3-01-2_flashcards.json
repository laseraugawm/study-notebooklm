    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\ub974\ud06c\uc2a4(Marx, K.)\uac00 \uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c \uc18d \ubd84\ubc30\ub97c \ube44\ud310\ud558\uba70 \ucc9c\uba85\ud55c \uc0ac\ud68c\uc8fc\uc758 \ub178\ub3d9 \ubd84\ubc30\uc758 \uc6d0\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
