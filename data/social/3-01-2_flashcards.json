        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80\uac00 \uc18c\ube44\uc790\uc758 \ub2e4\uc591\ud558\uace0 \ubcc0\ud654\ud558\ub294 \uc695\uad6c\ub97c \ubaa8\ub450 \ubc18\uc601\ud558\uc5ec \uacc4\ud68d\uc744 \uc138\uc6b0\ub294 \ub370 \ud55c\uacc4\uac00 \uc788\ub2e4."
