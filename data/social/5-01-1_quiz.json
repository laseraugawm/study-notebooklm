{
  "title": "\uc138\uacc4\uc778\uad6c \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "18\uc138\uae30 \uc774\ud6c4 \uc138\uacc4 \uc778\uad6c\uac00 \uae09\uaca9\ud788 \uc99d\uac00\ud558\uac8c \ub41c \uc8fc\uc694 \ubc30\uacbd \ubc0f \uc694\uc778\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0b0\uc5c5 \ud601\uba85 \uc774\ud6c4 \uc758\ub8cc \uae30\uc220\uc758 \ubc1c\ub2ec\uacfc \uacf5\uacf5 \uc704\uc0dd \uc2dc\uc124 \uac1c\uc120\uc73c\ub85c \ud3c9\uade0 \uc218\uba85\uc774 \ub298\uc5b4\ub0ac\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc5c5 \ud601\uba85 \uc774\ud6c4 \uc758\ud559 \ubc1c\uc804\uacfc \uc704\uc0dd \uac1c\uc120\uc740 \uc0ac\ub9dd\ub960\uc744 \ub0ae\ucd94\uace0 \ud3c9\uade0 \uc218\uba85\uc744 \uc5f0\uc7a5\uc2dc\ucf1c \uae09\uaca9\ud55c \uc778\uad6c \uc99d\uac00\ub97c \uac00\uc838\uc628 \ud575\uc2ec \uc694\uc778\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ucd9c\uc0dd\uacfc \uc0ac\ub9dd\uc5d0 \uc758\ud55c \ubcc0\ub3d9\uc740 \uc0ac\ud68c\uc801 \uc694\uc778\uc5d0, \uc804\uc785\uacfc \uc804\ucd9c\uc5d0 \uc758\ud55c \ubcc0\ub3d9\uc740 \uc790\uc5f0\uc801 \uc694\uc778\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucd9c\uc0dd\uacfc \uc0ac\ub9dd\uc740 \uc778\uad6c \ubcc0\ub3d9\uc758 \uc790\uc5f0\uc801 \uc694\uc778\uc774\uba70, \uc774\uc804 \uac70\uc8fc\uc9c0\uc5d0\uc11c\uc758 \uc804\ucd9c\uacfc \uc0c8 \uac70\uc8fc\uc9c0\ub85c\uc758 \uc804\uc785\uc740 \uc778\uad6c\uc774\ub3d9\uc5d0 \ub530\ub978 \uc0ac\ud68c\uc801 \uc694\uc778\uc5d0 \ud574\ub2f9\ud558\ubbc0\ub85c \uc124\uba85\uc774 \uc11c\ub85c \ubc14\ub00c\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0b0\uc5c5\ud654\uac00 \uc77c\ucc0d \uc2dc\uc791\ub41c \uc120\uc9c4\uad6d\uc740 18\uc138\uae30 \ub9d0\uc5d0\uc11c 20\uc138\uae30 \ucd08\uae4c\uc9c0 \uc778\uad6c\uac00 \ube60\ub974\uac8c \uc99d\uac00\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc120\uc9c4\uad6d\uc740 \uc77c\ucc0d \uc2dc\uc791\ub41c \uc0b0\uc5c5\ud654 \uc601\ud5a5\uc73c\ub85c 18\uc138\uae30 \ub9d0\ubd80\ud130 20\uc138\uae30 \ucd08 \uc0ac\uc774 \uc0ac\ub9dd\ub960 \uac10\uc18c\uc5d0 \ub530\ub978 \uc778\uad6c \uae09\uc99d\uc744 \uacbd\ud5d8\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0b0\uc5c5\ud654\uac00 \ub2a6\uc740 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 \uc774\ud6c4\uc778 20\uc138\uae30 \uc911\ubc18\ubd80\ud130 \uc778\uad6c\uac00 \uae09\uaca9\ud788 \ub298\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 20\uc138\uae30 \uc911\ubc18 \uc774\ud6c4 \uc0ac\ub9dd\ub960\uc740 \ub0ae\uc544\uc84c\uc73c\ub098 \ub192\uc740 \ucd9c\uc0dd\ub960\uc774 \uc720\uc9c0\ub418\uba74\uc11c \uc778\uad6c\uac00 \uae09\uc99d\ud558\uc600\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc778\uad6c \ubcc0\ub3d9 \uc694\uc778\uc740 \uc0dd\ubb3c\ud559\uc801 \uc694\uc778(\ucd9c\uc0dd\u00b7\uc0ac\ub9dd)\uacfc \uacf5\uac04\uc801 \uc774\ub3d9 \uc694\uc778(\uc804\uc785\u00b7\uc804\ucd9c)\uc73c\ub85c \uad6c\ubd84\ub429\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc778\uad6c \ubcc0\ucc9c \ubaa8\ud615\uc758 \uac01 \ub2e8\uacc4\ubcc4 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "1\ub2e8\uacc4(\uace0\uc704 \uc815\uccb4)\ub294 \ucd9c\uc0dd\ub960\uacfc \uc0ac\ub9dd\ub960\uc774 \ubaa8\ub450 \ub192\uc544 \uc778\uad6c\uc758 \uc790\uc5f0 \uc99d\uac10\uc774 \uac70\uc758 \uc5c6\ub294 \ub2e8\uacc4\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "1\ub2e8\uacc4\ub294 \uae30\uadfc\uacfc \uc9c8\ubcd1 \ub4f1\uc73c\ub85c \uc0ac\ub9dd\ub960\uc774 \ub192\uc9c0\ub9cc \ucd9c\uc0dd\ub960\ub3c4 \ud568\uaed8 \ub192\uc544 \uc778\uad6c \uc131\uc7a5\uc774 \uc815\uccb4\ub418\ub294 \uace0\uc704 \uc815\uccb4 \ub2e8\uacc4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "2\ub2e8\uacc4(\ucd08\uae30 \ud33d\ucc3d)\ub294 \ucd9c\uc0dd\ub960\uc774 \uae09\uaca9\ud788 \ub0ae\uc544\uc9c0\uba74\uc11c \uc778\uad6c \uc99d\uac00\uac00 \ub454\ud654\ub418\ub294 \ub2e8\uacc4\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "2\ub2e8\uacc4\ub294 \uacbd\uc81c \uc131\uc7a5 \ub4f1\uc73c\ub85c \uc0ac\ub9dd\ub960\uc774 \uae09\uaca9\ud788 \ub0ae\uc544\uc9c0\ub294 \ubc18\uba74 \ucd9c\uc0dd\ub960\uc740 \uc5ec\uc804\ud788 \ub192\uc544 \uc778\uad6c\uac00 \uae09\uaca9\ud788 \ud3ed\uc99d\ud558\ub294 \ub2e8\uacc4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "4\ub2e8\uacc4(\uc800\uc704 \uc815\uccb4)\ub294 \uc0ac\ub9dd\ub960\uc774 \ucd9c\uc0dd\ub960\uc744 \ucd08\uacfc\ud558\uc5ec \uc778\uad6c\uc758 \uc790\uc5f0\uc801 \uac10\uc18c\uac00 \uc2dc\uc791\ub418\ub294 \ub2e8\uacc4\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucd9c\uc0dd\ub960\uacfc \uc0ac\ub9dd\ub960\uc774 \ubaa8\ub450 \ub0ae\uc740 4\ub2e8\uacc4\ub294 \uc778\uad6c\uac00 \uc815\uccb4\ub418\ub294 \ub2e8\uacc4\uc774\uba70, \uc790\uc5f0 \uac10\uc18c\uac00 \ub098\ud0c0\ub098\ub294 \ub2e8\uacc4\ub294 5\ub2e8\uacc4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "5\ub2e8\uacc4(\uac10\uc18c)\ub294 \uc778\uad6c \uc5b5\uc81c \uc815\ucc45\uc758 \uc131\uacf5\uc73c\ub85c \ucd9c\uc0dd\ub960\ub9cc \uc9c0\uc18d\ud574\uc11c \uc0c1\uc2b9\ud558\ub294 \ub2e8\uacc4\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "5\ub2e8\uacc4\ub294 \ucd9c\uc0dd\ub960\uc774 \uc0ac\ub9dd\ub960\ubcf4\ub2e4 \ub0ae\uc544\uc838 \uc778\uad6c\uac00 \uc790\uc5f0\uc801\uc73c\ub85c \uac10\uc18c\ud558\ub294 \ub2e8\uacc4\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc778\uad6c \ubcc0\ucc9c \ubaa8\ud615\uc5d0\uc11c\ub294 \uc0ac\ub9dd\ub960\uc774 \uba3c\uc800 \uae09\uaca9\ud788 \uac10\uc18c\ud55c \ub4a4, \uacbd\uc81c\u00b7\uc0ac\ud68c\uc801 \ubcc0\ud654\uc5d0 \ub530\ub77c \ucd9c\uc0dd\ub960\uc774 \uac10\uc18c\ud558\ub294 \uacbd\ud5a5\uc744 \ubcf4\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uacfc \uc120\uc9c4\uad6d\uc758 \uc778\uad6c \uc131\uc7a5 \uacbd\ud5a5\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc120\uc9c4\uad6d\uc740 20\uc138\uae30 \uc911\ubc18 \uc774\ud6c4 \ucd9c\uc0dd\ub960\uc774 \uac10\uc18c\ud558\uba74\uc11c \uc778\uad6c \uc99d\uac00\uac00 \uc815\uccb4\ub418\uac70\ub098 \uac10\uc18c\ud558\ub294 \uacbd\ud5a5\uc744 \ubcf4\uc778\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc120\uc9c4\uad6d\uc740 \ucd9c\uc0dd\ub960 \uc800\ud558\ub85c \uc778\ud574 20\uc138\uae30 \uc911\ubc18 \uc774\ud6c4 \uc778\uad6c \uc99d\uac00\uc728\uc774 \uc815\uccb4\ub418\uac70\ub098 \uc77c\ubd80 \uad6d\uac00\uc5d0\uc11c\ub294 \uc778\uad6c\uac00 \uac10\uc18c\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 18\uc138\uae30 \ub9d0\ubd80\ud130 20\uc138\uae30 \ucd08 \uc0ac\uc774\uc5d0 \uc120\uc9c4\uad6d\ubcf4\ub2e4 \uba3c\uc800 \uc778\uad6c \uae09\uc99d\uc744 \uacbd\ud5d8\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "18\uc138\uae30 \ub9d0~20\uc138\uae30 \ucd08 \uc778\uad6c \uae09\uc99d\uc740 \uc120\uc9c4\uad6d\uc758 \ud2b9\uc9d5\uc774\uba70, \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \uc778\uad6c \ud3ed\uc99d\uc740 \uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 \uc774\ud6c4\uc5d0 \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \ud604\uc7ac \uc0ac\ub9dd\ub960\uacfc \ucd9c\uc0dd\ub960\uc774 \ub3d9\uc2dc\uc5d0 \uae09\uaca9\ud788 \uc0c1\uc2b9\ud558\uc5ec \uc778\uad6c \uc131\uc7a5\ub960\uc774 \ucd5c\uc800 \uc218\uc900\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \uc758\ub8cc \uae30\uc220 \ub3c4\uc785 \ub4f1\uc73c\ub85c \uc0ac\ub9dd\ub960\uc740 \ub0ae\uc544\uc84c\uc73c\ub098 \ucd9c\uc0dd\ub960\uc774 \uc5ec\uc804\ud788 \ub192\uc544 \ub192\uc740 \uc778\uad6c \uc99d\uac00\uc728\uc744 \ubcf4\uc774\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud5a5\ud6c4 \uc138\uacc4\uc758 \uc778\uad6c \uc131\uc7a5\uc740 \uc11c\uc720\ub7fd\uacfc \ubd81\uc544\uba54\ub9ac\uce74 \ub4f1 \uc8fc\uc694 \uc120\uc9c4\uad6d\uc774 \uc9c0\uc18d\ud574\uc11c \uc8fc\ub3c4\ud560 \uc608\uc815\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc120\uc9c4\uad6d\uc758 \uc778\uad6c\ub294 \uc815\uccb4/\uac10\uc18c \ucd94\uc138\uc774\ubbc0\ub85c, \ubbf8\ub798 \uc138\uacc4 \uc778\uad6c \uc131\uc7a5\uc740 \uc544\ud504\ub9ac\uce74, \uc544\uc2dc\uc544, \uc911\uc559 \ubc0f \ub0a8\uc544\uba54\ub9ac\uce74 \ub4f1\uc758 \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc774 \uc8fc\ub3c4\ud560 \uac83\uc73c\ub85c \uc608\uc0c1\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0b0\uc5c5\ud654 \ucc29\uc218 \uc2dc\uae30\uc640 \ucd9c\uc0dd\ub960 \ubcc0\ud654 \uc2dc\uc810\uc5d0 \ub530\ub77c \uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \uc778\uad6c \uc131\uc7a5 \ucd94\uc774\uac00 \ub2e4\ub974\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc138\uacc4 \uc778\uad6c \ubd84\ud3ec\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc790\uc5f0\uc801 \uc694\uc778\uacfc \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \uc694\uc778\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub3d9\uc544\uc2dc\uc544, \ub3d9\ub0a8\uc544\uc2dc\uc544, \ub0a8\ubd80 \uc544\uc2dc\uc544\ub294 \uc778\uad6c \ubd80\uc591\ub825\uc774 \ub192\uc740 \ubcbc\ub18d\uc0ac\uac00 \ubc1c\ub2ec\ud558\uc5ec \uc778\uad6c \ubc00\ub3c4\uac00 \ub192\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcbc\ub18d\uc0ac\ub294 \ub2e8\uc704 \uba74\uc801\ub2f9 \ub9ce\uc740 \uc778\uad6c\ub97c \ubd80\uc591\ud560 \uc218 \uc788\uc5b4 \ud574\ub2f9 \uc544\uc2dc\uc544 \uc9c0\uc5ed\uc758 \uc778\uad6c \ubc00\uc9d1\uc744 \uac00\uc838\uc628 \uc8fc\uc694 \uc790\uc5f0\u00b7\ub18d\uc5c5\uc801 \uc694\uc778\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubd81\ubc18\uad6c \uc911\uc704\ub3c4\uc758 \ub0c9\u00b7\uc628\ub300 \uae30\ud6c4 \uc9c0\uc5ed\uacfc \ud3c9\uc57c \ubc0f \ud574\uc548 \uc9c0\uc5ed\uc740 \uc778\uac04 \uac70\uc8fc\uc5d0 \uc720\ub9ac\ud558\uc5ec \uc778\uad6c\uac00 \ubc00\uc9d1\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc628\ud654\ud55c \uae30\ud6c4\uc640 \ud3c9\ud0c4\ud55c \uc9c0\ud615, \uc6a9\uc218 \ud655\ubcf4\uac00 \uc6a9\uc774\ud55c \ud574\uc548\u00b7\ud3c9\uc57c \uc9c0\ub300\ub294 \uc804\ud1b5\uc801\uc73c\ub85c \uc778\uad6c\uac00 \ubc00\uc9d1\ud558\uae30 \uc720\ub9ac\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac74\uc870\u00b7\ud55c\ub300 \uae30\ud6c4 \uc9c0\uc5ed\uc774\ub098 \ud5d8\uc900\ud55c \uc0b0\uc9c0 \ubc0f \uace0\uc6d0 \uc9c0\uc5ed\uc740 \uac70\uc8fc \ud658\uacbd\uc774 \ubd88\ub9ac\ud558\uc5ec \uc778\uad6c\uac00 \ud76c\ubc15\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uadf9\ub2e8\uc801\uc778 \uae30\ud6c4\uc640 \ud5d8\uc900\ud55c \uc9c0\ud615\uc740 \ub18d\uc5c5 \uc0dd\uc0b0 \ubc0f \uc0dd\ud65c \uc5ec\uac74\uc774 \ubd88\ub9ac\ud558\uc5ec \uc778\uad6c \ubc00\ub3c4\uac00 \ub0ae\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "\uc624\ub298\ub0a0 \uc778\uad6c \ubd84\ud3ec\ub294 \uc790\uc5f0\uc801 \uc694\uc778\uc5d0 \uc758\ud574\uc11c\ub9cc \uacb0\uc815\ub418\uba70 \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \uc694\uc778\uc758 \uc601\ud5a5\ub825\uc740 \ud06c\uac8c \uac10\uc18c\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uacfc\ud559 \uae30\uc220 \ubc1c\ub2ec\uacfc \uc138\uacc4\ud654\ub85c \uc0b0\uc5c5, \uad50\ud1b5, \uad50\uc721, \uc77c\uc790\ub9ac \ub4f1 \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \uc694\uc778\uc774 \uc778\uad6c \ubd84\ud3ec \ubc0f \uad6d\uc81c \uc774\ub3d9\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\ub825\uc774 \uc810\uc810 \ub354 \ucee4\uc9c0\uace0 \uc788\uc73c\ubbc0\ub85c \uc633\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc624\ub298\ub0a0\uc758 \ub300\ub3c4\uc2dc \ubc0f \uc120\uc9c4\uad6d \uc778\uad6c \ubc00\uc9d1\uc740 \uc0b0\uc5c5\uacfc \uad50\ud1b5, \ubb38\ud654 \ub4f1 \uc778\uc704\uc801\u00b7\uacbd\uc81c\uc801 \uc870\uac74\uc5d0 \ud06c\uac8c \uc88c\uc6b0\ub429\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc138\uacc4 \ub300\ub959\ubcc4 \uc778\uad6c \ubd84\ud3ec \ud2b9\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc138\uacc4 \uc778\uad6c\uc758 \uc808\ubc18 \uc774\uc0c1\uc774 \uc544\uc2dc\uc544 \ub300\ub959\uc5d0 \uc0b4\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "2021\ub144 \uae30\uc900 \uc544\uc2dc\uc544\ub294 \uc138\uacc4 \uc804\uccb4 \uc778\uad6c\uc758 \uc57d 59.4%\ub97c \ucc28\uc9c0\ud558\uc5ec \uc808\ubc18 \uc774\uc0c1\uc744 \uad6c\uc131\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4 \uc778\uad6c\uc758 \ub300\ubd80\ubd84\uc740 \uc9c0\ud615 \uc870\uac74\uc774 \ud3c9\ud0c4\ud55c \ub0a8\ubc18\uad6c \uc911\uc704\ub3c4\uc5d0 \uc9d1\uc911\ub418\uc5b4 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uacc4 \uc778\uad6c\uc758 \ub300\ubd80\ubd84\uc740 \ub18d\uc5c5\uacfc \uacf5\uc5c5 \ubc1c\ub2ec\uc5d0 \uc720\ub9ac\ud55c '\ubd81\ubc18\uad6c' \uc911\uc704\ub3c4 \uc9c0\uc5ed\uc5d0 \uc9d1\uc911\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub300\ub959\ubcc4 \uc778\uad6c \ube44\uc728\uc740 \uc544\uc2dc\uc544 \ub2e4\uc74c\uc73c\ub85c \uc720\ub7fd, \uc544\ud504\ub9ac\uce74, \ubd81\uc544\uba54\ub9ac\uce74 \uc21c\uc73c\ub85c \ub192\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub300\ub959\ubcc4 \uc778\uad6c \ube44\uc728 \uc21c\uc704\ub294 \uc544\uc2dc\uc544(59.4%) \ub2e4\uc74c\uc73c\ub85c \uc544\ud504\ub9ac\uce74(17.6%), \uc720\ub7fd(9.4%) \uc21c\uc785\ub2c8\ub2e4."
        },
        {
