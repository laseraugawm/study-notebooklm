{
  "title": "\uc724\ub9ac \ud034\uc988",
  "questions": [
    {
      "question": "\ub2e4\uc74c \uc911 \uc81c\uc2dc\ub41c \uc9c0\ubb38\uc5d0 \ub530\ub978 \uc0ac\uc775\uacfc \uacf5\uc775\uc758 \uc815\uc758\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\uc775\uc740 \uac1c\uc778\uc758 \ud589\ubcf5 \ucd94\uad6c\ub098 \uc790\uc544\uc2e4\ud604 \ub4f1\uc744 \ud1b5\ud574 \uac1c\uc778\uc774 \uc0ac\uc801\uc73c\ub85c \uc5bb\uac8c \ub418\ub294 \uc774\uc775\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\uc775\uc740 \uac1c\uc778\uc774 \uc0ac\uc801\uc73c\ub85c \ub204\ub9ac\ub294 \ud589\ubcf5 \ucd94\uad6c\ub098 \uc790\uc544\uc2e4\ud604 \ub4f1\uc758 \uc774\uc775\uc73c\ub85c \uc815\uc758\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\uc775\uc740 \uac1c\ubcc4 \uac1c\uc778\uc758 \uc0ac\uc801 \uc774\uc775\uc744 \ub2e8\uc21c \ud569\uc0b0\ud558\uc5ec \uc0b0\ucd9c\ud55c \ubb3c\uc9c8\uc801 \uc774\uc775\uc758 \ucd1d\ud569\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uc775\uc740 \ub2e8\uc21c\ud55c \uc0ac\uc775\uc758 \ud569\uc0b0\uc774 \uc544\ub2c8\ub77c \uacf5\ub3d9\uccb4\uc758 \uac00\uce58\ub97c \ucd94\uad6c\ud568\uc73c\ub85c\uc368 \uad6c\uc131\uc6d0 \ubaa8\ub450\uac00 \uc5bb\uac8c \ub418\ub294 \uc774\uc775\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\uc775\uc740 \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \uc758\ubb34\ub97c \uc774\ud589\ud560 \ub54c\ub9cc \ubd80\uc0b0\ubb3c\ub85c \uc5bb\uc5b4\uc9c0\ub294 \uc774\uc775\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\uc775\uc740 \uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \uac15\uc870\ud558\ub294 \uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \ubcf4\uc7a5\ud568\uc73c\ub85c\uc368 \uc2e4\ud604\ub418\ub294 \uc774\uc775\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\uc775\uc740 \uac1c\uc778\uc758 \uad8c\ub9ac \ubcf4\uc7a5\uacfc\ub294 \ubb34\uad00\ud558\uac8c \uad6d\uac00 \uad8c\ub825\uc758 \uac15\uc81c\ub85c\ub9cc \uc2e4\ud604\ub418\ub294 \uc774\uc775\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uc775\uc740 \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \uad6c\uc131\uc6d0\ub4e4\uc774 \uacf5\ub3d9\uccb4\uc5d0 \ub300\ud55c \uc758\ubb34\ub97c \uc218\ud589\ud558\uace0 \uc5f0\ub300\ud560 \ub54c \uc2e4\ud604\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubcf8\ubb38 \ud45c\uc5d0 \ub098\uc640 \uc788\ub294 '\uc0ac\uc775'\uacfc '\uacf5\uc775'\uc758 \uac1c\ub150 \uc815\uc758\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc591\uc2ec\uc801 \ubcd1\uc5ed \uac70\ubd80 \uc774\uc288\ub97c \ubc14\ub77c\ubcf4\ub294 \uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uacfc \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc758 \uc785\uc7a5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c\ub294 \ud2b9\uc815 \uc885\uad50 \uc2e0\ub150\uc5d0 \ub530\ub978 \ud589\ub3d9\uc744 \uac1c\uc778\uc758 \uc790\uc720\ub85c \uc778\uc2dd\ud558\ubbc0\ub85c \uc774\ub97c \uc798\ubabb\ub41c \ud589\uc704\ub85c \ubcf4\uc9c0 \uc54a\uc744 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uc885\uad50\uc640 \uc2e0\ub150\uc758 \uc790\uc720\ub97c \uac1c\uc778\uc758 \ud575\uc2ec \uad8c\ub9ac\ub85c \ubcf4\ubbc0\ub85c \uc591\uc2ec\uc801 \ubcd1\uc5ed \uac70\ubd80\ub97c \ube44\ub09c\ud558\uc9c0 \uc54a\ub294 \uad00\uc810\uc744 \ucde8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c\ub294 \uac1c\uc778\uc774 \uc2e0\ubd09\ud558\ub294 \uc885\uad50\uc801 \uc591\uc2ec\uc744 \uad6d\ubc29\uc758 \uc758\ubb34\ubcf4\ub2e4 \uc0c1\uc704\uc5d0 \ub454\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uad6d\ubc29\uc758 \uc758\ubb34\ub97c \uacf5\ub3d9\uccb4 \uad6c\uc131\uc6d0\uc73c\ub85c\uc11c \uc9c0\ub2c8\ub294 \ub2f9\uc5f0\ud55c \uc758\ubb34\ub85c \ubcf4\ubbc0\ub85c \ubcd1\uc5ed \uac70\ubd80\ub97c \ube44\ub09c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c\ub294 \uad6d\ubc29\uc758 \uc758\ubb34\ub97c \uacf5\ub3d9\uccb4 \uc720\uc9c0\uc758 \uc808\ub300\uc801 \uc804\uc81c\ub85c \uc0bc\uc544 \ubcd1\uc5ed \uac70\ubd80\uc790\ub97c \uc5c4\ubc8c\ud574\uc57c \ud55c\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\ubc29\uc758 \uc758\ubb34\ub97c \ub2f9\uc5f0\ud55c \uacf5\uc801 \uc758\ubb34\ub85c \uac15\uc870\ud558\ub294 \uac83\uc740 \uc790\uc720\uc8fc\uc758\uac00 \uc544\ub2c8\ub77c \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc758 \uc785\uc7a5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub450 \uc815\uc758\uad00 \ubaa8\ub450 \uac1c\uc778\uc758 \uc885\uad50\uc801 \uc790\uc720\uac00 \uacf5\ub3d9\uccb4\uc758 \uc548\ubcf4 \uc758\ubb34\ubcf4\ub2e4 \ud56d\uc0c1 \uc6b0\uc704\uc5d0 \uc788\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uacf5\ub3d9\uccb4\uc5d0 \ub300\ud55c \uc758\ubb34\ub97c \uac15\uc870\ud558\ubbc0\ub85c \uac1c\uc778\uc758 \uc885\uad50\uc801 \uc2e0\ub150\ubcf4\ub2e4 \uad6d\ubc29\uc758 \uc758\ubb34\ub97c \uc911\uc2dc\ud558\ub294 \uc785\uc7a5\uc744 \ucde8\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac01 \uc815\uc758\uad00\uc774 '\uac1c\uc778\uc758 \uc885\uad50\uc801 \uc790\uc720'\uc640 '\uad6d\ubc29\uc758 \uc758\ubb34' \uc911 \ubb34\uc5c7\uc744 \ub354 \uac15\uc870\ud558\ub294\uc9c0 \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uacfc \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc774 \uc0ac\uc775\uacfc \uacf5\uc775\uc758 \uad00\uacc4\ub97c \uc124\uba85\ud558\ub294 \ubc29\uc2dd\uc744 \ubc14\ub974\uac8c \uc5f0\uacb0\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00: \uac1c\uc778 \uac04\uc758 \uacf5\uc815\ud55c \uacbd\uc7c1\uc744 \ud1b5\ud55c \uc0ac\uc775 \ucd94\uad6c\uac00 \uacf5\uc775\uc758 \uc2e4\ud604\uc73c\ub85c \uc774\uc5b4\uc9c4\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uacf5\uc815\ud55c \uacbd\uc7c1\uc744 \ud1b5\ud55c \uc0ac\uc775 \uc99d\uc9c4\uc774 \uacf5\ub3d9\uccb4\uc758 \ubc1c\uc804(\uacf5\uc775)\uc73c\ub85c \uc5f0\uacb0\ub41c\ub2e4\uace0 \uc124\uba85\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00: \uac1c\uc778\uc758 \uc774\uae30\uc801 \uc695\ub9dd \ucd94\uad6c\uac00 \uacf5\uc775\ubcf4\ub2e4 \ud56d\uc0c1 \uc6b0\uc120\ub418\uc5b4\uc57c \ud55c\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uacf5\uc775\uc744 \uc2e4\ud604\ud558\uae30 \uc704\ud55c \uac1c\uc778\ub4e4\uc758 \uc5f0\ub300\uc640 \uc758\ubb34 \uc218\ud589\uc744 \uac15\uc870\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00: \uacf5\uc775\uc758 \uc2e4\ud604\uc774 \uc120\ud589\ub418\uc5b4\uc57c\ub9cc \ube44\ub85c\uc18c \uac1c\uc778\uc758 \uc0ac\uc775 \uc2e4\ud604\uc774 \uac00\ub2a5\ud574\uc9c4\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uc775\uc758 \uc2e4\ud604\uc774 \uac1c\uc778\uc758 \uc88b\uc740 \uc0b6(\uc0ac\uc775)\uc73c\ub85c \uc774\uc5b4\uc9c4\ub2e4\uace0 \ubcf4\ub294 \uac83\uc740 \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc758 \uc8fc\uc7a5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00: \uc0ac\uc775\uacfc \uacf5\uc775\uc740 \uc808\ub300 \uc870\ud654\ub420 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uc0ac\uc775\uc744 \uc644\uc804\ud788 \uc804\ud3d0\ud574\uc57c \ud55c\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00 \uc5ed\uc2dc \uacf5\uc775\uacfc \uc0ac\uc775\uc758 \uc870\ud654\ub97c \ucd94\uad6c\ud558\uba70 \uc0ac\uc775\uc758 \uc644\uc804\ud55c \ud3d0\uc9c0\ub97c \uc8fc\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc5b4\ub290 \uc815\uc758\uad00\uc774 '\uc0ac\uc775 \ucd94\uad6c $\\rightarrow$ \uacf5\uc775 \uc2e4\ud604'\uc744, \uc5b4\ub290 \uc815\uc758\uad00\uc774 '\uacf5\uc775 \uc2e4\ud604 $\\rightarrow$ \uc0ac\uc775(\uc88b\uc740 \uc0b6)'\uc744 \uc8fc\uc7a5\ud558\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc9c0\ubb38\uc5d0 \uc81c\uc2dc\ub41c '\ub2d8\ube44(NIMBY) \ud604\uc0c1' \ubc0f '\uccad\ub144 \uc784\ub300 \uc8fc\ud0dd \uc0ac\uc5c5' \uc0ac\ub840\uc5d0 \ub300\ud55c \ubd84\uc11d\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uccad\ub144 \uc784\ub300 \uc8fc\ud0dd \uc0ac\uc5c5\uc740 \uc9c0\uc5ed \uc8fc\ubbfc\ub4e4\uc774 \uacf5\ub3d9\uccb4 \uc804\uccb4\uc758 \uacf5\uc775\uc744 \uc704\ud574 \uc790\ubc1c\uc801\uc73c\ub85c \uc81c\uc548\ud55c \uc0ac\uc5c5\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uccad\ub144 \uc784\ub300 \uc8fc\ud0dd \uc0ac\uc5c5\uc740 \uc800\uc18c\ub4dd \uccad\ub144\uce35\uc758 \uc8fc\uac70 \ubd80\ub2f4 \uc644\ud654\ub97c \uc704\ud574 \uc9c0\ubc29 \uc790\uce58 \ub2e8\uccb4\uc640 \uacf5\uae30\uc5c5\uc774 \ucd94\uc9c4\ud558\ub294 \uc815\ucc45\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub2d8\ube44 \ud604\uc0c1\uc740 \uacf5\uacf5\uc758 \uc774\uc775\uc774 \ub418\ub354\ub77c\ub3c4 \uc790\uc2e0\uc774 \uc18d\ud55c \uc9c0\uc5ed\uc5d0 \uc774\uc775\uc774 \ub418\uc9c0 \uc54a\ub294 \uc77c\uc5d0 \ubc18\ub300\ud558\ub294 \ud589\uc704\ub97c \ub73b\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf8\ubb38\uc758 \uac01\uc8fc\uc5d0 \uba85\uc2dc\ub41c \ub2d8\ube44(NIMBY)\uc758 \uc815\ud655\ud55c \uac1c\ub150 \uc815\uc758\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc5ed \uc8fc\ubbfc\ub4e4\uc740 \uc784\ub300 \uc8fc\ud0dd \uac74\ub9bd \uc2dc \ubd80\ub3d9\uc0b0 \uac00\uaca9\uc774 \ud558\ub77d\ud560 \uac83\uc744 \uc6b0\ub824\ud558\uc5ec \uc0ac\uc5c5\uc5d0 \ubc18\ub300\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uc5ed \uc8fc\ubbfc\ub4e4\uc774 \ubc18\ub300\ud558\ub294 \uc8fc\uc694 \uc6d0\uc778\uc740 \ubd80\ub3d9\uc0b0 \uac00\uaca9 \ud558\ub77d \ubc0f \uc9c0\uc5ed \ubc1c\uc804 \uc800\ud574\uc5d0 \ub300\ud55c \uc6b0\ub824\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc774 \uc0ac\ub840\ub294 \uccad\ub144\uce35\uc758 \uc8fc\uac70 \uc548\uc815\uc774\ub77c\ub294 \uacf5\uc775\uacfc \uc9c0\uc5ed \uc8fc\ubbfc\uc758 \uc790\uc0b0 \uac00\uce58 \ubcf4\uc874\uc774\ub77c\ub294 \uc0ac\uc775\uc774 \ucda9\ub3cc\ud558\ub294 \uc0c1\ud669\uc744 \ubcf4\uc5ec\uc900\ub2e4.",
          "isCorrect": false,
          "rationale": "\uccad\ub144 \uc784\ub300 \uc8fc\ud0dd \uc0ac\uc5c5\uc740 \uacf5\uc775\uacfc \uc9c0\uc5ed \uc8fc\ubbfc\uc758 \uc0ac\uc801 \uc774\uc775\uc774 \uac08\ub4f1\uc744 \uacaa\ub294 \ub300\ud45c\uc801 \uc0ac\ub840\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uccad\ub144 \uc784\ub300 \uc8fc\ud0dd \uc0ac\uc5c5\uc744 \uc8fc\ub3c4\ud55c \uc8fc\uccb4\uc640 \uc9c0\uc5ed \uc8fc\ubbfc\ub4e4\uc758 \ubc18\ub300 \uc774\uc720\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc0ac\uc775\uacfc \uacf5\uc775, \uad8c\ub9ac\uc640 \uc758\ubb34\uac00 \uc870\ud654\ub97c \uc774\ub8e8\ub294 \uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\ub97c \uad6c\ud604\ud558\uae30 \uc704\ud55c \ubc29\uc548\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc740 \uacf5\ub3d9\uccb4\uc5d0 \ub300\ud55c \uc758\ubb34\ub97c \uc801\uadf9 \uc774\ud589\ud558\uace0, \uacf5\ub3d9\uccb4\ub294 \uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \ucd5c\ub300\ud55c \ubcf4\uc7a5\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\uc778\uc758 \uc758\ubb34 \uc774\ud589\uacfc \uacf5\ub3d9\uccb4\uc758 \uad8c\ub9ac \ubcf4\uc7a5\uc774 \ubcd1\ud589\ub420 \ub54c \uc0ac\uc775\uacfc \uacf5\uc775\uc774 \uc870\ud654\ub97c \uc774\ub8f0 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\uc775 \ub2ec\uc131\uc744 \uc704\ud574 \uac1c\uc778\uc758 \uad8c\ub9ac\uc640 \uc790\uc720\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \uc81c\ud55c\ud558\uace0 \ucd95\uc18c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5b4\ub290 \ud55c\ucabd\ub9cc\uc744 \uc9c0\ub098\uce58\uac8c \uac15\uc870\ud558\uac70\ub098 \uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \ubb34\uc2dc\ud574\uc11c\ub294 \uc870\ud654\ub97c \uc774\ub8f0 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\uc775 \uc99d\uc9c4\ub9cc\uc744 \uc808\ub300\uc801 \uac00\uce58\ub85c \uc0bc\uc544 \uacf5\ub3d9\uccb4\uc5d0 \ub300\ud55c \ubaa8\ub4e0 \uc758\ubb34\ub97c \uba74\uc81c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\uc775\ub9cc \uacfc\ub3c4\ud558\uac8c \ucd94\uad6c\ud558\uba74 \uacf5\uc775\uacfc\uc758 \ucda9\ub3cc\uc744 \ud574\uacb0\ud560 \uc218 \uc5c6\uc73c\uba70 \uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\ub97c \uc774\ub8e8\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uacfc \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00 \uc911 \ud558\ub098\ub9cc\uc744 \uc120\ud0dd\ud558\uc5ec \uc77c\uad00\ub418\uac8c \uc801\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub450 \uc815\uc758\uad00\uc740 \uc0c1\ud638 \ubcf4\uc644\uc801\uc774\ubbc0\ub85c \uc5b4\ub290 \ud558\ub098\ub9cc \uce58\uc6b0\uce58\uac8c \uc801\uc6a9\ud558\uae30\ubcf4\ub2e4 \uc870\ud654\ub97c \ubaa8\uc0c9\ud574\uc57c \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubcf8\ubb38 47\ucabd\uc5d0\uc11c \uc0ac\uc775\uacfc \uacf5\uc775\uc774 \uc870\ud654\ub97c \uc774\ub8e8\uae30 \uc704\ud574 \uac1c\uc778\uacfc \uacf5\ub3d9\uccb4\uac00 \uac01\uac01 \ucde8\ud574\uc57c \ud560 \ud0dc\ub3c4\ub97c \ucc3e\uc544\ubcf4\uc138\uc694."
