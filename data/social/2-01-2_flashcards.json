      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5c5\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ubcf5\uc9c0 \uc81c\ub3c4\uc640 \uac19\uc740 \uc0ac\ud68c \uc548\uc804\ub9dd\uc744 \ub9c8\ub828\ud558\ub294 \uac83\uc740 \uc5b4\ub5a0\ud55c \ubd84\ubc30\uc801 \uae30\uc900\uc5d0 \ubfcc\ub9ac\ub97c \ub450\uace0 \uc788\ub294\uac00?"
          }
