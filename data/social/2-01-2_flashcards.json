      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2018\ubd84\ubc30\uc801 \uc815\uc758\ub294 \uc0ac\ud68c\uc801 \uc7ac\ud654\ub97c \uacf5\uc815\ud558\uac8c \ubd84\ubc30\ud558\ub294 \uc6d0\uce59\uacfc \uad00\ub828\uc774 \uc5c6\ub2e4.\u2019 (\u25ef / \u00d7)"
          }
