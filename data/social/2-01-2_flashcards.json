    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\ub97c \ub300\ud45c\ud574 \uacbd\uae30\ub098 \uc0ac\uc5c5\uc5d0 \ub098\uac08 \uc120\uc218\ub97c \uc120\ubc1c\ud560 \ub54c \uc801\uc6a9\ud574\uc57c \ud560 \uac00\uc7a5 \uc801\ud569\ud55c \ubd84\ubc30 \uae30\uc900\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2a5\ub825\uc5d0 \ub530\ub978 \ubd84\ubc30 (\ub610\ub294 \uacbd\uae30\ub825/\uc5ed\ub7c9 \uae30\uc900)"
          }
        ]
