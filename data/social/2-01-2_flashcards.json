        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\ud3c9\ub4f1\ud55c \uacb0\uacfc\uc5d0 \uc77c\uc815\ud55c \uc9c0\uc6d0\uc744 \uc81c\uacf5\ud558\uc5ec \uacb0\uacfc\uc801 \uaca9\ucc28\ub97c \uc644\ud654\ud558\uace0\uc790 \ud558\ub294 \ud3c9\ub4f1\uc758 \uac1c\ub150\uc740?"
          }
        ]
