    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uc5d0\uc11c \uc0dd\uc0b0\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574 \uc2e4\uc801\uc774 \ub192\uc740 \uc0c1\uc704 \uc9c1\uc6d0\uc5d0\uac8c \uc9c0\uae09\ud558\ub294 \uae08\uc804\uc801 \ubcf4\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
