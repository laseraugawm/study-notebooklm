      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacb0\uacfc\uc758 \ud3c9\ub4f1 (\uc0ac\ud68c\uc801 \uc57d\uc790\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \ubc30\ub824)"
          }
        ]
