    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\ub85c\uc6b4 \ubd84\ubc30\uac00 \uc774\ub8e8\uc5b4\uc9c0\uae30 \uc704\ud574 \ubd84\ubc30 \uae30\uc900\uc744 \uc124\uc815\ud560 \ub54c \uace0\ub824\ud574\uc57c \ud558\ub294 \uc694\uc18c 2\uac00\uc9c0?"
