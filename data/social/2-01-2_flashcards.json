      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\uacfc\uae09 (\uc5c5\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30 \uc0ac\ub840)"
