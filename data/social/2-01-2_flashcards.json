    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc62c\ub9bc\ud53d \uacbd\uae30 \uacb0\uacfc\uc5d0 \ub530\ub77c \uba54\ub2ec\uc744 \uc218\uc5ec\ud560 \ub54c \uc801\uc808\ud55c \ubd84\ubc30 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5c5\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\ub098 \uc0ac\ud68c\uc5d0 \uacf5\ud5cc\ud55c \uc778\ubb3c\uc5d0\uac8c \ud6c8\uc7a5\uc744 \uc218\uc5ec\ud560 \ub54c \uc801\uc808\ud55c \ubd84\ubc30 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5c5\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c8\ubcd1 \uce58\ub8cc\ub098 \uac74\uac15 \uc720\uc9c0\ub97c \uc704\ud55c \uc758\ub8cc \ud61c\ud0dd\uc744 \uc81c\uacf5\ud560 \ub54c \uae30\ubcf8\uc801\uc73c\ub85c \uc801\uc6a9\ub418\uc5b4\uc57c \ud558\ub294 \ubd84\ubc30 \uae30\uc900\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud544\uc694\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ubbfc\uc5d0\uac8c \uc138\uae08\uc744 \ubd80\uacfc\ud560 \ub54c \ub2f4\uc138\ub825(\uc18c\ub4dd \ubc0f \uc7ac\uc0b0 \uc815\ub3c4)\uc5d0 \ub9de\ucd94\uc5b4 \ubd80\uacfc\ud558\ub294 \uac83\uc740 \uc5b4\ub5a4 \ubd84\ubc30 \uae30\uc900\uacfc \uc5f0\uad00\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2a5\ub825(\uc9c0\ubd88 \ub2a5\ub825) \ub610\ub294 \ud544\uc694(\uc0ac\ud68c\uc801 \ubd80\ub2f4 \ub2a5\ub825)\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\"\ub3d9\ub4f1\ud558\ub2e4\uba74 \ub3d9\ub4f1\ud55c \ubaab\uc744 \uac00\uc9c0\ub294 \uac83\", \"\uac01\uc790 \ud0c0\uace0\ub09c \uc131\ud5a5\uc5d0 \ub530\ub77c \uc790\uc2e0\uc758 \uc77c\uc744 \ub2e4\ud558\ub294 \uac83\"\uc5d0 \uacf5\ud1b5\uc73c\ub85c \ud574\ub2f9\ud558\ub294 \uac1c\ub150\uc740?"
