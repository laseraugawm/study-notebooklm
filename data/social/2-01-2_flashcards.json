    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\uc815\uc801 \uc815\uc758\uc640 \uad6c\ubd84\ub418\ub294 \uac1c\ub150\uc73c\ub85c\uc11c, \uc0ac\ud68c\uc801 \uc7ac\ud654\uc640 \ubd80\ub2f4\uc744 \uacf5\uc815\ud558\uac8c \ubd84\ubc30\ud558\ub294 \uc6d0\uce59\uc744 \ub73b\ud558\ub294 \uc815\uc758\uc758 \ud615\ud0dc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ubc30\uc801 \uc815\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7a5\ud559\uae08 \uc9c0\uae09 \ub300\uc0c1\uc744 \uc120\uc815\ud560 \ub54c '\ub2a5\ub825', '\uc5c5\uc801', '\ud544\uc694'\uac00 \uac01\uac01 \uc801\uc6a9\ub41c \uad6c\uccb4\uc801 \uae30\uc900\uc744 \ub2e8\uc5b4 \uc911\uc2ec\uc73c\ub85c \uc5f0\uacb0\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \ub2a5\ub825: \uc7a0\uc7ac\ub825\uc774 \ub6f0\uc5b4\ub09c \ud559\uc0dd\n\u2022 \uc5c5\uc801: \ub300\ud68c \uc218\uc0c1 \ub4f1 \ud559\uad50\ub97c \ube5b\ub0b8 \ud559\uc0dd\n\u2022 \ud544\uc694: \uac00\uc815 \ud615\ud3b8\uc774 \uc5b4\ub824\uc6b4 \ud559\uc0dd"
          }
        ]
      }
    }
  ]
