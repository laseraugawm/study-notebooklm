      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u00d7 (\ubd84\ubc30\uc801 \uc815\uc758\ub294 \uc0ac\ud68c\uc801 \uc7ac\ud654\ub97c \uacf5\uc815\ud558\uac8c \ubd84\ubc30\ud558\uae30 \uc704\ud55c \ud575\uc2ec \uc6d0\uce59\uc785\ub2c8\ub2e4.)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2018\uc804\ubb38\uc801\uc778 \uc790\uc9c8\uc744 \uac16\ucd98 \uc0ac\ub78c\uc5d0\uac8c \uc5b4\ub5a4 \uc9c0\uc704\ub098 \uc790\uaca9\uc744 \ubd80\uc5ec\ud558\ub294 \uac83\uc740 \ub2a5\ub825\uc5d0 \ub530\ub978 \ubd84\ubc30\uc5d0 \ud574\ub2f9\ud55c\ub2e4.\u2019 (\u25ef / \u00d7)"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u25ef"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2018\uc5c5\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30\ub294 \ube48\ubd80 \uaca9\ucc28\ub97c \uc904\uc77c \uc218 \uc788\ub294 \uc7a5\uc810\uc774 \uc788\uc9c0\ub9cc, \uc8fc\uad00\uc801 \ud3b8\uacac\uc744 \ubc30\uc81c\ud558\uae30 \uc5b4\ub835\ub2e4\ub294 \ub2e8\uc810\uc774 \uc788\ub2e4.\u2019 (\u25ef / \u00d7)"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u00d7 (\uc5c5\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30\ub294 \uc218\ub7c9\ud654\uac00 \uc6a9\uc774\ud558\uc5ec \uc8fc\uad00\uc801 \ud3b8\uacac\uc744 \ubc30\uc81c\ud558\uae30 \uc26c\uc6b4 \uc7a5\uc810\uc774 \uc788\uc9c0\ub9cc, \ube48\ubd80 \uaca9\ucc28\uac00 \ucee4\uc9c8 \uc218 \uc788\ub2e4\ub294 \ub2e8\uc810\uc774 \uc788\uc2b5\ub2c8\ub2e4.)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5c5\uc801 \ud3c9\uac00\uc758 \uc218\ub7c9\ud654\uac00 \uc26c\uc6b4 \ud3b8\uc774\ub77c\ub294 \ud2b9\uc131\uc774 \uc8fc\ub294 \ubd84\ubc30\uc0c1\uc758 \uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3c9\uac00\uc790\uc758 \uc8fc\uad00\uc801 \ud3b8\uacac\uc744 \ubc30\uc81c\ud560 \uc218 \uc788\uace0 \uac01\uc790\uc758 \ubaab\uc744 \uc815\ud558\uae30 \uba85\ud655\ud558\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc57d\uc790\ub97c \ubcf4\ud638\ud558\uc5ec \ucd5c\uc18c\ud55c\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \ubd84\ubc30 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud544\uc694\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub85c \ucd95\uad6c\ud300\uc774 \uacc4\uc57d \uc2dc \ud300 \uc2b9\ub9ac\uc5d0 \ud06c\uac8c \uae30\uc5ec\ud55c \uc120\uc218\uc5d0\uac8c \ub192\uc740 \uc5f0\ubd09\uc744 \uc8fc\ub294 \ubd84\ubc30 \ubc29\uc2dd\uc740?"
