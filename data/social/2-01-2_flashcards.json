            "type": "image",
            "reference": "d03617c2-b4ab-43b1-a7ef-1c2249d0a194",
            "alt": "\uc808\ub300\uc74c\uac10 \uc778\uc99d \ubc0f \uc74c\uc545\ub300\ud559 \ud569\uaca9 \ud654\uba74"
