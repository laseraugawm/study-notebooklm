        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc74c\uc545 \ub300\ud559\uc5d0\uc11c '\ud0c0\uace0\ub09c \uc808\ub300\uc74c\uac10'\uc744 \uc9c0\ub2cc \ud559\uc0dd\ub4e4\uc5d0\uac8c \uc785\ud559 \uc790\uaca9\uc744 \ubd80\uc5ec\ud55c \uacbd\uc6b0, \uc801\uc6a9\ub41c \ubd84\ubc30 \uae30\uc900\uc740?"
