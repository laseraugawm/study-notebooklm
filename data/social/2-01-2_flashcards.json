      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacb0\uacfc\uc758 \ud3c9\ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud544\uc694\uc5d0 \ub530\ub978 \ubd84\ubc30\ub294 '\uae30\ud68c\uc758 \ud3c9\ub4f1'\uacfc '\uacb0\uacfc\uc758 \ud3c9\ub4f1' \uc911 \ubb34\uc5c7\uc744 \ucd94\uad6c\ud558\ub294 \ubd84\ubc30 \ubc29\uc2dd\uc778\uac00?"
