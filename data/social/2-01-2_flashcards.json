      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud544\uc694\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2a5\ub825, \uc5c5\uc801, \ud544\uc694\ub77c\ub294 \uc138 \ubd84\ubc30 \uae30\uc900 \uc911 \ud3c9\uac00\uc758 '\uc8fc\uad00\uc131/\ubaa8\ud638\uc131'\uc774 \uac00\uc7a5 \ubb38\uc81c\uac00 \ub418\uae30 \uc26c\uc6b4 \uae30\uc900\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2a5\ub825\uc5d0 \ub530\ub978 \ubd84\ubc30 (\ub2a5\ub825\uc744 \uce21\uc815\ud558\ub294 \uac1d\uad00\uc801 \uae30\uc900 \ub9c8\ub828\uc774 \uc5b4\ub824\uc6c0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2a5\ub825, \uc5c5\uc801, \ud544\uc694 \uc138 \uae30\uc900 \uc911 '\ubb34\uc784\uc2b9\ucc28' \ubb38\uc81c\ub098 '\uc0dd\uc0b0 \uc758\uc695 \uc800\ud558'\uac00 \ub098\ud0c0\ub098\uae30 \uac00\uc7a5 \uc26c\uc6b4 \ubd84\ubc30 \ubc29\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud544\uc694\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2a5\ub825, \uc5c5\uc801, \ud544\uc694 \uc138 \uae30\uc900 \uc911 \uc9c0\ub098\uce58\uac8c \uac15\uc870\ud560 \uacbd\uc6b0 '\uacfc\uc5f4 \uacbd\uc7c1'\uacfc '\uc0ac\ud68c\uc801 \uc57d\uc790 \uc18c\uc678'\ub97c \ucd08\ub798\ud560 \uc218 \uc788\ub294 \uae30\uc900\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5c5\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30"
