      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ubc30 \ubaa9\uc801\uacfc \ubd84\ubc30 \ub300\uc0c1\uc758 \ud2b9\uc131"
