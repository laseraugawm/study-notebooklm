      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\ub7c9\uc744 \uc904\uc774\uace0 \uac00\uaca9\uc744 \uc62c\ub9b0\ub2e4."
