    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc2b7\ud55c \uc0c1\ud488\uc744 \uc0dd\uc0b0\ud558\ub294 \uae30\uc5c5\ub4e4\uc774 \ub354 \ub192\uc740 \uc774\uc775\uc744 \uc5bb\uc73c\ub824\uace0 \uc0dd\uc0b0\ub7c9\uacfc \uac00\uaca9\uc744 \uc0ac\uc804\uc5d0 \ud611\uc758\ud558\uc5ec \uacb0\uc815\ud558\ub294 \ud589\uc704\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2f4\ud569"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uacfc\uc810 \uc2dc\uc7a5\uc5d0\uc11c \uacf5\uae09\uc790\ub4e4\uc774 \uc774\uc724\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc0dd\uc0b0\ub7c9\uacfc \uac00\uaca9\uc744 \uc5b4\ub5bb\uac8c \uc870\uc815\ud558\ub294\uac00?"
          }
        ]
