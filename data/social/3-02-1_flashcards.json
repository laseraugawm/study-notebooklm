        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc2fc \ud2f0\ucf13 \uac12\uc744 \uc9c0\ubd88\ud558\uace0 \uac04 \uc74c\uc545\ud68c\uc5d0\uc11c \uc5f0\uc8fc\uac00 \uc7ac\ubbf8\uc5c6\uc74c\uc5d0\ub3c4 \ubcf8\uc804 \uc0dd\uac01\uc774 \ub098\uc11c \uc790\ub9ac\ub97c \uc9c0\ud0a4\uace0 \uc788\ub294 \ud589\uc704\ub294 \uc65c \ube44\ud569\ub9ac\uc801\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ubbf8 \uc9c0\ucd9c\ud558\uc5ec \ud68c\uc218\ud560 \uc218 \uc5c6\ub294 \ub9e4\ubab0 \ube44\uc6a9\uc5d0 \uc5bd\ub9e4\uc5ec \ud604\uc7ac \ubc0f \ubbf8\ub798\uc758 \uc120\ud0dd \ud310\ub2e8\uc744 \uadf8\ub974\ucce4\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc7a5\uc5d0\uc11c \uc790\uc6d0\uc774 \ud6a8\uc728\uc801\uc73c\ub85c \ubc30\ubd84\ub418\uc9c0 \ubabb\ud574 \uc0ac\ud68c \uc804\uccb4\uc758 \uc774\uc775\uc774 \ucee4\uc9c0\uc9c0 \uc54a\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
