      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uacfc\uc810 \uc2dc\uc7a5\uc774 \uc2dc\uc7a5 \uc2e4\ud328\ub97c \ucd08\ub798\ud558\ub294 \uc8fc\uc694 \uc774\uc720\ub294 \uc790\uc6d0 \ubc30\ubd84 \uad00\uc810\uc5d0\uc11c \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7ac\ud654\ub098 \uc11c\ube44\uc2a4\uac00 \uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc801\uac8c \uacf5\uae09\ub418\uc5b4 \uc790\uc6d0\uc774 \ube44\ud6a8\uc728\uc801\uc73c\ub85c \ubc30\ubd84\ub418\uae30 \ub54c\ubb38\uc774\ub2e4."
