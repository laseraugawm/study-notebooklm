    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uac00\uc758 \uc9c0\ubd88 \uc5ec\ubd80\uc640 \uad00\uacc4\uc5c6\uc774 \ub204\uad6c\ub098 \uc774\uc6a9\ud560 \uc218 \uc788\uc73c\uba70, \ud55c \uc0ac\ub78c\uc774 \uc18c\ube44\ud574\ub3c4 \ub2e4\ub978 \uc0ac\ub78c\uc758 \uc18c\ube44\ub7c9\uc774 \uc904\uc5b4\ub4e4\uc9c0 \uc54a\ub294 \uc7ac\ud654\ub098 \uc11c\ube44\uc2a4\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uacf5\uc7ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uacf5\uc7ac\uc758 \ub300\ud45c\uc801\uc778 \uc131\uaca9 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\ubc30\uc81c\uc131(\ub300\uac00\ub97c \ub0b4\uc9c0 \uc54a\uc544\ub3c4 \uc18c\ube44 \uac00\ub2a5)\uacfc \ube44\uacbd\ud569\uc131(\ud55c \uc0ac\ub78c\uc758 \uc18c\ube44\uac00 \ub2e4\ub978 \uc0ac\ub78c\uc758 \uc18c\ube44\ub97c \ubc29\ud574\ud558\uc9c0 \uc54a\uc74c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uacf5\uc7ac\uc758 \uc0ac\ub840\ub85c \uc81c\uc2dc\ub41c \uc0ac\ud68c\uc801 \uc11c\ube44\uc2a4 \ubc0f \uc7ac\ud654\uc758 \uc608\uc2dc 4\uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
