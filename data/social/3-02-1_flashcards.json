    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud558\ub098\uc758 \uae30\uc5c5\uc774 \uc2dc\uc7a5\uc744 \uc9c0\ubc30\ud558\ub294 \uc2dc\uc7a5 \ud615\ud0dc\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
