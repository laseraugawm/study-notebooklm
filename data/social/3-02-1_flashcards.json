        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ubc29 \ubc0f \uce58\uc548 \uc11c\ube44\uc2a4, \uac00\ub85c\ub4f1, \uacf5\uc6d0, \ub4f1\ub300"
