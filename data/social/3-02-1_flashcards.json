    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud569\ub9ac\uc801 \uc120\ud0dd\uc744 \ud558\ub824\uba74 \uc758\uc0ac \uacb0\uc815 \uacfc\uc815\uc5d0\uc11c \ub9e4\ubab0 \ube44\uc6a9\uc744 \uc5b4\ub5bb\uac8c \ub2e4\ub8e8\uc5b4\uc57c \ud558\ub294\uac00?"
