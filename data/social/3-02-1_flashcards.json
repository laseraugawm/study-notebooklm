    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc7a5 \uc2e4\ud328\uac00 \ubc1c\uc0dd\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc720\ud615 3\uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ub3c5\uacfc\uc810\uc758 \ud3d0\ud574\n2. \uacf5\uacf5\uc7ac\uc758 \ubd80\uc871\n3. \uc678\ubd80 \ud6a8\uacfc\uc758 \ubc1c\uc0dd"
