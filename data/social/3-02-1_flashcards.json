{
  "title": "\uacbd\uc81c\ud559 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc758 \ubb34\ud55c\ud55c \uc695\uad6c\uc5d0 \ube44\ud574 \uc774\ub97c \ucda9\uc871\ud560 \uc790\uc6d0\uc758 \uc591\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \ubd80\uc871\ud55c \uc0c1\ud0dc\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0\uc758 \ud76c\uc18c\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\ud65c\ub3d9\uc5d0\uc11c \uc5b4\ub5a4 \uc120\ud0dd\uc744 \ud568\uc73c\ub85c\uc368 \uc5bb\ub294 \uc774\uc775\uc774\ub098 \ub9cc\uc871\uac10\uc744 \ub73b\ud558\ub294 \uc6a9\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3b8\uc775"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub5a4 \uc120\ud0dd\uc744 \ud560 \ub54c \uc2e4\uc81c\ub85c \uc9c0\ucd9c\ud558\ub294 \ube44\uc6a9\uacfc \uadf8 \uc120\ud0dd\uc73c\ub85c \ud3ec\uae30\ud55c \ub300\uc548\uc758 \uac00\uce58 \uc911 \uac00\uc7a5 \ud070 \uac83\uc744 \ud569\uce5c \ube44\uc6a9\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud68c\ube44\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud68c\ube44\uc6a9\uc744 \uad6c\uc131\ud558\ub294 \ub450 \uac00\uc9c0 \uc138\ubd80 \ube44\uc6a9 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba85\uc2dc\uc801 \ube44\uc6a9\uacfc \uc554\ubb35\uc801 \ube44\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud68c\ube44\uc6a9\uc758 \uad6c\uc131 \uc694\uc18c \uc911 '\uc5b4\ub5a4 \uac83\uc744 \uc120\ud0dd\ud560 \ub54c \uc2e4\uc81c\ub85c \uc9c0\ucd9c\ud558\ub294 \ube44\uc6a9'\uc744 \ub73b\ud558\ub294 \uc6a9\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba85\uc2dc\uc801 \ube44\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud68c\ube44\uc6a9\uc758 \uad6c\uc131 \uc694\uc18c \uc911 '\uc120\ud0dd\uc73c\ub85c \uc778\ud574 \ud3ec\uae30\ud55c \ub300\uc548\ub4e4\uc758 \uac00\uce58 \uc911 \uac00\uc7a5 \ud070 \uac00\uce58'\ub97c \ub73b\ud558\ub294 \uc6a9\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc554\ubb35\uc801 \ube44\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc21c\ud3b8\uc775\uc744 \uad6c\ud558\ub294 \uacf5\uc2dd\uc744 \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc21c\ud3b8\uc775 = \ud3b8\uc775 - \uae30\ud68c\ube44\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud569\ub9ac\uc801 \uc120\ud0dd\uc758 \uc758\ubbf8\ub97c \uc21c\ud3b8\uc775 \uac1c\ub150\uc744 \ud65c\uc6a9\ud558\uc5ec \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ub7ec \ub300\uc548 \uc911 \ud3b8\uc775\uc5d0\uc11c \uae30\ud68c\ube44\uc6a9\uc744 \ube80 \uc21c\ud3b8\uc775\uc774 \uac00\uc7a5 \ud070 \ucd5c\uc120\uc758 \ub300\uc548\uc744 \uace0\ub974\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d4\uae09 5\ubc31\ub9cc \uc6d0(\uc5f0 6\ucc9c\ub9cc \uc6d0)\uc744 \ubc1b\ub358 \ud638\ud154 \uc8fc\ubc29\uc7a5\uc774 \uc9c1\uc7a5\uc744 \uadf8\ub9cc\ub450\uace0 \uc790\uc2e0\uc758 \uc74c\uc2dd\uc810\uc744 \uc6b4\uc601\ud558\ub824 \ud55c\ub2e4. \uc608\uc0c1 1\ub144 \uc218\uc785\uc774 3\uc5b5 \uc6d0, \uc2e4\uc81c \uc9c0\ucd9c \ube44\uc6a9\uc774 2\uc5b5 5\ucc9c\ub9cc \uc6d0\uc77c \ub54c \uba85\uc2dc\uc801 \ube44\uc6a9\uc740 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2\uc5b5 5\ucc9c\ub9cc \uc6d0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d4\uae09 5\ubc31\ub9cc \uc6d0(\uc5f0 6\ucc9c\ub9cc \uc6d0)\uc744 \ubc1b\ub358 \uc8fc\ubc29\uc7a5\uc774 \uc9c1\uc7a5\uc744 \uadf8\ub9cc\ub450\uace0 \uc74c\uc2dd\uc810\uc744 \uc5f4 \ub54c \ubc1c\uc0dd\ud558\ub294 \uc554\ubb35\uc801 \ube44\uc6a9\uc740 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0 6\ucc9c\ub9cc \uc6d0 (\uc9c1\uc7a5\uc744 \ud3ec\uae30\ud568\uc73c\ub85c\uc368 \uc0c1\uc2e4\ud558\ub294 \uc18c\ub4dd)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0 \uc18c\ub4dd 6\ucc9c\ub9cc \uc6d0 \uc9c1\uc7a5\uc744 \uadf8\ub9cc\ub450\uace0 \uc608\uc0c1 \uc218\uc785 3\uc5b5 \uc6d0, \uc9c0\ucd9c 2\uc5b5 5\ucc9c\ub9cc \uc6d0\uc778 \uc74c\uc2dd\uc810\uc744 \ucc3d\uc5c5\ud560 \ub54c, \ucd1d\uae30\ud68c\ube44\uc6a9\uc740 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "3\uc5b5 1\ucc9c\ub9cc \uc6d0 (\uba85\uc2dc\uc801 \ube44\uc6a9 2\uc5b5 5\ucc9c\ub9cc \uc6d0 + \uc554\ubb35\uc801 \ube44\uc6a9 6\ucc9c\ub9cc \uc6d0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud638\ud154 \uc8fc\ubc29\uc7a5\uc774 \uc5f0 6\ucc9c\ub9cc \uc6d0 \uc18c\ub4dd\uc744 \ud3ec\uae30\ud558\uace0 \uc5f0 \uc774\uc724 5\ucc9c\ub9cc \uc6d0(\uc218\uc785 3\uc5b5 - \uc9c0\ucd9c 2\uc5b5 5\ucc9c\ub9cc \uc6d0)\uc744 \uae30\ub300\ud558\uba70 \ucc3d\uc5c5\ud558\ub294 \uac83\uc774 \ud569\ub9ac\uc801 \uc120\ud0dd\uc774 \uc544\ub2cc \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc554\ubb35\uc801 \ube44\uc6a9(6\ucc9c\ub9cc \uc6d0)\uc744 \ud569\ud55c \ucd1d\uae30\ud68c\ube44\uc6a9\uc774 3\uc5b5 1\ucc9c\ub9cc \uc6d0\uc774 \ub418\uc5b4 \uc5f0\uac04 1\ucc9c\ub9cc \uc6d0\uc758 \uc190\ud574(\uc21c\ud3b8\uc775 \ub9c8\uc774\ub108\uc2a4)\ub97c \ubcf4\uae30 \ub54c\ubb38\uc774\ub2e4."
          },
          {
            "type": "image",
            "reference": "bbacbbc9-bc88-4b03-adbf-2db375db4bf5",
            "alt": "\ud638\ud154 \uc8fc\ubc29\uc7a5\uc774 \uc9c1\uc7a5\uc5d0 \ub0a8\ub294 \ub300\uc548\uacfc \ucc3d\uc5c5 \ub300\uc548 \uc0ac\uc774\uc5d0\uc11c \uace0\ubbfc\ud558\ub294 \ubaa8\uc2b5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ub2e8 \uc9c0\ucd9c\ud55c \ub4a4\uc5d0\ub294 \uc5b4\ub5a4 \uc120\ud0dd\uc744 \ud558\ub4e0\uc9c0 \ub2e4\uc2dc \ud68c\uc218\ud560 \uc218 \uc5c6\ub294 \ube44\uc6a9\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
