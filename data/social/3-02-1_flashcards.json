          {
            "type": "image",
            "reference": "f44a6c16-e9aa-4a09-9213-a939b6f7acb5",
            "alt": "\uac00\ub85c\ub4f1\uc774 \ucf1c\uc9c4 \ubc24\uae38\uacfc \uad6d\uacbd\uc744 \uacbd\uacc4\ud558\ub294 \uad6d\ubc29 \uad70\uc778\ub4e4\uc758 \ubaa8\uc2b5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ubb34\ub7f0 \ub300\uac00\ub97c \uc9c0\ubd88\ud558\uc9c0 \uc54a\uace0 \uacf5\uacf5\uc7ac\ub97c \uc18c\ube44\ud558\ub824\ub294 \ud589\uc704\ub098 \ud0dc\ub3c4\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ubb38\uc81c\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc784\uc2b9\ucc28\uc790 \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uacf5\uc7ac \uc0dd\uc0b0\uc744 \ubbfc\uac04 \uc2dc\uc7a5\uc5d0\ub9cc \ub9e1\uaca8\ub450\uba74 \uc5b4\ub5a0\ud55c \ud604\uc0c1\uc774 \ubc1c\uc0dd\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uc774 \uc774\uc724\uc744 \uc5bb\uc744 \uc218 \uc5c6\uc5b4 \uc0dd\uc0b0\uc744 \uc904\uc774\uac70\ub098 \ud3ec\uae30\ud558\ubbc0\ub85c \uc0ac\ud68c\uc801\uc73c\ub85c \ud544\uc694\ud55c \uc218\uc900\ubcf4\ub2e4 \ubd80\uc871\ud558\uac8c \uc0dd\uc0b0\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub5a4 \uacbd\uc81c \uc8fc\uccb4\uc758 \uacbd\uc81c\ud65c\ub3d9\uc774 \uc81c3\uc790\uc5d0\uac8c \uc758\ub3c4\ud558\uc9c0 \uc54a\uc740 \uc774\uc775\uc774\ub098 \ud53c\ud574\ub97c \uc8fc\uba74\uc11c\ub3c4 \uc774\uc5d0 \ub300\ud55c \ub300\uac00\ub97c \uc8fc\uace0\ubc1b\uc9c0 \uc54a\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\ubd80 \ud6a8\uacfc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\uc8fc\uccb4\uc758 \ud65c\ub3d9\uc774 \ub2e4\ub978 \uc774\uc5d0\uac8c \uc758\ub3c4\ud558\uc9c0 \uc54a\uc740 '\ud53c\ud574'\ub97c \uc8fc\uba74\uc11c\ub3c4 \ub300\uac00\ub97c \uce58\ub974\uc9c0 \uc54a\ub294 \uc0c1\ud0dc\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc7a5\uc758 \ub300\uae30 \uc624\uc5fc \ubb3c\uc9c8 \ubc30\ucd9c\uc740 \uc5b4\ub5a0\ud55c \uc678\ubd80 \ud6a8\uacfc\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc"
          },
          {
            "type": "image",
            "reference": "c1cae3a9-d6d3-4245-b5fe-bea4b880814e",
            "alt": "\uacf5\uc7a5\uc5d0\uc11c \ub9e4\uc5f0\uc774 \ubc1c\uc0dd\ud558\uc5ec \ud589\uc778\uc774 \uae30\uce68\uc744 \ud558\ub294 \ubd80\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc \uc0ac\ub840"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc\uac00 \ubc1c\uc0dd\ud558\ub294 \uc7ac\ud654\ub098 \uc11c\ube44\uc2a4\ub294 \uc2dc\uc7a5\uc5d0 \ub9e1\uae38 \uacbd\uc6b0 \uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\uc5d0 \ube44\ud574 \uc5b4\ub5bb\uac8c \uc0dd\uc0b0\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc9c0\ub098\uce58\uac8c \ub9ce\uc774(\uacfc\ub2e4) \uc0dd\uc0b0\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\ud65c\ub3d9\uc774 \ub2e4\ub978 \uacbd\uc81c \uc8fc\uccb4\uc5d0\uac8c \uc758\ub3c4\ud558\uc9c0 \uc54a\uc740 '\uc774\uc775'\uc744 \uc8fc\ub294\ub370\ub3c4 \ub300\uac00\ub97c \ubc1b\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud0dc\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae0d\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uac10 \uc608\ubc29 \uc811\uc885\uc744 \ub9de\ub294 \ud589\uc704\ub294 \uc5b4\ub5a4 \uc678\ubd80 \ud6a8\uacfc\uc758 \uc608\uc2dc\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae0d\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc (\ud0c0\uc778\uc5d0\uac8c \uac10\uc5fc\uc744 \uc904\uc5ec\uc8fc\ub294 \uc774\uc775 \uc81c\uacf5)"
          },
          {
            "type": "image",
            "reference": "926d80b5-1731-46e8-9db0-ae50dfb1ab36",
            "alt": "\ubcd1\uc6d0\uc5d0\uc11c \uc608\ubc29 \uc811\uc885\uc744 \ub9de\ub294 \ubaa8\uc2b5\uacfc \uc774\ub97c \ubc14\ub77c\ubcf4\ub294 \uc0ac\ub78c\ub4e4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae0d\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc\uac00 \ub098\ud0c0\ub098\ub294 \uacbd\uc81c\ud65c\ub3d9\uc740 \uc2dc\uc7a5\uc5d0 \ub9e1\uae38 \uacbd\uc6b0 \uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc5b4\ub5bb\uac8c \uc0dd\uc0b0/\uc18c\ube44\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc801\uac8c(\uacfc\uc18c) \ub098\ud0c0\ub09c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc774 \uc644\uc804\ud558\uac8c \ud569\ub9ac\uc801\uc778 \uc874\uc7ac\uac00 \uc544\ub2c8\ub77c '\uc81c\ud55c\uc801\uc73c\ub85c \ud569\ub9ac\uc801'\uc774\uba70 \uac10\uc815\uc801 \uc120\ud0dd\uc744 \ud55c\ub2e4\uace0 \uc804\uc81c\ud558\ub294 \uacbd\uc81c\ud559 \ubd84\uc57c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud589\ub3d9 \uacbd\uc81c\ud559"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud589\ub3d9 \uacbd\uc81c\ud559\uc744 \uc8fc\ucc3d\ud558\uace0 \uc81c\ud55c\uc801 \ud569\ub9ac\uc131 \uac1c\ub150\uc73c\ub85c \ub178\ubca8 \uacbd\uc81c\ud559\uc0c1\uc744 \uc218\uc0c1\ud55c \uc2ec\ub9ac\ud559\uc790\ub294 \ub204\uad6c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5c8\ubc84\ud2b8 \uc0ac\uc774\uba3c (Herbert Simon)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc98\uc74c \uc785\ub825\ub41c \uc815\ubcf4\uac00 \uc815\uc2e0\uc801 \uae30\uc900\uc774 \ub418\uc5b4 \uc774\ud6c4\uc758 \ud310\ub2e8\uacfc \uc120\ud0dd\uc5d0 \uacc4\uc18d \uc601\ud5a5\uc744 \uc8fc\ub294 \ud604\uc0c1\uc744 \ubb34\uc2a8 \ud6a8\uacfc\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2fb \ub0b4\ub9bc \ud6a8\uacfc (Anchoring Effect)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\ucf00\ud305\uc5d0\uc11c \uc74c\ub8cc\uc218 \ud560\uc778 \ud589\uc0ac \uc2dc '1\uc778\ub2f9 7\uac1c \uc81c\ud55c'\uc774\ub77c\ub294 \ubb38\uad6c\ub97c \ubd99\uc600\uc744 \ub54c \ud3c9\uade0 \uad6c\ub9e4\ub7c9\uc774 \uc99d\uac00\ud558\ub294 \uc774\uc720\ub294 \uc5b4\ub5a0\ud55c \uc2ec\ub9ac \ud6a8\uacfc \ub54c\ubb38\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2fb \ub0b4\ub9bc \ud6a8\uacfc (\uc81c\ud55c\ub41c \uc218\ub7c9\uc774 \uc18c\ube44\uc790\uc5d0\uac8c \ud310\ub2e8\uc758 \uae30\uc900/\ub2fb \uc5ed\ud560\uc744 \uc720\ub3c4\ud568)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc77c\ud55c \ub0b4\uc6a9\uc774\ub77c\ub3c4 \uc9c8\ubb38\uc774\ub098 \uc815\ubcf4 \uc81c\uc2dc \ubc29\uc2dd(\ud2c0)\uc5d0 \ub530\ub77c \uc0ac\ub78c\ub4e4\uc758 \ud310\ub2e8\uacfc \uc120\ud0dd\uc774 \ub2ec\ub77c\uc9c0\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub808\uc774\ubc0d \ud6a8\uacfc (Framing Effect)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub808\uc774\ubc0d \ud6a8\uacfc \uc774\ub860\uc5d0 \ub530\ub974\uba74, \uc0ac\ub78c\ub4e4\uc740 \uae0d\uc815\uc801 \uc778\uc2dd\uc758 \ud2c0(\uc774\ub4dd \ud504\ub808\uc784) \uc548\uc5d0\uc11c\ub294 \uc5b4\ub5a4 \uc120\ud0dd\uc744 \uc120\ud638\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\ud655\uc2e4\ud55c \uc774\ub4dd\ubcf4\ub2e4 \ud655\uc2e4\ud55c \uc774\ub4dd\uc744 \uc120\ud638\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub808\uc774\ubc0d \ud6a8\uacfc \uc774\ub860\uc5d0 \ub530\ub974\uba74, \uc0ac\ub78c\ub4e4\uc740 \ubd80\uc815\uc801 \uc778\uc2dd\uc758 \ud2c0(\uc190\uc2e4 \ud504\ub808\uc784) \uc548\uc5d0\uc11c\ub294 \uc5b4\ub5a4 \uc120\ud0dd\uc744 \uc120\ud638\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud655\uc2e4\ud55c \uc190\uc2e4\ubcf4\ub2e4 \ubd88\ud655\uc2e4\ud55c \uc190\uc2e4\uc744 \uc120\ud638\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'600\uba85 \uc0ac\ub9dd \uc9c8\ubcd1' \uc0ac\ub840\uc5d0\uc11c '200\uba85 \uc0dd\uc874(\uac00)' \ub300\uc548\uacfc '400\uba85 \uc0ac\ub9dd(\ub2e4)' \ub300\uc548\uc740 \ub3d9\uc77c\ud55c \uacb0\uacfc\uc774\ub2e4. \uadf8\ub7fc\uc5d0\ub3c4 \uc81c1\uc9d1\ub2e8\uc774 '200\uba85 \uc0dd\uc874'\uc744 \uc555\ub3c4\uc801\uc73c\ub85c \uc120\ud0dd\ud55c \uae4c\ub2ed\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc0dd\uc874'\uc774\ub77c\ub294 \uae0d\uc815\uc801 \ud504\ub808\uc784\uc5d0\uc11c\ub294 \ud655\ub960\uc801 \uc774\ub4dd\ubcf4\ub2e4 \ud655\uc2e4\ud55c \uc774\ub4dd(200\uba85 \ud655\uc2e4 \uc0dd\uc874)\uc744 \uc120\ud638\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'400\uba85 \uc0ac\ub9dd(\ub2e4)' \ub300\uc548 \ub300\uc2e0 \uc81c2\uc9d1\ub2e8\uc774 '\uc544\ubb34\ub3c4 \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc744 \ud655\ub960 $1/3$(\ub77c)'\uc744 \uc8fc\ub85c \uc120\ud0dd\ud55c \uae4c\ub2ed\uc740 \ud504\ub808\uc774\ubc0d \ud6a8\uacfc \uad00\uc810\uc5d0\uc11c \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc0ac\ub9dd'\uc774\ub77c\ub294 \ubd80\uc815\uc801 \ud504\ub808\uc784\uc5d0\uc11c\ub294 \ud655\uc2e4\ud55c \uc190\uc2e4(400\uba85 \uc0ac\ub9dd)\ubcf4\ub2e4 \uc704\ud5d8\uc774 \ub530\ub974\ub294 \ubd88\ud655\uc2e4\ud55c \uc190\uc2e4\uc744 \uc120\ud638\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\ud1b5 \uc8fc\ub958 \uacbd\uc81c\ud559\uacfc \ud589\ub3d9 \uacbd\uc81c\ud559\uc758 \uc778\uac04\uad00 \ucc28\uc774\ub97c \ud575\uc2ec \ud0a4\uc6cc\ub4dc\ub85c \ube44\uad50\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ub958 \uacbd\uc81c\ud559\uc740 \uc778\uac04\uc744 \uc644\uc804\ud558\uac8c '\ud569\ub9ac\uc801\uc778 \uc874\uc7ac'\ub85c \ubcf4\uc9c0\ub9cc, \ud589\ub3d9 \uacbd\uc81c\ud559\uc740 \uc778\uac04\uc744 '\uc81c\ud55c\uc801\uc73c\ub85c \ud569\ub9ac\uc801'\uc774\uba70 \uac10\uc815\uc801\uc778 \uc120\ud0dd\uc744 \ud558\ub294 \uc874\uc7ac\ub85c \ubcf8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uacfc\uc810\uc758 \ud3d0\ud574\uc640 \uacf5\uacf5\uc7ac\uc758 \ubd80\uc871 \ud604\uc0c1\uc774 \uacf5\ud1b5\uc801\uc73c\ub85c \uc57c\uae30\ud558\ub294 \uc2dc\uc7a5\uc758 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7ac\ud654\ub098 \uc11c\ube44\uc2a4\uac00 \uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc801\uac8c \uacf5\uae09\ub418\uc5b4 \uc790\uc6d0\uc758 \ube44\ud6a8\uc728\uc801 \ubc30\ubd84\uc744 \ucd08\ub798\ud55c\ub2e4\ub294 \uc810"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc\uc640 \uae0d\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc\uc758 \uc0dd\uc0b0\ub7c9 \uc65c\uace1 \ud604\uc0c1\uc744 \uac01\uac01 \ube44\uad50\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc\ub294 \uc0ac\ud68c\uc801 \uc801\uc815 \uc218\uc900\ubcf4\ub2e4 \uacfc\ub2e4 \uc0dd\uc0b0\ub418\uace0, \uae0d\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc\ub294 \uc0ac\ud68c\uc801 \uc801\uc815 \uc218\uc900\ubcf4\ub2e4 \uacfc\uc18c \uc0dd\uc0b0\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18 \uc0ac\uc801 \uc7ac\ud654\uc640 \uacf5\uacf5\uc7ac\uc758 \uad6c\ubcc4 \uae30\uc900\uc774 \ub418\ub294 \uc18c\ube44\uc790 \ud2b9\uc131 2\uac00\uc9c0\ub97c \ube44\uad50\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc801 \uc7ac\ud654\ub294 \ubc30\uc81c\uc131\uacfc \uacbd\ud569\uc131\uc744 \uac00\uc9c0\ub098, \uacf5\uacf5\uc7ac\ub294 \ube44\ubc30\uc81c\uc131\uacfc \ube44\uacbd\ud569\uc131\uc744 \uac00\uc9c4\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud569\ub9ac\uc801 \uc120\ud0dd\uc744 \ud310\ub2e8\ud560 \ub54c '\uae30\ud68c\ube44\uc6a9'\uacfc '\ub9e4\ubab0 \ube44\uc6a9'\uc758 \ubc18\uc601 \uc5ec\ubd80\ub97c \ube44\uad50\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
