        {
          "text": "\uc720\uc18c\ub144 \uc778\uad6c\uc758 \ud3ed\ubc1c\uc801 \uc99d\uac00\ub85c \uc778\ud55c \uad50\uc721 \uc790\uc6d0 \ubd80\uc871 \u2192 \ucd9c\uc0b0 \uc5b5\uc81c\uae08 \ubd80\uacfc \uc815\ucc45 \ub3c4\uc785",
          "isCorrect": false,
          "rationale": "\uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \uc0ac\ud68c\uc5d0\uc11c\ub294 \uc720\uc18c\ub144 \uc778\uad6c\uac00 \uc904\uc5b4\ub4e4\ubbc0\ub85c \ucd9c\uc0b0 \uc7a5\ub824 \uc815\ucc45\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
