        {
          "text": "\ud658\uacbd\u00b7\uc0ac\ud68c\u00b7\ud22c\uba85(ESG) \uacbd\uc601\uc744 \uc2e4\ucc9c\ud558\ub294 \uae30\uc5c5\uc758 \uc81c\ud488\uc778\uc9c0\ub97c \ud655\uc778\ud558\uace0 \uc18c\ube44\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "ESG \uacbd\uc601 \uae30\uc5c5\uc758 \uc81c\ud488\uc744 \uc120\ud0dd\ud558\ub294 \uac83\uc740 \uac00\uce58 \uc18c\ube44\uc640 \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc9c0\uc6d0\ud558\ub294 \ud589\ub3d9\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc81c\ud488\uc774 \ud658\uacbd\uacfc \uc0ac\ud68c\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ubb34\uc2dc\ud558\uace0 \ub2e8\uae30\uc801 \uac00\uaca9\ub9cc \ub530\uc9c0\ub294 \uc18c\ube44 \ubc29\uc2dd\uc744 \ucc3e\uc73c\uc138\uc694."
    },
    {
      "question": "\uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \ud604\uc0c1\uc73c\ub85c \ubc1c\uc0dd\ud558\ub294 \uc0ac\ud68c\uc801 \ubb38\uc81c\uc640 \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc704\ud55c \ud574\uacb0 \ubc29\uc548\uc758 \uc5f0\uacb0\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub178\ub144\uce35 \ubcf5\uc9c0 \ube44\uc6a9 \uae09\uc99d\uc5d0 \ub530\ub978 \uc138\ub300 \uac04 \uac08\ub4f1 \u2192 \uccad\ub144\uce35\uacfc \ub178\ub144\uce35\uc758 \ud615\ud3c9\uc131\uc744 \uace0\ub824\ud55c \uc0ac\ud68c \ubcf4\uc7a5 \uc815\ucc45 \ub9c8\ub828",
          "isCorrect": true,
          "rationale": "\uccad\ub144\uce35\uc758 \ubd80\ub2f4\uacfc \ub178\ub144\uce35\uc758 \ubcf5\uc9c0 \uc218\uc694 \uc0ac\uc774\uc5d0\uc11c \ud615\ud3c9\uc131\uc744 \uac16\ucd98 \ubcf5\uc9c0 \uc81c\ub3c4\ub97c \ub9c8\ub828\ud558\ub294 \uac83\uc774 \uc0ac\ud68c \ud1b5\ud569\uacfc \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."
