{
  "title": "\uc138\uacc4\uc2dc\ubbfc \ud034\uc988",
  "questions": [
    {
      "question": "\ub9c8\uc0ac \ub204\uc2a4\ubc14\uc6c0(Martha Nussbaum)\uc758 \uc8fc\uc7a5\uc5d0 \ub530\ub978 '\uc138\uacc4\uc2dc\ubbfc' \ubc0f \uc790\uc544\uc758 \ud655\ub300 \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc758 \uc790\uc544\ub294 \uad6d\uac00\ub77c\ub294 \ud55c\uacc4 \ub0b4\uc5d0\uc11c\ub9cc \uc815\uccb4\uc131\uc744 \ud615\uc131\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uc758 \uc790\uc544\ub294 \uc790\uad6d\ubbfc \ub2e8\uacc4\ub97c \ub118\uc5b4 \uc778\ub958 \uc804\uccb4\ub85c \ud655\ub300\ub418\ub294 \ub3d9\uc2ec\uc6d0\uc801 \uad6c\uc870\ub97c \uac00\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc740 \uc790\uc544\uc5d0\uc11c \uc2dc\uc791\ud558\uc5ec \uc774\uc6c3, \uad6d\uac00\ub97c \uac70\uccd0 \uc778\ub958 \uc804\uccb4\ub85c \ud655\ub300\ub418\ub294 \ub3d9\uc2ec\uc6d0\uc5d0 \ub458\ub7ec\uc2f8\uc5ec \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\uc778\uc740 \uc790\uc544, \uac00\uc871, \uc774\uc6c3, \uc9c0\uc5ed, \uc2dc\ubbfc, \uad6d\ubbfc\uc744 \uac70\uccd0 \uc778\ub958 \uc804\uccb4\uc5d0 \uc774\ub974\ub294 \ud655\uc7a5\ub41c \ub3d9\uc2ec\uc6d0 \uc18d\uc5d0\uc11c \uc790\uc2e0\uc744 \uc138\uacc4\uc2dc\ubbfc\uc73c\ub85c \uc778\uc2dd\ud558\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\ubcc4 \uc0ac\ud68c \uc9d1\ub2e8\uc758 \uc774\uc775\uc744 \uc9c0\ud0a4\ub294 \uac83\uc774 \uc778\ub958 \uc804\uccb4\uc758 \uc774\uc775\ubcf4\ub2e4 \ud56d\uc0c1 \uc6b0\uc120\uc2dc\ub418\uc5b4\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uacc4\uc2dc\ubbfc \uc758\uc2dd\uc740 \uac1c\ubcc4 \uc9d1\ub2e8\uc758 \uc774\uc775\uc744 \ub118\uc5b4 \uc778\ub958\uc758 \ubcf4\ud3b8\uc801 \uac00\uce58\uc640 \uc778\ub958 \uc804\uccb4\uc758 \uc774\uc775\uc744 \uc911\uc2dc\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4\ud654 \uc2dc\ub300\uc5d0\ub294 \uad6d\uac00 \uac04 \uacbd\uc7c1\uc744 \uc2ec\ud654\uc2dc\ud0a4\ub294 \uac83\uc774 \uc778\ub958 \uacf5\ub3d9\uccb4 \ubc1c\uc804\uc5d0 \uae30\uc5ec\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uacc4\uc2dc\ubbfc\uc740 \uad6d\uac00 \uac04 \ubb34\ud55c \uacbd\uc7c1\ubcf4\ub2e4\ub294 \uc9c0\uad6c\ucd0c \uad6c\uc131\uc6d0 \uac04\uc758 \uc774\ud574\uc640 \ud611\ub825\uc744 \ucd94\uad6c\ud574\uc57c \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac1c\uc778\uc744 \ub458\ub7ec\uc2fc \uacf5\ub3d9\uccb4\uc758 \ubc94\uc704\uac00 \uc790\uc544\uc5d0\uc11c \ucd9c\ubc1c\ud558\uc5ec \uc5b4\ub514\uae4c\uc9c0 \ud655\uc7a5\ub418\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc81c\uc2dc\ub41c \ubbf8\ub798 \uc0ac\ud68c\uc758 \uc8fc\uc694 \uc9c1\uc5c5\uacfc \ud574\ub2f9 \uc9c1\uc5c5\uc774 \uc18d\ud55c \ubd84\uc57c\uc758 \uc5f0\uacb0\uc774 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uae30\ud6c4\ubcc0\ud654 \ub300\uc751 \uc804\ubb38\uac00 - \uc0ac\ud68c\ud658\uacbd",
          "isCorrect": false,
          "rationale": "\uae30\ud6c4\ubcc0\ud654\ub97c \uc608\uce21\ud558\uace0 \ub300\ucc45\uc744 \ub9c8\ub828\ud558\ub294 \uc9c1\uc5c5\uc740 \uc0ac\ud68c\ud658\uacbd \ubd84\uc57c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uccb4 \uc778\uc2dd \uc804\ubb38\uac00 - \ubcf4\uc548",
          "isCorrect": false,
          "rationale": "\uc2e0\uccb4 \ud2b9\uc9d5\uc744 \ud65c\uc6a9\ud55c \ubcf4\uc548 \uc7a5\uce58\ub97c \ub9cc\ub4dc\ub294 \uc9c1\uc5c5\uc740 \ubcf4\uc548 \ubd84\uc57c\ub85c \ubd84\ub958\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ub3c4\uc2dc \uc7ac\uc0dd \uc804\ubb38\uac00 - \ubcf4\uc548",
          "isCorrect": true,
          "rationale": "\ub099\ud6c4\ub41c \ub3c4\uc2dc\uc5d0 \uc0c8\ub85c\uc6b4 \uc0dd\uba85\uc744 \ubd88\uc5b4\ub123\ub294 \ub3c4\uc2dc \uc7ac\uc0dd \uc804\ubb38\uac00\ub294 \ubcf4\uc548\uc774 \uc544\ub2c8\ub77c \uc0ac\ud68c\ud658\uacbd \ubd84\uc57c\uc5d0 \uc18d\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ubb3c \uc778\ud130\ub137 \uc804\ubb38\uac00 - \uae30\uc220",
          "isCorrect": false,
          "rationale": "\ubaa8\ub4e0 \uc0ac\ubb3c\uc744 \uc778\ud130\ub137\uc73c\ub85c \uc5f0\uacb0\ud558\ub294 \uc11c\ube44\uc2a4 \ubc0f \uac00\uce58\ub97c \ucc3d\ucd9c\ud558\ub294 \uc9c1\uc5c5\uc740 \uae30\uc220 \ubd84\uc57c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub3c4\uc2dc\uc758 \ud658\uacbd\uc744 \ub2e4\ub8e8\ub294 \uc9c1\uc5c5\uc774 '\ubcf4\uc548' \ubd84\ub958\uc5d0 \uc801\uc808\ud55c\uc9c0 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc120\uc9c4\uad6d(\ud504\ub791\uc2a4)\uacfc \uac1c\ubc1c \ub3c4\uc0c1\uad6d(\uac00\ub098)\uc758 \uc778\uad6c \uad6c\uc870 \ud2b9\uc131\uc744 \ube44\uad50\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud504\ub791\uc2a4\ub294 \uac00\ub098\ubcf4\ub2e4 \uc911\uc704 \uc5f0\ub839\uc774 \ub192\uace0 \ub178\ub144\uce35\uc758 \ube44\uc728\uc774 \ub192\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc120\uc9c4\uad6d\uc778 \ud504\ub791\uc2a4\ub294 \uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \ud604\uc0c1\uc73c\ub85c \uc778\ud574 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc778 \uac00\ub098\ubcf4\ub2e4 \uc911\uc704 \uc5f0\ub839 \ubc0f \ub178\ub144\uce35 \ube44\uc728\uc774 \ub192\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "\uac00\ub098\ub294 \ud504\ub791\uc2a4\ubcf4\ub2e4 \uae30\ub300 \uc218\uba85\uc774 \uae38\uace0 \uc778\uad6c \uc99d\uac00\uc728\uc774 \uc815\uccb4\ub418\uc5b4 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc740 \uc120\uc9c4\uad6d\ubcf4\ub2e4 \uae30\ub300 \uc218\uba85\uc774 \uc9e7\uace0 \uc778\uad6c \uc99d\uac00\uc728\uc740 \ub192\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "\ud504\ub791\uc2a4\ub294 \uac00\ub098\ubcf4\ub2e4 \uc720\uc18c\ub144\uce35(0~14\uc138)\uc758 \uc778\uad6c \ube44\uc728\uc774 \ub354 \ub192\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac00\ub098\uc640 \uac19\uc740 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc740 \ub192\uc740 \ucd9c\uc0b0\uc728\ub85c \uc778\ud574 \uc720\uc18c\ub144\uce35 \uc778\uad6c \ube44\uc911\uc774 \uc120\uc9c4\uad6d\ubcf4\ub2e4 \ud6e8\uc52c \ub192\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uac00\ub098\ub294 \uc778\uad6c \uacfc\uc789 \ubb38\uc81c\ubcf4\ub2e4 \uc800\ucd9c\uc0dd\uc73c\ub85c \uc778\ud55c \ub178\ub3d9\ub825 \ubd80\uc871 \ubb38\uc81c\ub97c \uc8fc\ub85c \uacaa\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc800\ucd9c\uc0dd \ubc0f \uace0\ub839\ud654 \ubb38\uc81c\ub294 \uc8fc\ub85c \uc120\uc9c4\uad6d\uc5d0\uc11c \ub098\ud0c0\ub098\uba70, \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc740 \uc778\uad6c \uacfc\uc789 \ubb38\uc81c\ub97c \uc8fc\ub85c \uacbd\ud5d8\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654\uac00 \uc9c4\ud589\ub41c \uad6d\uac00\uc77c\uc218\ub85d \uc5f0\ub839\ub300\ubcc4 \uc778\uad6c \ube44\uc911\uacfc \uc911\uc704 \uc5f0\ub839\uc774 \uc5b4\ub5bb\uac8c \ubcc0\ud654\ud558\ub294\uc9c0 \uace0\ub824\ud558\uc138\uc694."
    },
    {
      "question": "\uc8fc\uc694 \ud654\uc11d \uc5d0\ub108\uc9c0 \uc790\uc6d0(\uc11d\ud0c4, \uc11d\uc720, \ucc9c\uc5f0\uac00\uc2a4)\uc758 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc11d\uc720\ub294 \ud654\uc11d \uc790\uc6d0 \uc911 \uc5f0\uc18c \uc2dc \uc624\uc5fc \ubb3c\uc9c8 \ubc30\ucd9c\ub7c9\uc774 \uac00\uc7a5 \uc801\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc624\uc5fc \ubb3c\uc9c8 \ubc30\ucd9c\ub7c9\uc774 \uac00\uc7a5 \uc801\uc740 \uc5d0\ub108\uc9c0 \uc790\uc6d0\uc740 \ucc9c\uc5f0\uac00\uc2a4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ucc9c\uc5f0\uac00\uc2a4\ub294 \uc11d\uc720\ub098 \uc11d\ud0c4\ubcf4\ub2e4 \uc624\uc5fc \ubb3c\uc9c8 \ubc30\ucd9c\ub7c9\uc774 \uc801\uc5b4 \uce5c\ud658\uacbd\uc801\uc778 \ud654\uc11d \uc5f0\ub8cc\ub85c \uaf3d\ud78c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucc9c\uc5f0\uac00\uc2a4\ub294 \uc5f0\uc18c \uc2dc \ub300\uae30 \uc624\uc5fc \ubb3c\uc9c8 \ubc0f \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \ud654\uc11d \uc5f0\ub8cc \uc911 \uac00\uc7a5 \uc801\ub2e4\ub294 \ud2b9\uc9d5\uc774 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc11d\ud0c4\uc740 \uad6d\uc81c \uc774\ub3d9\ub7c9\uacfc \uc804\uccb4 \uc5d0\ub108\uc9c0 \uc18c\ube44\ub7c9\uc774 \uac00\uc7a5 \ub9ce\uc740 \uc790\uc6d0\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uacc4 \uc18c\ube44\ub7c9\uacfc \uad6d\uc81c \uc774\ub3d9\ub7c9\uc774 \uac00\uc7a5 \ub9ce\uc740 \uc5d0\ub108\uc9c0 \uc790\uc6d0\uc740 \uc11d\uc720\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub294 \ud654\uc11d \uc790\uc6d0\ubcf4\ub2e4 \uace0\uac08 \uc704\ud5d8\uc774 \ud06c\ub2e4\ub294 \ub2e8\uc810\uc774 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub294 \uc790\uc5f0\uc5d0\uc11c \uc5bb\uc5b4 \uace0\uac08 \uc6b0\ub824\uac00 \uc801\uace0 \uc9c0\uc18d \uc0ac\uc6a9\uc774 \uac00\ub2a5\ud55c \uc5d0\ub108\uc9c0\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub300\uae30 \uc624\uc5fc \ubb3c\uc9c8 \ubc30\ucd9c\ub7c9\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \uc801\uc5b4 \ube44\uad50\uc801 \uae68\ub057\ud558\ub2e4\uace0 \ud3c9\uac00\ubc1b\ub294 \ud654\uc11d \uc5f0\ub8cc\ub97c \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "1987\ub144 \uc138\uacc4 \ud658\uacbd \uac1c\ubc1c \uc704\uc6d0\ud68c(WCED)\uc5d0\uc11c \uc81c\uc2dc\ub418\uace0 1992\ub144 \ub9ac\uc6b0 \ud68c\uc758\uc5d0\uc11c \ucc44\ud0dd\ub41c \uac1c\ub150\uc73c\ub85c, \uacbd\uc81c \ubc1c\uc804, \uc0ac\ud68c \uc548\uc815\uacfc \ud1b5\ud569, \ud658\uacbd \ubcf4\uc804\uc758 \uade0\ud615\uc744 \ucd94\uad6c\ud558\ub294 \ubc1c\uc804 \ubaa8\ub378\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc6d0 \ubbfc\uc871\uc8fc\uc758",
          "isCorrect": false,
          "rationale": "\uc790\uc6d0 \ubbfc\uc871\uc8fc\uc758\ub294 \uc790\uc6d0 \ubcf4\uc720\uad6d\uc774 \uc790\uad6d \uc790\uc6d0\uc5d0 \ub300\ud55c \ud1b5\uc81c\uad8c\uc744 \uac15\ud654\ud558\ub294 \ud604\uc0c1\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804",
          "isCorrect": true,
          "rationale": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc740 \ubbf8\ub798 \uc138\ub300\uc758 \ud544\uc694\ub97c \ucda9\uc871\uc2dc\ud0ac \ub2a5\ub825\uc744 \ud6fc\uc190\ud558\uc9c0 \uc54a\uc73c\uba74\uc11c \ud604\uc7ac \uc138\ub300\uc758 \ud544\uc694\ub97c \ucda9\uc871\ud558\ub294 \ubc1c\uc804\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud0c4\uc18c \uad6d\uacbd \uc870\uc815",
          "isCorrect": false,
          "rationale": "\ud0c4\uc18c \uad6d\uacbd \uc870\uc815\uc740 \ud0c4\uc18c \ubc30\ucd9c \uaddc\uc81c\uac00 \ub290\uc2a8\ud55c \uad6d\uac00 \uc81c\ud488\uc5d0 \uad00\uc138\ub97c \ubd80\uacfc\ud558\ub294 \ubb34\uc5ed \uc81c\ub3c4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc591\uc801 \uacbd\uc81c \uc131\uc7a5",
          "isCorrect": false,
          "rationale": "\uc591\uc801 \uacbd\uc81c \uc131\uc7a5\uc740 \ud658\uacbd\uc774\ub098 \uc0ac\ud68c\uc801 \uade0\ud615\uc744 \ubc30\uc81c\ud558\uace0 \ub2e8\uc21c\ud788 \uacbd\uc81c \uaddc\ubaa8 \ud655\uc7a5\uc5d0\ub9cc \uc9d1\uc911\ud558\ub294 \uac1c\ub150\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubbf8\ub798 \uc138\ub300\uc758 \uc0b6\uc744 \uc704\ud611\ud558\uc9c0 \uc54a\uc73c\uba74\uc11c \ud658\uacbd\uacfc \uc0ac\ud68c, \uacbd\uc81c\uac00 \uade0\ud615\uc744 \uc774\ub8e8\ub294 \ubc1c\uc804 \uac1c\ub150\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc138\uacc4\uc2dc\ubbfc\uc73c\ub85c\uc11c \uc9c0\uad6c\ucd0c \uc804\uccb4\uc758 \ubb38\uc81c(\uae30\ud6c4\ubcc0\ud654, \uc804\uc5fc\ubcd1, \uad6d\uc81c \ud14c\ub7ec \ub4f1)\uc5d0 \ub300\uc751\ud558\ub294 \ubc14\ub78c\uc9c1\ud55c \uc790\uc138\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc778\ub958\uc758 \ubcf4\ud3b8\uc801\uc778 \uac00\uce58\ub97c \uac1c\ubcc4 \uc9d1\ub2e8\uc758 \uc774\uc775\ubcf4\ub2e4 \uc6b0\uc120\uc2dc\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uacc4\uc2dc\ubbfc \uc758\uc2dd\uc758 \ud575\uc2ec\uc740 \uc778\ub958 \uc804\uccb4\uc758 \uacf5\ub3d9\uccb4\uc801 \uac00\uce58\ub97c \uc874\uc911\ud558\ub294 \uac83\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uad6c\ucd0c\uc758 \ub2e4\uc591\ud55c \ubb38\ud654\uc640 \ubc30\uacbd\uc744 \uac00\uc9c4 \uc0ac\ub78c\ub4e4\uc744 \uc874\uc911\ud558\uace0 \ud611\ub825\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e4\uc591\uc131\uc5d0 \ub300\ud55c \uc874\uc911\uacfc \uad6d\uc81c\uc801 \ud611\ub825\uc740 \uc804 \uc9c0\uad6c\uc801 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub294 \uae30\ubc18\uc774 \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uad6c\ucd0c \ubb38\uc81c\ub294 \uad6d\uac00\uc640 \uad6d\uc81c\uae30\uad6c\uc758 \uc804\uc720\ubb3c\uc774\ubbc0\ub85c \uac1c\uc778\uc740 \uc790\uad6d\uc758 \ubb38\uc81c\uc5d0\ub9cc \uc9d1\uc911\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc804 \uc9c0\uad6c\uc801 \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574\uc11c\ub294 \uad6d\uac00\ubfd0\ub9cc \uc544\ub2c8\ub77c \uac1c\uc778\ub3c4 \uc9c0\uad6c\ucd0c\uc758 \uad6c\uc131\uc6d0\uc73c\ub85c\uc11c \ucc45\uc784\uac10\uc744 \uac00\uc9c0\uace0 \ucc38\uc5ec\ud574\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc5d0 \uad00\uc2ec\uc744 \uac00\uc9c0\uace0 \uc9c1\uc5c5 \uc120\ud0dd\uc774\ub098 \uc0b6\uc758 \ubc29\ud5a5 \uc124\uc815\uc5d0 \uc774\ub97c \ubc18\uc601\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc2e0\uc758 \uc9c1\uc5c5\uacfc \uc0b6\uc758 \ubc29\ud5a5\uc744 \ud1b5\ud574 \uc9c0\uad6c\ucd0c \ubbf8\ub798\uc5d0 \uae30\uc5ec\ud558\ub294 \uace0\ubbfc\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
