        },
        {
          "text": "\uc0c1\ud488\uc758 \uc0dd\uc0b0 \uacfc\uc815\uc744 \uace0\ub824\ud558\uc9c0 \uc54a\uace0 \uc624\uc9c1 \uac00\uaca9\uc774 \uac00\uc7a5 \uc800\ub834\ud55c \uc81c\ud488\ub9cc\uc744 \ub300\ub7c9 \uad6c\ub9e4\ud55c\ub2e4.",
