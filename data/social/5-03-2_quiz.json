        {
          "text": "\uc0dd\uc0b0 \uc5f0\ub839 \uc778\uad6c \uacfc\uc789\uc73c\ub85c \uc778\ud55c \uccad\ub144 \uc2e4\uc5c5 \uc545\ud654 \u2192 \uccad\ub144 \uc138\ub300\uc758 \ud574\uc678 \uc774\uc8fc \uc804\uba74 \uac15\uc81c",
          "isCorrect": false,
          "rationale": "\uace0\ub839\ud654 \uc0ac\ud68c\ub294 \uc0dd\uc0b0 \uc5f0\ub839 \uc778\uad6c\uac00 \uac10\uc18c\ud558\uc5ec \ub178\ub3d9\ub825 \ubd80\uc871 \ubb38\uc81c\ub97c \uacaa\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc2dd\ub7c9 \uc790\uc6d0 \uc18c\ube44 \uae09\uc99d\uc5d0 \ub530\ub978 \uc778\uad6c \uacfc\uc789 \ubb38\uc81c \u2192 \ub18d\ucd0c \uc9c0\uc5ed\uc758 \uac1c\ubc1c \uc81c\ud55c \ubc0f \ucd0c\ub77d \ud3d0\uc1c4",
          "isCorrect": false,
          "rationale": "\uc778\uad6c \uacfc\uc789 \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574\uc11c\ub294 \uc2dd\ub7c9 \uc99d\uc0b0\uacfc \ucd0c\ub77d\uc758 \uc0dd\ud65c \ud658\uacbd \uac1c\uc120\uc774 \uc774\ub8e8\uc5b4\uc838\uc57c \ud569\ub2c8\ub2e4."
        }
