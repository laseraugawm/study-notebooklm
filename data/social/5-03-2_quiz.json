      "hint": "\uc804\uc7c1\uc774\ub098 \uc815\uce58\uc801 \ubd84\uc7c1\uc73c\ub85c \uc778\ud574 \uace0\ud5a5\uc744 \ub5a0\ub098\uc57c \ud558\ub294 \uc774\uc8fc\ubbfc \uc9d1\ub2e8\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc77c\uc0c1\uc0dd\ud65c \uc18d\uc5d0\uc11c \uc2e4\ucc9c\ud560 \uc218 \uc788\ub294 '\ud0c4\uc18c \uc911\ub9bd' \ubc0f '\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804'\uc744 \uc704\ud55c \ud589\ub3d9\uc73c\ub85c \uac00\uc7a5 \uac70\ub9ac\uac00 \uba3c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2a4\ub9c8\ud2b8\ud3f0 \uc804\uc6d0\uc744 \ub044\uac70\ub098 \uc0ac\uc6a9 \uc2dc\uac04\uc744 \uc904\uc5ec \ub514\uc9c0\ud138 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc744 \uc808\uac10\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ub9c8\ud2b8\ud3f0 \uc0ac\uc6a9 \uac10\ucd95 \ubc0f \uc5b4\ub450\uc6b4 \ubc30\uacbd\ud654\uba74 \uc0ac\uc6a9 \ub4f1\uc740 \ud0c4\uc18c \ubc30\ucd9c\uc744 \uc904\uc774\ub294 \uc2e4\ucc9c \ud589\ub3d9\uc785\ub2c8\ub2e4."
