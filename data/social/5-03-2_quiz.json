          "isCorrect": false,
          "rationale": "\ub354 \ub098\uc740 \uc77c\uc790\ub9ac\uc640 \uacbd\uc81c\uc801 \uae30\ud68c\ub97c \ucc3e\uc544 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc5d0\uc11c \uc120\uc9c4\uad6d\uc73c\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0\uac00 \uc77c\ubc18\uc801\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\uce58\uc801 \uc694\uc778\uc5d0 \uc758\ud55c \ub300\ud45c\uc801\uc778 \uc778\uad6c \uc774\ub3d9 \ud615\ud0dc\ub294 \uc804\uc7c1\uc774\ub098 \uac08\ub4f1\uc5d0 \ub530\ub978 \ub09c\ubbfc\uc758 \uc774\ub3d9\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc804\uc7c1, \ubc15\ud574, \uc815\uce58\uc801 \ubd88\uc548\uc815\uc131\uc73c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \ub09c\ubbfc\uc758 \uc774\ub3d9\uc740 \uc815\uce58\uc801 \uc694\uc778\uc5d0 \uc758\ud55c \uc778\uad6c \uc774\ub3d9\uc758 \ub300\ud45c \uc608\uc2dc\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc758 \uace0\ub839\ud654 \ud604\uc0c1\uc73c\ub85c \uc778\ud574 \uc120\uc9c4\uad6d\uc758 \uc80a\uc740 \ub178\ub3d9\ub825\uc774 \uac1c\ub3c4\uad6d\uc73c\ub85c \uc774\ub3d9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \ud604\uc0c1\uc740 \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc774 \uc544\ub2cc \uc120\uc9c4\uad6d\uc5d0\uc11c \uc8fc\ub85c \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4 \uc778\uad6c \uc774\ub3d9\uc740 \uc790\uc5f0\uc801 \ud658\uacbd \uc870\uac74\uc5d0\ub9cc \uc758\ud574\uc11c \uacb0\uc815\ub418\uba70 \uc0ac\ud68c\uc801 \uc694\uc778\uc740 \uc791\uc6a9\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\uad6c \uc774\ub3d9\uc740 \uc9c0\ud615, \uae30\ud6c4 \ub4f1 \uc790\uc5f0\uc801 \uc694\uc778\ubfd0\ub9cc \uc544\ub2c8\ub77c \uacbd\uc81c, \uc815\uce58, \ubb38\ud654 \ub4f1 \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \uc694\uc778\uc758 \uc601\ud5a5\uc744 \ubcf5\ud569\uc801\uc73c\ub85c \ubc1b\uc2b5\ub2c8\ub2e4."
