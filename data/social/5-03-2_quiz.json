        {
          "text": "\uce5c\ud658\uacbd \uac00\ubc29(\uc5d0\ucf54\ubc31)\uc744 \uc81c\uc791\ud558\uc5ec \uac1c\ubc1c \ub3c4\uc0c1\uad6d \uc544\ub3d9\uc5d0\uac8c \uc804\ub2ec\ud558\ub294 \ucea0\ud398\uc778\uc5d0 \ucc38\uc5ec\ud55c\ub2e4.",
          "isCorrect": false,
