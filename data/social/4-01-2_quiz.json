{
  "title": "\uc138\uacc4\ud654 \uc724\ub9ac \ud034\uc988",
  "questions": [
    {
      "question": "\uc138\uacc4\ud654\uac00 \uacbd\uc81c \ubc0f \uc0ac\ud68c \uc804\ubc18\uc5d0 \ubbf8\uce58\ub294 \uae0d\uc815\uc801 \uc601\ud5a5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uac00 \uac04 \ubb34\uc5ed \ud65c\uc131\ud654\uc640 \uae30\uc220 \ud601\uc2e0\uc744 \ucd09\uc9c4\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uacc4\ud654\ub294 \ubb34\uc5ed \uc99d\uac00\uc640 \uae30\uc220 \ud601\uc2e0\uc744 \uc774\ub04c\uc5b4 \uc138\uacc4 \uac01\uad6d\uc758 \uacbd\uc81c \ubc1c\uc804\uc744 \ucd09\uc9c4\ud558\ub294 \uae0d\uc815\uc801 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub2e4\uc591\ud55c \uc81c\ud488 \uc18c\ube44 \uae30\ud68c\ub97c \ud655\ub300\ud558\uace0 \uc77c\uc790\ub9ac\ub97c \ucc3d\ucd9c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uacc4\ud654\ub97c \ud1b5\ud574 \uae00\ub85c\ubc8c \uc2dc\uc7a5\uc774 \ud615\uc131\ub418\uba74\uc11c \uc18c\ube44 \uae30\ud68c\uac00 \ub298\uc5b4\ub098\uace0 \uace0\uc6a9 \ucc3d\ucd9c \ubc0f \uc0dd\ud65c \uc218\uc900 \ud5a5\uc0c1\uc774 \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc720 \ubb34\uc5ed\uc758 \uacb0\uacfc\ub85c \uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d \uac04 \ubd80\uc758 \uade0\ub4f1\ud55c \ubd84\ubc30\uac00 \uc774\ub8e8\uc5b4\uc9c4\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc138\uacc4\ud654\ub85c \uc138\uacc4 \uc804\uccb4\uc758 \ubd80\ub294 \uc99d\uac00\ud558\uc9c0\ub9cc \uc790\ubcf8\uacfc \uae30\uc220\ub825\uc774 \ud48d\ubd80\ud55c \uc120\uc9c4\uad6d\uc5d0 \ubd80\uac00 \uc9d1\uc911\ub418\uc5b4 \uad6d\uac00 \uac04 \ube48\ubd80 \uaca9\ucc28\uac00 \uc624\ud788\ub824 \uc2ec\ud654\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ud65c\ubc1c\ud55c \ubb38\ud654 \uad50\ub958\ub97c \ud1b5\ud574 \ubb38\ud654 \ub2e4\uc591\uc131\uc744 \ub113\ud788\ub294 \uacc4\uae30\uac00 \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804 \uc9c0\uad6c\uc801 \ucc28\uc6d0\uc758 \ud65c\ubc1c\ud55c \ubb38\ud654 \uad50\ub958\ub294 \uc11c\ub85c \ub2e4\ub978 \ubb38\ud654\ub97c \uc811\ud558\uac8c \ud568\uc73c\ub85c\uc368 \ubb38\ud654\uc801 \ub2e4\uc591\uc131\uc744 \ud655\uc7a5\uc2dc\ud0b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc138\uacc4\ud654\ub294 \uc804\uccb4\uc801\uc778 \uacbd\uc81c \uaddc\ubaa8\ub97c \ud0a4\uc6b0\uc9c0\ub9cc, \ubd80\uac00 \ud615\uc131\ub418\uace0 \ubd84\ud3ec\ub418\ub294 \ubc29\uc2dd\uc5d0\uc11c\ub294 \ud2b9\uc815 \uc8fc\uccb4\uc5d0 \ud3b8\uc911\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
    },
    {
      "question": "\uc138\uacc4\ud654\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \ube48\ubd80 \uaca9\ucc28 \uc2ec\ud654 \ud604\uc0c1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc99d\ub300\ub41c \uc138\uacc4 \uc804\uccb4\uc758 \ubd80\uac00 \uc120\uc9c4\uad6d\uc5d0 \uc8fc\ub85c \uc9d1\uc911\ub418\ub294 \uacbd\ud5a5\uc774 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\ubcf8\uacfc \uae30\uc220\ub825\uc774 \uc6b0\uc218\ud55c \uc120\uc9c4\uad6d\uc774 \uc138\uacc4\ud654\uc758 \uc131\uacfc\ub97c \ub354 \ub9ce\uc774 \uac00\uc838\uac00\uba74\uc11c \uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d \uac04 \uaca9\ucc28\uac00 \ucee4\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\ud55c \uad6d\uac00 \ub0b4\uc5d0\uc11c\ub3c4 \uc0b0\uc5c5\uacfc \uae30\uc5c5\uc758 \uacbd\uc7c1\ub825 \ucc28\uc774\uc5d0 \ub530\ub77c \ubd80\uc758 \ucc28\ub4f1 \ubd84\ubc30\uac00 \uc77c\uc5b4\ub09c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\uac00 \ub0b4\ubd80\uc5d0\uc11c\ub3c4 \uacbd\uc7c1\ub825\uc744 \uac16\ucd98 \uc0b0\uc5c5\uacfc \uadf8\ub807\uc9c0 \ubabb\ud55c \uc0b0\uc5c5 \uac04\uc5d0 \uc18c\ub4dd \uaca9\ucc28\uac00 \ud06c\uac8c \ubc8c\uc5b4\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc720 \uacbd\uc7c1\uc5d0 \ucde8\uc57d\ud55c \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \uc2a4\uc2a4\ub85c\uc758 \uc131\uc7a5 \ub3d9\ub825 \ubc1c\uad74\ub9cc\uc73c\ub85c\ub294 \ud55c\uacc4\uc5d0 \uc9c1\uba74\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacbd\uc81c\uc801 \uc790\ub9bd\ub3c4\uac00 \ubd80\uc871\ud55c \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc740 \uad6d\uc81c \uc0ac\ud68c\uc758 \uacf5\uc801 \uac1c\ubc1c \uc6d0\uc870\ub098 \uae30\uc220 \uc9c0\uc6d0 \uc5c6\uc774\ub294 \uc720\uc5f0\ud55c \ub300\ucc98\uac00 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4\ud654\uc5d0 \ub530\ub978 \ubd80\uc758 \uc99d\ub300\ub85c \ubbf8\uad6d\uacfc \uc11c\uc720\ub7fd \ub0b4 \uc0c1\uc704 1%\uc640 \ud558\uc704 50%\uc758 \uc790\uc0b0 \uaca9\ucc28\ub294 \uc904\uc5b4\ub4e4\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc138\uacc4 \ubd88\ud3c9\ub4f1 \uc5f0\uad6c\uc18c \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \ubbf8\uad6d\uacfc \uc11c\uc720\ub7fd \ubaa8\ub450 \uc0c1\uc704 1%\uc640 \ud558\uc704 50% \uc0ac\uc774\uc758 \uc790\uc0b0 \uc810\uc720\uc728 \uaca9\ucc28\uac00 \uc804\ubc18\uc801\uc73c\ub85c \ud655\ub300\ub418\ub294 \uc591\uc0c1\uc744 \ubcf4\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc81c\uc2dc\ub41c \uc790\ub8cc\uc758 \ubbf8\uad6d\uacfc \uc11c\uc720\ub7fd \uc790\uc0b0 \uc810\uc720\uc728 \ubcc0\ud654 \uadf8\ub798\ud504\uc5d0\uc11c \uc0c1\uc704 \uacc4\uce35\uacfc \ud558\uc704 \uacc4\uce35\uc758 \uaca9\ucc28 \ucd94\uc774\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc138\uacc4\ud654\uc5d0 \ub530\ub978 \ubb38\ud654 \ud68d\uc77c\ud654 \ubc0f \uc18c\uba78 \ud604\uc0c1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc678\ub798\ubb38\ud654\ub97c \ubb34\ube44\ud310\uc801\uc73c\ub85c \uc218\uc6a9\ud558\uba74 \uc790\uae30 \ubb38\ud654\uc758 \uc815\uccb4\uc131\uc774 \uac15\ud654\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc678\ub798\ubb38\ud654\ub97c \uc8fc\uccb4\uc801 \uac80\ud1a0 \uc5c6\uc774 \uc218\uc6a9\ud558\uba74 \uace0\uc720 \ubb38\ud654\uc758 \uc815\uccb4\uc131\uc774 \uc57d\ud654\ub418\uc5b4 \ubb38\ud654 \uc18c\uba78\uc744 \uc720\ubc1c\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc720\ub124\uc2a4\ucf54\uc5d0 \ub530\ub974\uba74 \uc804 \uc138\uacc4 \uc5b8\uc5b4 \uc911 \uc18c\uba78 \uc704\uae30\uc5d0 \ucc98\ud55c \uc5b8\uc5b4\ub294 \uac70\uc758 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc720\ub124\uc2a4\ucf54 \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 2019\ub144 \uae30\uc900 \uc804 \uc138\uacc4 \uc5b8\uc5b4\uc758 3\ubd84\uc758 1 \uc774\uc0c1\uc774 \uc18c\uba78 \uc704\uae30\uc5d0 \ucc98\ud574 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc120\uc9c4\uad6d\uc774 \uc790\uad6d \ubb38\ud654\ub97c \uc0c1\ud488\ud654\ud558\uc5ec \uc218\ucd9c\ud558\ub294 \uacfc\uc815\uc5d0\uc11c \uc6d0\uc8fc\ubbfc \uace0\uc720 \ubb38\ud654\uac00 \uc0ac\ub77c\uc9c8 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubb38\ud654\uc801 \uc601\ud5a5\ub825\uc774 \uac15\ud55c \uc120\uc9c4\uad6d\uc758 \ubb38\ud654 \uc0c1\ud488 \uc804\ud30c\ub294 \uc57d\uc18c\uad6d\uc774\ub098 \uc6d0\uc8fc\ubbfc \ubb38\ud654\uc758 \uc18c\uba78\uacfc \ubb38\ud654 \ub2e4\uc591\uc131 \uac10\uc18c\ub97c \ucd08\ub798\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4\ud654\ub85c \ud65c\ubc1c\ud574\uc9c4 \ubb38\ud654 \uad50\ub958 \ub355\ubd84\uc5d0 \uac01 \uc9c0\uc5ed \uc0ac\ub78c\ub4e4\uc758 \uc0b6\uc758 \ubaa8\uc2b5\uc740 \uc810\ucc28 \ub3c5\ucc3d\uc801\uc73c\ub85c \ubcc0\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb38\ud654 \uad50\ub958\uc758 \ud655\ub300\ub294 \uc804 \uc138\uacc4 \uc0ac\ub78c\ub4e4\uc758 \uc758\uc2dd\uc8fc \ubc0f \uc0dd\ud65c\uc591\uc2dd\uc744 \uc810\ucc28 \uc720\uc0ac\ud558\uac8c \ub9cc\ub4dc\ub294 \ubb38\ud654 \ud68d\uc77c\ud654\ub97c \uc77c\uc73c\ud0b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubb38\ud654\uc801 \uc601\ud5a5\ub825\uc774 \ud070 \uad6d\uac00\uc758 \ubb38\ud654 \uc0c1\ud488\uc774 \uc57d\uc18c\uad6d\uc5d0 \uc77c\ubc29\uc801\uc73c\ub85c \uc804\ud30c\ub420 \ub54c \ub098\ud0c0\ub098\ub294 \ubd80\uc791\uc6a9\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcf4\ud3b8 \uc724\ub9ac\uc640 \ud2b9\uc218 \uc724\ub9ac\uc758 \uac1c\ub150 \ubc0f \uc774\ub4e4 \uac04\uc758 \uac08\ub4f1\uc5d0 \uad00\ud55c \uc11c\uc220 \uc911 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubcf4\ud3b8 \uc724\ub9ac\ub294 \uc778\uad8c \uc874\uc911, \uc790\uc720, \ud3c9\ub4f1\uacfc \uac19\uc740 \uc778\ub958\uc758 \ubcf4\ud3b8\uc801 \uac00\uce58\ub97c \uc911\uc2dc\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf4\ud3b8 \uc724\ub9ac\ub294 \uc138\uacc4\uc2dc\ubbfc\uc73c\ub85c\uc11c \ub204\uad6c\ub098 \uc9c0\ucf1c\uc57c \ud560 \uc778\ub958 \uacf5\ud1b5\uc758 \uc874\uc5c4\uc131\uacfc \uae30\ubcf8\uc801 \uac00\uce58\ub97c \uc0c1\uc704\uc5d0 \ub461\ub2c8\ub2e4."
        },
        {
          "text": "\ud2b9\uc218 \uc724\ub9ac\ub294 \ud2b9\uc815 \uc0ac\ud68c\uc5d0\uc11c\ub9cc \uacf5\uc720\ud558\ub294 \uaddc\ubc94\uacfc \uac00\uce58\ub97c \uc6b0\uc120\uc2dc\ud558\ub294 \uc785\uc7a5\uc744 \ucde8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud2b9\uc218 \uc724\ub9ac\ub294 \ud2b9\uc815 \uacf5\ub3d9\uccb4\uc758 \uc5ed\uc0ac\uc801\u00b7\ubb38\ud654\uc801 \ub9e5\ub77d \uc18d\uc5d0\uc11c \ud615\uc131\ub41c \uace0\uc720\ud55c \uaddc\ubc94\uc5d0 \uac00\uce58\ub97c \ubd80\uc5ec\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub2e4\ubb38\ud654 \uc0ac\ud68c\uac00 \uac00\uc18d\ud654\ub428\uc5d0 \ub530\ub77c \uc8fc\ub958 \uc0ac\ud68c \ubb38\ud654\uc640 \uc774\uc8fc\ubbfc \ubb38\ud654 \uac04\uc758 \ucda9\ub3cc\uc774 \ub098\ud0c0\ub0a0 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf4\ud3b8 \uc724\ub9ac\uc640 \ud2b9\uc218 \uc724\ub9ac\uc758 \uc724\ub9ac\uc801 \uac08\ub4f1\uc740 \ub2e4\ubb38\ud654 \uc0ac\ud68c\uc5d0\uc11c \uc8fc\ub958 \ubb38\ud654\uc640 \uc774\uc8fc\ubbfc \ubb38\ud654 \uac04\uc758 \uac00\uce58\uad00 \ub300\ub9bd\uc73c\ub85c \uad6c\uccb4\ud654\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uac08\ub4f1 \ud574\uacb0\uc744 \uc704\ud574 \ud2b9\uc815 \uc0ac\ud68c\uc758 \ud2b9\uc218 \uc724\ub9ac\ub9cc\uc744 \uc808\ub300\uc801 \uae30\uc900\uc73c\ub85c \uc0bc\uc544 \ubcf4\ud3b8 \uc724\ub9ac\ub97c \ubc30\uc81c\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud2b9\uc218 \uc724\ub9ac\ub9cc\uc744 \uc808\ub300\ud654\ud558\uba74 \uc778\uad8c \uce68\ud574\uc640 \uac19\uc740 \uc724\ub9ac\uc801 \ubb38\uc81c\uac00 \uc815\ub2f9\ud654\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c, \uc778\ub958 \ubcf4\ud3b8\uc801 \uac00\uce58\ub97c \uae30\uc900\uc73c\ub85c \ud2b9\uc218 \uc724\ub9ac\ub97c \uc131\ucc30\ud574\uc57c \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud2b9\uc815 \uc9d1\ub2e8\ub9cc\uc758 \uc724\ub9ac\uad00\uc744 \uc808\ub300\uc801 \uae30\uc900\uc73c\ub85c \uc0bc\uc744 \ub54c \uc778\uad8c\uc774\ub098 \uc790\uc720 \uac19\uc740 \uac00\uce58\uac00 \uc704\ud611\ubc1b\uc744 \uc218 \uc788\uc74c\uc744 \uace0\ub824\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc138\uacc4\ud654 \ubb38\uc81c\uc810\uc758 \ud574\uacb0 \ubc29\uc548\uc73c\ub85c \uc81c\uc2dc\ub41c \ub0b4\uc6a9 \uc911 \uc62c\ubc14\ub978 \uc124\uba85\ub9cc\uc744 \uc788\ub294 \ub300\ub85c \uace0\ub978 \uac83\uc740?\n\n\u3131. \uc678\ub798\ubb38\ud654\ub294 \uc790\uae30 \ubb38\ud654\uc758 \uc815\uccb4\uc131\uc744 \uc720\uc9c0\ud558\uba74\uc11c \ube44\ud310\uc801\uc73c\ub85c \uc218\uc6a9\ud55c\ub2e4.\n\u3134. \ud2b9\uc218 \uc724\ub9ac\uc5d0 \ub300\ud55c \uace0\ub824 \uc5c6\uc774 \ubcf4\ud3b8 \uc724\ub9ac\ub9cc\uc744 \uc77c\ubc29\uc801\uc73c\ub85c \uac15\uc694\ud574\uc57c \ud55c\ub2e4.\n\u3137. \uc9c0\uad6c\ucd0c \ubb38\uc81c\uc5d0 \ucc45\uc784 \uc758\uc2dd\uc744 \uac00\uc9c0\uace0 \ud589\ub3d9\ud558\ub294 \uc138\uacc4\uc2dc\ubbfc \uc758\uc2dd\uc744 \ubc1c\ud718\ud55c\ub2e4.\n\u3139. \uad6d\uc81c\uae30\uad6c\uc640 \uc120\uc9c4\uad6d\uc740 \uacf5\uc801 \uac1c\ubc1c \uc6d0\uc870(ODA)\ub098 \uae30\uc220 \uc774\uc804\uc744 \uac15\ud654\ud55c\ub2e4.",
      "answerOptions": [
        {
          "text": "\u3131, \u3134, \u3137",
          "isCorrect": false,
          "rationale": "\u3134\uc740 \ud2b9\uc218 \uc724\ub9ac\uc5d0 \ub300\ud55c \ub9e5\ub77d\uc801 \uace0\ub824\ub97c \ubc30\uc81c\ud558\ubbc0\ub85c \uc62c\ubc14\ub978 \uc724\ub9ac \uac08\ub4f1 \ud574\uc18c \ubc29\uc548\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\u3131, \u3137, \u3139",
          "isCorrect": true,
          "rationale": "\ubb38\ud654\uc758 \ube44\ud310\uc801 \uc218\uc6a9, \uc138\uacc4\uc2dc\ubbfc \uc758\uc2dd \ubc1c\ud718, \uc120\uc9c4\uad6d\uc758 ODA \uc9c0\uc6d0 \uac15\ud654\ub294 \uc138\uacc4\ud654 \ubd80\uc791\uc6a9\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud55c \uc62c\ubc14\ub978 \ub300\uc548\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\u3134, \u3137, \u3139",
          "isCorrect": false,
          "rationale": "\ubcf4\ud3b8 \uc724\ub9ac\uc640 \ud2b9\uc218 \uc724\ub9ac\uc758 \ucda9\ub3cc\uc744 \ud53c\ud558\uae30 \uc704\ud574\uc11c\ub294 \ubcf4\ud3b8 \uc724\ub9ac\uc5d0 \ub300\ud55c \uc874\uc911\uacfc \ud568\uaed8 \ud2b9\uc218 \uc724\ub9ac\uc5d0 \ub300\ud55c \ub9e5\ub77d\uc801 \uc774\ud574\uac00 \uc218\ubc18\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\u3131, \u3134, \u3139",
          "isCorrect": false,
          "rationale": "\ubcf4\ud3b8 \uc724\ub9ac\ub9cc\uc744 \uc77c\ubc29\uc801\uc73c\ub85c \uac15\uc694\ud558\uba74 \ud2b9\uc815 \ubb38\ud654\uad8c\uacfc\uc758 \ubb38\ud654\uc801 \ucda9\ub3cc \ubc0f \uac08\ub4f1\uc774 \uc2ec\ud654\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc724\ub9ac\uc801 \uac08\ub4f1 \ud574\uc18c\ub97c \uc704\ud574\uc11c\ub294 \ubcf4\ud3b8\uc801 \uac00\uce58\uc5d0 \ub300\ud55c \uc874\uc911\ubfd0\ub9cc \uc544\ub2c8\ub77c \uac01 \uc0ac\ud68c\uc758 \ub9e5\ub77d\uc744 \uace0\ub824\ud558\ub294 \uc774\ud574\uac00 \ub3d9\uc2dc\uc5d0 \ud544\uc694\ud569\ub2c8\ub2e4."
    },
    {
