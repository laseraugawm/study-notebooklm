    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc801\uadf9\uc801 \ud3c9\ub4f1 \uc2e4\ud604 \uc870\uce58\uc758 \ub300\ud45c\uc801 \uc0ac\ub840 \uc911 \uad00\uacf5\uc11c\ub098 \uc77c\uc815 \uaddc\ubaa8 \uc774\uc0c1\uc758 \uae30\uc5c5\uc5d0 \uc801\uc6a9\ub418\ub294 \uc81c\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
