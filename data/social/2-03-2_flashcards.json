    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80\uc640 \uc9c0\uc790\uccb4\uac00 \ub3c4\uc2dc \ub0b4\ubd80\uc758 \uacf5\uac04 \ubd88\ud3c9\ub4f1\uc744 \ud574\uc18c\ud558\uae30 \uc704\ud574 \uc2dc\ud589\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc0ac\uc5c5 \ubc29\uc548 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
