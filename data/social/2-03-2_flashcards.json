      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\uc6b8\ud2b9\ubcc4\uc2dc \uc9c0\uc790\uccb4\uc5d0\uc11c \ucabd\ubc29\ucd0c \ud3ed\uc5fc \ucde8\uc57d \uacc4\uce35\uc744 \uc704\ud574 \ubbf8\uc138\ud55c \uc778\uacf5 \uc548\uac1c\ub97c \ubd84\uc0ac\ud558\uc5ec \uc8fc\ubcc0 \uc628\ub3c4\ub97c \ub0ae\ucd94\ub294 \ub0c9\ubc29 \uc7a5\uce58\ub294 \ubb34\uc5c7\uc778\uac00?"
