    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0 \ub300\ud55c \ucc28\ubcc4\uc744 \ucd08\ub798\ud558\ub294 \uc8fc\ub41c \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
