    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ubbfc \uae30\ucd08 \uc0dd\ud65c \ubcf4\uc7a5 \uc81c\ub3c4\uc5d0\uc11c \uc0dd\uacc4\uac00 \uc5b4\ub824\uc6b4 \uad6d\ubbfc\uc5d0\uac8c \uc81c\uacf5\ud558\ub294 \uae09\uc5ec\uc758 \uc885\ub958 4\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uacc4 \uae09\uc5ec, \uc8fc\uac70 \uae09\uc5ec, \uc758\ub8cc \uae09\uc5ec, \uad50\uc721 \uae09\uc5ec"
          }
        ]
