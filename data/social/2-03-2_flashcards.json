      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ud6c4\u00b7\ubd88\ub7c9 \uc8fc\ud0dd \uac1c\ub7c9, \ub3c4\uc2dc \uae30\ubc18 \uc2dc\uc124 \ud655\ucda9"
