      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubca0\ub124\uc218\uc5d8\ub77c\uc5d0\uc11c \ube48\ubbfc\uce35 \uccad\uc18c\ub144\uc5d0\uac8c \ubb34\uc0c1 \uc74c\uc545 \uad50\uc721\uc744 \uc81c\uacf5\ud558\uc5ec \ub9c8\uc57d\uacfc \ubc94\uc8c4\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uace0 \ubbf8\ub798\uc758 \uafc8\uc744 \uc81c\uc2dc\ud55c \ud504\ub85c\uadf8\ub7a8\uc740 \ubb34\uc5c7\uc778\uac00?"
