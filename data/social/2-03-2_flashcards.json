        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ubbfc \uae30\ucd08 \uc0dd\ud65c \ubcf4\uc7a5 \uc81c\ub3c4, \uae30\ucd08 \uc5f0\uae08"
          }
        ]
