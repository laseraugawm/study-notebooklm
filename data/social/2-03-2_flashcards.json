      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc778\uc744 \uc704\ud55c \uc2dc\uac04 \ub3cc\ubd04 \uc2dc\uc2a4\ud15c"
