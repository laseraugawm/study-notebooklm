    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \uc774\ubbf8\uc9c0\ub294 \uc9c0\uc5ed\uc758 \ud2b9\uc131\uc744 \uc0c1\ud488\ud654\ud558\uc5ec \uacbd\uc81c\ub97c \ud65c\uc131\ud654\ud558\ub294 \uc804\ub7b5\uc758 \ub300\ud45c\uc801 \uc0ac\ub840\uc774\ub2e4. \uc774 \uc804\ub7b5\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
