    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c4\uc6c0\uacfc \ubcf4\ud638\uac00 \ud544\uc694\ud55c \uad6d\ubbfc\uc5d0\uac8c \uc0c1\ub2f4, \uc7ac\ud65c, \ub3cc\ubd04, \ubcf5\uc9c0 \uc2dc\uc124 \uc774\uc6a9 \ub4f1\uc758 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\ub294 \uc81c\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uc11c\ube44\uc2a4"
          }
        ]
