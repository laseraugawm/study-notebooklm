    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\ub97c \ub9cc\ub4e4\uae30 \uc704\ud574 \uc2dc\ubbfc \uac1c\uc778\uc774 \uc2e4\ucc9c\ud560 \uc218 \uc788\ub294 \ucc28\uc6d0\uc758 \ub178\ub825 3\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\ud3c9\ub4f1 \ubb38\uc81c\uc5d0 \ub300\ud55c \ubb38\uc81c\uc758\uc2dd \uac00\uc9c0\uae30, \uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0 \ub300\ud55c \uace0\uc815\uad00\ub150\u00b7\ud3b8\uacac \uc131\ucc30 \ubc0f \uacf5\uac10, \uae30\ubd80\u00b7\ubd09\uc0ac \ud65c\ub3d9 \ucc38\uc5ec \ub610\ub294 \uc2dc\ubbfc \ub2e8\uccb4 \ud65c\ub3d9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uac04 \ubd88\ud3c9\ub4f1 \ud604\uc0c1\uc744 \ucd08\ub798\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc8fc\ub41c \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\uc7a5 \uac70\uc810 \uac1c\ubc1c \uc815\ucc45"
          }
        ]
