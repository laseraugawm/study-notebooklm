    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c\uc758 \uc8fc\uc694 \uc0ac\ud68c \ubcf4\ud5d8 5\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
