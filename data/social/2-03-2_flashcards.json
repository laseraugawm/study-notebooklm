    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uacc4\uce35\uc758 \uc591\uadf9\ud654\ub97c \ucd08\ub798\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc8fc\ub41c \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
