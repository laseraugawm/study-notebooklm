      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7a5\uc18c \ub9c8\ucf00\ud305 (\uc0ac\ub840: \ubcf4\uc131 \ub179\ucc28 \ubc2d)"
