    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2024\ub144 \uae30\uc900 \uc6b0\ub9ac\ub098\ub77c \uc7a5\uc560\uc778 \uc758\ubb34 \uace0\uc6a9 \ube44\uc728\uc740 \uad6d\uac00\u00b7\uc9c0\ubc29 \uc790\uce58 \ub2e8\uccb4\u00b7\uacf5\uacf5 \uae30\uad00\uacfc \ubbfc\uac04 \uae30\uc5c5\uc5d0 \uac01\uac01 \uba87 %\ub85c \uaddc\uc815\ub418\uc5b4 \uc788\ub294\uac00?"
