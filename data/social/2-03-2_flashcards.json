      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ub78c\ub4e4\uc758 \ud3b8\uacac\uacfc \uc120\uc785\uacac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc790\uc6d0\uc744 \uacf5\uc815\ud558\uac8c \ubd84\ubc30\ud558\ub294 \uc6d0\uce59\uacfc \uad00\ub828\ud558\uc5ec, \uac01\uc790\uac00 \uc790\uc2e0\uc774 \ubc1b\uc544\uc57c \ud560 \ubaab\uc744 \uacf5\uc815\ud558\uac8c \ubc1b\ub3c4\ub85d \ud558\ub294 \uac83\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
