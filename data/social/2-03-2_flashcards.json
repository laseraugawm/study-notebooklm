      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uae08\uc804\uc801 \uc9c0\uc6d0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c \uc0ac\ud68c \uc11c\ube44\uc2a4 \uc81c\ub3c4\uc758 \ub300\ud45c\uc801\uc778 \uc0ac\ub840 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc778 \ub9de\ucda4 \ub3cc\ubd04 \uc11c\ube44\uc2a4, \uac00\uc0ac\u00b7\uac04\ubcd1 \uc11c\ube44\uc2a4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uae30 \ubd88\ud669\uc73c\ub85c \ud574\uace0\ub2f9\ud55c \uadfc\ub85c\uc790\uac00 \uc2e4\uc5c5 \uae09\uc5ec\ub97c \uc9c0\uae09\ubc1b\uace0 \uc9c1\uc5c5 \ub2a5\ub825 \uac1c\ubc1c \uc0ac\uc5c5\uc758 \ub3c4\uc6c0\uc744 \ubc1b\ub294 \uc81c\ub3c4\ub294 \uc0ac\ud68c \ubcf4\ud5d8 \uc911 \ubb34\uc5c7\uc778\uac00?"
