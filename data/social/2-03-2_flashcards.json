      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\uc131 \ub179\ucc28 \ubc2d, \ud568\ud3c9 \ub098\ube44 \ucd95\uc81c, \uac10\ucc9c \ubb38\ud654 \ub9c8\uc744 \uc870\uc131"
