    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e4\uc9c8\uc801\uc778 \ud3c9\ub4f1\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc0ac\ud68c\uc801\uc73c\ub85c \ubd88\ub9ac\ud55c \uc704\uce58\uc5d0 \uc788\ub294 \uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0\uac8c \uc77c\uc815\ud55c \ud61c\ud0dd\uc744 \uc81c\uacf5\ud558\ub294 \uc870\uce58\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
