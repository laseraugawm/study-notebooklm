{
  "title": "\uc0ac\ud68c \ubcf5\uc9c0 \uc554\uae30\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uad6c\uc131\uc6d0\uc774 \uae30\ubcf8\uc801\uc778 \uc695\uad6c\ub97c \ucda9\uc871\ud558\uace0 \uc815\uc0c1\uc801\uc778 \uc0dd\ud65c\uc744 \ud560 \uc218 \uc788\ub3c4\ub85d \uc9c0\uc6d0\ud558\ub294 \uc81c\ub3c4\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ubcf5\uc9c0 \uc81c\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ubcf5\uc9c0 \uc81c\ub3c4\ub97c \uc6b4\uc6a9\ud558\ub294 \uc8fc\ub41c \ubaa9\uc801 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uacc4\uce35\uc758 \uc591\uadf9\ud654 \ud574\uc18c, \uc0ac\ud68c\uc801 \uc57d\uc790\ub97c \ube44\ub86f\ud55c \ubaa8\ub4e0 \uad6c\uc131\uc6d0\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c \ubcf4\uc7a5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c \uc0ac\ud68c \ubcf5\uc9c0 \uc81c\ub3c4\uc758 3\uac00\uc9c0 \uc8fc\uc694 \uc720\ud615\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ubcf4\ud5d8, \uacf5\uacf5 \ubd80\uc870, \uc0ac\ud68c \uc11c\ube44\uc2a4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ubbfc\uc5d0\uac8c \ubc1c\uc0dd\ud558\ub294 \uc9c8\ubcd1, \uc7a5\uc560, \ub178\ub839, \uc2e4\uc5c5, \uc0ac\ub9dd \ub4f1\uc758 \uc0ac\ud68c\uc801 \uc704\ud5d8\uc744 \ubcf4\ud5d8\uc758 \ubc29\uc2dd\uc73c\ub85c \ub300\ucc98\ud558\ub294 \uc81c\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ubcf4\ud5d8"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ubcf4\ud5d8 \uc9c0\uc6d0 \ubc29\uc2dd\uc758 \uae30\ubcf8 \uc6d0\uce59\uc740 \uae08\uc804\uc801 \uc9c0\uc6d0\uc778\uac00, \ube44\uae08\uc804\uc801 \uc9c0\uc6d0\uc778\uac00?"
