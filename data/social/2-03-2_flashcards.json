    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c\uc5d0\uc11c \ud65c\uc6a9\ub41c \uc7a5\uc18c \ub9c8\ucf00\ud305\uc758 \ub300\ud45c\uc801\uc778 \uc0ac\ub840 3\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
