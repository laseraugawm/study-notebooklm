    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud63c\uc790\uc11c \uc77c\uc0c1\uc0dd\ud65c\uc744 \ud558\uae30 \uc5b4\ub824\uc6b4 \uace0\ub839\uc758 \ub178\uc778\uc5d0\uac8c \uac00\uc0ac\u00b7\ud65c\ub3d9 \uc9c0\uc6d0\uc774\ub098 \uc8fc\uac04 \ubcf4\ud638 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\ub294 \uc0ac\ud68c \uc11c\ube44\uc2a4\ub294 \ubb34\uc5c7\uc778\uac00?"
