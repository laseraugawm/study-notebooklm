      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uacf5 \ubd80\uc870"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c\uc758 \ub300\ud45c\uc801\uc778 \uacf5\uacf5 \ubd80\uc870 \uc81c\ub3c4 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
