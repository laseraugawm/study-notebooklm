      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc778 \ub9de\ucda4 \ub3cc\ubd04 \uc11c\ube44\uc2a4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\ub3c4\uad8c\uacfc \ube44\uc218\ub3c4\uad8c, \ub3c4\uc2dc\uc640 \ub18d\ucd0c \uac04\uc758 \ubd88\ud3c9\ub4f1\uc744 \ud574\uc18c\ud558\uace0 \uad6d\ud1a0\uc758 \uade0\ud615 \ubc1c\uc804\uc744 \uc774\ub8e8\uae30 \uc704\ud574 \ud544\uc694\ud55c \uc815\ucc45\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed \uaca9\ucc28 \uc644\ud654 \uc815\ucc45"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ud1a0\uc758 \uade0\ud615 \ubc1c\uc804\uc744 \ucd94\uc9c4\ud558\uae30 \uc704\ud574 \uc6b0\ub9ac \uc815\ubd80\uac00 \uc2dc\ud589\ud558\ub294 \ub300\ud45c\uc801\uc778 \uacf5\uacf5\uae30\uad00 \uc774\uc804 \uc0ac\uc5c5\uc758 \uc815\ucc45 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uacf5 \uae30\uad00\uc758 \uae30\ub2a5\uc801 \ud2b9\uc131\uacfc \uc9c0\uc5ed \uc804\ub7b5 \uc0b0\uc5c5\uc744 \uc5f0\uacc4\ud558\uc5ec \uc9c0\uc5ed \ubc1c\uc804\uc758 \ud1a0\ub300\ub97c \uad6c\ucd95\ud558\uace0 \uacf5\uac04 \ubd88\ud3c9\ub4f1\uc744 \uc644\ud654\ud558\uae30 \uc704\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed \uacf5\uac04\uacfc \uac19\uc740 \ud2b9\uc815 \uc7a5\uc18c\ub97c \uc0c1\ud488\ud654\ud558\uc5ec \uc9c0\uc5ed\uc758 \uc774\ubbf8\uc9c0\ub97c \ub192\uc774\uace0 \uc9c0\uc5ed \uacbd\uc81c\ub97c \ud65c\uc131\ud654\ud558\ub294 \uc804\ub7b5\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
