    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc1e0\ud1f4\ud558\ub358 \ud0c4\uad11\ucd0c \ub9c8\uc744\uc744 \uace0\uc591\uc774 \ucf58\uc149\ud2b8\ub85c \uafb8\uba70 \uc5f0\uac04 50\ub9cc \uba85\uc758 \uad00\uad11\uac1d\uc774 \ucc3e\ub294 \uad00\uad11\uc9c0\ub85c \uc7ac\uc0dd\uc2dc\ud0a8 \ud0c0\uc774\uc644\uc758 \ub300\ud45c\uc801 \uc0ac\ub840\ub294 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc774\uc644 \ud5c8\uc6b0\ud1b5 \uace0\uc591\uc774 \ub9c8\uc744"
