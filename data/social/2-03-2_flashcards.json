        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2a5\ub825\uc774 \ub6f0\uc5b4\ub098\uac70\ub098 \uc804\ubb38\uc801\uc778 \uc790\uc9c8\uc744 \uac16\ucd98 \uc0ac\ub78c\uc5d0\uac8c \ub354 \ub9ce\uc740 \uc0ac\ud68c\uc801 \uc790\uc6d0\uc744 \ubc30\ubd84\ud558\ub294 \uc815\uc758\uc758 \uc2e4\uc9c8\uc801 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2a5\ub825\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uc758 \ubaa9\ud45c\ub97c \uc774\ub8e8\ub294 \ub370 \ub354 \ub9ce\uc774 \uae30\uc5ec\ud55c \uc0ac\ub78c\uc5d0\uac8c \ub354 \ub9ce\uc740 \uc0ac\ud68c\uc801 \uc790\uc6d0\uc744 \ubc30\ubd84\ud558\ub294 \uc815\uc758\uc758 \uc2e4\uc9c8\uc801 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5c5\uc801(\uae30\uc5ec)\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ubcf8\uc801\uc778 \uc695\uad6c \ucda9\uc871\uc774 \uc5b4\ub824\uc6b4 \uc0ac\ub78c\ub4e4\uc5d0\uac8c \uc6b0\uc120\uc801\uc73c\ub85c \uc0ac\ud68c\uc801 \uc790\uc6d0\uc744 \ubc30\ubd84\ud558\ub294 \uc815\uc758\uc758 \uc2e4\uc9c8\uc801 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud544\uc694\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacb0\uacfc\uc758 \ud3c9\ub4f1\uc744 \ucd94\uad6c\ud558\uc5ec \ucd5c\uc18c\ud55c\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c\uc744 \ubcf4\uc7a5\ud558\ub294 \ub370 \uc8fc\ub85c \uc4f0\uc774\ub294 \ubd84\ubc30 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud544\uc694\uc5d0 \ub530\ub978 \ubd84\ubc30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc758 \uc790\uc720\uc640 \uad8c\ub9ac, \uc18c\uc720\uad8c\uc744 \uac15\uc870\ud558\uba70 \uad6d\uac00\uac00 \uac1c\uc778\uc758 \uc0b6\uc5d0 \uac1c\uc785\ud558\uc9c0 \uc54a\uace0 \uc911\ub9bd\uc131\uc744 \uc720\uc9c0\ud574\uc57c \ud55c\ub2e4\uace0 \ubcf4\ub294 \uc815\uc758\uad00\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc774 \uc9c0\ub098\uce60 \uacbd\uc6b0 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \ubb38\uc81c\uc810\uc774\ub098 \ud55c\uacc4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadf9\ub2e8\uc801 \uc774\uae30\uc8fc\uc758 \ucd08\ub798 \uac00\ub2a5\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc758 \ubb38\ud654, \uc5ed\uc0ac, \uc804\ud1b5\uc744 \uc911\uc2dc\ud558\uace0 \uacf5\ub3d9\uccb4\uc5d0 \ub300\ud55c \uac1c\uc778\uc758 \ucc45\uc784\uacfc \uc758\ubb34\ub97c \uac15\uc870\ud558\ub294 \uc815\uc758\uad00\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc774 \uc9c0\ub098\uce60 \uacbd\uc6b0 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \ud55c\uacc4\ub098 \ubd80\uc791\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uace0\uc8fc\uc758 \ub610\ub294 \uc9d1\ub2e8\uc8fc\uc758 \ucd08\ub798 \uac00\ub2a5\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uac1c\uc778\uc774 \uacf5\ub3d9\uccb4\uc758 \uc804\ud1b5\uc73c\ub85c\ubd80\ud130 \ub3c5\ub9bd\uc801\uc778 \uc874\uc7ac\uc778\uac00?'\ub77c\ub294 \uc9c8\ubb38\uc5d0 \ub300\ud574 \uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uacfc \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uac01\uac01 \uc5b4\ub5bb\uac8c \ub2f5\ubcc0\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00: \uc608 / \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00: \uc544\ub2c8\uc694"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uacc4\uce35 \uac00\uc6b4\ub370 \uc911\uce35\uc758 \ube44\uc728\uc774 \uac10\uc18c\ud558\uba74\uc11c \uad6c\uc131\uc6d0\ub4e4\uc774 \uc0c1\uce35\uacfc \ud558\uce35\uc758 \uc591\uadf9\ub2e8\uc73c\ub85c \uc3e0\ub9ac\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uacc4\uce35\uc758 \uc591\uadf9\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\ub3c4\uad8c\uacfc \ube44\uc218\ub3c4\uad8c, \ub3c4\uc2dc\uc640 \ub18d\ucd0c \ub4f1 \uc9c0\uc5ed\uc744 \uae30\uc900\uc73c\ub85c \uc0ac\ud68c\uc801 \ud76c\uc18c\uac00\uce58\uac00 \ubd88\uade0\ub4f1\ud558\uac8c \ubd84\ubc30\ub418\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uac04 \ubd88\ud3c9\ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uacc4\uce35\uc758 \uc591\uadf9\ud654\uc640 \uacf5\uac04 \ubd88\ud3c9\ub4f1\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc6b0\ub9ac\ub098\ub77c\uc5d0\uc11c \uc2dc\ud589 \uc911\uc778 \ub300\ud45c\uc801\uc778 \uc81c\ub3c4\uc801 \ubc29\uc548 3\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ubcf5\uc9c0 \uc81c\ub3c4, \uc9c0\uc5ed \uaca9\ucc28 \uc644\ud654 \uc815\ucc45, \uc801\uadf9\uc801 \ud3c9\ub4f1 \uc2e4\ud604 \uc870\uce58"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc7a5\uc560\uc778\uc774 \ub300\uc911\uad50\ud1b5(\uc2dc\uc678\ubc84\uc2a4 \ub4f1)\uc744 \uc27d\uac8c \uc774\uc6a9\ud558\ub294 \uac83\ucc98\ub7fc \ud0c0\uc778\uc740 \uac16\uc9c0 \ubabb\ud558\uc9c0\ub9cc \uc790\uc2e0\uc774 \uac00\uc9c4 \uae30\ud68c\ub97c \uc758\uc2dd\ud558\uc9c0 \ubabb\ud558\uace0 \ub204\ub9ac\ub294 \uac83\uc744 \ubb34\uc5c7\uc774\ub77c \ud45c\ud604\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ud6c4\u00b7\ubd88\ub7c9 \uc8fc\ud0dd \uac1c\ub7c9 \ubc0f \ub3c4\uc2dc \uae30\ubc18 \uc2dc\uc124 \ud655\ucda9 \uc0ac\uc5c5\uc740 \uc0ac\ud68c \ubd88\ud3c9\ub4f1 \ubb38\uc81c \uc911 \uc5b4\ub290 \ucc28\uc6d0\uc758 \ubd88\ud3c9\ub4f1\uc744 \ud574\uc18c\ud558\uae30 \uc704\ud55c \ub178\ub825\uc778\uac00?"
          }
