    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\uc704\uc2a4 \uc0dd\uac08\ub80c\uc2dc\uc758 \uc2dc\uac04 \ub3cc\ubd04 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \uc11c\ube44\uc2a4 \uc81c\uacf5 \ud6c4 \uc801\ub9bd\ud558\ub294 \uc218\ub2e8\uacfc \uc801\ub9bd\ud558\ub294 \uacc4\uc88c\uc758 \uba85\uce6d\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
