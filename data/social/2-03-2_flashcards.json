    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\uc704\uc2a4 \uc0dd\uac08\ub80c\uc2dc\uc5d0\uc11c \uc8fc\ubbfc\uc774 \ub178\uc778 \ub3cc\ubd04 \ubd09\uc0ac\ub97c \ud558\uace0 \uc801\ub9bd\ud55c \uc2dc\uac04 \uad6c\ub9e4\uad8c\uc744 \ub178\ud6c4\uc5d0 \uc0ac\uc6a9\ud558\ub294 \ub178\uc778 \ubcf5\uc9c0 \uc81c\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
