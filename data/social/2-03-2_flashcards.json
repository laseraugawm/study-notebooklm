        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\uacf5\uc815\ud55c \ud589\uc704\ub098 \uc798\ubabb\ub41c \ud589\ub3d9\uc744 \ubc14\ub85c\uc7a1\ub294 \uc815\uc758\uc758 \uc885\ub958\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\uc815\uc801 \uc815\uc758"
