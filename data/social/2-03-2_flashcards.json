    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uc11c\ube44\uc2a4 \uc81c\ub3c4\uc758 \uc9c0\uc6d0 \ubc29\uc2dd\uc740 \uc6d0\uce59\uc801\uc73c\ub85c \uae08\uc804\uc801 \uc9c0\uc6d0\uc778\uac00, \ube44\uae08\uc804\uc801 \uc9c0\uc6d0\uc778\uac00?"
