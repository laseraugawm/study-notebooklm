    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ubcf8\uc8fc\uc758 \uacbd\uc81c \uccb4\uc81c\uc5d0\uc11c \uc790\uc720\ub85c\uc6b4 \uacbd\uc81c \ud65c\ub3d9\uc744 \uc704\ud574 \uac1c\uc778\uc5d0\uac8c \ubcf4\uc7a5\ub418\ub294 \ub300\ud45c\uc801\uc778 \ub450 \uac00\uc9c0 \uc790\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
