    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ubcf8\uc8fc\uc758\uc5d0\uc11c \uac1c\uc778\uc774 \ud1a0\uc9c0, \uacf5\uc7a5, \uae30\uacc4 \ub4f1 \uc0dd\uc0b0 \uc218\ub2e8\uc744 \ud3ec\ud568\ud55c \uc7ac\uc0b0\uc744 \uc18c\uc720\u00b7\uad00\ub9ac\u00b7\ucc98\ubd84\ud560 \uc218 \uc788\ub3c4\ub85d \ubcf4\uc7a5\ud558\ub294 \uc81c\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
