    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ubcf8\uc8fc\uc758 \uccb4\uc81c\uc5d0\uc11c \uac01 \uacbd\uc81c \uc8fc\uccb4\uac00 \uc0ac\uc801 \uc774\uc775\uc744 \ucd94\uad6c\ud558\ub294 \uac83\uc744 \uc778\uc815\ud558\ub294 \uadfc\uac70\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
