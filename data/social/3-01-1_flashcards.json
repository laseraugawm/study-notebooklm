      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube75\uc744 \uc0ac\ub824\ub294 \uc218\uc694\ub294 \ub298\uc9c0\ub9cc \ud314\ub824\ub294 \uacf5\uae09\uc790\uac00 \uc904\uc5b4\ub4e4\uc5b4 \ud488\uadc0 \ud604\uc0c1\uc774 \ubc1c\uc0dd\ud558\uba70, \uc904\uc744 \uc11c\ub3c4 \ube75\uc744 \uc0ac\uae30 \uc5b4\ub824\uc6cc\uc9c4\ub2e4."
