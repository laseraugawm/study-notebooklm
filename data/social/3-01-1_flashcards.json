      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uacbd\uc81c \uc8fc\uccb4\uac00 \uc790\uc2e0\uc758 \uc774\uc775\uc744 \ucd94\uad6c\ud558\uba70 \uacbd\uc7c1\ud558\ub294 \uacfc\uc815\uc5d0\uc11c \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc0ac\ud68c \uc804\uccb4\uc758 \uc774\uc775\ub3c4 \uc99d\uac00\ud55c\ub2e4\uace0 \ubcf4\uae30 \ub54c\ubb38\uc774\ub2e4."
