    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80\uac00 \ubc95\uc73c\ub85c \ube75\uac00\uaca9\uc744 \uc778\uc704\uc801\uc73c\ub85c \ub192\uac8c \ud1b5\uc81c\ud560 \uacbd\uc6b0 \uc2dc\uc7a5\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ud604\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00?"
