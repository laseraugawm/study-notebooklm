{
  "title": "\uc0ac\ud68c\uc801\uc18c\uc218\uc790 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790(Social Minority)\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uccb4\uc801 \ub610\ub294 \ubb38\ud654\uc801 \ud2b9\uc9d5 \ub54c\ubb38\uc5d0 \uc8fc\ub958 \uc9d1\ub2e8\uc758 \uad6c\uc131\uc6d0\uc5d0\uac8c \ucc28\ubcc4\ubc1b\uc73c\uba70, \uc2a4\uc2a4\ub85c \ucc28\ubcc4\ubc1b\ub294 \uc9d1\ub2e8\uc5d0 \uc18d\ud574 \uc788\ub2e4\uace0 \uc778\uc2dd\ud558\ub294 \uc0ac\ub78c\ub4e4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub5a4 \uc9d1\ub2e8\uc774 '\uc0ac\ud68c\uc801 \uc18c\uc218\uc790'\uc5d0 \ud574\ub2f9\ud558\ub294\uc9c0 \uad6c\ubd84\ud558\ub294 \ud575\uc2ec \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9d1\ub2e8 \uad6c\uc131\uc6d0\uc758 \uc218\uac00 \uc544\ub2c8\ub77c, \ud574\ub2f9 \uc0ac\ud68c\uc5d0\uc11c\uc758 '\uc0ac\ud68c\uc801 \uc601\ud5a5\ub825'\uc774 \uc791\uace0 \uc57d\uc790\uc758 \uc704\uce58\uc5d0 \uc788\ub294\uc9c0 \uc5ec\ubd80\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9d1\ub2e8 \uad6c\uc131\uc6d0\uc758 \uc218\uac00 \uc778\uad6c\uc758 \uacfc\ubc18\uc218\ub97c \ucc28\uc9c0\ud558\ub354\ub77c\ub3c4 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uac00 \ub420 \uc218 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\ub2a5\ud558\ub2e4. \uad6c\uc131\uc6d0\uc758 \uc218\uc640 \uad00\uacc4\uc5c6\uc774 \uc0ac\ud68c\uc801 \uc601\ud5a5\ub825\uc774 \uc791\uace0 \uad8c\ub825\uc5d0\uc11c \ubc30\uc81c\ub418\uc5b4 \uc788\ub2e4\uba74 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub85c \ubcfc \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790 \uac1c\ub150\uc774 \uc9c0\ub2cc '\uc0c1\ub300\uc131'\uacfc '\uac00\ubcc0\uc131'\uc774\ub780 \ubb34\uc5c7\uc744 \uc758\ubbf8\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\ub300, \uc7a5\uc18c, \uc0ac\ud68c\uc801 \uc870\uac74\uc758 \ubcc0\ud654\uc5d0 \ub530\ub77c \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc5d0 \ud574\ub2f9\ud558\ub294 \uc9d1\ub2e8\uacfc \uad6c\uccb4\uc801 \ub300\uc0c1\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc74c\uc744 \uc758\ubbf8\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac \uc0ac\ud68c\uc5d0\uc11c \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uac00 \ubd80\ub2f9\ud55c \ucc28\ubcc4\uc744 \ubc1b\uac8c \ub418\ub294 \uc8fc\uc694 \uc6d0\uc778 \uc694\uc18c 4\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\ubcc4, \uc778\uc885, \uad6d\uc801, \uc7a5\uc560 \ub4f1."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub298\ub0a0 \ud55c\uad6d \uc0ac\ud68c\uc5d0\uc11c \ub300\ud45c\uc801\uc778 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub85c \uc5b8\uae09\ub418\ub294 \uc9d1\ub2e8 4\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\uc131, \uc7a5\uc560\uc778, \uc774\uc8fc \uc678\uad6d\uc778, \ubd81\ud55c \uc774\ud0c8 \uc8fc\ubbfc \ub4f1."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc5d0 \ub300\ud55c \ucc28\ubcc4\uc774 \uc9c0\uc18d\ub420 \ub54c \uc0ac\ud68c \uc804\uccb4\uc5d0 \ubbf8\uce58\ub294 \ubd80\uc815\uc801 \uc601\ud5a5 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uac1c\ubcc4 \uc778\uac04\uc758 \uc874\uc5c4\uc131 \ud6fc\uc190, 2) \uc0ac\ud68c \uac08\ub4f1 \uc720\ubc1c\uc5d0 \ub530\ub978 \uc0ac\ud68c \ud1b5\ud569 \ubc29\ud574."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9 \uc2dc\uc7a5\uc5d0\uc11c \uc131\ubcc4\uc5d0 \ub530\ub978 \ucc28\ubcc4\uc744 \uc608\ubc29\ud558\uace0 \uc77c\u00b7\uac00\uc815 \uc591\ub9bd\uc744 \uc9c0\uc6d0\ud558\uae30 \uc704\ud574 \uc81c\uc815\ub41c \ubc95\ub960\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub0a8\ub140 \uace0\uc6a9 \ud3c9\ub4f1\uacfc \uc77c\u00b7\uac00\uc815 \uc591\ub9bd \uc9c0\uc6d0\uc5d0 \uad00\ud55c \ubc95\ub960\u300d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\uad6d\uc778 \uadfc\ub85c\uc790\uc758 \uad8c\uc775\uc744 \ubcf4\ud638\ud558\uace0 \uace0\uc6a9 \uad00\ub9ac\ub97c \uc704\ud574 \uc81c\uc815\ub41c \ubc95\ub960\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc678\uad6d\uc778 \uadfc\ub85c\uc790\uc758 \uace0\uc6a9 \ub4f1\uc5d0 \uad00\ud55c \ubc95\ub960\u300d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7a5\uc560\uc778\uc5d0 \ub300\ud55c \ubd80\ub2f9\ud55c \ucc28\ubcc4\uc744 \uae08\uc9c0\ud558\uace0 \uad8c\ub9ac\ub97c \uad6c\uc81c\ud558\uae30 \uc704\ud574 \uc81c\uc815\ub41c \ubc95\ub960\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc7a5\uc560\uc778 \ucc28\ubcc4 \uae08\uc9c0 \ubc0f \uad8c\ub9ac \uad6c\uc81c \ub4f1\uc5d0 \uad00\ud55c \ubc95\ub960\u300d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7a5\uc560\uc778\uc758 \uace0\uc6a9 \uae30\ud68c\ub97c \uc2e4\uc9c8\uc801\uc73c\ub85c \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uae30\uc5c5\uc774\ub098 \uae30\uad00\uc5d0 \uc77c\uc815 \ube44\uc728 \uc774\uc0c1\uc758 \uc7a5\uc560\uc778\uc744 \ucc44\uc6a9\ud558\ub3c4\ub85d \uac15\uc81c\ud558\ub294 \uc815\ucc45\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7a5\uc560\uc778 \uc758\ubb34 \uace0\uc6a9\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc801 \ucc28\uc6d0\uc5d0\uc11c \uc0ac\ud68c\uc801 \uc18c\uc218\uc790 \ucc28\ubcc4\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574 \uac16\ucd94\uc5b4\uc57c \ud560 \uae30\ubcf8\uc801 \ud0dc\ub3c4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc5d0 \ub300\ud55c \ud3b8\uacac\uc744 \ubc84\ub9ac\uace0, \uc11c\ub85c\uc758 \ub2e4\uc591\uc131\uc744 \uc874\uc911\ud558\ub294 \uc790\uc138."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uad6c\uc131\uc6d0 \ub204\uad6c\ub098 \uc9c8\ubcd1, \uc0ac\uace0, \ud574\uc678 \uc774\uc8fc \ub4f1\uc5d0 \uc758\ud574 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uac00 \ub420 \uc218 \uc788\ub294 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub294 \uace0\uc815\ub41c \uc2e0\ubd84\uc774 \uc544\ub2c8\ub77c \uac00\ubcc0\uc801\uc778 '\uc0c1\ub300\uc801 \uac1c\ub150'\uc774\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ud558\ub294 \uccad\uc18c\ub144\uc758 \uad8c\ub9ac\ub97c \uc9c1\uc811\uc801\uc73c\ub85c \ubcf4\ud638\u00b7\uba85\uc2dc\ud558\uace0 \uc788\ub294 \uad6d\ub0b4 \ubc95\uc801 \uadfc\uac70 3\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud55c\ubbfc\uad6d \ud5cc\ubc95, \u300c\uadfc\ub85c \uae30\uc900\ubc95\u300d, \u300c\uccad\uc18c\ub144 \ubcf4\ud638\ubc95\u300d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud55c\ubbfc\uad6d \ud5cc\ubc95 \uc81c32\uc870 \uc81c5\ud56d\uc5d0 \uba85\uc2dc\ub41c \uc5f0\uc18c \uadfc\ub85c\uc790 \uad00\ub828 \uc870\ud56d\uc758 \ub0b4\uc6a9\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\"\uc5f0\uc18c\uc790\uc758 \uadfc\ub85c\ub294 \ud2b9\ubcc4\ud55c \ubcf4\ud638\ub97c \ubc1b\ub294\ub2e4.\""
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uadfc\ub85c \uae30\uc900\ubc95\u300d\uc0c1 '\uc5f0\uc18c \uadfc\ub85c\uc790'\uc5d0 \ud574\ub2f9\ud558\ub294 \uc5f0\ub839 \uae30\uc900\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "15\uc138 \uc774\uc0c1 18\uc138 \ubbf8\ub9cc\uc778 \uc0ac\ub78c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "15\uc138 \ubbf8\ub9cc\uc778 \uc790\ub294 \uc6d0\uce59\uc801\uc73c\ub85c \uadfc\ub85c\uc790\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc73c\ub098, \uc608\uc678\uc801\uc73c\ub85c \uc77c\uc744 \ud560 \uc218 \uc788\ub3c4\ub85d \uace0\uc6a9\ub178\ub3d9\ubd80 \uc7a5\uad00\uc774 \ubc1c\uae09\ud558\ub294 \ubb38\uc11c\uc758 \uba85\uce6d\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucde8\uc9c1 \uc778\ud5c8\uc99d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "18\uc138 \ubbf8\ub9cc \uc5f0\uc18c \uadfc\ub85c\uc790\ub97c \uace0\uc6a9\ud560 \ub54c \uc0ac\uc5c5\uc8fc\uac00 \uc0ac\uc5c5\uc7a5\uc5d0 \ubc18\ub4dc\uc2dc \uad6c\ube44\ud574 \ub450\uc5b4\uc57c \ud558\ub294 \uc99d\uba85 \uc11c\ub958 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uc5f0\ub839\uc744 \uc99d\uba85\ud558\ub294 \uac00\uc871 \uad00\uacc4 \uae30\ub85d \uc0ac\ud56d\uc5d0 \uad00\ud55c \uc99d\uba85\uc11c, 2) \uce5c\uad8c\uc790 \ub610\ub294 \ud6c4\uacac\uc778\uc758 \ub3d9\uc758\uc11c."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uc131\ub144\uc790\uac00 \uc54c\ubc14 \uadfc\ub85c \uacc4\uc57d\uc744 \uccb4\uacb0\ud560 \ub54c \uce5c\uad8c\uc790\ub098 \ud6c4\uacac\uc778\uc774 \uacc4\uc57d\uc744 \ub300\ub9ac\ud558\uc5ec \uc791\uc131\ud560 \uc218 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\uac00\ub2a5\ud558\ub2e4. \u300c\uadfc\ub85c \uae30\uc900\ubc95\u300d \uc81c67\uc870 \uc81c1\ud56d\uc5d0 \ub530\ub77c \uce5c\uad8c\uc790\ub098 \ud6c4\uacac\uc778\uc740 \ubbf8\uc131\ub144\uc790\uc758 \uadfc\ub85c \uacc4\uc57d\uc744 \ub300\ub9ac\ud560 \uc218 \uc5c6\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce5c\uad8c\uc790\ub098 \ud6c4\uacac\uc778\uc758 \ubbf8\uc131\ub144\uc790 \uadfc\ub85c \uacc4\uc57d \ub300\ub9ac\ub97c \ubc95\uc73c\ub85c \uc5c4\uaca9\ud788 \uae08\uc9c0\ud558\ub294 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce5c\uad8c\uc790 \ub4f1\uc5d0 \uc758\ud55c \uc784\uae08 \ucc29\ucde8\ub098 \ubd88\ub9ac\ud55c \uadfc\ub85c \uc870\uac74 \uac15\uc694\ub85c\ubd80\ud130 \ubbf8\uc131\ub144 \uadfc\ub85c\uc790\uc758 \uad8c\ub9ac\ub97c \ubcf4\ud638\ud558\uae30 \uc704\ud568\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uadfc\ub85c \uae30\uc900\ubc95\u300d\uc0c1 15\uc138 \uc774\uc0c1 18\uc138 \ubbf8\ub9cc \uc5f0\uc18c \uadfc\ub85c\uc790\uc758 1\uc77c \ubc95\uc815 \uae30\ubcf8 \uadfc\ub85c \uc2dc\uac04\uc740 \ucd5c\ub300 \uba87 \uc2dc\uac04\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\uc77c\uc5d0 7\uc2dc\uac04 \uc774\ub0b4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uadfc\ub85c \uae30\uc900\ubc95\u300d\uc0c1 \uc5f0\uc18c \uadfc\ub85c\uc790\uc758 1\uc8fc\uc77c \ubc95\uc815 \uae30\ubcf8 \uadfc\ub85c \uc2dc\uac04\uc740 \ucd5c\ub300 \uba87 \uc2dc\uac04\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\uc8fc\uc77c\uc5d0 35\uc2dc\uac04 \uc774\ub0b4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2f9\uc0ac\uc790 \uac04 \ud569\uc758\uac00 \uc788\uc744 \ub54c \uc5f0\uc18c \uadfc\ub85c\uc790\uac00 \uc5f0\uc7a5\ud560 \uc218 \uc788\ub294 \ucd5c\ub300 \uadfc\ub85c \uc2dc\uac04 \ud55c\ub3c4\ub294 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\uc77c\uc5d0 1\uc2dc\uac04, 1\uc8fc\uc77c\uc5d0 5\uc2dc\uac04 \ud55c\ub3c4 (\uc989, \ud558\ub8e8 \ucd5c\ub300 8\uc2dc\uac04, \uc8fc \ucd5c\ub300 40\uc2dc\uac04\uae4c\uc9c0 \uac00\ub2a5)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c \uc2dc\uac04\uc774 4\uc2dc\uac04\uc778 \uacbd\uc6b0 \uc0ac\uc6a9\uc790(\uace0\uc6a9\uc8fc)\uac00 \ubc18\ub4dc\uc2dc \ubd80\uc5ec\ud574\uc57c \ud558\ub294 \ud734\uac8c \uc2dc\uac04\uc758 \uae30\uc900\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c \uc2dc\uac04 \ub3c4\uc911\uc5d0 30\ubd84 \uc774\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c \uc2dc\uac04\uc774 8\uc2dc\uac04\uc778 \uacbd\uc6b0 \uc0ac\uc6a9\uc790\uac00 \ubc18\ub4dc\uc2dc \ubd80\uc5ec\ud574\uc57c \ud558\ub294 \ud734\uac8c \uc2dc\uac04\uc758 \uae30\uc900\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c \uc2dc\uac04 \ub3c4\uc911\uc5d0 1\uc2dc\uac04 \uc774\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c \uae30\uc900\ubc95\uc5d0 \ub530\ub77c \ud734\uac8c \uc2dc\uac04\uc740 \uc2dc\uc810\uc0c1 \uc5b8\uc81c \ubd80\uc5ec\ub418\uc5b4\uc57c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc18\ub4dc\uc2dc '\uadfc\ub85c \uc2dc\uac04 \ub3c4\uc911'\uc5d0 \ubd80\uc5ec\ub418\uc5b4\uc57c \ud558\uba70, \ud1f4\uadfc \uc9c1\uc804\uc774\ub098 \ucd9c\uadfc \uc9c1\ud6c4\ub85c \ub300\uccb4\ud560 \uc218 \uc5c6\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\"\ub098\uc774\uac00 \uc5b4\ub9ac\ubbc0\ub85c \ucd5c\uc800 \uc784\uae08\uc744 \uc801\uc6a9\ud558\uc9c0 \uc54a\ub294\ub2e4\"\ub77c\ub294 \uadfc\ub85c \uacc4\uc57d\uc11c \ud2b9\uc57d \uc0ac\ud56d\uc758 \ubc95\uc801 \ud6a8\ub825\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ud6a8\uc774\ub2e4. \uc5f0\uc18c \uadfc\ub85c\uc790\ub3c4 \ucd5c\uc800 \uc784\uae08\ubc95\uc758 \uc801\uc6a9\uc744 \ubc1b\uc73c\ubbc0\ub85c \ucd5c\uc800 \uc784\uae08 \uc774\uc0c1\uc758 \uae08\uc561\uc744 \ubc1b\uc544\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c \uacc4\uc57d\uc758 \ub0b4\uc6a9 \uc911 \u300c\uadfc\ub85c \uae30\uc900\ubc95\u300d\uc5d0\uc11c \uc815\ud55c \uae30\uc900\uc5d0 \ubbf8\ub2ec\ud558\ub294 \uc870\uac74\uc744 \uc791\uc131\ud588\uc744 \ub54c \ubc1c\uc0dd\ud558\ub294 \ubc95\uc801 \uacb0\uacfc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub2ec\ud558\ub294 \ud574\ub2f9 \uc870\uac74 \ubd80\ubd84\uc740 \ubb34\ud6a8\uac00 \ub418\uba70, \ubb34\ud6a8\uac00 \ub41c \ubd80\ubd84\uc740 \u300c\uadfc\ub85c \uae30\uc900\ubc95\u300d\uc5d0 \uc815\ud55c \uae30\uc900\uc744 \ub530\ub978\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "18\uc138 \ubbf8\ub9cc\uc790\ub97c \uace0\uc6a9\ud560 \uc218 \uc5c6\ub294 \uc0ac\uc5c5\uc7a5\uc758 \ubc95\uc801 \uc81c\ud55c \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c4\ub355\uc0c1 \ub610\ub294 \ubcf4\uac74\uc0c1 \uc720\ud574\u00b7\uc704\ud5d8\ud55c \uc0ac\uc5c5\uc7a5."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\ub2ec \uc544\ub974\ubc14\uc774\ud2b8 \ub3c4\uc911 \uc0ac\uace0\uac00 \ub0ac\uc744 \ub54c \uc0ac\uc7a5\uc774 \"\ubaa8\ub450 \uc54c\ubc14\uc0dd \ucc45\uc784\"\uc774\ub77c\uace0 \uba85\uc2dc\ud558\uac70\ub098 \uc694\uad6c\ud558\ub294 \uac83\uc758 \uc704\ubc95\uc131\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5c5\ubb34\uc0c1 \uc7ac\ud574\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc740 \ubc95\uc801\uc73c\ub85c \uc0ac\uc5c5\uc8fc \ubc0f \uadfc\ub85c\ubcf5\uc9c0\uacf5\ub2e8 \ucc45\uc784\uc774\ubbc0\ub85c \uc77c\ubc29\uc801\uc73c\ub85c \ubaa8\ub4e0 \uc190\ud574\ub97c \uadfc\ub85c\uc790\uc5d0\uac8c \uc804\uac00\ud558\ub294 \uac83\uc740 \uc704\ubc95\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccad\uc18c\ub144 \uadfc\ub85c\uc790\uac00 \uc784\uae08 \uccb4\ubd88\uc774\ub098 \ubd80\ub2f9 \ucc98\uc6b0 \ub4f1 \ub178\ub3d9\uad8c \uce68\ud574\ub97c \ub2f9\ud588\uc744 \ub54c \uad6c\uc81c \uc808\ucc28 \uc548\ub0b4, \uc2dc\uc815 \uba85\ub839 \ubc0f \ubc95\ub960 \uc0c1\ub2f4\uc744 \uc81c\uacf5\ud558\ub294 \ub300\ud45c\uc801 \uae30\uad00 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc6a9\ub178\ub3d9\ubd80, \ub178\ub3d9\uc704\uc6d0\ud68c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c\uc790\uc758 \ubcf5\uc9c0 \uc99d\uc9c4\uc744 \uc704\ud574 \uc124\ub9bd\ub41c \uc900\uc815\ubd80 \uae30\uad00\uc73c\ub85c, \uadfc\ub85c\uc790\uc758 \uc5c5\ubb34\uc0c1 \uc7ac\ud574\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc744 \ub2f4\ub2f9\ud558\ub294 \uacf3\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c\ubcf5\uc9c0\uacf5\ub2e8"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c\uc790\ub97c \uace0\uc6a9\ud558\uc5ec \ub178\ub3d9\uc744 \uc81c\uacf5\ubc1b\uace0 \uadf8\uc5d0 \ub300\ud558\uc5ec \ubcf4\uc218\ub97c \uc9c0\uae09\ud558\ub294 \uc8fc\uccb4\ub97c \uc774\ub974\ub294 \ubc95\uc801 \uc6a9\uc5b4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc6a9\uc790 (\uace0\uc6a9\uc8fc)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccad\uc18c\ub144 \uadfc\ub85c\uc790\uac00 \uc5c5\ubb34\ub97c \uc2dc\uc791\ud558\uae30 \uc804 \uc790\uc2e0\uc758 \ub178\ub3d9\uad8c\uc744 \ubcf4\uc7a5\ubc1b\uae30 \uc704\ud574 \uac00\uc7a5 \uba3c\uc800 \uc2e4\ucc9c\ud574\uc57c \ud560 \ud589\ub3d9\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c \uc870\uac74(\uc784\uae08, \uadfc\ub85c\uc2dc\uac04 \ub4f1)\uc744 \uba85\ud655\ud788 \ud655\uc778\ud558\uace0 \uc11c\uba74\uc73c\ub85c \ud45c\uc900 \uadfc\ub85c \uacc4\uc57d\uc11c\ub97c \uc791\uc131\ud558\uc5ec \uad50\ubd80\ubc1b\ub294 \uac83."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "ee7f3263-fd08-476c-a968-2e2e917aa713",
            "alt": "\uc131\ubcc4\uc744 \uc774\uc720\ub85c \ud55c \ucc28\ubcc4\ub85c \uc2b9\uc9c4 \ubd88\uc774\uc775\uc744 \ubc1b\uace0 \ud1f4\uc0ac\ud558\ub294 \uc5ec\uc131 \uc9c1\uc6d0\uc758 \ubaa8\uc2b5"
          },
          {
            "type": "text",
            "content": "\uc704 \uadf8\ub9bc\uacfc \uac19\uc774 \uc804\ubb38\uc131\uc774 \uc544\ub2cc \uc131\ubcc4\uc744 \uc774\uc720\ub85c \ubc30\uc815 \ubc0f \uc2b9\uc9c4 \ucc28\ubcc4\uc744 \ubc1b\ub294 \uc0c1\ud669\uc740 \uc5b4\ub5a0\ud55c \uad8c\ub9ac\uc758 \uce68\ud574\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\ubcc4\uc5d0 \ub530\ub978 \ub178\ub3d9 \uc2dc\uc7a5\uc5d0\uc11c\uc758 \ucc28\ubcc4 \ubc0f \ud3c9\ub4f1\uad8c(\ub178\ub3d9\uad8c) \uce68\ud574."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "e4dac68b-ae28-4027-b4cb-e0444834e6f0",
            "alt": "\uc57d \uc0c1\uc790\uc5d0 \uc810\uc790 \ud45c\uae30\uac00 \uc5c6\uc5b4 \ubcf5\uc6a9 \uc2dc \ubd88\uc548\ud574\ud558\ub294 \uc2dc\uac01 \uc7a5\uc560\uc778\uc758 \ubaa8\uc2b5"
          },
          {
            "type": "text",
            "content": "\uc704 \uadf8\ub9bc\uacfc \uac19\uc774 \uc758\uc57d\ud488 \uc810\uc790 \uc548\ub0b4 \ubd80\uc7ac\ub85c \uc778\ud574 \ub098\ud0c0\ub098\ub294 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc758 \uad8c\ub9ac \uce68\ud574 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7a5\uc560\uc778\uc5d0 \ub300\ud55c \ud3b8\uc758 \uc2dc\uc124 \ubd80\uc7ac\ub85c \uc778\ud574 \uc0dd\uba85\u00b7\uac74\uac15\uad8c \ubc0f \uc54c \uad8c\ub9ac\uac00 \uce68\ud574\ubc1b\ub294 \ubb38\uc81c."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "682b4b0c-9efd-4cc5-b768-052169e0bce6",
            "alt": "\ube44\ub2d0\ud558\uc6b0\uc2a4\uc5d0\uc11c \uc77c\ud558\uba70 \ubaa8\uc695\uc801 \uc5b8\ud589\uacfc \ubd80\uc2e4\ud55c \uc8fc\uac70 \ud658\uacbd\uc744 \uacaa\ub294 \uc774\uc8fc \uc678\uad6d\uc778 \uadfc\ub85c\uc790\uc758 \ubaa8\uc2b5"
          },
          {
            "type": "text",
            "content": "\uc704 \uc0ac\ub840\uc5d0 \uc81c\uc2dc\ub41c \uc774\uc8fc \uc678\uad6d\uc778 \uadfc\ub85c\uc790\uac00 \uacaa\ub294 \ubd80\ub2f9\ud55c \ucc28\ubcc4 \uc694\uc18c 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \ud55c\uad6d\ub9d0\uc774 \uc11c\ud22c\ub974\ub2e4\ub294 \uc774\uc720\uc758 \uc5b8\uc5b4\ud3ed\ub825(\uc778\uaca9\uad8c \uce68\ud574), 2) \uc5f4\uc545\ud55c \ube44\ub2d0\ud558\uc6b0\uc2a4 \uc8fc\uac70 \ud658\uacbd \uac15\uc694."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "669a3c07-9593-4de4-83c4-fda7fd640085",
            "alt": "\ub300\ud559\uc0dd\ub4e4\uc774 \ud720\uccb4\uc5b4\ub97c \ud0c0\uac70\ub098 \uc548\ub300\ub97c \uac00\ub9ac\uace0 \ud770 \uc9c0\ud321\uc774\ub97c \uc9da\uc73c\uba70 \uac70\ub9ac \ud589\uc9c4\uc744 \ud1b5\ud574 \uc7a5\uc560 \uccb4\ud5d8\uc744 \uc9c4\ud589\ud558\ub294 \ubaa8\uc2b5"
          },
          {
            "type": "text",
            "content": "\uc704\uc640 \uac19\uc740 \uc7a5\uc560 \uccb4\ud5d8 \ubc0f \ucea0\ud398\uc778 \ud65c\ub3d9\uc774 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790 \ubb38\uc81c \ud574\uacb0\uc5d0 \ubbf8\uce58\ub294 \uad50\uc721\uc801 \ud6a8\uacfc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uac00 \uacaa\ub294 \uc77c\uc0c1\uc801 \uc5b4\ub824\uc6c0\uc744 \uacf5\uac10\ud558\uace0, \ucc28\ubcc4\uc801 \ud3b8\uacac\uc744 \uadf9\ubcf5\ud558\uc5ec \uac1c\uc778\uc801 \ucc28\uc6d0\uc758 \uc758\uc2dd\uc744 \uac1c\uc120\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc18c \uadfc\ub85c\uc790 \ud45c\uc900 \uadfc\ub85c \uacc4\uc57d\uc11c \uc791\uc131 \uc2dc \ube60\uc9d0\uc5c6\uc774 \uae30\uc7ac\ub418\uc5b4\uc57c \ud560 \ud544\uc218 \ud56d\ubaa9 5\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uadfc\ub85c \uacc4\uc57d \uae30\uac04, 2) \uadfc\ubb34 \uc7a5\uc18c, 3) \uc5c5\ubb34 \ub0b4\uc6a9, 4) \uadfc\ub85c \uc2dc\uac04 \ubc0f \ud734\uac8c \uc2dc\uac04, 5) \uadfc\ubb34\uc77c/\ud734\uc77c \ubc0f \uc784\uae08 \uc870\uac74."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "16\uc138 \uace0\ub4f1\ud559\uc0dd\uc774 '\uc8fc 6\uc77c \uadfc\ubb34, \ud558\ub8e8 7\uc2dc\uac04 \uadfc\ubb34(\ucd1d \uc8fc 42\uc2dc\uac04)' \uc870\uac74\uc73c\ub85c \uadfc\ub85c \uacc4\uc57d\uc744 \ud569\uc758\ud574 \uc11c\uba85\ud588\ub2e4\uba74, \ubc95\uc801 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc18c\uc790\uc758 \uc8fc\ub2f9 \ubc95\uc815 \uadfc\ub85c \uc2dc\uac04(35\uc2dc\uac04)\uacfc \uc5f0\uc7a5 \ud55c\ub3c4(\uc8fc 5\uc2dc\uac04)\ub97c \ud569\uce5c \ucd5c\ub300 40\uc2dc\uac04\uc744 \ucd08\uacfc\ud558\uc5ec \ubc95\ub960\uc5d0 \uc704\ubc18\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc5c5\uc8fc\uac00 \uccad\uc18c\ub144 \uadfc\ub85c\uc790\ub97c \ubd80\ub97c \ub54c '\uc57c, \uac70\uae30!'\ub77c\uace0 \ud638\uce6d\ud558\uac70\ub098 \ud3ed\uc5b8\u00b7\ud3ed\ud589\uc744 \uac00\ud558\ub294 \uac83\uc740 \uc5b4\ub5a4 \ubc95\uc801 \uc704\ubc18\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c\uc790\uc758 \uc778\uaca9\uad8c\uc744 \ud6fc\uc190\ud558\ub294 \ubd80\ub2f9 \ucc98\uc6b0 \ubc0f \ud3ed\ud589 \uae08\uc9c0 \uc870\ud56d(\uadfc\ub85c\uae30\uc900\ubc95) \uc704\ubc18\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc95\uc801\uc73c\ub85c \uc815\ud574\uc9c4 \ub2f9\ud574 \uc5f0\ub3c4\uc758 \ucd5c\uc800 \uc784\uae08 \uc561\uc218\ub97c \uacf5\uc2dd \ud655\uc778\ud560 \uc218 \uc788\ub294 \uc0ac\uc774\ud2b8\uba85\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd5c\uc800\uc784\uae08\uc704\uc6d0\ud68c (www.minimumwage.go.kr)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\uc778 \uadfc\ub85c\uc790\ubcf4\ub2e4 \uc5f0\uc18c \uadfc\ub85c\uc790\uc758 \ubc95\uc815 \uadfc\ub85c\uc2dc\uac04\uc744 \ub354 \uc9e7\uac8c \uc81c\ud55c\ud558\ub294 \uadfc\ubcf8\uc801\uc778 \ubc95\uc801 \ubaa9\uc801\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\uc7a5 \ub2e8\uacc4\uc5d0 \uc788\ub294 \uc5f0\uc18c\uc790\uc758 \uc2e0\uccb4\uc801\u00b7\uc815\uc2e0\uc801 \uac74\uac15 \ubc0f \uad50\uc721\ubc1b\uc744 \uad8c\ub9ac\ub97c \ud2b9\ubcc4\ud788 \ubcf4\ud638\ud558\uae30 \uc704\ud568\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc6a9\uc790(\uace0\uc6a9\uc8fc)\uac00 \uccad\uc18c\ub144\uc744 \ucc44\uc6a9\ud560 \ub54c \uc900\uc218\ud574\uc57c \ud558\ub294 \ubc95\uc801 \uc758\ubb34 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uadfc\ub85c \uacc4\uc57d\uc11c \uc791\uc131 \ubc0f \uad50\ubd80 \uc758\ubb34, 2) \ubc95\uc815 \ucd5c\uc800 \uc784\uae08 \ubc0f \uadfc\ub85c \uc2dc\uac04 \uc900\uc218 \uc758\ubb34."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccad\uc18c\ub144 \uc544\ub974\ubc14\uc774\ud2b8\uc0dd\uc774 \uc77c\ud558\ub2e4 \ub2e4\ucce4\uc744 \ub54c \uce58\ub8cc\ube44 \ub4f1\uc744 \uc9c0\uc6d0\ubc1b\uc744 \uc218 \uc788\ub3c4\ub85d \uc6b4\uc601\ub418\ub294 \uc0ac\ud68c \ubcf4\ud5d8 \uc81c\ub3c4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc5c5\uc7ac\ud574\ubcf4\uc0c1\ubcf4\ud5d8 (\uc0b0\uc7ac\ubcf4\ud5d8)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
