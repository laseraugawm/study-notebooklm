{
  "title": "\ubb34\uc5ed \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 '\ubb34\uc5ed(\uad6d\uc81c \uac70\ub798)'\uc758 \uac1c\ub150 \ubc0f \uc77c\uc0c1\uc0dd\ud65c\uacfc \uacbd\uc81c \uc8fc\uccb4\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb34\uc5ed\uc740 \uad6d\uacbd\uc744 \ub118\uc5b4 \uc0c1\ud488\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc11c\ube44\uc2a4, \uc0dd\uc0b0 \uc694\uc18c \ub4f1\uc744 \uac70\ub798\ud558\ub294 \uac83\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uad6d\uc81c \uac70\ub798(\ubb34\uc5ed)\ub294 \ub2e8\uc21c\ud55c \uc720\ud615\uc758 \uc0c1\ud488 \uad50\ud658\uc5d0 \uad6d\ud55c\ub418\uc9c0 \uc54a\uace0 \uc11c\ube44\uc2a4, \ub178\ub3d9\u00b7\uc790\ubcf8 \ub4f1\uc758 \uc0dd\uc0b0 \uc694\uc18c \uac70\ub798\uae4c\uc9c0 \ubaa8\ub450 \ud3ec\ud568\ud55c\ub2e4."
        },
        {
          "text": "\ubb34\uc5ed\uc740 \uc624\uc9c1 \uc720\ud615\uc758 \uc7ac\ud654(\uc0c1\ud488)\uc758 \uc774\ub3d9\ub9cc\uc744 \uc758\ubbf8\ud558\uba70 \uc11c\ube44\uc2a4\ub098 \uc0dd\uc0b0 \uc694\uc18c\uc758 \uac70\ub798\ub294 \ud3ec\ud568\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb34\uc5ed\uc740 \uad6d\uacbd\uc744 \ub118\uc5b4 \uc774\ub8e8\uc5b4\uc9c0\ub294 \uc0c1\ud488, \uc11c\ube44\uc2a4 \ubc0f \uc0dd\uc0b0 \uc694\uc18c\uc758 \uac70\ub798\ub97c \ubaa8\ub450 \ud3ec\uad04\ud55c\ub2e4."
        },
        {
          "text": "\ubb34\uc5ed\uc774 \ud65c\uc131\ud654\ub418\uba74 \uc18c\ube44\uc790\ub294 \uc790\uad6d\uc5d0\uc11c \uc0dd\uc0b0\ub41c \uc81c\ud488\ub9cc \uc120\ud0dd\ud558\uac8c \ub418\ubbc0\ub85c \uc18c\ube44\uc758 \ub2e4\uc591\uc131\uc774 \uac10\uc18c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\ube44\uc790\ub294 \ubb34\uc5ed\uc744 \ud1b5\ud574 \uc790\uad6d\uc5d0\uc11c \uc0dd\uc0b0\ub418\uc9c0 \uc54a\uac70\ub098 \ubd80\uc871\ud55c \uc678\uad6d\uc758 \uc9c8 \uc88b\uace0 \uc800\ub834\ud55c \uc81c\ud488\uc744 \uc120\ud0dd\ud560 \uc218 \uc788\uc5b4 \ud48d\uc694\ub85c\uc6b4 \uc18c\ube44 \uc0dd\ud65c\uc744 \ub204\ub9b4 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0\uc790\ub294 \uc790\uad6d \uc2dc\uc7a5\ub9cc\uc744 \ub300\uc0c1\uc73c\ub85c \uc0c1\ud488\uc744 \ud310\ub9e4\ud560 \ub54c\ubcf4\ub2e4 \uc678\uad6d\uacfc\uc758 \uac70\ub798 \uc2dc \uc774\uc724\uc774 \ud56d\uc0c1 \uac10\uc18c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\uc0b0\uc790\ub294 \uc790\uc2e0\uc774 \uc0dd\uc0b0\ud55c \uc81c\ud488\uc744 \uc678\uad6d \uc2dc\uc7a5\uc5d0 \ud310\ub9e4\ud558\uc5ec \ub354 \ud070 \uc774\uc724\uc744 \uc5bb\uc744 \uc218 \uc788\ub2e4."
        }
      ],
      "hint": "\ubb34\uc5ed \uac70\ub798 \ub300\uc0c1\uc5d0\ub294 \ubb3c\ub9ac\uc801\uc778 \uc0c1\ud488 \uc678\uc5d0 \uc5b4\ub5a4 \uac83\ub4e4\uc774 \ud3ec\ud568\ub418\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc138\uacc4 \uc5ec\ub7ec \ub098\ub77c \uc0ac\uc774\uc5d0\uc11c \ubb34\uc5ed\uc774 \ubc1c\uc0dd\ud558\uac8c \ub418\ub294 \uadfc\ubcf8\uc801\uc778 \uc6d0\uc778\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubaa8\ub4e0 \uad6d\uac00\uc758 \uc0dd\uc0b0\ube44 \uc218\uc900\uacfc \uae30\uc220\ub825\uc774 \ub3d9\uc77c\ud560 \ub54c \ubb34\uc5ed\uc744 \ud1b5\ud55c \uad50\uc5ed \uc774\uc775\uc774 \uac00\uc7a5 \ud06c\uac8c \ubc1c\uc0dd\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubb34\uc5ed\uc740 \uad6d\uac00 \uac04 \uc790\uc5f0\ud658\uacbd, \uc0dd\uc0b0 \uc694\uc18c, \uae30\uc220 \uc218\uc900 \ub4f1\uc758 \ucc28\uc774\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 '\uc0dd\uc0b0\ube44\uc758 \ucc28\uc774'\uc5d0 \uae30\uc778\ud558\ubbc0\ub85c, \uc0dd\uc0b0 \uc870\uac74\uc774 \uc644\ubcbd\ud788 \ub3d9\uc77c\ud558\uba74 \ubb34\uc5ed\uc758 \ud544\uc694\uc131\uc774 \uc904\uc5b4\ub4e0\ub2e4."
        },
        {
          "text": "\uae30\ud6c4, \uc9c0\ud615 \ub4f1 \uc790\uc5f0\ud658\uacbd\uc758 \ucc28\uc774\ub85c \uc778\ud574 \uac01\uad6d\uc5d0\uc11c \uc0dd\uc0b0\ud560 \uc218 \uc788\ub294 \uc790\uc6d0\uc774\ub098 \uc0c1\ud488\uc758 \uc0dd\uc0b0\ube44\uc5d0 \ucc28\uc774\uac00 \ubc1c\uc0dd\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc5f0\ud658\uacbd\uc758 \ub2e4\uc591\uc131\uc740 \uad6d\uac00 \uac04 \uc790\uc6d0 \ubd84\ud3ec \ubc0f \uc0dd\uc0b0 \uc870\uac74\uc758 \ucc28\uc774\ub97c \ub9cc\ub4e4\uc5b4 \ub0b4\ub294 \ub300\ud45c\uc801\uc778 \uc6d0\uc778\uc774\ub2e4."
        },
        {
          "text": "\ub178\ub3d9\uacfc \uc790\ubcf8 \ub4f1 \uc0dd\uc0b0 \uc694\uc18c\uc758 \ubcf4\uc720\ub7c9 \ubc0f \uae30\uc220 \uc218\uc900\uc758 \ucc28\uc774\uac00 \uc0dd\uc0b0\ube44 \ucc28\uc774\ub97c \uac00\uc838\uc628\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac01 \uad6d\uac00\uac00 \ubcf4\uc720\ud55c \uc0dd\uc0b0 \uc694\uc18c\uc758 \uc591\uacfc \uae30\uc220\uc801 \ucc28\uc774\ub294 \uac01 \uc0c1\ud488\uc758 \uc0dd\uc0b0 \ud6a8\uc728\uc131\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce5c\ub2e4."
        },
        {
          "text": "\uac01 \uad6d\uac00\uac00 \uc0c1\ub300\uc801\uc73c\ub85c \uc801\uc740 \uc0dd\uc0b0\ube44\ub85c \ub354 \uc798 \ub9cc\ub4e4 \uc218 \uc788\ub294 \uc0c1\ud488\uc744 \uc0dd\uc0b0\ud558\uc5ec \uad50\ud658\ud558\uba74 \uc591\uad6d \ubaa8\ub450 \uc774\uc775\uc744 \uc5bb\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0c1\ub300\uc801 \uc6b0\uc704\uac00 \uc788\ub294 \uc0c1\ud488\uc5d0 \uc9d1\uc911\ud558\uc5ec \uac70\ub798\ud558\ub294 \uac83\uc774 \uad50\uc5ed \ub2f9\uc0ac\uad6d \ubaa8\ub450\uc5d0\uac8c \uc774\uc775\uc744 \uac00\uc838\ub2e4\uc8fc\ub294 \ud575\uc2ec \uc6d0\ub9ac\uc774\ub2e4."
        }
      ],
      "hint": "\uad6d\uac00 \uac04 \uac70\ub798\uac00 \uc774\ub8e8\uc5b4\uc9c0\uae30 \uc704\ud574 \ud544\uc694\ud55c \uc870\uac74\uc778 '\uc0dd\uc0b0\ube44 \ucc28\uc774'\uc758 \ubc1c\uc0dd \uc694\uc778\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ud45c\ub294 \uac11\uacfc \uc744\uc774 \ud558\ub8e8 \ub3d9\uc548 \ucd5c\ub300\ub85c \uc0dd\uc0b0\ud560 \uc218 \uc788\ub294 \ubb3c\uace0\uae30\uc640 \uc5f4\ub9e4\uc758 \uc591\uc744 \ub098\ud0c0\ub0b8 \uac83\uc774\ub2e4.\n\n| \uad6c\ubd84 | \ubb3c\uace0\uae30 | \uc5f4\ub9e4 |\n| --- | --- | --- |\n| \uac11 | 15\ub9c8\ub9ac | 24\uac1c |\n| \uc744 | 12\ub9c8\ub9ac | 9\uac1c |\n\n\uc774 \ud45c\ub97c \ubc14\ud0d5\uc73c\ub85c \uae30\ud68c\ube44\uc6a9\uacfc \ube44\uad50 \uc6b0\uc704\ub97c \ubd84\uc11d\ud55c \ub0b4\uc6a9 \uc911 \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb3c\uace0\uae30 1\ub9c8\ub9ac\ub97c \uc7a1\uae30 \uc704\ud55c \uae30\ud68c\ube44\uc6a9\uc740 \uc744($\\frac{3}{4}$\uac1c)\uc774 \uac11($\\frac{8}{5}$\uac1c)\ubcf4\ub2e4 \uc801\uc73c\ubbc0\ub85c, \uc744\uc774 \ubb3c\uace0\uae30 \uc7a1\uae30\uc5d0 \ube44\uad50 \uc6b0\uc704\uac00 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc744\uc774 \ubb3c\uace0\uae30 1\ub9c8\ub9ac\ub97c \uc5bb\uae30 \uc704\ud574 \ud3ec\uae30\ud574\uc57c \ud558\ub294 \uc5f4\ub9e4\ub294 $\\frac{9}{12} = \\frac{3}{4}$\uac1c\uc774\uace0, \uac11\uc740 $\\frac{24}{15} = \\frac{8}{5}$\uac1c\uc774\ubbc0\ub85c \uae30\ud68c\ube44\uc6a9\uc774 \ub354 \uc801\uc740 \uc744\uc774 \ubb3c\uace0\uae30 \uc7a1\uae30\uc5d0 \ube44\uad50 \uc6b0\uc704\ub97c \uac00\uc9c4\ub2e4."
        },
        {
          "text": "\uc5f4\ub9e4 1\uac1c\ub97c \ub530\uae30 \uc704\ud55c \uae30\ud68c\ube44\uc6a9\uc740 \uc744\uc774 \uac11\ubcf4\ub2e4 \uc801\uc73c\ubbc0\ub85c \uc744\uc774 \uc5f4\ub9e4 \ub530\uae30\uc5d0 \ube44\uad50 \uc6b0\uc704\uac00 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f4\ub9e4 1\uac1c\ub97c \uc5bb\uae30 \uc704\ud55c \uae30\ud68c\ube44\uc6a9\uc740 \uac11\uc774 $\\frac{15}{24} = \\frac{5}{8}$\ub9c8\ub9ac, \uc744\uc774 $\\frac{12}{9} = \\frac{4}{3}$\ub9c8\ub9ac\uc774\ubbc0\ub85c \uac11\uc774 \uae30\ud68c\ube44\uc6a9\uc774 \ub354 \uc801\uc5b4 \uc5f4\ub9e4 \ub530\uae30\uc5d0 \ube44\uad50 \uc6b0\uc704\uac00 \uc788\ub2e4."
        },
        {
          "text": "\uac11\uc740 \ubb3c\uace0\uae30\uc640 \uc5f4\ub9e4 \ub450 \uc0c1\ud488 \ubaa8\ub450\uc5d0\uc11c \uc0dd\uc0b0\ub7c9\uc774 \ub354 \ub9ce\uc73c\ubbc0\ub85c \ubb34\ub3d9\ub825 \uc0c1\ud0dc\uac00 \ub418\uc5b4 \ubb34\uc5ed \uc774\uc775\uc744 \uc5bb\uc744 \uc218 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud55c \ub098\ub77c\uac00 \ubaa8\ub4e0 \uc0c1\ud488 \uc0dd\uc0b0\uc5d0\uc11c \uc808\ub300\uc801\uc778 \uc6b0\uc704\uc5d0 \uc788\ub354\ub77c\ub3c4, \uae30\ud68c\ube44\uc6a9\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \uc791\uc740 \uc0c1\ud488\uc5d0 \ud2b9\ud654\ud558\uc5ec \ubb34\uc5ed\ud558\uba74 \uc591\uad6d \ubaa8\ub450 \uc774\uc775\uc744 \ubcf8\ub2e4."
        },
        {
          "text": "\uac11\uc740 \ubb3c\uace0\uae30 \uc7a1\uae30\uc5d0 \ube44\uad50 \uc6b0\uc704\uac00 \uc788\uace0, \uc744\uc740 \uc5f4\ub9e4 \ub530\uae30\uc5d0 \ube44\uad50 \uc6b0\uc704\uac00 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\ud68c\ube44\uc6a9\uc744 \uacc4\uc0b0\ud574 \ubcf4\uba74 \uac11\uc740 \uc5f4\ub9e4 \ub530\uae30, \uc744\uc740 \ubb3c\uace0\uae30 \uc7a1\uae30\uc5d0 \uac01\uac01 \ube44\uad50 \uc6b0\uc704\uac00 \uc788\ub2e4."
        }
      ],
      "hint": "\uac01 \uc0c1\ud488 1\ub2e8\uc704\ub97c \uc5bb\uae30 \uc704\ud574 \ud3ec\uae30\ud574\uc57c \ud558\ub294 \ub2e4\ub978 \uc0c1\ud488\uc758 \uc591(\uae30\ud68c\ube44\uc6a9)\uc744 \uad6c\ud558\uc5ec \ub354 \uc791\uc740 \ucabd\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uac11\uacfc \uc744\uc774 \uac01\uac01 \ud558\ub8e8\uc758 $\\frac{1}{3}$\uc740 \ubb3c\uace0\uae30 \uc7a1\uae30, $\\frac{2}{3}$\ub294 \uc5f4\ub9e4 \ub530\uae30\uc5d0 \ud22c\uc790\ud558\ub2e4\uac00, \uac01\uc790 \ube44\uad50 \uc6b0\uc704\uc5d0 \uc788\ub294 \uc0c1\ud488\uc5d0 \uc804\ub150(\ud2b9\ud654)\ud55c \ud6c4 '\uc5f4\ub9e4 7\uac1c'\uc640 '\ubb3c\uace0\uae30 7\ub9c8\ub9ac'\ub97c \uad50\ud658\ud558\uc600\ub2e4. \uc774 \uad50\ud658 \uacb0\uacfc\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?\n\n- \ud2b9\ud654 \uc804 \uc18c\ube44\ub7c9: \uac11(\ubb3c\uace0\uae30 5\ub9c8\ub9ac, \uc5f4\ub9e4 16\uac1c), \uc744(\ubb3c\uace0\uae30 4\ub9c8\ub9ac, \uc5f4\ub9e4 6\uac1c)\n- \ud558\ub8e8 \ucd5c\ub300 \uc0dd\uc0b0\ub7c9: \uac11(\ubb3c\uace0\uae30 15\ub9c8\ub9ac \ub610\ub294 \uc5f4\ub9e4 24\uac1c), \uc744(\ubb3c\uace0\uae30 12\ub9c8\ub9ac \ub610\ub294 \uc5f4\ub9e4 9\uac1c)",
      "answerOptions": [
        {
          "text": "\uad50\ud658 \ud6c4 \uac11\uc740 \ud2b9\ud654 \uc804\ubcf4\ub2e4 \ubb3c\uace0\uae30 2\ub9c8\ub9ac\uc640 \uc5f4\ub9e4 1\uac1c\uc758 \uc774\uc775\uc744 \ucd94\uac00\ub85c \uc5bb\ub294\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac11\uc774 \uc5f4\ub9e4 24\uac1c\ub97c \uc0dd\uc0b0\ud55c \ub4a4 \uc5f4\ub9e4 7\uac1c\ub97c \uc8fc\uace0 \ubb3c\uace0\uae30 7\ub9c8\ub9ac\ub97c \uac00\uc838\uc624\uba74 '\ubb3c\uace0\uae30 7\ub9c8\ub9ac, \uc5f4\ub9e4 17\uac1c'\ub97c \uc18c\ube44\ud558\ubbc0\ub85c \ud2b9\ud654 \uc804(\ubb3c\uace0\uae30 5\ub9c8\ub9ac, \uc5f4\ub9e4 16\uac1c)\ubcf4\ub2e4 \ubb3c\uace0\uae30 2\ub9c8\ub9ac, \uc5f4\ub9e4 1\uac1c\uc758 \uc774\uc775\uc774 \ubc1c\uc0dd\ud55c\ub2e4."
        },
        {
          "text": "\uad50\ud658 \ud6c4 \uc744\uc740 \ud2b9\ud654 \uc804\uacfc \ube44\uad50\ud588\uc744 \ub54c \uc18c\ube44\ud560 \uc218 \uc788\ub294 \ubb3c\uace0\uae30\uc758 \uc591\uc774 \uac10\uc18c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc744\uc740 \ubb3c\uace0\uae30 12\ub9c8\ub9ac\ub97c \uc0dd\uc0b0\ud558\uace0 7\ub9c8\ub9ac\ub97c \uac74\ub128 \ub4a4 \uc5f4\ub9e4 7\uac1c\ub97c \ubc1b\uc73c\ubbc0\ub85c '\ubb3c\uace0\uae30 5\ub9c8\ub9ac, \uc5f4\ub9e4 7\uac1c'\ub97c \uc18c\ube44\ud558\uac8c \ub418\uc5b4 \ud2b9\ud654 \uc804(\ubb3c\uace0\uae30 4\ub9c8\ub9ac, \uc5f4\ub9e4 6\uac1c)\ubcf4\ub2e4 \ubb3c\uace0\uae30 1\ub9c8\ub9ac\uc640 \uc5f4\ub9e4 1\uac1c\uac00 \ub298\uc5b4\ub09c\ub2e4."
        },
        {
          "text": "\ube44\uad50 \uc6b0\uc704 \uc0c1\ud488 \ud2b9\ud654 \uc0dd\uc0b0 \uc2dc \uc744\uc740 \ud558\ub8e8 \ub3d9\uc548 \uc5f4\ub9e4 9\uac1c\ub97c \uc804\ub7c9 \uc0dd\uc0b0\ud558\uac8c \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc744\uc740 \ubb3c\uace0\uae30 \uc7a1\uae30\uc5d0 \ube44\uad50 \uc6b0\uc704\uac00 \uc788\uc73c\ubbc0\ub85c \ubb3c\uace0\uae30 12\ub9c8\ub9ac\ub97c \ud2b9\ud654 \uc0dd\uc0b0\ud55c\ub2e4."
        },
        {
          "text": "\ud2b9\ud654 \ubc0f \uad50\ud658 \uacfc\uc815\uc744 \uac70\uce58\uba74 \uac11\ub9cc \uc774\uc775\uc744 \ubcf4\uace0 \uc744\uc740 \uacbd\uc81c\uc801 \uc190\uc2e4\uc744 \uc785\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube44\uad50 \uc6b0\uc704\uc5d0 \ub530\ub978 \ud2b9\ud654\uc640 \uad50\ud658\uc740 \ubb34\uc5ed\uc5d0 \ucc38\uc5ec\ud558\ub294 \uc591\uce21 \uacbd\uc81c \uc8fc\uccb4 \ubaa8\ub450\uc5d0\uac8c \uc774\uc775\uc744 \uac00\uc838\ub2e4\uc900\ub2e4."
        }
      ],
      "hint": "\uac11\uc774 \uc5f4\ub9e4\ub9cc 24\uac1c \uc0dd\uc0b0\ud55c \ud6c4 7\uac1c\ub97c \uc8fc\uace0 \ubb3c\uace0\uae30 7\ub9c8\ub9ac\ub97c \ubc1b\uc558\uc744 \ub54c\uc758 \ucd5c\uc885 \uc218\ub7c9\uc744 \ud2b9\ud654 \uc804 \uc218\ub7c9\uacfc \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uac11\uad6d\uc774 \uc637\uacfc \uc790\ub3d9\ucc28 \ub450 \uc0c1\ud488 \ubaa8\ub450\ub97c \uc744\uad6d\ubcf4\ub2e4 \uc801\uc740 \uc0dd\uc0b0\ube44\ub85c \ub9cc\ub4e4 \uc218 \uc788\ub294 \uc0c1\ud669\uc774\ub2e4. \ubcf8\ubb38\uc758 \ub17c\ub9ac\uc5d0 \ub530\ub97c \ub54c \uc774 \ub450 \uad6d\uac00\uc758 \ubb34\uc5ed \uac00\ub2a5\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
