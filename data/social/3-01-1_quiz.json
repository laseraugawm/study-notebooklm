{
  "title": "\uc790\ubcf8\uc8fc\uc758 \ud034\uc988",
  "questions": [
    {
      "question": "\uc790\ubcf8\uc8fc\uc758 \uacbd\uc81c \uccb4\uc81c\uc758 \uae30\ubcf8 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc774 \uc0dd\uc0b0 \uc218\ub2e8\uc744 \ud3ec\ud568\ud55c \uc7ac\uc0b0\uc744 \uc18c\uc720\u00b7\uad00\ub9ac\u00b7\ucc98\ubd84\ud560 \uc218 \uc788\ub294 \uc0ac\uc720 \uc7ac\uc0b0\uad8c\uc744 \ubcf4\uc7a5\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\ubcf8\uc8fc\uc758\ub294 \uc0ac\uc720 \uc7ac\uc0b0 \uc81c\ub3c4\ub97c \ubc14\ud0d5\uc73c\ub85c \uac1c\uc778\uc774 \ud1a0\uc9c0, \uacf5\uc7a5 \ub4f1 \uc0dd\uc0b0 \uc218\ub2e8 \ubc0f \uc7ac\uc0b0\uc744 \uc790\uc728\uc801\uc73c\ub85c \uc18c\uc720\ud558\uace0 \ucc98\ubd84\ud560 \uad8c\ub9ac\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80\uac00 \uc911\uc559\uc9d1\uc911\uc801 \uacc4\ud68d\uc744 \uc218\ub9bd\ud558\uc5ec \uc0dd\uc0b0\ub7c9\uacfc \uc0c1\ud488 \uac00\uaca9\uc744 \uc9c1\uc811 \uacb0\uc815\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc911\uc559\uc815\ubd80\uc758 \uacc4\ud68d\uc5d0 \uc758\ud574 \uacbd\uc81c \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub294 \uac83\uc740 \uc790\ubcf8\uc8fc\uc758\uac00 \uc544\ub2cc \uc0ac\ud68c\uc8fc\uc758 \uacbd\uc81c \uccb4\uc81c\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\ubcc4 \uacbd\uc81c \uc8fc\uccb4\uac00 \uc0ac\uc801 \uc774\uc775\uc744 \ucd94\uad6c\ud558\ub294 \ud589\uc704\ub294 \uc0ac\ud68c \uc804\uccb4\uc758 \uc774\uc775\uc744 \uc800\ud574\ud55c\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\ubcf8\uc8fc\uc758\uc5d0\uc11c\ub294 \uac01 \uc8fc\uccb4\uac00 \uc790\uc2e0\uc758 \uc774\uc775\uc744 \ucd94\uad6c\ud558\uace0 \uacbd\uc7c1\ud558\ub294 \uacfc\uc815\uc5d0\uc11c \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc0ac\ud68c \uc804\uccb4\uc758 \uc774\uc775\ub3c4 \uc99d\uac00\ud55c\ub2e4\uace0 \ubd05\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0 \uc218\ub2e8\uc758 \uad6d\uc720\ud654\uc640 \uacf5\ub3d9 \uc18c\uc720\ub97c \uc6d0\uce59\uc73c\ub85c \ud558\uc5ec \uc18c\ub4dd\uc758 \uc808\ub300\uc801 \ud3c9\ub4f1\uc744 \uc9c0\ud5a5\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\uc0b0 \uc218\ub2e8\uc758 \uacf5\ub3d9 \uc18c\uc720 \ub610\ub294 \uad6d\uc720\ud654\ub294 \uc790\ubcf8\uc8fc\uc758\uc758 \ud3d0\ud574\ub97c \uadf9\ubcf5\ud558\uace0\uc790 \ub4f1\uc7a5\ud55c \uc0ac\ud68c\uc8fc\uc758 \uc0ac\uc0c1\uc758 \ud575\uc2ec \uc6d0\uce59\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac1c\uc778\uc758 \uc7ac\uc0b0 \uc18c\uc720\uc640 \uc790\uc720\ub85c\uc6b4 \uacc4\uc57d \ubc0f \uc9c1\uc5c5 \uc120\ud0dd \uad8c\ub9ac\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc815\ubd80\ub098 \ud1b5\uce58\uc790\uac00 \ubc95\uc73c\ub85c \ube75 \uac00\uaca9\uc744 \uac15\uc81c\ub85c \uc778\ud558\uc2dc\ucf30\uc744 \ub54c \ub098\ud0c0\ub098\ub294 \uacbd\uc81c\uc801 \uacb0\uacfc\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ube75\uc744 \ud314\ub824\ub294 \uacf5\uae09\uc790\uac00 \uc904\uc5b4\ub4e4\uc5b4 \uc18c\ube44\uc790\uac00 \uc904\uc744 \uc11c\uc11c \uae30\ub2e4\ub824\ub3c4 \ube75\uc744 \uc0ac\uae30 \uc5b4\ub824\uc6cc\uc9c4\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac00\uaca9\uc744 \uc778\uc704\uc801\uc73c\ub85c \ub0ae\ucd94\uba74 \uc0c1\uc778\ub4e4\uc758 \ud310\ub9e4 \uc774\uc724\uc774 \uc904\uc5b4\ub4e4\uc5b4 \uacf5\uae09\ub7c9\uc774 \uac10\uc18c\ud558\ubbc0\ub85c \uc2dc\uc7a5\uc5d0\uc11c shortage(\uc218\uc694 \ucd08\uacfc \ubc0f \uacf5\uae09 \ubd80\uc871)\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ube75\uc758 \uacf5\uae09\ub7c9\uc774 \ube44\uc57d\uc801\uc73c\ub85c \ub298\uc5b4\ub098 \ubaa8\ub4e0 \uc18c\ube44\uc790\uac00 \ud48d\uc871\ud558\uac8c \ube75\uc744 \uad6c\ub9e4\ud560 \uc218 \uc788\uac8c \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac00\uaca9\uc774 \ub0ae\uc544\uc9c0\uba74 \uc0dd\uc0b0\uc790\uc758 \uc774\uc724 \ub3d9\uae30\uac00 \uac10\uc18c\ud558\ubbc0\ub85c \uacf5\uae09\ub7c9\uc740 \uc624\ud788\ub824 \uc904\uc5b4\ub4e4\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ube75\uc9d1 \uc8fc\uc778\uc758 \uc774\uc724\uc774 \uc99d\uac00\ud558\uc5ec \uc0dd\uc0b0 \uc124\ube44 \ud22c\uc790\uac00 \ud06c\uac8c \ud655\ub300\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac15\uc81c\uc801\uc778 \uac00\uaca9 \uc778\ud558\ub294 \uc0dd\uc0b0\uc790\uc758 \uc218\uc775\uc131\uc744 \uc545\ud654\uc2dc\ud0a4\ubbc0\ub85c \uc0dd\uc0b0 \ud22c\uc790\ub97c \ucd95\uc18c\uc2dc\ud0a4\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ud310\ub9e4\ub418\uc9c0 \uc54a\uace0 \ub0a8\uc544 \uad6c\ud615\uc774 \ub41c \uc7ac\uace0 \ube75\uc774 \uae09\uc99d\ud558\uc5ec \uc0c1\uc778\ub4e4\uc774 \uc9d1\uc73c\ub85c \ub418\uac00\uc9c0\uace0 \ub3cc\uc544\uac04\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud314\ub9ac\uc9c0 \uc54a\uc740 \ube75 \uc7ac\uace0\uac00 \ub9ce\uc774 \ub0a8\uc544 \uc0c1\uc778\ub4e4\uc774 \uc9d1\uc73c\ub85c \uac00\uc838\uac00\ub294 \ud604\uc0c1\uc740 \ubc95\uc73c\ub85c \ube75\uac12\uc744 \uc778\uc0c1\ud588\uc744 \ub54c \ub098\ud0c0\ub098\ub294 \uacb0\uacfc\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac00\uaca9 \ud1b5\uc81c\ub85c \uc778\ud574 \uc0dd\uc0b0\uc790\uc758 \ud310\ub9e4 \uc720\uc778\uacfc \uc18c\ube44\uc790\uc758 \uad6c\ub9e4 \uc695\uad6c\uac00 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "16\uc138\uae30\ubd80\ud130 18\uc138\uae30 \ucd08\ubc18\uc5d0 \ubc1c\ub2ec\ud55c \uc0c1\uc5c5 \uc790\ubcf8\uc8fc\uc758\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2e0\ud56d\ub85c \uac1c\ucc99\uacfc \uc2e0\ub300\ub959 \ubc1c\uacac\uc73c\ub85c \uc720\ub7fd\uc758 \uad50\uc5ed\ub9dd\uc774 \ud655\uc7a5\ub418\uba74\uc11c \ubc1c\ub2ec\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0c1\uc5c5 \uc790\ubcf8\uc8fc\uc758\ub294 \uc2e0\ud56d\ub85c \uac1c\ucc99 \uc774\ud6c4 \uc138\uacc4 \uad50\uc5ed\ub9dd\uc774 \ud655\ub300\ub418\uace0 \uc0c1\uc5c5\uc774 \ud65c\uc131\ud654\ub418\uba74\uc11c \ubcf8\uaca9\uc801\uc73c\ub85c \ubc1c\uc804\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uae08\uacfc \uc740\uc744 \uad6d\ubd80\uc758 \uc6d0\ucc9c\uc73c\ub85c \ubcf4\uace0 \uc0c1\uc5c5\uacfc \uc218\ucd9c\uc744 \uc7a5\ub824\ud558\ub294 \uc911\uc0c1\uc8fc\uc758 \uc815\ucc45\uc774 \ucd94\uc9c4\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2f9\uc2dc \uc720\ub7fd \uad6d\uac00\ub4e4\uc740 \uae08\u00b7\uc740 \ud655\ubcf4\uc640 \ubb34\uc5ed \uc218\uc9c0 \ud751\uc790\ub97c \uc704\ud574 \uc218\uc785\uc744 \uc5b5\uc81c\ud558\uace0 \uc218\ucd9c\uc744 \uc7a5\ub824\ud558\ub294 \uc911\uc0c1\uc8fc\uc758\ub97c \ud3bc\ucce4\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0c1\ud488\uc758 \uc0dd\uc0b0 \uacfc\uc815\ubcf4\ub2e4\ub294 \uc720\ud1b5 \uacfc\uc815\uc5d0\uc11c \uc774\uc724\uc744 \ucc3d\ucd9c\ud558\ub294 \ud2b9\uc9d5\uc744 \ubcf4\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0c1\uc5c5 \uc790\ubcf8\uc8fc\uc758 \uc2dc\uae30 \uc0c1\uc778\ub4e4\uc740 \uc0c1\ud488\uc744 \uad50\ud658\ud558\uace0 \uc720\ud1b5\ud558\ub294 \uacfc\uc815\uc5d0\uc11c \uc774\uc724\uc744 \uc5bb\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\uc7a5\uc81c \uae30\uacc4 \uacf5\uc5c5\uc744 \ubc14\ud0d5\uc73c\ub85c \ub300\ub7c9 \uc0dd\uc0b0 \uccb4\uc81c\uac00 \uad6c\ucd95\ub418\uc5b4 \ub300\uaddc\ubaa8 \uc0b0\uc5c5 \uc790\ubcf8\uc774 \ucd95\uc801\ub418\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uacf5\uc7a5\uc81c \uae30\uacc4 \uacf5\uc5c5\uacfc \ub300\ub7c9 \uc0dd\uc0b0 \uccb4\uc81c\uc5d0 \uc758\ud55c \uc0b0\uc5c5 \uc790\ubcf8\uc758 \ucd95\uc801\uc740 \uc0c1\uc5c5 \uc790\ubcf8\uc8fc\uc758\uac00 \uc544\ub2cc \uc0b0\uc5c5 \uc790\ubcf8\uc8fc\uc758 \uc2dc\uae30\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0c1\uc5c5 \uc790\ubcf8\uc8fc\uc758\ub294 \uacf5\uc7a5 \ub300\ub7c9 \uc0dd\uc0b0 \uc774\uc804\uc758 \uc2e0\ud56d\ub85c \uac1c\ucc99 \ubc0f \uc911\uc0c1\uc8fc\uc758\uc640 \uad00\ub828\uc774 \uc788\uc2b5\ub2c8\ub2e4."
    },
    {
      "question": "\uc560\ub364 \uc2a4\ubbf8\uc2a4(Smith, A.)\uc758 \uacbd\uc81c \uc0ac\uc0c1 \ubc0f \uc0b0\uc5c5 \uc790\ubcf8\uc8fc\uc758\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc758 \uc774\uae30\uc2ec\uc5d0 \ub530\ub978 \uacbd\uc81c\ud65c\ub3d9\uc774 '\ubcf4\uc774\uc9c0 \uc54a\ub294 \uc190'\uc5d0 \uc758\ud574 \uc0ac\ud68c \uc804\uccb4\uc758 \ubd80\ub97c \uc99d\uc9c4\uc2dc\ud0a8\ub2e4\uace0 \ubcf4\uc558\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc560\ub364 \uc2a4\ubbf8\uc2a4\ub294 \uac1c\uc778\uc774 \uc0ac\uc801 \uc774\uc775\uc744 \ucd94\uad6c\ud558\ub354\ub77c\ub3c4 '\ubcf4\uc774\uc9c0 \uc54a\ub294 \uc190(\uc2dc\uc7a5 \uac00\uaca9 \uba54\ucee4\ub2c8\uc998)'\uc744 \ud1b5\ud574 \ud6a8\uc728\uc801 \uc790\uc6d0 \ubc30\ubd84\uacfc \uc0ac\ud68c\uc801 \uc774\uc775\uc774 \ub2ec\uc131\ub41c\ub2e4\uace0 \ubcf4\uc558\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80\uac00 \uc2dc\uc7a5\uc5d0 \uc801\uadf9 \uac1c\uc785\ud558\uc5ec \ub300\uaddc\ubaa8 \uacf5\uacf5\uc0ac\uc5c5\uc744 \ucd94\uc9c4\ud574\uc57c \ub300\uacf5\ud669\uc744 \uadf9\ubcf5\ud560 \uc218 \uc788\ub2e4\uace0 \uc8fc\uc7a5\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ubd80\uc758 \uc2dc\uc7a5 \uac1c\uc785\uacfc \ub300\uaddc\ubaa8 \uacf5\uacf5\uc0ac\uc5c5 \ucd94\uc9c4\uc744 \uac15\uc870\ud55c \uc778\ubb3c\uc740 \uc218\uc815 \uc790\ubcf8\uc8fc\uc758\ub97c \uc81c\uc548\ud55c \ucf00\uc778\uc2a4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00\uc758 \ubd80\ub97c \uc99d\uc9c4\ud558\uae30 \uc704\ud574\uc11c \uc218\uc785\uc744 \uaddc\uc81c\ud558\uace0 \uad6d\uac00\uac00 \uacbd\uc81c \uc804\ubc18\uc744 \uac15\ub825\ud558\uac8c \ud1b5\uc81c\ud574\uc57c \ud55c\ub2e4\uace0 \ubcf4\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc560\ub364 \uc2a4\ubbf8\uc2a4\ub294 \uad6d\uac00\uc758 \uacfc\ub3c4\ud55c \uac1c\uc785\uacfc \uc218\uc785 \uaddc\uc81c\ub97c \ud2b9\uc9d5\uc73c\ub85c \ud558\ub294 \uc911\uc0c1\uc8fc\uc758 \uc815\ucc45\uc744 \uac15\ub825\ud788 \ube44\ud310\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0 \uc218\ub2e8\uc744 \uc0ac\ud68c\uc801\uc73c\ub85c \uacf5\ub3d9 \uc18c\uc720\ud558\uc5ec \uc18c\ub4dd \ubd84\ubc30\uc758 \ubd88\ud3c9\ub4f1\uc744 \ud574\uacb0\ud558\uace0\uc790 \ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\uc0b0 \uc218\ub2e8\uc758 \uacf5\ub3d9 \uc18c\uc720\ub97c \ud1b5\ud574 \ubd88\ud3c9\ub4f1\uc744 \ud574\uacb0\ud558\uace0\uc790 \ud55c \uac83\uc740 \uc0ac\ud68c\uc8fc\uc758 \uc0ac\uc0c1\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "'\ubcf4\uc774\uc9c0 \uc54a\ub294 \uc190'\uacfc \uc790\uc720\ub85c\uc6b4 \uacbd\uc81c \ud65c\ub3d9\uc744 \uac15\uc870\ud55c \uc790\uc720\ubc29\uc784\uc8fc\uc758 \uc0ac\uc0c1\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc0b0\uc5c5 \ud601\uba85 \uc774\ud6c4 \uc790\ubcf8\uc8fc\uc758\uc758 \ubc1c\uc804 \uacfc\uc815\uc5d0\uc11c \ubc1c\uc0dd\ud55c \uc0ac\ud68c\uc801 \ubd80\uc791\uc6a9 \ubc0f \uc601\ud5a5\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc11d\ud0c4 \ucc44\uad74\uacfc \uac19\uc740 \uc911\ub178\ub3d9\uc5d0 \uc0c1\ub300\uc801\uc73c\ub85c \uccb4\uad6c\uac00 \uc791\uace0 \uc784\uae08\uc774 \uc2fc \uc544\ub3d9\uacfc \uc5ec\uc131\uc774 \ub3d9\uc6d0\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc5c5 \ud601\uba85 \ucd08\uae30\uc5d0\ub294 \ube44\uc6a9 \uc808\uac10\uc744 \uc704\ud574 \uc5f4\uc545\ud55c \ub178\ub3d9 \ud658\uacbd \uc18d\uc5d0 \uc544\ub3d9\uacfc \uc5ec\uc131 \ub178\ub3d9\uc790\uac00 \uad11\ubc94\uc704\ud558\uac8c \ub3d9\uc6d0\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub300\ub7c9 \uc0dd\uc0b0\uc73c\ub85c \ubb3c\uc9c8\uc801 \ud48d\uc694\ub97c \ub204\ub9ac\uac8c \ub418\uc5c8\uc73c\ub098 \uc18c\ub4dd \ubd84\ubc30\uc758 \ubd88\ud3c9\ub4f1\uacfc \ub178\uc0ac \uac08\ub4f1\uc774 \uc2ec\ud654\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc5c5 \uc790\ubcf8\uc8fc\uc758 \ubc1c\ub2ec\ub85c \uc0dd\uc0b0\ub825\uc740 \uc99d\uac00\ud588\uc9c0\ub9cc \ube48\ubd80 \uaca9\ucc28\uc640 \uc790\ubcf8\uac00-\ub178\ub3d9\uc790 \uac04 \uac08\ub4f1\uc774\ub77c\ub294 \uc0ac\ud68c\uc801 \ubb38\uc81c\uac00 \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\ubcf8\uc8fc\uc758\uc758 \ud3d0\ud574\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \uc0dd\uc0b0 \uc218\ub2e8\uc758 \uad6d\uc720\ud654\uc640 \uacc4\ud68d \uacbd\uc81c\ub97c \uac15\uc870\ud558\ub294 \uc0ac\ud68c\uc8fc\uc758 \uc0ac\uc0c1\uc774 \ud655\uc0b0\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc5c5 \ud601\uba85\uae30 \uc790\ubcf8\uc8fc\uc758\uc758 \ubd80\uc791\uc6a9\uc744 \uc804\uba74 \ubd80\uc815\ud558\uba70 \uc815\ubd80\uc758 \uacc4\ud68d\uacfc \uacf5\ub3d9 \uc18c\uc720\ub97c \uc8fc\uc7a5\ud558\ub294 \uc0ac\ud68c\uc8fc\uc758\uac00 \ub300\ub450\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubd80\uc758 \ubcf5\uc9c0 \uc815\ucc45 \uac15\ud654\uc640 \uae30\uc5c5 \uaddc\uc81c \uc644\ud654\ub85c \ub178\ub3d9 \ud658\uacbd\uacfc \uc18c\ub4dd \uaca9\ucc28 \ubb38\uc81c\uac00 \uc989\uac01\uc801\uc73c\ub85c \ud574\uacb0\ub418\uc5c8\ub2e4.",
          "isCorrect": true,
