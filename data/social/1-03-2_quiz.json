{
  "title": "\uc778\uad8c \ubcf4\uc7a5 \ud034\uc988",
  "questions": [
    {
      "question": "\uc138\uacc4 \uc778\uad8c \uc9c0\uc218(Human Rights Index)\ub97c \ud65c\uc6a9\ud558\uc5ec \uad6d\uac00\ubcc4 \uc778\uad8c \ubcf4\uc7a5 \uc0c1\ud669\uc744 \ud30c\uc545\ud560 \ub54c \uc720\uc758\ud574\uc57c \ud560 \ud0dc\ub3c4\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub2e8\uc21c\ud788 \uad6d\uac00 \uac04 \uc21c\uc704 \ube44\uad50\ub97c \ud1b5\ud574 \ud2b9\uc815 \uad6d\uac00\uc758 \uc808\ub300\uc801\uc778 \uc778\uad8c \ubcf4\uc7a5 \uc218\uc900\uc744 \ub2e8\uc815\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e8\uc21c\ud55c \uc21c\uc704 \ube44\uad50\ub9cc\uc73c\ub85c\ub294 \uc9c0\uc218\uc758 \uce21\uc815 \ubc29\uc2dd \ucc28\uc774\ub098 \uad6d\uac00\ubcc4 \uc808\ub300\uc801\uc778 \uc778\uad8c \ubcf4\uc7a5 \uc218\uc900\uc744 \uc624\ud574\ud560 \uc704\ud5d8\uc774 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc22b\uc790\ub85c \uacc4\ub7c9\ud654\ub418\uc5b4 \ub098\ud0c0\ub098\ub294 \uc9c0\uc218\ub9cc\uc744 \uc720\uc77c\ud558\uace0 \uc808\ub300\uc801\uc778 \ud310\ub2e8 \uae30\uc900\uc73c\ub85c \uc0bc\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uce58\ub85c \ud45c\ud604\ub418\uc9c0 \uc54a\ub294 \ud604\uc2e4\uc801\uc778 \uc778\uad8c \ubb38\uc81c\ub97c \uc774\ud574\ud558\uae30 \uc704\ud574\uc11c\ub294 \uce68\ud574 \ub2f9\uc0ac\uc790\uc758 \ubaa9\uc18c\ub9ac\uc5d0 \uadc0 \uae30\uc6b8\uc774\ub294 \ud0dc\ub3c4\uac00 \ud568\uaed8 \ud544\uc694\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac01 \uc778\uad8c \uc9c0\uc218\uc758 \uac1c\ubc1c \ubaa9\uc801\uacfc \uce21\uc815 \ubc29\uc2dd\uc744 \uba85\ud655\ud788 \uc774\ud574\ud55c \ud6c4 \uc218\uce58\ub97c \ud574\uc11d\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc9c0\uc218\uc758 \uac1c\ubc1c \ubaa9\uc801\uacfc \uce21\uc815 \ubc29\uc2dd\uc744 \uc815\ud655\ud788 \uc774\ud574\ud574\uc57c \uc218\uce58\uac00 \uac00\uc9c0\ub294 \uc758\ubbf8\ub97c \uc62c\ubc14\ub974\uac8c \ud310\ub2e8\ud558\uace0 \uc798\ubabb\ub41c \ud574\uc11d\uc744 \ubc29\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uad8c \uc9c0\ud45c\ub294 \uac1c\ubcc4 \uad6d\uac00\uc758 \ub0b4\ubd80 \ubb38\uc81c\uc774\ubbc0\ub85c \ube44\uc815\ubd80 \uae30\uad6c(NGO)\uc758 \uc870\uc0ac \uacb0\uacfc\ub294 \ubc30\uc81c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\uc81c\uae30\uad6c\ubfd0\ub9cc \uc544\ub2c8\ub77c \ube44\uc815\ubd80 \uae30\uad6c(NGO)\ub3c4 \uc778\uad8c \uc2e4\ud0dc\ub97c \ud30c\uc545\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc9c0\uc218\ub97c \uc870\uc0ac\ud558\uace0 \ubc1c\ud45c\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc9c0\uc218\uac00 \uc0b0\ucd9c\ub41c \ubc30\uacbd\uacfc \uce21\uc815 \uae30\uc900\uc744 \ud30c\uc545\ud558\ub294 \uac83\uc774 \uc65c\uace1 \uc5c6\ub294 \ud574\uc11d\uc758 \ucd9c\ubc1c\uc810\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\uc138\uacc4 \uacbd\uc81c \ud3ec\ub7fc(WEF)\uc758 '\uc131 \uaca9\ucc28 \uc9c0\uc218'\uc640 \uad6d\uc81c \uc5f0\ud569 \uac1c\ubc1c \uacc4\ud68d(UNDP)\uc758 '\uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc131 \uaca9\ucc28 \uc9c0\uc218\ub294 \uc218\uce58\uac00 1\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \uc131 \ubd88\ud3c9\ub4f1 \uc815\ub3c4\uac00 \uc2ec\ud568\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc131 \uaca9\ucc28 \uc9c0\uc218\ub294 1\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \uc644\uc804 \ud3c9\ub4f1, 0\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \uc644\uc804 \ubd88\ud3c9\ub4f1\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4."
        },
        {
          "text": "\uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218\ub294 \ub0a8\ub140 \uac04 \uaca9\ucc28\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc5ec\uc131 \ucc98\uc6b0\uc758 \uc808\ub300\uc801 \uc218\uc900\ub3c4 \ubc18\uc601\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218\ub294 \uc0dd\uc0b0\u00b7\uac74\uac15, \uc5ec\uc131 \uad8c\ud55c, \ub178\ub3d9 \ucc38\uc5ec \ub4f1\uc758 \uc9c0\ud45c\ub97c \ud1b5\ud574 \ub0a8\ub140 \uaca9\ucc28\uc640 \uc5ec\uc131 \ucc98\uc6b0\uc758 \uc808\ub300\uc801 \uc218\uc900\uc744 \ud568\uaed8 \ubc18\uc601\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub450 \uc9c0\uc218 \ubaa8\ub450 \uc22b\uc790\uac00 \ucee4\uc9c8\uc218\ub85d \ud3c9\ub4f1\ud55c \uc0c1\ud0dc\ub97c \ub098\ud0c0\ub0b4\ub3c4\ub85d \ub3d9\uc77c\ud55c \uc0b0\ucd9c \uae30\uc900\uc744 \uc801\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc131 \uaca9\ucc28 \uc9c0\uc218\ub294 1\uc77c \ub54c \uc644\uc804 \ud3c9\ub4f1\uc774\uc9c0\ub9cc, \uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218\ub294 0\uc77c \ub54c \uc644\uc804 \ud3c9\ub4f1\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub450 \uc9c0\uc218\uc758 \ud3c9\uac00 \uc601\uc5ed\uacfc \uce21\uc815\ubc29\uc2dd\uc774 \uc644\uc804\ud788 \ub3d9\uc77c\ud558\uc5ec \uad6d\uac00\ubcc4 \uc21c\uc704\uac00 \ud56d\uc0c1 \uc77c\uce58\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac01 \uc9c0\uc218\ubcc4 \ubd80\ubb38 \ubc0f \uce21\uc815 \uc9c0\ud45c\uac00 \ub2e4\ub974\uae30 \ub54c\ubb38\uc5d0 \ub3d9\uc77c\ud55c \uad6d\uac00\ub77c\ub3c4 \ub450 \uc9c0\uc218\uc5d0\uc11c\uc758 \uc21c\uc704\uac00 \ub2e4\ub974\uac8c \ub098\ud0c0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub450 \uc9c0\uc218\ub294 \uce21\uc815 \uae30\uad00\ubfd0\ub9cc \uc544\ub2c8\ub77c \ud3c9\ub4f1 \uc218\uc900\uc744 \ub098\ud0c0\ub0b4\ub294 \uc218\uce58(0\uacfc 1)\uc758 \uc758\ubbf8\uac00 \uc11c\ub85c \ub2e4\ub985\ub2c8\ub2e4."
    },
    {
      "question": "\uc138\uacc4 \uc5ec\ub7ec \uc9c0\uc5ed\uc5d0\uc11c \ub098\ud0c0\ub098\ub294 \uc778\uad8c \ubb38\uc81c \uc0ac\ub840\uc640 \uadf8 \uc591\uc0c1\uc744 \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ud55c \uac83\ub9cc\uc744 \ubcf4\uae30\uc5d0\uc11c \uc788\ub294 \ub300\ub85c \uace0\ub978 \uac83\uc740?\n\n(\uac00) \uc6b0\uac04\ub2e4: \uacbd\ucc30\uc774 \uae38\uac70\ub9ac\uc5d0\uc11c \uc2dc\ubbfc\uc744 \ub9e4\uc9c8\ud568 \u2500\u2500 \uacf5\uad8c\ub825\uc5d0 \uc758\ud55c \uae30\ubcf8\uad8c \uce68\ud574\n(\ub098) \uc2dc\ub9ac\uc544: \ub0b4\uc804\uc73c\ub85c \uace0\ud5a5\uc744 \ub5a0\ub09c \uc8fc\ubbfc\ub4e4\uc774 \uad6c\ud638\ubb3c\uc790\ub97c \ubc1b\uc73c\ub824\uace0 \uc904\uc744 \uc11c \uc788\uc74c \u2500\u2500 \uc804\uc7c1\uacfc \ub0b4\uc804\uc5d0 \ub530\ub978 \ub09c\ubbfc \ubc1c\uc0dd\n(\ub2e4) \ud22c\ubc1c\ub8e8: \uae30\ud6c4\uc704\uae30\ub85c \uc778\ud55c \ud574\uc218\uba74 \uc0c1\uc2b9\uc73c\ub85c \ub9c8\uc744\uc774 \ubb3c\uc5d0 \uc7a0\uae40 \u2500\u2500 \uae30\ud6c4\ubcc0\ud654\uc5d0 \ub530\ub978 \uc778\uad8c \uce68\ud574",
      "answerOptions": [
        {
          "text": "(\uac00), (\ub098)",
          "isCorrect": false,
          "rationale": "(\ub2e4) \uc5ed\uc2dc \uae30\ud6c4\ubcc0\ud654\ub85c \uc778\ud55c \uac70\uc8fc\uad8c \ubc0f \ud658\uacbd\uad8c \uce68\ud574 \uc0ac\ub840\ub85c \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "(\ub098), (\ub2e4)",
          "isCorrect": false,
          "rationale": "(\uac00) \uc0ac\ub840 \ub610\ud55c \uacf5\uad8c\ub825\uc758 \ub0a8\uc6a9\uc73c\ub85c \uc778\ud55c \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c \uce68\ud574\ub85c \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "(\uac00), (\ub2e4)",
          "isCorrect": false,
          "rationale": "(\ub098) \uc0ac\ub840 \ub610\ud55c \ub0b4\uc804\uc73c\ub85c \uc778\ud55c \ub09c\ubbfc \ubc1c\uc0dd \ubb38\uc81c\ub85c \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "(\uac00), (\ub098), (\ub2e4)",
          "isCorrect": true,
          "rationale": "\uc81c\uc2dc\ub41c \uc138 \uac00\uc9c0 \uc0ac\ub840 \ubaa8\ub450 \uacf5\uad8c\ub825 \ub0a8\uc6a9, \ub0b4\uc804 \ub09c\ubbfc, \uae30\ud6c4\ubcc0\ud654 \ub4f1 \uc138\uacc4 \uc778\uad8c \ubb38\uc81c\uc758 \uc8fc\uc694 \uc591\uc0c1\uc744 \uc62c\ubc14\ub974\uac8c \ub098\ud0c0\ub0b4\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac01 \uc9c0\uc5ed\uc5d0\uc11c \ubc1c\uc0dd\ud55c \uc778\uad8c \uce68\ud574\uc758 \uc6d0\uc778\uacfc \uad6c\uccb4\uc801 \ud604\uc0c1\uc744 \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc138\uacc4 \uc778\uad8c \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud55c \ud589\uc704 \uc8fc\uccb4\ubcc4 \ub178\ub825\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uc81c \uc5f0\ud569(UN)\uc740 \uc778\uad8c \ubcf4\uc7a5 \uad00\ub828 \uc758\uc81c\ub97c \ub2e4\ub8e8\uace0 \ud574\ub2f9 \uad6d\uac00\uc5d0 \uac1c\uc120 \uad8c\uace0\uc548\uc744 \uc81c\uc2dc\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "UN\uc740 \ub300\ud45c\uc801\uc778 \uad6d\uc81c\uae30\uad6c\ub85c\uc11c \uc138\uacc4 \uc778\uad8c \uc758\uc81c\ub97c \ub2e4\ub8e8\uace0 \uad8c\uace0\uc548\uc744 \uc81c\uc2dc\ud558\ub294 \uc911\uc694\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ube44\uc815\ubd80 \uae30\uad6c(NGO)\ub294 \uc804\uc7c1\uc774\ub098 \ube48\uace4 \uc9c0\uc5ed\uc744 \uc9c0\uc6d0\ud558\uae30 \uc704\ud574 \ud64d\ubcf4 \ud65c\ub3d9\uc744 \ud558\uac70\ub098 \uae30\uae08\uc744 \uc870\uc131\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube44\uc815\ubd80 \uae30\uad6c\ub294 \ub09c\ubbfc \uad6c\ud638, \uae30\uae08 \ub9c8\ub828, \ud604\uc7a5 \uc9c0\uc6d0 \ub4f1\uc744 \ud1b5\ud574 \uc801\uadf9\uc801\uc73c\ub85c \uc778\uad8c \ubb38\uc81c \ud574\uacb0\uc5d0 \ub3d9\ucc38\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc740 \uc0ac\ud68c \uad00\uacc4\ub9dd \uc11c\ube44\uc2a4(SNS)\uc5d0\uc11c \ud574\uc2dc\ud0dc\uadf8 \ub2ec\uae30, \uc774\ubbf8\uc9c0 \uacf5\uc720 \ub4f1\uc744 \ud1b5\ud574 \uae00\ub85c\ubc8c \uc5f0\ub300\ub97c \uc2e4\ucc9c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uc740 \uc628\ub77c\uc778 \ud50c\ub7ab\ud3fc\uc744 \ud65c\uc6a9\ud574 \uc778\uad8c \uce68\ud574 \ubb38\uc81c\ub97c \uacf5\ub860\ud654\ud558\uace0 \uc138\uacc4\uc2dc\ubbfc\uc73c\ub85c\uc11c \uc5f0\ub300 \uc758\uc2dd\uc744 \ubc1c\ud718\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\ubcc4 \uad6d\uac00\uc758 \uc778\uad8c \uce68\ud574 \ubb38\uc81c\ub294 \uad6d\uac00 \uc8fc\uad8c\uc5d0 \uc18d\ud558\ubbc0\ub85c \uad6d\uc81c \uc0ac\ud68c\uac00 \uacf5\uc870\ud558\uc5ec \ube44\ud310\ud560 \uc218 \uc5c6\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc778\uad8c\uc740 \ubcf4\ud3b8\uc801 \uad8c\ub9ac\uc774\ubbc0\ub85c \ub3c5\uc7ac, \uc778\uc885 \ucc28\ubcc4 \ub4f1\uc73c\ub85c \uae30\ubcf8\uad8c\uc774 \uc2ec\uac01\ud558\uac8c \uce68\ud574\ub420 \ub54c \uad6d\uc81c \uc0ac\ud68c\ub294 \uacf5\uc870\ud558\uc5ec \ube44\ud310 \uc5ec\ub860\uc744 \ud615\uc131\ud558\uace0 \uacbd\uace0\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc778\uad8c\uc740 \ud2b9\uc815 \uad6d\uac00\uc758 \ub0b4\ubd80 \uad00\ud560\uad8c\uc744 \ub118\uc5b4\uc120 \ubcf4\ud3b8\uc801 \uac00\uce58\ub77c\ub294 \uc810\uc744 \uace0\ub824\ud558\uc138\uc694."
    },
    {
      "question": "\uc778\uad8c \ubcf4\uc7a5\uc758 \uc5ed\uc0ac\uc801 \ubc1c\uc804 \uacfc\uc815\uc744 \uc21c\uc11c\ub300\ub85c \uc62c\ubc14\ub974\uac8c \ub098\uc5f4\ud55c \uac83\uc740?\n\n\u3131. \uad6d\uc81c \uc5f0\ud569(UN)\uc758 \uc138\uacc4 \uc778\uad8c \uc120\uc5b8 \ucc44\ud0dd\n\u3134. \ucc28\ud2f0\uc2a4\ud2b8 \uc6b4\ub3d9\uacfc \uc5ec\uc131 \ucc38\uc815\uad8c \uc6b4\ub3d9\uc744 \ud1b5\ud55c \ucc38\uc815\uad8c \ud655\ub300\n\u3137. \ub3c5\uc77c \ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95\uc5d0 \uc0ac\ud68c\uad8c \ucd5c\ucd08 \uba85\uc2dc\n\u3139. \uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc744 \ud1b5\ud55c \uc790\uc720\uad8c\uacfc \ud3c9\ub4f1\uad8c\uc758 \ud655\uc0b0",
      "answerOptions": [
        {
          "text": "\u3139 \u2192 \u3134 \u2192 \u3137 \u2192 \u3131",
          "isCorrect": true,
          "rationale": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85(\uc790\uc720\uad8c\u00b7\ud3c9\ub4f1\uad8c) \u2192 \ucc38\uc815\uad8c \ud655\ub300 \uc6b4\ub3d9 \u2192 \ub3c5\uc77c \ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95(\uc0ac\ud68c\uad8c, 1919\ub144) \u2192 \uc138\uacc4 \uc778\uad8c \uc120\uc5b8(1948\ub144) \uc21c\uc73c\ub85c \ubc1c\uc804\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\u3139 \u2192 \u3137 \u2192 \u3134 \u2192 \u3131",
          "isCorrect": false,
          "rationale": "19\uc138\uae30\ubd80\ud130 \uc2dc\uc791\ub41c \ucc38\uc815\uad8c \ud655\ub300 \uc6b4\ub3d9\uc774 1919\ub144 \ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95 \uc81c\uc815\ubcf4\ub2e4 \uba3c\uc800 \uc77c\uc5b4\ub0ac\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\u3134 \u2192 \u3139 \u2192 \u3137 \u2192 \u3131",
          "isCorrect": false,
          "rationale": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc774 \uc120\ud589\ub41c \ud6c4, \ud601\uba85 \uacfc\uc815\uc5d0\uc11c \uad8c\ub9ac\ub97c \uc5bb\uc9c0 \ubabb\ud55c \uacc4\uce35\uc758 \ucc38\uc815\uad8c \uc6b4\ub3d9\uc774 \ub4f1\uc7a5\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\u3139 \u2192 \u3134 \u2192 \u3131 \u2192 \u3137",
          "isCorrect": false,
          "rationale": "\ub3c5\uc77c \ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95 \uc81c\uc815(1919\ub144)\uc774 \uc138\uacc4 \uc778\uad8c \uc120\uc5b8 \ucc44\ud0dd(1948\ub144)\ubcf4\ub2e4 \uc55e\uc12d\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc790\uc720\uad8c\uacfc \ud3c9\ub4f1\uad8c\uc758 \ud655\ub9bd\uc5d0\uc11c \uc2dc\uc791\ud558\uc5ec \ucc38\uc815\uad8c \ud655\ub300, \uc0ac\ud68c\uad8c \ub4f1\uc7a5, \uad6d\uc81c\uc801 \uc778\uad8c \uc120\uc5b8 \ucc44\ud0dd\uc758 \ud750\ub984\uc744 \uc0c1\uae30\ud558\uc138\uc694."
    },
    {
