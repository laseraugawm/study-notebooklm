      "hint": "\uc6b4\uc804\uc790\uac00 \uc778\uc704\uc801\uc73c\ub85c \uc18d\ub3c4\ub97c \uc904\uc774\ub3c4\ub85d \ub9cc\ub4e0 \ub3c4\ub85c\uc758 \ud615\ud0dc\uc801 \ud2b9\uc9d5\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uac74\ucd95\uac00 \ubc18 \uc2dc\uac8c\ub8e8\uac00 \uc7ac\ud574 \uc9c0\uc5ed \uc774\uc7ac\ubbfc\uacfc \ub09c\ubbfc\uc744 \uc704\ud574 \uce5c\ud658\uacbd \uc885\uc774 \ud29c\ube0c\uc640 \uc885\uc774 \uce78\ub9c9\uc774\ub97c \ud65c\uc6a9\ud558\uc5ec \uc9c0\ucf1c\uc8fc\uace0\uc790 \ud55c \ud575\uc2ec\uc801\uc778 \uae30\ubcf8\uad8c\uc740?",
      "answerOptions": [
        {
          "text": "\uc815\uce58\uc801 \uc758\uc0ac\ub97c \ud45c\ud604\ud558\uace0 \uc120\uac70\uc5d0 \ucc38\uc5ec\ud560 \ucc38\uc815\uad8c",
          "isCorrect": false,
          "rationale": "\uc885\uc774 \uce78\ub9c9\uc774\ub97c \ud1b5\ud55c \uc784\uc2dc \uac70\ucc98 \uacf5\uac04 \ub9c8\ub828\uc740 \ud22c\ud45c\uad8c \ud589\uc0ac \ub4f1\uc758 \ucc38\uc815\uad8c\uacfc \uc9c1\uc811\uc801\uc778 \uad00\ub828\uc774 \uc5c6\ub2e4."
        },
        {
          "text": "\uc7ac\ub09c \ud604\uc7a5\uc5d0\uc11c \uac1c\ubcc4 \uc784\uc2dc \uac70\ucc98\ub97c \uc774\uc6a9\ud558\uba70 \uc0ac\uc0dd\ud65c\uc744 \ubcf4\uc7a5\ubc1b\uc744 \uad8c\ub9ac",
          "isCorrect": true,
          "rationale": "\uc9d1\ub2e8 \ud53c\ub09c\ucc98\uc5d0\uc11c \uc885\uc774 \uce78\ub9c9\uc774\ub97c \uc124\uce58\ud558\uc5ec \ub09c\ubbfc \ubc0f \uc774\uc7ac\ubbfc\ub4e4\uc758 \uc0ac\uc0dd\ud65c \ubcf4\ud638\uc640 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc758 \ud658\uacbd\uc744 \uc81c\uacf5\ud558\uace0\uc790 \ud558\uc600\ub2e4."
        },
        {
          "text": "\ud0c0\uc778\uc5d0\uac8c \uc190\ud574 \ubc30\uc0c1\uc744 \uccad\uad6c\ud558\uc5ec \uc7ac\uc0b0\uc0c1 \uc774\uc775\uc744 \ud655\ubcf4\ud560 \uc7ac\ud310 \uccad\uad6c\uad8c",
          "isCorrect": false,
          "rationale": "\uac74\ucd95 \uacf5\uac04 \uc81c\uacf5\uc740 \uc7ac\ud310 \uccad\uad6c\uad8c \uad6c\uc81c \uc808\ucc28\ub77c\uae30\ubcf4\ub2e4 \uac70\uc8fc \ud658\uacbd \uac1c\uc120\uacfc \uc778\uad8c \ubcf4\ud638\uc758 \uc77c\ud658\uc774\ub2e4."
        },
        {
          "text": "\uacf5\ubb34\uc6d0\uc73c\ub85c \uc784\uc6a9\ub418\uc5b4 \uad6d\uac00 \uae30\uad00\uc758 \uc9c1\ubb34\ub97c \ub2f4\ub2f9\ud560 \uacf5\ubb34\ub2f4\uc784\uad8c",
          "isCorrect": false,
          "rationale": "\uc885\uc774 \uac74\ucd95\ubb3c \uc81c\uacf5\uc740 \uc7ac\ub09c \uad6c\ud638 \ubc0f \ub09c\ubbfc \uc0ac\uc0dd\ud65c \ubcf4\ud638\ub97c \ubaa9\uc801\uc73c\ub85c \ud558\ubbc0\ub85c \uacf5\ubb34\ub2f4\uc784\uad8c\uacfc \ubb34\uad00\ud558\ub2e4."
        }
      ],
      "hint": "\ud53c\ub09c\uc18c\ub098 \uc784\uc2dc \uac70\ucc98\uc5d0\uc11c \uad6c\ud68d\uc744 \ub098\ub204\uc5b4 \uc8fc\uc5c8\uc744 \ub54c \uac1c\uc778\uc774 \ubcf4\ud638\ubc1b\uc744 \uc218 \uc788\ub294 \uc0ac\uc801 \uc601\uc5ed\uc5d0 \ub300\ud574 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ucf5c\ub86c\ube44\uc544 \uba54\ub370\uc778\uc5d0\uc11c \uc2dc\ud589\ub41c '\ub3c4\uc2dc \uce68\uc220' \uae30\ubc18 \ub3c4\uc2dc \uc7ac\uc0dd \uc0ac\uc5c5\uc758 \uc8fc\uc694 \ub0b4\uc6a9 \ubc0f \uc131\uacfc\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uace0\ub9bd\ub41c \uc0b0\ub3d9\ub124 \ube48\ubbfc\uac00\ub97c \ub3c4\uc2ec\uacfc \uc5f0\uacb0\ud558\uae30 \uc704\ud574 \uba54\ud2b8\ub85c \ucf00\uc774\ube14\uc744 \ub3c4\uc785\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uba54\ud2b8\ub85c \ucf00\uc774\ube14\uc744 \ud1b5\ud574 \uc774\ub3d9\uad8c\uc744 \ud655\ubcf4\ud558\uace0 \uace0\ub9bd\ub41c \ube48\ubbfc\uac00\ub97c \ub3c4\uc2ec \uc0dd\ud65c\uad8c\uacfc \uc131\uacf5\uc801\uc73c\ub85c \uc5f0\uacb0\ud558\uc600\ub2e4."
        },
        {
          "text": "\uadfc\uac70\ub9ac \ubb34\uc120\ub9dd(Wi-Fi), \uacf5\uc6d0, \uc6b4\ub3d9\uc7a5, \uacf5\uacf5 \ub3c4\uc11c\uad00 \ub4f1 \uae30\ubc18 \uc2dc\uc124\uc744 \uad6c\ucd95\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb38\ud654\u00b7\uccb4\uc721\u00b7\ud1b5\uc2e0 \uae30\ubc18 \uc2dc\uc124\uc744 \uc870\uc131\ud558\uc5ec \uc2dc\ubbfc\ub4e4\uc758 \uc2dc\uc124 \uc811\uadfc\uc131\uc744 \ud68d\uae30\uc801\uc73c\ub85c \uac1c\uc120\ud558\uc600\ub2e4."
        },
        {
          "text": "\ub3c4\uc2dc \ud658\uacbd \uac1c\uc120 \ubc0f \ubb38\ud654 \uacf5\uac04 \ud655\ucda9\uc744 \ud1b5\ud574 \ubc94\uc8c4\uc728\uc744 \uac10\uc18c\uc2dc\ud0a4\uace0 \uad00\uad11\uc9c0\ub85c \ubcc0\ubaa8\uc2dc\ucf30\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud2b9\uc815 \uc9c0\uc5ed\uc5d0 \ub300\ud55c \uc790\uadf9\uacfc \uc778\ud504\ub77c \uad6c\ucd95\uc73c\ub85c \uc6b0\ubc94\uc9c0\uc5ed\uc774\ub358 \ub3c4\uc2dc\uc758 \ubc94\uc8c4\uac00 \uc904\uc5b4\ub4e4\uace0 \ubc29\ubb38\uac1d\uc774 \ucc3e\ub294 \uacf5\uac04\uc774 \ub418\uc5c8\ub2e4."
        },
        {
          "text": "\ube48\ubbfc\uac00 \uc804\uc5ed\uc744 \uc804\uba74 \ucca0\uac70\ud558\uace0 \uace0\uac00\uc758 \ubbfc\uac04 \uc720\ub8cc \uc8fc\ud0dd \ub2e8\uc9c0\ub85c \uc804\ub7c9 \ub300\uccb4\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uba54\ub370\uc778\uc758 \ub3c4\uc2dc \uce68\uc220\uc740 \uc8fc\ubbfc\uc744 \ubab0\uc544\ub0b4\ub294 \uc804\uba74 \ucca0\uac70 \ubc29\uc2dd\uc774 \uc544\ub2c8\ub77c, \uae30\uc874 \ub9c8\uc744\uc5d0 \ud544\uc694\ud55c \uae30\ubc18 \uc2dc\uc124\uacfc \uacf5\uacf5 \uac74\ucd95\ubb3c\uc744 \uacf5\uae09\ud558\uc5ec \uc790\uc0dd\ub825\uc744 \ub192\uc778 \ub3c4\uc2dc \uc7ac\uc0dd \ubc29\uc2dd\uc774\ub2e4."
        }
      ],
      "hint": "\ub3c4\uc2dc \uce68\uc220\uc774 \uae30\uc874 \uc8fc\ubbfc\ub4e4\uc758 \uc0dd\ud65c \uae30\ubc18 \uc2dc\uc124 \uc811\uadfc\uc131\uc744 \ub192\uc774\ub294 \ubc29\uc2dd\uc774\uc5c8\ub294\uc9c0, \ucca0\uac70 \ubc29\uc2dd\uc774\uc5c8\ub294\uc9c0 \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ubaa8\ub4e0 \uc5b4\ub9b0\uc774\uac00 \uc790\uc720\ub86d\uac8c \uc774\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uc870\uc131\ub41c '\ubb34\uc7a5\uc560 \ub180\uc774\ud130'\uc758 \uc8fc\uc694 \uac74\ucd95\uc801 \ud2b9\uc9d5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5b4\ub9b0\uc774\ub4e4\uc758 \uc2e0\uccb4 \ub2e8\ub828\uc744 \uc704\ud574 \ub180\uc774\uae30\uad6c \uc9c4\uc785\ub85c\uc5d0 \uacc4\ub2e8\ub9cc\uc744 \uc9d1\uc911\uc801\uc73c\ub85c \ubc30\uce58\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacc4\ub2e8\uc740 \ud720\uccb4\uc5b4\ub97c \uc774\uc6a9\ud558\ub294 \uc7a5\uc560 \uc5b4\ub9b0\uc774\uc758 \uc811\uadfc\uc744 \ub9c9\ub294 \uc7a5\ud574\ubb3c\uc774 \ub418\ubbc0\ub85c \uacc4\ub2e8 \ub300\uc2e0 \uacbd\uc0ac\ub85c\ub97c \ud65c\uc6a9\ud55c\ub2e4."
        },
        {
          "text": "\uacc4\ub2e8 \ub300\uc2e0 \uc644\ub9cc\ud55c \uacbd\uc0ac\ub85c\ub97c \uc124\uce58\ud558\uace0, \ud720\uccb4\uc5b4\ub97c \ud0c4 \ucc44 \ud0d1\uc2b9 \uac00\ub2a5\ud55c \ub180\uc774\uae30\uad6c\ub97c \uac16\ucd94\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc7a5\uc560 \uc5ec\ubd80\uc640 \uc0c1\uad00\uc5c6\uc774 \ub204\uad6c\ub098 \ub180\uc774\uae30\uad6c\uc5d0 \uc811\uadfc\ud558\uace0 \uc774\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uc644\ub9cc\ud55c \uacbd\uc0ac\ub85c\uc640 \ub9de\ucda4\ud615 \ub180\uc774\uae30\uad6c\ub97c \uc124\uce58\ud558\uc600\ub2e4."
        },
        {
          "text": "\uc7a5\uc560 \uc5b4\ub9b0\uc774\uc640 \ube44\uc7a5\uc560 \uc5b4\ub9b0\uc774\uac00 \uc0ac\uc6a9\ud558\ub294 \uad6c\uc5ed\uc744 \ub192\uc740 \uc6b8\ud0c0\ub9ac\ub85c \uc5c4\uaca9\ud788 \ubd84\ub9ac\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb34\uc7a5\uc560 \ub180\uc774\ud130\ub294 \uc7a5\uc560 \uc720\ubb34\uc640 \uad00\uacc4\uc5c6\uc774 '\ubaa8\ub4e0' \uc5b4\ub9b0\uc774\uac00 \ud568\uaed8 \uc5b4\uc6b8\ub824 \ub180 \uc218 \uc788\ub3c4\ub85d \ud1b5\ud569\ub41c \ud658\uacbd\uc744 \uc9c0\ud5a5\ud55c\ub2e4."
        },
        {
          "text": "\uc548\uc804\uc0ac\uace0 \ubc29\uc9c0\ub97c \ubaa9\uc801\uc73c\ub85c \uc6c0\uc9c1\uc774\ub294 \ub180\uc774\uae30\uad6c\ub97c \ubaa8\ub450 \uc5c6\uc560\uace0 \ub2e8\uc21c \ud3c9\uc9c0\ub9cc \uc81c\uacf5\ud558\uc600\ub2e4.",
