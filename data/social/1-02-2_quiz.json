    {
      "type": "multiple_choice",
      "question": "\uc5b4\ub9b0\uc774 \ud1b5\ud559\ub85c \uac1c\uc120\uc744 \uc704\ud55c '\uadf8\ub9b0\ub85c\ub4dc' \ud504\ub85c\uc81d\ud2b8 \uc0ac\ub840\uac00 \uc2dc\uc0ac\ud558\ub294 \uc2dc\ubbfc \ucc38\uc5ec\uc758 \ud2b9\uc9d5\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\uc5ed \uc0ac\ud68c\uc758 \uc2dc\ubbfc \ub2e8\uccb4\uc640 \uc5b4\ub9b0\uc774\ub4e4\uc774 \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud55c \ucea0\ud398\uc778\uc744 \uc8fc\ub3c4\uc801\uc73c\ub85c \uc2dc\uc791\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ucfe8 \uc874 \ub0b4 \ubcf4\ud589 \uc548\uc804 \uc704\ud611 \ubb38\uc81c\uc5d0 \ub300\ud574 \uc2dc\ubbfc \ub2e8\uccb4\uc640 \ub2f9\uc0ac\uc790\uc778 \uc5b4\ub9b0\uc774\ub4e4\uc774 \ucea0\ud398\uc778 \ud65c\ub3d9\uc744 \ud3bc\ucce4\ub2e4."
        },
        {
          "text": "\uc9c0\ubc29 \uc790\uce58 \ub2e8\uccb4, \uad50\uc721\uccad, \uacbd\ucc30\uc11c, \uc9c0\uc5ed \uc5b8\ub860, \ub300\ud559 \ub4f1 \ub2e4\uc591\ud55c \uc8fc\uccb4\uc758 \uac70\ubc84\ub10c\uc2a4 \ud615\uc131\uc744 \uc774\ub04c\uc5b4\ub0c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\ubbfc\ub4e4\uc758 \uc81c\uae30\uc5d0\uc11c \ucd9c\ubc1c\ud558\uc5ec \uc9c0\uc5ed\uc758 \uc5ec\ub7ec \uacf5\uacf5 \uae30\uad00 \ubc0f \ubbfc\uac04 \uae30\uad00\uc774 \ud504\ub85c\uc81d\ud2b8\uc5d0 \ud568\uaed8 \ucc38\uc5ec\ud558\uc600\ub2e4."
        },
        {
          "text": "\uc2dc\ubbfc\ub4e4\uc758 \uc790\ubc1c\uc801 \ucc38\uc5ec \ud65c\ub3d9\uc774 \uacf5\uacf5 \ubb38\uc81c \ud574\uacb0\uacfc \uc548\uc804\ud55c \uc0dd\ud65c \ud658\uacbd \uc870\uc131\uc73c\ub85c \uc5f0\uacb0\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucea0\ud398\uc778\uc774\ub77c\ub294 \ud569\ubc95\uc801 \uc2dc\ubbfc \ucc38\uc5ec \ubc29\uc548\uc744 \ud1b5\ud574 \uc2e4\uc81c \uc5b4\ub9b0\uc774 \ud1b5\ud559\ub85c\uc758 \uc2e4\uc9c8\uc801 \uac1c\uc120\uc744 \ub2ec\uc131\ud558\uc600\ub2e4."
        },
        {
          "text": "\uc2dc\ubbfc\ub4e4\uc774 \ud5cc\ubc95\uc7ac\ud310\uc18c\uc5d0 \ud5cc\ubc95\uc18c\uc6d0 \uc2ec\ud310\uc744 \uccad\uad6c\ud558\uc5ec \ud1b5\ud559\ub85c \uad00\ub828 \ubc95\ub960\uc758 \uc704\ud5cc \ud310\uacb0\uc744 \uc5bb\uc5b4\ub0c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\ub8cc\uc5d0 \uc18c\uac1c\ub41c \uadf8\ub9b0\ub85c\ub4dc \ud504\ub85c\uc81d\ud2b8\ub294 \ud5cc\ubc95\uc18c\uc6d0\uc774 \uc544\ub2cc \uc9c0\uc5ed \ucea0\ud398\uc778 \ubc0f \ub2e4\uae30\uad00 \ud611\ub825\uc744 \ud1b5\ud574 \ubb38\uc81c\ub97c \ud574\uacb0\ud55c \uc0ac\ub840\uc774\ub2e4."
        }
      ],
      "hint": "\uc2a4\ucfe8 \uc874 \uc548\uc804 \ubb38\uc81c \ud574\uacb0 \uacfc\uc815\uc5d0\uc11c \uc0ac\uc6a9\ub41c \uc2dc\ubbfc \ucc38\uc5ec \uc218\ub2e8\uc774 \ud5cc\ubc95 \uc7ac\ud310\uc774\uc5c8\ub294\uc9c0, \ubbfc\uad00 \ud611\ub825 \ucea0\ud398\uc778\uc774\uc5c8\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uace0\ub839\uc790\uc758 \uc778\uad8c \ubc0f \ubcf4\ud589 \uc548\uc804 \ubcf4\ud638\ub97c \uc704\ud574 \uc2f1\uac00\ud3ec\ub974\uc5d0\uc11c \uc801\uc6a9\ud55c '\uc2e4\ubc84 \uc874(Silver Zone)'\uc758 \ub3c4\uc2dc \uc124\uacc4 \ubc29\uc2dd\uc740?",
      "answerOptions": [
        {
          "text": "\ucc28\ub3c4\ub97c \ub113\uace0 \uc9c1\uc120\uc73c\ub85c \uac1c\uc124\ud558\uc5ec \ucc28\ub7c9\uc758 \uc6b4\ud589 \uc18d\ub3c4\ub97c \ub192\uc774\ub3c4\ub85d \ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c1\uc120 \ub3c4\ub85c \ud655\ucda9\uc740 \uc6b4\ud589 \uc18d\ub3c4\ub97c \ub192\uc5ec \ubcf4\ud589\uc790\uc758 \uc548\uc804\uc744 \uc704\ud611\ud558\ubbc0\ub85c \uc2e4\ubc84 \uc874\uc758 \ubaa9\uc801\uc5d0 \uc704\ubc30\ub41c\ub2e4."
        },
        {
          "text": "\ucc28\ub3c4\ub97c \uc881\uace0 \uad6c\ubd88\uad6c\ubd88\ud558\uac8c \uc124\uacc4\ud558\uc5ec \uc6b4\uc804\uc790\uac00 \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc11c\ud589\ud558\ub3c4\ub85d \ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2f1\uac00\ud3ec\ub974\ub294 \uc778\uc9c0 \ub2a5\ub825\uc774 \ub0ae\uac70\ub098 \uac70\ub3d9\uc774 \ubd88\ud3b8\ud55c \uc5b4\ub974\uc2e0\uc744 \uc704\ud574 \ubb3c\ub9ac\uc801 \ub3c4\ub85c \uad6c\uc870\ub97c \uad6c\ubd88\uad6c\ubd88\ud558\uac8c \ub9cc\ub4e4\uc5b4 \uc790\ub3d9 \uac10\uc18d\uc744 \uc720\ub3c4\ud558\uc600\ub2e4."
        },
        {
          "text": "\ub178\uc778\uc758 \uc57c\uac04 \uc678\ucd9c\uc744 \ubc95\uc801\uc73c\ub85c \uc81c\ud55c\ud558\ub294 \uc57c\uac04 \ud1b5\ud589\uae08\uc9c0 \uad6c\uc5ed\uc744 \uc124\uc815\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e4\ubc84 \uc874\uc740 \ub178\uc778\uc758 \uc774\ub3d9\uacfc \uad8c\ub9ac\ub97c \ubcf4\ud638\ud558\uae30 \uc704\ud55c \uce5c\ud654\uc801 \ub3c4\uc2dc \uc124\uacc4\uc774\uc9c0 \uc2e0\uccb4\uc758 \uc790\uc720\ub97c \uc81c\ud55c\ud558\ub294 \uc815\ucc45\uc774 \uc544\ub2c8\ub2e4."
        },
        {
          "text": "\ubcf4\ud589 \uc2e0\ud638\ub4f1\uc744 \uc81c\uac70\ud558\uace0 \ubaa8\ub4e0 \ubcf4\ud589\uc790\uac00 \uc721\uad50\ub9cc\uc744 \uc774\uc6a9\ud558\ub3c4\ub85d \uac15\uc81c\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac70\ub3d9\uc774 \ubd88\ud3b8\ud55c \ub178\uc778\uc5d0\uac8c \uc721\uad50 \uc774\uc6a9\uc744 \uac15\uc81c\ud558\ub294 \uac83\uc740 \ubcf4\ud589\uad8c\uc744 \uc800\ud574\ud558\ubbc0\ub85c \uace0\ub839 \uce5c\ud654\uc801 \uc124\uacc4\uc640 \uac70\ub9ac\uac00 \uba40\ub2e4."
        }
