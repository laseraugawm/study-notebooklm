{
  "title": "\uc778\uad8c\uacfc\uc2dc\ubbfc\ucc38\uc5ec \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ud5cc\ubc95 \ubc0f \uc81c\ub3c4\uc801 \uc7a5\uce58\uc640 \uc2dc\ubbfc \ucc38\uc5ec\uc758 \uad00\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud5cc\ubc95\uc5d0 \uc778\uad8c \ubcf4\uc7a5\uc744 \uc704\ud55c \uc81c\ub3c4\uc801 \uc7a5\uce58\uac00 \uba85\uc2dc\ub418\uc5b4 \uc788\ub2e4\uba74 \uc2dc\ubbfc\ub4e4\uc758 \ubcc4\ub3c4 \ucc38\uc5ec \uc5c6\uc774\ub3c4 \uc778\uad8c\uc774 \uc800\uc808\ub85c \ubcf4\uc7a5\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud5cc\ubc95\uc5d0 \uc81c\ub3c4\uc801 \uc7a5\uce58\uac00 \uc9c0\uc815\ub418\uc5b4 \uc788\ub354\ub77c\ub3c4 \uc2dc\ubbfc\ub4e4\uc758 \uc801\uadf9\uc801\uc778 \ucc38\uc5ec\uc640 \uc778\uad8c \uc758\uc2dd\uc774 \uc218\ubc18\ub418\uc9c0 \uc54a\uc73c\uba74 \uc778\uad8c\uc774 \uc81c\ub300\ub85c \ubcf4\uc7a5\ub418\uae30 \uc5b4\ub835\ub2e4."
        },
        {
          "text": "\uc2dc\ubbfc \ucc38\uc5ec\ub294 \uc120\uac70\ub97c \ud1b5\ud574 \uc815\ubb34\uc9c1 \uacf5\ubb34\uc6d0\uc744 \uc120\ucd9c\ud558\ub294 \ud589\uc704\uc5d0\ub9cc \ud55c\uc815\ub418\uba70 \uc77c\ubc18\uc801\uc778 \uc0ac\ud68c \ubb38\uc81c \uac1c\uc785\uc740 \uc81c\uc678\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\ubbfc \ucc38\uc5ec\ub294 \uc120\uac70\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc2dc\uc704, \uc11c\uba85 \uc6b4\ub3d9, \uacf5\uccad\ud68c, \uccad\uc6d0, \ucea0\ud398\uc778 \ub4f1 \uc0ac\ud68c\uc758 \uacf5\uacf5 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud55c \ub2e4\uc591\ud55c \ud65c\ub3d9\uc744 \ud3ec\uad04\ud55c\ub2e4."
        },
        {
          "text": "\uc2dc\ubbfc\ub4e4\uc774 \uc778\uad8c \uc758\uc2dd\uc744 \ubc14\ud0d5\uc73c\ub85c \uad6d\uac00 \uae30\uad00\uc758 \uc815\ucc45 \uacb0\uc815\uc774\ub098 \uc0ac\ud68c\uc801 \ubb38\uc81c \ud574\uacb0\uc5d0 \uc801\uadf9\uc801\uc73c\ub85c \uac1c\uc785\ud560 \ub54c \uc2e4\uc9c8\uc801\uc778 \uad8c\uc775 \ubcf4\ud638\uac00 \uc774\ub8e8\uc5b4\uc9c4\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2dc\ubbfc \ucc38\uc5ec\ub294 \uad6d\uac00 \uad8c\ub825\uc758 \ub0a8\uc6a9\uc744 \uacac\uc81c\ud558\uace0 \uc798\ubabb\ub41c \uc81c\ub3c4\ub098 \ubc95\ub960\uc744 \uac1c\uc120\ud568\uc73c\ub85c\uc368 \uc2dc\ubbfc\uc758 \uad8c\uc775\uc744 \uc9c0\ud0a4\ub294 \ud575\uc2ec\uc801\uc778 \ub3d9\uc778\uc774\ub2e4."
        },
        {
          "text": "\uc2dc\ubbfc \ucc38\uc5ec\uc758 \uc8fc\uc694 \ubaa9\uc801\uc740 \uac1c\ubcc4 \uc9d1\ub2e8\uc774 \uc18c\uc218\uc758 \uc0ac\uc801 \uc774\uc775\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uad6d\uac00 \uad8c\ub825\uc744 \ud65c\uc6a9\ud558\ub294 \ub370 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\ubbfc \ucc38\uc5ec\ub294 \uc0ac\uc801 \uc774\uc775 \ub3c5\uc810\uc774 \uc544\ub2c8\ub77c \uc2dc\ubbfc\uc758 \uad8c\uc775 \ubcf4\ud638, \uacf5\uacf5 \ubb38\uc81c \ud574\uacb0, \uc0ac\ud68c \uc815\uc758 \uc2e4\ud604\uc744 \ubaa9\uc801\uc73c\ub85c \ud55c\ub2e4."
        }
      ],
      "hint": "\uc81c\ub3c4\uc801 \uba85\ubb38\ud654\ub9cc\uc73c\ub85c \uc778\uad8c\uc774 \uc790\ub3d9 \uc2e4\ud604\ub418\ub294\uc9c0, \uadf8\ub9ac\uace0 \uc2dc\ubbfc\uc758 \uc5ed\ud560\uc774 \ubb34\uc5c7\uc778\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "2012\ub144 \uc218\uc0ac \uae30\uad00\uc758 \uac1c\uc778\uc815\ubcf4 \uc218\uc9d1\uc5d0 \ub300\uc751\ud55c \uc2dc\ubbfc\ub4e4\uc758 \uad8c\uc775 \ubcf4\ud638 \uc0ac\ub840\uc5d0 \ub300\ud55c \ubd84\uc11d\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc218\uc0ac \uae30\uad00\uc774 \ubc95\uc6d0\uc758 \uc601\uc7a5\uc774\ub098 \ud5c8\uac00 \uc5c6\uc774 \uc774\uc6a9\uc790 \uac1c\uc778\uc815\ubcf4\ub97c \uc218\uc9d1\ud558\uba74\uc11c \uad8c\uc775 \uce68\ud574 \ub17c\ub780\uc774 \ubd88\uac70\uc84c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2f9\uc2dc \uc601\uc7a5\uc774\ub098 \ud5c8\uac00 \uc5c6\ub294 \uc815\ubcf4 \uc218\uc9d1\uc758 \uae09\uc99d\uc73c\ub85c \uc778\ud574 \uc2dc\ubbfc\ub4e4\uc758 \uac1c\uc778\uc815\ubcf4 \uce68\ud574 \uc6b0\ub824\uc640 \ub17c\ub780\uc774 \uc2e4\uc81c \ubc1c\uc0dd\ud558\uc600\ub2e4."
        },
        {
          "text": "\uc2dc\ubbfc \ub2e8\uccb4\uc640 \uc2dc\ubbfc\ub4e4\uc740 \uac1c\uc778\uc815\ubcf4\uac00 \uc218\uc0ac \uae30\uad00\uc5d0 \uc81c\uacf5\ub41c \uc0ac\uc2e4\uc744 \ub2f9\uc0ac\uc790\uc5d0\uac8c \ud1b5\ubcf4\ud558\uc9c0 \uc54a\uc740 \uc810\uc744 \ubb38\uc81c \uc0bc\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ubcf4 \uc8fc\uccb4\uc778 \uc2dc\ubbfc\uc774 \uc790\uc2e0\uc758 \uc815\ubcf4 \uc81c\uacf5 \uc5ec\ubd80\ub97c \uc54c\uc9c0 \ubabb\ud574 \uad8c\uc775\uc744 \uce68\ud574\ub2f9\ud588\ub2e4\ub294 \uc810\uc774 \ud575\uc2ec \uc8fc\uc7a5\uc774\uc5c8\ub2e4."
        },
        {
          "text": "2\uc2ec \uc7ac\ud310\ubd80\ub294 \uac1c\uc778\uc815\ubcf4 \uc81c\uacf5 \ud604\ud669 \uacf5\uac1c\ub97c \uac70\ubd80\ud55c \uc774\ub3d9 \ud1b5\uc2e0\uc0ac\uc758 \ud589\uc704\uac00 \ubd88\ubc95\uc774\ub77c\uace0 \ud310\uacb0\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\ubbfc\ub4e4\uc774 \uc81c\uae30\ud55c \uc190\ud574 \ubc30\uc0c1 \uc18c\uc1a1 \uacb0\uacfc, \uc774\uc6a9\uc790\uc758 \uc815\ubcf4 \uc81c\uacf5 \ud604\ud669 \uacf5\uac1c \uc694\uccad\uc744 \uac70\ubd80\ud55c \ud1b5\uc2e0\uc0ac\uc758 \ud589\uc704\ub294 \ubd88\ubc95\uc73c\ub85c \ud310\uc2dc\ub418\uc5c8\ub2e4."
        },
        {
          "text": "\uc2dc\ubbfc\ub4e4\uc740 \ubc95\uc801\uc778 \uc18c\uc1a1 \uc808\ucc28\ub97c \uac70\uce58\uc9c0 \uc54a\uace0 \uc774\ub3d9 \ud1b5\uc2e0 \uc2dc\uc124\uc744 \ubb3c\ub9ac\uc801\uc73c\ub85c \uc810\uac70\ud558\ub294 \ubd88\ubc95 \ud589\ub3d9\ub9cc\uc744 \uc804\uac1c\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubcf8 \uc0ac\ub840\uc5d0\uc11c \uc2dc\ubbfc\ub4e4\uc740 \uc190\ud574 \ubc30\uc0c1 \uc18c\uc1a1 \ucea0\ud398\uc778\uc744 \ubc8c\uc774\uace0 \uc774\ub3d9 \ud1b5\uc2e0\uc0ac\ub97c \uc0c1\ub300\ub85c \uc815\ub2f9\ud55c \ubc95\uc801 \uc18c\uc1a1\uc744 \uc81c\uae30\ud558\uc5ec \uad8c\ub9ac\ub97c \uad6c\uc81c\ubc1b\uc558\ub2e4."
        }
      ],
      "hint": "\uc2dc\ubbfc\ub4e4\uc774 \uc790\uc2e0\uc758 \uad8c\ub9ac\ub97c \uc9c0\ud0a4\uae30 \uc704\ud574 \uc120\ud0dd\ud55c \ud569\ubc95\uc801\uc778 \ucc38\uc5ec\uc640 \ub300\uc751 \uc218\ub2e8\uc774 \ubb34\uc5c7\uc774\uc5c8\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc874 \ub864\uc2a4(J. Rawls)\uac00 \uc81c\uc2dc\ud55c '\uc2dc\ubbfc\ubd88\ubcf5\uc885'\uc758 \uc815\ub2f9\ud654 \uc870\uac74\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uccb4\uc81c \uc790\uccb4\uc758 \uc804\ubcf5\uacfc \ubc95\uc9c8\uc11c\uc758 \uc644\uc804\ud55c \ud30c\uad34\ub97c \ucd5c\uc6b0\uc120 \ubaa9\ud45c\ub85c \uc0bc\uc544\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\ubbfc\ubd88\ubcf5\uc885\uc740 \uae30\uc874 \ubc95\uc9c8\uc11c\ub97c \uc804\uba74 \ubd80\uc815\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ubc95\uc5d0 \ub300\ud55c \ucda9\uc2e4\uc131\uc758 \ud55c\uacc4 \ub0b4\uc5d0\uc11c \ud2b9\uc815 \ubd88\uc758\ud55c \ubc95\uc774\ub098 \uc815\ucc45\uc744 \ubc14\ub85c\uc7a1\uace0\uc790 \ud558\ub294 \ud589\uc704\uc774\ub2e4."
        },
        {
          "text": "\ud569\ubc95\uc801\uc778 \uc218\ub2e8\uc73c\ub85c\ub294 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc5b4\ub824\uc6b8 \ub54c \uc120\ud0dd\ud558\ub294 \ucd5c\ud6c4\uc758 \uc218\ub2e8\uc774\uc5b4\uc57c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud569\ubc95\uc801\uc778 \uc81c\ub3c4\uc801 \uc808\ucc28\ub85c \uc778\uad8c \uce68\ud574\ub098 \ubd80\ub2f9\ud568\uc744 \ud574\uacb0\ud560 \uc218 \uc5c6\ub294 \uc815\ub2f9\ud55c \uc0c1\ud669\uc5d0\uc11c \ucd5c\ud6c4\uc758 \uc218\ub2e8\uc73c\ub85c \ud589\uc0ac\ub418\uc5b4\uc57c \uc815\ub2f9\uc131\uc744 \uc5bb\ub294\ub2e4."
        },
        {
          "text": "\ubaa9\uc801\uc758 \uc815\ub2f9\uc131\uc744 \uc785\uc99d\ud558\uae30 \uc704\ud574 \uc758\ub3c4\uc801\uc73c\ub85c \ud3ed\ub825\uc801\uc778 \uc218\ub2e8\uc744 \ub3d9\uc6d0\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub864\uc2a4\uc5d0 \ub530\ub974\uba74 \uc2dc\ubbfc\ubd88\ubcf5\uc885 \ud589\uc704\ub294 \ube44\ud3ed\ub825\uc801\uc774\uc5b4\uc57c \ud55c\ub2e4\ub294 \uc815\ub2f9\uc131 \uc694\uac74\uc744 \uac16\ucd94\uc5b4\uc57c \ud55c\ub2e4."
        },
        {
          "text": "\uc758\ub3c4\uc801\uc778 \uc704\ubc95 \ud589\uc704\uc5d0 \ub530\ub77c \ubd80\uacfc\ub418\ub294 \ucc98\ubc8c\uc774\ub098 \ubc95\uc801 \ubd88\uc774\uc775\uc744 \uac70\ubd80\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\ubbfc\ubd88\ubcf5\uc885\uc740 \ubc95\uc5d0 \ub300\ud55c \uc874\uc911\uacfc \uc815\uc758\uad00\uc5d0 \ubc14\ud0d5\uc744 \ub450\ubbc0\ub85c \ubd88\ubc95 \ud589\uc704\uc5d0 \ub530\ub978 \ucc98\ubc8c\uacfc \uc81c\uc7ac\ub97c \uac10\uc218\ud558\ub294 \ud0dc\ub3c4\ub97c \ubcf4\uc5ec\uc57c \ud55c\ub2e4."
        }
      ],
      "hint": "\uc2dc\ubbfc\ubd88\ubcf5\uc885\uc774 \uc77c\ubc18 \ubc94\uc8c4 \ud589\uc704\ub098 \ud601\uba85\uacfc \uad6c\ubd84\ub418\ub294 \uc815\ub2f9\uc131 \uc694\uac74 \ubc0f \ubc95\uc5d0 \ub300\ud55c \ucda9\uc2e4\uc131\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \ud5cc\ubc95\uc0c1 \uae30\ubcf8\uad8c\uc758 \uc885\ub958\uc640 \uadf8 \uc608\uc2dc\uac00 \ubc14\ub974\uac8c \uc5f0\uacb0\ub41c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc720\uad8c \u2014 \uc120\uac70\uad8c, \uacf5\ubb34\ub2f4\uc784\uad8c",
          "isCorrect": false,
          "rationale": "\uc120\uac70\uad8c\uacfc \uacf5\ubb34\ub2f4\uc784\uad8c\uc740 \uad6d\ubbfc\uc774 \uc815\uce58 \uacfc\uc815\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\ub294 \ucc38\uc815\uad8c\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\ucc38\uc815\uad8c \u2014 \uad50\uc721\uc744 \ubc1b\uc744 \uad8c\ub9ac, \uadfc\ub85c\uc758 \uad8c\ub9ac",
          "isCorrect": false,
          "rationale": "\uad50\uc721\uc744 \ubc1b\uc744 \uad8c\ub9ac\uc640 \uadfc\ub85c\uc758 \uad8c\ub9ac\ub294 \uc778\uac04\ub2e4\uc6b4 \uc0dd\ud65c \ubcf4\uc7a5\uc744 \uc694\uad6c\ud558\ub294 \uc0ac\ud68c\uad8c\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uad8c \u2014 \uc2e0\uccb4\uc758 \uc790\uc720, \uc591\uc2ec\uc758 \uc790\uc720",
          "isCorrect": false,
          "rationale": "\uc2e0\uccb4\uc758 \uc790\uc720\uc640 \uc591\uc2ec\uc758 \uc790\uc720\ub294 \uad6d\uac00\uc758 \uac04\uc12d\uc744 \ubc1b\uc9c0 \uc54a\uc744 \uc790\uc720\uad8c\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\ucc38\uc815\uad8c \u2014 \uc120\uac70\uad8c, \uacf5\ubb34\ub2f4\uc784\uad8c",
          "isCorrect": true,
          "rationale": "\uad6d\uac00\uc758 \uc815\uce58 \uacb0\uc815 \uacfc\uc815\uc5d0 \uc8fc\uad8c\uc790\ub85c\uc11c \ucc38\uc5ec\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\ub294 \ucc38\uc815\uad8c\uc758 \ub300\ud45c\uc801 \uc608\uc2dc\uc774\ub2e4."
        }
      ],
      "hint": "\uad6d\uac00\uc5d0\uc758 \ucc38\uc5ec, \uad6d\uac00\ub85c\ubd80\ud130\uc758 \uc790\uc720, \uad6d\uac00\uc5d0 \uc758\ud55c \uae09\ubd80\ub97c \uc694\uad6c\ud558\ub294 \uad8c\ub9ac\uc758 \uad6c\ubd84\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc5b4\ub9b0\uc774 \ucd9c\uc785 \uc81c\ud55c \uacf5\uac04(\ub178\ud0a4\uc988\uc874) \uaddc\uc81c\uc5d0 \uad00\ud55c \ub17c\uc758\uc5d0\uc11c, \uc9c0\uc815 \uae08\uc9c0 \uc870\ub840 \uc81c\uc815\uc744 \uc694\uad6c\ud558\ub294 \uc2dc\ubbfc\ub4e4\uc758 \uc8fc\uc694 \ub17c\uac70\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud2b9\uc815 \uc5f0\ub839\ub300 \uace0\uac1d\uc758 \uc785\uc7a5 \uc790\uccb4\ub97c \uc804\uba74 \uac70\ubd80\ud558\ub294 \uac83\uc740 \ubd88\ud569\ub9ac\ud55c \ucc28\ubcc4\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc5b4\ub9b0\uc774\ub77c\ub294 \uc774\uc720\ub9cc\uc73c\ub85c \ubbfc\uac04 \uacf5\uac04\uc758 \uc785\uc7a5\uc744 \uc77c\ub960\uc801\uc73c\ub85c \uae08\uc9c0\ud558\ub294 \uac83\uc740 \ucc28\ubcc4\uc801 \uc694\uc18c\uac00 \uc788\ub2e4\ub294 \uc778\uad8c\uc801 \ubaa9\uc18c\ub9ac\uac00 \ud575\uc2ec \ubc30\uacbd\uc774\ub2e4."
        },
        {
          "text": "\ub178\ud0a4\uc988\uc874\uc744 \uc6b4\uc601\ud558\ub294 \uc18c\uc0c1\uacf5\uc778\uc5d0\uac8c \uad6d\uac00\uac00 \uc601\uc5c5 \uc190\uc2e4\uae08\uc744 \uc804\uc561 \ubcf4\uc0c1\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud574\ub2f9 \ub17c\uc758\uc758 \ubcf8\uc9c8\uc740 \uc601\uc5c5 \uc190\uc2e4 \ubcf4\uc0c1\uc774 \uc544\ub2c8\ub77c \ud2b9\uc815 \uc5f0\ub839\uce35 \uac70\ubd80\uc5d0 \ub530\ub978 \ucc28\ubcc4\uacfc \uae30\ubcf8\uad8c \uce68\ud574 \uc5ec\ubd80\uc774\ub2e4."
        },
        {
          "text": "\uc5b4\ub9b0\uc774 \ucd9c\uc785 \uc81c\ud55c \uad6c\uc5ed\uc744 \uc804\uad6d \ubaa8\ub4e0 \ubbfc\uac04 \uce74\ud398\uc640 \uc74c\uc2dd\uc810\uc73c\ub85c \uc758\ubb34 \ud655\uc7a5\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc870\ub840 \uc81c\uc815 \ub17c\uc758\ub294 \ucd9c\uc785 \uc81c\ud55c\uc744 \uae08\uc9c0\ud558\uc790\ub294 \ucde8\uc9c0\uc774\uba70, \uc81c\ud55c \uacf5\uac04\uc744 \ud655\uc7a5\ud558\uc790\ub294 \uc8fc\uc7a5\uc774 \uc544\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\ubc29 \uc790\uce58 \ub2e8\uccb4\uac00 \ubbfc\uac04 \uc0ac\uc5c5\uc7a5\uc758 \uc0c1\ud488 \uac00\uaca9 \uacb0\uc815\uad8c\uc744 \uc9c1\uc811 \ud1b5\uc81c\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf8 \uc790\ub8cc\ub294 \uc5f0\ub839 \ucc28\ubcc4\uacfc \uc785\uc7a5 \uc81c\ud55c \uae08\uc9c0 \uc870\ub840\uc5d0 \uad00\ud55c \ub0b4\uc6a9\uc73c\ub85c, \uac00\uaca9 \ud1b5\uc81c\uc640\ub294 \ubb34\uad00\ud558\ub2e4."
        }
      ],
      "hint": "\uc601\uc720\uc544 \ubc0f \uc5b4\ub9b0\uc774\uc758 \ucd9c\uc785\uc744 \uae08\uc9c0\ud558\ub294 \ud589\uc704\uac00 \uc778\uad8c\uc801 \uad00\uc810\uc5d0\uc11c \uc65c \ubb38\uc81c\uac00 \ub418\uc5c8\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
