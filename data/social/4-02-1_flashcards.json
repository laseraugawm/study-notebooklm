    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ud06c\ub77c\uc774\ub098 \ub09c\ubbfc \uc218\uae30 \uc791\uc131\uc790\uac00 \ud53c\ub09c\uc744 \ub5a0\ub098\uba74\uc11c \ub290\uaf08\ub358 \uc8c4\ucc45\uac10\uc758 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
