    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ud06c\ub77c\uc774\ub098 \ub09c\ubbfc\uc774 \uc601\uad6d \ub7f0\ub358\uc5d0 \ub3c4\ucc29\ud558\uc5ec \uac00\uc871\uc774 \ud568\uaed8 \uc2dd\uc0ac\ud558\ub294 \uc77c\uc0c1\uc744 \ubcf4\uba70 \uae68\ub2ec\uc740 \uac00\uc7a5 \uc18c\uc911\ud55c \uac00\uce58\ub294 \ubb34\uc5c7\uc778\uac00?"
