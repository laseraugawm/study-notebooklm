        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ubb34 \uac71\uc815 \uc5c6\uc774 \uac00\uc871\uacfc \ud568\uaed8 \uc9c0\ub0bc \uc218 \uc788\ub294 \uc18c\uc18c\ud55c \uc77c\uc0c1\uacfc \uac00\uc871\uc758 \uc548\uc704"
