      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc871\uacfc \uc9c1\uc7a5, \ub098\ub77c\ub97c \ub354 \ub3d5\uc9c0 \ubabb\ud558\uace0 \ub5a0\ub09c\ub2e4\ub294 \ub9c8\uc74c \ub54c\ubb38"
