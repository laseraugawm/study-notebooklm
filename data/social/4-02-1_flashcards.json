      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ud06c\ub77c\uc774\ub098 \uc790\ud3ec\ub9ac\uc790 \uc804\uc7c1 \ub09c\ubbfc \uc218\uae30\uc5d0\uc11c, '\uc548\uc804\uc744 \ud655\ubcf4\ud558\ub77c\ub294 \uc2e0\ud638'\uc600\uc9c0\ub9cc \uadf8 \uc790\uccb4\ub85c \uacf5\ud3ec\ub97c \uc900 \uc18c\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\ubcf4 \uc0ac\uc774\ub80c \uc18c\ub9ac"
