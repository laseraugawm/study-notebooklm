    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "ESG \uacbd\uc601\uc5d0\uc11c \uac01 \uc57d\uc790(E, S, G)\uac00 \ub098\ud0c0\ub0b4\ub294 \uc694\uc18c\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
