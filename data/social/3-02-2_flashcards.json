{
  "title": "\uacbd\uc81c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc7a5\uacbd\uc81c\uc5d0\uc11c \uc815\ubd80\uac00 \uc218\ud589\ud558\ub294 \uae30\ubcf8\uc801\uc778 \uc5ed\ud560 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\ud65c\ub3d9\uc5d0 \ud544\uc694\ud55c \uc81c\ub3c4\ub97c \ud655\ub9bd\ud558\uace0, \uac1c\uc778\uacfc \uae30\uc5c5\uc774 \uc790\uc720\ub86d\uac8c \uacbd\uc7c1\ud560 \uc218 \uc788\ub294 \ud658\uacbd\uc744 \uc870\uc131\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc7a5\uc758 \uae30\ub2a5\uc774 \uc6d0\ud65c\ud558\uac8c \uc791\ub3d9\ud558\uc9c0 \ubabb\ud558\ub294 \uc2dc\uc7a5 \uc2e4\ud328\uac00 \ubc1c\uc0dd\ud560 \ub54c \uc815\ubd80\ub294 \uc5b4\ub5bb\uac8c \ub300\uc751\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80\uac00 \uc801\uadf9\uc801\uc73c\ub85c \uc2dc\uc7a5\uc5d0 \ucc38\uc5ec\ud558\uc5ec \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub824 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c \uc815\ubd80\uac00 \ubd88\uacf5\uc815 \uac70\ub798 \ud589\uc704\ub97c \uaddc\uc81c\ud558\uae30 \uc704\ud574 \uc81c\uc815\ud55c \ub300\ud45c\uc801\uc778 \ubc95\ub960\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub3c5\uc810 \uaddc\uc81c \ubc0f \uacf5\uc815 \uac70\ub798\uc5d0 \uad00\ud55c \ubc95\ub960\u300d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc810 \ubc0f \ubd88\uacf5\uc815 \uac70\ub798\uc5d0 \uad00\ud55c \uc0ac\uc548\uc744 \uc2ec\uc758\u00b7\uc758\uacb0\ud558\uace0\uc790 \uc124\ub9bd\ub41c \uc815\ubd80 \uae30\uad00\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \uac70\ub798 \uc704\uc6d0\ud68c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc5c5\uc790\ub4e4\uc774 \uac00\uaca9\uc774\ub098 \ub0a9\ud488 \uc870\uac74 \ub4f1\uc744 \uc11c\ub85c \ud569\uc758\ud558\uc5ec \ubd80\ub2f9\ud558\uac8c \uacbd\uc7c1\uc744 \uc81c\ud55c\ud558\ub294 \ubd88\uacf5\uc815 \ud589\uc704\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2f4\ud569"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \uac70\ub798 \uc704\uc6d0\ud68c\uac00 \ube59\uacfc\ub958 \uc81c\uc870\u00b7\ud310\ub9e4 \uc5c5\uccb4\ub4e4\uc758 \uac00\uaca9 \ub2f4\ud569 \ud589\uc704\ub97c \uc81c\uc7ac\ud558\ub294 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\uacf5\uc815 \uac70\ub798\ub97c \uaddc\uc81c\ud558\uc5ec \uacf5\uc815\ud55c \uacbd\uc7c1 \ud658\uacbd\uc744 \uc870\uc131\ud558\uace0 \uc18c\ube44\uc790\uc758 \ud53c\ud574\ub97c \ub9c9\uae30 \uc704\ud574\uc11c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80\uac00 \uacf5\uacf5\uc7ac\ub97c \uc9c1\uc811 \uc0dd\uc0b0\ud558\uace0 \uad00\ub9ac\ud568\uc73c\ub85c\uc368 \uae30\uc5ec\ud558\ub294 \ubc14\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0\uc758 \ud6a8\uc728\uc801 \ubc30\ubd84\uc5d0 \uc774\ubc14\uc9c0\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\ubd80 \ud6a8\uacfc \ud574\uacb0\uc744 \uc704\ud574 \uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc801\uac8c \ub098\ud0c0\ub098\ub294 \uacbd\uc81c\ud65c\ub3d9\uc5d0 \uc815\ubd80\uac00 \ucde8\ud558\ub294 \uc218\ub2e8\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\uc870\uae08\uc744 \uc9c0\uae09\ud558\uc5ec \ud574\ub2f9 \ud65c\ub3d9\uc744 \uc7a5\ub824\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\ubd80 \ud6a8\uacfc \ud574\uacb0\uc744 \uc704\ud574 \uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \ub9ce\uc774 \ub098\ud0c0\ub098\ub294 \uacbd\uc81c\ud65c\ub3d9\uc5d0 \uc815\ubd80\uac00 \ucde8\ud558\ub294 \uc218\ub2e8\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uae08\uc774\ub098 \uacfc\uc9d5\uae08\uc744 \ubd80\uacfc\ud558\uc5ec \ud574\ub2f9 \ud65c\ub3d9\uc744 \uc5b5\uc81c\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "UN\uc758 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804 \ubaa9\ud45c(SDGs)\ub97c \ubc14\ud0d5\uc73c\ub85c \uc6b0\ub9ac\ub098\ub77c \uc815\ubd80\uac00 \uc218\ub9bd\ud55c \ud55c\uad6d\ud615 \ubaa9\ud45c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804 \ubaa9\ud45c (K-SDGs)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804 \ubaa9\ud45c(K-SDGs) \uc911 \uacbd\uc81c \ubd84\uc57c\uc640 \uad00\ub828\ub41c \uc138\ubd80 \ubaa9\ud45c \uc608\uc2dc\ub97c 2\uac00\uc9c0 \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\ub108\uc9c0\uc758 \uce5c\ud658\uacbd\uc801 \uc0dd\uc0b0\uacfc \uc18c\ube44, \uc88b\uc740 \uc77c\uc790\ub9ac \ud655\ub300 (\ub610\ub294 \uc9c0\uc18d\uac00\ub2a5\ud55c \uc0dd\uc0b0\uacfc \uc18c\ube44, \uc0b0\uc5c5 \uc131\uc7a5\uacfc \ud601\uc775 \ud65c\uc131\ud654 \ub4f1)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc138\ub300\uac00 \uc0ac\uc6a9\ud560 \uc790\uc6d0\uc744 \ub0ad\ube44\ud558\uc9c0 \uc54a\uc73c\uba74\uc11c \ud604\uc7ac \uc138\ub300\uc758 \ud544\uc694\ub97c \ucda9\uc871\ud558\ub294 \ubc1c\uc804\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uc744 \uacbd\uc601\ud558\uba70 \ud569\ub9ac\uc801\uc778 \uc120\ud0dd\uc744 \ud1b5\ud574 \uc774\uc724 \uadf9\ub300\ud654\ub97c \ucd94\uad6c\ud558\ub294 \uacbd\uc81c \uc8fc\uccb4\ub294 \ub204\uad6c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uac00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc704\ud5d8\uacfc \ubd88\ud655\uc2e4\uc131\uc744 \ubb34\ub985\uc4f0\uace0 \uc0c8\ub85c\uc6b4 \uc2dc\uc7a5\uc744 \uac1c\ucc99\ud558\ub294 \ub4f1 \uae30\uc5c5\uc744 \uc131\uc7a5\uc2dc\ud0a4\ub824\ub294 \ub3c4\uc804 \uc815\uc2e0\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
