    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce90\ub864\uc758 \uc0ac\ud68c\uc801 \ucc45\uc784 \ud53c\ub77c\ubbf8\ub4dc\uc5d0\uc11c 3\ub2e8\uacc4 \ucc45\uc784\uc740 \ubb34\uc5c7\uc778\uac00?"
