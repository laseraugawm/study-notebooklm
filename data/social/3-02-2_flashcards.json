      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uac00 \uc815\uc2e0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\ud559\uc790 \uc298\ud398\ud130(J. A. Schumpeter)\uac00 \uac15\uc870\ud55c \uae30\uc5c5\uac00 \uc815\uc2e0\uc758 \ud575\uc2ec \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc3d\uc870\uc801 \ud30c\uad34 (\ud601\uc2e0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uac00 \uc815\uc2e0\uc774 \uc2dc\uc7a5\uacbd\uc81c \uccb4\uc81c\uc5d0\uc11c \uc218\ud589\ud558\ub294 \uc6d0\ucc9c\uc801\uc778 \uae30\ub2a5 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc6a9\uc744 \ucc3d\ucd9c\ud558\uace0 \uc0dd\uc0b0\uc744 \ud65c\ubc1c\ud558\uac8c \ud558\uc5ec \uc2dc\uc7a5\uacbd\uc81c\uac00 \uc5ed\ub3d9\uc801\uc73c\ub85c \uc791\ub3d9\ud558\ub3c4\ub85d \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uac00\uac00 \ubc95\uaddc \uc900\uc218, \uc18c\ube44\uc790\u00b7\ub178\ub3d9\uc790 \uad8c\ub9ac \uc874\uc911, \uc9c0\uc5ed\uc0ac\ud68c \uacf5\ud5cc \ub4f1\uc744 \uace0\ub824\ud558\uc5ec \uacbd\uc81c\ud65c\ub3d9\uc744 \ud574\uc57c \ud558\ub294 \ucc45\uc784\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uc758 \uc0ac\ud68c\uc801 \ucc45\uc784 (CSR)"
