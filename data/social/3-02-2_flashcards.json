    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5 \uc0ac\uc6a9 \uc804\ub825\ub7c9\uc758 100%\ub97c 2050\ub144\uae4c\uc9c0 \uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub85c \ucda9\ub2f9\ud558\uaca0\ub2e4\ub294 \uad6d\uc81c \ucea0\ud398\uc778\uc758 \uba85\uce6d\uc740?"
