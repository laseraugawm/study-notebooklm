      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "E: \ud658\uacbd(Environment), S: \uc0ac\ud68c(Social), G: \ud22c\uba85/\uc9c0\ubc30 \uad6c\uc870(Governance)"
          }
        ]
