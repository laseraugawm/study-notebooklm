    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd \ubcf4\ud638, \uc0ac\ud68c\uc801 \ucc45\uc784, \uc9c0\ubc30 \uad6c\uc870 \uac1c\uc120 \ub4f1 \uae30\uc5c5\uc758 \ube44\uc7ac\ubb34\uc801 \uc694\uc18c\ub97c \ud568\uaed8 \uace0\ub824\ud558\ub294 \uacbd\uc601 \ubc29\uc2dd\uc740?"
