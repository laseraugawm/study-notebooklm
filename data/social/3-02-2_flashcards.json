        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9\uc790\uac00 \uc0ac\uc6a9\uc790\uc640 \ub300\ub4f1\ud55c \uc704\uce58\uc5d0\uc11c \ud611\uc0c1\ud560 \uc218 \uc788\ub3c4\ub85d \ud5cc\ubc95\uc5d0 \uaddc\uc815\ub41c \uad8c\ub9ac\ub97c \ud1b5\ud2c0\uc5b4 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9 3\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95\uc0c1 \ubcf4\uc7a5\ub418\ub294 \ub178\ub3d9 3\uad8c\uc758 \uc138 \uac00\uc9c0 \uc138\ubd80 \uad8c\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e8\uacb0\uad8c, \ub2e8\uccb4 \uad50\uc12d\uad8c, \ub2e8\uccb4 \ud589\ub3d9\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9\uc790\uac00 \uae30\uc5c5\uac00\uc640 \uc0c1\ud638 \ub3d9\ubc18\uc790 \uc758\uc2dd\uc744 \uac00\uc9c0\uace0 \ud568\uaed8 \ub178\ub825\ud574\uc57c \ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uc774 \uc874\ub9bd\ud558\uc9c0 \uc54a\uc73c\uba74 \uc77c\uc790\ub9ac\uac00 \uc548\uc815\uc801\uc73c\ub85c \uc720\uc9c0\ub420 \uc218 \uc5c6\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790\uac00 \uacbd\uc81c\ud65c\ub3d9\uc5d0\uc11c \uad81\uadf9\uc801\uc73c\ub85c \ucd94\uad6c\ud558\ub294 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud6a8\uc6a9 \uadf9\ub300\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud569\ub9ac\uc801 \uc18c\ube44\ub97c \ud558\uae30 \uc704\ud574 \uc18c\ube44\uc790\uac00 \ucde8\ud574\uc57c \ud560 \uc62c\ubc14\ub978 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ud488\uc758 \ud488\uc9c8\u00b7\uac00\uaca9 \uc815\ubcf4\ub97c \uc218\uc9d1\ud574 \ube44\ud310\uc801\uc73c\ub85c \ubd84\uc11d\ud558\uace0, \uacc4\ud68d\uc5d0 \ub530\ub77c \uc18c\ube44\ud574\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc7a5\uacbd\uc81c\uc5d0\uc11c \uc0dd\uc0b0\ubb3c\uc758 \uc885\ub958\uc640 \uc218\ub7c9\uc744 \uacb0\uc815\ud558\ub294 \ucd5c\uc885\uc801\uc778 \uad8c\ud55c\uc774 \uc18c\ube44\uc790\uc5d0\uac8c \uc788\ub2e4\ub294 \uc6d0\uce59\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790 \uc8fc\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790 \uac1c\uac1c\uc778\uc758 \uad6c\ub9e4 \uc120\ud0dd\uc774 \uae30\uc5c5\uc758 \uc0dd\uc0b0 \ud65c\ub3d9\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uc774 \ubb34\uc5c7\uc744, \uc5b4\ub5bb\uac8c \uc0dd\uc0b0\ud560\uc9c0\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \uc900\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0 \ubc0f \uc720\ud1b5\uc758 \uc804 \uacfc\uc815\uc774 \uc5f0\uacb0\ub428\uc744 \uc778\uc2dd\ud558\uace0 \uc724\ub9ac\uc801\uc73c\ub85c \uc0dd\uc0b0\ub41c \uc7ac\ud654\ub098 \uc11c\ube44\uc2a4\ub97c \uad6c\ub9e4\ud558\ub294 \uc18c\ube44\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub9ac\uc801 \uc18c\ube44"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub9ac\uc801 \uc18c\ube44\uc758 \ub300\ud45c\uc801\uc778 \uc608\uc2dc 2\uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce5c\ud658\uacbd \uc81c\ud488 \uad6c\ub9e4, \uacf5\uc815 \ubb34\uc5ed \uc81c\ud488 \uad6c\ub9e4 (\ub610\ub294 \ub3d9\ubb3c \uc2e4\ud5d8\uc744 \ud558\uc9c0 \uc54a\uc740 \ud654\uc7a5\ud488 \uad6c\ub9e4)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd08\uc74c\uc18d \uc5ec\uac1d\uae30 '\ucf69\ucf54\ub4dc' \uc0ac\ub840\uac00 \ubcf4\uc5ec\uc8fc\ub294 \ube44\ud569\ub9ac\uc801 \uacb0\uc815\uc758 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ubbf8 \ud68c\uc218\ud560 \uc218 \uc5c6\ub294 \ub9c9\ub300\ud55c \ud22c\uc790 \ube44\uc6a9(\ub9e4\ubab0 \ube44\uc6a9)\uc5d0 \ub9e4\uc5ec \ud070 \uc190\uc2e4\uc774 \uc608\uc0c1\ub428\uc5d0\ub3c4 \ubb34\ub9ac\ud558\uac8c \uac15\ud589\ud55c \uc810."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc44\uc2dd\uc8fc\uc758 \ubc0f \uce5c\ud658\uacbd \ud654\uc7a5\ud488 \uc120\ud638 \uc99d\uac00\ub85c \uc5c5\uacc4\uac00 \uce5c\ud658\uacbd \ud3ec\uc7a5\uc7ac\ub97c \ub3c4\uc785\ud55c \ud604\uc0c1\uc774 \uc2dc\uc0ac\ud558\ub294 \ubc14\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790\uc758 \uc724\ub9ac\uc801 \uac00\uce58 \uc18c\ube44\uac00 \uae30\uc5c5\uc758 \uc0dd\uc0b0 \ubc29\uc2dd\uc744 \ubc14\uafc0 \uc218 \uc788\uc74c\uc744 \ubcf4\uc5ec\uc900\ub2e4 (\uc18c\ube44\uc790 \uc8fc\uad8c \ud589\uc0ac)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce90\ub864\uc758 CSR \ud53c\ub77c\ubbf8\ub4dc\uc5d0\uc11c '\uc774\uc724 \uadf9\ub300\ud654'\uc640 '\ubc95 \uaddc\uc81c \uc900\uc218'\ub294 \uac01\uac01 \uba87 \ub2e8\uacc4 \ucc45\uc784\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc724 \uadf9\ub300\ud654\ub294 1\ub2e8\uacc4(\uacbd\uc81c\uc801 \ucc45\uc784), \ubc95 \uaddc\uc81c \uc900\uc218\ub294 2\ub2e8\uacc4(\ubc95\uc801 \ucc45\uc784)\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c\uad8c\uacfc \ub178\ub3d9 3\uad8c\uc758 \uacb0\uc815\uc801\uc778 \ubaa9\uc801\uc0c1\uc758 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub85c\uad8c\uc740 \uc77c\ud560 \uae30\ud68c \uc790\uccb4\ub97c \uc694\uad6c\ud558\ub294 \uad8c\ub9ac\uc774\uba70, \ub178\ub3d9 3\uad8c\uc740 \uc0ac\uc6a9\uc790\uc640 \ub300\ub4f1\ud55c \ud611\uc0c1 \uc9c0\uc704\ub97c \ud655\ubcf4\ud558\uae30 \uc704\ud55c \uad8c\ub9ac\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80\ub294 \uacfc\uc18c \uc0dd\uc0b0\ub418\ub294 \uc720\uc775\ud55c \uacbd\uc81c\ud65c\ub3d9\uc5d0\ub294 _____\uc744 \uc9c0\uae09\ud558\uace0, \uacfc\ub2e4 \uc0dd\uc0b0\ub418\ub294 \uc720\ud574 \ud65c\ub3d9\uc5d0\ub294 \uc138\uae08\uc744 \ubd80\uacfc\ud55c\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\uc870\uae08"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc298\ud398\ud130\ub294 \uae30\uc5c5\uac00 \uc815\uc2e0\uc758 \ubcf8\uc9c8\uc774 \uae30\uc874 \ubc29\uc2dd\uc744 \ub4a4\uc5ce\uace0 \uc0c8\ub85c\uc6b4 \ud601\uc2e0\uc744 \uc774\ub8e8\ub294 '_____\uc801 \ud30c\uad34'\uc5d0 \uc788\ub2e4\uace0 \ud558\uc600\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc3d\uc870"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "RE100 \ucea0\ud398\uc778\uc5d0 \ucc38\uc5ec\ud558\ub294 \uae30\uc5c5\ub4e4\uc740 \uc804\ub825\uc758 100%\ub97c \ud48d\ub825, \ud0dc\uc591\uad11 \ub4f1\uc758 _____ \uc5d0\ub108\uc9c0\ub85c \ucda9\ub2f9\ud558\uace0\uc790 \ud55c\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7ac\uc0dd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc7a5\uacbd\uc81c\uc5d0\uc11c \uc0dd\uc0b0\ubb3c\uc758 \uc885\ub958\uc640 \uc218\ub7c9\uc744 \uacb0\uc815\ud558\ub294 \ucd5c\uc885\uc801 \uad8c\ud55c\uc774 \uc18c\ube44\uc790\uc5d0\uac8c \uc788\ub2e4\ub294 \uc6d0\uce59\uc744 _____ \uc8fc\uad8c\uc774\ub77c \ud55c\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \uc774\ub8e8\uae30 \uc704\ud574 \ubbfc\uac04 \ubc0f \uc815\ubd80 \ubd80\ubb38\uc5d0\uc11c \ud611\ub825\ud558\ub294 \uc8fc\uc694 4\ub300 \uacbd\uc81c \uc8fc\uccb4\uc758 \uba85\uce6d\uc744 \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80, \uae30\uc5c5\uac00, \ub178\ub3d9\uc790, \uc18c\ube44\uc790"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc815 \uac70\ub798 \uc704\uc6d0\ud68c\uac00 \ubd88\uacf5\uc815 \ub2f4\ud569 \ud589\uc704\ub97c \ud55c \uae30\uc5c5\ub4e4\uc5d0 \ucc98\ubd84\ud560 \uc218 \uc788\ub294 \uc81c\uc7ac \uc81c\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc815 \uba85\ub839, \uacfc\uc9d5\uae08 \ubd80\uacfc \ubc0f \uac80\ucc30 \uace0\ubc1c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\uc744 \ub2ec\uc131\ud558\uae30 \uc704\ud55c \uae30\ubcf8 \uc6d0\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc138\ub300\uc758 \uc790\uc6d0\uc744 \ub0ad\ube44\ud558\uc9c0 \uc54a\uc73c\uba74\uc11c \ud604\uc7ac \uc138\ub300\uc758 \ud544\uc694\ub97c \ucda9\uc871\uc2dc\ud0a4\ub294 \uac83."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9 3\uad8c \uc911 \ub178\ub3d9\uc790\uac00 \uadfc\ub85c \uc870\uac74\uc758 \ud5a5\uc0c1\uc744 \uc704\ud574 \ub178\ub3d9\uc870\ud569 \ub4f1\uc758 \ub2e8\uccb4\ub97c \uacb0\uc131\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e8\uacb0\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9 3\uad8c \uc911 \ub178\ub3d9\uc870\ud569\uc774 \uc0ac\uc6a9\uc790\uc640 \uadfc\ub85c \uc870\uac74\uc5d0 \uad00\ud558\uc5ec \uc9c1\uc811 \uad50\uc12d\ud558\uace0 \ud611\uc57d\uc744 \uccb4\uacb0\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e8\uccb4 \uad50\uc12d\uad8c"
          }
        ]
      }
    }
  ]
