    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc591\ud55c \ubd84\uc57c\uc758 \ucd5c\ucca8\ub2e8 \uae30\uc220\uc774 \uc735\ud569\ub41c \uc790\ub3d9\ud654 \ub18d\uc5c5 \uc2dc\uc124\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
