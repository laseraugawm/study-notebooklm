    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c\uc5d0\uc11c \uc790\uc720 \ubb34\uc5ed\uc758 \ud655\ub300\uac00 \uad6d\uac00 \uac04 \uacbd\uc81c\uc801 \uac08\ub4f1\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \uacfc\uc815\uc740 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc5ed \uacbd\uc7c1\uc774 \uce58\uc5f4\ud574\uc9c0\uace0 \uc18c\uc218 \uad6d\uac00\uac00 \uacbd\uc81c\ub97c \ub3c5\uc810\ud558\uba74\uc11c \uad6d\uac00 \uac04 \ube48\ubd80 \uaca9\ucc28\uac00 \ud655\ub300\ub41c\ub2e4."
          }
        ]
