      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uba85 \ubcf5\uc81c, \uc720\uc804\uc790 \uce58\ub8cc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\ub098 \uae30\uc5c5 \ub4f1\uc758 \uac10\uc2dc\uc790\uac00 \uac1c\uac1c\uc778\uc758 \ub370\uc774\ud130\ubca0\uc774\uc2a4\ub97c \uc774\uc6a9\ud558\uc5ec \uac1c\uc778\uc758 \ud589\ub3d9\uc774\ub098 \uc0dd\uac01\uc744 \uac10\uc2dc\ud558\ub294 \ud589\uc704\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc790 \uac10\uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uacc4\ub098 \uc778\uacf5\uc9c0\ub2a5\uc744 \ud559\uc2b5\uc2dc\ud0a4\ub294 \ub370 \uc0ac\uc6a9\ub418\ub294 \ub370\uc774\ud130\uac00 \uc0ac\ub78c\uc774\ub098 \uc0ac\ud68c\uac00 \uac00\uc9c0\ub294 \ud3b8\uacac\uc744 \ud3ec\ud568\ud558\uace0 \uc788\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
