    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "c58796aa-2217-4369-8b94-2f89ef1be4c3",
            "alt": "\uc2dc\ud5d8\uad00 \ubc0f \ud329\uc5d0 \ubcf4\uad00\ub41c \ub2e4\uc591\ud55c \uc2dd\ubb3c \uc528\uc557 \uc0d8\ud50c\ub4e4"
