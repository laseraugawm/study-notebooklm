{
  "title": "\ubbf8\ub798\uc0ac\ud68c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798\ud559\uc790\ub098 \uc804\ubb38\uac00\ub4e4\uc774 \ubbf8\ub798 \uc0ac\ud68c\uc758 \ubcc0\ud654\ub97c \uc608\uce21\ud558\ub294 \uad81\uadf9\uc801\uc778 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798\uc5d0 \uc77c\uc5b4\ub0a0 \ubcc0\ud654\ub97c \ubbf8\ub9ac \ud30c\uc545\ud558\uc5ec \ubd88\ud655\uc2e4\ud55c \ubbf8\ub798\uc5d0 \uc720\uc5f0\ud558\uac8c \ub300\uc751\ud558\uace0 \uc704\ud5d8\uc744 \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud568\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80\uac00 \ubbf8\ub798 \uc0ac\ud68c\uc758 \ud658\uacbd \ubcc0\ud654\ub97c \uc608\uce21\ud558\uc5ec \uc218\ub9bd\ud558\ub294 \ub300\ucc45\uc758 \uc608\uc2dc\uc640 \uadf8 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c8\ub85c\uc6b4 \uc5d0\ub108\uc9c0 \uc815\ucc45\uc774\ub098 \ud658\uacbd \ubcf4\ud638 \ub300\ucc45\uc744 \ub9cc\ub4e4\uc5b4 \uc2dc\ubbfc\uc758 \uc548\uc804\uacfc \ud658\uacbd\uc744 \uc9c0\ud0a4\uace0, \uc608\uae30\uce58 \ubabb\ud55c \uc704\ud5d8\uc5d0 \ub300\ube44\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5c5\uc774 \uc138\uacc4 \uc2dc\uc7a5\uc758 \ubcc0\ud654\ub97c \uc608\uce21\ud558\uace0 \uc704\uae30\uad00\ub9ac \uc804\ub7b5\uc744 \uc138\uc6c0\uc73c\ub85c\uc368 \uc5bb\ub294 \uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae09\uaca9\ud55c \ubcc0\ud654\ub098 \uacbd\uc81c \uc704\uae30\uc5d0 \ub300\ucc98\ud558\uace0, \ubbf8\ub798\uc758 \uae30\ud68c\ub97c \uc801\uadf9\uc801\uc73c\ub85c \ud65c\uc6a9\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc774 \uc778\uacf5\uc9c0\ub2a5\uacfc \uc790\ub3d9\ud654 \uae30\uc220\uc758 \ubc1c\uc804\uc744 \uc608\uce21\ud558\uc5ec \ub300\ube44\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\ub2f9 \ubd84\uc57c\uc758 \uc804\ubb38\uc131\uc744 \uae30\ub974\ub294 \uad50\uc721\uc744 \ubc1b\uace0 \uacbd\ud5d8\uc744 \uc313\uc544, \ubbf8\ub798\uc5d0 \uc0c8\ub86d\uac8c \uc0dd\uae38 \uc9c1\uc5c5\uc774\ub098 \uc720\ub9dd \uc9c1\uc5c5\uc744 \ubbf8\ub9ac \uc900\ube44\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70\ub098 \ud604\uc7ac\uc758 \uc0c1\ud669\uc744 \ubc14\ud0d5\uc73c\ub85c \ubbf8\ub798 \uc0ac\ud68c\uc758 \ubaa8\uc2b5\uc744 \uc608\uce21\ud558\uace0 \uadf8 \ubaa8\ub378\uc744 \uc81c\uacf5\ud558\ub294 \ud559\ubb38\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798\ud559"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798\ud559\uc790\ub4e4\uc774 \ubbf8\ub798 \uc0ac\ud68c\uc758 \ubaa8\uc2b5\uc744 \uadf8\ub824\ub0b4\ub294 \uae30\ubcf8\uc801\uc778 \uc5f0\uad6c \uacfc\uc815\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70\uc640 \ud604\uc7ac\uc758 \uc0ac\ud68c \ubcc0\ub3d9 \uc591\uc0c1\uc744 \ubd84\uc11d\ud558\uc5ec \ubbf8\ub798\uc5d0 \ub2e4\uac00\uc62c \ubcc0\ud654\ub97c \uc608\uce21\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798\ud559\uc758 \uc608\uce21 \uacb0\uacfc\ub97c \uc218\uc6a9\ud560 \ub54c \uc720\uc758\ud574\uc57c \ud560 \uc810\uacfc \uc62c\ubc14\ub978 \ub300\uc751 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798\ub294 \uc804\uac1c \uc0c1\ud669\uacfc \uc870\uac74\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \ubb34\uc870\uac74 \ubc1b\uc544\ub4e4\uc774\uae30\ubcf4\ub2e4\ub294 \ubcc0\ud654\uc5d0 \uc720\uc5f0\ud558\uac8c \ub300\uc751\ud558\uba70 \ubc1c\uc804 \ubc29\ud5a5\uc744 \ucc3e\uc544\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "fb761e9c-5424-4788-8e4f-6ba07b8d6941",
            "alt": "\ubd81\uadf9 \uc9c0\uc5ed\uc5d0 \uc124\uce58\ub41c \uc2a4\ubc1c\ubc14\ub974 \uad6d\uc81c \uc885\uc790 \uc800\uc7a5\uace0 \uc785\uad6c \uc785\uba74 \uc804\uacbd"
          },
          {
            "type": "text",
            "content": "\uc774 \uc2dc\uc124\uc758 \uba85\uce6d\uacfc \uc124\uce58 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ubc1c\ubc14\ub974 \uad6d\uc81c \uc885\uc790 \uc800\uc7a5\uace0\ub85c, \uc790\uc5f0\uc7ac\ud574\u00b7\ud575 \uc804\uc7c1\u00b7\ud14c\ub7ec \ub4f1 \uc608\uce21\ud560 \uc218 \uc5c6\ub294 \ubbf8\ub798 \uc704\ud5d8\uc5d0 \ub300\ube44\ud558\uc5ec \uc778\ub958\uc758 \uc2dd\ub7c9\uc744 \ubcf4\uc874\ud558\uae30 \uc704\ud574 \uc124\uce58\ub418\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ubc1c\ubc14\ub974 \uad6d\uc81c \uc885\uc790 \uc800\uc7a5\uace0\uac00 \uc704\uce58\ud55c \uae4a\uc774\uc640 \uc0c1\uc9d5\uc801\uc778 \ubcc4\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd81\uadf9 \uc9c0\ud558 120m \uae4a\uc774\uc5d0 \uc704\uce58\ud558\uba70, '\ud604\ub300\ud310 \ub178\uc544\uc758 \ubc29\uc8fc'\ub85c \ubd88\ub9b0\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ubc1c\ubc14\ub974 \uad6d\uc81c \uc885\uc790 \uc800\uc7a5\uace0\uac00 \uc804\ub825\uc774 \ucc28\ub2e8\ub41c \ube44\uc0c1 \uc0c1\ud669\uc5d0\uc11c\ub3c4 \uc528\uc557\uc744 \ubcf4\uc874\ud560 \uc218 \uc788\ub294 \uae30\uc220\uc801 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uae30\uac00 \ub04a\uae30\ub354\ub77c\ub3c4 \ucd5c\ub300 200\ub144 \ub3d9\uc548 \uc790\uc5f0 \ub0c9\ub3d9 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub418\uc5b4 \uc788\ub2e4."
