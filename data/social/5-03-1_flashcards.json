    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c\uc5d0\uc11c \uac1c\uc778\uc758 \uc774\ub3d9\uc131\uc744 \uac1c\uc120\ud558\uace0 \uc0b6\uc758 \uc9c8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uac83\uc73c\ub85c \uae30\ub300\ub418\ub294 \uc6b4\uc1a1 \uc218\ub2e8 \ubc0f \uae30\uc220 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc728 \uc8fc\ud589 \uc790\ub3d9\ucc28, \ubb34\uc778\uae30(\ub4dc\ub860), \uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uba85 \uacf5\ud559\uacfc \uc720\uc804 \uacf5\ud559\uc758 \ubc1c\uc804\uc774 \uc778\ub958 \uc0ac\ud68c\uc5d0 \uac00\uc838\uc62c \uae0d\uc815\uc801 \ubcc0\ud654 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc758 \uc218\uba85 \uc5f0\uc7a5, \uc2dd\ub7c9 \ubb38\uc81c \ud574\uacb0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220\uc758 \uae09\uaca9\ud55c \ubc1c\ub2ec\ub85c \uc778\ud574 \uc6b0\ub824\ub418\ub294 \ubd80\uc791\uc6a9 4\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \uaca9\ucc28, \uc778\ud130\ub137 \uc911\ub3c5, \uc804\uc790 \uac10\uc2dc, \ub370\uc774\ud130 \ud3b8\ud5a5\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uba85 \uacf5\ud559\uc758 \ubc1c\uc804 \uacfc\uc815\uc5d0\uc11c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc724\ub9ac\uc801\u00b7\ub3c4\ub355\uc801 \ud63c\ub780\uc758 \uc6d0\uc778 \uae30\uc220 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
