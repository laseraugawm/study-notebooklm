    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ubc1c\ubc14\ub974 \uad6d\uc81c \uc885\uc790 \uc800\uc7a5\uace0\uc5d0 2020\ub144 \uae30\uc900\uc73c\ub85c \uc800\uc7a5\ub41c \uc528\uc557\uc758 \uaddc\ubaa8\ub294 \uc57d \uba87 \uc885\uc778\uac00?"
