    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c\uc5d0\uc11c \uad6d\uac00 \uac04 \uacbd\uc81c\uc801 \uac08\ub4f1\uc774 \uc2ec\ud654\ub420 \ub54c \ubc88\uc9c8 \uc218 \uc788\ub294 \uc815\uce58\u00b7\uc0ac\ud68c\uc801 \uac08\ub4f1 \ud615\ud0dc 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uac04 \uc601\ud1a0 \ubd84\uc7c1, \ubb38\ud654\uc801 \uac08\ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c\uc5d0\uc11c \uad6d\uac00 \uac04 \uc815\uce58\u00b7\uacbd\uc81c\uc801 \uac08\ub4f1\uc744 \uc608\ubc29\ud558\uace0 \ud574\uacb0\ud558\uae30 \uc704\ud574 \ucd94\uc9c4\ub418\ub294 \uad6d\uc81c\uc801 \ud611\ub825 \ubc29\uc548\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uac04 \ud611\uc815\uacfc \uc870\uc57d\uc744 \uccb4\uacb0\ud558\uace0, \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc704\ud55c \ub2e4\uc591\ud55c \ud611\ub825 \ud504\ub85c\uadf8\ub7a8\uc744 \ub9c8\ub828\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\ud1b5\uacfc \uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220\uc758 \ubc1c\uc804\uc774 \uc778\uac04\uc758 \uc0dd\ud65c\uacf5\uac04\uc5d0 \uac00\uc838\uc624\ub294 \uac00\uc7a5 \uc9c1\uad00\uc801\uc778 \ubcc0\ud654\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uac04\uacfc \uacf5\uac04\uc758 \uc81c\uc57d\uc774 \uc904\uc5b4\ub4e4\uba74\uc11c \uc0ac\ub78c\ub4e4\uc758 \ud65c\ub3d9 \ubc94\uc704\uac00 \ud06c\uac8c \ud655\ub300\ub41c\ub2e4."
          }
        ]
