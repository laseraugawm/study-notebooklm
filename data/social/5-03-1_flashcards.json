    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ubb3c \uacf5\uc7a5\uc758 \ub3c4\uc785\uc774 \ubbf8\ub798 \uc2dd\ub7c9 \ubb38\uc81c \ud574\uacb0\uc5d0 \uae30\uc5ec\ud558\ub294 \ud575\uc2ec\uc801 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4, \uacc4\uc808 \ub4f1 \uc678\ubd80 \ud658\uacbd\uc758 \uc601\ud5a5 \uc5c6\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \ub9ce\uc740 \uc591\uc758 \uc2dd\ubb3c\uc744 \uc548\uc815\uc801\uc73c\ub85c \uc0dd\uc0b0\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "3856d525-0007-4503-80f5-6404c180a986",
            "alt": "\uc2e4\ub0b4\uc5d0\uc11c \uc218\uc9c1 \uc120\ubc18 \uad6c\uc870\ub85c \uc790\ub3d9 \uc7ac\ubc30\ub418\uace0 \uc788\ub294 \uc2dd\ubb3c \uacf5\uc7a5\uc758 \ub0b4\ubd80 \ubaa8\uc2b5"
          },
          {
            "type": "text",
            "content": "\uc774 \uc0ac\uc9c4\uc774 \ub098\ud0c0\ub0b4\ub294 \ubbf8\ub798 \ub18d\uc5c5 \uae30\uc220 \uc2dc\uc124\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ubb3c \uacf5\uc7a5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc758 \uc9d1\uc774\ub098 \uac74\ubb3c\uc5d0\uc11c \ud0dc\uc591\uad11\u00b7\ud48d\ub825 \ub4f1\uc73c\ub85c \uc0dd\uc0b0\ud55c \uc5d0\ub108\uc9c0\ub97c \uc800\uc7a5\ud558\ub294 \uc2dc\uc124\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\ub108\uc9c0 \uc2a4\ud1a0\ub9ac\uc9c0 (Energy Storage)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\ub108\uc9c0 \uc2a4\ud1a0\ub9ac\uc9c0\uc758 \ud65c\uc6a9 \ud655\ub300\uac00 \uac00\uc838\uc624\ub294 \uae0d\uc815\uc801 \ud6a8\uacfc 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7ac\uc0dd \uc5d0\ub108\uc9c0\uc758 \ud65c\uc6a9\uc744 \ud655\ub300\ud558\uace0 \uc790\uc6d0\uc758 \ub0ad\ube44\ub97c \uc904\uc774\ub294 \ub370 \ub3c4\uc6c0\uc744 \uc900\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "209eb4d7-30b1-4560-b4c8-714ff35c2393",
            "alt": "\uc9c0\ubd95\uc5d0 \ud0dc\uc591\uad11 \ubc1c\uc804 \ud328\ub110\uc774 \ub300\uaddc\ubaa8\ub85c \uc124\uce58\ub41c \uc8fc\ud0dd\uc758 \uc870\uac10\ub3c4"
          },
          {
            "type": "text",
            "content": "\uc774\uc640 \uac19\uc774 \uc790\uac00 \ubc1c\uc804\ud55c \uc804\ub825\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uae30 \uc704\ud574 \ud568\uaed8 \uad6c\ucd95\ub418\ub294 \uc5d0\ub108\uc9c0 \uc800\uc7a5 \uc2dc\uc124\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\ub108\uc9c0 \uc2a4\ud1a0\ub9ac\uc9c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c\uc758 \uc0dd\ud0dc\ud658\uacbd\uc774 \uc545\ud654\ub420 \uac83\uc73c\ub85c \uc608\uce21\ub418\ub294 \uc8fc\uc694 \uc0ac\ud68c\uc801 \uc6d0\uc778 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c \uc131\uc7a5, \uc778\uad6c \uc99d\uac00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \ud658\uacbd \uc624\uc5fc\uc774 \uadf9\uc2ec\ud574\uc838 \uc9c0\uad6c\uc5d0 \uce58\uba85\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uac8c \ub418\ub294 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd \uc624\uc5fc \uc218\uc900\uc774 \uc9c0\uad6c\uc758 \uc790\uc815 \ub2a5\ub825\uc744 \ub2a5\uac00\ud560 \ub54c \uc2ec\uac01\ud574\uc9c4\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uad6c \uc628\ub09c\ud654 \uc2ec\ud654\ub85c \uc778\ud574 \uac00\uc18d\ud654\ub418\uba74\uc11c \ubaa8\ub4e0 \uc0dd\ubb3c\uccb4\uc758 \uc0dd\uc874\uc744 \uc704\ud611\ud558\ub294 3\uac00\uc9c0 \ud604\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4\ubcc0\ud654, \uc5f4\ub300\ub9bc \ud30c\uad34, \uc0ac\ub9c9\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c\uc5d0\uc11c \ubc1c\uc804\ub41c \uacfc\ud559\uae30\uc220\uc744 \ud65c\uc6a9\ud558\uc5ec \ud658\uacbd \uc624\uc5fc\uc744 \uac1c\uc120\ud558\ub294 2\uac00\uc9c0 \uc218\ub2e8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce5c\ud658\uacbd \uad50\ud1b5\uc218\ub2e8 \uac1c\ubc1c, \uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uc0ac\uc6a9 \ud655\ub300"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc804\uc790 \uc5f0\uad6c \ub4f1 \uacfc\ud559\uae30\uc220\uc744 \ud65c\uc6a9\ud558\uc5ec \uba78\uc885\ub418\uac70\ub098 \uc704\uae30\uc5d0 \ucc98\ud55c \uc0dd\ubb3c\uc5d0 \ub300\ud574 \uc9c4\ud589\ud558\ub294 \uacfc\ud559\uc801 \uc2dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\uc885 \ubcf5\uc6d0 \uc0ac\uc5c5 (\uc608: \uba78\uc885\ub41c \ub9e4\uba38\ub4dc \uc720\uc804\uc790 \uc5f0\uad6c\ub97c \ud1b5\ud55c \ubcf5\uc6d0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "7b08b41b-d482-4091-9177-7686312f7e87",
            "alt": "\ub208 \ub36e\uc778 \uc124\uc6d0\uc744 \uac70\ub2c8\ub294 \ub9e4\uba38\ub4dc\uc758 \uc608\uc0c1 \uadf8\ub798\ud53d \ubcf5\uc6d0\ub3c4"
          },
          {
            "type": "text",
            "content": "\uc774 \uadf8\ub9bc\uc740 \uacfc\ud559\uc790\ub4e4\uc774 \uc798 \ubcf4\uc874\ub41c \ud138 \uc720\uc804\uc790\ub97c \ud65c\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc911\uc778 \uc5b4\ub5a0\ud55c \uc0ac\uc5c5\uc744 \ub098\ud0c0\ub0b4\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba78\uc885\ub41c \uc0dd\ubb3c\uc885(\ub9e4\uba38\ub4dc) \ubcf5\uc6d0 \uc0ac\uc5c5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c4\uc2ec \ub0b4\uc5d0\uc11c \ubb34\uc778\uae30(\ub4dc\ub860)\ub098 \ud558\ub298\uc744 \ub098\ub294 \uc624\ud1a0\ubc14\uc774 \ub4f1\uc744 \ud65c\uc6a9\ud558\ub294 \uc18c\ud615 \ud56d\uacf5 \uad50\ud1b5\uccb4\uacc4\ub97c \uc57d\uc5b4\ub85c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "UAM (Urban Air Mobility, \ub3c4\uc2ec \ud56d\uacf5 \uad50\ud1b5\uc218\ub2e8)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "111d5f71-4c1e-4071-b2f8-ad636bcce570",
            "alt": "\ub3c4\uc2dc \ube4c\ub529 \uc232 \uc704\ub97c \ube44\ud589 \uc911\uc778 \ud0d1\uc2b9\uc6a9 \ubb34\uc778\uae30(\ub4dc\ub860) \ud0dd\uc2dc"
          },
          {
            "type": "text",
            "content": "\ubbf8\ub798 \ub3c4\uc2dc\uc5d0\uc11c \uc6d0\ud558\ub294 \ubaa9\uc801\uc9c0\uae4c\uc9c0 \ube60\ub974\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\ub3c4\ub85d \uc0c1\uc6a9\ud654\ub420 \uc774\ub3d9 \uc218\ub2e8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc778\uae30(\ub4dc\ub860) \ud0dd\uc2dc \ubc0f \uc18c\ud615 \ub3c4\uc2ec \ud56d\uacf5 \uad50\ud1b5\uc218\ub2e8(UAM)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2f1\uac00\ud3ec\ub974\uac00 '\uc790\uc5f0 \uc18d \ub3c4\uc2dc'\ub97c \ubaa9\ud45c\ub85c \uc2dc\ud589\ud558\uace0 \uc788\ub294 \uce5c\ud658\uacbd \ub3c4\uc2dc \uc815\ucc45\uc758 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uacfc \uc790\uc5f0\uc774 \uacf5\uc874\ud558\ub294 \ub3c4\uc2dc \uacbd\uad00\uc744 \uc870\uc131\ud558\uace0, \uc790\uccb4 \uac1c\ubc1c\ud55c \ub3c4\uc2dc \uc124\uacc4 \ub3c4\uad6c\ub85c \ub3c4\uc2dc \uc5f4\uc12c \ud604\uc0c1 \ub4f1 \ub3c4\uc2dc \ubb38\uc81c\ub97c \ud574\uacb0\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "c69cff77-49a4-44ae-9729-471588638b50",
            "alt": "\uc2f1\uac00\ud3ec\ub974\uc758 \uac00\ub4e0\uc2a4 \ubc14\uc774 \ub354 \ubca0\uc774 \ub4f1 \ub179\uc9c0\uc640 \ub3c4\uc2dc \uac74\ubb3c\uc774 \uc870\ud654\ub97c \uc774\ub8ec \ud48d\uacbd"
          },
          {
            "type": "text",
            "content": "\uc774 \uc0ac\uc9c4\uc740 \uc5b4\ub290 \uad6d\uac00\uc758 \ub300\ud45c\uc801\uc778 '\uce5c\ud658\uacbd \ub3c4\uc2dc(\uc790\uc5f0 \uc18d \ub3c4\uc2dc)' \uc0ac\ub840\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2f1\uac00\ud3ec\ub974"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub374\ub9c8\ud06c \ucf54\ud39c\ud558\uac90\uc758 '\uc544\ub9c8\uac8c\ub974 \ubc14\ucee4(Amager Bakke)' \uc2dc\uc124\uc774 \uce5c\ud658\uacbd \uc5d0\ub108\uc9c0 \ubaa8\ub378\ub85c \ud3c9\uac00\ubc1b\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3d0\uae30\ubb3c\uc744 \ud0dc\uc6cc \uc804\ub825\uc744 \uc0dd\uc0b0\ud558\uace0, \uc8fc\ubcc0 \uc9c0\uc5ed\uc5d0 \uc804\uae30\u00b7\ub09c\ubc29\u00b7\uc628\uc218\ub97c \uacf5\uae09\ud558\uc5ec \ud658\uacbd\uacfc \uc5d0\ub108\uc9c0 \ubb38\uc81c\uc5d0 \ub3d9\uc2dc\uc5d0 \ub300\uc751\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "97822036-c9b4-4e9d-a104-f387cd20c796",
            "alt": "\uac74\ubb3c \uc625\uc0c1\uc5d0 \ub179\uc9c0\uac00 \uc870\uc131\ub41c \ub374\ub9c8\ud06c \ucf54\ud39c\ud558\uac90\uc758 \uc544\ub9c8\uac8c\ub974 \ubc14\ucee4 \uc18c\uac01\uc7a5 \ubc0f \ubc1c\uc804\uc18c \uc804\uacbd"
          },
          {
            "type": "text",
            "content": "\ud3d0\uae30\ubb3c \uc18c\uac01\uacfc \uc5d0\ub108\uc9c0 \uc0dd\uc0b0\uc744 \uc5f0\uacc4\ud55c \uc774 \uc2dc\uc124\uc758 \uc774\ub984\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub9c8\uac8c\ub974 \ubc14\ucee4 (Amager Bakke)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c \uc608\uce21\uc5d0\uc11c \uc815\ubd80, \uae30\uc5c5, \uac1c\uc778\uc774 \uac00\uc9c0\ub294 \uc8fc\uccb4\ubcc4 \uc8fc\uc694 \ub300\uc751 \uacfc\uc81c\ub97c \ube44\uad50\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \uc815\ubd80: \uc0c8\ub85c\uc6b4 \uc5d0\ub108\uc9c0\u00b7\ud658\uacbd \uc815\ucc45 \uc218\ub9bd \ubc0f \uc704\ud5d8 \ub300\ube44\n\u2022 \uae30\uc5c5: \uc2dc\uc7a5 \ubcc0\ud654 \uc608\uce21 \ubc0f \uc704\uae30\uad00\ub9ac \uc804\ub7b5 \uc218\ub9bd\n\u2022 \uac1c\uc778: \uae30\uc220 \ubc1c\uc804\uc5d0 \ub9de\ucd98 \uc804\ubb38\uc131 \uac15\ud654 \ubc0f \uc0c8 \uc9c1\uc5c5 \uc900\ube44"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uae30\uc220 \ubc1c\uc804\uc774 \uac00\uc838\uc624\ub294 \uae0d\uc815\uc801 \uc601\ud5a5\uacfc \ubd80\uc815\uc801 \uc601\ud5a5\uc744 '\uc0dd\uba85 \uacf5\ud559' \uce21\uba74\uc5d0\uc11c \ube44\uad50\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \uae0d\uc815\uc801 \uc601\ud5a5: \uc218\uba85 \uc5f0\uc7a5, \uc2dd\ub7c9 \ubb38\uc81c \ud574\uacb0, \uba78\uc885 \uc0dd\ubb3c\uc885 \ubcf5\uc6d0\n\u2022 \ubd80\uc815\uc801 \uc601\ud5a5: \uc0dd\uba85 \ubcf5\uc81c\u00b7\uc720\uc804\uc790 \uce58\ub8cc\uc5d0 \ub530\ub978 \uc778\uac04 \uc815\uccb4\uc131 \ubc0f \ub3c4\ub355\uc801 \uac00\uce58\uc758 \ud63c\ub780"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220(ICT) \ubc1c\ub2ec\uc758 \uae0d\uc815\uc801 \uce21\uba74\uacfc \ubd80\uc815\uc801 \uce21\uba74\uc744 \ube44\uad50\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \uae0d\uc815\uc801 \uce21\uba74: \uc2dc\uacf5\uac04 \uc81c\uc57d \uac10\uc18c, \ud65c\ub3d9 \ubc94\uc704 \ud655\ub300, \uc0b6\uc758 \ud3b8\uc758\uc131 \ud5a5\uc0c1\n\u2022 \ubd80\uc815\uc801 \uce21\uba74: \uc815\ubcf4 \uaca9\ucc28, \uc778\ud130\ub137 \uc911\ub3c5, \uc804\uc790 \uac10\uc2dc, \ub370\uc774\ud130 \ud3b8\ud5a5\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0dd\ud0dc\ud658\uacbd \ubcc0\ud654\uc5d0\uc11c \uc6b0\ub824\ub418\ub294 '\uc704\ud611 \uc694\uc778'\uacfc \uc774\uc5d0 \ub300\ucc98\ud558\ub294 '\uacfc\ud559\uae30\uc220\uc801 \ud574\uacb0\ucc45'\uc744 \ube44\uad50\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \uc704\ud611 \uc694\uc778: \uc790\uc6d0 \uace0\uac08, \uc790\uc815 \ub2a5\ub825\uc744 \ucd08\uacfc\ud55c \uc624\uc5fc, \uc628\ub09c\ud654\u00b7\uc5f4\ub300\ub9bc\ud30c\uad34\u00b7\uc0ac\ub9c9\ud654\n\u2022 \ud574\uacb0\ucc45: \uce5c\ud658\uacbd \uad50\ud1b5\uc218\ub2e8, \uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \ud655\ub300, \uc0dd\ubb3c\uc885 \ubcf5\uc6d0, \uc0dd\ud0dc\uacc4 \ub370\uc774\ud130 \uad00\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
