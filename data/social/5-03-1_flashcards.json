      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ubc1c\ubc14\ub974 \uad6d\uc81c \uc885\uc790 \uc800\uc7a5\uace0 \ub0b4\ubd80\uc5d0 \ubcf4\uc874 \ucc98\ub9ac\ub418\uc5b4 \uc800\uc7a5\ub41c \uc528\uc557 \uc0d8\ud50c\uc758 \ubaa8\uc2b5\uc774\ub2e4."
