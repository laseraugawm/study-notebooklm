      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub5a4 \uc778\uad6c \uc9d1\ub2e8\uc758 \uc5f0\ub839\ubcc4\u00b7\uc131\ubcc4 \ub4f1\uc758 \uc778\uad6c \uad6c\uc131 \uc0c1\ud0dc"
          }
        ]
