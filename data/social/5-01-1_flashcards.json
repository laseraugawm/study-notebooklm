{
  "title": "\uc778\uad6c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\ud559 \ubc0f \uc9c0\ub9ac\ud559\uc5d0\uc11c '\uc778\uad6c'\uc758 \uae30\ubcf8 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub5a4 \ud2b9\uc815\ud55c \uc2dc\uc810\uc5d0 \uc77c\uc815 \uc9c0\uc5ed\uc5d0 \uc0ac\ub294 \uc0ac\ub78c\uc758 \uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \uaddc\ubaa8\ub97c \ubcc0\ud654\uc2dc\ud0a4\ub294 \ub450 \uac00\uc9c0 \uc8fc\uc694 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\uc801 \uc694\uc778(\ucd9c\uc0dd, \uc0ac\ub9dd)\uacfc \uc0ac\ud68c\uc801 \uc694\uc778(\uc804\ucd9c, \uc804\uc785)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c\uc758 \uc0ac\ud68c\uc801 \uc774\ub3d9\uc5d0\uc11c '\uc804\ucd9c'\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc804 \uac70\uc8fc\uc9c0\uc5d0\uc11c \uc0c8 \uac70\uc8fc\uc9c0\ub85c \uc62e\uaca8 \uac00\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c\uc758 \uc0ac\ud68c\uc801 \uc774\ub3d9\uc5d0\uc11c '\uc804\uc785'\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc804 \uac70\uc8fc\uc9c0\uc5d0\uc11c \uc0c8 \uac70\uc8fc\uc9c0\ub85c \uc62e\uaca8 \uc624\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "18\uc138\uae30 \uc0b0\uc5c5 \ud601\uba85 \uc774\ud6c4 \uc138\uacc4 \uc778\uad6c\uac00 \uae09\uaca9\ud788 \uc99d\uac00\ud55c \uc8fc\uc694 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud65c \ud658\uacbd \uac1c\uc120, \uc758\ub8cc \uae30\uc220 \ubc1c\ub2ec, \uacf5\uacf5 \uc704\uc0dd \uc2dc\uc124 \uac1c\uc120\uc73c\ub85c \ud3c9\uade0 \uc218\uba85\uc774 \ub298\uace0 \uc0ac\ub9dd\ub960\uc774 \ub0ae\uc544\uc84c\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc9c4\uad6d\uc758 \uc778\uad6c \uc131\uc7a5 \ucd94\uc774 \ubcc0\ud654 \uacfc\uc815\uc740 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "18\uc138\uae30 \ub9d0\uc5d0\uc11c 20\uc138\uae30 \ucd08\uae4c\uc9c0 \ube60\ub974\uac8c \ub298\uc5c8\uc73c\ub098, 20\uc138\uae30 \uc911\ubc18 \uc774\ud6c4 \ucd9c\uc0dd\ub960\uc774 \uac10\uc18c\ud558\uba74\uc11c \uc778\uad6c\uac00 \uc815\uccb4\ub418\uac70\ub098 \uc904\uace0 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \uc778\uad6c \uc131\uc7a5\uc774 \uae09\uaca9\ud788 \uc774\ub8e8\uc5b4\uc9c4 \uc2dc\uae30\uc640 \uadf8 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 \uc774\ud6c4\uc778 20\uc138\uae30 \uc911\ubc18\ubd80\ud130 \uae09\uc99d\ud558\uc600\uc73c\uba70, \uc0ac\ub9dd\ub960\uc740 \ub300\uccb4\ub85c \ub0ae\uc544\uc84c\uc73c\ub098 \ucd9c\uc0dd\ub960\uc774 \uc5ec\uc804\ud788 \ub192\uc544 \uc778\uad6c \uc99d\uac00\uc728\uc774 \ub192\uac8c \ub098\ud0c0\ub09c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5a5\ud6c4 \uc138\uacc4 \uc778\uad6c \uc131\uc7a5\uc744 \uc8fc\ub3c4\ud560 \uac83\uc73c\ub85c \uc608\uc0c1\ub418\ub294 \ub300\ub959/\uc9c0\uc5ed\ub4e4\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ud504\ub9ac\uce74, \uc544\uc2dc\uc544, \uc911\uc559 \ubc0f \ub0a8\uc544\uba54\ub9ac\uce74 \ub4f1\uc9c0\uc758 \uac1c\ubc1c\ub3c4\uc0c1\uad6d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \ubcc0\ucc9c \ubaa8\ud615\uc740 \ubb34\uc5c7\uc758 \ubcc0\ud654\ub97c \ubc14\ud0d5\uc73c\ub85c \uc778\uad6c \uc131\uc7a5 \ub2e8\uacc4\ub97c \uad6c\ubcc4\ud55c \uac83\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c \ubc1c\uc804 \uc218\uc900\uc5d0 \ub530\ub978 \ucd9c\uc0dd\ub960\uacfc \uc0ac\ub9dd\ub960\uc758 \ubcc0\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \ubcc0\ucc9c \ubaa8\ud615 1\ub2e8\uacc4(\uace0\uc704 \uc815\uccb4)\uc758 \ucd9c\uc0dd\ub960\uacfc \uc0ac\ub9dd\ub960 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd9c\uc0dd\ub960\uacfc \uc0ac\ub9dd\ub960\uc774 \ubaa8\ub450 \ub192\uc544 \uc778\uad6c \ubcc0\ud654\uac00 \uac70\uc758 \uc5c6\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \ubcc0\ucc9c \ubaa8\ud615 2\ub2e8\uacc4(\ucd08\uae30 \ud33d\ucc3d)\uc5d0\uc11c \uc778\uad6c\uac00 \uae09\uaca9\ud788 \uc99d\uac00\ud558\ub294 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c \uc131\uc7a5\uacfc \uc758\ub8cc \ubc1c\ub2ec \ub4f1\uc73c\ub85c \uc0ac\ub9dd\ub960\uc774 \uae09\uaca9\ud788 \ub0ae\uc544\uc9c0\uc9c0\ub9cc \ucd9c\uc0dd\ub960\uc740 \uc5ec\uc804\ud788 \ub192\uac8c \uc720\uc9c0\ub418\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \ubcc0\ucc9c \ubaa8\ud615 3\ub2e8\uacc4(\ud6c4\uae30 \ud33d\ucc3d)\uc758 \ucd9c\uc0dd\ub960 \ubcc0\ud654 \uc6d0\uc778\uacfc \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \uc5b5\uc81c \uc815\ucc45 \ub4f1\uc5d0 \uc758\ud574 \ucd9c\uc0dd\ub960\uc774 \ub0ae\uc544\uc9c0\uae30 \uc2dc\uc791\ud558\uba70, \uc778\uad6c \uc99d\uac00\uc728\uc740 \ub454\ud654\ub418\ub098 \uc778\uad6c\ub294 \uc9c0\uc18d\uc801\uc73c\ub85c \uc99d\uac00\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \ubcc0\ucc9c \ubaa8\ud615 4\ub2e8\uacc4(\uc800\uc704 \uc815\uccb4)\uc758 \ucd9c\uc0dd\ub960\uacfc \uc0ac\ub9dd\ub960 \ubc0f \uc778\uad6c \ubcc0\ud654 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd9c\uc0dd\ub960\uacfc \uc0ac\ub9dd\ub960\uc774 \ubaa8\ub450 \ub0ae\uace0, \uc778\uad6c \uc99d\uac00\uac00 \uc815\uccb4\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \ubcc0\ucc9c \ubaa8\ud615 5\ub2e8\uacc4(\uac10\uc18c)\uc5d0\uc11c \uc778\uad6c\uac00 \uac10\uc18c\ud558\ub294 \uc9c1\uc811\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd9c\uc0dd\ub960\uc774 \uc0ac\ub9dd\ub960\ubcf4\ub2e4 \ub354 \ub0ae\uc544\uc9c0\uba74\uc11c \uc778\uad6c\uc758 \uc790\uc5f0\uc801 \uac10\uc18c\uac00 \ub098\ud0c0\ub098\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\ud1b5\uc801\uc73c\ub85c \uc778\uad6c \ubd84\ud3ec\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce5c \ub300\ud45c\uc801\uc778 \uc790\uc5f0\uc801 \uc694\uc778 4\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4, \uc9c0\ud615, \uc2dd\uc0dd, \ud1a0\uc591"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc544\uc2dc\uc544, \ub3d9\ub0a8\uc544\uc2dc\uc544, \ub0a8\ubd80 \uc544\uc2dc\uc544 \uc9c0\uc5ed\uc5d0 \uc778\uad6c \ubc00\uc9d1\ub3c4\uac00 \ub192\uc740 \ud575\uc2ec \ub18d\uc5c5\uc801 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \ubd80\uc591\ub825\uc774 \ub192\uc740 \ubcbc\ub18d\uc0ac\uac00 \ubc1c\ub2ec\ud588\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\uc801 \uc694\uc778 \uc911 \uc778\uac04\uc774 \uac70\uc8fc\ud558\uae30\uc5d0 \ubd88\ub9ac\ud558\uc5ec \uc778\uad6c\uac00 \ud76c\ubc15\ud55c \uc9c0\uc5ed\uc758 \uae30\ud6c4 \ubc0f \uc9c0\ud615 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac74\uc870\u00b7\ud55c\ub300 \uae30\ud6c4 \uc9c0\uc5ed, \ud5d8\uc900\ud55c \uc0b0\uc9c0 \ubc0f \uace0\uc6d0 \uc9c0\uc5ed"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub298\ub0a0 \uc778\uad6c \ubd84\ud3ec\uc5d0 \ub9ce\uc740 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \uc694\uc778\uc5d0\ub294 \uc5b4\ub5a4 \uac83\ub4e4\uc774 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc5c5, \uad50\ud1b5, \ubb38\ud654, \uad50\uc721, \uc77c\uc790\ub9ac, \uc0ac\ud68c \uae30\ubc18 \uc2dc\uc124"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub298\ub0a0 \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \uc694\uc778\uc5d0 \uc758\ud574 \uc778\uad6c\uac00 \ubc00\uc9d1\ud558\ub294 \uc9c0\uc5ed\uc758 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\ud1b5\uacfc \uc0b0\uc5c5\uc774 \ubc1c\ub2ec\ud558\uace0 \uad50\uc721 \uc5ec\uac74\uacfc \ubb38\ud654 \uc2dc\uc124\uc774 \uc798 \uac16\ucd94\uc5b4\uc9c4 \ub300\ub3c4\uc2dc\uc640 \uc120\uc9c4\uad6d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc704\ub3c4\uc0c1\uc73c\ub85c \ubcfc \ub54c \uc138\uacc4 \uc778\uad6c\uc758 \ub300\ubd80\ubd84\uc740 \uc5b4\ub290 \ubc18\uad6c\uc5d0 \uc9d1\uc911\ub418\uc5b4 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd81\ubc18\uad6c (\ud2b9\ud788 \ubd81\ubc18\uad6c \uc911\uc704\ub3c4 \uc9c0\uc5ed)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\uc5d0\uc11c \uc778\uad6c\uac00 \ub9ce\uace0 \uc778\uad6c \ubc00\ub3c4\uac00 \ub192\uc740 \ub300\ud45c\uc801\uc778 4\ub300 \ubc00\uc9d1 \uc9c0\uc5ed\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc544\uc2dc\uc544, \ub0a8\ubd80 \uc544\uc2dc\uc544, \uc11c\uc720\ub7fd, \ubbf8\uad6d \ubd81\ub3d9\ubd80"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \ub300\ub959 \uc911 \uc778\uad6c \ube44\uc728\uc774 \uac00\uc7a5 \ub192\uc740 \ub300\ub959\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\uc2dc\uc544 (\uc138\uacc4 \uc778\uad6c\uc758 \uc808\ubc18 \uc774\uc0c1\uc778 \uc57d 59.4% \ucc28\uc9c0)"
