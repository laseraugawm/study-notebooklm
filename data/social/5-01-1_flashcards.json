    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c\ud559\uc5d0\uc11c '\uc778\uad6c \uad6c\uc870'\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
