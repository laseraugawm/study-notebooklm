            "alt": "\ub208\uacfc \ube59\ud558\ub85c \ub36e\uc5ec \uc9d1\ub4e4\uc774 \ub4dc\ubb3c\uac8c \uc704\uce58\ud55c \uadf8\ub9b0\ub780\ub4dc \ub9c8\uc744"
