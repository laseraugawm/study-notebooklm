    {
      "type": "multiple_choice",
      "question": "1900\ub144\uc5d0 \ubc18\ud3ec\ub41c \ub300\ud55c \uc81c\uad6d \uce59\ub839 \uc81c41\ud638\uc758 \uc8fc\uc694 \ub0b4\uc6a9\uacfc \uc758\uc758\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
