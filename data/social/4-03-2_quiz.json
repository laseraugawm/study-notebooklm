{
  "title": "\ub3d9\uc544\uc2dc\uc544\uc5ed\uc0ac \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \ub3c5\ub3c4\uac00 \uc6b0\ub9ac\ub098\ub77c\uc758 \uace0\uc720 \uc601\ud1a0\uc784\uc744 \uc785\uc99d\ud558\ub294 \uc5ed\uc0ac\uc801 \uc0ac\ub8cc \ubc0f \ubb38\ud5cc\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "1785\ub144 \uc77c\ubcf8 \uc9c0\ub9ac\ud559\uc790 \ud558\uc57c\uc2dc \uc2dc\ud5e4\uc774\uac00 \uadf8\ub9b0 \u300c\uc0bc\uad6d\uc811\uc591\uc9c0\ub3c4\u300d\ub294 \uc6b8\ub989\ub3c4\uc640 \ub3c5\ub3c4\ub97c \uc870\uc120\uacfc \uac19\uc740 \uc0c9\uc73c\ub85c \ud45c\uc2dc\ud558\uace0 '\uc870\uc120\uc758 \uac83'\uc774\ub77c\uace0 \uba85\uc2dc\ud558\uc600\ub2e4.",
          "rationale": "\uc77c\ubcf8\uc778 \uc9c0\ub9ac\ud559\uc790\uac00 \uc791\uc131\ud55c \uc9c0\ub3c4\uc784\uc5d0\ub3c4 \uc6b8\ub989\ub3c4\uc640 \ub3c5\ub3c4\ub97c \uc870\uc120\uc758 \uc601\ud1a0\ub85c \uba85\ud655\ud788 \uc778\uc2dd\ud558\uc5ec \ud45c\uae30\ud588\uc74c\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uacb0\uc815\uc801 \uc0ac\ub8cc\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\u300e\uc138\uc885\uc2e4\ub85d\uc9c0\ub9ac\uc9c0\u300f(1454)\ub294 \ub3c5\ub3c4\uac00 \uc6b8\ub989\ub3c4\uc640 \uba40\ub9ac \ub5a8\uc5b4\uc838 \uc788\uc5b4 \uc721\uc548\uc73c\ub85c \uad00\ucc30\ud560 \uc218 \uc5c6\ub2e4\uace0 \uae30\ub85d\ud558\uc600\ub2e4.",
          "rationale": "\u300e\uc138\uc885\uc2e4\ub85d\uc9c0\ub9ac\uc9c0\u300f\uc5d0\ub294 \uc6b8\ub989\ub3c4\uc640 \ub3c5\ub3c4 \ub450 \uc12c\uc758 \uac70\ub9ac\uac00 \uba40\uc9c0 \uc54a\uc544 \ub0a0\uc528\uac00 \ub9d1\uc73c\uba74 \uc11c\ub85c \ubc14\ub77c\ubcfc \uc218 \uc788\ub2e4\uace0 \uba85\uc2dc\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "1877\ub144 \ud0dc\uc815\uad00 \uc9c0\ub839\ubb38\uc740 \ub3c5\ub3c4\uac00 \uc9c0\ub9ac\uc801\uc73c\ub85c \uc77c\ubcf8 \ubcf8\ud1a0\uc5d0 \uac00\uae4c\uc6cc \uc77c\ubcf8 \uc601\ud1a0\ub85c \uad00\ud560\ud568\uc744 \ud655\uc778\ud55c \ubb38\uc11c\uc774\ub2e4.",
          "rationale": "\ud0dc\uc815\uad00 \uc9c0\ub839\ubb38\uc740 \ub2f9\uc2dc \uc77c\ubcf8 \uc815\ubd80\uc758 \ucd5c\uace0 \ud589\uc815 \uae30\uad00\uc774 \uc6b8\ub989\ub3c4\uc640 \ub3c5\ub3c4\uac00 \uc77c\ubcf8 \uc601\ud1a0\uc640 \uad00\uacc4\uac00 \uc5c6\uc74c\uc744 \uacf5\uc2dd \uc9c0\ub839\uc73c\ub85c \ubc1d\ud78c \ubb38\uc11c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "1900\ub144 \ub300\ud55c \uc81c\uad6d \uce59\ub839 \uc81c41\ud638\ub294 \ub3c5\ub3c4\ub97c \uac15\uc81c\ub85c \uc77c\ubcf8 \uc2dc\ub9c8\ub124\ud604\uc758 \uad00\ud560\ub85c \ub118\uaca8\uc8fc\ub294 \ub0b4\uc6a9\uc744 \ub2f4\uace0 \uc788\ub2e4.",
          "rationale": "\ub300\ud55c \uc81c\uad6d \uce59\ub839 \uc81c41\ud638\ub294 \uc6b8\ub989\ub3c4\ub97c \uc6b8\ub3c4\uad70\uc73c\ub85c \uaca9\uc0c1\ud558\uace0 \ub3c5\ub3c4(\uc11d\ub3c4)\ub97c \uc6b8\ub3c4\uad70\uc758 \uad00\ud560 \uad6c\uc5ed\uc73c\ub85c \uba85\uc2dc\ud558\uc5ec \uc6b0\ub9ac \uc8fc\uad8c\uc744 \uc120\ud3ec\ud55c \ubc95\ub839\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc77c\ubcf8 \uc9c0\ub9ac\ud559\uc790\uac00 \uc791\uc131\ud55c \uc61b \uc9c0\ub3c4\uc5d0\uc11c \uc6b8\ub989\ub3c4\uc640 \ub3c5\ub3c4\ub97c \uc5b4\ub5bb\uac8c \ub2e4\ub8e8\uc5c8\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc911\uad6d\uc774 2002\ub144\ubd80\ud130 \ucd94\uc9c4\ud55c \ub3d9\ubd81 \uacf5\uc815(\u6771\u5317\u5de5\u7a0b)\uacfc \uc774\ub85c \uc778\ud55c \uc5ed\uc0ac \uac08\ub4f1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub3d9\ubd81 3\uc131 \uc9c0\uc5ed\uc758 \uc5ed\uc0ac\ub97c \uc5f0\uad6c\ud558\uba74\uc11c \uace0\uc870\uc120, \uace0\uad6c\ub824, \ubc1c\ud574\uc758 \uc5ed\uc0ac\uc640 \ubb38\ud654\ub97c \uc790\uad6d \uc5ed\uc0ac\uc758 \uc77c\ubd80\ub85c \ud3b8\uc785\uc2dc\ud0a4\ub824\ub294 \uc65c\uace1\uc744 \ud3bc\ucce4\ub2e4.",
          "rationale": "\uc911\uad6d\uc740 \uc18c\uc218 \ubbfc\uc871 \ud1b5\ud569 \ubc0f \uc601\ud1a0 \uacf5\uace0\ud654\ub97c \ubaa9\uc801\uc73c\ub85c \ud55c\ubc18\ub3c4 \ubd81\ubd80\uc640 \ub9cc\uc8fc \uc9c0\uc5ed\uc5d0 \uc874\uc7ac\ud588\ub358 \ud55c\uad6d \uace0\ub300 \uad6d\uac00\uc758 \uc5ed\uc0ac\ub97c \uc790\uad6d \uc5ed\uc0ac\uc758 \uc77c\ubd80\ub85c \uc8fc\uc7a5\ud558\uc600\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud55c\u00b7\uc911\u00b7\uc77c 3\uad6d \ud559\uc790\ub4e4\uc774 \uacf5\ub3d9\uc73c\ub85c \ubaa8\uc5ec \ub3d9\uc544\uc2dc\uc544\uc758 \ud3c9\ud654\ub97c \uc704\ud55c \ud1b5\uc0ac \uad50\uc7ac\ub97c \ud3b8\ucc2c\ud558\uae30 \uc704\ud574 \uc2dc\uc791\ub41c \ud504\ub85c\uc81d\ud2b8\uc774\ub2e4.",
          "rationale": "\ub3d9\ubd81 \uacf5\uc815\uc740 3\uad6d \ud569\uc791 \ud504\ub85c\uc81d\ud2b8\uac00 \uc544\ub2c8\ub77c \uc911\uad6d\uc774 \ub3d9\ubd81 3\uc131\uc758 \uc5ed\uc0ac\uc640 \ubbfc\uc871\uc744 \uc5f0\uad6c\ud558\uba70 \uc790\uad6d \uc911\uc2ec\uc73c\ub85c \uc5ed\uc0ac\ub97c \uc65c\uace1\ud55c \uc815\ubd80 \uc8fc\ub3c4 \uc0ac\uc5c5\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uace0\uad6c\ub824\uc758 \uc131\uc744 \ub9cc\ub9ac\uc7a5\uc131\uc758 \uc77c\ubd80\ub77c\ub294 \uc8fc\uc7a5\uc744 \ucca0\ud68c\ud558\uace0 \ud55c\uad6d \uace0\ub300\uc0ac\uc758 \ub3c5\uc790\uc131\uc744 \uacf5\uc2dd \uc2b9\uc778\ud55c \uc5f0\uad6c \uc870\uce58\uc774\ub2e4.",
          "rationale": "\uc911\uad6d\uc740 \uace0\uad6c\ub824\uc758 \uc131\uc744 \ub9cc\ub9ac\uc7a5\uc131\uc758 \uc77c\ubd80\ub77c\uace0 \uc8fc\uc7a5\ud558\uace0 \uace0\uad6c\ub824\u00b7\ubc1c\ud574 \uc720\ubb3c\uc744 \uc790\uad6d \uc720\ubb3c\ub85c \uc18c\uac1c\ud558\uba70 \uc5ed\uc0ac \uc65c\uace1\uc744 \uc9c0\uc18d\ud558\uc600\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "1998\ub144 \ud55c\uc77c \uc815\uc0c1 \uac04\uc5d0 \ud569\uc758\ub41c \ub0b4\uc6a9\uc73c\ub85c, \uc18c\uc218 \ubbfc\uc871\uc758 \uc5ed\uc0ac\ub97c \uac01\uad6d\uc758 \uace0\uc720 \uc5ed\uc0ac\ub85c \uc874\uc911\ud558\uae30\ub85c \ud55c \ud611\uc815\uc774\ub2e4.",
          "rationale": "1998\ub144 \ud611\uc815\uc740 \ud55c\uad6d\uacfc \uc77c\ubcf8 \uc815\uc0c1 \uac04 \ubc1c\ud45c\ub41c '\ud55c\uc77c \ud30c\ud2b8\ub108\uc2ed \uacf5\ub3d9 \uc120\uc5b8'\uc774\uba70 \uc911\uad6d\uc758 \ub3d9\ubd81 \uacf5\uc815\uacfc\ub294 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc911\uad6d\uc774 \ub3d9\ubd81 3\uc131 \uc9c0\uc5ed\uc744 \uc5f0\uad6c\ud558\uba74\uc11c \ud55c\uad6d \uace0\ub300 \uad6d\uac00\ub4e4\uc758 \uc5ed\uc0ac\uc801 \uc704\uce58\ub97c \uc5b4\ub5bb\uac8c \ub2e4\ub8e8\uc5c8\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc77c\ubcf8\uc758 \uc8fc\uc694 \uc815\uce58\uc778\ub4e4\uc774 \uc57c\uc2a4\ucfe0\ub2c8 \uc2e0\uc0ac\ub97c \ucc38\ubc30\ud558\ub294 \ud589\uc704\uac00 \ud55c\uad6d \ubc0f \uc8fc\ubcc0\uad6d\uacfc\uc758 \uc2ec\uac01\ud55c \uac08\ub4f1 \uc6d0\uc778\uc774 \ub418\ub294 \ud575\uc2ec \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc57c\uc2a4\ucfe0\ub2c8 \uc2e0\uc0ac\uc5d0 \uc81c2\ucc28 \uc138\uacc4 \ub300\uc804\uc758 \uc8fc\uc694 \uc804\uc7c1 \ubc94\uc8c4\uc790\ub4e4\uc774 \ud569\uc0ac\ub418\uc5b4 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc804\uc7c1 \ubc94\uc8c4\uc790\ub97c \ucd94\ubaa8\ud558\uace0 \uc12c\uae30\ub294 \ucc38\ubc30 \ud589\uc704\ub294 \uacfc\uac70 \uc8fc\ubcc0\uad6d\ub4e4\uc744 \uce68\ub7b5\ud588\ub358 \uc5ed\uc0ac\ub97c \uc9c4\uc815\uc73c\ub85c \ubc18\uc131\ud558\uc9c0 \uc54a\ub294\ub2e4\ub294 \uc758\ubbf8\ub85c \ubc1b\uc544\ub4e4\uc5ec\uc9c0\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc57c\uc2a4\ucfe0\ub2c8 \uc2e0\uc0ac\uac00 \uc870\uc120\uc778 \uac15\uc81c \uc9d5\uc6a9 \ud53c\ud574\uc790\ub4e4\uc758 \uc720\uace8\ub9cc\uc744 \uc804\ub2f4 \uc548\uce58\ud55c \uc2dc\uc124\uc774\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uac08\ub4f1\uc758 \ud575\uc2ec\uc740 \uc870\uc120\uc778 \uc9d5\uc6a9 \ud53c\ud574\uc790 \uc720\uace8 \ubb38\uc81c\uac00 \uc544\ub2cc, \uc81c2\ucc28 \uc138\uacc4 \ub300\uc804\uc744 \uc77c\uc73c\ud0a8 \uc8fc\uc694 \uc804\ubc94\ub4e4\uc774 \ud568\uaed8 \ud569\uc0ac\ub418\uc5b4 \uc788\ub2e4\ub294 \uc810\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc57c\uc2a4\ucfe0\ub2c8 \uc2e0\uc0ac\uc5d0\uc11c 1905\ub144 \uc2dc\ub9c8\ub124\ud604 \uace0\uc2dc \uc81c40\ud638\ub97c \uacf5\uc2dd \uc81c\uc815\ud558\uace0 \uacf5\ud3ec\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc2dc\ub9c8\ub124\ud604 \uace0\uc2dc \uc81c40\ud638\ub294 \uc77c\ubcf8 \uc2dc\ub9c8\ub124\ud604\uc774\ub77c\ub294 \uc9c0\ubc29 \uc9c0\uc790\uccb4\uc5d0\uc11c \ubc1c\ud45c\ud55c \ud589\uc815 \ubb38\uc11c\uc774\uba70 \uc57c\uc2a4\ucfe0\ub2c8 \uc2e0\uc0ac\uc640 \ubb34\uad00\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc57c\uc2a4\ucfe0\ub2c8 \uc2e0\uc0ac\uac00 \uc911\uad6d\uc758 \ub3d9\ubd81 \uacf5\uc815\uc744 \uc8fc\ub3c4\ud55c \ud559\uc790\ub4e4\uc744 \uae30\ub150\ud558\uae30 \uc704\ud574 \ub9cc\ub4e0 \uc2e0\ub2f9\uc774\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ub3d9\ubd81 \uacf5\uc815\uc740 \uc911\uad6d\uc5d0\uc11c \ucd94\uc9c4\ud55c \uc5ed\uc0ac \uc65c\uace1 \ud504\ub85c\uc81d\ud2b8\uc774\uba70, \uc77c\ubcf8\uc758 \uc57c\uc2a4\ucfe0\ub2c8 \uc2e0\uc0ac\uc640\ub294 \uc544\ubb34\ub7f0 \uc5f0\uad00\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc57c\uc2a4\ucfe0\ub2c8 \uc2e0\uc0ac\uc5d0 \ubd09\uc548\ub418\uc5b4 \uc788\ub294 \ub300\uc0c1\uc758 \uc131\uaca9\uacfc \uadf8\uac83\uc774 \uc2dc\uc0ac\ud558\ub294 \uc5ed\uc0ac\uc801 \ubc18\uc131\uc758 \ud0dc\ub3c4\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc77c\uc81c \uac15\uc810\uae30 \uc870\uc120\uc778 \uac15\uc81c \ub178\uc5ed \ud604\uc7a5\uc774\uc5c8\ub358 \uad70\ud568\ub3c4(\ud558\uc2dc\ub9c8\uc12c)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc77c\ubcf8 \uc815\ubd80\ub294 2015\ub144 \uc138\uacc4\uc720\uc0b0 \ub4f1\uc7ac \ub2f9\uc2dc \uc57d\uc18d\uacfc \ub2ec\ub9ac \uc81c\ucd9c\ud55c \ubcf4\uace0\uc11c\uc5d0\uc11c \uc870\uc120\uc778 \uac15\uc81c \ub178\uc5ed \ubc0f \ucc28\ubcc4 \uc0ac\uc2e4\uc744 \uc7ac\ucc28 \ubd80\uc778\ud558\uc600\ub2e4.",
          "rationale": "\ub4f1\uc7ac \ub2f9\uc2dc \ud76c\uc0dd\uc790\ub97c \uae30\ub9ac\uae30 \uc704\ud55c \uc870\uce58\ub97c \uc57d\uc18d\ud588\uc74c\uc5d0\ub3c4 \uc774\ud6c4 \uc720\ub124\uc2a4\ucf54 \ubcf4\uace0\uc11c\uc5d0\uc11c \ucc28\ubcc4\uacfc \uac15\uc81c \ub178\uc5ed \uc0ac\uc2e4\uc744 \uac70\ubd80\ud558\uc5ec \ub17c\ub780\uc744 \uc77c\uc73c\ucf30\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc77c\ubcf8 \uc815\ubd80\ub294 2015\ub144 \uc138\uacc4\uc720\uc0b0 \ub4f1\uc7ac \uc2dc \uc57d\uc18d\ud588\ub358 \uac15\uc81c \ub178\uc5ed \uc778\uc815\uacfc \ucd94\ubaa8 \uc870\uce58\ub97c \uc131\uc2e4\ud788 \uc774\ud589\ud558\uace0 \uc788\ub2e4.",
          "rationale": "\uc77c\ubcf8 \uce21\uc740 \uc138\uacc4\uc720\uc0b0 \ub4f1\uc7ac \uc774\ud6c4 \uc57d\uc18d\uc744 \uc774\ud589\ud558\uc9c0 \uc54a\uace0 \uc870\uc120\uc778 \ucc28\ubcc4\uacfc \uac15\uc81c \ub178\uc5ed \uc0ac\uc2e4\uc744 \uc7ac\ucc28 \ubd80\uc778\ud558\ub294 \ubcf4\uace0\uc11c\ub97c \uc81c\ucd9c\ud558\uc600\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc720\ub124\uc2a4\ucf54\ub294 \uad70\ud568\ub3c4\ub97c \uace0\uad6c\ub824\uc640 \ubc1c\ud574\uc758 \uc5ed\uc0ac \uc720\uc801\uc774 \ubc00\uc9d1\ub41c \uac70\uc810\uc73c\ub85c \uc778\uc815\ud558\uc5ec \uc138\uacc4\uc720\uc0b0\uc73c\ub85c \ub4f1\uc7ac\ud558\uc600\ub2e4.",
          "rationale": "\uad70\ud568\ub3c4\ub294 \uc77c\uc81c \uac15\uc810\uae30 \uc870\uc120\uc778 \uac15\uc81c \uc9d5\uc6a9 \ud53c\ud574 \ud604\uc7a5\uc774\uba70 \uace0\uad6c\ub824\u00b7\ubc1c\ud574 \uc5ed\uc0ac \uc720\uc801\uacfc\ub294 \uc544\ubb34\ub7f0 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc6b0\ub9ac \uc815\ubd80\ub294 \uad70\ud568\ub3c4 \uc5ed\uc0ac \uc65c\uace1\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud574 2004\ub144 \uc77c\ubcf8 \uc678\ubb34\uc131\uacfc 5\uac1c \uc870\ud56d\uc758 \ud569\uc758\uc11c\ub97c \uccb4\uacb0\ud558\uc600\ub2e4.",
          "rationale": "2004\ub144 5\uac1c \uc870\ud56d \ud569\uc758\uc11c\ub294 \uc911\uad6d\uc758 \ub3d9\ubd81 \uacf5\uc815 \ud655\uc0b0\uc744 \ub9c9\uae30 \uc704\ud574 \ud55c\uad6d\uacfc \uc911\uad6d \uc678\uad50\ubd80 \uac04\uc5d0 \uad50\ud658\ub41c \ud569\uc758\uc11c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "2015\ub144 \uc138\uacc4\uc720\uc0b0 \ub4f1\uc7ac \ub2f9\uc2dc \uc77c\ubcf8\uc774 \uc57d\uc18d\ud588\ub358 \ubc14\uc640 \uc774\ud6c4 \ubcf4\uc5ec\uc900 \uc2e4\uc81c \ud0dc\ub3c4\uc758 \ucc28\uc774\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub3d9\uc544\uc2dc\uc544 \uc5ed\uc0ac \uac08\ub4f1 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc6b0\ub9ac \uc815\ubd80 \ucc28\uc6d0\uc5d0\uc11c \ucd94\uc9c4\ud55c \ub300\uc751 \ub178\ub825\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "2006\ub144 \ub3d9\ubd81\uc544 \uc5ed\uc0ac \uc7ac\ub2e8\uc744 \uc124\ub9bd\ud558\uc5ec \uc77c\ubcf8\uacfc \uc911\uad6d\uc758 \uc5ed\uc0ac \uc65c\uace1\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud55c \uc5f0\uad6c\ub97c \uc9c0\uc6d0\ud558\uc600\ub2e4.",
