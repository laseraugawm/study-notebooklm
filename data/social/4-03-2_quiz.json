        {
          "text": "\ub2e4\uc591\ud55c \ud574\uc591 \uc0dd\ubb3c\uc774 \ubab0\ub824\ub4dc\ub294 \uc11c\uc2dd\uc9c0\ub85c\uc11c \ud574\uc591 \uc0dd\ud0dc\uacc4\uc801 \uac00\uce58\uac00 \ub9e4\uc6b0 \ub192\ub2e4.",
