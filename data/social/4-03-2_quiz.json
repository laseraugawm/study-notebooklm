        {
          "text": "\uc2dc\ub9c8\ub124\ud604 \uace0\uc2dc \uc81c40\ud638\ub97c \uc218\uc6a9\ud558\uc5ec \ub3c5\ub3c4\uc758 \uba85\uce6d\uc744 \uc6b0\uc0b0\ub3c4\uc5d0\uc11c \ubb34\ub989\ub3c4\ub85c \ubcc0\uacbd\ud558\uc600\ub2e4.",
