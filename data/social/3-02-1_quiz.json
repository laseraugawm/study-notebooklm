{
  "title": "\uacbd\uc81c \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ud604\uc7ac \uc5f0\ubd09(\uc6d4\uae09 500\ub9cc \uc6d0, \uc5f0\uac04 6,000\ub9cc \uc6d0)\uc744 \ubc1b\ub294 \ud638\ud154 \uc8fc\ubc29\uc7a5 \uac11\uc774 \uc9c1\uc7a5\uc744 \uadf8\ub9cc\ub450\uace0 \uc608\uc0c1 \uc5f0 \uc218\uc785 3\uc5b5 \uc6d0, \uc5f0\uac04 \uba85\uc2dc\uc801 \ube44\uc6a9 2\uc5b5 5,000\ub9cc \uc6d0\uc778 \uc74c\uc2dd\uc810\uc744 \ucc3d\uc5c5\ud558\ub824\uace0 \uace0\ubbfc \uc911\uc774\ub2e4. \uc774 \uc0c1\ud669\uc5d0 \ub300\ud55c \uacbd\uc81c\uc801 \ubd84\uc11d\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc74c\uc2dd\uc810 \uc6b4\uc601\uc5d0 \ub530\ub978 \uae30\ud68c\ube44\uc6a9\uc740 \ucd1d 3\uc5b5 1,000\ub9cc \uc6d0\uc774\ubbc0\ub85c, \ucc3d\uc5c5 \uacb0\uc815\uc740 \ube44\ud569\ub9ac\uc801\uc778 \uc120\ud0dd\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uae30\ud68c\ube44\uc6a9\uc740 \uc2e4\uc81c\ub85c \uc9c0\ucd9c\ud558\ub294 \uba85\uc2dc\uc801 \ube44\uc6a9(2\uc5b5 5,000\ub9cc \uc6d0)\uacfc \ud3ec\uae30\ud55c \uc9c1\uc7a5 \uc18c\ub4dd\uc778 \uc554\ubb35\uc801 \ube44\uc6a9(6,000\ub9cc \uc6d0)\uc744 \ud569\uc0b0\ud55c 3\uc5b5 1,000\ub9cc \uc6d0\uc774 \ub418\uba70, \uc774\ub294 \uc608\uc0c1 \uc218\uc785(3\uc5b5 \uc6d0)\ubcf4\ub2e4 \ud06c\ubbc0\ub85c \uc190\ud574\ub97c \ubcf4\uac8c \ub41c\ub2e4."
        },
        {
          "text": "\ud3ec\uae30\ud574\uc57c \ud558\ub294 \uae30\uc874 \uc9c1\uc7a5 \uc18c\ub4dd 6,000\ub9cc \uc6d0\uc740 \ud68c\uc218\ud560 \uc218 \uc5c6\ub294 \ub9e4\ubab0 \ube44\uc6a9\uc5d0 \ud574\ub2f9\ud558\ubbc0\ub85c \uc758\uc0ac \uacb0\uc815\uc5d0\uc11c \uc81c\uc678\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\uc874 \uc9c1\uc7a5 \uc18c\ub4dd 6,000\ub9cc \uc6d0\uc740 \ud68c\uc218 \ubd88\uac00\ub2a5\ud55c \ube44\uc6a9\uc774 \uc544\ub2c8\ub77c \uc0c8\ub85c\uc6b4 \uc120\ud0dd(\ucc3d\uc5c5)\uc744 \uc704\ud574 \ud3ec\uae30\ud574\uc57c \ud558\ub294 \uc554\ubb35\uc801 \ube44\uc6a9\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\uc608\uc0c1 \uc218\uc785\uc5d0\uc11c \uba85\uc2dc\uc801 \ube44\uc6a9\uc744 \ube80 \uc774\uc724\uc774 5,000\ub9cc \uc6d0 \ubc1c\uc0dd\ud558\ubbc0\ub85c \uc21c\ud3b8\uc775\uc740 5,000\ub9cc \uc6d0\uc73c\ub85c \uc591(+)\uc758 \uac12\uc744 \uac16\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc785\uc5d0\uc11c \uba85\uc2dc\uc801 \ube44\uc6a9\ub9cc \ube80 5,000\ub9cc \uc6d0\uc740 \ub2e8\uc21c\ud55c \ud68c\uacc4\uc801 \uc774\uc724\uc77c \ubfd0\uc774\uba70, \uc554\ubb35\uc801 \ube44\uc6a9\uae4c\uc9c0 \uace0\ub824\ud55c \uae30\ud68c\ube44\uc6a9\uc744 \ucc28\uac10\ud558\uba74 \uc21c\ud3b8\uc775\uc740 -1,000\ub9cc \uc6d0\uc774\ub2e4."
        },
        {
          "text": "\uba85\uc2dc\uc801 \ube44\uc6a9\uacfc \uc554\ubb35\uc801 \ube44\uc6a9\uc758 \ud06c\uae30\uac00 \ub3d9\uc77c\ud558\ubbc0\ub85c \uc9c1\uc7a5\uc744 \uc720\uc9c0\ud558\ub294 \uac83\uacfc \ucc3d\uc5c5\ud558\ub294 \uac83\uc758 \uacbd\uc81c\uc801 \uac00\uce58\ub294 \uac19\ub2e4.",
          "isCorrect": false,
          "rationale": "\uba85\uc2dc\uc801 \ube44\uc6a9\uc740 2\uc5b5 5,000\ub9cc \uc6d0\uc774\uace0 \uc554\ubb35\uc801 \ube44\uc6a9\uc740 6,000\ub9cc \uc6d0\uc73c\ub85c \ub450 \ube44\uc6a9\uc758 \ud06c\uae30\ub294 \uc11c\ub85c \ub2e4\ub974\ub2e4."
        }
      ],
      "hint": "\ud569\ub9ac\uc801 \uc120\ud0dd\uc744 \uc704\ud55c \uae30\ud68c\ube44\uc6a9\uc5d0\ub294 \uc9c1\uc811 \uc9c0\ucd9c\ud558\ub294 \ube44\uc6a9\ubfd0\ub9cc \uc544\ub2c8\ub77c \ud3ec\uae30\ud55c \ub300\uc548\uc758 \uac00\uce58\ub3c4 \ud568\uaed8 \ud3ec\ud568\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ud569\ub9ac\uc801 \uc758\uc0ac \uacb0\uc815 \uacfc\uc815\uc5d0\uc11c \uace0\ub824\ud574\uc57c \ud558\ub294 '\ub9e4\ubab0 \ube44\uc6a9'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc774\ubbf8 \uc9c0\ucd9c\ud558\uc5ec \uc5b4\ub5a4 \uc120\ud0dd\uc744 \ud558\ub354\ub77c\ub3c4 \ub2e4\uc2dc \ud68c\uc218\ud560 \uc218 \uc5c6\ub294 \ube44\uc6a9\uc774\ubbc0\ub85c \uc758\uc0ac \uacb0\uc815 \uc2dc \uace0\ub824 \ub300\uc0c1\uc5d0\uc11c \uc81c\uc678\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub9e4\ubab0 \ube44\uc6a9\uc740 \uc774\ubbf8 \uc9c0\ucd9c\ub418\uc5b4 \ub418\ucc3e\uc744 \uc218 \uc5c6\ub294 \ube44\uc6a9\uc774\ubbc0\ub85c, \ud5a5\ud6c4 \ud589\uc704 \uc5ec\ubd80\ub97c \uacb0\uc815\ud560 \ub54c \uace0\ub824\ud558\uc9c0 \uc54a\uc544\uc57c \ud569\ub9ac\uc801\uc778 \uc120\ud0dd\uc744 \ud560 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\uc5b4\ub5a4 \uac83\uc744 \uc120\ud0dd\ud560 \ub54c \uc2e4\uc81c\ub85c \uc9c0\ucd9c\ub418\ub294 \ube44\uc6a9\uacfc \ud3ec\uae30\ud55c \ub300\uc548\uc758 \uac00\uce58\ub97c \ud569\uce5c \uae08\uc561\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc120\ud0dd \uc2dc \uc2e4\uc81c \uc9c0\ucd9c\uc561\uacfc \ud3ec\uae30\ud55c \ub300\uc548\uc758 \uac00\uce58\ub97c \ud569\ud55c \ube44\uc6a9\uc740 \ub9e4\ubab0 \ube44\uc6a9\uc774 \uc544\ub2c8\ub77c \uae30\ud68c\ube44\uc6a9\uc5d0 \ub300\ud55c \uc815\uc758\uc774\ub2e4."
        },
        {
          "text": "\uacfc\uac70\uc5d0 \uc9c0\ucd9c\ub41c \ube44\uc6a9\uc774\ub354\ub77c\ub3c4 \ubcf8\uc804\uc744 \ucc3e\uae30 \uc704\ud574 \uc21c\ud3b8\uc775 \uacc4\uc0b0 \uacfc\uc815\uc5d0 \ubc18\ub4dc\uc2dc \ud3ec\ud568\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\ucd9c\ub41c \ub3c8\uc774 \uc544\uae4c\uc6cc \ubcf8\uc804\uc744 \ubf51\uc73c\ub824\uace0 \ub9e4\ubab0 \ube44\uc6a9\uc744 \uace0\ub824\ud558\ub294 \uac83\uc740 \ud310\ub2e8\uc744 \uadf8\ub974\uce58\uac8c \ub9cc\ub4dc\ub294 \ube44\ud569\ub9ac\uc801 \ud589\ub3d9\uc774\ub2e4."
        },
        {
          "text": "\ud3ec\uae30\ud55c \uc5ec\ub7ec \ub300\uc548 \uc911\uc5d0\uc11c \uac00\uce58\uac00 \uac00\uc7a5 \ub192\uc740 \ub300\uc548\uc758 \uc554\ubb35\uc801 \uac00\uce58\ub9cc\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud3ec\uae30\ud55c \ub300\uc548\ub4e4 \uc911 \uac00\uc7a5 \uac00\uce58\uac00 \ud070 \ub300\uc548\uc758 \uac00\uce58\ub294 \uae30\ud68c\ube44\uc6a9 \uc911 \uc554\ubb35\uc801 \ube44\uc6a9\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        }
      ],
      "hint": "\uc774\ubbf8 \uc9c0\ub098\uac04 \uc9c0\ucd9c\uc5d0 \uc5f0\uc5f0\ud558\uc9c0 \uc54a\ub294 \uac83\uc774 \uacbd\uc81c\ud559\uc801 \ud569\ub9ac\uc131\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ub3c5\uacfc\uc810 \uc2dc\uc7a5\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ud3d0\ud574\uc640 \uc774\ub85c \uc778\ud55c \uc790\uc6d0 \ubc30\ubd84\uc758 \uacb0\uacfc\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uacf5\uae09\uc790\uac00 \uc774\uc724 \uadf9\ub300\ud654\ub97c \uc704\ud574 \uc0dd\uc0b0\ub7c9\uc744 \uc904\uc774\uace0 \uac00\uaca9\uc744 \uc62c\ub9bc\uc73c\ub85c\uc368 \uc7ac\ud654\uac00 \uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc801\uac8c \uacf5\uae09\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub3c5\uacfc\uc810 \uae30\uc5c5\uc740 \uac00\uaca9 \uc9c0\ubc30\ub825\uc774\ub098 \uae30\uc5c5 \uac04 \ub2f4\ud569\uc744 \uc774\uc6a9\ud574 \uc0dd\uc0b0\ub7c9\uc744 \uc904\uc5ec \uac00\uaca9\uc744 \ub192\uc774\ubbc0\ub85c, \uc0ac\ud68c\uc801\uc73c\ub85c \ud544\uc694\ud55c \uc591\ub9cc\ud07c \ucda9\ubd84\ud788 \uacf5\uae09\ub418\uc9c0 \ubabb\ud558\ub294 \uc790\uc6d0 \ubc30\ubd84\uc758 \ube44\ud6a8\uc728\uc131\uc744 \ucd08\ub798\ud55c\ub2e4."
        },
        {
          "text": "\ub300\uac00 \uc5c6\uc774 \uc7ac\ud654\ub97c \uc0ac\uc6a9\ud558\ub294 \ubb34\uc784\uc2b9\ucc28\uc790 \ubb38\uc81c\ub85c \uc778\ud574 \uacf5\uae09\uc790\uac00 \uc0dd\uc0b0\uc744 \uc644\uc804\ud788 \ud3ec\uae30\ud558\uac8c \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb34\uc784\uc2b9\ucc28\uc790 \ubb38\uc81c\ub294 \ub3c5\uacfc\uc810 \uc2dc\uc7a5\uc758 \ud3d0\ud574\uac00 \uc544\ub2c8\ub77c \uacf5\uacf5\uc7ac\uc758 \ud2b9\uc131\uc73c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \uc2dc\uc7a5 \uc2e4\ud328\uc758 \uc6d0\uc778\uc774\ub2e4."
        },
        {
          "text": "\uc18c\ube44\uc790 \uac04\uc758 \uacfc\ub3c4\ud55c \uacbd\uc7c1\uc73c\ub85c \uc778\ud574 \uc7ac\ud654\uc758 \uc2dc\uc7a5 \uac00\uaca9\uc774 \uc801\uc815 \uc218\uc900\ubcf4\ub2e4 \uc9c0\ub098\uce58\uac8c \ub0ae\uac8c \ud615\uc131\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub3c5\uacfc\uc810 \uc2dc\uc7a5\uc5d0\uc11c\ub294 \uacf5\uae09\uc790\uac00 \uc2dc\uc7a5 \uc9c0\ubc30\ub825\uc744 \uac00\uc838 \uc0dd\uc0b0\ub7c9\uc744 \uc904\uc774\uace0 \uac00\uaca9\uc744 \uc62c\ub9ac\ubbc0\ub85c \uc18c\ube44\uc790\ub294 \uc2dc\uc7a5 \uac00\uaca9\ubcf4\ub2e4 \ub192\uc740 \uac00\uaca9\uc5d0 \uad6c\ub9e4\ud558\uac8c \ub41c\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0\uc790\uac00 \ud0c0\uc778\uc5d0\uac8c \uc758\ub3c4\ud558\uc9c0 \uc54a\uc740 \ud53c\ud574\ub97c \uc8fc\uace0\ub3c4 \uc774\uc5d0 \ub300\ud55c \ub300\uac00\ub97c \uce58\ub974\uc9c0 \uc54a\ub294 \ud604\uc0c1\uc774 \uc8fc\ub41c \uc6d0\uc778\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacbd\uc81c\uc801 \ub300\uac00\ub97c \uce58\ub974\uc9c0 \uc54a\uace0 \uc758\ub3c4\ud558\uc9c0 \uc54a\uc740 \ud53c\ud574\ub97c \uc8fc\ub294 \ud604\uc0c1\uc740 \ubd80\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc\uc5d0 \uad00\ud55c \uc124\uba85\uc774\ub2e4."
        }
      ],
      "hint": "\uc2dc\uc7a5 \uc9c0\ubc30\ub825\uc744 \uac00\uc9c4 \uc18c\uc218 \ub610\ub294 \ub2e8\uc77c \uacf5\uae09\uc790\uac00 \uc774\uc724\uc744 \ub298\ub9ac\uae30 \uc704\ud574 \uc0dd\uc0b0\ub7c9\uacfc \uac00\uaca9\uc744 \uc5b4\ub5bb\uac8c \uc870\uc808\ud558\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uad6d\ubc29, \uce58\uc548, \uac00\ub85c\ub4f1, \ub4f1\ub300\uc640 \uac19\uc740 \uacf5\uacf5\uc7ac\uc758 \ud2b9\uc131 \ubc0f \uacf5\uacf5\uc7ac\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \uc2dc\uc7a5 \uc2e4\ud328\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub300\uac00 \uc5c6\uc774\ub3c4 \ub204\uad6c\ub098 \uc18c\ube44\ud560 \uc218 \uc788\uc5b4 \ubb34\uc784\uc2b9\ucc28\uc790 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uba70, \uc2dc\uc7a5\uc5d0\ub9cc \ub9e1\uae30\uba74 \uc0ac\ud68c\uc801 \ud544\uc694\ub7c9\ubcf4\ub2e4 \uc801\uac8c \uacf5\uae09\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uacf5\uacf5\uc7ac\ub294 \ub300\uac00\ub97c \ub0b4\uc9c0 \uc54a\uc544\ub3c4 \uc774\uc6a9\ud560 \uc218 \uc788\ub294 \ud2b9\uc131 \ub54c\ubb38\uc5d0 \ubb34\uc784\uc2b9\ucc28\uc790 \ubb38\uc81c\uac00 \uc0dd\uae30\uace0, \uae30\uc5c5\uc774 \uc774\uc724\uc744 \uc5bb\uae30 \uc5b4\ub824\uc6cc \uc0dd\uc0b0\uc744 \ud53c\ud558\ubbc0\ub85c \ud544\uc694\ud55c \uc218\uc900\ubcf4\ub2e4 \ubd80\uc871\ud558\uac8c \uc0dd\uc0b0\ub41c\ub2e4."
        },
        {
          "text": "\ud55c \uc0ac\ub78c\uc774 \uc18c\ube44\ud558\uba74 \ub2e4\ub978 \uc0ac\ub78c\uc774 \uc18c\ube44\ud560 \uc218 \uc788\ub294 \ubaab\uc774 \uc904\uc5b4\ub4e4\ubbc0\ub85c \ubbfc\uac04 \uae30\uc5c5\ub4e4\uc774 \uacfc\ub3c4\ud55c \uc0dd\uc0b0 \uacbd\uc7c1\uc744 \ubc8c\uc778\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uacf5\uc7ac\ub294 \ud55c \uc0ac\ub78c\uc774 \uc18c\ube44\ud558\ub354\ub77c\ub3c4 \ub2e4\ub978 \uc0ac\ub78c\uc758 \uc18c\ube44 \ubaab\uc774 \uc904\uc5b4\ub4e4\uc9c0 \uc54a\ub294 \ud2b9\uc131\uc744 \uac16\ub294\ub2e4."
        },
        {
          "text": "\ub300\uac00 \uc9c0\ubd88\uc790\ub9cc \uc0ac\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \ucca0\uc800\ud788 \uc81c\ud55c\ub418\uc5b4 \uc2dc\uc7a5\uc5d0\uc11c \uc0ac\ud68c\uc801 \uc801\uc815 \uc218\uc900\ubcf4\ub2e4 \uacfc\ub2e4\ud558\uac8c \uc0dd\uc0b0\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uacf5\uc7ac\ub294 \ub300\uac00\ub97c \uc9c0\ubd88\ud558\uc9c0 \uc54a\uc740 \uc0ac\ub78c\ub3c4 \uc18c\ube44\uc5d0\uc11c \ubc30\uc81c\ud560 \uc218 \uc5c6\ub294 \ud2b9\uc131\uc744 \uc9c0\ub2cc\ub2e4."
        },
        {
          "text": "\uacf5\uacf5\uc7ac\ub294 \ub3c4\ub85c\ub098 \uac00\ub85c\ub4f1 \uac19\uc740 \uc2e4\ubb3c \uc7ac\ud654\ub85c\ub9cc \ud55c\uc815\ub418\uba70, \uc11c\ube44\uc2a4 \ud615\ud0dc\ub85c\ub294 \uc874\uc7ac\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uacf5\uc7ac\uc5d0\ub294 \uac00\ub85c\ub4f1\uacfc \uac19\uc740 \uc7ac\ud654\ubfd0\ub9cc \uc544\ub2c8\ub77c \uad6d\ubc29\uc774\ub098 \uce58\uc548\uacfc \uac19\uc740 \uc11c\ube44\uc2a4\ub3c4 \ud3ec\ud568\ub41c\ub2e4."
        }
      ],
      "hint": "\uacf5\uacf5\uc7ac\ub294 \ub300\uac00\ub97c \ub0b4\uc9c0 \uc54a\uc740 \uc0ac\ub78c\uc744 \uc18c\ube44\uc5d0\uc11c \ub9c9\uc744 \uc218 \uc5c6\uace0, \uc774\uc6a9\uc5d0 \uacbd\uc7c1\uc774 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc678\ubd80 \ud6a8\uacfc\uc640 \uc790\uc6d0 \ubc30\ubd84\uc758 \ud6a8\uc728\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub3c5\uac10 \uc608\ubc29 \uc811\uc885\uacfc \uac19\uc774 \uae0d\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc\uac00 \ubc1c\uc0dd\ud558\ub294 \uacbd\uc81c\ud65c\ub3d9\uc740 \uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \ub9ce\uc774 \ub098\ud0c0\ub09c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uae0d\uc815\uc801 \uc678\ubd80 \ud6a8\uacfc\uac00 \ubc1c\uc0dd\ud558\ub294 \uacbd\uc81c\ud65c\ub3d9\uc740 \ud0c0\uc778\uc5d0\uac8c \uc774\uc775\uc744 \uc8fc\uc9c0\ub9cc \uadf8\uc5d0 \ub300\ud55c \ub300\uac00\ub97c \ubc1b\uc9c0 \ubabb\ud558\ubbc0\ub85c \uc0ac\ud68c\uc801\uc73c\ub85c \uc801\uc815\ud55c \uc218\uc900\ubcf4\ub2e4 \uc801\uac8c \ub098\ud0c0\ub09c\ub2e4."
