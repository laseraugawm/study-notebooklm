          "text": "\ud559\uc0dd\uc774\ub77c\ub294 \uc774\uc720\ub85c \ucd5c\uc800 \uc784\uae08\ubcf4\ub2e4 \uc801\uc740 \uae08\uc561\uc744 \uc9c0\uae09\ud568 - \ucd5c\uc800\uc784\uae08\ubc95 \ubc0f \uc815\ub2f9\ud55c \uc784\uae08 \uc9c0\uae09 \uad8c\ub9ac \uce68\ud574",
          "isCorrect": true,
