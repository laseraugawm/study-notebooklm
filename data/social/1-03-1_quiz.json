{
  "title": "\uccad\uc18c\ub144\ub178\ub3d9 \ud034\uc988",
  "questions": [
    {
      "question": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9d1\ub2e8\uc758 \uad6c\uc131\uc6d0 \uc218\uac00 \uc804\uccb4 \uc0ac\ud68c\uc5d0\uc11c \ucc28\uc9c0\ud558\ub294 \ube44\uc728\uc774 \ubc18\ub4dc\uc2dc \uc801\uc5b4\uc57c \uc131\ub9bd\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub294 \uad6c\uc131\uc6d0 \uc218\uc758 \ub9ce\uace0 \uc801\uc74c\uc774 \uc544\ub2c8\ub77c \uc0ac\ud68c\uc801 \uc601\ud5a5\ub825\uc774 \uc791\uace0 \uc57d\uc790\uc758 \uc704\uce58\uc5d0 \uc788\ub294\uac00\uc5d0 \ub530\ub77c \uad6c\ubd84\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e0\uccb4\uc801 \ub610\ub294 \ubb38\ud654\uc801 \ud2b9\uc9d5\uc73c\ub85c \uc778\ud574 \uc8fc\ub958 \uc9d1\ub2e8 \uad6c\uc131\uc6d0\uc5d0\uac8c \ucc28\ubcc4\ubc1b\ub294 \uc0ac\ub78c\ub4e4\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub294 \uc2e0\uccb4\uc801, \ubb38\ud654\uc801 \ucc28\uc774\ub85c \uc778\ud574 \ubd80\ub2f9\ud55c \ub300\uc6b0\ub97c \ubc1b\uc73c\uba70 \uc2a4\uc2a4\ub85c \ucc28\ubcc4\ubc1b\ub294 \uc9d1\ub2e8\uc5d0 \uc18d\ud574 \uc788\ub2e4\uace0 \uc778\uc2dd\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud574\ub2f9 \uc0ac\ud68c\uc758 \uc5ed\uc0ac\uc801\u00b7\ubb38\ud654\uc801 \ubc30\uacbd\uc5d0 \ub530\ub77c \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc5d0 \ud574\ub2f9\ud558\ub294 \uad6c\uc131\uc6d0\uc774 \ub2e4\ub97c \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ud68c\uc801 \uc601\ud5a5\ub825\uacfc \uc704\uce58\ub294 \uc0ac\ud68c\ub9c8\ub2e4 \uc0c1\uc774\ud558\ubbc0\ub85c \uc2dc\ub300\uc640 \uc0ac\ud68c\uc5d0 \ub530\ub77c \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uc758 \ubc94\uc704\uac00 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\uace0, \uc9c8\ubcd1, \ud574\uc678 \uc774\uc8fc \ub4f1\uc73c\ub85c \uc778\ud574 \ub204\uad6c\ub098 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\uac00 \ub420 \uc218 \uc788\ub294 \uc0c1\ub300\uc801 \uac1c\ub150\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b6\uc758 \ud658\uacbd \ubcc0\ud654\ub098 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc0ac\uace0 \ub4f1\uc73c\ub85c \ub204\uad6c\ub4e0 \uc0ac\ud68c\uc801 \uc57d\uc790\uc758 \uc704\uce58\uc5d0 \ucc98\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uc0c1\ub300\uc801 \uc131\uaca9\uc744 \uac00\uc9d1\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc778\uad6c\uc218\uc640 \uc0ac\ud68c\uc801 \uc601\ud5a5\ub825 \uc911 \ubb34\uc5c7\uc774 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub97c \uacb0\uc815\ud558\ub294 \ud575\uc2ec \uae30\uc900\uc778\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub97c \ubcf4\ud638\ud558\uae30 \uc704\ud55c \ubc95\ub960\uacfc \uadf8 \ub0b4\uc6a9\uc774 \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ub41c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\u300c\uc7a5\uc560\uc778 \ucc28\ubcc4 \uae08\uc9c0 \ubc0f \uad8c\ub9ac \uad6c\uc81c \ub4f1\uc5d0 \uad00\ud55c \ubc95\ub960\u300d - \uc7a5\uc560\uc778 \uc758\ubb34 \uace0\uc6a9\uc81c \ub4f1\uc758 \uc815\ucc45 \uc2dc\ud589",
          "isCorrect": true,
          "rationale": "\uc7a5\uc560\uc778\uc758 \uad8c\ub9ac\ub97c \ubcf4\ud638\ud558\uace0 \uc2e4\uc9c8\uc801 \uae30\ud68c\ub97c \uc81c\uacf5\ud558\uae30 \uc704\ud574 \uc7a5\uc560\uc778 \ucc28\ubcc4 \uae08\uc9c0\ubc95\uc5d0 \ub530\ub77c \uc758\ubb34 \uace0\uc6a9\uc81c \ub4f1\uc744 \uc2dc\ud589\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\u300c\ub0a8\ub140 \uace0\uc6a9 \ud3c9\ub4f1\uacfc \uc77c\u00b7\uac00\uc815 \uc591\ub9bd \uc9c0\uc6d0\uc5d0 \uad00\ud55c \ubc95\ub960\u300d - \uc774\uc8fc \uc678\uad6d\uc778 \uadfc\ub85c\uc790\uc758 \uc5f4\uc545\ud55c \uc8fc\uac70 \ud658\uacbd \uac1c\uc120",
          "isCorrect": false,
          "rationale": "\ub0a8\ub140 \uace0\uc6a9 \ud3c9\ub4f1\ubc95\uc740 \ub178\ub3d9 \uc2dc\uc7a5\uc5d0\uc11c \uc131\ubcc4\uc5d0 \ub530\ub978 \ubd80\ub2f9\ud55c \ucc28\ubcc4\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc81c\uc815\ub41c \ubc95\ub960\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\u300c\uc678\uad6d\uc778 \uadfc\ub85c\uc790\uc758 \uace0\uc6a9 \ub4f1\uc5d0 \uad00\ud55c \ubc95\ub960\u300d - \uc5ec\uc131 \uadfc\ub85c\uc790\uc5d0 \ub300\ud55c \uc2b9\uc9c4 \ubd88\uc774\uc775 \uae08\uc9c0",
          "isCorrect": false,
          "rationale": "\uc678\uad6d\uc778 \uadfc\ub85c\uc790\uc758 \uace0\uc6a9 \ub4f1\uc5d0 \uad00\ud55c \ubc95\ub960\uc740 \uc774\uc8fc \uc678\uad6d\uc778 \uadfc\ub85c\uc790\uc758 \uad8c\uc775\uc744 \ubcf4\ud638\ud558\uae30 \uc704\ud55c \ubc95\ub960\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\u300c\uccad\uc18c\ub144 \ubcf4\ud638\ubc95\u300d - \ubd81\ud55c \uc774\ud0c8 \uc8fc\ubbfc\uc758 \uacbd\uc81c\uc801 \uc790\ub9bd \uc9c0\uc6d0",
          "isCorrect": false,
          "rationale": "\uccad\uc18c\ub144 \ubcf4\ud638\ubc95\uc740 \uccad\uc18c\ub144\uc774 \uac74\uc804\ud55c \uc778\uaca9\uccb4\ub85c \uc131\uc7a5\ud558\ub3c4\ub85d \ub3d5\uae30 \uc704\ud574 \uc81c\uc815\ub41c \ubc95\ub960\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac01 \ubc95\ub960\uc758 \uba85\uce6d\uc5d0 \ud3ec\ud568\ub41c \ub300\uc0c1\uacfc \uc815\ucc45 \ubaa9\uc801\uc744 \ub9e4\uce6d\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc6b0\ub9ac\ub098\ub77c \ud5cc\ubc95 \ubc0f \uad00\ub828 \ubc95\ub960\uc5d0\uc11c \uaddc\uc815\ud558\uace0 \uc788\ub294 \uc5f0\uc18c \uadfc\ub85c\uc790\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uadfc\ub85c\uae30\uc900\ubc95\uc0c1 \uc5f0\uc18c \uadfc\ub85c\uc790\ub294 15\uc138 \uc774\uc0c1 18\uc138 \ubbf8\ub9cc\uc778 \uc0ac\ub78c\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uadfc\ub85c\uae30\uc900\ubc95\uc5d0\uc11c\ub294 15\uc138 \uc774\uc0c1 18\uc138 \ubbf8\ub9cc\uc758 \uccad\uc18c\ub144\uc744 \uc5f0\uc18c \uadfc\ub85c\uc790\ub85c \uaddc\uc815\ud558\uc5ec \ud2b9\ubcc4\ud55c \ubcf4\ud638\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud5cc\ubc95 \uc81c32\uc870\uc5d0\uc11c\ub294 \uc5f0\uc18c\uc790\uc758 \uadfc\ub85c\uc5d0 \ub300\ud574 \uc131\uc778\uacfc \ub3d9\uc77c\ud55c \uae30\uc900\ub9cc\uc744 \uc801\uc6a9\ud558\ub3c4\ub85d \uba85\uc2dc\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud5cc\ubc95 \uc81c32\uc870 \uc81c5\ud56d\uc740 \uc5f0\uc18c\uc790\uc758 \uadfc\ub85c\ub294 \ud2b9\ubcc4\ud55c \ubcf4\ud638\ub97c \ubc1b\ub294\ub2e4\uace0 \uba85\uc2dc\ud558\uc5ec \ubcc4\ub3c4\uc758 \ubcf4\ud638 \uae30\uc900\uc744 \ub461\ub2c8\ub2e4."
        },
        {
          "text": "15\uc138 \ubbf8\ub9cc\uc778 \uc790\ub294 \uc608\uc678 \uc5c6\uc774 \uc5b4\ub5a0\ud55c \uacbd\uc6b0\uc5d0\ub3c4 \uadfc\ub85c\uc790\ub85c \uc77c\ud560 \uc218 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "15\uc138 \ubbf8\ub9cc\uc774\ub77c\ub3c4 \uace0\uc6a9\ub178\ub3d9\ubd80 \uc7a5\uad00\uc774 \ubc1c\uae09\ud55c \ucde8\uc9c1\uc778\ud5c8\uc99d\uc744 \uc18c\uc9c0\ud55c \uacbd\uc6b0\uc5d0\ub294 \uc608\uc678\uc801\uc73c\ub85c \uadfc\ub85c\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc5f0\uc18c \uadfc\ub85c\uc790\ub294 \ubcf4\ud638\uc790\uc758 \ub3d9\uc758\ub9cc \uc788\ub2e4\uba74 \ud558\ub8e8 10\uc2dc\uac04 \uc774\uc0c1 \uc5f0\uc7a5 \uadfc\ub85c\ub97c \ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uc18c \uadfc\ub85c\uc790\ub294 \ud569\uc758 \uc2dc\uc5d0\ub3c4 \ud558\ub8e8 \ucd5c\ub300 1\uc2dc\uac04\ub9cc \uc5f0\uc7a5 \uadfc\ub85c\uac00 \uac00\ub2a5\ud558\uc5ec 1\uc77c \ucd1d 8\uc2dc\uac04\uc744 \ub118\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc5f0\uc18c \uadfc\ub85c\uc790\ub97c \uad6c\ubcc4\ud558\ub294 \ubc95\uc801 \uc5f0\ub839 \uae30\uc900\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uadfc\ub85c\uae30\uc900\ubc95\uc0c1 \uc5f0\uc18c \uadfc\ub85c\uc790\uc758 \uadfc\ub85c \uacc4\uc57d \uccb4\uacb0 \ubc0f \uc11c\ub958 \uad6c\ube44\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uce5c\uad8c\uc790\ub098 \ud6c4\uacac\uc778\uc740 \ubbf8\uc131\ub144\uc790\uc758 \uadfc\ub85c \uacc4\uc57d\uc744 \ub300\ub9ac\ud560 \uc218 \uc5c6\uc73c\uba70 \uadfc\ub85c\uc790 \ubcf8\uc778\uc774 \uc9c1\uc811 \uccb4\uacb0\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uadfc\ub85c\uae30\uc900\ubc95 \uc81c67\uc870\uc5d0 \ub530\ub77c \uce5c\uad8c\uc790\ub098 \ud6c4\uacac\uc778\uc740 \ubbf8\uc131\ub144\uc790\uc758 \uadfc\ub85c \uacc4\uc57d\uc744 \ub300\ub9ac\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uccad\uc18c\ub144 \ubcf8\uc778\uc774 \uc9c1\uc811 \uacc4\uc57d\uc744 \ub9fa\uc5b4\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\uc6a9\uc790\ub294 \uc5f0\uc18c \uadfc\ub85c\uc790\ub97c \uace0\uc6a9\ud560 \ub54c \uce5c\uad8c\uc790 \ub3d9\uc758\uc11c\ub9cc \uad6c\ube44\ud558\uba74 \ub418\uba70 \uc5f0\ub839 \uc99d\uba85 \uc11c\ub958\ub294 \ubd88\ud544\uc694\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc81c66\uc870\uc5d0 \ub530\ub77c \uc0ac\uc6a9\uc790\ub294 \uc5f0\ub839\uc744 \uc99d\uba85\ud558\ub294 \uac00\uc871 \uad00\uacc4 \uae30\ub85d \uc0ac\ud56d\uc5d0 \uad00\ud55c \uc99d\uba85\uc11c\uc640 \uce5c\uad8c\uc790(\ud6c4\uacac\uc778) \ub3d9\uc758\uc11c\ub97c \ubaa8\ub450 \uac16\ucd94\uc5b4\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uce5c\uad8c\uc790\ub294 \ubbf8\uc131\ub144 \uadfc\ub85c\uc790\uc758 \ubcf4\ud638\ub97c \uc704\ud574 \ubc95\uc801\uc73c\ub85c \uadfc\ub85c \uacc4\uc57d\uc744 \ub300\uc2e0 \uccb4\uacb0\ud574 \uc904 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubbf8\uc131\ub144\uc790\uc758 \ubd80\ub2f9\ud55c \ub178\ub3d9 \ucc29\ucde8\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ubc95\uc801\uc73c\ub85c \uce5c\uad8c\uc790\uc758 \uacc4\uc57d \ub300\ub9ac\ub97c \uae08\uc9c0\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc5f0\uc18c \uadfc\ub85c\uc790\uac00 \uc2a4\uc2a4\ub85c \uacc4\uc57d\uc744 \uccb4\uacb0\ud55c \uacbd\uc6b0 \uce5c\uad8c\uc790\ub098 \ud6c4\uacac\uc778\uc758 \ub3d9\uc758\uc11c\ub294 \ud544\uc694\ud558\uc9c0 \uc54a\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacc4\uc57d\uc740 \ubcf8\uc778\uc774 \uccb4\uacb0\ud558\ub354\ub77c\ub3c4 \uc0ac\uc5c5\uc7a5\uc5d0\ub294 \uce5c\uad8c\uc790 \ub610\ub294 \ud6c4\uacac\uc778\uc758 \ub3d9\uc758\uc11c\uac00 \ubc18\ub4dc\uc2dc \uad6c\ube44\ub418\uc5b4 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uadfc\ub85c \uacc4\uc57d\uc744 \uc9c1\uc811 \uc791\uc131\ud574\uc57c \ud558\ub294 \uc8fc\uccb4\uc640 \ubd80\ubaa8\ub2d8\uc774 \uc81c\ucd9c\ud574\uc57c \ud558\ub294 \uc11c\ub958\uc758 \uc5ed\ud560\uc744 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uadfc\ub85c\uae30\uc900\ubc95 \uc81c54\uc870 \ubc0f \uc81c69\uc870\uc5d0 \ub530\ub978 \uc5f0\uc18c \uadfc\ub85c\uc790\uc758 \ubc95\uc815 \uadfc\ub85c\uc2dc\uac04\uacfc \ud734\uac8c\uc2dc\uac04 \uae30\uc900\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubc95\uc815 \uadfc\ub85c\uc2dc\uac04\uc740 1\uc77c 7\uc2dc\uac04, 1\uc8fc 35\uc2dc\uac04\uc744 \ucd08\uacfc\ud558\uc9c0 \ubabb\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uadfc\ub85c\uae30\uc900\ubc95 \uc81c69\uc870\uc5d0 \ub530\ub77c 15\uc138 \uc774\uc0c1 18\uc138 \ubbf8\ub9cc\uc790\uc758 \uadfc\ub85c\uc2dc\uac04\uc740 1\uc77c 7\uc2dc\uac04, 1\uc8fc 35\uc2dc\uac04\uc73c\ub85c \uc81c\ud55c\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ub2f9\uc0ac\uc790 \uac04 \ud569\uc758\uac00 \uc788\ub354\ub77c\ub3c4 \uc5f0\uc7a5 \uadfc\ub85c\ub294 \uc77c\uc808 \ud5c8\uc6a9\ub418\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2f9\uc0ac\uc790 \uac04 \ud569\uc758\uc5d0 \ub530\ub77c 1\uc77c\uc5d0 1\uc2dc\uac04, 1\uc8fc\uc77c\uc5d0 5\uc2dc\uac04\uc744 \ud55c\ub3c4\ub85c \uc5f0\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uadfc\ub85c\uc2dc\uac04\uc774 4\uc2dc\uac04\uc778 \uacbd\uc6b0 15\ubd84 \uc774\uc0c1\uc758 \ud734\uac8c\uc2dc\uac04\uc744 \uc8fc\uc5b4\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uadfc\ub85c\uc2dc\uac04\uc774 4\uc2dc\uac04\uc778 \uacbd\uc6b0\uc5d0\ub294 30\ubd84 \uc774\uc0c1, 8\uc2dc\uac04\uc778 \uacbd\uc6b0\uc5d0\ub294 1\uc2dc\uac04 \uc774\uc0c1\uc758 \ud734\uac8c\uc2dc\uac04\uc744 \uc8fc\uc5b4\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub2f9\uc0ac\uc790 \uac04 \ud569\uc758 \uc2dc 1\uc77c\uc5d0 \ucd5c\ub300 3\uc2dc\uac04\uae4c\uc9c0 \uc5f0\uc7a5 \uadfc\ub85c\uac00 \uac00\ub2a5\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uc7a5 \uadfc\ub85c\ub294 \ud558\ub8e8 \ucd5c\ub300 1\uc2dc\uac04\uae4c\uc9c0\ub9cc \ud5c8\uc6a9\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc131\uc778 \uadfc\ub85c\uc790\uc5d0 \ube44\ud574 \ub354 \uc5c4\uaca9\ud558\uac8c \uc81c\ud55c\ub418\ub294 \uc5f0\uc18c\uc790\uc758 \ud558\ub8e8 \ubc95\uc815 \uadfc\ub85c\uc2dc\uac04 \uc22b\uc790\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uccad\uc18c\ub144\uc774 \uc77c\ud130\uc5d0\uc11c \ub178\ub3d9\uad8c\uc744 \uce68\ud574\ub2f9\ud588\uc744 \ub54c \ub3c4\uc6c0\uc744 \ubc1b\uc744 \uc218 \uc788\ub294 \uae30\uad00\uacfc \uadf8 \uc5ed\ud560\uc758 \uc5f0\uacb0\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uadfc\ub85c\ubcf5\uc9c0\uacf5\ub2e8 - \uc5f0\uc18c \uadfc\ub85c\uc790\uc5d0\uac8c \ucde8\uc9c1\uc778\ud5c8\uc99d\uc744 \uc2e0\uccad\ubc1b\uc544 \ubc1c\uae09\ud574 \uc900\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucde8\uc9c1\uc778\ud5c8\uc99d \ubc1c\uae09\uc740 \uace0\uc6a9\ub178\ub3d9\ubd80 \uc7a5\uad00\uc758 \uad8c\ud55c\uc774\uba70, \uadfc\ub85c\ubcf5\uc9c0\uacf5\ub2e8\uc740 \uc5c5\ubb34\uc0c1 \uc7ac\ud574\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uacfc \ubcf5\uc9c0 \uc99d\uc9c4\uc744 \ub2f4\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uace0\uc6a9\ub178\ub3d9\ubd80 - \ub178\ub3d9\uad8c \uce68\ud574 \uc2dc \uc2dc\uc815 \uba85\ub839 \ubc0f \uad6c\uc81c \uc808\ucc28 \uc548\ub0b4\ub97c \uc81c\uacf5\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uace0\uc6a9\ub178\ub3d9\ubd80\ub294 \ub178\ub3d9 \uad00\uacc4 \ubc95\ub839 \uc900\uc218\ub97c \uac10\ub3c5\ud558\uba70 \ubd80\ub2f9 \ud589\uc704\uc5d0 \ub300\ud55c \uad6c\uc81c \uc808\ucc28 \uc548\ub0b4 \ubc0f \uc2dc\uc815 \uba85\ub839\uc744 \ub2f4\ub2f9\ud569\ub2c8\ub2e4."
