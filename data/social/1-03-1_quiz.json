        {
          "text": "\uc624\uc804 10\uc2dc\ubd80\ud130 \uc624\ud6c4 6\uc2dc\uae4c\uc9c0(8\uc2dc\uac04) \uc77c\uc2dc\ud0a4\uba74\uc11c \ud734\uac8c\uc2dc\uac04\uc744 30\ubd84\ub9cc \ubd80\uc5ec\ud568",
