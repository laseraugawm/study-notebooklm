        {
          "text": "\ub178\ub3d9\uc704\uc6d0\ud68c - \ubd80\ub2f9 \ud574\uace0\ub098 \ub178\ub3d9\uad8c \uce68\ud574\uc5d0 \uad00\ud55c \ubc95\ub960 \uc0c1\ub2f4 \ubc0f \uad6c\uc81c \uc2e0\uccad\uc744 \ucc98\ub9ac\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub178\ub3d9\uc704\uc6d0\ud68c\ub294 \ub178\ub3d9\uad00\uacc4\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ud310\uc815 \ubc0f \uc870\uc815 \uc0ac\uac74\uc744 \ub2e4\ub8e8\ub294 \ud589\uc815\uae30\uad00\uc785\ub2c8\ub2e4."
