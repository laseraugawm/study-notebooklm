      "hint": "\uccad\uc18c\ub144\uc758 \ub3c4\ub355\uc0c1 \ub610\ub294 \ubcf4\uac74\uc0c1 \uc548\uc804\uc744 \uc704\ud611\ud558\ub294 \uc2e0\uccb4\uc801 \uace0\uac15\ub3c4 \uc791\uc5c5\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "\uc81c\uacf5\ub41c \ucd9c\ucc98 \uc790\ub8cc\uc758 '\uc5f0\uc18c \uadfc\ub85c\uc790 \uadfc\ub85c\uacc4\uc57d\uc11c' \ub0b4\uc6a9 \uc911 \uad00\ub828 \ubc95\ub960\uc5d0 \uc704\ubc30\ub418\uc9c0 \uc54a\ub294 \uc801\ubc95\ud55c \ud56d\ubaa9\uc740?",
      "answerOptions": [
