      "answerOptions": [
        {
          "text": "\ubb3c\ub958\uc13c\ud130\uc5d0\uc11c\uc758 \ud0dd\ubc30 \ubb3c\uac74 \uc0c1\ud558\ucc28 \uc791\uc5c5",
          "isCorrect": true,
