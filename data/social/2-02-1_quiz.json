        {
          "text": "\ud558\ub098\uc758 \uc601\uc5ed\uc5d0\uc11c \uc6b0\uc704\ub97c \ucc28\uc9c0\ud55c \uac00\uce58\uac00 \ub2e4\ub978 \uc601\uc5ed\uc758 \uac00\uce58\uae4c\uc9c0 \uc9c0\ubc30\ud558\ub294 \uac83\uc774 \ub2e4\uc6d0\uc801 \ud3c9\ub4f1\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud55c \uc601\uc5ed\uc758 \uac00\uce58\uac00 \ub2e4\ub978 \uc601\uc5ed\uae4c\uc9c0 \uce68\ubc94\ud558\uc9c0 \uc54a\uace0 \uace0\uc720 \uc601\uc5ed\uc5d0 \uba38\ubb34\ub97c \ub54c '\ub2e4\uc6d0\uc801 \ud3c9\ub4f1'\uc774 \uc2e4\ud604\ub41c\ub2e4\uace0 \ubcf4\uc558\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubd80\ub098 \uad8c\ub825 \uac19\uc740 \ud2b9\uc815 \uac00\uce58\uac00 \ub2e4\ub978 \uc601\uc5ed\uc758 \uac00\uce58\uae4c\uc9c0 \ub3c5\uc810\ud558\uac70\ub098 \uc9c0\ubc30\ud558\uc9c0 \uc54a\ub294 \uc0c1\ud0dc\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc785\uc7a5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?\n\n[\ud1a0\ub860 \ubc1c\uc5b8]\n\"\uac10\uc5fc\ubcd1 \ud655\uc0b0 \uc0c1\ud669\uc5d0\uc11c \ub9c8\uc2a4\ud06c \ucc29\uc6a9 \uc758\ubb34\ud654\ub294 \uacf5\uacf5 \uc548\uc804\uacfc \uacf5\ub3d9\uccb4\uc758 \uac74\uac15\uc744 \uc9c0\ud0a4\ub294 \uc911\uc694\ud55c \ubc29\ubc95\uc785\ub2c8\ub2e4. \ub530\ub77c\uc11c \uacf5\ub3d9\uccb4 \uc804\uccb4\uc758 \uac74\uac15\uacfc \uc548\uc804\uc744 \ubcf4\ud638\ud558\uae30 \uc704\ud574 \uac1c\uc778\uc5d0\uac8c \ub9c8\uc2a4\ud06c \ucc29\uc6a9\uc758 \uc758\ubb34\ub97c \ubd80\uc5ec\ud558\ub294 \uac83\uc740 \uc815\ub2f9\ud569\ub2c8\ub2e4.\"",
      "answerOptions": [
        {
          "text": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc744 \ubc14\ud0d5\uc73c\ub85c \uc791\uc131\ub41c \uc785\uc7a5\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uacf5 \uc548\uc804, \uacf5\ub3d9\uccb4 \uac74\uac15, \ucc45\uc784\uacfc \uc758\ubb34\ub97c \uac15\uc870\ud558\ubbc0\ub85c \uacf5\ub3d9\uccb4\uc8fc\uc758 \uc2dc\uac01\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc758 \uc88b\uc740 \uc0b6\uc774 \uacf5\ub3d9\uccb4\uc758 \uc720\uc9c0 \ubc0f \ubc1c\uc804\uacfc \ubd88\uac00\ubd84\uc758 \uad00\uacc4\uc5d0 \uc788\uc74c\uc744 \uac15\uc870\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\ub3d9\uccb4\uc758 \uc548\uc804\uc774 \uace7 \uac1c\uc778\uc758 \uac74\uac15\uacfc \uc9c1\uacb0\ub41c\ub2e4\ub294 \uacf5\ub3d9\uccb4\uc8fc\uc758\uc758 \uc2dc\uac01\uc774 \ubc18\uc601\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc758 \uc790\uc720\ub85c\uc6b4 \uc120\ud0dd\uad8c \ubcf4\uc7a5\uacfc \uae30\ubcf8\uc801 \uad8c\ub9ac\ub97c \ubb34\uc5c7\ubcf4\ub2e4 \uc6b0\uc120\uc2dc\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\uc778\uc758 \uc120\ud0dd\uad8c\uacfc \uae30\ubcf8\uc801\uc778 \uc790\uc720\ub97c \ucd5c\uc6b0\uc120\uc73c\ub85c \ub450\ub294 \uac83\uc740 \uc81c\uc2dc\ubb38\uacfc \ub2ec\ub9ac \uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc758 \uc785\uc7a5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\ub3d9\uccb4 \uad6c\uc131\uc6d0\uc73c\ub85c\uc11c \uc720\ub300\uac10\uc744 \ubc14\ud0d5\uc73c\ub85c \ucc45\uc784\uacfc \uc758\ubb34\ub97c \ub2e4\ud560 \uac83\uc744 \ucd09\uad6c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\ub3d9\uccb4\uc758 \uc548\ub155\uc744 \uc704\ud574 \uad6c\uc131\uc6d0\uc758 \uc758\ubb34 \uc774\ud589\uc744 \uac15\uc870\ud558\ub294 \uc8fc\uc7a5\uc5d0 \ubd80\ud569\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubc1c\uc5b8\ubb38\uc774 \uac1c\uc778\uc758 '\uc120\ud0dd\uc758 \uc790\uc720'\ub97c \uac15\uc870\ud558\ub294\uc9c0, \uc544\ub2c8\uba74 '\uacf5\ub3d9\uccb4\uc758 \uc548\uc804\uacfc \uc758\ubb34'\ub97c \uac15\uc870\ud558\ub294\uc9c0 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uacfc \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc744 \ube44\uad50\ud55c \ub0b4\uc6a9\uc73c\ub85c \uc54c\ub9de\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc720\uc8fc\uc758\ub294 \uad6d\uac00\uac00 \uc911\ub9bd\uc744 \uc9c0\ucf1c\uc57c \ud55c\ub2e4\uace0 \ubcf4\uc9c0\ub9cc, \uacf5\ub3d9\uccb4\uc8fc\uc758\ub294 \uad6d\uac00\uac00 \uc911\ub9bd\ub9cc\uc744 \uc720\uc9c0\ud574\uc11c\ub294 \uc548 \ub41c\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc720\uc8fc\uc758\ub294 \uad6d\uac00 \uc911\ub9bd\uc744, \uacf5\ub3d9\uccb4\uc8fc\uc758\ub294 \uad6d\uac00\uac00 \uacf5\ub3d9\uccb4 \ubaa9\ud45c\ub97c \uc704\ud574 \uc77c\uc815 \uac1c\uc785\ud560 \uc218 \uc788\uc74c\uc744 \uc9c0\uc9c0\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc720\uc8fc\uc758\ub294 \uac1c\uc778\uc744 \uacf5\ub3d9\uccb4\ub85c\ubd80\ud130 \ub3c5\ub9bd\ub41c \uc790\uc728\uc801 \uc874\uc7ac\ub85c, \uacf5\ub3d9\uccb4\uc8fc\uc758\ub294 \uc5f0\uace0\uc640 \uc815\uccb4\uc131\uc744 \uc9c0\ub2cc \uc874\uc7ac\ub85c \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub450 \uc815\uc758\uad00\uc774 \ubc14\ub77c\ubcf4\ub294 \uc778\uac04\uad00\uc758 \ud575\uc2ec\uc801\uc778 \ucc28\uc774\uc810\uc744 \uc62c\ubc14\ub974\uac8c \uc11c\uc220\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc720\uc8fc\uc758\ub294 \uac1c\uc778\uc758 \uc790\uc720 \uc2e4\ud604\uc744, \uacf5\ub3d9\uccb4\uc8fc\uc758\ub294 \uacf5\ub3d9\uccb4\uc758 \ubaa9\ud45c \uc2e4\ud604\uacfc \uc758\ubb34 \ub2e4\ud558\uae30\ub97c \uc815\ub2f9\uc131 \uae30\uc900\uc73c\ub85c \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac01 \uc815\uc758\uad00\uc774 \ucd94\uad6c\ud558\ub294 \uc6b0\uc120\uc801 \uac00\uce58\uc640 \uc815\uc758\uc758 \uae30\uc900\uc744 \uc801\uc808\ud558\uac8c \ube44\uad50\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc720\uc8fc\uc758\ub294 \uac1c\uc778\uc758 \uad8c\ub9ac \uce68\ud574 \uc6b0\ub824 \ub54c\ubb38\uc5d0 \ud0c0\uc778\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\ub294 \ud589\uc704\ub3c4 \uc81c\ud55c\ud560 \uc218 \uc5c6\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\uc720\uc8fc\uc758 \uc5ed\uc2dc \ud0c0\uc778\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\ub294 \ud589\uc704\ub294 \uc815\ub2f9\ud55c \uc790\uc720\uc758 \ubc94\uc704\ub97c \ubc97\uc5b4\ub09c \uac83\uc73c\ub85c \ubcf4\uc544 \uc81c\ud55c\ud560 \uc218 \uc788\ub2e4\uace0 \uc778\uc815\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc790\uc720\uc8fc\uc758\uc5d0\uc11c \uac1c\uc778\uc758 \uc790\uc720\uac00 '\ud0c0\uc778\uc5d0\uac8c \ud53c\ud574\ub97c \uc904 \ub54c' \uc5b4\ub5bb\uac8c \ub2e4\ub8e8\uc5b4\uc9c0\ub294\uc9c0 \uae30\uc5b5\ud574 \ubcf4\uc138\uc694."
