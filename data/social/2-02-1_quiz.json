      "hint": "\uace0\ud5a5\uc774\ub77c\ub294 '\uc9c0\uc5f0'\uc5d0 \ub04c\ub824 \uc608\uc0b0\uc744 \ubd88\uade0\ud615\ud558\uac8c \ubc30\uc815\ud55c \uacf5\ubb34\uc6d0 B \uc528\uc758 \uc0ac\ub840\ub97c \ucc38\uace0\ud558\uc138\uc694."
    },
    {
      "question": "\ub9e4\ud0a8\ud0c0\uc774\uc5b4(MacIntyre)\uc758 \uacf5\ub3d9\uccb4\uc8fc\uc758 \uc0ac\uc0c1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ub78c\uc740 \uc0ac\ud68c\uc801 \uc5ed\ud560\uc744 \ub5a0\ub098 \uc5f0\uace0\uac00 \uc5c6\ub294 \uc21c\uc218\ud55c \uc790\uc544\ub85c\uc11c \uc0b6\uc758 \ubaa9\uc801\uc744 \uacb0\uc815\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub9e4\ud0a8\ud0c0\uc774\uc5b4\ub294 \uc778\uac04\uc774 \uc0ac\ud68c\uc801 \uc5ed\ud560(\uc544\ub4e4, \ub538, \uc2dc\ubbfc \ub4f1)\uc744 \ud1b5\ud574 \uc815\uccb4\uc131\uc744 \ud615\uc131\ud55c\ub2e4\uace0 \uc8fc\uc7a5\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc740 \uac00\uc871, \ub3c4\uc2dc, \ubbfc\uc871\uacfc \uac19\uc740 \uacf5\ub3d9\uccb4\uc758 \uc5ed\uc0ac\uc801 \ud750\ub984 \uc18d\uc5d0\uc11c \uc790\uc2e0\uc758 \uc774\uc0c1\uc744 \uad6c\uc131\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0b6\uc774 \ud56d\uc0c1 \uacf5\ub3d9\uccb4 \uc18d\uc5d0\uc11c \uc774\ub8e8\uc5b4\uc9c0\uba70, \uacfc\uac70\ub85c\ubd80\ud130 \ub2e4\uc591\ud55c \uc720\uc0b0\uacfc \uc758\ubb34\ub97c \ubb3c\ub824\ubc1b\ub294\ub2e4\uace0 \ubcf4\uc558\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \uc0ac\ud68c\uc5d0\uc11c \ub3d9\uc77c\ud558\uace0 \ubcf4\ud3b8\uc801\uc73c\ub85c \uc801\uc6a9\ub418\ub294 \uac00\uce58 \ubd84\ubc30 \uae30\uc900\uc744 \uc815\ub9bd\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubaa8\ub4e0 \uc0ac\ud68c\uc5d0 \ub3d9\uc77c\ud558\uac8c \uc801\uc6a9\ub418\ub294 \ubcf4\ud3b8\uc801 \ubd84\ubc30 \uae30\uc900\ubcf4\ub2e4\ub294 \uc5ed\uc0ac\uc801\u00b7\ubb38\ud654\uc801 \ub9e5\ub77d\uc744 \uac15\uc870\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\ub3d9\uccb4\uac00 \uac1c\uc778\uc5d0\uac8c \ubd80\uc5ec\ud558\ub294 \uc804\ud1b5\uacfc \uaddc\ubc94\uc740 \uc790\uc720\ub85c\uc6b4 \uc0b6\uc744 \ubc29\ud574\ud558\ubbc0\ub85c \ubc30\uaca9\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub9e4\ud0a8\ud0c0\uc774\uc5b4\ub294 \uacf5\ub3d9\uccb4\uc758 \uc804\ud1b5\uacfc \uc720\uc0b0\uc744 \uc815\uccb4\uc131 \ud615\uc131\uc758 \ud575\uc2ec \uc694\uc18c\ub85c \uc874\uc911\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc778\uac04\uc774 \uac00\uc871, \ub3c4\uc2dc, \ubbfc\uc871 \ub4f1\uc758 \uc5f0\uace0\uc640 \uc720\uc0b0\uc744 \ubb3c\ub824\ubc1b\ub294 '\uc0ac\ud68c\uc801 \uc874\uc7ac'\uc784\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc648\ucc98(Walzer)\uac00 \uc8fc\uc7a5\ud55c \uc815\uc758\uad00\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ud68c\uc801 \uac00\uce58\ub294 \uac01 \uacf5\ub3d9\uccb4\uc758 \uc5ed\uc0ac\uc801\u00b7\ubb38\ud654\uc801 \uc18c\uc0b0\uc73c\ub85c \uace0\uc720\ud55c \uc758\ubbf8\ub97c \uac16\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc648\ucc98\ub294 \uc0ac\ud68c\uc801 \uac00\uce58\ub4e4\uc774 \uac01 \uacf5\ub3d9\uccb4\uc758 \ud2b9\uc218\uc131\uacfc \ubb38\ud654\uc5d0 \ub530\ub77c \ub2e4\ub974\uac8c \uad6c\uc131\ub41c\ub2e4\uace0 \ubd05\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \uc0ac\ud68c\uc5d0\uc11c \ub3d9\uc77c\ud558\uac8c \uc911\uc694\ud55c \uac83\uc73c\ub85c \uc778\uc815\ub418\ub294 \ub2e8 \ud558\ub098\uc758 \uac00\uce58\ub294 \uc874\uc7ac\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc648\ucc98\ub294 \ub2e8\uc77c\ud55c \uac00\uce58 \uae30\uc900\uc744 \uac70\ubd80\ud558\uace0 \uc0ac\ud68c\uc801 \uac00\uce58\uc758 \ub2e4\uc6d0\uc131\uc744 \uc778\uc815\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc11c\ub85c \ub2e4\ub978 \uc0ac\ud68c\uc801 \uac00\uce58\ub294 \uc11c\ub85c \ub2e4\ub978 \uc774\uc720, \uc808\ucc28, \uc8fc\uccb4\uc5d0 \uc758\ud574 \ubd84\ubc30\ub418\uc5b4\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac01 \uc601\uc5ed\uc758 \uac00\uce58\ub294 \uadf8 \uc601\uc5ed\uc758 \uace0\uc720\ud55c \uae30\uc900\uc5d0 \ub9de\uac8c \ubd84\ubc30\ub418\uc5b4\uc57c \ud55c\ub2e4\ub294 \uc601\uc5ed\ubcc4 \ubd84\ubc30\ub97c \uc8fc\uc7a5\ud588\uc2b5\ub2c8\ub2e4."
