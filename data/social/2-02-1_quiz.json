{
  "title": "\uc790\uc720\uc8fc\uc758 \uc815\uc758\uad00 \ud034\uc988",
  "questions": [
    {
      "question": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc774 \ubc14\ub77c\ubcf4\ub294 \uac1c\uc778\uacfc \uc0ac\ud68c(\uad6d\uac00)\uc758 \uad00\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc740 \uacf5\ub3d9\uccb4\uc758 \uc5ed\uc0ac\uc640 \ubb38\ud654\ub97c \uc804\uc218\ubc1b\uc544\uc57c\ub9cc \ube44\ub85c\uc18c \ub3c5\ub9bd\ub41c \uc874\uc7ac\uac00 \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \uac1c\uc778\uc740 \uacf5\ub3d9\uccb4\uc640 \ubb34\uad00\ud558\uac8c \uadf8 \uc790\uccb4\ub85c \ub3c5\ub9bd\ub41c \uc790\uc728\uc801 \uc874\uc7ac\ub85c \uaddc\uc815\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c(\uad6d\uac00)\ub294 \uac1c\uc778\ub4e4\uc774 \ubaa8\uc778 \ub2e8\uc21c\ud55c \uc9d1\ud569\uccb4\uc774\uba70 \uacc4\uc57d\uacfc \ud569\uc758\ub85c \uad6c\uc131\ub41c \uc0b0\ubb3c\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\uc720\uc8fc\uc758\uad00\uc740 \uac1c\uc778\uc744 \uc6b0\uc120\uc2dc\ud558\uba70 \uc0ac\ud68c\ub97c \uac1c\uc778 \uac04\uc758 \ud569\uc758\uc640 \uacc4\uc57d\uc5d0 \uc758\ud574 \ud615\uc131\ub41c \ub2e8\uc21c\ud55c \uc9d1\ud569\uccb4\ub85c \ud30c\uc545\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00\ub294 \uacf5\ub3d9\uccb4\uc758 \ubaa9\ud45c \uc2e4\ud604\uc744 \uc704\ud574 \uac1c\uc778\uc758 \uc0b6\uc5d0 \uc801\uadf9\uc801\uc73c\ub85c \uac1c\uc785\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uad6d\uac00\uc758 \uac1c\uc785\uc774 \uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \uce68\ud574\ud560 \uc218 \uc788\ub2e4\uace0 \ubcf4\uc544 \uad6d\uac00\uc758 \uc911\ub9bd\uc131\uc744 \uac15\uc870\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uacfc \uc0ac\ud68c\ub294 \uc720\uae30\uccb4\uc801\uc73c\ub85c \uacb0\ud569\ud558\uc5ec \ubd84\ub9ac\ud560 \uc218 \uc5c6\ub294 \uad00\uacc4\ub97c \ud615\uc131\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uacfc \uc0ac\ud68c\uac00 \uc720\uae30\uccb4\uc801\uc73c\ub85c \uacb0\ud569\ub418\uc5b4 \uc788\ub2e4\ub294 \uc2dc\uac01\uc740 \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc758 \ud575\uc2ec \uc785\uc7a5\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc790\uc720\uc8fc\uc758\uc5d0\uc11c\ub294 \uac1c\uc778\uc744 \ub3c5\ub9bd\uc801 \uc874\uc7ac\ub85c \ubcf4\uba70, \uc0ac\ud68c\ub97c \uac1c\uc778\ub4e4\uc758 \uacc4\uc57d\uc5d0 \uc758\ud574 \uc131\ub9bd\ub41c \uac83\uc73c\ub85c \uc774\ud574\ud569\ub2c8\ub2e4."
    },
    {
      "question": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \ub2e4\ub8e8\ub294 '\uac1c\uc778\uc758 \uc790\uc720\uc640 \uad8c\ub9ac'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc740 \uc790\uc2e0\uc758 \uc790\uc720\uc640 \uad8c\ub9ac\ub97c \uc5b4\ub5a0\ud55c \uc0c1\ud669\uc5d0\uc11c\ub3c4 \ubb34\uc81c\ud55c\uc801\uc73c\ub85c \ucd94\uad6c\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc720\uc640 \uad8c\ub9ac\uc758 \ubb34\uc81c\ud55c \ucd94\uad6c\ub294 \ud0c0\uc778\uc758 \uad8c\ub9ac\ub97c \uce68\ud574\ud558\uace0 \uadf9\ub2e8\uc801 \uc774\uae30\uc8fc\uc758\ub97c \ucd08\ub798\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uc81c\ud55c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc2e0\uc5d0\uac8c\ub9cc \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \ud589\uc704\ub77c\ub3c4 \uc0ac\ud68c\uc801 \ud569\uc758\uac00 \uc5c6\uc73c\uba74 \uc790\uc720\ub97c \ub204\ub9b4 \uc218 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc720\uc8fc\uc758\ub294 \uc790\uc2e0\uc5d0\uac8c\ub9cc \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \ud589\uc704\uc5d0 \ub300\ud574 \uac1c\uc778\uc774 \ucd5c\ub300\ud55c\uc758 \uc790\uc720\ub97c \ub204\ub824\uc57c \ud55c\ub2e4\uace0 \ubd05\ub2c8\ub2e4."
        },
        {
          "text": "\ud0c0\uc778\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\ub294 \ud589\uc704\uc5d0 \ub300\ud574\uc11c\ub294 \uac1c\uc778\uc758 \uc790\uc720\uac00 \uc81c\ud55c\ub420 \uc218 \uc788\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uac1c\uc778\uc758 \uc790\uc720\ub97c \uc911\uc2dc\ud558\uc9c0\ub9cc, \ud0c0\uc778\uc758 \uad8c\ub9ac\ub098 \uc0ac\ud68c \uc804\uccb4 \uc774\uc775\uc744 \uce68\ud574\ud558\ub294 \ud589\uc704\ub294 \uc778\uc815\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\ub3d9\uccb4\uc758 \uc804\uccb4 \uc774\uc775\uc744 \uc99d\uc9c4\ud558\uae30 \uc704\ud574\uc11c\ub77c\uba74 \uac1c\uc778\uc758 \uae30\ubcf8\uc801 \uc790\uc720\ub97c \ubc15\ud0c8\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc720\uc8fc\uc758\ub294 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc758 \ub354 \ud070 \uc774\uc775\uc744 \uc774\uc720\ub85c \uc18c\uc218\uc758 \uc790\uc720\ub97c \ube7c\uc557\ub294 \uac83\uc740 \uc815\uc758\ub86d\uc9c0 \uc54a\ub2e4\uace0 \uac15\uc870\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubc24\ub2a6\uac8c \ud53c\uc544\ub178\ub97c \uccd0\uc11c \uc774\uc6c3\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\ub294 \uc0ac\ub840\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub864\uc2a4(Rawls)\uc758 \uc790\uc720\uc8fc\uc758 \uc815\uc758\uad00\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud569\uc758 \ub2f9\uc0ac\uc790\ub4e4\uc740 \uc790\uc2e0\uc758 \uc704\uce58\ub098 \uc870\uac74\uc744 \ubaa8\ub974\ub294 '\ubb34\uc9c0\uc758 \ubca0\uc77c'\uc744 \uc4f4 \uc6d0\ucd08\uc801 \uc785\uc7a5\uc744 \uc804\uc81c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub864\uc2a4\ub294 \uacf5\uc815\ud55c \uc815\uc758\uc758 \uc6d0\uce59\uc744 \ub3c4\ucd9c\ud558\uae30 \uc704\ud574 \uacf5\uc815\ud55c \uc870\uac74\uc778 \uc6d0\ucd08\uc801 \uc785\uc7a5\uc758 '\ubb34\uc9c0\uc758 \ubca0\uc77c' \uad6c\uc0c1\uc744 \uc81c\uc2dc\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \uac1c\uc778\uc5d0\uac8c \uae30\ubcf8\uc801 \uc790\uc720\uac00 \ud3c9\ub4f1\ud558\uac8c \ubcf4\uc7a5\ub418\uc5b4\uc57c \ud55c\ub2e4\ub294 \uc6d0\uce59\uc744 \uac15\uc870\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub864\uc2a4 \uc815\uc758\uc758 \uccab \ubc88\uc9f8 \uc6d0\uce59\uc740 \ud3c9\ub4f1\ud55c \uae30\ubcf8\uc801 \uc790\uc720\uc758 \ubcf4\uc7a5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\u00b7\uacbd\uc81c\uc801 \ubd88\ud3c9\ub4f1\uc740 \ucd5c\uc18c \uc218\ud61c\uc790\uc5d0\uac8c \ucd5c\ub300 \uc774\uc775\uc774 \ub420 \ub54c \uc81c\ud55c\uc801\uc73c\ub85c \ud5c8\uc6a9\ub420 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub864\uc2a4\ub294 \ucc28\ub4f1\uc758 \uc6d0\uce59\uc744 \ud1b5\ud574 \uc0ac\ud68c\uc801 \uc57d\uc790(\ucd5c\uc18c \uc218\ud61c\uc790)\uc5d0\uac8c \ucd5c\ub300 \uc774\uc775\uc774 \ub3cc\uc544\uac00\ub294 \ubd88\ud3c9\ub4f1\ub9cc\uc744 \uc778\uc815\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00\ub294 \uc624\uc9c1 \uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \ubcf4\ud638\ud558\ub294 \uc18c\uadf9\uc801 \uc5ed\ud560\ub9cc \uc218\ud589\ud574\uc57c \ud55c\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc18c\uadf9\uc801 \uc5ed\ud560\ub9cc\uc744 \uc218\ud589\ud558\ub294 '\ucd5c\uc18c \uad6d\uac00'\ub97c \uc8fc\uc7a5\ud55c \ud559\uc790\ub294 \ub864\uc2a4\uac00 \uc544\ub2c8\ub77c \ub178\uc9c1\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubcf5\uc9c0\ub098 \uc7ac\ubd84\ubc30 \uc815\ucc45\uc744 \ud5c8\uc6a9\ud558\ub294 \uc785\uc7a5\uacfc \ucd5c\uc18c\ud55c\uc758 \uce58\uc548\u00b7\uad8c\ub9ac \ubcf4\ud638\ub9cc \uac15\uc870\ud558\ub294 \uc785\uc7a5\uc744 \uad6c\ubcc4\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub178\uc9c1(Nozick)\uc758 \uc790\uc720 \uc9c0\uc0c1\uc8fc\uc758 \uc785\uc7a5\uc5d0 \uad00\ud55c \uc9c4\uc220\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucd5c\uc18c \uad6d\uac00\ubcf4\ub2e4 \ub354 \ud3ec\uad04\uc801\uc778 \uad6d\uac00\ub294 \uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \uce68\ud574\ud558\ubbc0\ub85c \uc815\ub2f9\ud654\ub420 \uc218 \uc5c6\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub178\uc9c1\uc740 \uac1c\uc778\uc758 \uc790\uc720\uc640 \uad8c\ub9ac\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \ubcf4\ud638\ud558\ub294 \uc18c\uadf9\uc801 \uc5ed\ud560\uc758 \ucd5c\uc18c \uad6d\uac00\ub9cc\uc744 \uc815\ub2f9\ud558\ub2e4\uace0 \ubd05\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc801 \ubd88\ud3c9\ub4f1\uc744 \ud574\uc18c\ud558\uae30 \uc704\ud574 \uad6d\uac00\uac00 \uc801\uadf9\uc801\uc778 \uc18c\ub4dd \uc7ac\ubd84\ubc30 \uc815\ucc45\uc744 \uc2e4\uc2dc\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub178\uc9c1\uc740 \uac1c\uc778\uc758 \uc815\ub2f9\ud55c \uc18c\uc720\uad8c\uc5d0 \ub300\ud55c \uad6d\uac00\uc758 \uc7ac\ubd84\ubc30 \ubaa9\uc801 \uac1c\uc785\uc744 \uad8c\ub9ac \uce68\ud574\ub85c \ubcf4\uace0 \ubc18\ub300\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\u00b7\uacbd\uc81c\uc801 \ubd88\ud3c9\ub4f1\uc740 \ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \uae30\ud68c\uac00 \uade0\ub4f1\ud558\uac8c \uc8fc\uc5b4\uc9c8 \ub54c\ub9cc \uc815\ub2f9\ud654\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\ud68c \uade0\ub4f1\uc758 \uc870\uac74\uacfc \ucd5c\uc18c \uc218\ud61c\uc790\uc5d0 \ub300\ud55c \uace0\ub824\ub97c \uc815\uc758\uc758 \uc6d0\uce59\uc73c\ub85c \uc81c\uc2dc\ud55c \uac83\uc740 \ub864\uc2a4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc758 \uc18c\uc720\ubb3c \ucde8\ub4dd\uacfc \uc774\uc804 \uacfc\uc815\uc774 \uc815\ub2f9\ud558\ub354\ub77c\ub3c4 \uc18c\uc720 \uad8c\ub9ac\ub294 \uad6d\uac00\uc5d0 \uc18d\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ub2f9\ud55c \ucde8\ub4dd\uacfc \uc774\uc804\uc744 \uac70\uce5c \uc18c\uc720\ubb3c\uc5d0 \ub300\ud55c \uc644\uc804\ud55c \uad8c\ub9ac\ub294 \uac1c\uc778\uc5d0\uac8c \uc788\ub2e4\uace0 \ubd05\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub178\uc9c1\uc774 \uc815\ub2f9\ud558\ub2e4\uace0 \uc778\uc815\ud55c \uc720\uc77c\ud55c \uad6d\uac00 \ud615\ud0dc\uac00 \ubb34\uc5c7\uc778\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc758 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\ub9cc\uc744 \ubcf4\uae30\uc5d0\uc11c \uc788\ub294 \ub300\ub85c \uace0\ub978 \uac83\uc740?\n\n\u3131. \uad6d\uac00\uac00 \uc911\ub9bd\uc744 \uc720\uc9c0\ud558\ub294 \uac83\uc740 \uacf5\ub3d9\uccb4\uc758 \ubaa9\ud45c\ub97c \ud3ec\uae30\ud558\ub294 \uac83\uacfc \uac19\ub2e4\uace0 \ubcf8\ub2e4.\n\u3134. \uac1c\uc778\uc758 \uc88b\uc740 \uc0b6\uc740 \uacf5\ub3d9\uccb4\uc640 \ubd84\ub9ac\ub418\uc5b4 \ub3c5\ub9bd\uc801\uc73c\ub85c \uc644\uc131\ub420 \uc218 \uc788\ub2e4\uace0 \ubcf8\ub2e4.\n\u3137. \uac1c\uc778\uc740 \uacf5\ub3d9\uccb4\uc758 \uad6c\uc131\uc6d0\uc73c\ub85c\uc11c \uacf5\ub3d9\uccb4\uc5d0 \ub300\ud55c \ucc45\uc784\uacfc \uc758\ubb34\ub97c \ub2e4\ud574\uc57c \ud55c\ub2e4.\n\u3139. \uac1c\uc778 \uac04\uc758 \uc790\uc728\uc801 \uacc4\uc57d\uacfc \ud569\uc758\ub97c \ud1b5\ud574 \uacf5\ub3d9\uccb4\uc758 \uc815\uccb4\uc131\uc774 \uacb0\uc815\ub41c\ub2e4\uace0 \ubcf8\ub2e4.",
      "answerOptions": [
        {
          "text": "\u3131, \u3137",
          "isCorrect": true,
          "rationale": "\uacf5\ub3d9\uccb4\uc8fc\uc758\ub294 \uad6d\uac00\uc758 \uac1c\uc785\uacfc \uc911\ub9bd \ubd88\uac00\ub97c \uc8fc\uc7a5\ud558\uba70(\u3131), \uad6c\uc131\uc6d0\uc73c\ub85c\uc11c\uc758 \uc758\ubb34\uc640 \ucc45\uc784\uc744 \uac15\uc870\ud569\ub2c8\ub2e4(\u3137)."
        },
        {
          "text": "\u3131, \u3134",
          "isCorrect": false,
          "rationale": "\uacf5\ub3d9\uccb4\uc8fc\uc758\ub294 \uac1c\uc778\uc758 \uc88b\uc740 \uc0b6\uc774 \uacf5\ub3d9\uccb4\uc640 \ubd84\ub9ac\ub420 \uc218 \uc5c6\ub2e4\uace0 \ubd05\ub2c8\ub2e4."
        },
        {
          "text": "\u3134, \u3139",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uc758 \ub3c5\ub9bd\uc131\uacfc \uc790\uc728\uc801 \uacc4\uc57d\uc744 \uc911\uc2ec\uc73c\ub85c \ubcf4\ub294 \uac83\uc740 \uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc758 \uc2dc\uac01\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\u3137, \u3139",
          "isCorrect": false,
          "rationale": "\uacc4\uc57d\uacfc \ud569\uc758\uc5d0 \ub530\ub978 \uc0ac\ud68c \uad6c\uc131\uc744 \uac15\uc870\ud558\ub294 \uc9c4\uc220(\u3139)\uc740 \uc790\uc720\uc8fc\uc758\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uacf5\ub3d9\uccb4\uc8fc\uc758\ub294 \uac1c\uc778\uacfc \uacf5\ub3d9\uccb4\uc758 \uc720\uae30\uc801 \uacb0\ud569 \ubc0f \uad6d\uac00\uc758 \uc77c\uc815 \ubd80\ubd84 \uac1c\uc785\uc744 \uac15\uc870\ud569\ub2c8\ub2e4."
    },
    {
      "question": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc744 \uc9c0\ub098\uce58\uac8c \uac15\uc870\ud560 \ub54c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \ubd80\uc791\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc774 \ud0c0\uc778\uacfc \ubb34\uad00\ud558\uac8c \uadf9\ub2e8\uc801\uc778 \uc774\uae30\uc8fc\uc758\ub97c \ucd94\uad6c\ud558\ub294 \ud604\uc0c1",
          "isCorrect": false,
          "rationale": "\uadf9\ub2e8\uc801 \uc774\uae30\uc8fc\uc758\ub294 \uac1c\uc778\uc758 \uc790\uc720\uc640 \uad8c\ub9ac\ub9cc\uc744 \ubb34\uc81c\ud55c \ucd94\uad6c\ud560 \ub54c \ubc1c\uc0dd\ud558\ub294 \uc790\uc720\uc8fc\uc758\uc758 \ubd80\uc791\uc6a9\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud608\uc5f0, \uc9c0\uc5f0, \ud559\uc5f0 \ub4f1\uc744 \uc6b0\uc120\uc2dc\ud558\uc5ec \uc9d1\ub2e8 \uac04 \ubd88\ud3c9\ub4f1\uc744 \ucd08\ub798\ud558\ub294 \uc5f0\uace0\uc8fc\uc758 \uc2ec\ud654",
          "isCorrect": true,
          "rationale": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uac00 \uacfc\ub3c4\ud574\uc9c0\uba74 \uc18d\ud55c \uc9d1\ub2e8\uc744 \uae30\uc900\uc73c\ub85c \uc0ac\ub78c\uc744 \ud3c9\uac00\ud558\ub294 \uc5f0\uace0\uc8fc\uc758\ub098 \uc9d1\ub2e8 \uc774\uae30\uc8fc\uc758\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00\uac00 \uac1c\uc778\uc758 \uc0b6\uacfc \uac00\uce58\uad00\uc5d0 \uc804\ud600 \uac1c\uc785\ud558\uc9c0 \uc54a\uc544 \ubc1c\uc0dd\ud558\ub294 \uc9c8\uc11c \ud63c\ub780",
          "isCorrect": false,
          "rationale": "\uad6d\uac00\uac00 \ubc29\uad00\ud558\uac70\ub098 \uac1c\uc785\ud558\uc9c0 \uc54a\ub294 \uac83\uc740 \uc790\uc720\uc8fc\uc758\uc801 \uad6d\uac00 \uc911\ub9bd\uc131\uc758 \ubb38\uc81c\uc810\uacfc \uad00\ub828\uc774 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc758 \ub2a5\ub825\uacfc \ub178\ub825\uc5d0 \ub530\ub978 \uacf5\uc815\ud55c \ubcf4\uc0c1\uc774 \uc6d0\ucc9c\uc801\uc73c\ub85c \ucc28\ub2e8\ub418\ub294 \ubb38\uc81c",
          "isCorrect": false,
          "rationale": "\uc5f0\uace0\uc8fc\uc758\ub294 \uac1c\uc778\uc758 \ub2a5\ub825\uc774\ub098 \ub178\ub825\uacfc \uad00\uacc4\uc5c6\uc774 \uc18d\ud55c \uacf5\ub3d9\uccb4\ub85c \ud3c9\uac00\ud55c\ub2e4\ub294 \ud55c\uacc4\uac00 \uc788\uc73c\ub098, \ud575\uc2ec \ubd80\uc791\uc6a9 \ud45c\ud604\uc740 \uc5f0\uace0\uc8fc\uc758 \uc2ec\ud654 \ubc0f \uc9d1\ub2e8 \uc774\uae30\uc8fc\uc758\uc785\ub2c8\ub2e4."
