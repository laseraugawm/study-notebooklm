{
  "title": "\uc138\uacc4\uc2dc\ubbfc \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub298\ub0a0 \uc138\uacc4\ud654\uc758 \ud750\ub984 \uc18d\uc5d0\uc11c \uc138\uacc4\uac00 \ud558\ub098\uc758 \uacf5\ub3d9\uccb4 \uc131\uaca9\uc744 \uac15\ud558\uac8c \ub760\uac8c \ub41c \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uad6d\uac00\uac00 \ubc00\uc811\ud558\uac8c \uc5f0\uacb0\ub418\uc5b4 \uc11c\ub85c \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc0ac \ub204\uc2a4\ubc14\uc6c0\uc774 \uc81c\uc2dc\ud55c \uac1c\uc778\uc758 \uc758\uc2dd\uc774 \ud655\uc7a5\ub418\ub294 8\ub2e8\uacc4 \ub3d9\uc2ec\uc6d0 \uc601\uc5ed\uc744 \uc21c\uc11c\ub300\ub85c \uc368 \ubcf4\uc790."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc544 \u2192 \uac00\uc871 \u2192 \ud655\ub300\ub41c \uac00\uc871 \u2192 \uc774\uc6c3 \u2192 \uc9c0\uc5ed \uc9d1\ub2e8 \u2192 \uad6d\ubbfc \u2192 \uc2dc\ubbfc \u2192 \uc778\ub958"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc0ac \ub204\uc2a4\ubc14\uc6c0\uc774 \uac15\uc870\ud55c \uc138\uacc4\uc2dc\ubbfc\uc73c\ub85c\uc11c\uc758 \ubc14\ub78c\uc9c1\ud55c \uc790\uc138\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\uc2a4\ub85c\ub97c \uc778\ub958\uc5d0 \ub458\ub7ec\uc2f8\uc778 \uc138\uacc4\uc2dc\ubbfc\uc73c\ub85c \uc778\uc2dd\ud558\uace0, \uc9c0\uad6c\ucd0c\uc758 \ub2e4\uc591\ud55c \ubb38\ud654\uc640 \uac00\uce58\ub97c \uc874\uc911\ud558\uba70 \ub354 \ud070 \uacf5\ub3d9\uccb4\ub97c \uc704\ud574 \ud589\ub3d9\ud558\ub294 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804 \uc9c0\uad6c\uc801 \uc218\uc900\uc758 \ubb38\uc81c\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud574 \uc138\uacc4\uc2dc\ubbfc\uc774 \ubc14\ud0d5\uc73c\ub85c \uc0bc\uc544\uc57c \ud560 \ud575\uc2ec \uc758\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubcc4 \uc0ac\ud68c \uc9d1\ub2e8\uc758 \uc774\uc775\uc744 \ub118\uc5b4 \uc778\ub958 \uc804\uccb4\uc758 \uc774\uc775\uc744 \uc6b0\uc120\uc2dc\ud558\ub294 \uc138\uacc4\uc2dc\ubbfc \uc758\uc2dd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ub7ec \uad6d\uac00\uc640 \uc870\uc9c1\uc774 \ud611\ub825\ud558\uc5ec \ub300\uc751\ud574\uc57c \ud560 \uc804 \uc9c0\uad6c\uc801 \uc218\uc900\uc758 \ubb38\uc81c 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4\ubcc0\ud654, \uc804\uc5fc\ubcd1, \uad6d\uc81c \ud14c\ub7ec"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c\uc5d0 \ubb34\uc778 \uc6b4\uc1a1 \uc218\ub2e8\uc774 \uc0c1\uc6a9\ud654\ub428\uc5d0 \ub530\ub77c \ub098\ud0c0\ub098\ub294 \uc8fc\uc694 \ubcc0\ud654\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uac04\uacfc \uacf5\uac04\uc758 \uc81c\uc57d \uac10\uc18c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0dd\uba85 \uacf5\ud559\uae30\uc220\uc758 \ubc1c\uc804\uc5d0 \ub530\ub77c \uc6b0\ub824\ub418\ub294 \uc8fc\uc694 \uc0ac\ud68c\uc801 \ubd80\uc791\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc758 \uc815\uccb4\uc131\uacfc \ub3c4\ub355\uc801 \uac00\uce58\uc758 \ud63c\ub780 \uc99d\uac00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\ubb34\uc5ed\uc774 \ud655\ub300\ub420 \ub54c \uad6d\uac00 \uac04 \ubb34\uc5ed \uacbd\uc7c1\uc740 \uc5b4\ub5bb\uac8c \ubcc0\ud654\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uac04 \ubb34\uc5ed \uacbd\uc7c1\uc774 \uc57d\ud654\ub418\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ub354\uc6b1 \uc2ec\ud654\u00b7\uac15\ud654\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \ud658\uacbd \ubd84\uc57c \uc9c1\uc5c5 \uc911 '\uae30\ud6c4\ubcc0\ud654 \ub300\uc751 \uc804\ubb38\uac00'\uc758 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4\ubcc0\ud654\ub97c \uc608\uce21\ud558\uace0 \uc774\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud55c \ub300\ucc45\uc744 \ub9c8\ub828\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \ud658\uacbd \ubd84\uc57c \uc9c1\uc5c5 \uc911 '\uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uc804\ubb38\uac00'\uc758 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\uc5d0\uc11c \uc9c0\uad6c\ub97c \uc0b4\ub9ac\ub294 \uc5d0\ub108\uc9c0\ub97c \uc5f0\uad6c\ud558\uace0 \ubc1c\uad74\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c \ubd84\uc57c \uc9c1\uc5c5 \uc911 '\ub3c4\uc2dc \uc7ac\uc0dd \uc804\ubb38\uac00'\uc758 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc1e0\ud1f4\ud558\uac70\ub098 \ub099\ud6c4\ub41c \ub3c4\uc2dc\uc5d0 \uc0c8\ub85c\uc6b4 \uc0dd\uba85\uc744 \ubd88\uc5b4\ub123\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c \ubd84\uc57c \uc9c1\uc5c5 \uc911 '\ubb38\ud654 \ucf58\ud150\uce20 \uc804\ubb38\uac00'\uc758 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\ud654\ub97c \ub2e4\uc591\ud55c \ucf58\ud150\uce20\ub85c \uc81c\uc791\ud558\uace0 \ucc3d\uc791\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uae30\uc220 \ubd84\uc57c \uc9c1\uc5c5 \uc911 '\ubb34\uc778 \uc790\ub3d9\ucc28 \uc5d4\uc9c0\ub2c8\uc5b4'\uc758 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b4\uc804\uc790\uc758 \uc870\uc791 \uc5c6\uc774\ub3c4 \uc2a4\uc2a4\ub85c \ub3c4\ub85c \uc0c1\ud669\uc744 \ud30c\uc545\ud558\uc5ec \ubaa9\uc801\uc9c0\uc5d0 \ub3c4\ucc29\ud558\ub294 \ucc28\ub7c9 \uc81c\uc5b4 \uae30\uc220\uc744 \uac1c\ubc1c\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uae30\uc220 \ubd84\uc57c \uc9c1\uc5c5 \uc911 '\uc0ac\ubb3c \uc778\ud130\ub137 \uc804\ubb38\uac00'\uc758 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\ub4e0 \uc0ac\ubb3c\uc5d0 \uc778\ud130\ub137\uc744 \uc5f0\uacb0\ud558\uc5ec \uc0c8\ub85c\uc6b4 \uac00\uce58\ub098 \uc11c\ube44\uc2a4\ub97c \ucc3d\ucd9c\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \ubcf4\uc548 \ubd84\uc57c \uc9c1\uc5c5 \uc911 '\uc815\ubcf4 \ubcf4\ud638 \uc804\ubb38\uac00'\uc758 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \ubcf4\ud638 \uc218\uc900\uc744 \uc9c4\ub2e8\ud558\uace0 \uc911\uc694\ud55c \uc815\ubcf4\ub97c \ubcf4\ud638\ud558\uae30 \uc704\ud55c \ud574\uacb0 \ubc29\uc548\uc744 \uc81c\uc2dc\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \ubcf4\uc548 \ubd84\uc57c \uc9c1\uc5c5 \uc911 '\uc0dd\uccb4 \uc778\uc2dd \uc804\ubb38\uac00'\uc758 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ub78c \ubab8\uc758 \ud2b9\uc815 \ubd80\ubd84(\uc9c0\ubb38, \ud64d\ucc44 \ub4f1)\uc744 \uc774\uc6a9\ud558\uc5ec \ube44\ubc00\ubc88\ud638 \ubc0f \ubcf4\uc548 \uc7a5\uce58\ub97c \uac1c\ubc1c\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\uc758 \uc778\uad6c \uc131\uc7a5\uc5d0\uc11c \uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc9c4\uad6d\uc758 \uc778\uad6c \uc99d\uac00\uc728\uc740 \uc815\uccb4\ub418\uac70\ub098 \uac10\uc18c\ud558\uc9c0\ub9cc, \uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc758 \uc778\uad6c \uc99d\uac00\uc728\uc740 \ub192\uac8c \ub098\ud0c0\ub09c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\uc758 \uc778\uad6c \ubd84\ud3ec \uacb0\uc815\uc5d0 \uc601\ud5a5\uc744 \uc8fc\ub294 \ub450 \uac00\uc9c0 \uc8fc\uc694 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\uc801 \uc694\uc778, \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \uc694\uc778"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc5d0\uc11c \uc120\uc9c4\uad6d\uc73c\ub85c \ubc1c\uc0dd\ud558\ub294 \uc778\uad6c \uc774\ub3d9\uc758 \uc8fc\ub41c \uc6d0\uc778 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\uc801 \uc694\uc778 (\ub354 \ub098\uc740 \uc18c\ub4dd \ubc0f \uc77c\uc790\ub9ac \uae30\ud68c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc7c1\uc774\ub098 \ubd84\uc7c1 \ub4f1\uc73c\ub85c \uc778\ud574 \ub09c\ubbfc\uc774 \uc774\ub3d9\ud558\ub294 \uac83\uc740 \uc5b4\ub5a4 \uc694\uc778\uc5d0 \uc758\ud55c \uc778\uad6c \uc774\ub3d9\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uce58\uc801 \uc694\uc778"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \ud604\uc0c1\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc815\ucc45\uc801 \ubc29\uc548\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd9c\uc0b0 \uc7a5\ub824 \uc815\ucc45 \ucd94\uc9c4 \ubc0f \uc0ac\ud68c \ubcf4\uc7a5 \uc81c\ub3c4 \uac15\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd9c\uc0b0\uc728 \uc800\ud558 \uadf9\ubcf5\uc744 \uc704\ud55c \uad6c\uccb4\uc801\uc778 \uc81c\ub3c4\uc801 \uc9c0\uc6d0\ucc45 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd9c\uc0b0 \uc7a5\ub824\uae08 \uc9c0\uc6d0, \ucd9c\uc0b0 \ud734\uac00 \ubcf4\uc7a5, \uc721\uc544 \ud734\uc9c1 \ubcf4\uc7a5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \uacfc\uc789 \ud604\uc0c1\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc815\ucc45 \ubc29\uc548 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ub7c9 \uc99d\uc0b0 \uc815\ucc45, \ucd0c\ub77d\uc758 \uc0dd\ud65c \ud658\uacbd \uac1c\uc120"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d(\uc608: \uac00\ub098)\uacfc \ube44\uad50\ud588\uc744 \ub54c \uc120\uc9c4\uad6d(\uc608: \ud504\ub791\uc2a4) \uc778\uad6c \uad6c\uc870\uc758 \uc138 \uac00\uc9c0 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uae30\ub300 \uc218\uba85\uc774 \uae38\ub2e4.\n2. \uc911\uc704 \uc5f0\ub839\uc774 \ub192\ub2e4.\n3. \ub178\ub144\uce35 \ube44\uc728\uc774 \ub192\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc9c4\uad6d(\uc608: \ud504\ub791\uc2a4)\uacfc \ube44\uad50\ud588\uc744 \ub54c \uac1c\ubc1c\ub3c4\uc0c1\uad6d(\uc608: \uac00\ub098) \uc778\uad6c \uad6c\uc870\uc758 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc18c\ub144\uce35 \ube44\uc728\uc774 \ub192\uace0 \uc911\uc704 \uc5f0\ub839\uc774 \ub0ae\uc73c\uba70, \uc0c1\ub300\uc801\uc73c\ub85c \uae30\ub300 \uc218\uba85\uc774 \uc9e7\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc694 \ud654\uc11d \uc5d0\ub108\uc9c0 \uc790\uc6d0 \uc911 \uc81c\ucca0 \uacf5\uc5c5\uc774\ub098 \ubc1c\uc804\uc758 \uc5f0\ub8cc\ub85c \uc8fc\ub85c \uc0ac\uc6a9\ub418\ub294 \uc790\uc6d0\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11d\ud0c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uc8fc\uc694 \uc5d0\ub108\uc9c0 \uc790\uc6d0 \uc911 \uc18c\ube44\ub7c9\uacfc \uad6d\uc81c \uc774\ub3d9\ub7c9\uc774 \uac00\uc7a5 \ub9ce\uc740 \uc790\uc6d0\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11d\uc720"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11d\uc720 \ubc0f \uc11d\ud0c4\uc5d0 \ube44\ud574 \uc5f0\uc18c \uc2dc \uc624\uc5fc \ubb3c\uc9c8 \ubc30\ucd9c\ub7c9\uc774 \uc801\uc740 \ud654\uc11d \uc5d0\ub108\uc9c0 \uc790\uc6d0\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc9c\uc5f0\uac00\uc2a4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5d0\ub108\uc9c0 \uc790\uc6d0 \uc911\uc2ec\uc758 \uc18c\ube44 \uad6c\uc870\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \ub300\ud45c\uc801\uc778 \ubb38\uc81c\uc810 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd \ubb38\uc81c, \uc790\uc6d0 \ubbfc\uc871\uc8fc\uc758, \uc790\uc6d0 \uace0\uac08 \ubc0f \ubd80\uc871"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5d0\ub108\uc9c0 \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574 \ubcf4\uae09 \ud655\ub300\uac00 \ud544\uc694\ud55c \ub300\ud45c\uc801 \ub300\uc548 \uc5d0\ub108\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0 (\uc608: \ud0dc\uc591\uad11 \ubc1c\uc804, \ud48d\ub825 \ubc1c\uc804)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "[\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804]\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c \ubc1c\uc804, \uc0ac\ud68c \uc548\uc815\uacfc \ud1b5\ud569, \ud658\uacbd \ubcf4\uc804\uc774 \uade0\ud615\uc744 \uc774\ub8e8\ub294 \ubc1c\uc804"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804 \uac1c\ub150\uc774 \ub110\ub9ac \ucc44\ud0dd\ub41c \uacc4\uae30\uac00 \ub41c 1992\ub144 \uad6d\uc81c \ud68c\uc758\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube0c\ub77c\uc9c8 \ub9ac\uc6b0\ub370\uc790\ub124\uc774\ub8e8\uc5d0\uc11c \uc5f4\ub9b0 \uc720\uc5d4 \ud658\uacbd \uac1c\ubc1c \ud68c\uc758 (UNCED)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1987\ub144\uc5d0 \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804 \uac1c\ub150\uc744 \ub110\ub9ac \uc18c\uac1c\ud55c \uad6d\uc81c \uae30\uad6c(\uc704\uc6d0\ud68c)\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \ud658\uacbd \uac1c\ubc1c \uc704\uc6d0\ud68c (WCED)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uad6c\uc131\ud558\ub294 3\ub300 \uc601\uc5ed(\ucd95)\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd (\uc2e4\uc6a9\uc801\uc778 \ud658\uacbd), \uc0ac\ud68c (\uacac\ub51c\ub9cc\ud55c \uc0ac\ud68c), \uacbd\uc81c (\uacf5\uc815\ud55c \uacbd\uc81c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc704\ud574 \uad6d\uac00 \ucc28\uc6d0\uc5d0\uc11c \uc2e4\ucc9c\ud558\ub294 \ubc29\uc548\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804 \uae30\ubcf8 \uacc4\ud68d\uc744 \uc138\uc6cc \uc870\ud654\ub85c\uc6b4 \ubc1c\uc804\uc744 \ucd94\uad6c\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \uc704\ud574 \uac1c\uc778 \ucc28\uc6d0\uc5d0\uc11c \uc2e4\ucc9c\ud560 \uc218 \uc788\ub294 \ubc14\ub978 \uc18c\ube44 \ub178\ub825 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub9ac\uc801 \uc18c\ube44, \ub85c\uceec \ud478\ub4dc \uad6c\ub9e4, \uacf5\uc815 \ubb34\uc5ed \uc81c\ud488 \uc774\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1997\ub144\uc5d0 \uad6d\uc81c \uc0ac\ud68c\uac00 \ucc44\ud0dd\ud55c \uae30\ud6c4\ubcc0\ud654 \ud611\uc57d\uc758 \uad6c\uccb4\uc801 \uc774\ud589 \ubc29\uc548\uc744 \ub2f4\uc740 \uc758\uc815\uc11c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\ud1a0 \uc758\uc815\uc11c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4\ubcc0\ud654\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud574 \uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c \uaddc\uc81c\uac00 \uc57d\ud55c \uad6d\uac00\uc758 \uc81c\ud488\uc5d0 \uc138\uae08\uc744 \ubd80\uacfc\ud558\ub294 \ubb34\uc5ed \uad00\ub828 \uc81c\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c4\uc18c \uad6d\uacbd \uc870\uc815 \uc81c\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \ubcf4\uac74 \ubb38\uc81c\ub97c \ub2f4\ub2f9\ud558\ub294 \uc138\uacc4 \ubcf4\uac74 \uae30\uad6c(WHO)\uac00 \uc138\uacc4\uc758 \uc2dd\ub7c9 \ubb38\uc81c\ub97c \uc9c1\uc811 \ud574\uacb0\ud55c\ub2e4\ub294 \uc8fc\uc7a5\uc774 \uc633\uc9c0 \uc54a\uc740 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ub7c9 \ubb38\uc81c\ub294 \uc138\uacc4\uc2dd\ub7c9\uae30\uad6c(FAO) \ub4f1\uc758 \uc601\uc5ed\uc774\uba70, WHO\uc758 \uc8fc \uc784\ubb34\ub294 \uc138\uacc4 \ubcf4\uac74 \ubc0f \uc804\uc5fc\ubcd1 \ub300\uc751\uc774\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce5c\ud658\uacbd \uac00\ubc29(\uc5d0\ucf54\ubc31)\uc744 \uc9c1\uc811 \ub9cc\ub4e4\uc5b4 \uac1c\ubc1c\ub3c4\uc0c1\uad6d \uc544\ub3d9\uc5d0\uac8c \uc804\ub2ec\ud558\ub294 \ucea0\ud398\uc778\uc758 \uc758\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ub3c4\uad6d \uc544\ub3d9\uc758 \uc0dd\uc874\uc5d0 \uc911\uc694\ud55c \uc2e0\ud544\ud488, \uc758\uc57d\ud488, \ud559\uc6a9\ud488\uc744 \uc804\ud558\uc5ec \uad50\uc721\u00b7\uc704\uc0dd\u00b7\uc758\ub8cc \ud658\uacbd \uac1c\uc120\uc5d0 \ub3c4\uc6c0\uc744 \uc90c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8\ud3f0\uc744 2\uc2dc\uac04 \uc0ac\uc6a9\ud560 \ub54c \ubc1c\uc0dd\ud558\ub294 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc758 \ud06c\uae30\ub294 \uc5b4\ub290 \uc815\ub3c4\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\ucc28 1.4km\ub97c \uc8fc\ud589\ud560 \ub54c\uc640 \uac19\uc740 \uc591\uc758 \ud0c4\uc18c\uac00 \ubc30\ucd9c\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ud0c4\uc18c \ubc30\ucd9c\uc744 \uc904\uc5ec \ud0c4\uc18c \uc911\ub9bd\uc5d0 \uae30\uc5ec\ud558\uae30 \uc704\ud574 \uc77c\uc0c1\uc5d0\uc11c \uc2e4\ucc9c\ud560 \uc218 \uc788\ub294 \uad6c\uccb4\uc801 \ud589\ub3d9 \ubc29\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8\ud3f0 \uc804\uc6d0 \uaebc\ub450\uae30, \uc804\uc790\uc6b0\ud3b8 \uc904\uc774\uae30, \ud654\uba74 \uc5b4\ub450\uc6b4 \uc0c1\ud0dc\ub85c \ubc14\uafb8\uae30, \uc804\uc790 \uc601\uc218\uc99d \ubc1b\uae30"
          },
          {
            "type": "image",
            "reference": "6403f757-432a-4717-a0f9-8f3e400b7424",
            "alt": "\uc804\uc6d0 \ub044\uae30 \ubc84\ud2bc\uc774 \ud45c\uc2dc\ub41c \uc2a4\ub9c8\ud2b8\ud3f0 \uc0ac\uc9c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\ubb3c\uc131 \uc6d0\ub8cc \uc0ac\uc6a9 \uc5ec\ubd80\ub098 \uce5c\ud658\uacbd\uc131\uc744 \ud655\uc778\ud558\uae30 \uc704\ud574 \uc18c\ube44\uc790\uac00 \ud655\uc778\ud574 \ubcfc \uc218 \uc788\ub294 \uae30\uc5c5 \uacbd\uc601 \uc9c0\ud45c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "ESG \uacbd\uc601 (\ud658\uacbd\u00b7\uc0ac\ud68c\u00b7\ud22c\uba85 \uacbd\uc601)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc84\ub824\uc9c4 \ud398\ud2b8\ubcd1\uc744 \ud65c\uc6a9\ud558\uc5ec \ub9cc\ub4e0 \uc637\uc744 \uad6c\ub9e4\ud558\ub294 \ub4f1 \uc9c0\uc18d\uac00\ub2a5\ud55c \ubc1c\uc804\uc5d0 \uae30\uc5ec\ud558\ub294 \uc18c\ube44\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uce58 \uc18c\ube44"
          },
          {
            "type": "image",
            "reference": "d2e104de-b84a-40db-8f91-8517411c071d",
            "alt": "\ubc84\ub824\uc9c4 \ud398\ud2b8\ubcd1\uc744 \uc7ac\ud65c\uc6a9\ud558\uc5ec \ub9cc\ub4e0 \uc758\ub958 \uc804\uc2dc \ubaa8\uc2b5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \uad6d\uac00\uc5d0\uc11c \ubcf5\uc9c0 \ube44\uc6a9 \ubd80\ub2f4\uc774 \uc138\ub300 \uac04 \uc815\uc758\ub97c \ud574\uce60 \uc218 \uc788\ub294 \uad6c\uccb4\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub144\uce35\uc5d0 \ub300\ud55c \ubcf5\uc9c0 \ud655\ub300\uac00 \uccad\ub144\uce35\uc5d0\uac8c \uc2ec\uac01\ud55c \uacbd\uc81c\uc801 \ubd80\ub2f4\uc73c\ub85c \uc791\uc6a9\ud558\uc5ec \uc0ac\ud68c\uc801 \uc138\ub300 \uac08\ub4f1\uc744 \uc720\ubc1c\ud558\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\uc2dc\ubbfc\uc73c\ub85c\uc11c \uc790\uc2e0\uc758 \uc9c1\uc5c5 \ubc0f \uc0b6\uc758 \ubc29\ud5a5\uc744 \uc124\uc815\ud560 \ub54c \uace0\ub824\ud574\uc57c \ud560 \ud575\uc2ec \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc758 \ud765\ubbf8\uc640 \uc801\uc131\uc744 \uace0\ub824\ud568\uacfc \ub3d9\uc2dc\uc5d0, \uadf8 \uc9c1\uc5c5\uc774 \uc9c0\uad6c\ucd0c \ubbf8\ub798 \uc0ac\ud68c\uc5d0 \uc5b4\ub5bb\uac8c \uae30\uc5ec\ud560 \uac83\uc778\uc9c0\ub97c \ud568\uaed8 \uace0\ubbfc\ud558\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0 \ubcf4\uc720\uad6d\uc774 \uc790\uc6d0\uc758 \uc0dd\uc0b0\uacfc \uacf5\uae09\uc744 \uc815\uce58\uc801\u00b7\uacbd\uc81c\uc801 \ubb34\uae30\ud654\ud558\ub824\ub294 \uc131\ud5a5\uc744 \uc77c\uceeb\ub294 \ub2e8\uc5b4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0 \ubbfc\uc871\uc8fc\uc758"
