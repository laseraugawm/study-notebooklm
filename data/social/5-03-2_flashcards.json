    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc0ac \ub204\uc2a4\ubc14\uc6c0\uc758 \ub3d9\uc2ec\uc6d0 \ubaa8\ub378\uc5d0\uc11c '\uc790\uc544'\ub97c \ub458\ub7ec\uc2fc \uac00\uc7a5 \ucd5c\uc885\uc801\uc778 \uc678\uacfd\uc758 \uacf5\ub3d9\uccb4 \uc601\uc5ed\uc740 \ubb34\uc5c7\uc778\uac00?"
