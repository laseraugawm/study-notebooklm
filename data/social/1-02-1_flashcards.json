    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud589\uc815\ubd80(\uc815\ubd80)\uac00 \uc0ac\ubc95\ubd80(\ubc95\uc6d0)\uc758 \uc218\uc7a5 \ubc0f \ucd5c\uace0\ubc95\uad00\uc744 \uad6c\uc131\ud560 \ub54c \ud589\uc0ac\ud558\ub294 \uad8c\ud55c\uc740 \ubb34\uc5c7\uc778\uac00?"
