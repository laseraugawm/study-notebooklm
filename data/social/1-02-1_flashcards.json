    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95\uc5d0 \uad6d\ubbfc\uc758 \uae30\ubcf8\uc801 \uc778\uad8c \ubcf4\uc7a5\uc744 \uba85\uc2dc\ud558\ub294 \uad81\uadf9\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
