      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uad8c, \ud3c9\ub4f1\uad8c, \ucc38\uc815\uad8c, \uc0ac\ud68c\uad8c, \uccad\uad6c\uad8c"
