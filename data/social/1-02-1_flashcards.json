      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uad8c\ub825\uc774 \uad6d\ubbfc\uc758 \uc778\uac04\uc73c\ub85c\uc11c\uc758 \uc874\uc5c4\uacfc \uac00\uce58\ub97c \ud568\ubd80\ub85c \uce68\ud574\ud558\uc9c0 \ubabb\ud558\ub3c4\ub85d \uc778\uad8c \ubcf4\uc7a5\uc758 \ud1a0\ub300\uc774\uc790 \ubc95\uc801 \uc7a5\uce58\ub97c \ub9c8\ub828\ud558\uae30 \uc704\ud568\uc774\ub2e4."
          }
        ]
