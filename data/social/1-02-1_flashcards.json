        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\uc758 \ubaa8\ub4e0 \uad8c\ub825\uc774 \ud5cc\ubc95\uc5d0 \ub530\ub974\ub3c4\ub85d \ud558\uc5ec \uad8c\ub825\uc758 \uc790\uc758\uc801 \ud589\uc0ac\ub97c \ubc29\uc9c0\ud558\uace0 \uad6d\ubbfc\uc758 \uc778\uad8c\uc744 \uc2e4\uc9c8\uc801\uc73c\ub85c \ubcf4\uc7a5\ud558\ub824\ub294 \uc815\uce58 \uc6d0\ub9ac\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\ud5cc\uc8fc\uc758"
