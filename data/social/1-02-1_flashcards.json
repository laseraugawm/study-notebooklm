      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ubc95\uc6d0\uc7a5 \ubc0f \ub300\ubc95\uad00 \uc784\uba85 \ub3d9\uc758\uad8c"
