      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\uc7a5\uc8fc\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ubb38 \uae08\uc9c0\uc640 \uc601\uc7a5\uc8fc\uc758 \uaddc\uc815\uc740 5\ub300 \uae30\ubcf8\uad8c \uc911 \uc8fc\ub85c \uc5b4\ub5a4 \uad8c\ub9ac\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uc81c\ub3c4\uc801 \uc7a5\uce58\uc778\uac00?"
          }
