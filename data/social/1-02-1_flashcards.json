        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc774\ub77c\uba74 \ub204\uad6c\ub098 \ub2f9\uc5f0\ud788 \ub204\ub824\uc57c \ud560 \ubcf4\ud3b8\uc801 \uad8c\ub9ac\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
