    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uad8c\ub825\uc758 \ub0a8\uc6a9\uc744 \ub9c9\uace0 \uad6d\ubbfc\uc758 \uc778\uad8c\uc744 \uce68\ud574\ubc1b\uc9c0 \uc54a\ub3c4\ub85d \uc785\ubc95\uad8c, \ud589\uc815\uad8c, \uc0ac\ubc95\uad8c\uc744 \uc11c\ub85c \ub2e4\ub978 \uae30\uad00\uc5d0 \ubd84\ub2f4\uc2dc\ud0a4\ub294 \uc81c\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
