        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\ubc95\uad8c: \uad6d\ud68c / \ud589\uc815\uad8c: \uc815\ubd80 / \uc0ac\ubc95\uad8c: \ubc95\uc6d0"
