    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95 \uc81c12\uc870 \uc81c1\ud56d\uc5d0 \uaddc\uc815\ub41c '\ubc95\ub960\uc5d0 \uc758\ud558\uc9c0 \uc544\ub2c8\ud558\uace0\ub294 \uccb4\ud3ec\u00b7\uad6c\uc18d\u00b7\uc555\uc218\u00b7\uc218\uc0c9 \ub610\ub294 \uc2ec\ubb38\uc744 \ubc1b\uc9c0 \uc544\ub2c8\ud55c\ub2e4'\ub294 \ub0b4\uc6a9\uc740 \uc5b4\ub5a4 \uae30\ubcf8\uad8c\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
