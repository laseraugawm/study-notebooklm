        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc778\uad8c'\uacfc '\uae30\ubcf8\uad8c'\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c\uc740 \uc778\uac04\uc73c\ub85c\uc11c\ub204\ub9ac\ub294 \ubcf4\ud3b8\uc801 \uad8c\ub9ac\uc778 \ubc18\uba74, \uae30\ubcf8\uad8c\uc740 \uad6d\uac00\uc758 \ucd5c\uace0\ubc95\uc778 \ud5cc\ubc95\uc5d0 \uba85\uc2dc\ub418\uc5b4 \ubc95\uc801\uc73c\ub85c \ubcf4\uc7a5\ub418\ub294 \uc778\uad8c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\uc758 \ud1b5\uce58 \uc870\uc9c1\uacfc \uc6b4\uc601 \uc6d0\ub9ac \ubc0f \uad6d\ubbfc\uc758 \uae30\ubcf8\uc801 \uc778\uad8c\uc744 \uaddc\uc815\ud55c \uad6d\uac00\uc758 \ucd5c\uace0 \uaddc\ubc94\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud55c\ubbfc\uad6d \ud5cc\ubc95 \uc81c10\uc870\uc5d0\uc11c \uba85\uc2dc\ud558\uace0 \uc788\ub294 \uc778\uac04\uc758 \ud575\uc2ec\uc801 \uad8c\ub9ac\uc640 \uad6d\uac00\uc758 \uc758\ubb34\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\ub4e0 \uad6d\ubbfc\uc758 \uc778\uac04\uc73c\ub85c\uc11c\uc758 \uc874\uc5c4\uacfc \uac00\uce58 \ubc0f \ud589\ubcf5 \ucd94\uad6c\uad8c\uc744 \uaddc\uc815\ud558\uace0, \uad6d\uac00\ub294 \uac1c\uc778\uc774 \uac00\uc9c0\ub294 \ubd88\uac00\uce68\uc758 \uae30\ubcf8\uc801 \uc778\uad8c\uc744 \ud655\uc778\ud558\uace0 \ubcf4\uc7a5\ud560 \uc758\ubb34\ub97c \uc9c4\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95\uc758 \ud575\uc2ec\uc801 \uac00\uce58\uc774\uc790 \uae30\ubcf8 \uc6d0\ub9ac\ub85c\uc11c, \ubaa8\ub4e0 \uad6d\uac00 \uc791\uc6a9\uacfc \ubc95\uc9c8\uc11c\uac00 \ub530\ub77c\uc57c \ud558\ub294 \ucd5c\uace0\uc758 \uac00\uce58\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc758 \uc874\uc5c4\uacfc \uac00\uce58"
