    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud589\uc815\ubd80(\uc815\ubd80)\uac00 \uc785\ubc95\ubd80(\uad6d\ud68c)\uc758 \ub3c5\uc8fc\ub97c \uacac\uc81c\ud558\uae30 \uc704\ud574 \ud589\uc0ac\ud560 \uc218 \uc788\ub294 \ud5cc\ubc95\uc0c1 \uad8c\ud55c\uc740 \ubb34\uc5c7\uc778\uac00?"
