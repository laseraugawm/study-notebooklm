          {
            "type": "text",
            "content": "\uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c\uc744 \ubc95\ub960\ub85c \uc81c\ud55c\ud558\ub354\ub77c\ub3c4 \uce68\ud574\ud560 \uc218 \uc5c6\ub294 \ud55c\uacc4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc640 \uad8c\ub9ac\uc758 \ubcf8\uc9c8\uc801\uc778 \ub0b4\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95 \uc81c37\uc870 \uc81c2\ud56d\uc5d0\uc11c \uae30\ubcf8\uad8c \uc81c\ud55c\uc758 \ubaa9\uc801, \uc218\ub2e8, \ud55c\uacc4\ub97c \uba85\ud655\ud788 \uaddc\uc815\ud574 \ub454 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uad8c\ub825\uc774 \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c\uc744 \ud568\ubd80\ub85c \uce68\ud574\ud558\uac70\ub098 \ub0a8\uc6a9\ud558\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud568\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud615\uc0ac \uc808\ucc28\uc5d0\uc11c \uccb4\ud3ec\u00b7\uad6c\uc18d\u00b7\uc555\uc218\u00b7\uc218\uc0c9 \uc2dc \uac80\uc0ac\uc758 \uccad\uad6c\uc5d0 \uc758\ud574 \ubc95\uad00\uc774 \ubc1c\ubd80\ud55c \uc601\uc7a5\uc744 \uc81c\uc2dc\ud574\uc57c \ud55c\ub2e4\ub294 \uc6d0\uce59\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
