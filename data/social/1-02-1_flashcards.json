    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ub9bd \uad50\uc721 \ub300\ud559\uad50\uc758 \uc218\uc2dc \ubaa8\uc9d1 \uc694\uac15\uc5d0\uc11c \uac80\uc815\uace0\uc2dc \ucd9c\uc2e0\uc790\uc758 \uc9c0\uc6d0 \uc790\uaca9\uc744 \uc77c\ub960\uc801\uc73c\ub85c \uc81c\ud55c\ud55c \uac83\uc5d0 \ub300\ud574 \ud5cc\ubc95\uc7ac\ud310\uc18c\ub294 \uc5b4\ub5a0\ud55c \uacb0\uc815\uc744 \ub0b4\ub838\ub294\uac00?"
