    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac80\uc815\uace0\uc2dc \ucd9c\uc2e0\uc790\uc758 \ub300\uc785 \uc9c0\uc6d0 \uc790\uaca9 \uc81c\ud55c \uc704\ud5cc \uacb0\uc815 \uc0ac\uac74\uc744 \ud1b5\ud574 \uc54c \uc218 \uc788\ub294 \ud5cc\ubc95\uc7ac\ud310\uc18c\uc758 \ud575\uc2ec \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uad8c\ub825\uc774\ub098 \ubd88\ud569\ub9ac\ud55c \uaddc\uc815\uc73c\ub85c \uc778\ud574 \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c\uc774 \uce68\ud574\ub418\uc5c8\uc744 \ub54c, \ud5cc\ubc95\uc744 \uae30\uc900\uc73c\ub85c \uc774\ub97c \uc2ec\ud310\ud558\uc5ec \uce68\ud574\ub41c \uae30\ubcf8\uad8c\uc744 \uad6c\uc81c\ud558\ub294 \uc5ed\ud560\uc774\ub2e4."
