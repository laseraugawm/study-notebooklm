    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uad8c\ub825\uc758 \uac04\uc12d\uc774\ub098 \uce68\ud574\ub97c \ubc1b\uc9c0 \uc54a\uace0 \uc790\uc720\ub86d\uac8c \uc0dd\ud65c\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
