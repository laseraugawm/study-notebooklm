    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac \ud5cc\ubc95\uc5d0\uc11c \ubcf4\uc7a5\ud558\ub294 5\ub300 \uae30\ubcf8\uad8c\uc758 \uc885\ub958\uc5d0\ub294 \ubb34\uc5c7\uc774 \uc788\ub294\uac00?"
