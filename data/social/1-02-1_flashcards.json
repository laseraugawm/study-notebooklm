        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc18d\u00b7\uacf5\uac1c \uc7ac\ud310\uc744 \ubc1b\uc744 \uad8c\ub9ac, \ud615\uc0ac \ubcf4\uc0c1 \uc81c\ub3c4, \uad6d\uac00 \ubc30\uc0c1 \uc81c\ub3c4\ub294 \uc5b4\ub5a4 \uae30\ubcf8\uad8c\uc744 \uc2e4\uc9c8\uc801\uc73c\ub85c \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uc7a5\uce58\uc778\uac00?"
