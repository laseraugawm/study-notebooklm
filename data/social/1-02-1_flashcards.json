    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud55c\ubbfc\uad6d \ud5cc\ubc95\uc5d0\uc11c \uc785\ubc95\uad8c, \ud589\uc815\uad8c, \uc0ac\ubc95\uad8c\uc744 \ub2f4\ub2f9\ud558\ub294 \uad6d\uac00 \uae30\uad00\uc740 \uac01\uac01 \uc5b4\ub514\uc778\uac00?"
