        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uad8c\uc5d0 \ud574\ub2f9\ud558\ub294 \ub300\ud45c\uc801\uc778 \uad8c\ub9ac \uc138 \uac00\uc9c0 \uc774\uc0c1\uc744 \uc81c\uc2dc\ud558\uc2dc\uc624."
