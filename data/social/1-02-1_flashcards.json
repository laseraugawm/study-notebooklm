    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac80\uc815\uace0\uc2dc \ucd9c\uc2e0\uc790\uc758 \ub300\uc785 \uc218\uc2dc \ubaa8\uc9d1 \uc9c0\uc6d0 \uc81c\ud55c \uc0ac\uac74\uc5d0\uc11c \uccad\uad6c\uc778\ub4e4\uc774 \uae30\ubcf8\uad8c \uad6c\uc81c\ub97c \ubc1b\uae30 \uc704\ud574 \uc81c\uae30\ud55c \uc2ec\ud310\uc740 \ubb34\uc5c7\uc778\uac00?"
