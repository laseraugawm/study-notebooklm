    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95\uc5d0\uc11c \uc131\ubcc4, \uc885\uad50, \uc0ac\ud68c\uc801 \uc2e0\ubd84\uc5d0 \ub530\ub978 \ucc28\ubcc4\uc744 \uae08\uc9c0\ud558\ub3c4\ub85d \uaddc\uc815\ud55c \uac83\uc740 \uc5b4\ub5a4 \uae30\ubcf8\uad8c\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud568\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3c9\ub4f1\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ubcf4\uc7a5 \ubc0f \ubcf5\uc9c0 \uc99d\uc9c4, \uadfc\ub85c\uc790\uc758 \uace0\uc6a9\uacfc \uc801\uc815 \uc784\uae08 \ubcf4\uc7a5 \uc81c\ub3c4\ub294 \uc5b4\ub5a4 \uae30\ubcf8\uad8c\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \ud5cc\ubc95\uc801 \uc7a5\uce58\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uad8c"
