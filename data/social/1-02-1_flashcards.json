      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac80\uc815\uace0\uc2dc \ucd9c\uc2e0\uc790\uc758 \ub300\ud559 \uc785\ud559 \uae30\ud68c\ub97c \uc2e4\uc9c8\uc801\uc73c\ub85c \ubc15\ud0c8\ud558\uc5ec \uade0\ub4f1\ud558\uac8c \uad50\uc721\ubc1b\uc744 \uad8c\ub9ac\ub97c \uce68\ud574\ud558\ubbc0\ub85c \ud574\ub2f9 \uc694\uac15 \ub0b4\uc6a9\uc774 \ud5cc\ubc95\uc5d0 \uc704\ubc18\ub41c\ub2e4\uace0 \uacb0\uc815\ud558\uc600\ub2e4."
