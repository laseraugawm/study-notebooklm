    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubc95\ubd80(\ubc95\uc6d0)\uac00 \uad6d\ud68c(\uc785\ubc95\ubd80)\uac00 \ub9cc\ub4e0 \ubc95\ub960\uc758 \uc704\ud5cc\uc131\uc774 \uc758\uc2ec\ub420 \ub54c \ud5cc\ubc95\uc7ac\ud310\uc18c\uc5d0 \uc694\uad6c\ud558\ub294 \uacac\uc81c \uc218\ub2e8\uc740 \ubb34\uc5c7\uc778\uac00?"
