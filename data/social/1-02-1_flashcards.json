    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc95\uc6d0\uc5d0\uc11c \uc7ac\ud310 \uc911\uc778 \uc0ac\uac74\uc5d0 \uc801\uc6a9\ub420 \ubc95\ub960\uc774 \ud5cc\ubc95\uc5d0 \uc704\ubc18\ub418\ub294\uc9c0 \uc5ec\ubd80\ub97c \ud5cc\ubc95\uc7ac\ud310\uc18c\uac00 \uc2ec\ud310\ud558\ub294 \uc81c\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
