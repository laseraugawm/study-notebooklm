      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc95\uc6d0\uc758 \uc7ac\ud310, \uccad\uc6d0, \ud589\uc815 \uc2ec\ud310 (\ub610\ub294 \ud5cc\ubc95\uc7ac\ud310\uc18c \uc2ec\ud310)"
