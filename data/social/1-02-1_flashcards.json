    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95\uc5d0 \uaddc\uc815\ub418\uc5b4 \uad6d\uac00\uac00 \ubcf4\uc7a5\ud558\ub294 \uae30\ubcf8\uc801\uc778 \uc778\uad8c\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
