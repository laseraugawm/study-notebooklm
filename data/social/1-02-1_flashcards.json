    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ubcf8\uad8c\uc744 \uce68\ud574\ubc1b\uc740 \uad6d\ubbfc\uc774 \uc774\uc6a9\ud560 \uc218 \uc788\ub294 \uc77c\ubc18\uc801\uc778 \ubc95\ub960\uc801 \uad6c\uc81c \uc218\ub2e8 \uc138 \uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
