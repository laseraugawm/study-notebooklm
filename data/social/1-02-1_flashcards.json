    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\ubc95\ubd80(\uad6d\ud68c)\uac00 \ud589\uc815\ubd80(\uc815\ubd80)\uc758 \uad6d\uc815 \uc218\ud589\uc744 \uac10\uc2dc\ud558\uace0 \uacac\uc81c\ud558\uae30 \uc704\ud574 \uac16\ub294 \uad8c\ud55c\uc740 \ubb34\uc5c7\uc778\uac00?"
