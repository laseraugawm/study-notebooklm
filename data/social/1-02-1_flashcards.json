    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubc95\ubd80(\ubc95\uc6d0)\uac00 \ud589\uc815\ubd80(\uc815\ubd80)\uc758 \ud589\uc815 \uc785\ubc95 \ubc0f \ucc98\ubd84\uc758 \uc704\ubc95\uc131\uc744 \uc2ec\uc0ac\ud558\uc5ec \ud589\uc815\ubd80\ub97c \uacac\uc81c\ud558\ub294 \uad8c\ud55c\uc740 \ubb34\uc5c7\uc778\uac00?"
