        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uccb4\uc758 \uc790\uc720, \uac70\uc8fc\u00b7\uc774\uc804\uc758 \uc790\uc720, \uc591\uc2ec\uc758 \uc790\uc720, \uc885\uad50\uc758 \uc790\uc720, \uc5b8\ub860\u00b7\ucd9c\ud310\u00b7\uc9d1\ud68c\u00b7\uacb0\uc0ac\uc758 \uc790\uc720"
