    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18 \ubc95\uc6d0\uacfc \ubcc4\ub3c4\ub85c \uc124\uce58\ub418\uc5b4 \ud5cc\ubc95\uc744 \ucd5c\uace0 \uae30\uc900\uc73c\ub85c \uc0bc\uc544 \uae30\ubcf8\uad8c \uce68\ud574 \ubc0f \ubc95\ub960\uc758 \uc704\ud5cc\uc131\uc744 \uc2ec\ud310\ud558\ub294 \uc804\ub2f4 \uae30\uad00\uc740 \ubb34\uc5c7\uc778\uac00?"
