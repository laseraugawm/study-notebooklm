    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uae30\uad00\uc758 \uacf5\uad8c\ub825 \ud589\uc0ac \ub610\ub294 \ubd88\ud589\uc0ac\ub098 \ubc95\ub960\ub85c \uc778\ud574 \uae30\ubcf8\uad8c\uc744 \uc9c1\uc811 \uce68\ud574\ub2f9\ud55c \uad6d\ubbfc\uc774 \ud5cc\ubc95\uc7ac\ud310\uc18c\uc5d0 \uc9c1\uc811 \uad6c\uc81c\ub97c \uccad\uad6c\ud558\ub294 \uc2ec\ud310\uc740 \ubb34\uc5c7\uc778\uac00?"
