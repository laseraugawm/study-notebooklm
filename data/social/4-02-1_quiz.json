        {
          "text": "\uc11c\uc544\ud504\ub9ac\uce74 \uc9c0\uc5ed \uce74\uce74\uc624 \ub18d\uc7a5\uc5d0\uc11c\ub294 \uc57d 200\ub9cc \uba85\uc758 \uc544\ub3d9\ub4e4\uc774 \uac00\ud639\ud55c \ud658\uacbd\uc5d0\uc11c \ub178\ub3d9\uc744 \ucc29\ucde8\ub2f9\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc11c\uc544\ud504\ub9ac\uce74 \uce74\uce74\uc624 \ub18d\uc7a5\uc5d0\uc11c\ub294 \uc57d 200\ub9cc \uba85\uc758 \uc544\ub3d9\uc774 \uc548\uc804 \uc7a5\ube44 \uc5c6\uc774 \uc0b4\ucda9\uc81c \uc0b4\ud3ec \ub4f1 \uace0\ub41c \ub178\ub3d9\uc5d0 \uc2dc\ub2ec\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4."
