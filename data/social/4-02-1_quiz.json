    {
      "type": "multiple_choice",
      "question": "\ub178\ub974\uc6e8\uc774\uc758 \ud3c9\ud654\ud559\uc790 \uc694\ud55c \uac08\ud241(Galtung, J.)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
