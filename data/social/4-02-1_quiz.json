    {
      "type": "multiple_choice",
      "question": "\uc11c\uc544\ud504\ub9ac\uce74 \uce74\uce74\uc624 \ub18d\uc7a5\uc758 \uc544\ub3d9 \ub178\ub3d9 \uc2e4\ud0dc\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uc81c \ub178\ub3d9 \uae30\uad6c(ILO)\ub294 15\uc138 \ubbf8\ub9cc \ubbf8\uc131\ub144\uc790\uc758 \ub178\ub3d9\uc744 \uc804\uba74 \ud5c8\uc6a9\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uad6d\uc81c \ub178\ub3d9 \uae30\uad6c(ILO)\ub294 15\uc138 \ubbf8\ub9cc \ubbf8\uc131\ub144\uc790\uc758 \ub178\ub3d9\uc744 \uc6d0\uce59\uc801\uc73c\ub85c \uae08\uc9c0\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
