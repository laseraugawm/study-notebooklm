        {
          "text": "\ubb3c\ub9ac\uc801 \ud3ed\ub825",
          "isCorrect": false,
          "rationale": "\ubb3c\ub9ac\uc801 \ud3ed\ub825\uc740 \uc2e0\uccb4\uc801 \uac00\ud574\ub098 \uc804\uc7c1, \ud14c\ub7ec\ucc98\ub7fc \uc9c1\uc811\uc801\uc73c\ub85c \ud589\ud574\uc9c0\ub294 \ud3ed\ub825\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubb38\ud654\uc801 \ud3ed\ub825",
          "isCorrect": false,
          "rationale": "\ubb38\ud654\uc801 \ud3ed\ub825\uc740 \uc885\uad50, \uc608\uc220, \uc5b8\uc5b4 \ub4f1\uc744 \ud1b5\ud574 \uc9c1\uc811\uc801\u00b7\uad6c\uc870\uc801 \ud3ed\ub825\uc744 \uc815\ub2f9\ud654\ud558\ub294 \ud3ed\ub825\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
