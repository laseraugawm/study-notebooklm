        {
          "text": "\uc544\ub3d9 \ub178\ub3d9\uc790\ub4e4\uc740 \uc548\uc804 \uc7a5\ube44 \uc5c6\uc774 \ud654\ud559 \ubb3c\uc9c8 \uc0b4\ud3ec\ub098 \ubb34\uac70\uc6b4 \uc9d0 \uc6b4\ubc18 \ub4f1\uc758 \uc704\ud5d8\uc5d0 \ub178\ucd9c\ub418\uc5b4 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uce74\uce74\uc624 \ub18d\uc7a5\uc758 \uc544\ub3d9\ub4e4\uc740 \uc0b4\ucda9\uc81c \uc0b4\ud3ec \ubc0f \ubb34\uac70\uc6b4 \uc9d0 \uc6b4\ubc18 \ub4f1 \uac00\ud639\ud55c \ud658\uacbd\uc5d0\uc11c \uc77c\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc804\uc7c1\uc774 \uc5c6\ub354\ub77c\ub3c4 \uc774\ub7ec\ud55c \uc544\ub3d9 \ub178\ub3d9 \ucc29\ucde8\uac00 \uc874\uc7ac\ud558\ub294 \uc0c1\ud0dc\ub294 \uc9c4\uc815\ud55c \ud3c9\ud654\uac00 \uc2e4\ud604\ub41c \uac83\uc73c\ub85c \ubcf4\uae30 \uc5b4\ub835\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb3c\ub9ac\uc801 \ud3ed\ub825\uc774 \uc5c6\ub354\ub77c\ub3c4 \uad6c\uc870\uc801\u00b7\ubb38\ud654\uc801 \ud3ed\ub825\uc774 \uc874\uc7ac\ud558\ub294 \ud55c \uc9c4\uc815\ud55c \ud3c9\ud654\uac00 \uc2e4\ud604\ub418\uc5c8\ub2e4\uace0 \ubcfc \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
