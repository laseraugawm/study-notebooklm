    {
      "type": "multiple_choice",
      "question": "\uad6d\uc81c \uc0ac\ud68c\uc5d0\uc11c \ud3c9\ud654\ub97c \uc2e4\ud604\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \ub450 \uac00\uc9c0 \uc8fc\uc694 \uc774\uc720\ub85c \uc62c\ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc778\ub958\uc758 \uc548\uc804\uacfc \uc0dd\uc874\uc758 \ubc14\ud0d5 \ub9c8\ub828 / \uad6d\uc81c \uc815\uc758 \uc2e4\ud604\uacfc \uc778\ub958\uc758 \ubc88\uc601",
          "isCorrect": true,
          "rationale": "\ud3c9\ud654\ub294 \uc0dd\uc874 \uc704\ud611\uc5d0\uc11c \ubc97\uc5b4\ub098 \uc548\uc804\uc744 \ud655\ubcf4\ud558\ub294 \ubc14\ud0d5\uc774 \ub418\uba70, \uae30\ubcf8\uc801 \uad8c\ub9ac \ubcf4\uc7a5\uc744 \ud1b5\ud574 \uad6d\uc81c \uc815\uc758\uc640 \uc778\ub958\uc758 \ubc88\uc601\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4 \uacbd\uc81c\uc758 \ub2e8\uc77c\ud654 \ub2ec\uc131 / \ud2b9\uc815 \uac15\ub300\uad6d\uc758 \uc8fc\ub3c4\uad8c \uac15\ud654",
          "isCorrect": false,
          "rationale": "\uacbd\uc81c \ub2e8\uc77c\ud654\ub098 \ud2b9\uc815 \uac15\ub300\uad6d \uc8fc\ub3c4\uad8c \uac15\ud654\ub294 \ud3c9\ud654 \uc2e4\ud604\uc758 \ubcf8\uc9c8\uc801\uc778 \ubaa9\uc801\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00 \uac04 \uad70\uc0ac\ube44 \uacbd\uc7c1 \ucd09\uc9c4 / \ubd88\uacf5\uc815\ud55c \uc0ac\ud68c \uad6c\uc870\uc758 \uc720\uc9c0",
          "isCorrect": false,
          "rationale": "\uad70\uc0ac\ube44 \uacbd\uc7c1\uacfc \ubd88\uacf5\uc815 \uad6c\uc870 \uc720\uc9c0\ub294 \ud3c9\ud654\ub97c \uc704\ud611\ud558\ub294 \uc694\uc18c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \uad6d\uac00\uc758 \ubb34\ub825 \uc0ac\uc6a9 \uad8c\uc7a5 / \uc790\uad6d \uc911\uc2ec\uc8fc\uc758 \uc815\uce58\uc758 \uc815\ub2f9\ud654",
          "isCorrect": false,
          "rationale": "\ubb34\ub825 \uc0ac\uc6a9\uc774\ub098 \uc790\uad6d \uc911\uc2ec\uc8fc\uc758 \uc815\ub2f9\ud654\ub294 \ud3c9\ud654\uc758 \uac00\uce58\uc640 \ub300\ub9bd\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc804\uc7c1\uacfc \ud3ed\ub825 \uacf5\ud3ec\uc5d0\uc11c\uc758 \ubc97\uc5b4\ub0a8(\uc0dd\uc874)\uacfc \uc0b6\uc758 \uc9c8 \ubc0f \uad8c\ub9ac \ubcf4\uc7a5(\ubc88\uc601)\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ubd80\uc0b0\uc5d0 \uc704\uce58\ud55c '\uc7ac\ud55c \uc720\uc5d4 \uae30\ub150 \uacf5\uc6d0'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "6\u00b725 \uc804\uc7c1 \ub2f9\uc2dc \uc138\uacc4 \ud3c9\ud654\uc640 \uc790\uc720\ub97c \uc704\ud574 \uc801\uacfc \uc2f8\uc6b0\ub2e4 \uc804\uc0ac\ud55c \uc7a5\ubcd1\ub4e4\uc774 \uc7a0\ub4e4\uc5b4 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc7ac\ud55c \uc720\uc5d4 \uae30\ub150 \uacf5\uc6d0\uc740 6\u00b725 \uc804\uc7c1 \ub2f9\uc2dc \ud3c9\ud654\uc640 \uc790\uc720\ub97c \uc704\ud574 \uc2f8\uc6b0\ub2e4 \ubaa9\uc228\uc744 \uc783\uc740 \uc720\uc5d4\uad70 \uc7a5\ubcd1\ub4e4\uc758 \ubb18\uc5ed\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 \ub2f9\uc2dc \uc720\ub300\uc778\ub4e4\uc774 \uac15\uc81c\ub85c \uac07\ud600 \uace0\ud1b5\ubc1b\uc558\ub358 \ub300\ud45c\uc801 \uc218\uc6a9\uc18c \uc720\uc801\uc9c0\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc720\ub300\uc778\uc774 \uac15\uc81c \uc218\uc6a9\ub418\uc5c8\ub358 \uc7a5\uc18c\ub294 \uc544\uc6b0\uc288\ube44\uce20 \uc218\uc6a9\uc18c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc11c\uc544\ud504\ub9ac\uce74 \uce74\uce74\uc624 \ub18d\uc7a5\uc758 \uc544\ub3d9 \ub178\ub3d9 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc124\ub9bd\ub41c \uad6d\uc81c \ub178\ub3d9 \uae30\uad6c(ILO) \uc2dc\uc124\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc7ac\ud55c \uc720\uc5d4 \uae30\ub150 \uacf5\uc6d0\uc740 \uc544\ub3d9 \ub178\ub3d9 \ubb38\uc81c \ud574\uacb0 \uc2dc\uc124\uc774 \uc544\ub2cc \uc804\uc0ac\uc790 \ucd94\ubaa8 \uc2dc\uc124\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc2a4\ud1a1\ud640\ub984 \uad6d\uc81c \ud3c9\ud654 \uc5f0\uad6c\uc18c\ub97c \uc124\ub9bd\ud55c \uac08\ud241\uc758 \uc5c5\uc801\uc744 \uae30\ub150\ud558\uae30 \uc704\ud574 \uac74\ub9bd\ub41c \uc5f0\uad6c\uc18c\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc7ac\ud55c \uc720\uc5d4 \uae30\ub150 \uacf5\uc6d0\uc740 \ucc38\uc804 \uc804\uc0ac\uc790\ub97c \ucd94\ubaa8\ud558\uae30 \uc704\ud55c \uacf5\uc6d0\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud55c\uad6d\uc804\uc7c1(6\u00b725 \uc804\uc7c1)\uacfc \ubd80\uc0b0\uc774\ub77c\ub294 \uc7a5\uc18c\uc801 \ubc30\uacbd\uc744 \uc5f0\uacb0\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc6b0\ud06c\ub77c\uc774\ub098 \uc804\uc7c1 \ub09c\ubbfc\uc758 \uc218\uae30 \ub0b4\uc6a9\uc744 \ubc14\ud0d5\uc73c\ub85c \uc54c \uc218 \uc788\ub294 '\ud3c9\ud654\uc758 \uc18c\uc911\ud568'\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n\"5\uc6d4 10\uc77c \ub7f0\ub358\uc5d0 \uc640\uc11c \uc54c\uc558\ub2e4. \uc544\ubb34 \uac71\uc815 \uc5c6\uc774 \uac00\uc871\uacfc \ud568\uaed8 \uc9c0\ub0bc \uc218 \uc788\ub2e4\ub294 \uac83\uc774 \uc5bc\ub9c8\ub098 \uc18c\uc911\ud55c \uc77c\uc778\uc9c0\ub97c. \u2026\u2026 \uc800\ub141 \uc2dc\uac04\uc774 \ub418\uba74 \uc628 \uac00\uc871\uc774 \ud568\uaed8 \uc2dd\uc0ac\ud55c\ub2e4. \uc18c\uc18c\ud55c \uadf8\ub4e4\uc758 \uc77c\uc0c1\uc774 \ub108\ubb34 \ud589\ubcf5\ud574 \ubcf4\uc5ec\uc11c \ubcfc \ub54c\ub9c8\ub2e4 \ub208\ubb3c\uc774 \ub0ac\ub2e4. \uc774\uc81c \ub098\uc5d0\uac8c \uac00\uc7a5 \uc911\uc694\ud55c \uac83\uc740 \uac00\uc871\uc758 \uc548\uc704\ub2e4.\"",
      "answerOptions": [
        {
          "text": "\ud3c9\ud654\ub294 \uac1c\uc778\uacfc \uac00\uc871\uc758 \ud3c9\ubc94\ud55c \uc77c\uc0c1\uacfc \uc0dd\uc874\uc758 \uc548\uc804\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud55c \ud544\uc218\uc801 \ubc14\ud0d5\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc218\uae30\uc5d0\uc11c \uac15\uc870\ub418\ub4ef \ud3c9\ud654\ub294 \uc544\ubb34 \uac71\uc815 \uc5c6\uc774 \uac00\uc871\uacfc \ud568\uaed8 \uc2dd\uc0ac\ud558\uace0 \uc77c\uc0c1\uc744 \ub204\ub9b4 \uc218 \uc788\uac8c \ud574 \uc8fc\ub294 \ud575\uc2ec \uc870\uac74\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc804\uc7c1 \uc18d\uc5d0\uc11c\ub3c4 \uac1c\uc778\uc758 \uacbd\uc81c\uc801 \uc18c\ub4dd\ub9cc \uc720\uc9c0\ub418\uba74 \ud3c9\ud654\ub85c\uc6b4 \uc0b6\uc744 \ub204\ub9b4 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804\uc7c1 \uc0c1\ud669\uc5d0\uc11c\ub294 \uc2e0\uccb4\uc801 \uc548\uc804\uacfc \uc77c\uc0c1\uc758 \uc548\uc815\uc774 \ubb34\ub108\uc9c0\ubbc0\ub85c \uacbd\uc81c\uc801 \uc18c\ub4dd\ub9cc\uc73c\ub85c \ud3c9\ud654\uac00 \uc720\uc9c0\ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c1\uc811\uc801\uc778 \uc2e0\uccb4\uc801 \uc704\ud574\ub9cc \uc5c6\uc73c\uba74 \uc0ac\uc774\ub80c\uc774\ub098 \uacbd\ubcf4 \uc18d\uc5d0\uc11c\ub3c4 \uc77c\uc0c1\uc758 \ud589\ubcf5\uc774 \uc9c0\uc18d\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uae30\uc5d0\uc11c \uc5b8\uae09\ud588\ub4ef \uc0ac\uc774\ub80c \uc18c\ub9ac \uc790\uccb4\ub3c4 \ud070 \uacf5\ud3ec\uc640 \ucd08\uc870\ud568\uc744 \uac00\uc838\uc640 \uc77c\uc0c1\uc744 \ud30c\uad34\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc678\uad6d\uc73c\ub85c \uc774\uc8fc\ud558\uc5ec \uc0dd\ud65c\ud558\ub294 \uac83\uc774 \uc804\uc7c1 \uad6d\uac00\uc758 \uad6d\ubbfc\uc73c\ub85c\uc11c \uc8c4\ucc45\uac10\uc744 \uc5c6\uc560\ub294 \uae38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uae30 \uc791\uc131\uc790\ub294 \uace0\uad6d\uc744 \ub5a0\ub098\ub294 \uacfc\uc815\uc5d0\uc11c \ub9c8\uc74c\uc774 \ubd88\ud3b8\ud558\uace0 \uc8c4\ucc45\uac10\uc744 \ub290\uaf08\ub2e4\uace0 \ubc1d\ud788\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac00\uc871\uacfc\uc758 \ud3c9\ubc94\ud55c \uc800\ub141 \uc2dd\uc0ac\uc640 \uac19\uc740 \uc77c\uc0c1\uc774 \uc804\uc7c1\uc73c\ub85c \uc778\ud574 \uc5b4\ub5bb\uac8c \ud30c\uad34\ub418\uc5c8\ub294\uc9c0\uc5d0 \uc8fc\ubaa9\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 \ub2f9\uc2dc \uc778\ub958\uac00 \ubaa9\uaca9\ud55c \ub300\ud45c\uc801\uc778 \ud3ed\ub825 \uc0ac\uac74 \ubc0f \uc7a5\uc18c\ub85c, \uc720\ub300\uc778 \ub4f1\uc744 \uac15\uc81c\ub85c \uac00\ub450\uace0 \ube44\uc778\uac04\uc801 \ud3ed\ub825\uc744 \ud589\uc0ac\ud588\ub358 \uacf3\uc740?",
      "answerOptions": [
        {
          "text": "\ud640\ub85c\ucf54\uc2a4\ud2b8 - \uc544\uc6b0\uc288\ube44\uce20 \uc218\uc6a9\uc18c",
          "isCorrect": true,
          "rationale": "\uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 \ub2f9\uc2dc \uc720\ub300\uc778 \ub300\ub7c9 \ud559\uc0b4\uc744 \ud640\ub85c\ucf54\uc2a4\ud2b8\ub77c \ud558\uba70, \uac15\uc81c \uc218\uc6a9\uc18c\uc758 \ub300\ud45c\uc801 \uc7a5\uc18c\uac00 \uc544\uc6b0\uc288\ube44\uce20 \uc218\uc6a9\uc18c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub09c\uc9d5 \ub300\ud559\uc0b4 - \uc7ac\ud55c \uc720\uc5d4 \uae30\ub150 \uacf5\uc6d0",
          "isCorrect": false,
          "rationale": "\uc7ac\ud55c \uc720\uc5d4 \uae30\ub150 \uacf5\uc6d0\uc740 6\u00b725 \uc804\uc7c1 \uc720\uc5d4\uad70 \uc804\uc0ac\uc790 \ucd94\ubaa8 \uc2dc\uc124\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc544\ub3d9 \ub178\ub3d9 \ucc29\ucde8 - \uc11c\uc544\ud504\ub9ac\uce74 \uce74\uce74\uc624 \ub18d\uc7a5",
          "isCorrect": false,
          "rationale": "\uce74\uce74\uc624 \ub18d\uc7a5\uc758 \uc544\ub3d9 \ub178\ub3d9\uc740 20\uc138\uae30 \uc720\ub300\uc778 \ud559\uc0b4 \uc0ac\uac74\uc774 \uc544\ub2cc \ud604\ub300\uc758 \uad6c\uc870\uc801 \ud3ed\ub825 \uc608\uc2dc\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc801\uadf9\uc801 \ud3c9\ud654 \uc6b4\ub3d9 - \uc2a4\ud1a1\ud640\ub984 \uad6d\uc81c \ud3c9\ud654 \uc5f0\uad6c\uc18c",
          "isCorrect": false,
          "rationale": "\uc2a4\ud1a1\ud640\ub984 \uc5f0\uad6c\uc18c\ub294 \ud3c9\ud654\ud559 \uc5f0\uad6c \uae30\uad00\uc774\uba70 \uc720\ub300\uc778 \uac15\uc81c \uc218\uc6a9\uc18c\uac00 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 \uae30\uac04\uc5d0 \uc720\ub300\uc778\uc744 \ub300\uc0c1\uc73c\ub85c \uc790\ud589\ub41c \ub300\ud45c\uc801\uc778 \uc794\ud639 \ud589\uc704\uc640 \uc218\uc6a9 \uc2dc\uc124\uc744 \ucc3e\uc73c\uc138\uc694."
    }
  ]
}