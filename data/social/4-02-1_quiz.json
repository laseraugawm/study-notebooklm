        {
          "text": "\uc9c1\uc811\uc801 \ud3ed\ub825",
          "isCorrect": false,
          "rationale": "\uc9c1\uc811\uc801 \ud3ed\ub825\uc740 \ud589\uc704\uc790\uac00 \uba85\ud655\ud558\uac8c \ubb3c\ub9ac\uc801 \uc704\ud574\ub97c \uac00\ud558\ub294 \ud3ed\ub825\uc785\ub2c8\ub2e4."
