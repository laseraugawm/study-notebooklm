{
  "title": "\ud3c9\ud654\uc758\ubbf8 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ud3c9\ud654\uc758 \uc758\ubbf8 \uc911 '\uc18c\uadf9\uc801 \ud3c9\ud654'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc804\uc7c1, \ud14c\ub7ec, \ubc94\uc8c4\uc640 \uac19\uc740 \uc9c1\uc811\uc801\uc774\uace0 \ubb3c\ub9ac\uc801\uc778 \ud3ed\ub825\uc774 \uc5c6\ub294 \uc0c1\ud0dc\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc18c\uadf9\uc801 \ud3c9\ud654\ub294 \uc804\uc7c1\uc774\ub098 \ud14c\ub7ec \ub4f1 \uc9c1\uc811\uc801\uc774\uace0 \ubb3c\ub9ac\uc801\uc778 \ud3ed\ub825\uc774 \uc5b5\uc81c\ub418\uac70\ub098 \ubd80\uc7ac\ud55c \uc0c1\ud0dc\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ube48\uace4, \uae30\uc544, \uc5b5\uc555 \ub4f1 \ubd88\uacf5\uc815\ud55c \uc0ac\ud68c \uc81c\ub3c4\ub85c \uc778\ud55c \uac04\uc811\uc801 \ud3ed\ub825\uae4c\uc9c0 \uc81c\uac70\ub41c \uc0c1\ud0dc\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd88\uacf5\uc815\ud55c \uc0ac\ud68c \uc81c\ub3c4\ub098 \uad6c\uc870\uc801 \ud3ed\ub825\uae4c\uc9c0 \uc81c\uac70\ub41c \uc0c1\ud0dc\ub294 \uc18c\uadf9\uc801 \ud3c9\ud654\uac00 \uc544\ub2cc \uc801\uadf9\uc801 \ud3c9\ud654\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud3ed\ub825\uc744 \uc815\ub2f9\ud654\ud558\ub294 \uc885\uad50, \uc608\uc220, \uc5b8\uc5b4 \ub4f1\uc758 \ubb38\ud654\uc801 \uc694\uc18c\ub97c \uc644\uc804\ud788 \ud574\uc18c\ud55c \uc0c1\ud0dc\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb38\ud654\uc801 \ud3ed\ub825\uc744 \uc81c\uac70\ud558\uc5ec \uc9c4\uc815\ud55c \ud3c9\ud654\ub97c \uc774\ub8e8\ub294 \uac83\uc740 \uc801\uadf9\uc801 \ud3c9\ud654\uc758 \uc694\uc18c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \uc0ac\ud68c \uad6c\uc131\uc6d0\uc774 \uc778\uac04\uc758 \uc874\uc5c4\uc131\uc744 \uc644\uc804\ud788 \ubcf4\uc7a5\ubc1b\uc73c\uba70 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc744 \ub204\ub9ac\ub294 \uc0c1\ud0dc\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\uac04\uc758 \uc874\uc5c4\uc131\uacfc \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc758 \ubcf4\uc7a5\uc740 \uc18c\uadf9\uc801 \ud3c9\ud654\ub97c \ub118\uc5b4 \uc801\uadf9\uc801 \ud3c9\ud654\uac00 \uc2e4\ud604\ub420 \ub54c \uac00\ub2a5\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc9c1\uc811\uc801\uc774\uace0 \ubb3c\ub9ac\uc801\uc778 \ud3ed\ub825\uc758 \uc720\ubb34\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc124\uba85\uc5d0 \ud574\ub2f9\ud558\ub294 \ud3ed\ub825\uc758 \uc720\ud615\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n- \ube48\uace4, \uc815\uce58\uc801 \ub3c5\uc7ac, \uacbd\uc81c\uc801 \ucc29\ucde8 \ub4f1\uc774 \ub300\ud45c\uc801 \uc0ac\ub840\uc784\n- \ubd88\uacf5\uc815\ud55c \uc0ac\ud68c \uad6c\uc870\ub098 \uc81c\ub3c4\ub85c \uc778\ud574 \uc778\uad8c \uce68\ud574\uc640 \uace0\ud1b5\uc774 \ubc1c\uc0dd\ud558\ub294 \ud3ed\ub825\uc784",
