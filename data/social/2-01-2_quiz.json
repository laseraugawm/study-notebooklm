{
  "title": "\ubd84\ubc30\uc815\uc758 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ubd84\ubc30\uc801 \uc815\uc758\uc5d0\uc11c \uacf5\uc815\ud558\uac8c \ub098\ub204\uc5b4\uc57c \ud560 \ub300\uc0c1\uc740 \ud06c\uac8c '\uc0ac\ud68c\uc801 \uc774\uc775'\uacfc '\uc0ac\ud68c\uc801 \ubd80\ub2f4'\uc73c\ub85c \uad6c\ubcc4\ub41c\ub2e4. \uc774\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubd80, \uad8c\ub9ac, \uba85\uc608, \uae30\ud68c \ub4f1\uc740 \uc0ac\ud68c\uc801 \uc774\uc775\uc5d0 \uc18d\ud558\uba70, \uc138\uae08, \uc758\ubb34, \uc0ac\ud68c\uc801 \ucc45\uc784 \ub4f1\uc740 \uc0ac\ud68c\uc801 \ubd80\ub2f4\uc5d0 \uc18d\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\ud68c\uc801 \uc774\uc775\uc740 \uac1c\uc778\uc5d0\uac8c \ud61c\ud0dd\uc774 \ub418\ub294 \uc7ac\ud654\uc640 \uac00\uce58\ub97c \uc758\ubbf8\ud558\uace0, \uc0ac\ud68c\uc801 \ubd80\ub2f4\uc740 \uac1c\uc778\uc774 \uc0ac\ud68c\ub97c \uc704\ud574 \ub9e1\uc544\uc57c \ud558\ub294 \ucc45\uc784\uc774\ub098 \uc758\ubb34\ub97c \uc758\ubbf8\ud55c\ub2e4."
        },
        {
          "text": "\uc138\uae08\uacfc \uc0ac\ud68c\uc801 \ucc45\uc784\uc740 \uc0ac\ud68c\uc801 \uc774\uc775\uc5d0 \ud574\ub2f9\ud558\uba70, \uba85\uc608\uc640 \uc0ac\ud68c\uc801 \uc9c0\uc704\ub294 \uc0ac\ud68c\uc801 \ubd80\ub2f4\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uae08\uacfc \ucc45\uc784\uc740 \uac1c\uc778\uc774 \uc9ca\uc5b4\uc838\uc57c \ud558\ub294 \ubd80\ub2f4\uc774\uba70, \uba85\uc608\uc640 \uc9c0\uc704\ub294 \uac1c\uc778\uc774 \uc5bb\uace0\uc790 \ud558\ub294 \ud61c\ud0dd \ub610\ub294 \uc774\uc775\uc774\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc801 \ubd80\ub2f4\uc740 \uc624\uc9c1 \uc18c\ub4dd \ubd88\ud3c9\ub4f1\uc744 \uac1c\uc120\ud558\uae30 \uc704\ud574 \ud2b9\uc815 \uacc4\uce35\uc5d0\ub9cc \uc801\uc6a9\ub418\ub294 \uc6d0\uce59\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ud68c\uc801 \ubd80\ub2f4\uc740 \uad6c\uc131\uc6d0 \uc804\uccb4\uac00 \uacf5\uc815\ud558\uac8c \ub098\ub204\uc5b4 \uac00\uc838\uc57c \ud560 \uc138\uae08, \uc758\ubb34, \ucc45\uc784 \ub4f1\uc744 \ud1b5\uce6d\ud558\ub294 \uac1c\ub150\uc774\ub2e4."
        },
        {
          "text": "\ubd84\ubc30\uc801 \uc815\uc758\ub294 \uc0ac\ud68c\uc801 \uc774\uc775\uc744 \ub098\ub204\ub294 \uac83\uc5d0\ub9cc \ud574\ub2f9\ud558\uba70, \ubd80\ub2f4\uc744 \ubd84\ubc30\ud558\ub294 \uac83\uacfc\ub294 \uad00\ub828\uc774 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd84\ubc30\uc801 \uc815\uc758\ub294 \uc0ac\ud68c\uc801 \uc774\uc775\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc138\uae08\uc774\ub098 \uc758\ubb34\uc640 \uac19\uc740 \uc0ac\ud68c\uc801 \ubd80\ub2f4\uc744 \uacf5\uc815\ud558\uac8c \ubd84\ubc30\ud558\ub294 \uc6d0\uce59\ub3c4 \ud3ec\ud568\ud55c\ub2e4."
        }
      ],
      "hint": "\uc0ac\ud68c \uad6c\uc131\uc6d0\uc774 \ub204\ub9ac\ub294 \ud61c\ud0dd\uacfc \uac1c\uc778\uc774 \uc758\ubb34\uc801\uc73c\ub85c \ubd80\ub2f4\ud558\ub294 \ud56d\ubaa9\uc744 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ub300\ud654\uc5d0\uc11c \ud559\uc0dd \uac11, \uc744, \ubcd1\uc774 \uac01\uac01 \uac15\uc870\ud558\uace0 \uc788\ub294 \ubd84\ubc30\uc801 \uc815\uc758\uc758 \uc2e4\uc9c8\uc801 \uae30\uc900\uc744 \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ud55c \uac83\uc740?\n\n\uac11: \uac01\uc885 \ub300\ud68c\uc5d0\uc11c \uc218\uc0c1\ud558\uc5ec \ud559\uad50\ub97c \ube5b\ub0b8 \ud559\uc0dd\uc774 \uc7a5\ud559\uae08\uc744 \ubc1b\uc544\uc57c \ud55c\ub2e4\uace0 \uc0dd\uac01\ud574\uc694.\n\uc744: \uc7a0\uc7ac\ub825\uc774 \ub9e4\uc6b0 \ub6f0\uc5b4\ub09c \ud559\uc0dd\uc5d0\uac8c \uc7a5\ud559\uae08\uc744 \uc8fc\uc5b4\uc57c \ud55c\ub2e4\uace0 \uc0dd\uac01\ud574\uc694.\n\ubcd1: \uac00\uc815 \ud615\ud3b8\uc774 \uc5b4\ub824\uc6cc \ud559\uc5c5\uc5d0 \uc804\ub150\ud558\uae30 \ud798\ub4e0 \ud559\uc0dd\uc5d0\uac8c \uc7a5\ud559\uae08\uc744 \uc8fc\uba74 \uc88b\uaca0\uc5b4\uc694.",
      "answerOptions": [
        {
          "text": "\uac11 - \uc5c5\uc801, \uc744 - \ub2a5\ub825, \ubcd1 - \ud544\uc694",
          "isCorrect": true,
          "rationale": "\uac11\uc740 \ud559\uad50\ub97c \ube5b\ub0b8 \uc218\uc0c1 \uc131\uacfc(\uc5c5\uc801)\ub97c, \uc744\uc740 \uc7a0\uc7ac\ub825\uacfc \uc804\ubb38\uc801 \uc790\uc9c8(\ub2a5\ub825)\uc744, \ubcd1\uc740 \uacbd\uc81c\uc801 \uc5b4\ub824\uc6c0 \uadf9\ubcf5 \uc694\uad6c(\ud544\uc694)\ub97c \uac15\uc870\ud55c\ub2e4."
        },
        {
          "text": "\uac11 - \ub2a5\ub825, \uc744 - \uc5c5\uc801, \ubcd1 - \ud544\uc694",
          "isCorrect": false,
          "rationale": "\uac01\uc885 \ub300\ud68c \uc218\uc0c1 \uc2e4\uc801\uc740 \uc7a0\uc7ac\ub41c \ub2a5\ub825\uc774 \uc544\ub2c8\ub77c \uc2e4\uc81c\ub85c \uc774\ub8e8\uc5b4 \ub0b8 \uc131\uacfc\uc778 \uc5c5\uc801\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\uac11 - \uc5c5\uc801, \uc744 - \ud544\uc694, \ubcd1 - \ub2a5\ub825",
          "isCorrect": false,
          "rationale": "\uac00\uc815 \ud615\ud3b8\uc774 \uc5b4\ub824\uc6b4 \uc0c1\ud669\uc740 \uae30\ubcf8\uc801 \uc0dd\ud65c \uc720\uc9c0\ub97c \uc704\ud55c \ud544\uc694 \uae30\uc900\uc774\uba70 \ub2a5\ub825 \uae30\uc900\uc774 \uc544\ub2c8\ub2e4."
        },
        {
          "text": "\uac11 - \ub2a5\ub825, \uc744 - \ud544\uc694, \ubcd1 - \uc5c5\uc801",
          "isCorrect": false,
          "rationale": "\uc7a0\uc7ac\ub825\uc740 \ub2a5\ub825 \uae30\uc900\uc5d0, \uac00\uc815 \ud615\ud3b8\uc740 \ud544\uc694 \uae30\uc900\uc5d0, \uc218\uc0c1 \uc2e4\uc801\uc740 \uc5c5\uc801 \uae30\uc900\uc5d0 \uac01\uac01 \ub300\uc751\ud55c\ub2e4."
        }
      ],
      "hint": "\uac01 \uc778\ubb3c\uc774 \uc81c\uc2dc\ud558\ub294 \uc7a5\ud559\uae08 \uc218\ud61c \uc870\uac74\uc758 \ud575\uc2ec(\uc218\uc0c1 \uc2e4\uc801, \uc7a0\uc7ac\ub825, \uacbd\uc81c\uc801 \ud615\ud3b8)\uc744 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "'\ub2a5\ub825\uc5d0 \ub530\ub978 \ubd84\ubc30' \ubc29\uc2dd\uc758 \uc7a5\uc810 \ubc0f \ub2e8\uc810\uc5d0 \ub300\ud55c \uc9c4\uc220\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc758 \uc7ac\ub2a5\uacfc \uc7a0\uc7ac\ub825\uc744 \ubc1c\ud718\ud558\ub3c4\ub85d \ub3d9\uae30\ub97c \uc790\uadf9\ud558\ub294 \uc7a5\uc810\uc774 \uc788\uc9c0\ub9cc, \ud0c0\uace0\ub09c \ud658\uacbd\uc774\ub098 \uc2e0\uccb4\uc801 \uc870\uac74 \ub4f1 \uc6b0\uc5f0\uc801 \uc694\uc18c\uac00 \uac1c\uc785\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub2a5\ub825\uc5d0 \ub530\ub978 \ubd84\ubc30\ub294 \uc7a0\uc7ac\ub825\uc744 \ubc1c\ud718\ud558\uac8c \ub9cc\ub4e4\uc9c0\ub9cc, \ub2a5\ub825\uc744 \ud615\uc131\ud558\ub294 \ub370 \uc120\ucc9c\uc801 \uc7ac\ub2a5\uc774\ub098 \uac00\uc815\ud658\uacbd \uac19\uc740 \uc6b0\uc5f0\uc801 \uc694\uc778\uc774 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce5c\ub2e4\ub294 \ub2e8\uc810\uc774 \uc788\ub2e4."
        },
        {
          "text": "\uacb0\uacfc\ub97c \uc218\ub7c9\ud654\ud558\uae30 \uc26c\uc6cc \uc8fc\uad00\uc801 \ud3b8\uacac\uc744 \uc644\uc804\ud788 \ubc30\uc81c\ud560 \uc218 \uc788\uc73c\ub098, \uad6c\uc131\uc6d0 \uac04 \uacfc\uc5f4\ub41c \uacbd\uc7c1\uc744 \uc720\ubc1c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\ub7c9\ud654\uac00 \uc6a9\uc774\ud558\uace0 \uc8fc\uad00\uc801 \ud3b8\uacac\uc744 \ubc30\uc81c\ud560 \uc218 \uc788\ub2e4\ub294 \uc810\uc740 \ub2a5\ub825 \uae30\uc900\uc774 \uc544\ub2cc \uc5c5\uc801 \uae30\uc900\uc758 \ub300\ud45c\uc801 \ud2b9\uc9d5\uc774\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0\uac8c \ucd5c\uc18c\ud55c\uc758 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc744 \ubcf4\uc7a5\ud560 \uc218 \uc788\uc9c0\ub9cc, \uad6d\uac00\uc758 \uc7ac\uc815\uc801 \ubd80\ub2f4\uc774 \uadf9\uc2ec\ud574\uc9c4\ub2e4\ub294 \ud55c\uacc4\uac00 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ud68c\uc801 \uc57d\uc790\ub97c \ubcf4\ud638\ud558\uace0 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc744 \ubcf4\uc7a5\ud558\ub294 \uac83\uc740 \ud544\uc694\uc5d0 \ub530\ub978 \ubd84\ubc30\uac00 \uac16\ub294 \uc7a5\uc810\uc774\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc774 \ub2ec\uc131\ud55c \ucd5c\uc885 \uc131\uacfc\ub9cc\uc744 \ubc14\ud0d5\uc73c\ub85c \ud3c9\uac00\ud558\ubbc0\ub85c, \ub2a5\ub825\uc744 \ud3c9\uac00\ud558\ub294 \uae30\uc900\uc774 \uc5b8\uc81c\ub098 \ub9e4\uc6b0 \uba85\ud655\ud558\uace0 \uac1d\uad00\uc801\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2a5\ub825\uc740 \uc7a0\uc7ac\ub825\uc774\ub098 \uc804\ubb38\uc801 \uc790\uc9c8\uc744 \ud3ec\ud568\ud558\ubbc0\ub85c, \uc5c5\uc801\uacfc \ub2ec\ub9ac \ud3c9\uac00 \uae30\uc900\uc774 \ubaa8\ud638\ud558\ub2e4\ub294 \ub2e8\uc810\uc744 \uc9c0\ub2cc\ub2e4."
        }
      ],
      "hint": "\ub2a5\ub825\uc744 \uc5bb\ub294 \uacfc\uc815\uc5d0 \uac1c\uc785\ud558\ub294 \uc120\ucc9c\uc801\u00b7\uc6b0\uc5f0\uc801 \uc694\uc18c\uc640 \ub2a5\ub825 \ud3c9\uac00\uc758 \uba85\ud655\uc131 \uc5ec\ubd80\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc9c8\ubb38\uc5d0 \ub300\ud55c \ub2f5\ubcc0\uc73c\ub85c \uad50\uacfc\uc11c\uc758 \ubc14\ud0d5 \ub0b4\uc6a9\uc5d0 \ube44\ucd94\uc5b4 \ubcfc \ub54c \uac00\uc7a5 \uc62c\ubc14\ub978 \uc124\uba85\uc740?\n\n[\uad81\uae08\ud574\uc694!]\n\"\ub2a5\ub825\uc774 \ub6f0\uc5b4\ub09c \uc0ac\ub78c\uc740 \uc5c5\uc801\ub3c4 \ub9ce\uc774 \uc313\uac8c \ub418\ub294 \uac83 \uc544\ub2cc\uac00\uc694?\"",
      "answerOptions": [
        {
          "text": "\ub2a5\ub825\uc774 \ub6f0\uc5b4\ub098\ub354\ub77c\ub3c4 \uc2a4\uc2a4\ub85c \ub178\ub825\ud558\uc9c0 \uc54a\uac70\ub098 \ub2a5\ub825\uc744 \ubc1c\ud718\ud560 \uc5ec\uac74\uc774 \ub9c8\ub828\ub418\uc9c0 \uc54a\uc73c\uba74 \ub192\uc740 \uc5c5\uc801\uc744 \uc313\uae30 \uc5b4\ub835\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub2a5\ub825\uc740 \uc5c5\uc801\uc744 \uc774\ub8f0 \uc218 \uc788\ub294 \uc7a0\uc7ac\uc801 \uc790\uc9c8\uc774\uba70, \uc2e4\uc81c \uc5c5\uc801\uc73c\ub85c \uc774\uc5b4\uc9c0\uae30 \uc704\ud574\uc11c\ub294 \uac1c\uc778\uc758 \ub178\ub825\uacfc \uc0ac\ud68c\uc801 \uc5ec\uac74\uc774 \ud544\uc218\uc801\uc73c\ub85c \uacb0\ud569\ub418\uc5b4\uc57c \ud55c\ub2e4."
        },
        {
          "text": "\ub2a5\ub825\uc774 \ub6f0\uc5b4\ub09c \uc0ac\ub78c\uc740 \uc5b4\ub5a0\ud55c \uc0c1\ud669\uc5d0\uc11c\ub3c4 \ud56d\uc0c1 \uadf8\uc5d0 \ube44\ub840\ud558\ub294 \ucd5c\uace0\uc758 \uc5c5\uc801\uc744 \ub2ec\uc131\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2a5\ub825\uacfc \uc5c5\uc801\uc740 \ube44\ub840 \uad00\uacc4\uc5d0 \uc788\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc9c0\ub9cc, \ub178\ub825 \ubd80\uc7ac\ub098 \uc5ec\uac74 \ubbf8\ube44\ub85c \uc778\ud574 \ub2a5\ub825\uc774 \uc5c5\uc801\uc73c\ub85c \uc9c1\uacb0\ub418\uc9c0 \ubabb\ud560 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\uc5c5\uc801\uacfc \ub2a5\ub825\uc740 \uc644\uc804\ud788 \ub3d9\uc77c\ud55c \uac1c\ub150\uc774\ubbc0\ub85c \ub450 \uae30\uc900\uc740 \ubd84\ubc30 \uc2dc \uad6c\ubcc4\ud560 \ud544\uc694\uac00 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2a5\ub825\uc740 \uc2e0\uccb4\uc801\u00b7\uc815\uc2e0\uc801 \uc7a0\uc7ac\ub825 \ubc0f \uc790\uc9c8\uc744, \uc5c5\uc801\uc740 \ub2a5\ub825\uacfc \ub178\ub825\uc744 \ud1a0\ub300\ub85c \uc774\ub904\ub0b8 \uc2e4\uc81c \uacb0\uacfc\ubb3c\uc744 \uc758\ubbf8\ud558\ubbc0\ub85c \uc5c4\uc5f0\ud788 \uad6c\ubd84\ub41c\ub2e4."
        },
        {
          "text": "\uc5c5\uc801\uc744 \uc313\ub294 \ub370 \ud544\uc694\ud55c \uac83\uc740 \uc624\uc9c1 \uc120\ucc9c\uc801\uc778 \ud658\uacbd\ubfd0\uc774\uba70 \uac1c\uc778\uc758 \ub2a5\ub825\uc774\ub098 \ub178\ub825\uc740 \uc601\ud5a5\uc744 \ubbf8\uce58\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5c5\uc801\uc740 \uac1c\uc778\uc774 \uc790\uc2e0\uc758 \ub2a5\ub825\uacfc \ub178\ub825\uc744 \ud1a0\ub300\ub85c \uc774\ub8e8\uc5b4 \ub0b4\ub294 \uc131\uacfc\uc774\ub2e4."
        }
      ],
      "hint": "\ub2a5\ub825\uc774 \uc2e4\uc81c \uacb0\uacfc\ubb3c\ub85c \ud45c\ud604\ub418\uae30 \uc704\ud574 \uc694\uad6c\ub418\ub294 \uc694\uc18c(\ub178\ub825, \ud658\uacbd \ubc0f \uc5ec\uac74)\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "'\uc5c5\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30' \ubc29\uc2dd\uc774 \uc9c0\ub2cc \ub300\ud45c\uc801\uc778 \uc7a5\uc810\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc131\uacfc\ub97c \uc313\uae30 \ud798\ub4e0 \uc0ac\ud68c\uc801 \uc57d\uc790\ub97c \uc6b0\uc120 \ubc30\ub824\ud558\uc5ec \ube48\ubd80 \uaca9\ucc28\ub97c \uc790\ub3d9\uc73c\ub85c \uc644\ud654\ud574 \uc900\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc5c5\uc801\uc5d0 \ub530\ub978 \ubd84\ubc30\ub294 \uc5c5\uc801\uc744 \uc313\uae30 \uc5b4\ub824\uc6b4 \uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0 \ub300\ud55c \ubc30\ub824\uac00 \ubd80\uc871\ud574\uc838 \uc624\ud788\ub824 \ube48\ubd80 \uaca9\ucc28\uac00 \ucee4\uc9c8 \uc218 \uc788\ub2e4\ub294 \ub2e8\uc810\uc744 \uc9c0\ub2cc\ub2e4."
        },
        {
          "text": "\uc131\uacfc\uac00 \ube44\uad50\uc801 \uc218\ub7c9\ud654\ud558\uae30 \uc6a9\uc774\ud558\uc5ec \ud3c9\uac00\uc5d0 \uac1c\uc785\ub420 \uc218 \uc788\ub294 \uc8fc\uad00\uc801 \ud3b8\uacac\uc744 \ubc30\uc81c\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5c5\uc801\uc740 \uacb0\uacfc\ubb3c\uc774 \uba85\ud655\ud558\uac8c \ub4dc\ub7ec\ub098 \uc218\ub7c9\ud654\ud558\uae30 \uc26c\uc6b0\ubbc0\ub85c \uacf5\uc815\ud558\uace0 \uac1d\uad00\uc801\uc778 \ud3c9\uac00\uac00 \uac00\ub2a5\ud558\ub2e4."
        },
        {
          "text": "\uacf5\ub3d9\uc758 \ubaa9\ud45c\ub97c \uc774\ub8f0 \uc218 \uc788\ub3c4\ub85d \uac1c\uc778\uc758 \uc131\ucde8\ub3d9\uae30\ub97c \uc790\uadf9\ud558\uc5ec \uc0dd\uc0b0\uc131\uc744 \ub192\uc774\ub294 \ub370 \uae30\uc5ec\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc2e0\uc774 \uae30\uc5ec\ud55c \uc131\uacfc\ub9cc\ud07c \ubcf4\uc0c1\ubc1b\uc73c\ubbc0\ub85c \uad6c\uc131\uc6d0\ub4e4\uc758 \uc131\ucde8\ub3d9\uae30\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\ub2e4."
