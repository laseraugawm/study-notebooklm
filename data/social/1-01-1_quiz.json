          "rationale": "\ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95 \uc81c153\uc870\ub294 \uc18c\uc720\uad8c\uc758 \ud589\uc0ac\uac00 \uacf5\uacf5\ubcf5\ub9ac\uc5d0 \uc801\ud569\ud574\uc57c \ud568\uc744 \uba85\uc2dc\ud588\uc2b5\ub2c8\ub2e4."
