    {
      "type": "multiple_choice",
      "question": "\uc0b0\uc5c5 \ud601\uba85 \uc774\ud6c4 \ub4f1\uc7a5\ud55c \uc778\uad8c\uc758 \uc0c8\ub85c\uc6b4 \uc601\uc5ed\uacfc \ub3c5\uc77c \ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95(1919)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95\uc740 \uac1c\uc778\uc758 \uc7ac\uc0b0\uad8c \ud589\uc0ac\ub97c \uacf5\uacf5\ubcf5\ub9ac\uc640 \ubb34\uad00\ud558\uac8c \uc808\ub300\uc801\uc73c\ub85c \ubcf4\ud638\ud574\uc57c \ud568\uc744 \uba85\uc2dc\ud558\uc600\ub2e4.",
