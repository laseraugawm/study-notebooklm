    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ub450 \uc790\ub8cc\uc5d0 \uba85\uc2dc\ub41c \uc778\uad8c \uc120\uc5b8\ubb38\uc744 \ube44\uad50 \ubd84\uc11d\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?\n\n[\uc790\ub8cc 1] \ud504\ub791\uc2a4 \uc778\uac04\uacfc \uc2dc\ubbfc\uc758 \uad8c\ub9ac \uc120\uc5b8(1789)\n\uc81c2\uc870 \ubaa8\ub4e0 \uc815\uce58\uc801 \uacb0\uc0ac\uc758 \ubaa9\uc801\uc740 \uadf8 \ubb34\uc5c7\ub3c4 \uce68\ud574\ud560 \uc218 \uc5c6\ub294 \uc778\uac04\uc758 \uc790\uc5f0\uad8c\uc744 \ubcf4\uc804\ud558\ub294 \ub370 \uc788\ub2e4. \uadf8 \uad8c\ub9ac\ub294 \uc790\uc720, \uc18c\uc720, \uc548\uc804 \ubc0f \uc555\uc81c\uc5d0 \ub300\ud55c \uc800\ud56d\uc774\ub2e4.\n\n[\uc790\ub8cc 2] \uc138\uacc4 \uc778\uad8c \uc120\uc5b8(1948)\n\uc81c22\uc870 \ubaa8\ub4e0 \uc0ac\ub78c\uc740 ... \uad6d\uac00\uc801 \ub178\ub825\uacfc \uad6d\uc81c\uc801 \ud611\ub825\uc744 \ud1b5\ud558\uc5ec ... \uc790\uc2e0\uc758 \uc874\uc5c4\uacfc \uc778\uaca9\uc758 \uc790\uc720\ub85c\uc6b4 \ubc1c\uc804\uc5d0 \ubd88\uac00\uacb0\ud55c \uacbd\uc81c\u00b7\uc0ac\ud68c\u00b7\ubb38\ud654\uc801 \uad8c\ub9ac\ub4e4\uc744 \uc2e4\ud604\ud560 \uad8c\ub9ac\uac00 \uc788\ub2e4.",
      "answerOptions": [
        {
          "text": "\uc790\ub8cc 1\uc740 \uad6d\uac00 \uad8c\ub825\uc758 \ubd80\ub2f9\ud55c \uac04\uc12d\uc73c\ub85c\ubd80\ud130 \ubc97\uc5b4\ub098\ub824\ub294 \uc790\uc720\uad8c\uc801 \uc131\uaca9\uc744 \uac15\uc870\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud504\ub791\uc2a4 \uc778\uad8c \uc120\uc5b8 \uc81c2\uc870\uc758 \uc790\uc720, \uc18c\uc720, \uc548\uc804, \uc800\ud56d\uad8c\uc740 \ub300\ud45c\uc801\uc778 \uc790\uc720\uad8c\uc801 \uad8c\ub9ac\uc785\ub2c8\ub2e4."
