        {
          "text": "\ub450 \ucc28\ub840\uc758 \uc138\uacc4 \ub300\uc804 \ucc38\uc0c1\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uad6d\uc81c \uc5f0\ud569 \ucd1d\ud68c\uc5d0\uc11c \ucc44\ud0dd\ub41c \ucd5c\ucd08\uc758 \uad6d\uc81c \uc870\uc57d\uc774\ub2e4.",
          "isCorrect": false,
