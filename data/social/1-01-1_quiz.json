{
  "title": "\uc778\uad8c\uc0ac \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc778\uad8c\uc758 \uae30\ubcf8 \ud2b9\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uac00 \uad8c\ub825\uc774\ub098 \ub2e4\ub978 \uc0ac\ub78c\uc774 \ud568\ubd80\ub85c \ube7c\uc557\uac70\ub098 \uce68\ud574\ud560 \uc218 \uc5c6\ub294 \ubd88\uac00\uce68\uc758 \uad8c\ub9ac\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\uad8c\uc740 \ud0c0\uc778\uc774\ub098 \uad6d\uac00\uc5d0 \uc758\ud574 \uce68\ud574\ub420 \uc218 \uc5c6\ub294 \ubd88\uac00\uce68\uc131\uc744 \uac00\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uc885, \uc131\ubcc4, \uc885\uad50, \uc5b8\uc5b4 \ub4f1\uacfc \uad00\uacc4\uc5c6\uc774 \uc778\uac04\uc774\ub77c\uba74 \ub204\uad6c\ub098 \ub204\ub9ac\ub294 \ubcf4\ud3b8\uc801 \uad8c\ub9ac\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\uad8c\uc740 \uc2e0\ubd84\uc774\ub098 \uc870\uac74\uc5d0 \uad00\uacc4\uc5c6\uc774 \ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \uc801\uc6a9\ub418\ub294 \ubcf4\ud3b8\uc131\uc744 \uac00\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00\uc758 \ubc95\ub960\uc774\ub098 \ubb38\uc11c\ub85c \uaddc\uc815\ub418\uc5b4\uc57c\ub9cc \ube44\ub85c\uc18c \uc815\ub2f9\uc131\uc744 \ubd80\uc5ec\ubc1b\ub294 \uc2e4\uc815\ubc95\uc801 \uad8c\ub9ac\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc778\uad8c\uc740 \uad6d\uac00\uac00 \ubc95\uc73c\ub85c \ubcf4\uc7a5\ud558\uae30 \uc804\ubd80\ud130 \ud0dc\uc5b4\ub098\uba74\uc11c \uc790\uc5f0\uc801\uc73c\ub85c \ubd80\uc5ec\ub418\ub294 \ucc9c\ubd80\uc801 \uad8c\ub9ac\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00 \uad8c\ub825\uc774 \ubd80\ub2f9\ud558\uac8c \uad6d\ubbfc\uc758 \uad8c\ub9ac\ub97c \uce68\ud574\ud560 \ub54c \uc774\ub97c \ube44\ud310\ud558\uace0 \ubc14\ub85c\uc7a1\ub294 \uae30\uc900\uc774 \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\uad8c\uc740 \uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\ub97c \ud310\ub2e8\ud558\uace0 \uad6d\uac00 \uad8c\ub825\uc744 \uacac\uc81c\ud558\ub294 \uc2e4\uc9c8\uc801\uc778 \ud3c9\uac00 \uae30\uc900 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc778\uad8c\uc740 \uad6d\uac00\uac00 \uc131\ubb38\ubc95\uc73c\ub85c \uc81c\uc815\ud558\uae30 \uc774\uc804\ubd80\ud130 \uc778\uac04\uc5d0\uac8c \uc790\uc5f0\uc801\uc73c\ub85c \uc874\uc7ac\ud558\ub294 \uad8c\ub9ac\uc784\uc744 \uba85\uc2ec\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uae00\uc5d0 \ub098\ud0c0\ub09c \ucca0\ud559\uc790 \ud574\ub098 \uc544\ub80c\ud2b8(Arendt, H.)\uc758 \uc8fc\uc7a5\uc5d0\uc11c \uac15\uc870\ud558\ub294 \ubc14\ub97c \uac00\uc7a5 \uc798 \ud30c\uc545\ud55c \uac83\uc740?\n\n\"\uad8c\ub9ac\ub97c \uc0c1\uc2e4\ud55c \uc0ac\ub78c\ub4e4\uc758 \uc7ac\ub09c\uc740 \uadf8\ub4e4\uc774 \uc0dd\uba85, \uc790\uc720\uc640 \ud589\ubcf5 \ucd94\uad6c \ub610\ub294 \ubc95 \uc55e\uc5d0\uc11c\uc758 \ud3c9\ub4f1\uacfc \uc758\uacac\uc758 \uc790\uc720\ub97c \ube7c\uc557\uacbc\ub2e4\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc5b4\ub290 \uacf5\ub3d9\uccb4\uc5d0\ub3c4 \uc18d\ud558\uc9c0 \uc54a\ub294\ub2e4\ub294 \uac83\uc774\ub2e4. \uc774\ub4e4\uc774 \uacaa\ub294 \uc5b4\ub824\uc6c0\uc740 \ubc95 \uc55e\uc5d0\uc11c \ud3c9\ub4f1\ud558\uc9c0 \uc54a\uc740 \uac83\uc774 \uc544\ub2c8\ub77c \uadf8\ub4e4\uc744 \uc704\ud55c \uc5b4\ub5a0\ud55c \ubc95\ub3c4 \uc874\uc7ac\ud558\uc9c0 \uc54a\ub294\ub2e4\ub294 \uac83\uc774\ub2e4.\"",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc758 \uc790\uc720\uc640 \uad8c\ub9ac\ub294 \ubbfc\uc871\uacfc \uad6d\uac00\uc758 \uc874\ub9bd\uc744 \uc704\ud574 \uc81c\ud55c\ub418\ub294 \uac83\uc774 \uc815\ub2f9\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\uac83\uc740 \uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \uad6d\uac00\ubcf4\ub2e4 \ud6c4\uc21c\uc704\ub85c \ub450\ub294 \uc804\uccb4\uc8fc\uc758\uc801 \uad00\uc810\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00\ub098 \uc815\uce58 \uacf5\ub3d9\uccb4\uc5d0 \uc18d\ud558\uc9c0 \uc54a\uc740 \ubb34\uad6d\uc801\uc790\ub098 \ub09c\ubbfc\uc758 \uc778\uad8c \ubcf4\uc7a5 \ubb38\uc81c\uc5d0 \uc8fc\ubaa9\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc544\ub80c\ud2b8\ub294 \uc5b4\ub290 \uc815\uce58 \uacf5\ub3d9\uccb4\uc5d0\ub3c4 \uc18d\ud558\uc9c0 \ubabb\ud574 \ubc95\uc801 \ubcf4\ud638\ub97c \ubc1b\uc9c0 \ubabb\ud558\ub294 \uc18c\uc218\uc790, \ub09c\ubbfc, \ubb34\uad6d\uc801\uc790\uc758 \uc778\uad8c \ubcf4\uc7a5\uc774 \ub9e4\uc6b0 \uc911\uc694\ud568\uc744 \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uad8c\uc740 \uac1c\uc778\uc758 \uad6d\uc801\uacfc \ubc95\uc801 \uc790\uaca9\uc774 \uba3c\uc800 \ud655\ub9bd\ub418\uc5b4\uc57c \ubd80\uc5ec\ub418\ub294 \uc2e4\uc815\ubc95\uc801 \uad8c\ub9ac\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc544\ub80c\ud2b8\ub294 \uad6d\uac00\uac00 \uad6d\uc801\uc744 \ubc15\ud0c8\ud588\uc744 \ub54c \ubaa8\ub4e0 \uad8c\ub9ac\uac00 \uc0c1\uc2e4\ub418\ub294 \ud604\uc2e4\uc744 \ube44\ud310\ud55c \uac83\uc774\uc9c0, \uad6d\uc801\uc774 \uc778\uad8c\uc758 \uc804\uc81c\uc870\uac74\uc774\ub77c\uace0 \uc639\ud638\ud55c \uac83\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\ube48\ubd80 \uaca9\ucc28 \ud574\uc18c\ub97c \uc704\ud574 \uad6d\uac00\uac00 \uc0ac\ud68c\uc801 \uc57d\uc790\uc5d0\uac8c \uacbd\uc81c\uc801 \uae09\ubd80\ub97c \uc9c1\uc811 \uc81c\uacf5\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc81c\uc2dc\ubb38\uc740 \uc0ac\ud68c\uad8c\uc801 \uae09\ubd80\uac00 \uc544\ub2c8\ub77c \uc815\uce58 \uacf5\ub3d9\uccb4\uc5d0 \uc18d\ud558\uc9c0 \ubabb\ud55c \ubb34\uad6d\uc801\uc790\u00b7\ub09c\ubbfc\uc758 \ubcf4\ud3b8\uc801 \uc778\uad8c \ubd80\uc7ac\ub97c \ubb38\uc81c \uc0bc\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uad6d\uc801\uc774\ub098 \uc815\uce58\uc801 \uc18c\uc18d\uc774 \uc5c6\ub294 \ubb34\uad6d\uc801\uc790\ub098 \ub09c\ubbfc\uc774 \ucc98\ud55c \uc778\uad8c\uc758 \uc0ac\uac01\uc9c0\ub300\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc758 \uc0ac\uc0c1\uc801 \ubc30\uacbd\uc774 \ub41c \uacc4\ubabd\uc0ac\uc0c1\uacfc \uc0ac\ud68c \uacc4\uc57d\uc124\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uacc4\ubabd\uc0ac\uc0c1\uc740 \uac1c\uc778\uc758 \ubaa8\ub4e0 \ud65c\ub3d9\uc774 \uad6d\uac00\uc758 \uc874\ub9bd\uacfc \ubc1c\uc804\uc744 \uc704\ud574 \uc874\uc7ac\ud574\uc57c \ud55c\ub2e4\ub294 \uc774\ub150\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uc758 \ud65c\ub3d9\uc774 \uad6d\uac00 \uc874\ub9bd\uc744 \uc704\ud574 \uc874\uc7ac\ud55c\ub2e4\ub294 \uc0dd\uac01\uc740 \uacc4\ubabd\uc0ac\uc0c1\uc774 \uc544\ub2c8\ub77c \uc804\uccb4\uc8fc\uc758\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c \uacc4\uc57d\uc124\uc740 \uc790\uc720\ub86d\uace0 \ud3c9\ub4f1\ud55c \uc2dc\ubbfc \uac04\uc758 \uacc4\uc57d\uc744 \ubc14\ud0d5\uc73c\ub85c \uad6d\uac00 \uad8c\ub825\uc774 \ud615\uc131\ub418\uc5c8\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\ud68c \uacc4\uc57d\uc124\uc740 \uc8fc\uad8c\uc790\uc778 \uc2dc\ubbfc\ub4e4\uc758 \uc790\ubc1c\uc801 \ud569\uc758\uc640 \uacc4\uc57d\uc73c\ub85c \uad6d\uac00 \uad8c\ub825\uc774 \uc815\ub2f9\ud654\ub41c\ub2e4\uace0 \uc124\uba85\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uacc4\ubabd\uc0ac\uc0c1\uc740 \uc655\uad8c\uc2e0\uc218\uc124\uc744 \ubc14\ud0d5\uc73c\ub85c \uc808\ub300\uc655\uc815\uc758 \uc815\ub2f9\uc131\uc744 \uc639\ud638\ud558\ub294 \ub370 \uae30\uc5ec\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacc4\ubabd\uc0ac\uc0c1\uc740 \uc778\uac04\uc758 \uc774\uc131\uc73c\ub85c \uc0ac\ud68c\uc801 \ubaa8\uc21c\uacfc \uad6c\uc81c\ub3c4\uc758 \ubd80\uc870\ub9ac\ub97c \ube44\ud310\ud558\uace0 \ubc14\ub85c\uc7a1\uc73c\ub824 \ud55c \uc0ac\uc0c1\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c \uacc4\uc57d\uc124\uc740 \uad6d\uac00\uc758 \uad6c\uccb4\uc801 \ubc95\ub960\uc774 \uac1c\uc785\ud558\uc9c0 \uc54a\ub354\ub77c\ub3c4 \uc0ac\ud68c\uad8c\uc774 \uc989\uc2dc \uc2e4\ud604\ub41c\ub2e4\uace0 \uc8fc\uc7a5\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ud68c \uacc4\uc57d\uc124\uc740 \uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uae30 \uad6d\uac00 \uad8c\ub825\uc758 \uc131\ub9bd \uacfc\uc815\uacfc \uc790\uc720\uad8c \ud655\ub9bd\uc5d0 \uc601\ud5a5\uc744 \uc900 \uc774\ub860\uc774\uba70, \ubcf5\uc9c0 \uad6d\uac00 \uc2dc\ub300\uc758 \uc0ac\ud68c\uad8c\uacfc\ub294 \uc9c1\uc811\uc801 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uad6d\uac00\uac00 \uc2e0\uc774 \uc544\ub2cc '\uc2dc\ubbfc \uac04\uc758 \uc790\ubc1c\uc801 \uc57d\uc18d'\uc5d0 \uc758\ud574 \ub9cc\ub4e4\uc5b4\uc84c\ub2e4\uace0 \ubcf4\ub294 \uc774\ub860\uc774 \ubb34\uc5c7\uc778\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85 \uacfc\uc815\uc5d0\uc11c \ubb38\uc11c\ud654\ub41c \uc778\uad8c \uc120\uc5b8\uacfc \uadf8 \ub0b4\uc6a9\uc758 \uc5f0\uacb0\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc601\uad6d \uad8c\ub9ac \uc7a5\uc804(1689) \u2013 \uad6d\ubbfc \uc8fc\uad8c\uc758 \uc6d0\ub9ac, \ud589\ubcf5 \ucd94\uad6c\uad8c, \uc800\ud56d\uad8c\uc744 \uba85\uc2dc\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\ubbfc \uc8fc\uad8c, \ud589\ubcf5 \ucd94\uad6c\uad8c, \uc800\ud56d\uad8c\uc774 \uba85\uc2dc\ub41c \ubb38\uc11c\ub294 \ubbf8\uad6d \ub3c5\ub9bd \uc120\uc5b8\ubb38(1776)\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubbf8\uad6d \ub3c5\ub9bd \uc120\uc5b8\ubb38(1776) \u2013 \uc758\ud68c\uc758 \ub3d9\uc758 \uc5c6\ub294 \uacfc\uc138 \uae08\uc9c0 \ub4f1\uc744 \uaddc\uc815\ud558\uc5ec \uc785\ud5cc \uad70\uc8fc\uc81c\uc758 \uae30\ud2c0\uc744 \ub9c8\ub828\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc758\ud68c\uc758 \ub3d9\uc758 \uc5c6\ub294 \uacfc\uc138 \uae08\uc9c0\uc640 \uc785\ud5cc \uad70\uc8fc\uc81c \uae30\ud2c0 \ub9c8\ub828\uc740 \uc601\uad6d \uad8c\ub9ac \uc7a5\uc804(1689)\uc5d0 \uad00\ud55c \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud504\ub791\uc2a4 \uc778\uac04\uacfc \uc2dc\ubbfc\uc758 \uad8c\ub9ac \uc120\uc5b8(1789) \u2013 \uc7ac\uc0b0\uad8c\uc744 \uc2e0\uc131\ud55c \uad8c\ub9ac\ub85c \uc120\ud3ec\ud558\uace0 \uc790\uc720\uc640 \ud3c9\ub4f1\uc758 \uac00\uce58\ub97c \uc120\uc5b8\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud504\ub791\uc2a4 \uc778\uad8c \uc120\uc5b8\uc740 \uc7ac\uc0b0\uad8c\uc758 \uc2e0\uc131\ubd88\uac00\uce68\uc131\uacfc \uc790\uc720, \ud3c9\ub4f1, \uc800\ud56d\uad8c \ub4f1\uc744 \uba85\uc2dc\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc601\uad6d \uad8c\ub9ac \uc7a5\uc804(1689) \u2013 \ubaa8\ub4e0 \uc131\uc778 \ub0a8\ub140\uc5d0\uac8c \uc2e0\ubd84\uacfc \uc7ac\uc0b0\uc5d0 \uad00\uacc4\uc5c6\ub294 \ubcf4\ud1b5 \uc120\uac70\uad8c\uc744 \ubcf4\uc7a5\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85 \ub2f9\uc2dc\uc5d0\ub294 \uc7ac\uc0b0\uc774\ub098 \uc131\ubcc4 \ub4f1\uc5d0 \ub530\ub978 \ucc38\uc815\uad8c \uc81c\ud55c\uc774 \uc720\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud504\ub791\uc2a4 \ud601\uba85 \uc9c1\ud6c4 \ucc44\ud0dd\ub41c \uc120\uc5b8\ubb38\uc5d0\uc11c '\uc18c\uc720\uad8c(\uc7ac\uc0b0\uad8c)'\uc744 \uc5b4\ub5bb\uac8c \ub2e4\ub8e8\uc5c8\ub294\uc9c0 \uae30\uc5b5\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc744 \ud1b5\ud574 \ud655\ub9bd\ub41c \uc778\uad8c \ubcf4\uc7a5\uc758 \ud55c\uacc4\uc810\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc720\uad8c\uacfc \ud3c9\ub4f1\uad8c\uc758 \ud655\ub9bd \uacc4\uae30\uac00 \ub418\uc5c8\uc73c\ub098, \uc131\ubcc4\uc774\ub098 \uc7ac\uc0b0\uc5d0 \ub530\ub978 \ucc38\uc815\uad8c\uc758 \uc81c\ud55c\uc774 \uc874\uc7ac\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85\uc740 \uc790\uc720\uc640 \ud3c9\ub4f1\uc744 \uc120\uc5b8\ud588\uc9c0\ub9cc, \uc5ec\uc804\ud788 \ub178\ub3d9\uc790, \ub18d\ubbfc, \uc5ec\uc131 \ub4f1\uc5d0\uac8c\ub294 \uc120\uac70\uad8c\uc774 \uc8fc\uc5b4\uc9c0\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uad8c\uc774 \ucd5c\ucd08\ub85c \uba85\uc2dc\ub418\uc5c8\uc73c\ub098 \uc790\ubcf8\uc8fc\uc758\uc758 \uae09\uaca9\ud55c \ubc1c\uc804\uc73c\ub85c \uc778\ud574 \uc2e4\ud6a8\uc131\uc744 \uac70\ub450\uc9c0 \ubabb\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85 \uc2dc\uae30\uc5d0\ub294 \uc0ac\ud68c\uad8c\uc774\ub77c\ub294 \uac1c\ub150 \uc790\uccb4\uac00 \ud655\ub9bd\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc758\ud68c \uc911\uc2ec\uc758 \uc815\uce58 \uccb4\uc81c\ub294 \ub9cc\ub4e4\uc5b4\uc84c\uc73c\ub098 \uc655\uc758 \uad8c\ub825\uc744 \uc81c\ud55c\ud558\ub294 \ub370\uc5d0\ub294 \uc644\uc804\ud788 \uc2e4\ud328\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uba85\uc608\ud601\uba85 \ub4f1\uc744 \ud1b5\ud574 \uc655\uad8c\uc744 \uc81c\ud55c\ud558\uace0 \uc785\ud5cc \uad70\uc8fc\uc81c\ub098 \uacf5\ud654\uc815\uc774 \uc218\ub9bd\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uc81c \uc5f0\ud569(UN)\uc758 \uc8fc\ub3c4\ub85c \ubcf4\ud3b8\uc801 \uc778\uad8c \uae30\uc900\uc774 \uba85\uc2dc\ub418\uc5c8\uc73c\ub098 \uad6d\ub0b4\ubc95\uc801 \ud6a8\ub825\uc744 \uac16\uc9c0 \ubabb\ud558\uc600\ub2e4.",
          "isCorrect": false,
