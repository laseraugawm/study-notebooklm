      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac70\ub798 \ub2f9\uc0ac\uad6d \ubaa8\ub450 \uc0dd\uc0b0 \ud6a8\uc728\uc131\uc774 \ub192\uc544\uc9c0\uace0 \uc18c\ube44 \uae30\ud68c\uac00 \ud655\ub300\ub418\uc5b4 \uc0c1\ud638 \uc774\uc775\uc744 \uc5bb\ub294\ub2e4."
