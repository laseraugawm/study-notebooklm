{
  "title": "\uad6d\uc81c \uac70\ub798 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uacbd\uc744 \ub118\uc5b4 \uad6d\uac00 \uac04\uc5d0 \uc0c1\ud488, \uc11c\ube44\uc2a4, \uc0dd\uc0b0 \uc694\uc18c \ub4f1\uc744 \uac70\ub798\ud558\ub294 \uacbd\uc81c \ud65c\ub3d9\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uac70\ub798 (\ubb34\uc5ed)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c \uc8fc\uccb4\ub4e4\uc774 \uc790\uc2e0\uc5d0\uac8c \uc0c1\ub300\uc801\uc73c\ub85c \uc720\ub9ac\ud55c \uc7ac\ud654\uc640 \uc11c\ube44\uc2a4\ub9cc\uc744 \uc804\ubb38\uc801\uc73c\ub85c \uc0dd\uc0b0\ud558\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \ub098\ub77c\uac00 \ubb34\uc5ed\uc5d0 \uc720\ub9ac\ud55c \uc0c1\ud488\uc744 \ud2b9\ud654\ud558\uc5ec \uc804\ubb38\uc801\uc73c\ub85c \uc0dd\uc0b0\ud558\ub294 \uccb4\uacc4\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \ubd84\uc5c5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uac01\uad6d \uac04\uc5d0 \ubb34\uc5ed\uc774 \ubc1c\uc0dd\ud558\ub294 \uadfc\ubcf8\uc801\uc778 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\ud658\uacbd, \uc0dd\uc0b0 \uc694\uc18c\uc758 \uc591, \uae30\uc220 \uc218\uc900 \ub4f1\uc758 \ucc28\uc774\ub85c \uc778\ud574 \uc0c1\ud488 \uc0dd\uc0b0\ube44\uc5d0 \ucc28\uc774\uac00 \ubc1c\uc0dd\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790\uac00 \ubb34\uc5ed\uc744 \ud1b5\ud574 \uc5bb\uc744 \uc218 \uc788\ub294 \ub300\ud45c\uc801\uc778 \uacbd\uc81c\uc801 \uc774\uc775\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\uad6d\uc758 \uc9c8 \uc88b\uace0 \uc800\ub834\ud55c \uc81c\ud488\uc744 \uc120\ud0dd\ud560 \uc218 \uc788\uc5b4 \ud48d\uc694\ub85c\uc6b4 \uc18c\ube44 \uc0dd\ud65c\uc744 \ub204\ub9b4 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\uc790\uac00 \ubb34\uc5ed\uc744 \ud1b5\ud574 \uc5bb\uc744 \uc218 \uc788\ub294 \ub300\ud45c\uc801\uc778 \uacbd\uc81c\uc801 \uc774\uc775\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uad6d\uc5d0\uc11c \uc0dd\uc0b0\ud55c \uc81c\ud488\uc744 \uc678\uad6d\uc5d0 \ud310\ub9e4\ud558\uc5ec \ub354 \ud070 \uc774\uc724\uc744 \uc5bb\uc744 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc5ed\uc744 \ud1b5\ud574 \uc790\uad6d \ub0b4 \uc790\uc6d0\uc774 \ubd80\uc871\ud558\uac70\ub098 \uc0dd\uc0b0\ub418\uc9c0 \uc54a\ub294 \uad6d\uac00\uac00 \uc5bb\ub294 \uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uad6d\uc5d0\uc11c \ubd80\uc871\ud558\uac70\ub098 \uc804\ud600 \uc0dd\uc0b0\ub418\uc9c0 \uc54a\ub294 \ud544\uc218 \uc790\uc6d0 \ubc0f \uc0c1\ud488\uc744 \ud574\uc678\ub85c\ubd80\ud130 \ud655\ubcf4\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uad6d\uac00\uac00 \ubaa8\ub4e0 \uc0c1\ud488\uc758 \uc0dd\uc0b0\ube44 \uce21\uba74\uc5d0\uc11c \ud0c0\uad6d\ubcf4\ub2e4 \uc6b0\uc704\uc5d0 \uc788\ub354\ub77c\ub3c4 \ubb34\uc5ed\uc744 \ud574\uc57c \ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ub300\uc801\uc73c\ub85c \uae30\ud68c\ube44\uc6a9\uc774 \uc801\uc740(\ub354 \ud6a8\uc728\uc801\uc778) \ube44\uad50 \uc6b0\uc704 \uc0c1\ud488\uc744 \ud2b9\ud654\ud558\uc5ec \uad50\ud658\ud558\uba74 \uc591\uad6d \ubaa8\ub450 \uc774\uc775\uc744 \uc5bb\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud55c\ubbfc\uad6d\uc774 \uc0ac\uc6b0\ub514\uc544\ub77c\ube44\uc544\uc640\uc758 \ubb34\uc5ed\uc744 \ud1b5\ud574 \uc218\uc785\ud558\ub294 \ub300\ud45c\uc801\uc778 \uad11\ubb3c\uc131 \uc6d0\ub8cc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\uc720"
          }
        ]
