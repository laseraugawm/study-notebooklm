    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\ud654(Specialization)\uac00 \uacbd\uc81c \uc8fc\uccb4 \uc804\uccb4\uc758 \uc0dd\uc0b0\ub7c9\uc744 \ub298\ub824\uc8fc\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc774 \uac00\uc7a5 \uc798 \ub9cc\ub4e4 \uc218 \uc788\ub294 \uc0c1\ud488\uc5d0 \uc0dd\uc0b0 \uc694\uc18c\ub97c \uc9d1\uc911\ud568\uc73c\ub85c\uc368 \uc0ac\ud68c \uc804\uccb4\uc758 \uc0dd\uc0b0 \ud6a8\uc728\uc131\uc774 \uc99d\uac00\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11\uacfc \uc744\uc758 \uc0ac\ub840\uc5d0\uc11c \ubb34\uc5ed \ud6c4 \ub450 \uc0ac\ub78c \ubaa8\ub450\uc758 \ubb3c\uace0\uae30 \ubc0f \uc5f4\ub9e4 \uc18c\ube44\ub7c9\uc774 \uc99d\uac00\ud55c \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01\uc790 \ube44\uad50 \uc6b0\uc704 \uc0c1\ud488\uc5d0\ub9cc \ud2b9\ud654\ud558\uc5ec \ucd1d\uc0dd\uc0b0\ub7c9\uc744 \ub298\ub9b0 \ud6c4 \uc0c1\ud638 \uc720\ub9ac\ud55c \ube44\uc728\ub85c \uad50\ud658\ud588\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d \ubb34\uc5ed \ud611\ud68c \uc790\ub8cc \uae30\uc900, 1970\ub144\ubd80\ud130 2022\ub144\uae4c\uc9c0\uc758 \ud55c\uad6d \ubc0f \uc138\uacc4 \ubb34\uc5ed \uaddc\ubaa8 \ubcc0\ud654 \ucd94\uc774\ub294 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654 \ubc0f \uad6d\uc81c \ubd84\uc5c5\uc758 \ud655\ub300\ub85c \uc778\ud574 \ud55c\uad6d\uacfc \uc138\uacc4 \ubaa8\ub450 \ubb34\uc5ed \uaddc\ubaa8\uac00 \ud3ed\ubc1c\uc801\uc73c\ub85c \uae09\uc99d\ud558\uc600\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0 \uc694\uc18c \uc911 '\uc790\ubcf8'\uacfc '\uae30\uc220'\uc774 \ud48d\ubd80\ud55c \uc120\uc9c4\uad6d\uc774 \uc8fc\ub825\uc73c\ub85c \uc218\ucd9c\ud558\uae30\uc5d0 \uc720\ub9ac\ud55c \uc0c1\ud488 \uc720\ud615\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ubcf8 \ubc0f \uae30\uc220 \uc9d1\uc57d \uc0c1\ud488 (\uc608: \uc218\uc1a1 \uae30\uacc4, \ubc18\ub3c4\uccb4, \uc11d\uc720 \ud654\ud559 \uc81c\ud488 \ub4f1)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \uc7ac\ud654 1\ub2e8\uc704\ub97c \uc5bb\uae30 \uc704\ud574 \ud3ec\uae30\ud574\uc57c \ud558\ub294 \ub2e4\ub978 \uc7ac\ud654\uc758 \uc591\uc73c\ub85c \uacc4\uc0b0\ub418\ub294 \ube44\uc6a9\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
