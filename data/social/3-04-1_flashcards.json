    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uac04 \uad50\uc5ed\uc5d0\uc11c \uc6d0\uc720, \uae30\uacc4, \uc2dd\ud488 \ub4f1\uacfc \uac19\uc740 \ubb3c\ub9ac\uc801 \ud615\ud0dc\ub97c \uac00\uc9c4 \ubb3c\ud488\uc758 \uac70\ub798\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ubd80\ub974\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7ac\ud654(\uc0c1\ud488) \uac70\ub798"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc5ed\uc774 \uc77c\uc0c1\ud654\ub418\uba74\uc11c \uad6d\uac00 \uac04\uc758 \uad00\uacc4\ub294 \uc5b4\ub5bb\uac8c \ubcc0\ud654\ud558\uc600\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \ub098\ub77c\uc758 \uacbd\uc81c\uac00 \ub2e4\ub978 \ub098\ub77c\uc640 \uae34\ubc00\ud788 \uc5f0\uacb0\ub418\ub294 \ubc00\uc811\ud55c \uc0c1\ud638 \uc758\uc874 \uad00\uacc4\uac00 \ud615\uc131\ub418\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc678 \uc9c1\uad6c\ub97c \ud1b5\ud574 \ub2e4\ub978 \ub098\ub77c\uc758 \uc601\uc591\uc81c\ub098 \ubb3c\ud488\uc744 \uc9c1\uc811 \uc8fc\ubb38\ud558\uc5ec \ubcf5\uc6a9\ud558\ub294 \ud589\uc704\ub294 \ubb34\uc5c7\uc758 \uc0ac\ub840\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778 \uc18c\ube44 \ucc28\uc6d0\uc5d0\uc11c \uc77c\uc0c1\ud654\ub41c \ubb34\uc5ed(\uad6d\uc81c \uac70\ub798)\uc758 \uc0ac\ub840"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11\uad6d\uc774 \uc637\uacfc \uc790\ub3d9\ucc28 \ubaa8\ub450 \uc744\uad6d\ubcf4\ub2e4 \uc801\uc740 \uc0dd\uc0b0\ube44\ub85c \ub9cc\ub4e4 \uc218 \uc788\ub294 \uc0c1\ud669\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \uc9c0\uce6d\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11\uad6d\uc774 \ub450 \uc0c1\ud488 \ubaa8\ub450\uc5d0 \ub300\ud574 \uc808\ub300 \uc6b0\uc704\ub97c \uc9c0\ub2cc \uc0c1\ud669"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac11\uad6d\uc774 \ub450 \uc0c1\ud488 \ubaa8\ub450 absolute \uc6b0\uc704\uac00 \uc788\ub354\ub77c\ub3c4, \uc637\uc744 \uc790\ub3d9\ucc28\ubcf4\ub2e4 \uc0c1\ub300\uc801\uc73c\ub85c \uc801\uc740 \uc0dd\uc0b0\ube44\ub85c \ub9cc\ub4e4 \uc218 \uc788\ub2e4\uba74 \uac11\uad6d\uc774 \ud2b9\ud654\ud574\uc57c \ud560 \uc0c1\ud488\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc637 (\ube44\uad50 \uc6b0\uc704\uac00 \uc788\ub294 \uc0c1\ud488)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uad50 \uc6b0\uc704\uc5d0 \ub530\ub77c \ud2b9\ud654\uac00 \uc774\ub8e8\uc5b4\uc9c0\uae30 \uc704\ud574 \ud544\uc694\ud55c \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uad6d\uac00\uac00 \uc0c1\ub300\uc801\uc73c\ub85c \uae30\ud68c\ube44\uc6a9\uc774 \ub354 \uc801\uc740 \uc0c1\ud488\uc5d0 \uc790\uc6d0\uc744 \uc9d1\uc911\ud558\uc5ec \uc0dd\uc0b0\ud558\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c\uac00 \ubc18\ub3c4\uccb4\ub97c \ud574\uc678\uc5d0 \uc218\ucd9c\ud558\uc5ec \uc5bb\ub294 \ub300\ud45c\uc801\uc778 \uacbd\uc81c\uc801 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9ce\uc740 \uc678\ud654\ub97c \ubc8c\uc5b4\ub4e4\uc5ec \uad6d\uac00 \uacbd\uc81c \uc774\uc775\uc744 \ucc3d\ucd9c\ud55c\ub2e4."
