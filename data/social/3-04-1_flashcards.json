    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \ubd84\uc5c5\uacfc \ubb34\uc5ed\uc744 \ud1b5\ud574 \uac70\ub798 \ucc38\uc5ec\uad6d \uc804\uccb4\uac00 \uc5bb\ub294 \ucd5c\uc885\uc801\uc778 \uacbd\uc81c\uc801 \uc131\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
