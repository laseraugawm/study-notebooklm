    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\ud654 \uc804(\ubb3c\uace0\uae30 4\ub9c8\ub9ac, \uc5f4\ub9e4 6\uac1c)\uacfc \ube44\uad50\ud588\uc744 \ub54c, \uad50\ud658 \ud6c4(\ubb3c\uace0\uae30 5\ub9c8\ub9ac, \uc5f4\ub9e4 7\uac1c) \uc744\uc774 \uc5bb\uac8c \ub41c \uc21c\uc774\uc775\uc740 \uc5bc\ub9c8\uc778\uac00?"
