      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ubcf8 \ubc0f \uae30\uc220 \uc9d1\uc57d \uc0c1\ud488 (\uc608: \uc218\uc1a1 \uae30\uacc4, \uc11d\uc720 \ud654\ud559 \uc81c\ud488, \ucca0\uac15 \uc81c\ud488 \ub4f1)"
