        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc785\ud55c \uc6d0\uc720\ub97c \uc815\uc81c\ud558\uc5ec \uc790\ub3d9\ucc28\uc5d0 \uc8fc\uc720\ud558\ub294 \ud718\ubc1c\uc720\ub97c \uc5bb\ub294 \uacfc\uc815\uc740 \ubb34\uc5ed\uc758 \uc5b4\ub5a4 \ud544\uc694\uc131\uc744 \ubcf4\uc5ec\uc8fc\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ub0b4\uc5d0\uc11c \uc0dd\uc0b0\ub418\uc9c0 \uc54a\uac70\ub098 \ubd80\uc871\ud55c \uae30\ucd08 \ucc9c\uc5f0\uc790\uc6d0\uc744 \ud574\uc678 \ubb34\uc5ed\uc744 \ud1b5\ud574 \ud655\ubcf4\ud560 \ud544\uc694\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc5ed\uc774 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\uace0 \uc790\uad6d \ub0b4 \uc0dd\uc0b0\uc5d0\ub9cc \uc758\uc874\ud560 \uacbd\uc6b0 \uc18c\ube44\uc790 \uce21\uba74\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ubd88\uc774\uc775\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ud488\uc758 \uc120\ud0dd \ud3ed\uc774 \uc81c\ud55c\ub418\uace0, \uc9c8 \uc88b\uace0 \uc800\ub834\ud55c \uc678\uad6d\uc758 \uc7ac\ud654\ub97c \uc18c\ube44\ud558\uae30 \uc5b4\ub835\ub2e4."
