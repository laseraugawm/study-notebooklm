    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0 \uc694\uc18c \uc911 \ub178\ub3d9\uacfc \uc790\ubcf8\uc758 \ucc28\uc774\ub294 \uac01\uad6d\uc758 \uacbd\uc81c \ud65c\ub3d9\uacfc \ubb34\uc5ed\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \uc8fc\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\ubcc4 \uc0dd\uc0b0 \uc694\uc18c\uc758 \uc591\uacfc \uae30\uc220 \uc218\uc900\uc758 \ucc28\uc774\ub97c \uac00\uc838\uc640 \ub3d9\uc77c \uc81c\ud488 \uc0dd\uc0b0 \uc2dc \uc0dd\uc0b0\ube44\uc758 \uaca9\ucc28\ub97c \ub9cc\ub4e0\ub2e4."
