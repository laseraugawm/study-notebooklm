    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud544\ub9ac\ud540\uc0b0 \ubc14\ub098\ub098\ub098 \ucf5c\ub86c\ube44\uc544\uc0b0 \uc6d0\ub450 \ucee4\ud53c\ub97c \uad6d\ub0b4 \ub300\ud615 \ud560\uc778\uc810\uc5d0\uc11c \uc27d\uac8c \uc811\ud560 \uc218 \uc788\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4 \ubc0f \uc790\uc5f0\ud658\uacbd\uc774 \ub2e4\ub978 \uad6d\uac00\uc640\uc758 \uad6d\uc81c \uac70\ub798(\ubb34\uc5ed)\uac00 \uc77c\uc0c1\ud654\ub418\uc5c8\uae30 \ub54c\ubb38\uc774\ub2e4."
