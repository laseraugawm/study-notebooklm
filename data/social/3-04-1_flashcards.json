    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud55c\ubbfc\uad6d\uc774 \uc0ac\uc6b0\ub514\uc544\ub77c\ube44\uc544\uc5d0 \uc8fc\ub85c \uc218\ucd9c\ud558\ub294 \uc0c1\ud488 \uc720\ud615 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
