{
  "title": "\uc815\uc758 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub3d9\uc11c\uc591 \uc0ac\uc0c1\uac00\ub4e4\uc774 \uc81c\uc2dc\ud55c \uc815\uc758\uc758 \uc758\ubbf8\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub9f9\uc790\ub294 \uc0ac\uc801 \uc774\uc775\uc744 \uadf9\ub300\ud654\ud558\uc5ec \uc0ac\ud68c \uc804\uccb4\uc758 \ubd80\ub97c \ub298\ub9ac\ub294 \uac83\uc744 \uc815\uc758\ub77c\uace0 \ubcf4\uc558\ub2e4.",
          "rationale": "\ub9f9\uc790\ub294 \uc774\uc775\uc5d0 \uc9d1\ucc29\ud558\uc9c0 \uc54a\uace0 \uc798\ubabb\uc744 \ubd80\ub044\ub7ec\uc6cc\ud558\ub294 \uc62c\uace7\uc74c\uc744 \uc815\uc758\ub85c \ubcf4\uc558\uc73c\uba70, \uc0ac\uc801 \uc774\uc775 \ucd94\uad6c\uc640 \uc815\uc758\ub294 \uad6c\ubd84\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud50c\ub77c\ud1a4\uc740 \uac01\uc790\uac00 \ud0c0\uace0\ub09c \uc131\ud5a5\uc5d0 \ub530\ub77c \uc790\uc2e0\uc758 \uc5ed\ud560\uacfc \uc77c\uc744 \ub2e4\ud558\ub294 \uac83\uc744 \uc815\uc758\ub77c\uace0 \ubcf4\uc558\ub2e4.",
          "rationale": "\ud50c\ub77c\ud1a4\uc740 \uc0ac\ud68c \uad6c\uc131\uc6d0\uc774 \uac01\uc790\uc758 \ud0c0\uace0\ub09c \uc131\ud5a5\uc5d0 \ub9de\ucd94\uc5b4 \ub9e1\uc740 \ubc14 \uc9c1\ubd84\uc744 \ucda9\uc2e4\ud788 \uc218\ud589\ud558\ub294 \uc0c1\ud0dc\ub97c \uc815\uc758\ub85c \uaddc\uc815\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\ub294 \ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \uc870\uac74\uacfc \uc0c1\uad00\uc5c6\uc774 \uc5b8\uc81c\ub098 \uc644\uc804\ud788 \ub3d9\uc77c\ud55c \uc591\uc758 \ubaab\uc744 \uc8fc\ub294 \uac83\uc774 \uc815\uc758\ub77c\uace0 \ubcf4\uc558\ub2e4.",
          "rationale": "\uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\ub294 \uc808\ub300\uc801 \ud3c9\ub4f1\uc774 \uc544\ub2cc, \ub3d9\ub4f1\ud55c \uc790\uc5d0\uac8c\ub294 \ub3d9\ub4f1\ud55c \ubaab\uc744, \ub3d9\ub4f1\ud558\uc9c0 \uc54a\uc740 \uc790\uc5d0\uac8c\ub294 \ub3d9\ub4f1\ud558\uc9c0 \uc54a\uc740 \ubaab\uc744 \uc8fc\ub294 \ube44\ub840\uc801 \ud3c9\ub4f1\uc744 \uac15\uc870\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3d9\uc591 \uc0ac\uc0c1\uac00\ub4e4\uc740 \ub300\uccb4\ub85c \uac01\uc790\uac00 \ub9e1\uc740 \uae30\ub2a5\uc801 \ubaab\uacfc \uacc4\uae09\uc801 \uad8c\ub9ac\ub97c \uba85\ud655\ud788 \uacc4\uc0b0\ud558\ub294 \uac83\uc5d0 \uc815\uc758\uc758 \uc911\uc810\uc744 \ub450\uc5c8\ub2e4.",
          "rationale": "\ub3d9\uc591 \uc0ac\uc0c1\uac00\ub4e4\uc740 \uacc4\uae09\uc801 \uacc4\uc0b0\ubcf4\ub2e4\ub294 \uc62c\ubc14\ub978 \ud589\ub3d9\uc744 \ud558\uac70\ub098 \uc0ac\uc801 \uc774\uc775 \ubc0f \uacb0\uacfc\uc5d0 \uc5bd\ub9e4\uc774\uc9c0 \uc54a\ub294 \ub0b4\uba74\uc801 \ub3c4\ub355\uc131\uacfc \uc62c\uace7\uc74c\uc5d0 \uc911\uc810\uc744 \ub450\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc11c\uc591 \uc0ac\uc0c1\uac00 \uc911 \ud55c \uba85\uc740 \uac1c\uc778\uc758 \ud0c0\uace0\ub09c \uc131\ud5a5\uacfc \uc0ac\ud68c\uc801 \uc9c1\ubd84\uc758 \uc218\ud589\uc744 \uc5f0\uad00 \uc9c0\uc5b4 \uc815\uc758\ub97c \uc124\uba85\ud588\uc2b5\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc815\uc758\uc758 \uc5ec\uc2e0\uc0c1(Justitia)\uc774 \ud55c \uc190\uc5d0\ub294 \uc800\uc6b8, \ub2e4\ub978 \ud55c \uc190\uc5d0\ub294 \uce7c\uc744 \ub4e4\uace0 \uc788\ub294 \uc774\uc720\ub97c \uc815\uc758\uc758 \uc758\ubbf8\uc640 \uc5f0\uacb0\ud558\uc5ec \uac00\uc7a5 \uc798 \uc124\uba85\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc800\uc6b8\uc740 \ubc95\uc744 \uc9d1\ud589\ud558\ub294 \uad6d\uac00 \uad8c\ub825\uc744, \uce7c\uc740 \uc0ac\ud68c\uc801 \uc790\uc6d0\uc758 \uc218\ub7c9\uc744 \uce21\uc815\uc744 \uc0c1\uc9d5\ud55c\ub2e4.",
          "rationale": "\uc800\uc6b8\uc740 \uc5b4\ub290 \ud55c\ucabd\uc5d0 \uce58\uc6b0\uce58\uc9c0 \uc54a\ub294 \uacf5\uc815\ud55c \ud310\ub2e8\uc744 \uc758\ubbf8\ud558\uba70, \uce7c\uc740 \uc704\ubc95 \ud589\uc704\uc5d0 \ub300\ud55c \uc5c4\uc815\ud55c \uc81c\uc7ac\ub97c \uc0c1\uc9d5\ud558\ubbc0\ub85c \uc124\uba85\uc774 \uc11c\ub85c \ubc14\ub00c\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc800\uc6b8\uc740 \uacf5\ud3c9\ud558\uace0 \uacf5\uc815\ud55c \ud310\ub2e8\uc744 \uc758\ubbf8\ud558\uba70, \uce7c\uc740 \ubd88\uacf5\uc815\ud55c \ud589\uc704\ub098 \uc798\ubabb\uc5d0 \ub300\ud55c \uac15\ub825\ud55c \uc81c\uc7ac\ub97c \uc758\ubbf8\ud55c\ub2e4.",
          "rationale": "\uc800\uc6b8\uc740 \ubd84\ubc30\ub098 \ud310\uacb0\uc5d0\uc11c\uc758 \uc5c4\uc815\ud55c \uacf5\uc815\uc131\uc744, \uce7c\uc740 \uc815\uc758\ub97c \uc2e4\ud604\ud558\uae30 \uc704\ud55c \uac15\uc81c\ub825\uacfc \ucc98\ubc8c\uc744 \ub300\ubcc0\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc800\uc6b8\uc740 \uac1c\uc778\uc758 \uc0ac\ub9ac\uc0ac\uc695\uc744 \ucd94\uad6c\ud558\ub294 \uae30\uc900\uc744, \uce7c\uc740 \uc62c\ubc14\ub978 \ud589\ub3d9\uc744 \uc120\ubc1c\ud558\ub294 \uae30\uc900\uc744 \uc0c1\uc9d5\ud55c\ub2e4.",
          "rationale": "\uc815\uc758\uc758 \uc5ec\uc2e0\uc0c1\uc5d0 \ud3ec\ud568\ub41c \ub450 \uc0c1\uc9d5\ubb3c\uc740 \uac1c\uc778\uc758 \uc0ac\ub9ac\uc0ac\uc695 \ucd94\uad6c\uac00 \uc544\ub2cc \uacf5\uc801 \ud310\ub2e8\uacfc \uc5c4\uc815\ud55c \ubc95 \uc9d1\ud589\uc744 \uc0c1\uc9d5\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc800\uc6b8\uc740 \uad50\uc815\uc801 \uc815\uc758\ub9cc\uc744 \uc0c1\uc9d5\ud558\uace0, \uce7c\uc740 \ubd84\ubc30\uc801 \uc815\uc758\ub9cc\uc744 \uc0c1\uc9d5\ud558\uc5ec \ub450 \uc601\uc5ed\uc758 \uc644\uc804\ud55c \ubd84\ub9ac\ub97c \ub73b\ud55c\ub2e4.",
          "rationale": "\uc800\uc6b8\uacfc \uce7c\uc740 \ubd84\ubc30\uc640 \uad50\uc815\uc758 \uc601\ud1a0\ub97c \uc5c4\uaca9\ud788 \ubd84\ub9ac\ud558\uae30 \uc704\ud55c \uac83\uc774 \uc544\ub2c8\ub77c \ud310\ub2e8\uc758 \uacf5\uc815\uc131\uacfc \uc9d1\ud589\uc758 \uc5c4\uc815\ud568\uc744 \ud55c\ub370 \ub098\ud0c0\ub0b4\ub294 \uc7a5\uce58\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc800\uc6b8\uc740 \uc591\uce21\uc758 \uade0\ud615\uacfc \uacf5\ud3c9\ud568\uc744, \uce7c\uc740 \ud310\uacb0\uc744 \uc774\ud589\ud558\uace0 \uc704\ubc95\uc744 \ubc14\ub85c\uc7a1\ub294 \uad8c\ub825\uc744 \uc0c1\uc9d5\ud569\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc815\uc758\uc758 \uad6c\ubcc4 \uc720\ud615\uc778 '\ubd84\ubc30\uc801 \uc815\uc758'\uc640 '\uad50\uc815\uc801 \uc815\uc758'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubd84\ubc30\uc801 \uc815\uc758\ub294 \ubd88\uacf5\uc815\ud55c \ud589\uc704\ub098 \uc798\ubabb\ub41c \ud589\ub3d9\uc744 \ubc14\ub85c\uc7a1\ub294 \uc6d0\uce59\uc774\ub2e4.",
          "rationale": "\uc798\ubabb\ub41c \ud589\ub3d9\uc774\ub098 \uc704\ubc95 \ud589\uc704\ub97c \ubc14\ub85c\uc7a1\uace0 \ucc98\ubc8c\ud558\ub294 \uac83\uc740 \uad50\uc815\uc801 \uc815\uc758\uc758 \uc601\uc5ed\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad50\uc815\uc801 \uc815\uc758\ub294 \uac01 \uac1c\uc778\uc774 \ubc1b\uc544\uc57c \ud560 \uc0ac\ud68c\uc801 \uc790\uc6d0\uc758 \uacf5\uc815\ud55c \ubaab\uc744 \uc815\ud558\ub294 \uc6d0\uce59\uc774\ub2e4.",
          "rationale": "\uc0ac\ud68c\uc801 \uc790\uc6d0\uc744 \uacf5\uc815\ud558\uac8c \ubc30\ubd84\ud558\ub294 \uc6d0\uce59\uc740 \ubd84\ubc30\uc801 \uc815\uc758\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubd84\ubc30\uc801 \uc815\uc758\ub294 \uac01\uc790\uac00 \ubc1b\uc544\uc57c \ud560 \ubaab\uc744 \uacf5\uc815\ud558\uac8c \ub098\ub204\ub294 \uac83\uc774\uba70, \uad50\uc815\uc801 \uc815\uc758\ub294 \uc798\ubabb\uc5d0 \ub300\ud55c \ub300\uc751\uc774 \uacf5\uc815\ud55c\uc9c0\ub97c \ub2e4\ub8ec\ub2e4.",
          "rationale": "\ubd84\ubc30\uc801 \uc815\uc758\ub294 \uc790\uc6d0 \ubc0f \uad8c\ub9ac\uc758 \uacf5\uc815\ud55c \ubc30\ubd84\uc744, \uad50\uc815\uc801 \uc815\uc758\ub294 \ubd88\ubc95\uc774\ub098 \ud574\uc545\uc5d0 \ub300\ud55c \ubd80\uc751 \ubc0f \uc6d0\uc0c1\ubcf5\uad6c\ub97c \ub2e4\ub8f9\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uad50\uc815\uc801 \uc815\uc758\uac00 \uc2e4\ud604\ub418\uba74 \uc0ac\ud68c\uc801 \uc790\uc6d0\uc758 \ud76c\uc18c\uc131\uc774 \uc644\uc804\ud788 \ud574\uc18c\ub418\ubbc0\ub85c \ubd84\ubc30\uc801 \uc815\uc758\ub294 \ubd88\ud544\uc694\ud574\uc9c4\ub2e4.",
          "rationale": "\uad50\uc815\uc801 \uc815\uc758\uc640 \ubd84\ubc30\uc801 \uc815\uc758\ub294 \uc11c\ub85c \ub2e4\ub978 \uc0ac\ud68c\uc801 \uc601\uc5ed\uc744 \ub2e4\ub8e8\ub294 \ubcf4\uc644\uc801 \uad00\uacc4\uc774\uba70 \uc790\uc6d0\uc758 \ud76c\uc18c\uc131 \uc790\uccb4\ub97c \uc5c6\uc560\uc9c0\ub294 \ubabb\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ud558\ub098\ub294 \uc790\uc6d0\uc758 \uacf5\uc815\ud55c \ubaab \ubc30\ubd84\uc5d0 \uad00\ud55c \uac83\uc774\uace0, \ub2e4\ub978 \ud558\ub098\ub294 \ubd88\ubc95 \ubc0f \uc798\ubabb\uc758 \uad50\uc815\uacfc \ucc98\ubc8c\uc5d0 \uad00\ud55c \uac83\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\uac00 \uc81c\uc2dc\ud55c \uc815\uc758\uad00\uc758 \ud575\uc2ec \ub0b4\uc6a9\uc744 \uc62c\ubc14\ub974\uac8c \ud30c\uc545\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \uc870\uac74\uc774\ub098 \uc2e0\ubd84\uc5d0 \uc0c1\uad00\uc5c6\uc774 \ubb34\uc870\uac74 \uc808\ub300\uc801\uc73c\ub85c \ub3d9\uc77c\ud55c \uc790\uc6d0\uc744 \ubd80\uc5ec\ud574\uc57c \ud55c\ub2e4.",
          "rationale": "\uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\ub294 \uc808\ub300\uc801 \uc218\uce58\uc758 \ub3d9\uc77c\ud568\uc774 \uc544\ub2c8\ub77c \uac01\uc790\uc758 \uac00\uce58\ub098 \ub3d9\ub4f1\uc131\uc5d0 \uc0c1\uc751\ud558\ub294 \ube44\ub840\uc801 \ud3c9\ub4f1\uc744 \uc8fc\uc7a5\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3d9\ub4f1\ud55c \uc704\uce58\uc5d0 \uc788\ub294 \uc0ac\ub78c\uc5d0\uac8c\ub294 \ub3d9\ub4f1\ud55c \ubaab\uc744, \ub3d9\ub4f1\ud558\uc9c0 \uc54a\uc740 \uc704\uce58\uc5d0 \uc788\ub294 \uc0ac\ub78c\uc5d0\uac8c\ub294 \ub3d9\ub4f1\ud558\uc9c0 \uc54a\uc740 \ubaab\uc744 \uc8fc\uc5b4\uc57c \ud55c\ub2e4.",
          "rationale": "\uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\uc758 \uc815\uc758\uad00\uc740 \uac01\uc790\uc758 \uc870\uac74\uacfc \uac00\uce58\uc5d0 \ub9de\uac8c \ubaab\uc744 \ubd80\uc5ec\ud558\ub294 \uc0c1\ub300\uc801\u00b7\ube44\ub840\uc801 \ud3c9\ub4f1\uc744 \ud575\uc2ec\uc73c\ub85c \ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc790\uc2e0\uc758 \uc798\ubabb\uc744 \ubd80\ub044\ub7ec\uc6cc\ud558\uace0 \uc0ac\uc801\uc778 \uc774\uc775\uc774\ub098 \uacb0\uacfc\uc5d0 \uc9d1\ucc29\ud558\uc9c0 \uc54a\ub294 \ub9c8\uc74c\uac00\uc9d0\uc744 \uac00\uc838\uc57c \ud55c\ub2e4.",
          "rationale": "\uc798\ubabb\uc744 \ubd80\ub044\ub7ec\uc6cc\ud558\ub294 \uc218\uc624\uc9c0\uc2ec\uacfc \uc0ac\ub9ac\uc0ac\uc695 \ubc30\uc81c\ub294 \ub9f9\uc790\ub97c \ube44\ub86f\ud55c \uc720\uad50 \uc0ac\uc0c1\uac00\ub4e4\uc758 \uc815\uc758\uad00\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac01\uc790\uac00 \ud0c0\uace0\ub09c \uc131\ud5a5\uc5d0 \ub530\ub77c \uacc4\uae09\uc744 \ubd80\uc5ec\ubc1b\uace0 \uadf8 \uace0\uc720 \uc5c5\ubb34\uc5d0\ub9cc \ud3c9\uc0dd \uc804\ub150\ud574\uc57c \ud55c\ub2e4.",
          "rationale": "\ud0c0\uace0\ub09c \uc131\ud5a5\uc5d0 \ub530\ub978 \uc9c1\ubd84 \ucda9\uc2e4\uc744 \uac15\uc870\ud55c \uac83\uc740 \ud50c\ub77c\ud1a4\uc758 \uc815\uc758\uad00\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc870\uac74\uacfc \uac00\uce58\uc758 \ub3d9\ub4f1 \uc5ec\ubd80\uc5d0 \ub530\ub978 \ube44\ub840\uc801 \ubc30\ubd84\uc744 \uc5b8\uae09\ud55c \uc0ac\uc0c1\uac00\uc758 \uacac\ud574\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "20\uc138\uae30 \ud6c4\ubc18\uae4c\uc9c0 \ub0a8\uc544\ud504\ub9ac\uce74 \uacf5\ud654\uad6d\uc5d0\uc11c \uc2dc\ud589\ub418\uc5c8\ub358 \uc778\uc885 \ubd84\ub9ac \uc815\ucc45(\uc544\ud30c\ub974\ud2b8\ud5e4\uc774\ud2b8) \uc0ac\ub840\uac00 \uc2dc\uc0ac\ud558\ub294 \ubc14\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc815\ub2f9\ud55c \uc774\uc720 \uc5c6\uc774 \ud53c\ubd80\uc0c9\uc774\ub098 \uc778\uc885\uc744 \uc774\uc720\ub85c \ucc28\ubcc4\ud558\ub294 \uc0ac\ud68c\uc5d0\uc11c\ub294 \uc778\uac04\uc758 \uc874\uc5c4\uc131\uc774 \uc720\uc9c0\ub418\uae30 \uc5b4\ub835\ub2e4.",
          "rationale": "\uc544\ud30c\ub974\ud2b8\ud5e4\uc774\ud2b8\ub294 \ubd80\ub2f9\ud55c \ucc28\ubcc4\uc774 \uc778\uac04 \uc874\uc5c4\uc131\uc744 \uc2ec\uac01\ud558\uac8c \ud6fc\uc190\ud568\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ub300\ud45c\uc801 \uc0ac\ub840\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uae30\ubcf8\uc801 \uad8c\ub9ac\uac00 \uc5b5\uc555\ub2f9\ud558\ub294 \ubd88\uc758\ud55c \uc0ac\ud68c\uc5d0\uc11c\ub294 \uc0ac\ud68c \uad6c\uc131\uc6d0\uc774 \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc744 \uc601\uc704\ud560 \uc218 \uc5c6\ub2e4.",
          "rationale": "\ud751\uc778\ub4e4\uc758 \uc9c1\uc5c5\uacfc \uacb0\ud63c, \uc2dc\uc124 \uc774\uc6a9\uc744 \uc81c\ud55c\ud55c \uac83\uc740 \uae30\ubcf8\uad8c\uacfc \uc778\uac04\ub2e4\uc6b4 \uc0b6\uc744 \ubc15\ud0c8\ud55c \ubd80\ub2f9\ud55c \ubd88\uc758\uc600\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc778\uc885\uc5d0 \ub530\ub77c \uc0dd\ud65c\uacf5\uac04\uc774\ub098 \uacf5\uacf5\uc2dc\uc124 \uc774\uc6a9\uc744 \uc81c\ud55c\ud558\ub294 \uc81c\ub3c4\ub294 \uad50\uc815\uc801 \uc815\uc758\uc758 \uc6d0\uce59\uc5d0 \ubd80\ud569\ud55c\ub2e4.",
          "rationale": "\uc815\ub2f9\ud55c \uc774\uc720 \uc5c6\ub294 \uc778\uc885 \ucc28\ubcc4 \uc81c\ub3c4\ub294 \ubd84\ubc30\uc801\u00b7\uad50\uc815\uc801 \uc815\uc758 \uc5b4\ub514\uc5d0\ub3c4 \ubd80\ud569\ud558\uc9c0 \uc54a\uc73c\uba70 \uc815\uc758\uc758 \uc6d0\ub9ac\ub97c \uc815\uba74\uc73c\ub85c \uc704\ubc30\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\uac00 \uad6c\ucd95\ub418\uc5b4\uc57c\ub9cc \uac1c\uc778\ub4e4\uc774 \ucc28\ubcc4 \uc5c6\uc774 \uacf5\uc815\ud55c \uae30\uc900\uc5d0 \ub530\ub77c \uc790\uc2e0\uc758 \ubaab\uc744 \ubc1b\uc744 \uc218 \uc788\ub2e4.",
          "rationale": "\uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\uc5d0\uc11c\ub294 \uc778\uc885, \uc131\ubcc4 \ub4f1\uc5d0 \ub530\ub978 \ucc28\ubcc4 \uc5c6\uc774 \uc815\ub2f9\ud55c \uae30\uc900\uc5d0 \ub530\ub77c \uad8c\ub9ac\uc640 \ubaab\uc774 \ubcf4\uc7a5\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc815\ub2f9\ud55c \uc774\uc720\uac00 \uc5c6\ub294 \uc778\uc885 \ucc28\ubcc4 \uc815\ucc45\uc774 \uc815\uc758\uc758 \uc6d0\uce59\uc774\ub098 \uad50\uc815\uc801 \uc815\uc758\uc5d0 \ubd80\ud569\ud560 \uc218 \uc788\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc6b0\ub9ac \uc0ac\ud68c\uc5d0 \uc815\uc758\uac00 \ud655\ub9bd\ub418\uc5c8\uc744 \ub54c \ub098\ud0c0\ub098\ub294 \ud604\uc0c1 \ubc0f \ud544\uc694\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ud68c \uad6c\uc131\uc6d0\ub4e4\uc774 \uc131\ubcc4\uc774\ub098 \uc778\uc885, \uc0ac\ud68c\u00b7\uacbd\uc81c\uc801 \uc9c0\uc704\uc5d0 \uc0c1\uad00\uc5c6\uc774 \uacf5\uc815\ud55c \ub300\uc6b0\ub97c \ubc1b\uac8c \ub41c\ub2e4.",
          "rationale": "\uc815\uc758\ub85c\uc6b4 \uc0ac\ud68c\uc5d0\uc11c\ub294 \ucc28\ubcc4 \uc5c6\uc774 \uacf5\uc815\ud55c \uc808\ucc28\uc640 \uae30\uc900\uc5d0 \uc758\ud574 \uad6c\uc131\uc6d0\uc774 \ub300\uc6b0\ubc1b\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc704\ubc95 \ud589\uc704\uc5d0 \ub300\ud55c \uacf5\uc815\ud55c \ubc95 \uc9d1\ud589\uacfc \uc801\uc808\ud55c \ucc98\ubc8c\uc774 \uc774\ub8e8\uc5b4\uc838 \uad6c\uc131\uc6d0 \uac04\uc758 \uc2e0\ub8b0\uac00 \ud615\uc131\ub41c\ub2e4.",
          "rationale": "\uacf5\uc815\ud55c \ucc98\ubc8c\uacfc \ubc95 \uc9d1\ud589\uc740 \uad6c\uc131\uc6d0 \uac04 \uc2e0\ub8b0\ub97c \uad6c\ucd95\ud558\uace0 \uc0ac\ud68c \uc9c8\uc11c\ub97c \uc720\uc9c0\ud558\ub294 \uae30\ubc18\uc774 \ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad6c\uc131\uc6d0 \uac04 \uc2e0\ub8b0\uc640 \ud611\ub825\uc774 \ubc14\ud0d5\uc774 \ub418\uc5b4 \uc0ac\ud68c\uac00 \ud1b5\ud569\ub418\uace0 \uc9c0\uc18d\uc801\uc73c\ub85c \ubc1c\uc804\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\uc815\uc758\uc758 \uc2e4\ud604\uc740 \uc2e0\ub8b0 \uad6c\ucd95\uc744 \ud1b5\ud574 \uc0ac\ud68c \ud1b5\ud569\uacfc \ubc1c\uc804\uc744 \uc774\ub044\ub294 \ud544\uc218 \uc6d0\ub3d9\ub825\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubaa8\ub4e0 \uad6c\uc131\uc6d0\uc5d0\uac8c \uc815\uc758\ub85c\uc6b4 \uae30\uc900\uc744 \uc801\uc6a9\ud558\uba74 \uc0ac\ud68c\uc801 \ud76c\uc18c \uc790\uc6d0\uc744 \ub458\ub7ec\uc2fc \ubaa8\ub4e0 \uac08\ub4f1\uc774 \uc644\ubcbd\ud558\uac8c \uc18c\uba78\ud55c\ub2e4.",
          "rationale": "\uc815\uc758\uac00 \ud655\ub9bd\ub418\uba74 \uac08\ub4f1\uc744 \uacf5\uc815\ud558\uac8c \ud574\uacb0\ud558\ub294 \uae30\uc900\uc774 \ub9c8\ub828\ub418\ub294 \uac83\uc774\uc9c0, \uc790\uc6d0\uc758 \ud76c\uc18c\uc131\uc774\ub098 \uc778\uac04 \uc0ac\uc774\uc758 \ubaa8\ub4e0 \uac08\ub4f1 \uc790\uccb4\uac00 \ubb3c\ub9ac\uc801\uc73c\ub85c \uc18c\uba78\ud558\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\uc815\uc758\uc758 \ud655\ub9bd\uc774 \uc0ac\ud68c \ud1b5\ud569\uc5d0 \uae30\uc5ec\ud558\uc9c0\ub9cc, \ud604\uc2e4\uc5d0\uc11c \uc0ac\ud68c\uc801 \ud76c\uc18c\uc131\uacfc \uc758\uacac \ucc28\uc774\ub85c \uc778\ud55c \ubaa8\ub4e0 \uac08\ub4f1\uc744 '\uc644\ubcbd\ud788 \uc18c\uba78'\uc2dc\ud0ac \uc218 \uc788\ub294\uc9c0\ub294 \uc2e0\uc911\ud788 \ud310\ub2e8\ud574\uc57c \ud569\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc0c1\ud669\uc744 \ud1b5\ud574 \ud30c\uc545\ud560 \uc218 \uc788\ub294 \uacf5\uc815\uc131 \ud655\ubcf4\uc758 \uc8fc\uc694 \uc6d0\ub9ac\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n\uc5ec\ub7ec \uc0ac\ub78c\uc774 \ud558\ub098\uc758 \ucf00\uc774\ud06c\ub97c \uacf5\uc815\ud558\uac8c \ub098\ub204\ub824\uace0 \ud560 \ub54c, \ud55c \uc0ac\ub78c\uc774 \ucf00\uc774\ud06c\ub97c \uc790\ub974\uace0 \ub098\uba38\uc9c0 \uc0ac\ub78c\ub4e4\uc774 \uadf8 \uc0ac\ub78c\ubcf4\ub2e4 \uba3c\uc800 \ucf00\uc774\ud06c\ub97c \uac00\uc838\uac00\ub3c4\ub85d \uaddc\uce59\uc744 \uc815\ud558\uc600\ub2e4. \uadf8 \uacb0\uacfc \ucf00\uc774\ud06c\ub97c \uc790\ub974\ub294 \uc0ac\ub78c\uc740 \uc790\uc2e0\uc758 \ubaab\uc744 \uc190\ud574 \ubcf4\uc9c0 \uc54a\uae30 \uc704\ud574 \uc815\ud655\ud788 \uade0\ub4f1\ud558\uac8c \ub098\ub204\uc5c8\ub2e4.",
      "answerOptions": [
        {
          "text": "\uacb0\uacfc\uc758 \uc218\uc6a9\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574\uc11c\ub294 \uad8c\ub825\uc790\uc758 \ud310\ub2e8\uc5d0 \ubb34\uc870\uac74\uc801\uc73c\ub85c \ubcf5\uc885\ud558\ub294 \ud0dc\ub3c4\uac00 \ud544\uc694\ud558\ub2e4.",
          "rationale": "\uc81c\uc2dc\ubb38\uc740 \uad8c\ub825\uc5d0\uc758 \ubcf5\uc885\uc774 \uc544\ub2cc \uacf5\uc815\ud55c \uc808\ucc28 \uc124\uc815\uc744 \ud1b5\ud574 \uade0\ub4f1\ud55c \uacb0\uacfc\ub97c \ub3c4\ucd9c\ud55c \uc0ac\ub840\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub2f9\uc0ac\uc790\ub4e4\uc758 \uc0ac\uc801\uc778 \uc774\uc775 \ucd94\uad6c\ub97c \uc6d0\ucc9c \uae08\uc9c0\ud574\uc57c\ub9cc \uc815\uc758\ub85c\uc6b4 \uacb0\uacfc\uc5d0 \ub3c4\ub2ec\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\uc774 \ubc29\uc2dd\uc740 \uc0ac\ub9ac\uc0ac\uc695\uc744 \uae08\uc9c0\ud55c \uac83\uc774 \uc544\ub2c8\ub77c, \uc790\ub974\ub294 \uc0ac\ub78c\uc758 \uc0ac\ub9ac\uc0ac\uc695(\uc190\ud574\ubcf4\uc9c0 \uc54a\uc73c\ub824\ub294 \ub9c8\uc74c)\uc744 \uc774\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uacf5\uc815\ud55c \uc808\ucc28\ub97c \uc124\uacc4\ud55c \uac83\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uacf5\uc815\ud55c \ubd84\ubc30 \uacb0\uacfc\ub97c \ub3c4\ucd9c\ud558\uae30 \uc704\ud574\uc11c\ub294 \uacf5\uc815\ud55c \uc808\ucc28\uc640 \uaddc\uce59\uc744 \ub9c8\ub828\ud558\ub294 \uac83\uc774 \uc911\uc694\ud558\ub2e4.",
          "rationale": "\uc790\ub974\ub294 \uc790\uac00 \ub098\uc911\uc5d0 \uc120\ud0dd\ud558\uac8c \ud558\ub294 '\uacf5\uc815\ud55c \uc808\ucc28'\ub97c \uc815\ud568\uc73c\ub85c\uc368 \uc790\ubc1c\uc801\uc73c\ub85c \uade0\ub4f1\ud55c \ubd84\ubc30 \uacb0\uacfc\ub97c \ub9cc\ub4e4\uc5b4 \ub0c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc790\uc6d0\uc744 \ubd84\ubc30\ud560 \ub54c\uc5d0\ub294 \uac1c\uc778\uc758 \ud0c0\uace0\ub09c \uc131\ud5a5\uacfc \uc2e0\ubd84 \ucc28\uc774\uc5d0 \ub9de\ucdb0 \ube44\uc728\uc744 \uc815\ud574\uc57c \ud55c\ub2e4.",
          "rationale": "\uc81c\uc2dc\ubb38\uc740 \ucf00\uc774\ud06c\ub77c\ub294 \uc790\uc6d0\uc744 \uade0\ub4f1\ud558\uac8c \ub098\ub204\uae30 \uc704\ud55c \uc808\ucc28\uc801 \uacf5\uc815\uc131\uc5d0 \uad00\ud55c \uc774\uc57c\uae30\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc790\ub974\ub294 \uc0ac\ub78c\uc774 \ub098\uc911\uc5d0 \uc120\ud0dd\uad8c\uc744 \uac00\uc9d0\uc73c\ub85c\uc368 \uc2a4\uc2a4\ub85c \uacf5\uc815\ud558\uac8c \ub098\ub204\uac8c \ub9cc\ub4dc\ub294 '\uaddc\uce59/\uc808\ucc28'\uc758 \ud6a8\uacfc\ub97c \uace0\ub824\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc0ac\ub840\uac00 \uc2dc\uc0ac\ud558\ub294 \uc815\uc758\uc758 \ud544\uc694\uc131 \ubc0f \ubc95 \uc801\uc6a9\uc758 \uc6d0\uce59\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n\uc601\uad6d\uc758 \ucc98\uce60 \uc218\uc0c1\uc774 \uad6d\ud68c \uc5f0\uc124 \uc2dc\uac04\uc5d0 \ub2a6\uc5b4 \uc6b4\uc804\uae30\uc0ac\uc5d0\uac8c \uc18d\ub3c4\ub97c \ub192\uc774\ub77c\uace0 \uc9c0\uc2dc\ud558\uc5ec \uc2e0\ud638 \uc704\ubc18\uc73c\ub85c \ub2e8\uc18d\ub418\uc5c8\ub2e4. \uc6b4\uc804\uae30\uc0ac\uac00 \uc218\uc0c1\uc774 \ud0c0\uace0 \uc788\uc74c\uc744 \ubc1d\ud614\uc73c\ub098, \uad50\ud1b5\uacbd\ucc30\uc740 \uc608\uc678 \uc5c6\uc774 \uc2e0\ud638 \uc704\ubc18\uc5d0 \ub300\ud55c \ubc94\uce59\uae08\uc744 \ubd80\uacfc\ud558\uc600\ub2e4.",
      "answerOptions": [
        {
          "text": "\uad6d\uac00\uc758 \uacf5\uc801\uc778 \uae34\uae09 \uc5c5\ubb34\ub97c \uc218\ud589\ud560 \ub54c \ubc1c\uc0dd\ud558\ub294 \uc704\ubc95 \ud589\uc704\ub294 \ubc95 \uc9d1\ud589 \ub300\uc0c1\uc5d0\uc11c \uc644\uc804\ud788 \uc81c\uc678\ub418\uc5b4\uc57c \ud55c\ub2e4.",
          "rationale": "\uc81c\uc2dc\ubb38\uc5d0\uc11c\ub294 \uc544\ubb34\ub9ac \ub192\uc740 \uc9c0\uc704\ub098 \uae34\uae09\ud55c \uc0ac\uc720\uac00 \uc788\ub354\ub77c\ub3c4 \ubc95 \uc9d1\ud589\uc5d0 \uc608\uc678\uac00 \uc5c6\uc74c\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubc95\uc774 \ub204\uad6c\uc5d0\uac8c\ub098 \uacf5\uc815\ud558\uace0 \uc5c4\uc815\ud558\uac8c \uc9d1\ud589\ub420 \ub54c \ubc95\uacfc \uc0ac\ud68c\uc5d0 \ub300\ud55c \uad6c\uc131\uc6d0\ub4e4\uc758 \uc2e0\ub8b0\uac00 \uc720\uc9c0\ub41c\ub2e4.",
          "rationale": "\uc218\uc0c1\uacfc \uac19\uc740 \uace0\uc704 \uacf5\uc9c1\uc790\uc5d0\uac8c\ub3c4 \uc608\uc678 \uc5c6\uc774 \ubc95\uc744 \uc801\uc6a9\ud558\ub294 \uc5c4\uc815\ud55c \ubc95 \uc9d1\ud589\uc774 \uc0ac\ud68c\uc801 \uc2e0\ub8b0\uc758 \ubc14\ud0d5\uc774 \ub428\uc744 \uc77c\uae68\uc6cc \uc90d\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uacf5\uc9c1\uc790\uc758 \uc2e0\ubd84\uacfc \uad8c\ub825\uc5d0 \ub9de\ucd94\uc5b4 \ucc98\ubc8c\uc758 \uc218\uc704\ub97c \ucc28\ub4f1\ud558\uc5ec \ub298\ub9ac\ub294 \uac83\uc774 \uad50\uc815\uc801 \uc815\uc758\uc758 \ud575\uc2ec\uc774\ub2e4.",
          "rationale": "\uad50\uc815\uc801 \uc815\uc758 \ubc0f \uacf5\uc815\ud55c \ubc95 \uc9d1\ud589\uc740 \uc9c0\uc704\uc5d0 \uc0c1\uad00\uc5c6\uc774 \uc704\ubc95 \ud589\uc704 \uc790\uccb4\uc5d0 \ub300\ud574 \uc5c4\uc815\ud558\uace0 \ud615\ud3c9\uc131 \uc788\uac8c \ubc95\uc744 \uc801\uc6a9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0ac\ud68c \uc9c8\uc11c \uc720\uc9c0\ub97c \uc704\ud574\uc11c\ub294 \ubc95 \uc9d1\ud589\uc790\ubcf4\ub2e4 \uc815\uce58\uc801 \uc9c0\ub3c4\uc790\uc758 \uc7ac\ub7c9\uad8c \ud589\uc0ac\uac00 \uc6b0\uc120\uc2dc\ub418\uc5b4\uc57c \ud55c\ub2e4.",
          "rationale": "\uc815\uce58 \uc9c0\ub3c4\uc790\uc758 \uc7ac\ub7c9\uad8c\uc774 \ubc95 \uc704\uc5d0 \uc11c\uac8c \ub418\uba74 \ubc95\uc758 \uacf5\uc815\uc131\uc774 \ubb34\ub108\uc9c0\uace0 \uc0ac\ud68c\uc801 \uc2e0\ub8b0\uac00 \uc2e4\ucd94\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc2e0\ubd84\uc774\ub098 \uad8c\ub825\uc758 \ub192\uace0 \ub0ae\uc74c\uc5d0 \uc0c1\uad00\uc5c6\uc774 \ubc95\uc744 \uc9d1\ud589\ud558\ub294 \uc6d0\uce59\uc774 \uc0ac\ud68c \uc9c8\uc11c\uc640 \uc2e0\ub8b0\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub9f9\uc790\uac00 '\uc758(\u7fa9)'\uc5d0 \uad00\ud574 \uc124\uba85\ud558\uba74\uc11c \uac15\uc870\ud55c \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc2e0\uc758 \ud0c0\uace0\ub09c \uc131\ud5a5\uacfc \uc9c1\ubd84\uc5d0 \ub9de\uac8c \uac01\uc790\uc758 \uc0ac\ud68c\uc801 \uc77c\uc744 \uc131\uc2e4\ud788 \ub2e4\ud558\ub294 \uac83\uc774\ub2e4.",
          "rationale": "\ud0c0\uace0\ub09c \uc131\ud5a5\uc5d0 \ub530\ub978 \uc9c1\ubd84 \uc644\uc218\ub294 \ud50c\ub77c\ud1a4\uc758 \uc815\uc758\uad00\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3d9\ub4f1\ud55c \ub2a5\ub825\uc744 \uac00\uc9c4 \uc0ac\ub78c\uc5d0\uac8c \ub3d9\ub4f1\ud55c \ube44\uc728\uc758 \uc0ac\ud68c\uc801 \ubaab\uacfc \uc790\uc6d0\uc744 \ubd84\ubc30\ud558\ub294 \uac83\uc774\ub2e4.",
          "rationale": "\ub3d9\ub4f1\ud568\uc5d0 \ub530\ub978 \ubaab\uc758 \ubd84\ubc30\ub294 \uc544\ub9ac\uc2a4\ud1a0\ud154\ub808\uc2a4\uc758 \ube44\ub840\uc801 \ud3c9\ub4f1\uad00\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc798\ubabb\uc744 \ubd80\ub044\ub7ec\uc6cc\ud558\uace0 \uc0ac\uc801\uc778 \uc774\uc775\uc774\ub098 \uacb0\uacfc\uc5d0 \uc9d1\ucc29\ud558\uc9c0 \uc54a\ub294 \uc62c\uace7\uc74c\uc744 \uac16\ucd94\ub294 \uac83\uc774\ub2e4.",
          "rationale": "\ub9f9\uc790\ub294 '\uc758(\u7fa9)\ub780 \uc798\ubabb\uc744 \ubd80\ub044\ub7ec\uc6cc\ud558\uace0 \uc774\uc775\uc5d0 \uc9d1\ucc29\ud558\uc9c0 \uc54a\ub294 \uc62c\uace7\uc74c\uc774\ub2e4'\ub77c\uace0 \uc815\uc758\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uad6d\uac00\uac00 \uc5c4\uaca9\ud55c \uc800\uc6b8\uacfc \uce7c\uc744 \ud1b5\ud574 \uc0ac\ud68c\uc801 \ubd80\ub97c \uc7ac\ubd84\ubc30\ud558\ub294 \uc81c\ub3c4\ub97c \ud655\ub9bd\ud558\ub294 \uac83\uc774\ub2e4.",
          "rationale": "\uc800\uc6b8\uacfc \uce7c\uc740 \uc11c\uc591\uc758 \uc815\uc758\uc758 \uc5ec\uc2e0\uc0c1 \uc0c1\uc9d5\ubb3c\uc774\uba70, \ub9f9\uc790\uc758 \ub3c4\ub355\uc801 \uc815\uc758\uad00\uacfc\ub294 \uc9c1\uc811\uc801 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub9f9\uc790\ub294 \ub3c4\ub355\uc801 \uc218\uce58\uc2ec(\uc218\uc624\uc9c0\uc2ec)\uacfc \uc0ac\uc0ac\ub85c\uc6b4 \uc774\uc775\uc744 \ud0d0\ud558\uc9c0 \uc54a\ub294 \ub9c8\uc74c\uac00\uc9d0\uc744 \uac15\uc870\ud588\uc2b5\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 '\uad50\uc815\uc801 \uc815\uc758'\uac00 \uc801\uc6a9\ub41c \ub300\ud45c\uc801\uc778 \uc0ac\ub840\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
