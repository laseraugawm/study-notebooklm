            "content": "\uc778\ub3c4\uc5d0\uc11c \ub098\ud0c0\ub098\ub294 \ub300\ud45c\uc801\uc778 \uc778\uad6c \ubb38\uc81c 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc790\ub9ac \ubd80\uc871 \ubb38\uc81c\uc640 \ub3c4\uc2dc \ube48\ubbfc \ubb38\uc81c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ub3c4\uc5d0\uc11c \ub3c4\uc2dc \ube48\ubbfc \ubb38\uc81c\uac00 \ub098\ud0c0\ub098\uac8c \ub41c \ubc30\uacbd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c4\uc2dc\uc640 \uc2dc\uace8 \uac04\uc758 \uaca9\ucc28\uac00 \ubc8c\uc5b4\uc9c0\uba74\uc11c \ub3c4\uc2dc\ub85c \uc778\uad6c\uac00 \uc9c0\ub098\uce58\uac8c \ubab0\ub824\ub4e4\uc5c8\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub798 \uc0ac\uc9c4\uc5d0 \ud574\ub2f9\ud558\ub294 \uc9c0\uc5ed\uc758 \uba85\uce6d\uacfc \uc774 \uc9c0\uc5ed\uc5d0 \ub098\ud0c0\ub09c \uc778\uad6c \ubb38\uc81c\uc758 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          },
          {
            "type": "image",
            "reference": "44cb4eff-ad19-4039-9c68-e143ee27a720",
            "alt": "\uc778\ub3c4 \ubb44\ubc14\uc774 \ub2e4\ub77c\ube44\uc758 \ubc00\uc9d1\ub41c \uc2ac\ub7fc\uac00 \ubc0f \ube48\ubbfc \uc9c0\uc5ed \ud48d\uacbd"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ub3c4 \ubb44\ubc14\uc774\uc758 '\ub2e4\ub77c\ube44(Dharavi)' \uc9c0\uc5ed\uc73c\ub85c, \ub3c4\uc2dc\ub85c \ubab0\ub824\ub4e0 \uc778\uad6c\ub85c \uc778\ud574 \uc8fc\ubbfc\ub4e4\uc774 \ub9e4\uc6b0 \uc5f4\uc545\ud55c \ud658\uacbd\uc5d0\uc11c \uc0b4\uc544\uac00\ub294 \ub300\ud45c\uc801\uc778 \ub3c4\uc2dc \ube48\ubbfc \uc9c0\uc5ed(\uc2ac\ub7fc)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2030\uc138\ub300\uac00 \uc544\uc774\ub97c \ub0b3\uace0 \uc2f6\uc5b4 \ud558\uc9c0 \uc54a\ub294 \uac00\uc7a5 \ud070 \uc774\uc720(1\uc704, 45%)\ub85c \uc870\uc0ac\ub41c \ud56d\ubaa9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc721\uc544\uc5d0 \ub4dc\ub294 \uac1c\uc778\uc801 \uc2dc\uac04\uacfc \ub178\ub825\uc744 \uac10\ub2f9\ud558\uace0 \uc2f6\uc9c0 \uc54a\uc544\uc11c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2030\uc138\ub300\uac00 \uc790\ub140 \ucd9c\uc0b0\uc744 \uc8fc\uc800\ud558\uac8c \ub9cc\ub4dc\ub294 \uacbd\uc81c\uc801 \ubd80\ub2f4 \uc694\uc778 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ub140 \uc591\uc721\uc5d0 \ub300\ud55c \uacbd\uc81c\uc801 \uc5ec\uc720 \ubd80\uc871\uacfc \uc790\ub140 \uad50\uc721\uc5d0 \ub4dc\ub294 \ub9c9\ub300\ud55c \ube44\uc6a9 \ubd80\ub2f4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc9c4\uad6d\uc5d0\uc11c \uc800\ucd9c\uc0dd\uc73c\ub85c \uc778\ud55c \uc778\uad6c \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uace0\uc790 \uc2e4\uc2dc\ud558\ub294 \ub300\ud45c\uc801\uc778 \ucd9c\uc0b0 \uc7a5\ub824 \uc815\ucc45 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd9c\uc0b0 \uc7a5\ub824\uae08 \uc9c0\uc6d0, \ucd9c\uc0b0 \ud734\uac00 \ubc0f \uc721\uc544 \ud734\uc9c1 \ubcf4\uc7a5, \uc720\uc5f0 \uadfc\ubb34\uc81c \ud655\ub300\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e8\uc2dc\uac04 \uadfc\ub85c, \uc2dc\ucc28 \ucd9c\ud1f4\uadfc\uc81c, \uc7ac\ud0dd\uadfc\ubb34 \ub4f1 \uc721\uc544\uc640 \uc5c5\ubb34\ub97c \ubcd1\ud589\ud560 \uc218 \uc788\ub3c4\ub85d \uc6b4\uc601\ud558\ub294 \ud0c4\ub825\uc801\uc778 \uadfc\ubb34 \ud615\ud0dc\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc5f0 \uadfc\ubb34\uc81c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc9c4\uad6d\uc5d0\uc11c \uacbd\uc81c\uc801 \ubb38\uc81c\ub85c \uccad\ub144\ub4e4\uc774 \uacb0\ud63c\uacfc \ucd9c\uc0b0\uc744 \ub2a6\ucd94\uac70\ub098 \ud3ec\uae30\ud558\uc9c0 \uc54a\ub3c4\ub85d \ub9c8\ub828\ud558\ub294 \uc815\ubd80 \uc9c0\uc6d0 \uc815\ucc45 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ud0dd \ud2b9\ubcc4 \uacf5\uae09\uacfc \uccad\ub144 \uc77c\uc790\ub9ac \ud655\ubcf4 \uc815\ucc45\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc9c4\uad6d\uc5d0\uc11c \uace0\ub839\ud654 \ud604\uc0c1\uc5d0 \ub300\ube44\ud574 \ub178\ub144\uce35\uc758 \uacbd\uc81c\uc801 \uc548\uc815\uacfc \uc0ac\ud68c \ucc38\uc5ec\ub97c \ub3d5\uae30 \uc704\ud574 \uc2dc\ud589\ud558\ub294 \uc815\ucc45 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub144\uce35 \uc77c\uc790\ub9ac \ud655\ub300, \uc815\ub144 \uc5f0\uc7a5, \uc548\uc815\uc801\uc778 \ub178\ud6c4 \uc0dd\ud65c\uc744 \uc704\ud55c \uc5f0\uae08 \uc81c\ub3c4 \uc6b4\uc601\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc5d0\uc11c \uc778\uad6c \uacfc\uc789 \ud604\uc0c1\uc5d0 \ub530\ub978 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc2e4\uc2dc\ud558\ub294 \uc8fc\uc694 \uc778\uad6c \ubc0f \ub18d\uc5c5 \uc815\ucc45 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ub7c9 \uc99d\uc0b0 \uc815\ucc45\uacfc \uc0b0\uc544 \uc81c\ud55c \uc815\ucc45\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc5d0\uc11c \ub3c4\uc2dc\ub85c \uc778\uad6c\uac00\u8fc7\ub3c4\ud558\uac8c \uc9d1\uc911\ud558\ub294 \ubb38\uc81c\ub97c \uc644\ud654\ud558\uae30 \uc704\ud574 \ucd94\uc9c4\ud558\ub294 \uc9c0\uc5ed \uc815\ucc45 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd0c\ub77d\uc758 \uc0dd\ud65c \ud658\uacbd \uac1c\uc120\uacfc \uc911\uc18c \ub3c4\uc2dc \uc721\uc131 \uc815\ucc45\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574 '\uac1c\uc778\uc801 \ucc28\uc6d0'\uc5d0\uc11c \uc694\uad6c\ub418\ub294 \uc778\uc2dd\uc801 \ubcc0\ud654\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc871\uacfc \ud568\uaed8\ud558\ub294 \uc0b6\uc5d0\uc11c \uacb0\ud63c\uc758 \uac00\uce58\ub97c \uae68\ub2eb\uace0 \uc790\ub140\uc758 \uc18c\uc911\ud568\uc744 \uc774\ud574\ud558\uba70, \ub178\ub144\uce35\uc744 \uc9c0\ud61c\ub97c \ub098\ub204\ub294 \uad6c\uc131\uc6d0\uc73c\ub85c \ub300\ud558\uace0 \uacf5\uacbd\ud558\ub294 \uac83\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\ucd9c\uc0dd\u00b7\uace0\ub839\ud654 \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574 '\uc0ac\ud68c\uc801 \ucc28\uc6d0'\uc5d0\uc11c \ud655\ub9bd\ud574\uc57c \ud560 \ubb38\ud654\uc640 \uac00\uce58\uad00\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uc131\ud3c9\ub4f1 \ubb38\ud654\ub97c \ud655\ub9bd\ud558\uace0 \uc77c\uacfc \uac00\uc815 \uac04\uc758 \uade0\ud615\uc744 \uc774\ub8f0 \uc218 \uc788\ub294 \uac00\uc871 \uce5c\ud654\uc801 \uac00\uce58\uad00\uc744 \ud615\uc131\ud558\ub294 \uac83\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ud604\uc138\ub300\uc640 \ubbf8\ub798 \uc138\ub300 \uac04\uc758 \ud615\ud3c9\uc131\uc744 \uace0\ub824\ud558\ub294 \uac83'\uc744 \ub73b\ud558\ub294 \uc724\ub9ac\uc801\u00b7\uc0ac\ud68c\uc801 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\ub300 \uac04 \uc815\uc758\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ub839\ud654 \uc0ac\ud68c\uc5d0\uc11c '\uc138\ub300 \uac04 \uc815\uc758'\uc5d0 \uae30\ubc18\ud558\uc5ec \ubcf5\uc9c0 \uc815\ucc45\uc744 \ucd94\uc9c4\ud560 \ub54c \uc720\uc758\ud574\uc57c \ud560 \ub178\ud6c4 \ubcf5\uc9c0 \uc218\uc900\uc758 \uc124\uc815 \ubc29\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\uc138\ub300 \ub178\ub144\uce35 \ubcf5\uc9c0\uac00 \ubbf8\ub798 \uc138\ub300(\uc0dd\uc0b0 \uc5f0\ub839 \uc778\uad6c)\uc5d0\uac8c \uacfc\ub3c4\ud55c \ubd80\ub2f4\uc744 \uc8fc\uc9c0 \uc54a\ub3c4\ub85d \uc0ac\ud68c\uc801 \ud569\uc758\ub97c \ud1b5\ud574 \uc801\uc815 \uc218\uc900\uc73c\ub85c \uc720\uc9c0\ud558\ub294 \uac83\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uad6d\uc5d0\uc11c \uc800\ucd9c\uc0dd \ubc0f \uc778\uad6c \uc99d\uac00\uc138 \uac10\uc18c \ud604\uc0c1\uc744 \ubd88\ub7ec\uc628 3\uac00\uc9c0 \ubcf5\ud569\uc801\uc778 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucf54\ub85c\ub09819 \ub300\uc720\ud589, \uae30\uc874\uc758 \uc800\ucd9c\uc0dd \ud604\uc0c1, \uac15\ub825\ud55c \ubc18\uc774\ubbfc \uc815\ucc45\uc758 \ubcf5\ud569\uc801 \uc791\uc6a9\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\ucd9c\uc0dd\uacfc \uac15\ub825\ud55c \ubc18\uc774\ubbfc \uc815\ucc45\uc774 \uc9c0\uc18d\ub420 \uacbd\uc6b0 \ubbf8\uad6d \uacbd\uc81c \ubc0f \uc0ac\ud68c \ubcf4\uc7a5 \uce21\uba74\uc5d0\uc11c \uc608\uc0c1\ub418\ub294 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9\uc790 \ubd80\uc871 \ud604\uc0c1 \ubc1c\uc0dd\uacfc \uc0ac\ud68c \ubcf4\uc7a5 \ube44\uc6a9\uc758 \uc99d\uac00\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ub3c4\uc5d0\uc11c \uc77c\uc790\ub9ac \ubd80\uc871 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\ub294 \uc18d\ub3c4\uc0c1 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc6a9 \ucc3d\ucd9c \uc18d\ub3c4\uac00 \uc778\uad6c \uc99d\uac00 \uc18d\ub3c4\ub97c \ub530\ub77c\uac00\uc9c0 \ubabb\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\uc758 \uc778\uad6c\uac00 \uc801\uc815 \uaddc\ubaa8\ub85c \uc720\uc9c0\ub418\uc9c0 \ubabb\ud558\uac70\ub098 \uc778\uad6c \uad6c\uc870\uac00 \uae09\uaca9\ud558\uac8c \ubcc0\ud654\ud558\uc5ec \ubc1c\uc0dd\ud558\ub294 \uc5ec\ub7ec \uc0ac\ud68c\ubb38\uc81c\ub97c \ud1b5\ud2c0\uc5b4 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad6c \ubb38\uc81c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uac01 \uc9c0\uc5ed\uc758 \uc778\uad6c \ubd84\ud3ec\uac00 \ubd88\uade0\ub4f1\ud558\uac8c \ub098\ud0c0\ub098\ub3c4\ub85d \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 2\uac00\uc9c0 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\uc801 \uc694\uc778\uacfc \uc0ac\ud68c\uc801 \uc694\uc778\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d\uc5d0\uc11c \ub178\ub144\uce35 \uc778\uad6c \ubd80\uc591\uc5d0 \ud22c\uc785\ub418\ub294 \uc608\uc0b0\uc774 \ucee4\uc9c8 \ub54c, \uccad\uc7a5\ub144\uce35\uc774 \uacaa\uac8c \ub418\ub294 \uc9c1\uc811\uc801\uc778 \uacbd\uc81c\uc801 \ubd80\ub2f4\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub144\uce35\uc744 \ubd80\uc591\ud558\uae30 \uc704\ud574 \ubd80\ub2f4\ud574\uc57c \ud558\ub294 \uc138\uae08 \ubc0f \uc0ac\ud68c \ubcf4\uc7a5 \uc608\uc0b0 \ubd80\ub2f4\uc774 \uc99d\uac00\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc9c4\uad6d\uacfc \uac1c\ubc1c \ub3c4\uc0c1\uad6d\uc758 \uc778\uad6c \ubb38\uc81c\uac00 \uac01\uae30 \ub2e4\ub978 \uc591\uc0c1\uc73c\ub85c \ub098\ud0c0\ub098\ub294 \uc8fc\uc694 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uad6d\uac00\uac00 \ucc98\ud55c \uacbd\uc81c \ubc1c\uc804 \uc218\uc900\uacfc \uacbd\uc81c\uc801\u00b7\uc0ac\ud68c\uc801 \uc0c1\ud669\uc774 \uc11c\ub85c \ub2e4\ub974\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
