{
  "title": "\uc790\uc6d0 \uc5d0\ub108\uc9c0 \ud034\uc988",
  "questions": [
    {
      "question": "\uc790\uc6d0\uc740 \uacfc\ud559\uae30\uc220\uc758 \ubc1c\ub2ec\uc774\ub098 \uc0ac\ud68c\uc801\u00b7\ubb38\ud654\uc801 \ubc30\uacbd \ub4f1\uc5d0 \ub530\ub77c \uadf8 \uac00\uce58\uac00 \ubcc0\ud558\uae30\ub3c4 \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc790\uc6d0\uc758 \ud2b9\uc131\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud569\ub2c8\uae4c?",
      "answerOptions": [
        {
          "text": "\uac00\ubcc0\uc131",
          "isCorrect": true,
          "rationale": "\uc790\uc6d0\uc758 \uac00\uce58\uac00 \uc2dc\uacf5\uac04\uc774\ub098 \uae30\uc220, \uc0ac\ud68c\uc801 \uc0c1\ud669\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c0\ub294 \uc131\uc9c8\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4."
        },
        {
          "text": "\ud3b8\uc7ac\uc131",
          "isCorrect": false,
          "rationale": "\uc790\uc6d0\uc774 \uc9c0\uad6c\uc0c1\uc5d0 \uace0\ub974\uac8c \ubd84\ud3ec\ud558\uc9c0 \uc54a\uace0 \ud2b9\uc815 \uc9c0\uc5ed\uc5d0 \uc9d1\uc911\ub418\uc5b4 \uc788\ub294 \uc131\uc9c8\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc720\ud55c\uc131",
          "isCorrect": false,
          "rationale": "\uc790\uc6d0\uc758 \ub9e4\uc7a5\ub7c9\uc774 \ud55c\uc815\ub418\uc5b4 \uc788\uc5b4 \uc0ac\uc6a9\ud558\uba74 \uc5b8\uc820\uac00 \uace0\uac08\ub418\ub294 \ud2b9\uc131\uc744 \uac00\ub9ac\ud0b5\ub2c8\ub2e4."
        },
        {
          "text": "\uace0\uc815\uc131",
          "isCorrect": false,
          "rationale": "\uc790\uc6d0\uc758 \uac00\uce58\ub098 \ud65c\uc6a9\ub3c4\uac00 \ubcc0\ud558\uc9c0 \uc54a\ub294\ub2e4\ub294 \uac1c\ub150\uc73c\ub85c, \ubcf8\ubb38\uc758 \uac00\ubcc0\uc131\uacfc \ub300\ub9bd\ub418\ub294 \uc624\ub2f5 \uc694\uc18c\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc2dc\ub300\ub098 \uae30\uc220 \uc218\uc900\uc758 \ubcc0\ud654\uc5d0 \ub530\ub77c \uc790\uc6d0\uc758 \uac00\uce58\uac00 \ub2ec\ub77c\uc9c4\ub2e4\ub294 \ub73b\uc758 \ub2e8\uc5b4\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc8fc\uc694 \ud654\uc11d \uc5d0\ub108\uc9c0 \uc911 \uac00\uc7a5 \uba3c\uc800 \uc0c1\uc6a9\ud654\ub418\uc5c8\uc73c\uba70, \ube44\uad50\uc801 \ub113\uc740 \uc9c0\uc5ed\uc5d0 \ubd84\ud3ec\ud558\uc5ec \uc0dd\uc0b0\ub7c9 \ub300\ube44 \uad6d\uc81c \uc774\ub3d9\ub7c9\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \uc801\uc740 \uc790\uc6d0\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?",
      "answerOptions": [
        {
          "text": "\uc11d\ud0c4",
          "isCorrect": true,
          "rationale": "18\uc138\uae30 \uc0b0\uc5c5 \ud601\uba85 \uc774\ud6c4 \ubcf8\uaca9 \uc0ac\uc6a9\ub418\uc5c8\uc73c\uba70 \ub113\uac8c \ubd84\ud3ec\ud558\uc5ec \uad6d\uc81c \uc774\ub3d9\ub7c9\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \uc801\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc11d\uc720",
          "isCorrect": false,
          "rationale": "\ud398\ub974\uc2dc\uc544\ub9cc \uc8fc\ubcc0\uc5d0 \ub9e4\uc7a5\ub7c9\uc774 \uc9d1\uc911\ub418\uc5b4 \uc788\uc5b4 \ud3b8\uc7ac\uc131\uc774 \ub9e4\uc6b0 \ud06c\uace0 \uad6d\uc81c \uc774\ub3d9\ub7c9\uc774 \uac00\uc7a5 \ub9ce\uc740 \uc790\uc6d0\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ucc9c\uc5f0\uac00\uc2a4",
          "isCorrect": false,
          "rationale": "\ub0c9\ub3d9 \uc561\ud654 \uae30\uc220\uacfc \uc218\uc1a1\uad00 \uac74\uc124\ub85c \uc774\ub3d9\ub7c9\uc774 \ub298\uc5b4\ub0ac\uc73c\uba70 \uc8fc\ub85c \uac00\uc815\uc6a9 \ubc0f \uc0c1\uc5c5\uc6a9\uc73c\ub85c \uc4f0\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc6b0\ub77c\ub284",
          "isCorrect": false,
          "rationale": "\uc6d0\uc790\ub825 \ubc1c\uc804\uc5d0 \uc774\uc6a9\ub418\ub294 \uc790\uc6d0\uc73c\ub85c \ud654\uc11d \uc5d0\ub108\uc774\uc81c \ubc94\uc8fc\uc5d0 \ud574\ub2f9\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uace0\uc0dd\ub300 \uc9c0\uce35\uc5d0 \uc8fc\ub85c \ub9e4\uc7a5\ub418\uc5b4 \uc788\uc73c\uba70 18\uc138\uae30 \uc0b0\uc5c5 \ud601\uba85\uc758 \uc8fc\uc694 \ub3d9\ub825\uc6d0\uc774\uc5c8\ub358 \uc790\uc6d0\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\uc11d\uc720 \uc790\uc6d0\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "18\uc138\uae30 \uc0b0\uc5c5 \ud601\uba85 \uc9c1\ud6c4 \uac00\uc7a5 \uba3c\uc800 \uc0c1\uc6a9\ud654\ub41c \ud654\uc11d \uc5d0\ub108\uc9c0\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0b0\uc5c5 \ud601\uba85 \uc9c1\ud6c4 \uac00\uc7a5 \uba3c\uc800 \uc0c1\uc6a9\ud654\ub41c \ud654\uc11d \uc5d0\ub108\uc9c0\ub294 \uc11d\uc720\uac00 \uc544\ub2c8\ub77c \uc11d\ud0c4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4\uc5d0\uc11c \uc18c\ube44\ub7c9\uacfc \uad6d\uc81c \uc774\ub3d9\ub7c9\uc774 \uac00\uc7a5 \ub9ce\uc740 \uc5d0\ub108\uc9c0 \uc790\uc6d0\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc11d\uc720\ub294 \uc804 \uc138\uacc4 \uc18c\ube44\ub7c9\uacfc \uad6d\uc81c \uc774\ub3d9\ub7c9 \ubaa8\ub450 1\uc704\ub97c \ucc28\uc9c0\ud558\ub294 \uc790\uc6d0\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\uacc4 \ub9e4\uc7a5\ub7c9\uc758 \uc808\ubc18 \uc815\ub3c4\uac00 \ud398\ub974\uc2dc\uc544\ub9cc \uc8fc\ubcc0\uc5d0 \uc9d1\uc911\ub418\uc5b4 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc11d\uc720\ub294 \ud2b9\uc815 \uc9c0\uc5ed \uc9d1\uc911\ub3c4\uac00 \ub192\uc544 \ud3b8\uc7ac\uc131\uc774 \ub9e4\uc6b0 \ud06c\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "19\uc138\uae30 \ub0b4\uc5f0 \uae30\uad00\uc758 \ubc1c\uba85\uacfc \uc790\ub3d9\ucc28 \ubcf4\uae09\uc73c\ub85c \uc218\uc694\uac00 \uae09\uc99d\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub0b4\uc5f0 \uae30\uad00 \ubc1c\uba85\uc740 \uc11d\uc720 \uc218\uc694\ub97c \uae09\uaca9\ud558\uac8c \ub298\ub9b0 \ud575\uc2ec \uc694\uc778\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac00\uc7a5 \uba3c\uc800 \ubcf8\uaca9\uc801\uc73c\ub85c \uc0ac\uc6a9\ub41c \ud654\uc11d \uc5d0\ub108\uc9c0\uac00 \ubb34\uc5c7\uc778\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ucc9c\uc5f0\uac00\uc2a4\uc758 \uad6d\uc81c \uc774\ub3d9\ub7c9\uc774 \uacfc\uac70\uc5d0 \ube44\ud574 \ud06c\uac8c \uc99d\uac00\ud560 \uc218 \uc788\uc5c8\ub358 \uc8fc\uc694 \uc694\uc778\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub0c9\ub3d9 \uc561\ud654 \uae30\uc220\uc758 \ubc1c\ub2ec\uacfc \ub300\ud615 \uc218\uc1a1\uad00 \uac74\uc124",
          "isCorrect": true,
          "rationale": "\uae30\uccb4 \uc0c1\ud0dc\uc758 \ucc9c\uc5f0\uac00\uc2a4\ub97c \uc561\uccb4\ub85c \ub9cc\ub4e4\uc5b4 \ubd80\ud53c\ub97c \uc904\uc774\uace0 \uc218\uc1a1\uad00\uc744 \ud1b5\ud574 \ub300\ub7c9 \uc6b4\ubc18\uc774 \uac00\ub2a5\ud574\uc84c\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uace0\uc0dd\ub300 \uc9c0\uce35\uc758 \ubc1c\uad74\uacfc \uc81c\ucca0 \uacf5\uc5c5\uc758 \uae09\uc131\uc7a5",
          "isCorrect": false,
          "rationale": "\uace0\uc0dd\ub300 \uc9c0\uce35 \ubc0f \uc81c\ucca0 \uacf5\uc5c5\uacfc \ubc00\uc811\ud55c \uad00\ub828\uc774 \uc788\ub294 \uc790\uc6d0\uc740 \uc11d\ud0c4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub0b4\uc5f0 \uae30\uad00\uc758 \ubc1c\uba85 \ubc0f \uc218\uc1a1 \uc5f0\ub8cc \uc218\uc694 \ud3ed\uc99d",
          "isCorrect": false,
          "rationale": "\ub0b4\uc5f0 \uae30\uad00\uc758 \uc218\uc1a1\uc6a9 \uc5f0\ub8cc\ub85c \uc218\uc694\uac00 \ud3ed\uc99d\ud55c \uac83\uc740 \uc11d\uc720\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud398\ub974\uc2dc\uc544\ub9cc \uc5f0\uc548 \uad6d\ub4e4\uc758 \uc0dd\uc0b0\ub7c9 \uc99d\ub300 \uc815\ucc45",
          "isCorrect": false,
          "rationale": "\ud398\ub974\uc2dc\uc544\ub9cc\uc740 \ucc9c\uc5f0\uac00\uc2a4\ubcf4\ub2e4\ub294 \uc11d\uc720 \ub9e4\uc7a5\ub7c9\uc774 \uc9d1\uc911\ub41c \ub300\ud45c\uc801 \uc9c0\uc5ed\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uae30\uccb4 \uc0c1\ud0dc\uc758 \uc790\uc6d0\uc744 \uae30\uc628\uc744 \ub0ae\ucdb0 \uc561\uccb4\ub85c \ubc14\uafb8\uc5b4 \uc6b4\ubc18\ud558\ub294 \uae30\uc220\uacfc \uad00\ub828\uc774 \uc788\uc2b5\ub2c8\ub2e4."
    },
    {
      "question": "\uc81c\uc2dc\ub41c \uc790\ub8cc\uc758 \ud654\uc11d \uc5d0\ub108\uc9c0 \uc790\uc6d0\ubcc4 \uac00\ucc44 \uc5f0\uc218\ub97c \ubc14\ud0d5\uc73c\ub85c, \ud5a5\ud6c4 \uace0\uac08\ub420 \uac83\uc73c\ub85c \uc608\uc0c1\ub418\ub294 \uc2dc\uc810\uc774 \ube60\ub978 \uac83\ubd80\ud130 \uc21c\uc11c\ub300\ub85c \ubc14\ub974\uac8c \ub098\uc5f4\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucc9c\uc5f0\uac00\uc2a4 \u2794 \uc11d\uc720 \u2794 \uc11d\ud0c4",
          "isCorrect": true,
          "rationale": "\uc790\ub8cc\uc5d0 \uc81c\uc2dc\ub41c \uac00\ucc44 \uc5f0\uc218\ub294 \ucc9c\uc5f0\uac00\uc2a4 49\ub144, \uc11d\uc720 54\ub144, \uc11d\ud0c4 139\ub144 \uc21c\uc73c\ub85c \ucc9c\uc5f0\uac00\uc2a4\uac00 \uac00\uc7a5 \uc9e7\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc11d\uc720 \u2794 \ucc9c\uc5f0\uac00\uc2a4 \u2794 \uc11d\ud0c4",
          "isCorrect": false,
          "rationale": "\uc11d\uc720\uc758 \uac00\ucc44 \uc5f0\uc218\ub294 54\ub144\uc73c\ub85c \ucc9c\uc5f0\uac00\uc2a4(49\ub144)\ubcf4\ub2e4 \uae41\ub2c8\ub2e4."
        },
        {
          "text": "\uc11d\ud0c4 \u2794 \uc11d\uc720 \u2794 \ucc9c\uc5f0\uac00\uc2a4",
          "isCorrect": false,
          "rationale": "\uc11d\ud0c4\uc740 \uac00\ucc44 \uc5f0\uc218\uac00 139\ub144\uc73c\ub85c \ud654\uc11d \uc5d0\ub108\uc9c0 \uc911 \uac00\uc7a5 \uae41\ub2c8\ub2e4."
        },
        {
          "text": "\ucc9c\uc5f0\uac00\uc2a4 \u2794 \uc11d\ud0c4 \u2794 \uc11d\uc720",
          "isCorrect": false,
          "rationale": "\uc11d\ud0c4\uc758 \uac00\ucc44 \uc5f0\uc218\uac00 \uc11d\uc720\ubcf4\ub2e4 \ud6e8\uc52c \uae38\uac8c \ub0a8\uc544\uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac00\ucc44 \uc5f0\uc218\uac00 \uc9e7\uc744\uc218\ub85d \ub354 \ube68\ub9ac \uace0\uac08\ub429\ub2c8\ub2e4. \ubcf8\ubb38\uc758 \uadf8\ub798\ud504 \uc218\uce58(49\ub144, 54\ub144, 139\ub144)\ub97c \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc790\uc6d0\uc744 \ubcf4\uc720\ud55c \uad6d\uac00\uac00 \uc790\uad6d\uc758 \uacbd\uc81c\uc801\u00b7\uc815\uce58\uc801 \uc774\uc775\uc744 \uc704\ud574 \uc790\uc6d0\uc744 \uc804\ub7b5\uc801 \ubb34\uae30\ub85c \uc774\uc6a9\ud558\ub294 \ud604\uc0c1\uc744 \ub73b\ud558\ub294 \uc6a9\uc5b4\ub294?",
      "answerOptions": [
        {
          "text": "\uc790\uc6d0 \ubbfc\uc871\uc8fc\uc758",
          "isCorrect": true,
          "rationale": "\uc790\uc6d0 \ubcf4\uc720\uad6d\uc774 \uc790\uc6d0\uc744 \ubb34\uae30\ud654\ud558\uc5ec \uc0dd\uc0b0\ub7c9\uc774\ub098 \uac00\uaca9\uc744 \uc870\uc808\ud568\uc73c\ub85c\uc368 \uad6d\uc775\uc744 \ub3c4\ubaa8\ud558\ub294 \ud604\uc0c1\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc6d0 \ud3b8\uc7ac\uc131",
          "isCorrect": false,
          "rationale": "\uc790\uc6d0\uc774 \uc9c0\uad6c \ud45c\uba74\uc5d0 \ubd88\uade0\ub4f1\ud558\uac8c \ub9e4\uc7a5\ub418\uc5b4 \uc788\ub294 \uc9c0\ub9ac\uc801 \ud604\uc0c1\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc6d0 \uac00\ubcc0\uc131",
          "isCorrect": false,
          "rationale": "\uae30\uc220\uc774\ub098 \ubb38\ud654\uc801 \ubc30\uacbd\uc5d0 \ub530\ub77c \uc790\uc6d0\uc758 \uac00\uce58\uac00 \ub2ec\ub77c\uc9c0\ub294 \uc131\uc9c8\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc5d0\ub108\uc9c0 \uc804\ud658 \uc815\ucc45",
          "isCorrect": false,
          "rationale": "\ud654\uc11d \uc5f0\ub8cc \uc911\uc2ec\uc5d0\uc11c \uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub85c \uc5d0\ub108\uc9c0\uc6d0\uc744 \ubc14\uafb8\ub294 \uad6d\uac00 \uc815\ucc45\uc744 \ub73b\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc11d\uc720 \uc218\ucd9c\uad6d \uae30\uad6c(OPEC)\uac00 \uc11d\uc720 \uc0dd\uc0b0\ub7c9\uacfc \uac00\uaca9\uc744 \uc870\uc808\ud558\uc5ec \uc601\ud5a5\ub825\uc744 \ud589\uc0ac\ud558\ub294 \uc0ac\ub840\uac00 \ub300\ud45c\uc801\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\ucd5c\uadfc \ubd81\uadf9\ud574 \uc9c0\uc5ed\uc5d0\uc11c \uc790\uc6d0\uc744 \ub458\ub7ec\uc2fc \uac08\ub4f1\uc774 \ud655\uc0b0\ud558\uac8c \ub41c \uc6d0\uc778\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\uad6c \uc628\ub09c\ud654\ub85c \ubd81\uadf9\ud574 \uc5bc\uc74c\uc774 \ub179\uc544 \ubc14\ub2f7\uc18d \ub9e4\uc7a5 \uc790\uc6d0\uc758 \ud0d0\uc0ac\uc640 \uac1c\ubc1c\uc774 \uac00\ub2a5\ud574\uc84c\uae30 \ub54c\ubb38\uc5d0",
          "isCorrect": true,
          "rationale": "\uc9c0\uad6c \uc628\ub09c\ud654\ub85c \ube59\ud558\uac00 \uc904\uc5b4\ub4e4\uba74\uc11c \ubd81\uadf9\ud574\uc5d0 \ubb3b\ud78c \ub300\ub7c9\uc758 \uc11d\uc720\uc640 \ucc9c\uc5f0\uac00\uc2a4 \uac1c\ubc1c\uc774 \uac00\ub2a5\ud574\uc838 \uc5f0\uc548\uad6d \uac04 \uc601\uc720\uad8c \ubd84\uc7c1\uc774 \uc2dc\uc791\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubd81\uadf9\ud574 \uc5f0\uc548 \uad6d\uac00\ub4e4\uc774 \uc11d\uc720 \uc218\ucd9c\uad6d \uae30\uad6c(OPEC)\ub97c \uc0c8\ub86d\uac8c \uacb0\uc131\ud588\uae30 \ub54c\ubb38\uc5d0",
          "isCorrect": false,
          "rationale": "\ubd81\uadf9\ud574 \uc5f0\uc548\uad6d\ub4e4\uc774 OPEC\uc744 \uacb0\uc131\ud588\ub2e4\ub294 \ub0b4\uc6a9\uc740 \ubcf8\ubb38 \ucd9c\ucc98\uc5d0 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubd81\uadf9\ud574\uc758 \ud654\uc11d \uc5d0\ub108\uc9c0\uac00 \uace0\uac08\ub418\uc5b4 \ub0a8\uc544\uc788\ub294 \ub300\uccb4 \uc5d0\ub108\uc9c0\ub97c \ucc28\uc9c0\ud558\uae30 \uc704\ud574",
          "isCorrect": false,
          "rationale": "\ubd81\uadf9\ud574\ub294 \uc11d\uc720 \uc57d 13%, \ucc9c\uc5f0\uac00\uc2a4 \uc57d 30%\uac00 \ubbf8\uac1c\ubc1c \uc0c1\ud0dc\ub85c \uc0c8\ub85c\uc774 \ub9e4\uc7a5\ub418\uc5b4 \uc788\uc74c\uc774 \ud655\uc778\ub41c \uc9c0\uc5ed\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uae30\uc220\uc774 \ubc1c\uc804\ud568\uc5d0 \ub530\ub77c \ud654\uc11d \uc5f0\ub8cc\uc758 \uac00\uce58\uac00 \uc644\uc804\ud788 \uc18c\uba78\ud588\uae30 \ub54c\ubb38\uc5d0",
