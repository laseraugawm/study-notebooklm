{
  "title": "\uc815\uc758\uad00 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc774 \ucd5c\uc6b0\uc120\uc73c\ub85c \ucd94\uad6c\ud558\ub294 \ubaa9\ud45c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \ubcf4\uc7a5\ud558\uc5ec \uc790\uc720\ub97c \uc2e4\ud604\ud558\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \uad6d\uac00\uc758 \uac1c\uc785\uc5d0 \ub300\ud574 \ucde8\ud558\ub294 \uae30\ubcf8 \uc785\uc7a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\uc758 \uac1c\uc785\uc740 \uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \uce68\ud574\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uad6d\uac00\ub294 \uc911\ub9bd\uc744 \uc720\uc9c0\ud574\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \ubc14\ub77c\ubcf4\ub294 '\uac1c\uc778'\uc758 \uc9c0\uc704\uc640 \uc131\uaca9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\ub85c\ubd80\ud130 \ub3c5\ub9bd\ub41c \uc790\uc728\uc801 \uc874\uc7ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \ubc14\ub77c\ubcf4\ub294 '\uc0ac\ud68c(\uad6d\uac00)'\uc758 \ubcf8\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\ub4e4\uc774 \ubaa8\uc5ec \uc788\ub294 \ub2e8\uc21c\ud55c \uc9d1\ud569\uccb4\uc774\uc790 \uac1c\uc778 \uac04\uc758 \ud569\uc758\uc640 \uacc4\uc57d\uc73c\ub85c \uad6c\uc131\ub41c \uc0b0\ubb3c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \uac1c\uc778\uc758 \uc790\uc720\uc640 \uad8c\ub9ac \ucd94\uad6c\uac00 \uc81c\ud55c\ub420 \uc218 \uc788\ub294 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc778\uc758 \uad8c\ub9ac\ub098 \uc790\uc720\ub97c \uce68\ud574\ud558\uac70\ub098 \ud53c\ud574\ub97c \uc8fc\ub294 \ud589\uc704\uc77c \ub54c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc774 \uc790\uc2e0\uc758 \uc790\uc720\uc640 \uad8c\ub9ac\ub9cc\uc744 \ubb34\uc81c\ud55c\uc801\uc73c\ub85c \ucd94\uad6c\ud560 \ub54c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \ubd80\uc791\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc778\uc758 \uad8c\ub9ac\ub098 \uc0ac\ud68c \uc804\uccb4\uc758 \uc774\uc775\uc744 \uce68\ud574\ud558\ub294 \uadf9\ub2e8\uc801 \uc774\uae30\uc8fc\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub864\uc2a4(Rawls)\uac00 \uc81c\uc2dc\ud55c, \uacf5\uc815\ud55c \uc815\uc758\uc758 \uc6d0\uce59\uc744 \ub3c4\ucd9c\ud558\uae30 \uc704\ud55c \uac00\uc0c1\uc758 \ud569\uc758 \uc0c1\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc9c0\uc758 \ubca0\uc77c\uc744 \uc4f4 \uc6d0\ucd08\uc801 \uc785\uc7a5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub864\uc2a4\uc758 \uc815\uc758\uc758 \uccab \ubc88\uc9f8 \uc6d0\uce59(\ud3c9\ub4f1\ud55c \uc790\uc720\uc758 \uc6d0\uce59)\uc758 \ud575\uc2ec \ub0b4\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \uae30\ubcf8\uc801 \uc790\uc720\uac00 \ud3c9\ub4f1\ud558\uac8c \ubcf4\uc7a5\ub418\uc5b4\uc57c \ud55c\ub2e4\ub294 \uc6d0\uce59"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub864\uc2a4\uc758 \uc815\uc758\uc758 \ub450 \ubc88\uc9f8 \uc6d0\uce59 \uc911 \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \ubd88\ud3c9\ub4f1\uc744 \uc815\ub2f9\ud654\ud558\uae30 \uc704\ud574 '\ucd5c\uc18c \uc218\ud61c\uc790'\uc640 \uad00\ub828\ub41c \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \ubd88\ud3c9\ub4f1\uc774 \ucd5c\uc18c \uc218\ud61c\uc790\uc5d0\uac8c \ucd5c\ub300 \uc774\uc775\uc774 \ub418\uc5b4\uc57c \ud55c\ub2e4(\ucc28\ub4f1\uc758 \uc6d0\uce59)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub864\uc2a4\uc758 \uc815\uc758\uad00\uc5d0\uc11c \uc0ac\ud68c\uc801\u00b7\uacbd\uc81c\uc801 \ubd88\ud3c9\ub4f1\uc774 \ud5c8\uc6a9\ub418\uae30 \uc704\ud574 \uc9c1\uc704\ub098 \uc9c1\ucc45\uacfc \uad00\ub828\ud558\uc5ec \ucda9\uc871\ub418\uc5b4\uc57c \ud558\ub294 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \uae30\ud68c\uac00 \uade0\ub4f1\ud558\uac8c \uc8fc\uc5b4\uc838\uc57c \ud55c\ub2e4(\uae30\ud68c \uade0\ub4f1\uc758 \uc6d0\uce59)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc9c1(Nozick)\uc774 \uc8fc\ucc3d\ud55c \uc790\uc720\uc8fc\uc758 \uacc4\uc5f4\uc758 \uc815\ub2f9\ud55c \uad6d\uac00\uad00 \ubc0f \uc0ac\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720 \uc9c0\uc0c1\uc8fc\uc758 (Libertarianism)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc9c1\uc5d0 \ub530\ub974\uba74 \uc815\ub2f9\ud654\ub420 \uc218 \uc788\ub294 \uc720\uc77c\ud55c \uad6d\uac00 \ud615\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc758 \uad8c\ub9ac\ub97c \ubcf4\ud638\ud558\ub294 \uc18c\uadf9\uc801 \uc5ed\ud560\ub9cc\uc744 \uc218\ud589\ud558\ub294 '\ucd5c\uc18c \uad6d\uac00'"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc9c1\uc758 \uc815\uc758\uad00\uc5d0\uc11c \uac1c\uc778 \uc18c\uc720\ubb3c\uc758 \uc815\ub2f9\uc131\uc744 \uacb0\uc815\ud558\ub294 \ud575\uc2ec \uae30\uc900 \ub450 \uac00\uc9c0 \uacfc\uc815\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ub2f9\ud55c \ucde8\ub4dd\uacfc \uc815\ub2f9\ud55c \uc774\uc804"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc9c1\uc758 \uc815\uc758\uad00\uc5d0\uc11c \uc18c\uc720\ubb3c\uc758 \ucde8\ub4dd\uc774\ub098 \uc774\uc804 \uacfc\uc815\uc5d0\uc11c \ubd80\uc815\uc758\uac00 \ubc1c\uc0dd\ud55c \uacbd\uc6b0 \uad6d\uac00\ub098 \uc0ac\ud68c\uac00 \ud574\uc57c \ud560 \uc77c\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\uc815\uc758\ub97c \uad50\uc815\ud558\ub294 \uc77c (\uad50\uc815\uc758 \uc815\ub2f9\uc131)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc774 \uac1c\uc778\uc758 \uad8c\ub9ac\ubcf4\ub2e4 \uc911\uc2dc\ud558\ub294 4\uac00\uc9c0 \uc0ac\ud68c\uc801 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc758 \ubb38\ud654, \uc5ed\uc0ac, \uc804\ud1b5, \uaddc\ubc94"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \uacf5\ub3d9\uccb4\uc758 \uc720\uc9c0\uc640 \ubc1c\uc804\uc744 \uc704\ud574 \uad6c\uc131\uc6d0\uc778 \uac1c\uc778\uc5d0\uac8c \uac15\uc870\ud558\ub294 \uac83\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc5d0 \ub300\ud55c \ucc45\uc784\uacfc \uc758\ubb34\ub97c \ub2e4\ud558\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \uad6d\uac00\uc758 \uc911\ub9bd\uc131\uc5d0 \ub300\ud574 \ube44\ud310\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\uac00 \uc911\ub9bd\uc744 \uc720\uc9c0\ud558\ub294 \uac83\uc740 \uacf5\ub3d9\uccb4\uc758 \ubaa9\ud45c\ub97c \ud3ec\uae30\ud558\ub294 \uac83\uacfc \uac19\ub2e4\uace0 \ubcf4\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \ubc14\ub77c\ubcf4\ub294 '\uac1c\uc778'\uc758 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc758 \uc5ed\uc0ac\uc640 \ubb38\ud654\ub97c \uc804\uc218\ubc1b\uc73c\uba70 \uc18c\uc18d\uac10\uacfc \uc815\uccb4\uc131\uc744 \ud615\uc131\ud558\ub294 \uc874\uc7ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \ubc14\ub77c\ubcf4\ub294 '\uc0ac\ud68c(\uad6d\uac00)'\uc758 \uacb0\ud569 \ud615\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uac1c\uc778\uc774 \uc720\uae30\uccb4\uc801\uc73c\ub85c \uacb0\ud569\ud558\uc5ec \ub9cc\ub4e4\uc5b4\uc9c4 \uc9d1\ud569\uccb4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \uac1c\uc778\uc758 '\uc758\ubbf8 \uc788\ub294 \uc0b6' \ub610\ub294 '\uc88b\uc740 \uc0b6'\uc740 \ubb34\uc5c7\uacfc \ubd84\ub9ac\ub420 \uc218 \uc5c6\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4 \ubc0f \uacf5\ub3d9\uccb4\uc5d0 \ub300\ud55c \uc18c\uc18d\uac10"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc758 \ubaa9\ud45c\ub97c \uc9c0\ub098\uce58\uac8c \uac15\uc870\ud560 \ub54c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc8fc\uc694 \ubd80\uc791\uc6a9 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uac1c\uc778\uc758 \uc790\uc720\uc640 \uad8c\ub9ac \uce68\ud574 \ubc0f \ud76c\uc0dd \uac15\uc694\n2. \uc5f0\uace0\uc8fc\uc758 \uc2ec\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud608\uc5f0, \uc9c0\uc5f0, \ud559\uc5f0 \ub4f1 \uc804\ud1b5\uc801 \uc0ac\ud68c\uad00\uacc4\ub97c \uc6b0\uc120\uc2dc\ud558\uac70\ub098 \uc911\uc694\ud558\uac8c \uc5ec\uae30\ub294 \ud0dc\ub3c4\ub97c \uc77c\uceeb\ub294 \uc6a9\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uace0\uc8fc\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ubb34\uc6d0\uc774 \uac1c\uc778\uc758 \ub2a5\ub825\uc774\ub098 \uac1d\uad00\uc801 \uacf5\uc815\uc131\uacfc \ubb34\uad00\ud558\uac8c \uace0\ud5a5 \uc608\uc0b0\ub9cc \uc99d\uc561\ud574 \uc8fc\ub294 \uc0ac\ub840\ub294 \uacf5\ub3d9\uccb4\uc8fc\uc758\uc758 \uc5b4\ub5a4 \ud55c\uacc4\ub97c \ubcf4\uc5ec\uc8fc\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uace0\uc8fc\uc758\ub85c \uc778\ud574 \uc11c\ub85c \ub2e4\ub978 \uacf5\ub3d9\uccb4 \uad6c\uc131\uc6d0 \uac04\uc758 \ubd88\ud3c9\ub4f1\uc774 \ucd08\ub798\ub418\ub294 \ubb38\uc81c\uc810"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\ud0a8\ud0c0\uc774\uc5b4(MacIntyre)\uc5d0 \ub530\ub974\uba74 \uc0ac\ub78c\uc774 \uc790\uc2e0\uc758 \uc815\uccb4\uc131\uc744 \ud615\uc131\ud558\uace0 \uc0b6\uc758 \uc774\uc0c1\uc744 \uad6c\uc131\ud558\ub294 \uadfc\uc6d0\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4 \uc18d\uc5d0\uc11c\uc758 \uc0ac\ud68c\uc801 \uc5ed\ud560\uacfc \uacf5\ub3d9\uccb4\uc758 \uc5ed\uc0ac\uc801 \ud750\ub984 \ubc0f \uc804\ud1b5 \uc720\uc0b0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc648\ucc98(Walzer)\uac00 \uc81c\uc2dc\ud55c, \uc0ac\ud68c\uc801 \uac00\uce58\uac00 \uac01 \uacf5\ub3d9\uccb4\uc758 \ubb38\ud654\uc801 \ub9e5\ub77d\uc5d0 \ub530\ub77c \ubd84\ubc30\ub418\uc5b4\uc57c \ud55c\ub2e4\ub294 \uc815\uc758\uad00\uc758 \ud575\uc2ec \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc6d0\uc801 \ud3c9\ub4f1 (Pluralistic equality)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc648\ucc98\uc5d0 \ub530\ub974\uba74 '\ub2e4\uc6d0\uc801 \ud3c9\ub4f1'\uc774 \uc2e4\ud604\ub418\ub294 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\ub85c \ub2e4\ub978 \uc0ac\ud68c\uc801 \uac00\uce58\ub4e4\uc774 \ud0c0 \uc601\uc5ed\uc744 \uce68\ubc94\ud558\uc9c0 \uc54a\uace0 \uac01\uac01\uc758 \uace0\uc720\ud55c \uc601\uc5ed \uc548\uc5d0 \uba38\ubb34\ub97c \ub54c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uacfc \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c '\uc0ac\ud68c'\ub97c \ubc14\ub77c\ubcf4\ub294 \uad00\uc810\uc758 \uacb0\uc815\uc801 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\ub294 \uc0ac\ud68c\ub97c '\uac1c\uc778\ub4e4\uc758 \ub2e8\uc21c\ud55c \uc9d1\ud569\uccb4/\uacc4\uc57d\ubb3c'\ub85c \ubcf4\uace0, \uacf5\ub3d9\uccb4\uc8fc\uc758\ub294 '\uc720\uae30\uccb4\uc801\uc73c\ub85c \uacb0\ud569\ub41c \uc9d1\ud569\uccb4'\ub85c \ubcf8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uacfc \uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c '\uad6d\uac00\uc758 \uc5ed\ud560'\uc5d0 \ub300\ud55c \uc785\uc7a5\uc758 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\ub294 \uad6d\uac00\uc758 \uc911\ub9bd\uc131\uc744 \uac15\uc870\ud558\uc9c0\ub9cc, \uacf5\ub3d9\uccb4\uc8fc\uc758\ub294 \uad6d\uac00\uac00 \uacf5\ub3d9\uccb4 \ubaa9\ud45c \uc2e4\ud604\uc744 \uc704\ud574 \uac1c\uc778\uc758 \uc0b6\uc5d0 \uac1c\uc785\ud560 \uc218 \uc788\ub2e4\uace0 \ubcf8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uac1c\uc778\uc774 \uc18c\uc18d\ub41c \uacf5\ub3d9\uccb4\ub85c\ubd80\ud130 \ub3c5\ub9bd\ub418\uc5b4 \uc2a4\uc2a4\ub85c \uacb0\uc815\ud558\ub294 _____ \uc874\uc7ac\ub77c\uace0 \ubcf8\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc728\uc801"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc740 \uac1c\uc778\uc774 \uc18d\ud55c \uacf5\ub3d9\uccb4\ub97c \uae30\uc900\uc73c\ub85c \uac1c\uc778\uc744 \ud3c9\uac00\ud558\uc5ec \ubd88\ud3c9\ub4f1\uc744 \uc57c\uae30\ud558\ub294 _____\uc758 \uc704\ud5d8\uc131\uc744 \uc9c0\ub2cc\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uace0\uc8fc\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub864\uc2a4\ub294 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc758 \ub354 \ud070 \uc774\uc775\uc744 \uc704\ud574\uc11c\ub77c \ud560\uc9c0\ub77c\ub3c4 \uc18c\uc218\uc758 _____\ub97c \ube7c\uc557\ub294 \uac83\uc740 \uc815\uc758\ub86d\uc9c0 \uc54a\ub2e4\uace0 \uc8fc\uc7a5\ud558\uc600\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720 (\uae30\ubcf8\uc801 \uc790\uc720)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc9c1\uc758 \uc790\uc720 \uc9c0\uc0c1\uc8fc\uc758\uc5d0 \ub530\ub974\uba74, \uc18c\uc720\ubb3c\uc758 \ucde8\ub4dd\uacfc \uc774\uc804 \uacfc\uc815\uc5d0\uc11c _____\uac00 \ubc1c\uc0dd\ud560 \uacbd\uc6b0 \uc774\ub97c \uad50\uc815\ud574\uc57c \ud55c\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\uc815\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc648\ucc98\ub294 \ubaa8\ub4e0 \uc0ac\ud68c\uc5d0\uc11c \ub3d9\uc77c\ud558\uac8c \uc911\uc694\ud558\ub2e4\uace0 \uc778\uc815\ub418\ub294 \uac00\uce58\ub294 \uc5c6\uc73c\ubbc0\ub85c \uac00\uce58 \ubd84\ubc30 \uc2dc \uacf5\ub3d9\uccb4\uc758 \ubb38\ud654\uc801 _____\uacfc \ucc28\uc774\ub97c \uace0\ub824\ud574\uc57c \ud55c\ub2e4\uace0 \uc8fc\uc7a5\ud588\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc218\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1 \ud655\uc0b0 \uc2dc '\ub9c8\uc2a4\ud06c \ucc29\uc6a9 \uc758\ubb34\ud654'\uac00 \uacf5\uacf5 \uc548\uc804\uacfc \uacf5\ub3d9\uccb4 \uac74\uac15 \ubcf4\ud638\ub97c \uc704\ud574 \ud544\uc694\ud558\ub2e4\uace0 \uc8fc\uc7a5\ud558\ub294 \uc785\uc7a5\uc740 \uc5b4\ub5a4 \uc815\uc758\uad00\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1 \ud655\uc0b0 \uc2dc '\ub9c8\uc2a4\ud06c \ucc29\uc6a9 \uc758\ubb34\ud654'\uac00 \uac1c\uc778\uc758 \uae30\ubcf8\uc801\uc778 \uc120\ud0dd\uc758 \uc790\uc720\ub97c \uc81c\ud55c\ud558\uace0 \uc704\ud611\ud55c\ub2e4\uace0 \ubc18\ub300\ud558\ub294 \uc785\uc7a5\uc740 \uc5b4\ub5a4 \uc815\uc758\uad00\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc544\ub178 \uc5f0\uc8fc\uc790 A\uc528\uac00 \ub2a6\uc740 \ubc24 \uc774\uc6c3\uc758 \uc218\ucc28\ub840 \uc790\uc81c \uc694\uccad\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \uc0c8\ubcbd\uae4c\uc9c0 \ud53c\uc544\ub178\ub97c \uce5c \uc0ac\ub840\ub294 \uc790\uc720\uc8fc\uc758\uc758 \uc5b4\ub5a4 \ubb38\uc81c\uc810\uc744 \ubcf4\uc5ec\uc8fc\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc758 \uc790\uc720\uc640 \uad8c\ub9ac\ub9cc\uc744 \ubb34\uc81c\ud55c \ucd94\uad6c\ud558\uc5ec \ud0c0\uc778\uc758 \uad8c\ub9ac\ub97c \uce68\ud574\ud558\ub294 \uadf9\ub2e8\uc801 \uc774\uae30\uc8fc\uc758"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c \ub2a6\uc740 \ubc24 \ud53c\uc544\ub178 \uc5f0\uc2b5 \uc18c\uc74c\ucc98\ub7fc \ud0c0\uc778\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\ub294 \ud589\uc704\uc5d0 \ub300\ud574 \ucde8\ud558\ub294 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc778\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\ub294 \ud589\uc704\ub294 \uc790\uc720\ub77c\ub3c4 \uc81c\ud55c\ub420 \uc218 \uc788\ub2e4\uace0 \ubcf8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub864\uc2a4\uac00 \uc81c\uc2dc\ud55c \uc815\uc758\uc758 \uc6d0\uce59\uc5d0\uc11c \uc0ac\ud68c\uc801 \ubd88\ud3c9\ub4f1\uc774 \ud5c8\uc6a9\ub418\uae30 \uc704\ud55c \ub450 \uac00\uc9c0 \ud575\uc2ec \uc870\uac74\uc744 \uba85\uce6d\uc73c\ub85c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc28\ub4f1\uc758 \uc6d0\uce59 (\ucd5c\uc18c \uc218\ud61c\uc790 \ucd5c\ub300 \uc774\uc775), \uae30\ud68c \uade0\ub4f1\uc758 \uc6d0\uce59"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc9c1\uc758 \uc785\uc7a5\uc5d0\uc11c \uad6d\uac00\uac00 \uac1c\uc778\uc758 \uc7ac\uc0b0\uc744 \uc138\uae08 \ub4f1\uc73c\ub85c \uac15\uc81c \uc7ac\ubd84\ubc30\ud558\ub294 \uac83\uc5d0 \ucc2c\uc131\ud560 \uac83\uc778\uac00, \ubc18\ub300\ud560 \uac83\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc18\ub300\ud55c\ub2e4 (\ucd5c\uc18c \uad6d\uac00\ub97c \ub118\uc5b4\uc11c\ub294 \uc7ac\ubd84\ubc30 \uc815\ucc45\uc740 \uac1c\uc778\uc758 \uc18c\uc720 \uad8c\ub9ac\ub97c \uce68\ud574\ud55c\ub2e4\uace0 \ubd04)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\ud0a8\ud0c0\uc774\uc5b4\ub294 \uc778\uac04\uc744 \ub204\uad70\uac00\uc758 \uc544\ub4e4, \ub538, \uc2dc\ubbfc, \uce5c\uc871 \ub4f1\uc758 \uc5ed\ud560\uc744 \ub9e1\uc740 \uc874\uc7ac\ub85c \ubcf4\uc558\ub2e4. \uc774\ub97c \ubc14\ud0d5\uc73c\ub85c \uc778\uac04\uc758 \uc815\uccb4\uc131 \ud615\uc131 \ud2b9\uc9d5\uc744 \ud55c \ubb38\uc7a5\uc73c\ub85c \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc740 \uacf5\ub3d9\uccb4 \uc18d\uc5d0\uc11c \ubd80\uc5ec\ubc1b\uc740 \uc0ac\ud68c\uc801 \uc5ed\ud560\uacfc \uc5ed\uc0ac\uc801 \uc804\ud1b5\uc744 \ud1b5\ud574 \uc815\uccb4\uc131\uc744 \ud615\uc131\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc648\ucc98\uc758 \uc815\uc758\uad00\uc5d0 \ub530\ub974\uba74 \ub3c8, \uad8c\ub825, \ud559\ubc8c\uacfc \uac19\uc740 \uc0ac\ud68c\uc801 \uac00\uce58\ub97c \ubd84\ubc30\ud560 \ub54c \ub2e8\uc77c\ud55c \uae30\uc900\uc744 \uc801\uc6a9\ud560 \uc218 \uc5c6\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uac00\uce58\ub9c8\ub2e4 \uace0\uc720\ud55c \uc601\uc5ed\uc774 \uc874\uc7ac\ud558\uba70, \uac01 \uacf5\ub3d9\uccb4\uc758 \uc5ed\uc0ac\uc801\u00b7\ubb38\ud654\uc801 \ud2b9\uc218\uc131\uc774 \ub2e4\ub974\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc640 \uacf5\ub3d9\uccb4\uc8fc\uc758 \uc911 \"\uac1c\uc778\uc740 \uacf5\ub3d9\uccb4\uc758 \uc720\uc0b0\uacfc \uc758\ubb34\ub97c \ubb3c\ub824\ubc1b\ub294 \uc5f0\uace0\ub97c \uac00\uc9c4 \uc874\uc7ac\"\ub77c\uace0 \ud30c\uc545\ud558\ub294 \uad00\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc640 \uacf5\ub3d9\uccb4\uc8fc\uc758 \uc911 \"\uac1c\uc778 \uac04\uc758 \ud569\uc758\uc640 \uacc4\uc57d\uc73c\ub85c \ub9cc\ub4e4\uc5b4\uc9c4 \uac83\uc774 \uad6d\uac00\uc774\ub2e4\"\ub77c\uace0 \ud30c\uc545\ud558\ub294 \uad00\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c '\ubb34\uc9c0\uc758 \ubca0\uc77c'\uc774\ub780 \ud569\uc758 \ub2f9\uc0ac\uc790\ub4e4\uc774 \ubb34\uc5c7\uc744 \ubaa8\ub974\ub294 \uc0c1\ud0dc\ub97c \ub73b\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc758 \uc790\uc5f0\uc801 \uc7ac\ub2a5, \uc0ac\ud68c\uc801 \uc9c0\uc704, \uacc4\uce35, \uac00\uce58\uad00 \ub4f1 \uc790\uc2e0\uc758 \uc6b0\uc5f0\uc801 \uc870\uac74"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc9c1\uc774 \ub9d0\ud55c \uc18c\uc720\uad8c\uc758 3\uac00\uc9c0 \ud575\uc2ec \uc694\uc18c(\uc6d0\ub9ac)\ub294 \ucde8\ub4dd\uc758 \uc815\ub2f9\uc131, \uc774\uc804\uc758 \uc815\ub2f9\uc131, \uadf8\ub9ac\uace0 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\uc815\uc758\uc758 \uad50\uc815 (\uad50\uc815\uc758 \uc815\ub2f9\uc131)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub3d9\uccb4\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc774 \uc9c0\ub098\uce60 \uacbd\uc6b0 \uac1c\uc778\uc5d0\uac8c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \ud3d0\ub2e8\uc740 \uac1c\uc778\uc758 \uad8c\ub9ac \uce68\ud574\uc640 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc758 \ud76c\uc0dd \uac15\uc694"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uace0\uc8fc\uc758\uc758 \uc8fc\uc694 \uc6d0\uc778\uc774 \ub418\ub294 \uc804\ud1b5\uc801 \uc0ac\ud68c\uad00\uacc4 \uc5f0\uace0 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud608\uc5f0, \uc9c0\uc5f0, \ud559\uc5f0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc648\ucc98\uac00 \uacbd\uacc4\ud55c \ud604\uc0c1\uc73c\ub85c, \ud558\ub098\uc758 \uc0ac\ud68c\uc801 \uac00\uce58\uac00 \ub2e4\ub978 \uc601\uc5ed\uc758 \uac00\uce58\uae4c\uc9c0 \uc9c0\ubc30\ud558\uac70\ub098 \uce68\ubc94\ud558\ub294 \uc0c1\ud669\uc744 \ub9c9\uc558\uc744 \ub54c \uc774\ub8e8\uc5b4\uc9c0\ub294 \ud3c9\ub4f1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc6d0\uc801 \ud3c9\ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc8fc\uc758\uc801 \uc815\uc758\uad00\uc5d0\uc11c '\uc815\uc758\ub86d\ub2e4'\uace0 \ud3c9\uac00\ud558\ub294 \ud575\uc2ec \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc758 \uc790\uc720\uc640 \uad8c\ub9ac\ub97c \ucd5c\ub300\ud55c \ubcf4\uc7a5\ud558\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
