        {
          "text": "\uc790\uc0b0 \uc6b4\uc6a9 \uacb0\uacfc\uc640 \uad00\uacc4\uc5c6\uc774 \uc5b8\uc81c\ub098 \uace0\uc815\ub41c \uc774\uc790\ub97c \ud22c\uc790\uc790\uc5d0\uac8c \uc9c0\uae09\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud380\ub4dc\ub294 \uc6b4\uc6a9 \uacb0\uacfc\ub85c \ubc1c\uc0dd\ud55c \uc218\uc775\uc744 \ub3cc\ub824\uc8fc\ub294 \uc0c1\ud488\uc73c\ub85c \uace0\uc815 \uc774\uc790\ub97c \uc9c0\uae09\ud558\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\uc804\ubb38 \uae30\uad00\uc774 \uc6b4\uc6a9\ud558\ubbc0\ub85c \ubcc4\ub3c4\uc758 \uc218\uc218\ub8cc\uac00 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud380\ub4dc\ub294 \uc804\ubb38\uac00\uac00 \uc6b4\uc6a9\ud574 \uc8fc\ub294 \ub300\uac00\ub85c \ubcc4\ub3c4\uc758 \uc218\uc218\ub8cc\ub97c \ub0a9\ubd80\ud574\uc57c \ud55c\ub2e4."
        }
      ],
      "hint": "\ud22c\uc790 \ubc29\uc2dd(\uc9c1\uc811 vs \uac04\uc811)\uacfc \uc804\ubb38\uac00 \uc6b4\uc6a9\uc5d0 \ub530\ub978 \uc704\ud5d8 \ubc0f \ube44\uc6a9 \uc720\ubb34\ub97c \uccb4\ud06c\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae30\ud0c0 \uae08\uc735 \uc790\uc0b0 \uc911 '\uc5f0\uae08'\uacfc '\ubcf4\ud5d8'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5f0\uae08\uc740 \uc740\ud1f4 \ub4f1\uc73c\ub85c \uc18c\ub4dd\uc774 \uc904\uc5b4\ub4dc\ub294 \ub178\ud6c4 \uc0dd\ud65c\uc758 \uc548\uc815\uc744 \uc704\ud574 \uc77c\uc815 \uae08\uc561\uc744 \uc801\ub9bd\ud558\ub294 \uc0c1\ud488\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub178\ud6c4 \uc0dd\ud65c\uc758 \uc548\uc815\uc744 \uc704\ud574 \uc18c\ub4dd\uc774 \uc788\ub294 \ub3d9\uc548 \uc801\ub9bd\ud574 \ub450\uc5c8\ub2e4\uac00 \uc9c0\uae09\ubc1b\ub294 \uc0c1\ud488\uc774\ub2e4."
        },
        {
          "text": "\ubcf4\ud5d8\uc740 \ubbf8\ub798\uc758 \uc704\ud5d8\uc5d0 \ub300\ube44\ud558\uae30 \uc704\ud55c \uc0c1\ud488\uc73c\ub85c \uc218\uc775\uc131\ubcf4\ub2e4\ub294 \ubcf4\uc7a5\uc5d0 \ucd08\uc810\uc744 \ub454\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf4\ud5d8\uc740 \ud654\uc7ac, \uc9c8\ubcd1 \ub4f1 \uc704\ud5d8 \ub300\ube44\uac00 \uc8fc\ubaa9\uc801\uc774\ubbc0\ub85c \ud22c\uc790 \uc218\uc775\ubcf4\ub2e4 \uc704\ud5d8 \ubcf4\uc7a5\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd98\ub2e4."
        },
        {
          "text": "\uc5f0\uae08\uc740 \uc6b4\uc6a9 \uc8fc\uccb4 \ubc0f \uc131\uaca9\uc5d0 \ub530\ub77c \uad6d\ubbfc\uc5f0\uae08, \ud1f4\uc9c1 \uc5f0\uae08, \uac1c\uc778\uc5f0\uae08 \ub4f1\uc73c\ub85c \uad6c\ubd84\ub41c\ub2e4.",
