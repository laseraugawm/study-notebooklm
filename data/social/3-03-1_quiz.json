{
  "title": "\uae08\uc735\uc790\uc0b0 \ud034\uc988",
  "questions": [
    {
      "question": "\ub2e4\uc74c \uc911 \uc81c\uc2dc\ub41c \uc790\uc0b0\uc758 \ubd84\ub958\uc5d0\uc11c '\uc2e4\ubb3c \uc790\uc0b0'\uc5d0 \ud574\ub2f9\ud558\uc9c0 \uc54a\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud1a0\uc9c0",
          "isCorrect": false,
          "rationale": "\ud1a0\uc9c0\ub294 \ub300\ud45c\uc801\uc778 \uc720\ud615\uc758 \uc2e4\ubb3c \uc790\uc0b0\uc774\ub2e4."
        },
        {
          "text": "\uac74\ubb3c",
          "isCorrect": false,
          "rationale": "\uac74\ubb3c\uc740 \uad6c\uccb4\uc801\uc778 \ud615\ud0dc\uac00 \uc788\ub294 \uc2e4\ubb3c \uc790\uc0b0\uc5d0 \uc18d\ud55c\ub2e4."
        },
        {
          "text": "\ucc44\uad8c",
          "isCorrect": true,
          "rationale": "\ucc44\uad8c\uc740 \uc608\uae08, \uc8fc\uc2dd \ub4f1\uacfc \ud568\uaed8 \uae08\uc735 \uc790\uc0b0\uc73c\ub85c \ubd84\ub958\ub41c\ub2e4."
        },
        {
          "text": "\uc608\uc220\ud488",
          "isCorrect": false,
          "rationale": "\uc608\uc220\ud488\uc740 \uae08\uc804\uc801 \uac00\uce58\ub97c \uc9c0\ub2cc \uc2e4\ubb3c \uc790\uc0b0\uc758 \ud55c \uc885\ub958\uc774\ub2e4."
        }
      ],
      "hint": "\uae08\uc735 \uae30\uad00\uc774\ub098 \uc2dc\uc7a5\uc5d0\uc11c \uac70\ub798\ub418\ub294 \uae08\uc735 \uad8c\ub9ac\uac00 \uc544\ub2c8\ub77c \uad6c\uccb4\uc801\uc778 \ubb3c\uac74 \ubc0f \uc2e4\uccb4\ub85c \uc874\uc7ac\ud558\ub294 \uc790\uc0b0\uc778\uc9c0 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc694\uad6c\ubd88 \uc608\uae08\uacfc \uc800\ucd95\uc131 \uc608\uae08\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc694\uad6c\ubd88 \uc608\uae08\uc740 \uc785\ucd9c\uae08\uc774 \uc790\uc720\ub86d\uc9c0\ub9cc \uc800\ucd95\uc131 \uc608\uae08\uc5d0 \ube44\ud574 \uc774\uc790 \uc218\uc775\uc774 \ub0ae\uc740 \ud3b8\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc694\uad6c\ubd88 \uc608\uae08\uc740 \uac70\ub798\uc758 \ud3b8\uc758\uc131\uc744 \ubaa9\uc801\uc73c\ub85c \ud558\uc5ec \uc790\uc720\ub86d\uac8c \uc785\ucd9c\uae08\ud560 \uc218 \uc788\uc73c\ub098 \uc774\uc790\uc728\uc774 \ub0ae\ub2e4."
        },
        {
          "text": "\uc694\uad6c\ubd88 \uc608\uae08\uc740 \ud22c\uc790\ub97c \uc8fc\ub41c \ubaa9\uc801\uc73c\ub85c \ud558\uc5ec \uc0c1\ub300\uc801\uc73c\ub85c \ub192\uc740 \uc774\uc790\uac00 \uc9c0\uae09\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud22c\uc790\ub97c \uc8fc\ub41c \ubaa9\uc801\uc73c\ub85c \ud558\uc5ec \uc0c1\ub300\uc801\uc73c\ub85c \ub192\uc740 \uc774\uc790\uac00 \ubd99\ub294 \uac83\uc740 \uc800\ucd95\uc131 \uc608\uae08\uc774\ub2e4."
        },
        {
          "text": "\uc815\uae30 \uc608\uae08\uacfc \uc815\uae30 \uc801\uae08\uc740 \uac70\ub798\uc758 \ud3b8\uc758\ub97c \uc8fc\ub41c \ubaa9\uc801\uc73c\ub85c \ud558\ub294 \uc694\uad6c\ubd88 \uc608\uae08\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\uae30 \uc608\uae08\uacfc \uc815\uae30 \uc801\uae08\uc740 \uc694\uad6c\ubd88 \uc608\uae08\uc774 \uc544\ub2cc \uc800\ucd95\uc131 \uc608\uae08\uc758 \ub300\ud45c\uc801 \uc0c1\ud488\uc774\ub2e4."
        },
        {
          "text": "\uc800\ucd95\uc131 \uc608\uae08\uc740 \uc5b8\uc81c\ub4e0\uc9c0 \uc790\uc720\ub86d\uac8c \uc785\ucd9c\uae08\ud560 \uc218 \uc788\uc5b4 \uc720\ub3d9\uc131\uc774 \ub192\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc720\ub85c\uc6b4 \uc785\ucd9c\uae08\uc774 \uac00\ub2a5\ud558\uc5ec \uac70\ub798 \ud3b8\uc758\uc131\uc744 \uc81c\uacf5\ud558\ub294 \uc608\uae08\uc740 \uc694\uad6c\ubd88 \uc608\uae08\uc774\ub2e4."
        }
      ],
      "hint": "\uc790\uae08\uc744 \uc778\ucd9c\ud560 \uc218 \uc788\ub294 \uc790\uc720\ub3c4(\ud3b8\uc758\uc131)\uc640 \uc0c1\ud488\ubcc4 \uc774\uc790 \uc218\uc775 \uac04\uc758 \uad00\uacc4\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38\uc5d0 \uc81c\uc2dc\ub41c \uc608\uae08\uc790 \ubcf4\ud638 \uc81c\ub3c4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\ub9cc\uc744 \uace0\ub978 \uac83\uc740?\n\n(\u3131) \uc608\uae08\uc790 \ubcf4\ud638 \uc81c\ub3c4\ub294 \uc608\uae08\ubcf4\ud5d8\uacf5\uc0ac\uac00 \uae08\uc735 \uae30\uad00\uc73c\ub85c\ubd80\ud130 \uc608\uae08 \ubcf4\ud5d8\ub8cc\ub97c \ubc1b\uc544 \uc6b4\uc601\ud55c\ub2e4.\n(\u3134) \ubcf4\ud638 \ud55c\ub3c4\ub294 \ub3d9\uc77c \uae08\uc735 \uae30\uad00 \ub0b4\uc5d0\uc11c \uc6d0\uae08\ub9cc \ud569\uc0b0\ud558\uc5ec 1\uc778\ub2f9 \ucd5c\ub300 1\uc5b5 \uc6d0\uc774\ub2e4.\n(\u3137) \uae08\uc735 \uae30\uad00\ubcc4\ub85c \uac01\uac01 \uc801\uc6a9\ub418\uba70, \ud30c\uc0b0 \ub4f1\uc73c\ub85c \uc608\uae08\uc744 \uc9c0\uae09\ud560 \uc218 \uc5c6\uc744 \ub54c \uc9c0\uae09\ub41c\ub2e4.\n(\u3139) \uc608\uae08\uc790 \ubcf4\ud638 \uc81c\ub3c4\uac00 \uc801\uc6a9\ub418\ubbc0\ub85c \uc815\uae30 \uc608\uae08\uc740 \uc218\uc775\uc131\uc774 \ub9e4\uc6b0 \ub192\uc740 \ud3b8\uc774\ub2e4.",
      "answerOptions": [
        {
          "text": "(\u3131), (\u3134)",
          "isCorrect": false,
          "rationale": "(\u3134)\uc740 \uc6d0\uae08\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc774\uc790\ub97c \ud569\ud558\uc5ec 1\uc5b5 \uc6d0\uae4c\uc9c0 \uc9c0\uae09\ub418\ubbc0\ub85c \uc798\ubabb\ub41c \uc124\uba85\uc774\ub2e4."
        },
        {
          "text": "(\u3131), (\u3137)",
          "isCorrect": true,
          "rationale": "\uc608\uae08\ubcf4\ud5d8\uacf5\uc0ac\ub294 \ud3c9\uc18c \uc801\ub9bd\ud55c \uae30\uae08\uc73c\ub85c \ud30c\uc0b0 \uc2dc \uae08\uc735 \uae30\uad00\ubcc4 1\uc778\ub2f9 \ucd5c\ub300 1\uc5b5 \uc6d0(\uc6d0\uae08+\uc774\uc790)\uae4c\uc9c0 \ubcf4\ud638\ud55c\ub2e4."
        },
        {
          "text": "(\u3134), (\u3139)",
          "isCorrect": false,
          "rationale": "(\u3134)\uc740 \uc774\uc790\uac00 \ud569\uc0b0\ub418\ubbc0\ub85c \ud2c0\ub838\uace0, (\u3139)\uc758 \uc608\uae08\uc740 \uc774\uc790\uc728\uc774 \ub192\uc9c0 \uc54a\uc544 \ud070 \uc218\uc775\uc744 \uae30\ub300\ud558\uae30 \uc5b4\ub835\ub2e4."
        },
        {
          "text": "(\u3137), (\u3139)",
          "isCorrect": false,
          "rationale": "(\u3139) \uc608\uae08\uc740 \uc548\uc804\uc131\uc774 \ub192\uc740 \ub300\uc2e0 \uc218\uc775\uc131\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \ub0ae\ub2e4."
        }
      ],
      "hint": "\ubcf4\ud638 \ud55c\ub3c4\uae08\uc561\uc5d0 \uc774\uc790\uac00 \ud3ec\ud568\ub418\ub294\uc9c0\uc758 \uc5ec\ubd80\uc640 \uc608\uae08\uc758 \uc77c\ubc18\uc801\uc778 \uc218\uc775\uc131 \uc218\uc900\uc744 \uac80\ud1a0\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc8fc\uc2dd\uacfc \ucc44\uad8c\uc758 \ucc28\uc774\uc810\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc8fc\uc2dd \ud22c\uc790\uae08\uc740 \ud68c\uc0ac\uc758 \uc790\ubcf8\uae08\uc774 \ub418\uace0, \ucc44\uad8c \ud22c\uc790\uae08\uc740 \ud68c\uc0ac\uc758 \ubd80\ucc44(\ube5a)\uac00 \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc8fc\uc2dd\uc740 \uc9c0\ubd84\uc744 \ud45c\uc2dc\ud558\uc5ec \uc790\ubcf8\uae08\uc774 \ub418\uba70, \ucc44\uad8c\uc740 \ub300\ucd9c \uc99d\uc11c\ub85c\uc11c \ubd80\ucc44\uac00 \ub41c\ub2e4."
        },
        {
          "text": "\uc8fc\uc2dd \ud22c\uc790\uc790\ub294 \ud68c\uc0ac\uc758 \uc9c0\ubd84\uc744 \uc18c\uc720\ud55c \uc8fc\uc8fc\uac00 \ub418\uace0, \ucc44\uad8c \ud22c\uc790\uc790\ub294 \ucc44\uad8c\uc790\uac00 \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc8fc\uc2dd \ud22c\uc790\uc790\ub294 \uc8fc\uc8fc\ub85c\uc11c \ubc30\ub2f9\uc744 \ubc1b\uace0 \ucc44\uad8c \ud22c\uc790\uc790\ub294 \uc6d0\uae08\uacfc \uc774\uc790\ub97c \uc9c0\uae09\ubc1b\ub294\ub2e4."
        },
        {
          "text": "\uc8fc\uc2dd\uacfc \ucc44\uad8c \ubaa8\ub450 \ud574\ub2f9 \ubc1c\ud589 \uae30\uad00\uc774 \ud30c\uc0b0\ud560 \uacbd\uc6b0 \ud22c\uc790 \uc6d0\uae08 \uc190\uc2e4 \uc704\ud5d8\uc774 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\uc5c5\uc774\ub098 \ucc44\uad8c \ubc1c\ud589 \uae30\uad00\uc774 \ud30c\uc0b0\ud558\uba74 \ub450 \uc790\uc0b0 \ubaa8\ub450 \uc6d0\uae08\uc744 \uc783\uc744 \uac00\ub2a5\uc131\uc774 \uc874\uc7ac\ud55c\ub2e4."
        },
        {
          "text": "\ucc44\uad8c\uc740 \uc57d\uc815\ub41c \ub9cc\uae30\uc77c\uae4c\uc9c0 \ubc18\ub4dc\uc2dc \ubcf4\uc720\ud574\uc57c\ub9cc \ud558\uba70 \ub9cc\uae30\uc77c \uc804 \ub9e4\ub9e4\ub294 \ubd88\uac00\ub2a5\ud558\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucc44\uad8c\uc740 \ub9cc\uae30\uc77c \uc804\uc774\ub77c\ub3c4 \uc0b4 \ub54c\ubcf4\ub2e4 \ub192\uc740 \uac00\uaca9\uc5d0 \ud314\uc544 \uc218\uc775\uc744 \ub0bc \uc218 \uc788\ub2e4."
        }
      ],
      "hint": "\ucc44\uad8c\uc744 \ub9cc\uae30 \uc804\uc5d0 \ud0c0\uc778\uc5d0\uac8c \uac70\ub798(\ub9e4\ub9e4)\ud560 \uc218 \uc788\ub294\uc9c0 \uc5ec\ubd80\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc8fc\uc2dd(Stock) \ud22c\uc790\uc790\uac00 \uae30\ub300\ud560 \uc218 \uc788\ub294 \ub450 \uac00\uc9c0 \ub300\ud45c\uc801\uc778 \uc218\uc775 \ud615\ud0dc\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uace0\uc815 \uc774\uc790 \uc218\uc775\uacfc \uc608\uae08\uc790 \ubcf4\ud638\uae08",
          "isCorrect": false,
          "rationale": "\uace0\uc815 \uc774\uc790\ub294 \uc608\uae08\uc774\ub098 \ucc44\uad8c\uc758 \uc218\uc775 \ud615\ud0dc\uc774\uba70 \uc608\uae08\uc790 \ubcf4\ud638\uae08\uc740 \ud30c\uc0b0 \uc2dc\uc758 \ubcf4\uc0c1\uae08\uc774\ub2e4."
        },
        {
          "text": "\uc774\uc775 \ubc30\ub2f9\uae08\uacfc \uc8fc\uac00 \uc0c1\uc2b9\uc5d0 \ub530\ub978 \uc2dc\uc138 \ucc28\uc775",
          "isCorrect": true,
          "rationale": "\uc8fc\uc8fc\ub294 \uacbd\uc601 \uc774\uc775\uc758 \uc77c\ubd80\ub97c \ubc30\ub2f9\ubc1b\uac70\ub098 \uc8fc\uc2dd \uac00\uaca9 \uc0c1\uc2b9 \uc2dc \ub9e4\ub3c4\ud558\uc5ec \uc2dc\uc138 \ucc28\uc775\uc744 \uc62c\ub9b4 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\uc815\ubd80 \ubcf4\uc870\uae08\uacfc \uc218\uc218\ub8cc \ud658\uae09\uae08",
          "isCorrect": false,
          "rationale": "\uc815\ubd80 \ubcf4\uc870\uae08\uc774\ub098 \uc218\uc218\ub8cc \ud658\uae09\uc740 \uc8fc\uc2dd \ud22c\uc790\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc8fc\ub41c \uc218\uc775\uc774 \uc544\ub2c8\ub2e4."
        },
        {
          "text": "\uc704\ud5d8 \ubcf4\uc7a5\uae08\uacfc \ub9cc\uae30 \uc6d0\uae08 \ud658\uae09\uae08",
          "isCorrect": false,
          "rationale": "\uc704\ud5d8 \ubcf4\uc7a5\uae08\uc740 \ubcf4\ud5d8\uc758 \ud2b9\uc9d5\uc774\uba70, \ub9cc\uae30 \uc6d0\uae08 \ud658\uae09\uc740 \ucc44\uad8c\uc774\ub098 \uc800\ucd95\uc131 \uc608\uae08\uc758 \ud2b9\uc9d5\uc774\ub2e4."
        }
      ],
      "hint": "\uae30\uc5c5\uc758 \uacbd\uc601 \uc131\uacfc\ub97c \ubd84\ubc30\ubc1b\ub294 \ubc29\uc2dd\uacfc \uc8fc\uc2dd \uc2dc\uc7a5\uc5d0\uc11c \uc8fc\uc2dd \uac00\uaca9\uc774 \uc624\ub97c \ub54c \uc5bb\ub294 \ucc28\uc775\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ud380\ub4dc(Fund)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc804\ubb38 \uc6b4\uc6a9 \uae30\uad00\uc774 \uc790\uc0b0\uc744 \uc6b4\uc6a9\ud558\ubbc0\ub85c \uc6d0\uae08 \uc190\uc2e4 \uc704\ud5d8\uc774 \uc804\ud600 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud380\ub4dc\ub294 \uc804\ubb38\uac00\uac00 \uc6b4\uc6a9\ud558\ub354\ub77c\ub3c4 \uc6b4\uc6a9 \uacb0\uacfc\uc5d0 \ub530\ub77c \uc6d0\uae08 \uc190\uc2e4\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\uc804\ubb38\uc801\uc778 \uc6b4\uc6a9 \uae30\uad00\uc774 \ud22c\uc790\uc790\ub4e4\uc758 \uc790\uae08\uc744 \ubaa8\uc544 \ud22c\uc790\ud558\ub294 \uac04\uc811 \ud22c\uc790 \uc0c1\ud488\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud380\ub4dc\ub294 \ub2e4\uc218 \ud22c\uc790\uc790\uc758 \uc790\uae08\uc744 \uc804\ubb38 \uae30\uad00\uc774 \uc8fc\uc2dd\uc774\ub098 \ucc44\uad8c \ub4f1\uc5d0 \ub300\uc2e0 \ud22c\uc790\ud558\ub294 \uac04\uc811 \ud22c\uc790 \uc0c1\ud488\uc774\ub2e4."
