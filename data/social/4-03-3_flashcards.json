    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2023\ub144 \uae30\uc900 \ub300\ud55c\ubbfc\uad6d\uc758 \ubb34\uc5ed \uaddc\ubaa8\uc640 \uc138\uacc4 \uc21c\uc704\ub294 \uc5b4\ub5bb\uac8c \ub418\ub294\uac00?"
