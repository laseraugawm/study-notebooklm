    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2023\ub144 \uae30\uc900 \ub300\ud55c\ubbfc\uad6d\uc758 \uacf5\uc801 \uac1c\ubc1c \uc6d0\uc870(ODA) \ube44\uc6a9 \uaddc\ubaa8\uc640 \uc138\uacc4 \uc21c\uc704\ub294 \uc5b4\ub5bb\uac8c \ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "21.9\uc5b5 \ub2ec\ub7ec, \uc138\uacc4 16\uc704 (OECD \uac1c\ubc1c \uc6d0\uc870 \uc704\uc6d0\ud68c \uae30\uc900)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
