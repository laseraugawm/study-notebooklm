{
  "title": "\uc138\uacc4\ud654 \ud3c9\ud654 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\ud1b5\uacfc \ud1b5\uc2e0\uc758 \ubc1c\ub2ec\ub85c \uad6d\uac00 \uac04 \uc0c1\ud638 \uc758\uc874\uc131\uc774 \ucee4\uc9c0\uba74\uc11c \uc804 \uc138\uacc4\uac00 \ud558\ub098\uc758 \uacf5\ub3d9\uccb4\ub85c \ud1b5\ud569\ub418\uc5b4 \uac00\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654\uac00 \uc9c4\ud589\ub428\uc5d0 \ub530\ub77c \uac1c\ubcc4 \uc9c0\uc5ed\uc774 \uc790\uad6d\uc758 \uace0\uc720\ud55c \ud2b9\uc131\uc744 \uc0b4\ub824 \ub3c5\uc790\uc801\uc778 \uac00\uce58\ub97c \ub192\uc774\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uad6d\uc801 \uae30\uc5c5\uc774 \uc0dd\uc0b0 \uacfc\uc815\uc744 \uc5ec\ub7ec \uad6d\uac00\ub85c \ub098\ub204\uc5b4 \ubc30\uce58\ud558\ub294 '\uacf5\uac04\uc801 \ubd84\uc5c5'\uc744 \uc9c0\ud5a5\ud558\ub294 \ud575\uc2ec \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc7c1\ub825\uc744 \ud655\ubcf4\ud558\uace0 \uc774\uc724\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574\uc11c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654 \uc2dc\ub300\uc5d0 \ubb38\ud654 \uce21\uba74\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ub300\ud45c\uc801\uc778 \ubb38\uc81c\uc810 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\ud654 \ud68d\uc77c\ud654\uc640 \uace0\uc720 \ubb38\ud654\uc758 \uc18c\uba78"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654 \uc2dc\ub300\uc5d0 \ubb38\ud654 \ud68d\uc77c\ud654\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc678\ub798\ubb38\ud654\ub97c \ubc1b\uc544\ub4e4\uc77c \ub54c \uac00\uc838\uc57c \ud560 \ubc14\ub78c\uc9c1\ud55c \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\ub85c\uc6b4 \uc790\uae30 \ubb38\ud654\uc758 \uc815\uccb4\uc131\uc744 \uc720\uc9c0\ud558\uba74\uc11c \uc678\ub798\ubb38\ud654\ub97c \ube44\ud310\uc801\uc73c\ub85c \uc218\uc6a9\ud558\ub294 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\ud654\uc5d0 \ub530\ub978 \ube48\ubd80 \uaca9\ucc28 \ubb38\uc81c\ub97c \uc644\ud654\ud558\uae30 \uc704\ud574 \uc120\uc9c4\uad6d\uacfc \uad6d\uc81c \uc0ac\ud68c\uac00 \ucde8\ud574\uc57c \ud560 \ud574\uacb0 \ubc29\uc548\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c\ub3c4\uc0c1\uad6d\uc5d0 \ub300\ud55c \uacbd\uc81c\uc801 \uc9c0\uc6d0 \ubc0f \uae30\uc220 \ud611\ub825 \uac15\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc694\ud55c \uac08\ud241\uc774 \uc815\uc758\ud55c \ud3c9\ud654 \uac1c\ub150 \uc911 '\uc804\uc7c1, \ud14c\ub7ec, \ud3ed\ub825 \ub4f1 \uc9c1\uc811\uc801 \ud3ed\ub825\uc774 \uc5c6\ub294 \uc0c1\ud0dc'\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uadf9\uc801 \ud3c9\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c1\uc811\uc801 \ud3ed\ub825\ubfd0\ub9cc \uc544\ub2c8\ub77c \ube48\uace4, \uae30\uc544, \uc5b5\uc555, \ucc28\ubcc4 \ub4f1 \uc0ac\ud68c \uad6c\uc870\uc801\u00b7\uac04\uc811\uc801 \ud3ed\ub825\uae4c\uc9c0 \ubaa8\ub450 \uc81c\uac70\ub41c \uc0c1\ud0dc\ub97c \uc758\ubbf8\ud558\ub294 \ud3c9\ud654 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc801\uadf9\uc801 \ud3c9\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3c9\ud654\uc758 \uc885\ub958 \uc911 '\uc9c1\uc811\uc801 \ud3ed\ub825'\uacfc '\uac04\uc811\uc801(\uad6c\uc870\uc801) \ud3ed\ub825'\uc758 \ub300\ud45c\uc801\uc778 \uc608\uc2dc\ub97c \uac01\uac01 \ud55c \uac00\uc9c0\uc529 \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \uc9c1\uc811\uc801 \ud3ed\ub825: \uc804\uc7c1, \ud14c\ub7ec, \uc2e0\uccb4\uc801\u00b7\uc5b8\uc5b4\uc801 \ud3ed\ub825\n\u2022 \uac04\uc811\uc801(\uad6c\uc870\uc801) \ud3ed\ub825: \ube48\uace4, \uae30\uc544, \uc2e0\ubd84/\uc131\ubcc4 \ucc28\ubcc4, \uc0ac\ud68c\uc801 \ubd88\ud3c9\ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc0ac\ud68c\uc5d0\uc11c \ub3c5\ub9bd\uc801\uc778 \uc8fc\uad8c\uc744 \ud589\uc0ac\ud558\uba70 \ubd84\uc7c1 \ubc1c\uc0dd \uc2dc \uc678\uad50\uc801\uc73c\ub85c \ud574\uacb0\ud558\ub294 \uac00\uc7a5 \uae30\ubcf8\uc801\uc778 \ud589\uc704 \uc8fc\uccb4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00(State)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uac04 \uc774\ud574\uad00\uacc4\ub97c \uc870\uc815\ud558\uace0 \ubd84\uc7c1\uc744 \uc911\uc7ac\ud558\uba70, \uad6d\uc81c \uc0ac\ud68c\uc5d0\uc11c \uacf5\ud1b5\uc73c\ub85c \uc900\uc218\ud574\uc57c \ud560 \uaddc\ubc94\uc744 \uc81c\uc815\ud558\ub294 \ud589\uc704 \uc8fc\uccb4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubd80 \uac04 \uad6d\uc81c\uae30\uad6c(IGO)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc774\ub098 \ubbfc\uac04\ub2e8\uccb4\ub97c \ud68c\uc6d0\uc73c\ub85c \ud558\uba70, \ud2b9\uc815 \uad6d\uac00\uc758 \uc774\uc775\uacfc \uc0c1\uad00\uc5c6\uc774 \uc778\uad8c, \ud658\uacbd, \ud3c9\ud654 \ub4f1 \ubcf4\ud3b8\uc801 \uac00\uce58\ub97c \uc2e4\ud604\ud558\uae30 \uc704\ud574 \ud65c\ub3d9\ud558\ub294 \ud589\uc704 \uc8fc\uccb4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc815\ubd80 \uae30\uad6c(NGO)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\ubcf5 \uc774\ud6c4 \ub0c9\uc804 \uccb4\uc81c \uc18d\uc5d0\uc11c \ub0a8\ubd81 \ubd84\ub2e8\uc744 \uacb0\uc815\uc801\uc73c\ub85c \uace0\ucc29\ud654\uc2dc\ud0a8 \uc5ed\uc0ac\uc801 \uc0ac\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "6\u00b725 \uc804\uc7c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \ub0a8\ubd81 \ubd84\ub2e8 \uad00\ub828 \uc5ed\uc0ac\uc801 \uc0ac\uac74\ub4e4\uc744 \uc77c\uc5b4\ub09c \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud558\uc2dc\uc624: [5\u00b710 \ucd1d\uc120\uac70, 6\u00b725 \uc804\uc7c1, \uad11\ubcf5, \ubaa8\uc2a4\ud06c\ubc14 3\uad6d \uc678\ubb34 \uc7a5\uad00 \ud68c\uc758, \ub300\ud55c\ubbfc\uad6d \uc815\ubd80 \uc218\ub9bd]"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\ubcf5 \u2192 \ubaa8\uc2a4\ud06c\ubc14 3\uad6d \uc678\ubb34 \uc7a5\uad00 \ud68c\uc758 \u2192 5\u00b710 \ucd1d\uc120\uac70 \u2192 \ub300\ud55c\ubbfc\uad6d \uc815\ubd80 \uc218\ub9bd \u2192 6\u00b725 \uc804\uc7c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a8\ubd81\ud55c\uc758 \ud3c9\ud654\uc801\uc778 \ud1b5\uc77c\uc740 \uc8fc\ubcc0\uad6d\uc758 \ud611\uc870 \uc5c6\uc774 \ub2f9\uc0ac\uc790 \uac04\uc758 \ub178\ub825\ub9cc\uc73c\ub85c \uc644\uc804\ud788 \uc774\ub8e8\uc5b4 \ub0bc \uc218 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadf8\ub807\uc9c0 \uc54a\ub2e4. \ub0a8\ubd81\ud55c\uc758 \ud3c9\ud654 \ud1b5\uc77c\uc740 \ub2f9\uc0ac\uc790 \uac04\uc758 \ud611\ub825\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc8fc\ubcc0\uad6d\uc758 \ud611\uc870\uc640 \uad6d\uc81c \uc0ac\ud68c\uc758 \uacf5\uc870\uac00 \ubc18\ub4dc\uc2dc \ud544\uc694\ud558\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\ub3c4\uac00 \ub300\ud55c\ubbfc\uad6d\uc758 \uace0\uc720 \uc601\ud1a0\uc784\uc744 \uc785\uc99d\ud558\ub294 \uc138 \uac00\uc9c0 \uce21\uba74\uc758 \uadfc\uac70\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ed\uc0ac\uc801, \uc9c0\ub9ac\uc801, \uad6d\uc81c\ubc95\uc801 \uadfc\uac70"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c \uc9c0\ub9ac\uc801 \uc704\uce58\uac00 \uc9c0\ub2cc \ub3d9\uc544\uc2dc\uc544\uc5d0\uc11c\uc758 \uc804\ub7b5\uc801 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\ub77c\uc2dc\uc544 \ub300\ub959\uacfc \ud0dc\ud3c9\uc591\uc744 \uc5f0\uacb0\ud558\ub294 \ub3d9\uc544\uc2dc\uc544\uc758 \uc804\ub7b5\uc801 \uad00\ubb38\uc5d0 \ud574\ub2f9\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubcf8\uc774 \ub3d9\uc544\uc2dc\uc544 \uc8fc\ubcc0\uad6d\ub4e4\uacfc \uc77c\uc73c\ud0a4\uace0 \uc788\ub294 \uc8fc\uc694 \uc5ed\uc0ac \uac08\ub4f1 \uc694\uc18c \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ub3c5\ub3c4 \uc601\uc720\uad8c\uc758 \uc77c\ubc29\uc801 \uc8fc\uc7a5\n2. \uc5ed\uc0ac \uad50\uacfc\uc11c \uc65c\uace1\uc744 \ud1b5\ud55c \uacfc\uac70 \uce68\ub7b5 \ud589\uc704 \uc815\ub2f9\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uad6d\uc774 \ucd94\uc9c4\ud55c \uc5ed\uc0ac \uc5f0\uad6c \ud504\ub85c\uc81d\ud2b8\ub85c, \uace0\uc870\uc120\u00b7\uace0\uad6c\ub824\u00b7\ubc1c\ud574 \ub4f1 \ud55c\uad6d\uc0ac\uc758 \uace0\ub300 \uad6d\uac00\ub4e4\uc744 \uc790\uad6d\uc758 \uc5ed\uc0ac\ub85c \ud3b8\uc785\uc2dc\ud0a4\ub824\ub294 \uc2dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\ubd81\uacf5\uc815"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubcf8 \uc815\uce58\uc778\ub4e4\uc758 \uc57c\uc2a4\ucfe0\ub2c8 \uc2e0\uc0ac \ucc38\ubc30\uac00 \ub3d9\uc544\uc2dc\uc544 \uc8fc\ubcc0 \uad6d\uac00\ub4e4\uc758 \uc6b0\ub824\uc640 \uac08\ub4f1\uc744 \ub0b3\ub294 \ud575\uc2ec \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 A\uae09 \uc804\ubc94\ub4e4\uc758 \uc704\ud328\uac00 \ud569\uc0ac\ub418\uc5b4 \uc788\uc5b4, \uc815\uce58\uc778\ub4e4\uc758 \ucc38\ubc30\uac00 \uacfc\uac70 \uce68\ub7b5 \uc804\uc7c1\uc744 \ubbf8\ud654\ud558\uace0 \uc8fc\ubcc0\uad6d\uc5d0 \ud53c\ud574\ub97c \uc900 \uc5ed\uc0ac\ub97c \uc815\ub2f9\ud654\ud558\ub294 \uac83\uc73c\ub85c \ube44\uce58\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2023\ub144 \uae30\uc900 \ub300\ud55c\ubbfc\uad6d\uc758 \uad6d\ub0b4 \ucd1d\uc0dd\uc0b0(GDP) \uaddc\ubaa8\uc640 \uc138\uacc4 \uc21c\uc704\ub294 \uc5b4\ub5bb\uac8c \ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\uc870 6,733\uc5b5 \ub2ec\ub7ec, \uc138\uacc4 13\uc704 (\ud55c\uad6d\uc740\ud589 \uae30\uc900)"
