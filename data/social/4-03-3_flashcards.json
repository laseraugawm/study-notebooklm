    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2023\ub144 \uc138\uacc4 \uc9c0\uc2dd \uc7ac\uc0b0 \uae30\uad6c(WIPO) \ubc1c\ud45c \uae30\uc900 \ub300\ud55c\ubbfc\uad6d\uc758 \uae00\ub85c\ubc8c \ud601\uc2e0 \uc9c0\uc218 \uc21c\uc704\ub294 \uba87 \uc704\uc778\uac00?"
