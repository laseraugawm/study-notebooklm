{
  "title": "\uad6d\uc81c\uc0ac\ud68c \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uad6d\uc81c \uc0ac\ud68c\ub97c \ubc14\ub77c\ubcf4\ub294 \uad00\uc810 \uc911 '\ud604\uc2e4\uc801 \uad00\uc810'\uacfc '\uc774\uc0c1\uc801 \uad00\uc810'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud604\uc2e4\uc801 \uad00\uc810\uc5d0\uc11c\ub294 \uad6d\uac00 \uac04 \uacbd\uc7c1 \uc18d\uc5d0\uc11c \uc601\ud1a0, \uc790\uc6d0, \ubbfc\uc871, \uc885\uad50 \ub4f1 \ubcf5\ud569\uc801 \uc6d0\uc778\uc5d0 \uc758\ud574 \uac08\ub4f1\uc774 \ubc1c\uc0dd\ud55c\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud604\uc2e4\uc801 \uad00\uc810\uc740 \uac01 \uad6d\uac00\uac00 \uc790\uad6d\uc758 \uc774\uc775\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ucd94\uad6c\ud558\uba70 \uacbd\uc7c1\ud558\ub294 \uacfc\uc815\uc5d0\uc11c \ub2e4\uc591\ud55c \uc6d0\uc778\uc73c\ub85c \uad6d\uc81c \uac08\ub4f1\uc774 \uc77c\uc5b4\ub09c\ub2e4\uace0 \ud30c\uc545\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc774\uc0c1\uc801 \uad00\uc810\uc5d0\uc11c\ub294 \uc790\uad6d\uc758 \uc774\uc775\ub9cc\uc744 \ucd5c\uc6b0\uc120 \uac00\uce58\ub85c \ub450\uba70 \uad6d\uac00 \uac04 \ud3c9\ud654\uc801 \ud611\ub825\uc740 \ubd88\uac00\ub2a5\ud558\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\uac00\uac00 \uc790\uad6d\uc758 \uc774\uc775\ub9cc\uc744 \ucd94\uad6c\ud558\uba70 \ud611\ub825\uc774 \uc5b4\ub835\ub2e4\uace0 \ubcf4\ub294 \uac83\uc740 \ud604\uc2e4\uc801 \uad00\uc810\uc758 \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud604\uc2e4\uc801 \uad00\uc810\uc5d0\uc11c\ub294 \uac01 \uad6d\uac00\uac00 \ud56d\uc0c1 \ud569\ub9ac\uc801\uc73c\ub85c \ud589\ub3d9\ud558\uba70 \uc138\uacc4 \ud3c9\ud654\ub97c \uc704\ud574 \uc790\ubc1c\uc801\uc73c\ub85c \uc5f0\ub300\ud55c\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\uac00\uc758 \ud569\ub9ac\uc801 \ud589\ub3d9\uacfc \ud3c9\ud654\ub97c \uc704\ud55c \ud611\ub825 \ubc0f \uc5f0\ub300 \uac00\ub2a5\uc131\uc744 \uac15\uc870\ud558\ub294 \uac83\uc740 \uc774\uc0c1\uc801 \uad00\uc810\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc774\uc0c1\uc801 \uad00\uc810\uc5d0\uc11c\ub294 \uc804\uc5fc\ubcd1\uc774\ub098 \uc790\uc5f0\uc7ac\ud574 \uac19\uc740 \ubb38\uc81c\ub3c4 \ub2e8\uc77c \uad6d\uac00\uc758 \ub3c5\uc790\uc801\uc778 \ub178\ub825\ub9cc\uc73c\ub85c \uc644\ubcbd\ud788 \ud574\uacb0\ud560 \uc218 \uc788\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\uc0c1\uc801 \uad00\uc810\uc5d0\uc11c\ub294 \ud55c \uad6d\uac00\uc758 \ub178\ub825\ub9cc\uc73c\ub85c \ud574\uacb0\ud558\uae30 \uc5b4\ub824\uc6b4 \uc9c0\uad6c\ucd0c \ubb38\uc81c\uac00 \ub298\uc5b4\ub0a8\uc5d0 \ub530\ub77c \uad6d\uc81c\uc801 \uc5f0\ub300\uc640 \ud611\ub825\uc774 \ud544\uc694\ud558\ub2e4\uace0 \ubd05\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac01 \uad00\uc810\uc774 \uad6d\uac00\uc758 \uc774\uc775 \ucd94\uad6c\uc640 \uad6d\uc81c \ud611\ub825 \uac00\ub2a5\uc131\uc5d0 \ub300\ud574 \uc5b4\ub5bb\uac8c \ud574\uc11d\ud558\ub294\uc9c0 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub0a8\uc911\uad6d\ud574\ub97c \ub458\ub7ec\uc2fc \uad6d\uc81c \uac08\ub4f1\uc758 \ubc30\uacbd \ubc0f \ud2b9\uc9d5\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub0a8\uc911\uad6d\ud574\uc5d0\ub294 \uc57d 2,500\uc885\uc758 \ud574\uc591 \uc0dd\ubb3c\uacfc \uc6d0\uc720, \ucc9c\uc5f0\uac00\uc2a4 \ub4f1 \uc0c1\ub2f9\ub7c9\uc758 \uc9c0\ud558\uc790\uc6d0\uc774 \ub9e4\uc7a5\ub418\uc5b4 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub0a8\uc911\uad6d\ud574\ub294 \ud48d\ubd80\ud55c \ud574\uc591 \uc0dd\ubb3c \uc790\uc6d0\uacfc \uc9c0\ud558\uc790\uc6d0\uc774 \uc874\uc7ac\ud558\uc5ec \uacbd\uc81c\uc801 \uac00\uce58\uac00 \ub9e4\uc6b0 \ub192\uc740 \uc9c0\uc5ed\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub0a8\uc911\uad6d\ud574\ub294 \uc804\ub7b5\uc801 \uac00\uce58\uac00 \ub192\uc740 \ud574\uc0c1 \uad50\ud1b5\ub85c\ub85c\uc11c \uc5ec\ub7ec \uad6d\uac00\uc758 \uc774\uc810\uc774 \uac78\ub824 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud574\uc0c1 \uad50\ud1b5\ub85c\ub85c\uc11c\uc758 \uc804\ub7b5\uc801 \uc911\uc694\uc131\uc740 \ub0a8\uc911\uad6d\ud574 \uc601\uc720\uad8c \uac08\ub4f1\uc758 \uc8fc\uc694 \uc6d0\uc778 \uc911 \ud558\ub098\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc911\uad6d, \ubca0\ud2b8\ub0a8, \ud544\ub9ac\ud540, \ub9d0\ub808\uc774\uc2dc\uc544, \ube0c\ub8e8\ub098\uc774 \ub4f1\uc774 \ud574\uc591 \uc9c0\ud615\ubb3c\uc5d0 \ub300\ud55c \uc601\uc720\uad8c \ubc0f \uad00\ud560\uad8c\uc744 \uc8fc\uc7a5\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub0a8\uc911\uad6d\ud574 \uc0c1\uc758 \uc778\uacf5 \uc12c\uacfc \ud574\uc591 \uc9c0\ud615\ubb3c\uc744 \ub458\ub7ec\uc2f8\uace0 \uc5ec\ub7ec \ub3d9\ub0a8\uc544\uc2dc\uc544 \uad6d\uac00\ub4e4\uacfc \uc911\uad6d\uc774 \ub300\ub9bd\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud2b9\uc815 \ube44\uc815\ubd80 \uae30\uad6c(NGO)\uac00 \ub0a8\uc911\uad6d\ud574 \uc804\uccb4\uc5d0 \ub300\ud55c \uc601\uc720\uad8c\uc744 \ub3c5\uc810\uc801\uc73c\ub85c \uc120\uc5b8\ud558\uba74\uc11c \uac08\ub4f1\uc774 \uc2dc\uc791\ub418\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub0a8\uc911\uad6d\ud574 \uac08\ub4f1\uc740 \ube44\uc815\ubd80 \uae30\uad6c\uac00 \uc544\ub2cc \uc8fc\uad8c \uad6d\uac00\ub4e4(\uc911\uad6d, \ubca0\ud2b8\ub0a8, \ud544\ub9ac\ud540 \ub4f1) \uac04\uc758 \uc601\uc720\uad8c \ubc0f \ud574\uc591 \uad00\ud560\uad8c \uc8fc\uc7c1\uc73c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\uc600\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub0a8\uc911\uad6d\ud574 \uac08\ub4f1\uc758 \ub300\ub9bd \uc8fc\uccb4\uac00 \uad6d\uac00\uc778\uc9c0 \ubbfc\uac04\ub2e8\uccb4(NGO)\uc778\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uad6d\uc81c \uc0ac\ud68c\uc758 \uae30\ubcf8\uc801 \ud589\uc704 \uc8fc\uccb4\uc778 '\uad6d\uac00'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub300\ub0b4\uc801\uc73c\ub85c\ub294 \ucd5c\uace0 \uad8c\ub825\uc744, \ub300\uc678\uc801\uc73c\ub85c\ub294 \uc790\uc8fc\uc801 \ub3c5\ub9bd\uc131\uc744 \uc9c0\ub2cc \uc8fc\uad8c\uc744 \ud589\uc0ac\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uad6d\uac00\ub294 \uad6d\uc81c \uc0ac\ud68c\uc758 \uae30\ubcf8 \uc8fc\uccb4\ub85c\uc11c \ub300\ub0b4\uc678\uc801\uc778 \ucd5c\uace0\uc758 \ud798\uacfc \ub3c5\ub9bd\uc131\uc744 \uc758\ubbf8\ud558\ub294 \uc8fc\uad8c\uc744 \ubcf4\uc720\ud558\uace0 \ud589\uc0ac\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc8fc\uad8c\uc744 \uac00\uc9c4 \uad6d\uac00\ub4e4\uc774 \uacf5\ub3d9\uc73c\ub85c \uacb0\uc131\ud558\uc5ec \uad6d\uac00 \uac04 \uc774\ud574\uad00\uacc4\ub97c \uc870\uc815\ud558\ub294 \ud611\ub825\uccb4\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc8fc\uad8c \uad6d\uac00\ub4e4\ub85c \uacb0\uc131\ub418\uc5b4 \uc774\ud574\uad00\uacc4\ub97c \uc870\uc815\ud558\uace0 \uaddc\ubc94\uc744 \uc81c\uc815\ud558\ub294 \uc8fc\uccb4\ub294 '\uad6d\uc81c\uae30\uad6c'\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc774\ub098 \ubbfc\uac04\ub2e8\uccb4\ub97c \uc911\uc2ec\uc73c\ub85c \uad6c\uc131\ub418\uc5b4 \uc778\ub958 \uacf5\ud1b5\uc758 \ubcf4\ud3b8\uc801 \uac00\uce58\ub97c \ucd94\uad6c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778 \ubc0f \ubbfc\uac04\ub2e8\uccb4 \uc911\uc2ec\uc73c\ub85c \uad6c\uc131\ub418\uc5b4 \ubcf4\ud3b8\uc801 \uac00\uce58\ub97c \ucd94\uad6c\ud558\ub294 \uc8fc\uccb4\ub294 '\ube44\uc815\ubd80 \uae30\uad6c(NGO)'\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uad6d\uc758 \uc774\uc775\uc744 \uc804\ud600 \ucd94\uad6c\ud558\uc9c0 \uc54a\uc73c\uba70 \uc624\uc9c1 \ud0c0\uad6d\uc758 \uacbd\uc81c \uc9c0\uc6d0\ub9cc\uc744 \uc804\ub2f4\ud558\ub294 \uc870\uc9c1\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\uac00\ub294 \uc790\uad6d\uc758 \uc774\uc775\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ucd94\uad6c\ud558\ub294 \uc18d\uc131\uc744 \uc9c0\ub2c8\uba70, \uc678\uad50\ub098 \ud611\uc57d\uc744 \ud1b5\ud574 \uc774\ub97c \ud3c9\ud654\uc801\uc73c\ub85c \uc2e4\ud604\ud558\uace0\uc790 \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uad6d\uac00\uac00 \ubcf4\uc720\ud55c \ud575\uc2ec \uad8c\ub9ac\uc778 '\uc8fc\uad8c'\uc758 \uac1c\ub150\uacfc \ud2b9\uc9d5\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uad6d\uc81c\uae30\uad6c(IGO)\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc8fc\uad8c\uc744 \uac00\uc9c4 \uad6d\uac00\ub4e4\ub85c \uacb0\uc131\ub41c \uad6d\uc81c \ud611\ub825\uccb4\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\uc81c\uae30\uad6c\ub294 \uc815\ubd80 \uac04 \ud611\uc758\uccb4\ub85c\uc11c \uc8fc\uad8c \uad6d\uac00\ub4e4\uc774 \ud68c\uc6d0\uc73c\ub85c \ucc38\uc5ec\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uac00 \uac04\uc758 \uc774\ud574\uad00\uacc4\ub97c \uc870\uc815\ud558\uac70\ub098 \ubd84\uc7c1\uc744 \uc911\uc7ac\ud558\ub294 \uc5ed\ud560\uc744 \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6d\uc81c\uae30\uad6c\ub294 \uad6d\uac00 \uac04 \ub300\ub9bd \uc2dc \uc774\ud574\uad00\uacc4\ub97c \uc911\uc728\ud558\uace0 \uacf5\ud1b5\uc758 \uaddc\ubc94\uc744 \uc81c\uc815\ud558\uc5ec \ubd84\uc7c1\uc744 \uc911\uc7ac\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc774\ub098 \ubbfc\uac04\ub2e8\uccb4\ub97c \uc911\uc2ec\uc73c\ub85c \uad6c\uc131\ub418\uba70 \uac1c\ubcc4 \uad6d\uac00\uc758 \uc774\ud574\uad00\uacc4\uc640 \uc0c1\uad00\uc5c6\uc774 \ud65c\ub3d9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\uc778\uc774\ub098 \ubbfc\uac04\ub2e8\uccb4\ub97c \uc911\uc2ec \uc870\uc9c1\uc73c\ub85c \ud558\ub294 \uac83\uc740 \uad6d\uc81c\uae30\uad6c\uac00 \uc544\ub2c8\ub77c '\ube44\uc815\ubd80 \uae30\uad6c(NGO)'\uc5d0 \ub300\ud55c \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub300\ud45c\uc801\uc778 \uc608\ub85c \uad6d\uc81c \uc5f0\ud569(UN), \uc138\uacc4 \ubcf4\uac74 \uae30\uad6c(WHO), \uad6d\uc81c \ud1b5\ud654 \uae30\uae08(IMF) \ub4f1\uc774 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "UN, WHO, IMF, ILO \ub4f1\uc740 \uad6d\uac00\ub4e4\uc774 \ud68c\uc6d0\uc73c\ub85c \uac00\uc785\ud558\uc5ec \ud65c\ub3d9\ud558\ub294 \ub300\ud45c\uc801\uc778 \uad6d\uc81c\uae30\uad6c\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uad6d\uc81c\uae30\uad6c(IGO)\uc640 \ube44\uc815\ubd80 \uae30\uad6c(NGO)\uc758 \uad6c\uc131\uc6d0 \ucc28\uc774(\uc815\ubd80/\uad6d\uac00 vs \uac1c\uc778/\ubbfc\uac04\ub2e8\uccb4)\ub97c \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc124\uba85\uc5d0 \ud574\ub2f9\ud558\ub294 \uad6d\uc81c\uae30\uad6c\uc640 \uadf8 \uc8fc\uc694 \uc5ed\ud560\uc758 \uc5f0\uacb0\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc138\uacc4 \ubcf4\uac74 \uae30\uad6c(WHO) - \uc720\ud589\uc131 \uc9c8\ubcd1 \ud1f4\uce58 \ubc0f \uacf5\uc911 \ubcf4\uac74 \uad00\ub828 \ud589\uc815 \uac15\ud654 \uc9c0\uc6d0",
          "isCorrect": true,
          "rationale": "\uc138\uacc4 \ubcf4\uac74 \uae30\uad6c(WHO)\ub294 \ubcf4\uac74\u00b7\uc704\uc0dd \ubd84\uc57c\uc758 \uad6d\uc81c\uc801 \ud611\ub825\uc744 \ubaa9\uc801\uc73c\ub85c \uc804\uc5fc\ubcd1 \ub300\ucc45 \ub9c8\ub828 \ubc0f \ubc29\uc5ed \uccb4\uacc4\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uc81c \ud1b5\ud654 \uae30\uae08(IMF) - \uc591\uc9c8\uc758 \ub3c4\uc81c \uc81c\ub3c4\uc5d0 \uad00\ud55c \uad8c\uace0 \ub4f1 \ub178\ub3d9 \uae30\uc900 \ucc44\ud0dd",
          "isCorrect": false,
          "rationale": "\ub178\ub3d9 \uae30\uc900 \uc81c\uc815 \ubc0f \ub178\ub3d9\uad8c \ubcf4\uc7a5\uc744 \ub2f4\ub2f9\ud558\ub294 \uae30\uad6c\ub294 \uad6d\uc81c \ub178\ub3d9 \uae30\uad6c(ILO)\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uc81c \ub178\ub3d9 \uae30\uad6c(ILO) - \uacf5\ub3d9 \uae30\uae08\uc744 \ud1b5\ud55c \uc678\ud654 \uc790\uae08 \uc870\ub2ec \ubc0f \uad6d\uc81c \ud1b5\ud654 \uc548\uc815 \ub3c4\ubaa8",
          "isCorrect": false,
          "rationale": "\uc678\ud654 \uc790\uae08 \uc870\ub2ec\uacfc \uad6d\uc81c \ud1b5\ud654 \uc548\uc815\uc744 \ucd09\uc9c4\ud558\ub294 \uac83\uc740 \uad6d\uc81c \ud1b5\ud654 \uae30\uae08(IMF)\uc758 \uc5ed\ud560\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uad6d\uc81c \uc5f0\ud569(UN) - \uac1c\uc778 \uc911\uc2ec\uc758 \ud658\uacbd \ubb38\uc81c \uc6d0\uc778 \uaddc\uba85\uc744 \uc704\ud55c \uc801\uadf9\uc801\uc778 \uc120\ubc15 \uc2dc\uc704 \uc8fc\ub3c4",
          "isCorrect": false,
          "rationale": "\uc120\ubc15 \uc2dc\uc704 \ub4f1\uc744 \ud1b5\ud574 \ud658\uacbd \uc6b4\ub3d9\uc744 \ud3bc\uce58\ub294 \uac83\uc740 \ube44\uc815\ubd80 \uae30\uad6c\uc778 \uadf8\ub9b0\ud53c\uc2a4(Greenpeace)\uc758 \ud65c\ub3d9\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubcf4\uac74, \ud1b5\ud654, \ub178\ub3d9, \uad6d\uc81c \ud3c9\ud654 \ub4f1 \uac01 \uae30\uad6c\uc758 \uace0\uc720 \uc804\ubb38 \ubd84\uc57c\ub97c \ub9e4\uce6d\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ube44\uc815\ubd80 \uae30\uad6c(NGO)\uc640 \uadf8 \ub300\ud45c\uc801\uc778 \ud65c\ub3d9 \ub0b4\uc6a9\uc758 \uc5f0\uacb0\uc774 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6d\uacbd \uc5c6\ub294 \uc758\uc0ac\ud68c - \ubb34\ub825 \ubd84\uc7c1, \uc804\uc5fc\ubcd1, \uc790\uc5f0\uc7ac\ud574 \uc9c0\uc5ed\uc5d0\uc11c\uc758 \uae34\uae09 \ubbfc\uac04 \uc758\ub8cc \uad6c\ud638 \ud65c\ub3d9",
          "isCorrect": false,
