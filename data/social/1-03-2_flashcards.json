{
  "title": "\uc778\uad8c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c\uc758 \uae30\ubcf8 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc774 \uc778\uac04\ub2f5\uac8c \uc0b4\uae30 \uc704\ud574 \ub9c8\ub545\ud788 \ub204\ub824\uc57c \ud560 \uae30\ubcf8\uc801\uc778 \uad8c\ub9ac\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc5b4\ub0a0 \ub54c\ubd80\ud130 \ub2f9\uc5f0\ud788 \uac00\uc9c0\ub294 \uc778\uad8c\uc758 \ud2b9\uc131\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc9c\ubd80\uc778\uad8c\uc131(\ucc9c\ubd80\uc131)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uc885, \uc131\ubcc4, \uc885\uad50, \uc2e0\ubd84 \ub4f1\uc5d0 \uad00\uacc4\uc5c6\uc774 \ub204\uad6c\ub098 \ub204\ub9ac\ub294 \uc778\uad8c\uc758 \ud2b9\uc131\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\ud3b8\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85 \uacfc\uc815\uc744 \ud1b5\ud574 \ud655\uc0b0\ud558\uae30 \uc2dc\uc791\ud55c \ud575\uc2ec \uae30\ubcf8\uad8c \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uad8c, \ud3c9\ub4f1\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\ub300 \uc2dc\ubbfc \ud601\uba85 \uc774\ud6c4 \ucc38\uc815\uad8c\uc5d0\uc11c \uc81c\uc678\ub418\uc5c8\ub358 \ub178\ub3d9\uc790\uc640 \uc5ec\uc131 \ub4f1\uc774 \ucc38\uc815\uad8c \ud655\ub300\ub97c \uc704\ud574 \uc804\uac1c\ud55c \ub300\ud45c\uc801 \uc6b4\ub3d9 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc28\ud2f0\uc2a4\ud2b8 \uc6b4\ub3d9, \uc5ec\uc131 \ucc38\uc815\uad8c \uc6b4\ub3d9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ubd80\ubd84\uc758 \uad6d\uac00\uc5d0\uc11c \uc77c\uc815 \uc5f0\ub839 \uc774\uc0c1\uc758 \ubaa8\ub4e0 \uc2dc\ubbfc\uc5d0\uac8c \ucc38\uc815\uad8c\uc774 \ubcf4\uc7a5\ub418\uae30 \uc2dc\uc791\ud55c \uc2dc\uae30\ub294 \uc5b8\uc81c\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "20\uc138\uae30 \uc911\ubc18 \uc774\ud6c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \ucd5c\ucd08\ub85c \ud5cc\ubc95\uc5d0 '\uc0ac\ud68c\uad8c'\uc744 \uba85\uc2dc\ud55c \uad6d\uac00\uc758 \ud5cc\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc77c \ubc14\uc774\ub9c8\ub974 \ud5cc\ubc95"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1948\ub144 \uad6d\uc81c \uc5f0\ud569(UN)\uc774 \ucc44\ud0dd\ud558\uc5ec \uc804 \uc138\uacc4 \uc778\uad8c \ubcf4\uc7a5\uc744 \uc704\ud55c \uc5f0\ub300 \ub178\ub825\uc758 \uacc4\uae30\uac00 \ub41c \uc120\uc5b8\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uc778\uad8c \uc120\uc5b8"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\ub300 \uc0ac\ud68c\uc5d0\uc11c \uc778\uad8c\uc758 \ubc94\uc704\uac00 \ud655\uc7a5\ub418\uba74\uc11c \uc0c8\ub86d\uac8c \ub4f1\uc7a5\ud55c \uc778\uad8c\uc758 \uc885\ub958\uc5d0\ub294 \uc5b4\ub5a4 \uac83\ub4e4\uc774 \uc788\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uac70\uad8c, \uc548\uc804\uad8c, \ud658\uacbd\uad8c, \ubb38\ud654\uad8c, \uc815\ubcf4 \uc0ac\ud68c\uc5d0\uc11c\uc758 \uc0c8\ub85c\uc6b4 \uad8c\ub9ac \ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \uc0ac\ud68c\uc758 \uc9c4\uc804\uc5d0 \ub530\ub77c \uc0c8\ub86d\uac8c \ubcf4\uc7a5 \uc694\uad6c\uac00 \ub298\uc5b4\ub09c \uad8c\ub9ac 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \uc811\uadfc\uad8c, \uac1c\uc778 \uc815\ubcf4 \uc790\uae30 \uacb0\uc815\uad8c, \uc78a\ud790 \uad8c\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uad6d\uac00\uc758 \ucd5c\uace0\ubc95\uc73c\ub85c\uc11c \uc778\uac04\uc758 \uc874\uc5c4\uc131 \uc2e4\ud604\uacfc \uc778\uad8c \ubcf4\uc7a5\uc744 \uc704\ud55c \ud1a0\ub300\uac00 \ub418\ub294 \ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95\uc5d0\uc11c \ubcf4\uc7a5\ud558\ub294 \uad6d\ubbfc\uc758 5\ub300 \uae30\ubcf8\uad8c\uc5d0\ub294 \ubb34\uc5c7\uc774 \uc788\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uad8c, \ud3c9\ub4f1\uad8c, \ucc38\uc815\uad8c, \uc0ac\ud68c\uad8c, \uccad\uad6c\uad8c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00 \uae30\uad00\uc5d0 \uc758\ud574 \uae30\ubcf8\uad8c\uc744 \uce68\ud574\ub2f9\ud55c \uad6d\ubbfc\uc774 \uc774\uc6a9\ud560 \uc218 \uc788\ub294 \ubc95\uc801 \uad6c\uc81c \uc218\ub2e8 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc95\uc6d0\uc758 \uc7ac\ud310, \ud5cc\ubc95\uc7ac\ud310\uc18c\uc758 \uc2ec\ud310"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5cc\ubc95\uc0c1 \uad8c\ub825 \ubd84\ub9bd \uc81c\ub3c4\ub97c \ub450\ub294 \uad81\uadf9\uc801\uc778 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad8c\ub825\uc758 \ub0a8\uc6a9\uc744 \ub9c9\uace0 \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c(\uc778\uad8c)\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud568\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\uac00 \uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c\uc744 \uc81c\ud55c\ud560 \ub54c \uae30\uc900\uc774 \ub418\ub294 \ud5cc\ubc95\uc0c1 \uc0ac\uc720 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uac00\uc548\uc804\ubcf4\uc7a5, \uc9c8\uc11c\uc720\uc9c0, \uacf5\uacf5\ubcf5\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c\uc744 \uc81c\ud55c\ud560 \ub54c \ub530\ub77c\uc57c \ud558\ub294 \ubc95\uc801 \ud615\uc2dd\uacfc \uc81c\ud55c\uc758 \ud55c\uacc4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ud68c\uac00 \uc81c\uc815\ud55c '\ubc95\ub960'\ub85c\uc368 \uc81c\ud55c\ud574\uc57c \ud558\uba70, \uae30\ubcf8\uad8c\uc758 '\ubcf8\uc9c8\uc801\uc778 \ub0b4\uc6a9'\uc740 \uce68\ud574\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ubb38\uc744 \uae08\uc9c0\ud558\ub294 \uc81c\ub3c4\ub294 5\ub300 \uae30\ubcf8\uad8c \uc911 \uc5b4\ub290 \uad8c\ub9ac\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uac83\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uad8c (\uc2e0\uccb4\uc758 \uc790\uc720)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c \ubcf4\uc7a5\uc744 \uc704\ud55c \uc2dc\ubbfc \ucc38\uc5ec \ubc29\ubc95 \uc911 \ucd5c\ud6c4\uc758 \uc218\ub2e8\uc73c\ub85c \ud589\uc0ac\ub418\ub294 \ud589\uc704\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\ubbfc\ubd88\ubcf5\uc885"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \uc18c\uc218\uc790\ub97c \uad6c\ubd84\ud558\ub294 \ud575\uc2ec \uae30\uc900\uc740 \ub2e8\uc21c\ud788 \uc778\uc6d0\uc218\uc758 \ub9ce\uace0 \uc801\uc74c\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub2d9\ub2c8\ub2e4. \uc778\uc6d0\uc218\uc640 \uc0c1\uad00\uc5c6\uc774 \uad8c\ub825\uc758 \uc5f4\uc138\uc5d0 \uc788\uac70\ub098 \ucc28\ubcc4\uacfc \uc18c\uc678\ub97c \ubc1b\ub294\uc9c0 \uc5ec\ubd80\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccad\uc18c\ub144 \uadfc\ub85c\uc790\ub3c4 \uc131\uc778\uacfc \ub3d9\uc77c\ud558\uac8c \ucd5c\uc800 \uc784\uae08\uc744 \uc801\uc6a9\ubc1b\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub124, \uccad\uc18c\ub144\ub3c4 \uadfc\ub85c\uae30\uc900\ubc95 \ubc0f \ucd5c\uc800\uc784\uae08\ubc95\uc5d0 \ub530\ub77c \uc131\uc778\uacfc \ub3d9\uc77c\ud55c \ucd5c\uc800 \uc784\uae08\uc744 \uc801\uc6a9\ubc1b\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccad\uc18c\ub144\uc774 \uc0ac\uc5c5\uc8fc\ub85c\ubd80\ud130 \uc815\ud574\uc9c4 \uadfc\ub85c\uc2dc\uac04 \ucd08\uacfc \uadfc\ubb34\uc5d0 \ub300\ud55c \uae09\uc5ec\ub97c \ubc1b\uc9c0 \ubabb\ud55c \uacbd\uc6b0 \uc5b4\ub5a4 \uad8c\ub9ac\ub97c \uce68\ud574\ub2f9\ud55c \uac83\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccad\uc18c\ub144 \ub178\ub3d9\uad8c(\uc784\uae08 \uccad\uad6c\uad8c \ubc0f \uc5f0\uc7a5\uadfc\ub85c \uc218\ub2f9 \uc218\uae09\uad8c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccad\uc18c\ub144 \ub178\ub3d9\uad8c \uce68\ud574 \uc2dc \ub3c4\uc6c0\uc744 \ubc1b\uc744 \uc218 \uc788\ub294 \ub300\ud45c\uc801\uc778 \uad6d\uac00 \uae30\uad00 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc6a9 \ub178\ub3d9\ubd80, \ub178\ub3d9 \uc704\uc6d0\ud68c, \uadfc\ub85c \ubcf5\uc9c0 \uacf5\ub2e8"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \uc0ac\ud68c\uc5d0\uc11c \ucc28\ubcc4\uc744 \uacbd\ud5d8\ud558\ub294 '\ub514\uc9c0\ud138 \ucde8\uc57d \uacc4\uce35'\uc5d0 \ud574\ub2f9\ud558\ub294 \uc8fc\ub41c \uc9d1\ub2e8\uc740 \ub204\uad6c\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc778, \uc7a5\uc560\uc778, \uc800\uc18c\ub4dd\uce35, \ub18d\uc5b4\ubbfc, \uc774\uc8fc \uc678\uad6d\uc778 \ub4f1 \uc0ac\ud68c\uc801 \uc18c\uc218\uc790"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ucde8\uc57d \uacc4\uce35\uc778 \ub178\uc778\uc758 \uc811\uadfc\uc131\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc740\ud589 \ud604\uae08 \uc790\ub3d9 \uc785\ucd9c\uae08\uae30\uc5d0 \ub3c4\uc785\ub418\ub294 \uc2dc\uc124 \uac1c\uc120 \uc0ac\ub840\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          },
          {
            "type": "image",
            "reference": "401b4e60-b8c7-4d61-b73a-d3c33c404171",
            "alt": "\uc5b4\ub974\uc2e0\uc6a9 \uc26c\uc6b4\uac70\ub798 \ud654\uba74\uc774 \ud45c\uc2dc\ub41c \ud604\uae08 \uc790\ub3d9 \uc785\ucd9c\uae08\uae30"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub974\uc2e0\uc6a9 \uc26c\uc6b4\uac70\ub798 \ud604\uae08 \uc790\ub3d9 \uc785\ucd9c\uae08\uae30(ATM) \uc124\uce58"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub298\ub0a0 \uc138\uacc4 \uc778\uad8c \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc6d0\uc778 \ubc0f \ubc30\uacbd\uc5d0\ub294 \uc5b4\ub5a4 \uac83\ub4e4\uc774 \uc788\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad00\uc2b5, \uc81c\ub3c4, \uc804\uc7c1, \ube48\uace4, \ub3c5\uc7ac, \uae30\ud6c4\ubcc0\ud654 \ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc0ac\ud68c\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc8fc\uc694 \uc138\uacc4 \uc778\uad8c \ubb38\uc81c\uc758 \uc720\ud615 4\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc7ac \uad6d\uac00 \uacf5\uad8c\ub825\uc5d0 \uc758\ud55c \uae30\ubcf8\uad8c \uce68\ud574, \uc804\uc7c1\uacfc \ub0b4\uc804, \uae30\ud6c4\ubcc0\ud654\uc5d0 \ub530\ub978 \ub09c\ubbfc\u00b7\uae30\uc544 \ubb38\uc81c, \uc81c3\uc138\uacc4 \uc544\ub3d9 \ub178\ub3d9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c\uae30\uad6c\ub098 \ube44\uc815\ubd80 \uae30\uad6c\uac00 \uc138\uacc4 \uc778\uad8c \ubb38\uc81c\uc758 \uc2e4\ud0dc\uc640 \ubcc0\ub3d9 \uc0c1\ud669\uc744 \ud30c\uc545\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc870\uc0ac\ud558\uc5ec \ubc1c\ud45c\ud558\ub294 \uc9c0\ud45c\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c \uc9c0\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c \uc9c0\uc218 \ubcf4\uace0\uc11c\ub97c \ubcfc \ub54c \ub2e8\uc21c\ud788 \uad6d\uac00 \uac04 \uc21c\uc704\ub9cc \ube44\uad50\ud558\uba74 \uc548 \ub418\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc218\uc758 \uac1c\ubc1c \ubaa9\uc801\uacfc \uce21\uc815 \ubc29\uc2dd\uc744 \uc774\ud574\ud558\uc9c0 \uc54a\uace0 \uc21c\uc704\ub9cc \ube44\uad50\ud558\uba74 \ud2b9\uc815 \uad6d\uac00\uc758 \uc808\ub300\uc801\uc778 \uc778\uad8c \ubcf4\uc7a5 \uc218\uc900\uc744 \uc624\ud574\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\ub85c \ud45c\ud604\ub418\uc9c0 \uc54a\ub294 \uc778\uad8c \ubb38\uc81c\ub97c \uae4a\uc774 \uc774\ud574\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \uc5f0\uad6c\u00b7\uc870\uc0ac \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c\uc744 \uce68\ud574\ubc1b\uc740 \ub2f9\uc0ac\uc790\uc758 \ubaa9\uc18c\ub9ac\uc5d0 \uadc0 \uae30\uc6b8\uc774\ub294 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \uc0ac\uc9c4\uc740 \uc5b4\ub5a4 \uc778\uad8c \uce68\ud574 \uc591\uc0c1\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc0ac\ub840\uc778\uac00\uc694?"
          },
          {
            "type": "image",
            "reference": "56401b60-485c-482e-a90b-7c8a9fe433c6",
            "alt": "\uc6b0\uac04\ub2e4\uc5d0\uc11c \uacbd\ucc30\uc774 \ubb34\uae30\ub97c \ub4e4\uace0 \uac70\ub9ac\uc758 \uc2dc\ubbfc\uc744 \ub9e4\uc9c8\ud558\ub824\ub294 \ubaa8\uc2b5"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc7ac \uad6d\uac00\ub098 \uc77c\ubd80 \uc9c0\uc5ed\uc5d0\uc11c \uacf5\uad8c\ub825\uc774 \uc2dc\ubbfc\uc758 \uc7ac\uc0b0\uc774\ub098 \uc2e0\uccb4\uc758 \uc790\uc720 \ub4f1 \uae30\ubcf8\uad8c\uc744 \uce68\ud574\ud558\ub294 \uc591\uc0c1 (\uc6b0\uac04\ub2e4 \uc0ac\ub840)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \uc0ac\uc9c4\uc5d0 \uc81c\uc2dc\ub41c \uc2dc\ub9ac\uc544 \ud53c\ub09c\ubbfc\ub4e4\uc758 \uc0c1\ud669\uc740 \uc5b4\ub5a4 \uc6d0\uc778\uc73c\ub85c \ubc1c\uc0dd\ud55c \uc778\uad8c \ubb38\uc81c\uc778\uac00\uc694?"
          },
          {
            "type": "image",
            "reference": "9a310562-d3ad-4d3a-b2e5-92167ec90c8b",
            "alt": "\uc2dc\ub9ac\uc544 \ub0b4\uc804\uc73c\ub85c \uc0b4\ub358 \uacf3\uc5d0\uc11c \ucad3\uaca8\ub09c \ub09c\ubbfc\ub4e4\uc774 \uae34 \uc904\uc744 \uc11c\uc11c \uc74c\uc2dd\uc744 \uae30\ub2e4\ub9ac\ub294 \ubaa8\uc2b5"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0b4\uc804\uacfc \uc804\uc7c1\uc73c\ub85c \uc778\ud55c \ub09c\ubbfc \ubc1c\uc0dd \ubc0f \uc0dd\uc874\uad8c \uce68\ud574 \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \uc0ac\uc9c4\uc5d0 \uc81c\uc2dc\ub41c \ud22c\ubc1c\ub8e8\uc758 \uc0c1\ud669\uc740 \uc5b4\ub5a0\ud55c \uc138\uacc4\uc801 \uc704\uae30 \ub54c\ubb38\uc5d0 \ubc1c\uc0dd\ud55c \uc778\uad8c \ubb38\uc81c\uc778\uac00\uc694?"
          },
          {
            "type": "image",
            "reference": "1e6b99f9-5154-4a39-b3c6-1b3f06934fc5",
            "alt": "\ud22c\ubc1c\ub8e8\uc5d0\uc11c \uae30\ud6c4\ubcc0\ud654\ub85c \uc778\ud55c \ud574\uc218\uba74 \uc0c1\uc2b9\uc73c\ub85c \ubb3c\uc5d0 \uc7a0\uae34 \ub9c8\uc744\uc744 \uac77\ub294 \uc8fc\ubbfc"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4\ubcc0\ud654(\uae30\ud6c4\uc704\uae30)\ub85c \uc778\ud55c \ud574\uc218\uba74 \uc0c1\uc2b9 \ubc0f \uc8fc\uac70\u00b7\uc0dd\uc874\uad8c \uce68\ud574 \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uacbd\uc81c \ud3ec\ub7fc(WEF)\uc774 \ubc1c\ud45c\ud558\ub294 '\uc131 \uaca9\ucc28 \uc9c0\uc218'\uc758 4\uac00\uc9c0 \uc870\uc0ac \ubd80\ubb34\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\uc801 \ucc38\uc5ec \ubc0f \uae30\ud68c, \uad50\uc721 \uc131\ucde8\ub3c4, \uac74\uac15\uacfc \uc0dd\uc874, \uc815\uce58\uc801 \uad8c\ud55c \ubd80\uc5ec"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uacbd\uc81c \ud3ec\ub7fc\uc758 '\uc131 \uaca9\ucc28 \uc9c0\uc218'\uc5d0\uc11c \uc218\uce58 1\uacfc 0\uc740 \uac01\uac01 \ubb34\uc5c7\uc744 \uc758\ubbf8\ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc218 1\uc740 \uc644\uc804 \ud3c9\ub4f1, \uc9c0\uc218 0\uc740 \uc644\uc804 \ubd88\ud3c9\ub4f1\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc5f0\ud569 \uac1c\ubc1c \uacc4\ud68d(UNDP)\uc774 \ubc1c\ud45c\ud558\ub294 '\uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218'\uc758 3\uac1c \uce21\uc815 \ubd80\ubb38\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\u00b7\uac74\uac15, \uc5ec\uc131 \uad8c\ud55c, \ub178\ub3d9 \ucc38\uc5ec"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc5f0\ud569 \uac1c\ubc1c \uacc4\ud68d\uc758 '\uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218'\uc5d0\uc11c \uc218\uce58 0\uacfc 1\uc740 \uac01\uac01 \ubb34\uc5c7\uc744 \uc758\ubbf8\ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc218 0\uc740 \uc644\uc804 \ud3c9\ub4f1, \uc9c0\uc218 1\uc740 \uc644\uc804 \ubd88\ud3c9\ub4f1\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131 \uaca9\ucc28 \uc9c0\uc218\uc640 \uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218\uc5d0\uc11c '\uc644\uc804 \ud3c9\ub4f1'\uc744 \ub73b\ud558\ub294 \uc218\uce58\ub294 \uac01\uac01 \uc5bc\ub9c8\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131 \uaca9\ucc28 \uc9c0\uc218\ub294 1\uc774 \uc644\uc804 \ud3c9\ub4f1, \uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218\ub294 0\uc774 \uc644\uc804 \ud3c9\ub4f1\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc77c\ud55c \uad6d\uac00\uc758 \uc591\uc131\ud3c9\ub4f1 \uad00\ub828 \uc21c\uc704\uac00 \uc131 \uaca9\ucc28 \uc9c0\uc218\uc640 \uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218\uc5d0\uc11c \ub2e4\ub974\uac8c \ub098\ud0c0\ub098\ub294 \uc8fc\ub41c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \uc9c0\uc218\uc758 \uce21\uc815 \uc601\uc5ed \ubc0f \uc9c0\ud45c\uac00 \ub2e4\ub974\uace0, \uc131 \ubd88\ud3c9\ub4f1 \uc9c0\uc218\uc758 \uacbd\uc6b0 \ub0a8\ub140 \uaca9\ucc28\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc5ec\uc131 \ucc98\uc6b0\uc758 \uc808\ub300\uc801 \uc218\uc900\uae4c\uc9c0 \ubc18\uc601\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc138\uacc4 \uc5b8\ub860 \uc790\uc720 \uc9c0\uc218'\ub97c \uc815\uae30\uc801\uc73c\ub85c \ubc1c\ud45c\ud558\ub294 \ub300\ud45c\uc801\uc778 \ube44\uc815\ubd80 \uae30\uad6c(NGO)\ub294 \uc5b4\ub514\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uacbd \uc5c6\ub294 \uae30\uc790\ud68c(RSF)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uacbd \uc5c6\ub294 \uae30\uc790\ud68c\uac00 \uc138\uacc4 \uc5b8\ub860 \uc790\uc720 \uc9c0\uc218\ub97c \uc0b0\ucd9c\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 5\uac00\uc9c0 \uc0c1\ud669\ubcc4 \uc9c0\ud45c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uce58\uc801 \ub9e5\ub77d, \ubc95\uc801 \ud504\ub808\uc784\uc6cc\ud06c, \uacbd\uc81c\uc801 \ub9e5\ub77d, \uc0ac\ud68c\u00b7\ubb38\ud654\uc801 \ub9e5\ub77d, \uc548\uc804"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud280\ub974\ud0a4\uc608\uc5d0\uc11c \uc5b8\ub860\u00b7\uc18c\uc15c \ubbf8\ub514\uc5b4\ubc95 \uac1c\uc815\uc548 \ud1b5\uacfc \uc2dc '\uac80\uc5f4\ubc95'\uc774\ub77c\ub294 \ube44\ud310\uc774 \uc81c\uae30\ub41c \ubc95\uc548\uc758 \ud575\uc2ec \ub0b4\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5c8\uc704 \uc815\ubcf4\ub97c \ubcf4\ub3c4\ud55c \uc5b8\ub860\uc778\uc774\ub098 \uc774\ub97c \ud37c\ub098\ub978 \uc18c\uc15c \ubbf8\ub514\uc5b4 \uc774\uc6a9\uc790\uc5d0 \ub300\ud55c \ucc98\ubc8c\uc744 \ub300\ud3ed \uac15\ud654\ud558\ub294 \ub0b4\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub9ac\ub364 \ud558\uc6b0\uc2a4(Freedom House)\uc5d0\uc11c \uc870\uc0ac\u00b7\ubc1c\ud45c\ud558\ub294 \uc778\uad8c \uad00\ub828 \uc9c0\uc218\uc758 \uc774\ub984\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uc790\uc720 \uc9c0\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \uc5f0\ud569 \uac1c\ubc1c \uacc4\ud68d(UNDP)\uc774 \uac01\uad6d\uc758 \uac1c\ubc1c \ubc0f \uc0b6\uc758 \uc9c8 \uc218\uc900\uc744 \uc885\ud569\uc801\uc73c\ub85c \ud3c9\uac00\ud558\uc5ec \ubc1c\ud45c\ud558\ub294 \uc9c0\uc218\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04 \uac1c\ubc1c \uc9c0\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c \ub178\ub3d9 \uc870\ud569 \ucd1d\uc5f0\ub9f9(ITUC)\uc5d0\uc11c \uac01\uad6d\uc758 \ub178\ub3d9\uad8c \ubcf4\uc7a5 \uc2e4\ud0dc\ub97c \ud3c9\uac00\ud558\uc5ec \ubc1c\ud45c\ud558\ub294 \uc9c0\uc218\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \ub178\ub3d9 \uad8c\ub9ac \uc9c0\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uc778\uad8c \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574 \uad6d\uc81c \uc5f0\ud569(UN)\uc774 \uc218\ud589\ud558\ub294 \uc8fc\ub41c \uc5ed\ud560 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uad8c \ubcf4\uc7a5\uacfc \uad00\ub828\ub41c \uc758\uc81c \ub2e4\ub8e8\uae30, \ud574\ub2f9 \uad6d\uac00\uc5d0 \uad8c\uace0\uc548 \uc81c\uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub09c\ubbfc \ubc0f \uae30\uc544 \uc9c0\uc6d0, \uae30\uae08 \uc870\uc131 \ubc0f \ud64d\ubcf4 \ud65c\ub3d9\uc744 \uc8fc\ub3c4\ud558\ub294 \uad6d\uc81c \ud589\uc704 \uc8fc\uccb4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc815\ubd80 \uae30\uad6c(NGO)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\ubbfc\uc758 \uae30\ubcf8\uad8c\uc744 \uce68\ud574\ud558\ub294 \ub3c5\uc7ac\ub098 \ucc28\ubcc4 \uad6d\uac00\uc5d0 \ub300\ud574 \uad6d\uc81c \uc0ac\ud68c\uac00 \ucde8\ud558\ub294 \uacf5\uc870 \ub300\uc751 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6d\uc81c\uc801\uc778 \ube44\ud310 \uc5ec\ub860\uc744 \ud615\uc131\ud558\uc5ec \uacbd\uace0 \ubc0f \uc555\ubc15\uc744 \uac00\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub298\ub0a0 \uc77c\ubc18 \uac1c\uc778\ub4e4\uc774 \uc0ac\ud68c \uad00\uacc4\ub9dd \uc11c\ube44\uc2a4(SNS)\ub97c \ud65c\uc6a9\ud574 \uc138\uacc4 \uc778\uad8c \uc6b4\ub3d9\uc5d0 \ub3d9\ucc38\ud558\ub294 \ubc29\ubc95 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud575\uc2ec\uc5b4 \ud45c\uc2dc(\ud574\uc2dc\ud0dc\uadf8) \ub2ec\uae30, \ud2b9\uc815 \uc774\ubbf8\uc9c0 \uacf5\uc720\ud558\uae30, \ub3d9\uc77c\ud55c \ud589\uc704 \uc2e4\ucc9c\ud558\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uad6d \ub0b4 \uc544\uc2dc\uc544\uacc4 \ub300\uc0c1 \uc5f0\uc1c4 \ucd1d\uaca9 \uc0ac\uac74 \uc774\ud6c4 \uc804 \uc138\uacc4\uc778\ub4e4\uc774 SNS\uc5d0 \uacf5\uc720\ud55c \uc544\uc2dc\uc544\uacc4 \ucc28\ubcc4 \ubc18\ub300 \uad6c\ud638\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          },
          {
