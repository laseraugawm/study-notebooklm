    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uad11, \ud48d\ub825 \ub4f1\uc758 \uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uc0ac\uc6a9 \ube44\uc911\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uc99d\uac00\ud558\uace0 \uc788\ub294 \uc8fc\uc694 \uacbd\uc81c\uc801 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
