    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4 \uc11d\uc720\uc758 \uc57d 13%, \ucc9c\uc5f0\uac00\uc2a4\uc758 \uc57d 30%\uac00 \ub9e4\uc7a5\ub418\uc5b4 \uc788\uc73c\uba70, \uc9c0\uad6c \uc628\ub09c\ud654\ub85c \uc5bc\uc74c\uc774 \ub179\uc73c\uba74\uc11c \uc5f0\uc548\uad6d \uac04 \uc601\uc720\uad8c \uac08\ub4f1\uc774 \ubc1c\uc0dd\ud55c \ud574\uc5ed\uc740 \uc5b4\ub514\uc778\uac00\uc694?"
