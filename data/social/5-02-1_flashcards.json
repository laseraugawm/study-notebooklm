    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5d0\ub108\uc9c0\ub97c \ub300\uccb4\ud558\uae30 \uc704\ud574 \uc804 \uc138\uacc4\uac00 \ubcf4\uae09\uc744 \ud655\ub300\ud558\uace0 \uc788\ub294 \uce5c\ud658\uacbd \ubc1c\uc804 \uc5d0\ub108\uc9c0 \uad70\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
