    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5d0\ub108\uc9c0 \uc18c\ube44 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud55c \uae30\uc220 \ubc0f \uc0b0\uc5c5 \uce21\uba74\uc758 \uc8fc\uc694 \ubc29\uc548 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
