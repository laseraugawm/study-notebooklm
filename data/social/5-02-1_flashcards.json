      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc7a5 \uc801\uc740 \uc5d0\ub108\uc9c0\uc6d0: \ucc9c\uc5f0\uac00\uc2a4 / \uac00\uc7a5 \ub9ce\uc740 \uc5d0\ub108\uc9c0\uc6d0: \uc11d\ud0c4"
