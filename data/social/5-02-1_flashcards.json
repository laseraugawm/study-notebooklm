    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2022\ub144 \uae30\uc900 \uc804 \uc138\uacc4 \uc5d0\ub108\uc9c0\uc6d0\ubcc4 \uc804\ub825 \uc0dd\uc0b0 \ube44\uc911\uc5d0\uc11c \uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0\uac00 \ucc28\uc9c0\ud558\ub294 \ube44\uc911\uc740 \uc57d \uba87 %\uc778\uac00\uc694?"
