      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc0b0\ud654 \ud0c4\uc18c\ub97c \ubc30\ucd9c\ud558\uc9c0 \uc54a\ub294\ub2e4, \ubbf8\uc138 \uba3c\uc9c0 \ub4f1 \ub300\uae30 \uc624\uc5fc \ubb3c\uc9c8\uc774 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\ub294\ub2e4."
          }
