      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0 \uc808\uc57d\ud615 \uc0b0\uc5c5 \uc721\uc131, \uc5d0\ub108\uc9c0 \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc774\uc6a9\ud558\ub294 \uae30\uc220 \uac1c\ubc1c"
