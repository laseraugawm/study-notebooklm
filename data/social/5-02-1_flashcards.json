      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559 \uae30\uc220\uc758 \ubc1c\ub2ec, \uc0ac\ud68c\uc801\u00b7\ubb38\ud654\uc801 \ubc30\uacbd\uc758 \ubcc0\ud654"
