            "content": "\uc911\uad6d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2021\ub144 \uae30\uc900 \uc11d\uc720 \uc0dd\uc0b0\ub7c9 \uc0c1\uc704 3\uac1c \uad6d\uac00(\ubbf8\uad6d, \ub7ec\uc2dc\uc544, \uc0ac\uc6b0\ub514\uc544\ub77c\ube44\uc544)\uc758 \uc0dd\uc0b0 \ube44\uc911 \ubd84\ud3ec \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uad6d(16.8%), \uc0ac\uc6b0\ub514\uc544\ub77c\ube44\uc544(12.2%), \ub7ec\uc2dc\uc544(12.7%) \ub4f1 \uc0c1\uc704 \uc0b0\uc720\uad6d\ub4e4\uc5d0 \uc0dd\uc0b0\uc774 \ub9e4\uc6b0 \uc9d1\uc911\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
