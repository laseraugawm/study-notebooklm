      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11d\ud0c4 (18\uc138\uae30) $\\rightarrow$ \uc11d\uc720 (19\uc138\uae30) $\\rightarrow$ \ucc9c\uc5f0\uac00\uc2a4"
