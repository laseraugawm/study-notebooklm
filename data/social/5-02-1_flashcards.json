    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uccb4 \uc0c1\ud0dc\uc758 \ucc9c\uc5f0\uac00\uc2a4\ub97c \ub0c9\ub3d9 \uc561\ud654\ud588\uc744 \ub54c \uc218\uc1a1\uacfc \uc800\uc7a5 \uce21\uba74\uc5d0\uc11c \uc720\ub9ac\ud574\uc9c0\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
