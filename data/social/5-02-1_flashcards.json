      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\u00b7\uc7ac\uc0dd \uc5d0\ub108\uc9c0 (\ud0dc\uc591\uad11, \ud48d\ub825 \ub4f1)"
