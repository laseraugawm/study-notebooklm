      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11d\uc720 (\uc11d\uc720\ub294 \uc77c\ubd80 \uc9c0\uc5ed\uc5d0 \uc9d1\uc911 \ub9e4\uc7a5\ub418\uc5b4 \ud3b8\uc7ac\uc131\uc774 \ud070 \ubc18\uba74, \uc11d\ud0c4\uc740 \ube44\uad50\uc801 \ub113\uc740 \uc9c0\uc5ed\uc5d0 \uace0\ub974\uac8c \ubd84\ud3ec\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2021\ub144 \uae30\uc900 \uc138\uacc4 \uc11d\ud0c4 \uc18c\ube44\ub7c9\uc758 50% \uc774\uc0c1(\uc57d 50.8%)\uc744 \ucc28\uc9c0\ud558\ub294 \uc138\uacc4 \ucd5c\ub300 \uc11d\ud0c4 \uc18c\ube44\uad6d\uc740 \uc5b4\ub514\uc778\uac00\uc694?"
