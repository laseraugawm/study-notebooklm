    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0\uc758 \ud2b9\uc131 \uc911 '\uac00\ubcc0\uc131'\uc774 \ubc1c\uc0dd\ud558\ub294 \uc8fc\uc694 \uc6d0\uc778 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
