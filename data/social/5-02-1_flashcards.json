        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591, \ubc14\ub78c, \ubb3c \ub4f1 \uc790\uc5f0\uc758 \ud798\uc744 \uc774\uc6a9\ud558\ub294 \uc7ac\uc0dd \uc5d0\ub108\uc9c0\uac00 \ud654\uc11d \uc5d0\ub108\uc9c0 \ub300\ube44 \uac16\ub294 \ub300\ud45c\uc801\uc778 \ud658\uacbd\uc801 \uc7a5\uc810 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
