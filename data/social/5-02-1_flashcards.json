    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0\uc758 \ud574\uc678 \uc758\uc874\ub3c4\uac00 \ub192\uc740 \uad6d\uac00\uac00 \uc548\uc815\uc801\uc778 \uc790\uc6d0 \ud655\ubcf4\ub97c \uc704\ud574 \ucd94\uc9c4\ud574\uc57c \ud560 \uad6d\uac00 \ucc28\uc6d0\uc758 \ub300\ucc45 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
