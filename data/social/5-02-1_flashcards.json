    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0\uc758 \ud3b8\uc7ac\uc131 \ub54c\ubb38\uc5d0 \uc790\uc6d0\uc758 \uc0dd\uc0b0\uc9c0\uc640 \uc18c\ube44\uc9c0\uac00 \uc77c\uce58\ud558\uc9c0 \uc54a\uc544 \ud544\uc5f0\uc801\uc73c\ub85c \ub098\ud0c0\ub098\ub294 \ud604\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
