    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2021\ub144 \uae30\uc900 \ucc9c\uc5f0\uac00\uc2a4 \uc0dd\uc0b0\ub7c9 \uc0c1\uc704 2\uac1c \uad6d\uac00\ub294 \uc5b4\ub514\uc778\uac00\uc694?"
