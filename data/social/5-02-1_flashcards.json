        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub7ec\uc2dc\uc544, \ubbf8\uad6d, \uce90\ub098\ub2e4, \ub178\ub974\uc6e8\uc774, \ub374\ub9c8\ud06c"
