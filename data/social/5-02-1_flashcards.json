    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874 \ud654\uc11d \uc5d0\ub108\uc9c0\ub97c \ubcc0\ud658\ud558\uc5ec \uc774\uc6a9\ud558\ub294 \uc2e0\uc5d0\ub108\uc9c0\uc640 \uc7ac\uc0dd\uc774 \uac00\ub2a5\ud55c \uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub97c \ud1b5\ud2c0\uc5b4 \uc77c\uceeb\ub294 \uc6a9\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
