      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc561\ud654\ub418\uba74\uc11c \ubd80\ud53c\uac00 \ud06c\uac8c \uc904\uc5b4\ub4e4\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
