    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\uc6a9\ud654\ub41c \uc2dc\uae30\uac00 \ube60\ub978 \uc21c\uc11c\ub300\ub85c \uc8fc\uc694 \ud654\uc11d \uc5d0\ub108\uc9c0 3\uac00\uc9c0\ub97c \ub098\uc5f4\ud558\uba74 \uc5b4\ub5bb\uac8c \ub418\ub098\uc694?"
