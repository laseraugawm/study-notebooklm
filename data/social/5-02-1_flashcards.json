    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5d0\ub108\uc9c0 \uc911\uc2ec\uc758 \uc18c\ube44 \uad6c\uc870\ub85c \uc778\ud574 \ub098\ud0c0\ub098\ub294 \ub300\ud45c\uc801\uc778 \uc0ac\ud68c\u00b7\uacbd\uc81c\uc801 \ubb38\uc81c\uc810 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
