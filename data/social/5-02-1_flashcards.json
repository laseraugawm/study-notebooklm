      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc678 \uc790\uc6d0 \uc9c1\uc811 \ud22c\uc790, \uc790\uc6d0 \uc678\uad50 \uac15\ud654"
