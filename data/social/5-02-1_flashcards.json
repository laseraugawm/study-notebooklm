    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd81\uadf9\ud574\uc758 \uc601\uc720\uad8c\uacfc \uc790\uc6d0 \ub9e4\uc7a5\uc9c0\ub97c \ub458\ub7ec\uc2f8\uace0 \uac08\ub4f1\uc744 \ubc8c\uc774\uace0 \uc788\ub294 \uc5f0\uc548 5\uac1c \uad6d\uac00\ub294 \uc5b4\ub514\uc778\uac00\uc694?"
