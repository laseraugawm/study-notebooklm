    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11d\ud0c4\uacfc \uc11d\uc720 \uc911 \uad6d\uc81c \uc774\ub3d9\ub7c9\uc774 \ub354 \ub9ce\uc740 \uc5d0\ub108\uc9c0 \uc790\uc6d0\uc740 \ubb34\uc5c7\uc774\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
