    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \uc77c\ub7ec\uc2a4\ud2b8\ub294 \uc5b4\ub290 \ud574\uc5ed\uc758 \uc790\uc6d0 \ub9e4\uc7a5\uc9c0\uc640 \uc601\uc720\uad8c\uc744 \ub458\ub7ec\uc2fc \uc5f0\uc548\uad6d \uac04\uc758 \uac08\ub4f1 \uc0c1\ud669\uc744 \ub098\ud0c0\ub0b8 \uac83\uc778\uac00\uc694?"
