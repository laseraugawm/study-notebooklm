      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc9c\uc5f0\uac00\uc2a4 $\\rightarrow$ \uc11d\uc720 $\\rightarrow$ \ubb3c (\ubc00\ub3c4\ucc28\uc5d0 \uc758\ud574 \uac00\uc2a4\uac00 \ucd5c\uc0c1\uce35, \ubb3c\uc774 \ucd5c\ud558\uce35\uc5d0 \uc704\uce58)"
