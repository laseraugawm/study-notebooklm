          {
            "type": "image",
            "reference": "c1afc6e4-4100-4c2a-808d-079a66fbd969",
            "alt": "\ud478\ub978 \ud558\ub298 \uc544\ub798 \uc124\uce58\ub41c \ud0dc\uc591\uad11 \ubc1c\uc804 \ud328\ub110 \ub2e8\uc9c0\uc640 \ub300\ud615 \ud48d\ub825 \ubc1c\uc804\uae30\ub4e4"
