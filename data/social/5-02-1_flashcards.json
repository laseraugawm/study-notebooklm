      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0 \ubd80\uc871 \ubc0f \uace0\uac08 \ubb38\uc81c, \uad6d\uac00 \uac04 \uc790\uc6d0 \ubd84\uc7c1 \ubc0f \uac08\ub4f1 \uc2ec\ud654, \uad6d\uac00 \uac04 \uc5d0\ub108\uc9c0 \uc18c\ube44 \uaca9\ucc28"
