    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5d0\ub108\uc9c0 \uc911 \uc5f0\uc18c \uc2dc \ub2e8\uc704\ub2f9 \ub300\uae30 \uc624\uc5fc \ubb3c\uc9c8 \ubc30\ucd9c\ub7c9\uc774 \uac00\uc7a5 \uc801\uc740 \uc5d0\ub108\uc9c0\uc6d0\uacfc \uac00\uc7a5 \ub9ce\uc740 \uc5d0\ub108\uc9c0\uc6d0\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00\uc694?"
