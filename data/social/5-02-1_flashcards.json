    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0 \ubbfc\uc871\uc8fc\uc758\uc758 \ub300\ud45c\uc801 \uc608\uc2dc\ub85c, \uc6d0\uc720 \uc0dd\uc0b0\ub7c9\uacfc \uac00\uaca9\uc744 \uc870\uc808\ud558\uc5ec \uc790\uc6d0 \uc601\ud5a5\ub825\uc744 \ud589\uc0ac\ud558\ub294 \uad6d\uc81c \uae30\uad6c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
