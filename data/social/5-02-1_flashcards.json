    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11d\uc720\uc640 \ucc9c\uc5f0\uac00\uc2a4\uac00 \ub9e4\uc7a5\ub41c \ubc30\uc0ac \uad6c\uc870 \uc9c0\uce35 \ub0b4\ubd80\uc5d0\uc11c \uc717\uce35\ubd80\ud130 \ucc28\ub840\ub300\ub85c \uc874\uc7ac\ud558\ub294 3\uac00\uc9c0 \ubb3c\uc9c8\uce35\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
