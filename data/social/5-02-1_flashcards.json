    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7ac\uc0dd \uac00\ub2a5\ud55c \ub300\ud45c\uc801\uc778 \uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uc885\ub958 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
