    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ub300\ud654\uc5d0\uc11c \ub3d9\uc544\ub9ac \ub300\ud45c\uc758 \ub9d0\ud558\uae30\uc5d0 \uc801\uc6a9\ub41c '\uc0ac\ud68c\uc801 \uc758\uc0ac\uc18c\ud1b5 \ubc29\ubc95'\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n\uc8fc\ubbfc \ub300\ud45c: \uc5f0\uae30 \uae30\ucd08 \ud6c8\ub828\uc740 \ubb34\uc5c7\uc744 \ub9d0\ud558\ub294 \uac83\uc778\uac00\uc694?\n\ub3d9\uc544\ub9ac \ub300\ud45c: \ubc30\uc6b0\ub4e4\uc774 \uc5f0\uae30\ub97c \ud558\uae30 \uc704\ud574 \uac16\ucdb0\uc57c \ud560 \uae30\ubcf8\uae30\ub97c \uc775\ud788\ub294 \ud6c8\ub828\uc744 \ub9d0\ud569\ub2c8\ub2e4. \ud6c8\ub828\uc758 \ub0b4\uc6a9\uc73c\ub85c\ub294 \uc790\uc138 \ud6c8\ub828, \ud638\ud761 \ud6c8\ub828, \ubc1c\uc131 \ubc0f \ubc1c\uc74c \ud6c8\ub828 \ub4f1\uc774 \uc788\uc2b5\ub2c8\ub2e4.",
