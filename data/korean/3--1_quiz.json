{
  "title": "\ud611\uc0c1 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ud611\uc0c1\uc758 \uac1c\ub150\uacfc \uc758\uc758\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "hint": "\ud611\uc0c1 \uacfc\uc815\uc5d0\uc11c \uc591\uce21\uc774 \ucde8\ud574\uc57c \ud558\ub294 \uae30\ubcf8\uc801\uc778 \ud0dc\ub3c4\uc640 \ubaa9\uc801\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694.",
      "answerOptions": [
        {
          "text": "\uc790\uc2e0\uc758 \uc774\uc775\ub9cc\uc744 \ucd5c\uc6b0\uc120\uc73c\ub85c \uc0bc\uc544 \uc0c1\ub300\ubc29\uc758 \uc694\uad6c\ub97c \uc218\uc6a9\ud558\uc9c0 \uc54a\uace0 \uad00\ucca0\ud558\ub294 \uac83\uc744 \ubcf8\uc9c8\uc801\uc778 \ubaa9\uc801\uc73c\ub85c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud611\uc0c1\uc740 \uc790\uc2e0\uc758 \uc8fc\uc7a5\ub9cc\uc744 \uc77c\ubc29\uc801\uc73c\ub85c \uad00\ucca0\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c, \uc591\ubcf4\uc640 \ud0c0\ud611\uc744 \ud1b5\ud574 \uc591\uce21 \ubaa8\ub450\uac00 \ub9cc\uc871\ud560 \ub9cc\ud55c \uacb0\uacfc\ub97c \uc5bb\uc5b4\ub0b4\ub294 \ud611\ub825\uc801 \uc758\uc0ac\uc18c\ud1b5 \ubc29\ubc95\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc774\ub098 \uc9d1\ub2e8 \uc0ac\uc774\uc5d0\uc11c \uc774\uc775\uc774\ub098 \uc8fc\uc7a5\uc774 \ub2ec\ub77c \ubc1c\uc0dd\ud558\ub294 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud55c \ud611\ub825\uc801 \uc758\uc0ac\uc18c\ud1b5\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud611\uc0c1\uc740 \uac08\ub4f1 \uc0c1\ud669\uc5d0\uc11c \uc11c\ub85c \ud0c0\ud611\ud558\uace0 \uc870\uc815\ud558\uc5ec \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub294 \ud611\ub825\uc801 \uc18c\ud1b5\uc758 \uacfc\uc815\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud611\uc0c1 \ucc38\uc5ec\uc790\ub4e4\uc740 \uc2dc\uc791 \ub2e8\uacc4, \uc870\uc815 \ub2e8\uacc4, \ud574\uacb0 \ub2e8\uacc4\uc5d0 \ub530\ub77c \ub2e4\uc591\ud55c \uc804\ub7b5\uc744 \ub9c8\ub828\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud611\uc0c1\uc740 \uc9c4\ud589 \ub2e8\uacc4\ubcc4(\uc2dc\uc791, \uc870\uc815, \ud574\uacb0)\ub85c \uc785\uc7a5\uc744 \ud655\uc778\ud558\uace0 \uc81c\uc548\uc744 \uc218\uc815\ud55c \ub4a4 \ucd5c\uc120\uc758 \ud569\uc758\uc548\uc744 \uc774\ub04c\uc5b4 \ub0b4\ub294 \uc804\ub7b5\uc801 \uc808\ucc28\ub97c \uac70\uce69\ub2c8\ub2e4."
        },
        {
          "text": "\uc591\ubcf4\uc640 \ud611\ub825\uc744 \ud1b5\ud574 \ucc38\uc5ec\uc790 \ubaa8\ub450\uac00 \ub9cc\uc871\ud560 \ub9cc\ud55c \uacb0\uacfc\ub97c \uc5bb\uc744 \uc218 \uc788\ub2e4\ub294 \ub370 \uc758\uc758\uac00 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud611\ub825\uc801 \uc758\uc0ac\uc18c\ud1b5\uc744 \ud1b5\ud574 \uc11c\ub85c \uc0c1\uc0dd\ud558\ub294 \uacb0\uacfc\ub97c \ub3c4\ucd9c\ud558\ub294 \uac83\uc774 \ud611\uc0c1\uc758 \ud575\uc2ec \uc758\uc758\uc785\ub2c8\ub2e4."
        }
      ]
    },
    {
      "type": "multiple_choice",
      "question": "'\uc2dc\uc791 \ub2e8\uacc4'\uc5d0\uc11c \ud480\ube5b\uace0 \uc5f0\uadf9 \ub3d9\uc544\ub9ac \uce21\uacfc \ub2e4\ube5b\uc544\ud30c\ud2b8 \uc8fc\ubbfc \uce21\uc758 \uc785\uc7a5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "hint": "\uc591\uce21\uc774 \ub300\uad00\uc744 \uc694\uad6c\ud558\uac70\ub098 \ub9dd\uc124\uc774\ub294 \uc774\uc720\uc640 \uadfc\uac70\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694.",
      "answerOptions": [
        {
          "text": "\uc8fc\ubbfc \uce21\uc740 \uc678\ubd80 \ub300\uc5ec \uc2dc \ubc1c\uc0dd\ud560 \uad00\ub9ac \ube44\uc6a9\uacfc \uc8fc\ubbfc\uc758 \ubd88\ud3b8\ud568\uc744 \uace0\ub824\ud558\uc5ec \uc774\uc5d0 \uc0c1\uc751\ud558\ub294 \ud61c\ud0dd\uc774 \ud544\uc694\ud558\ub2e4\uace0 \ubcf4\uc558\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc8fc\ubbfc \ub300\ud45c\ub294 \uad00\ub0b4 \uc2dc\uc124\uc744 \uc678\ubd80\uc5d0 \ub300\uc5ec\ud560 \uacbd\uc6b0 \uad00\ub9ac \ube44\uc6a9 \ubc1c\uc0dd \ubc0f \uc8fc\ubbfc \ubd88\ud3b8\uc774 \uc608\uc0c1\ub418\ubbc0\ub85c \uc0c1\uc751\ud558\ub294 \uc774\uc775\uc774 \uc788\uc5b4\uc57c \ub300\uc5ec\ud560 \uc218 \uc788\ub2e4\ub294 \uc785\uc7a5\uc744 \ud45c\uba85\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub3d9\uc544\ub9ac \uce21\uc740 \ud559\uad50 \uac15\ub2f9 \uacf5\uc0ac\uac00 \uc774\ubbf8 \uc644\ub8cc\ub418\uc5c8\uc73c\ub098 \ub354 \ub113\uc740 \ubb34\ub300\ub97c \ud65c\uc6a9\ud558\uae30 \uc704\ud574 \ub300\uad00\uc744 \uc694\uccad\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub3d9\uc544\ub9ac \uce21\uc774 \ub300\uad00\uc744 \uc694\uccad\ud55c \uc774\uc720\ub294 \uac15\ub2f9 \uc9c0\ubd95 \uacf5\uc0ac \ub54c\ubb38\uc5d0 \ub2e4\uc74c \ub2ec \uc608\uc815\ub41c \uc815\uae30 \uacf5\uc5f0\uc744 \uc9c4\ud589\ud560 \uc7a5\uc18c\uac00 \ub9c8\ub545\uce58 \uc54a\uc558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub3d9\uc544\ub9ac \uce21\uc740 \ubd80\uc6d0 \uc804\uc6d0\uc774 \ub2e4\ube5b\uc544\ud30c\ud2b8 \uac70\uc8fc\uc790\ub77c\ub294 \uc810\uc744 \ub4e4\uc5b4 \ubb34\uc870\uac74\uc801\uc778 \ubb34\uc0c1 \ub300\uad00\uc744 \uc8fc\uc7a5\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub3d9\uc544\ub9ac \uce21\uc740 \ubd80\uc6d0 \uc804\uc6d0\uc774 \uc544\ub2c8\ub77c \ud559\uad50 \ud559\uc0dd\uc758 \uc808\ubc18\uac00\ub7c9\uc774 \ub2e4\ube5b\uc544\ud30c\ud2b8\uc5d0 \uc0b4\uace0 \uc788\ub2e4\ub294 \uc810\uc744 \ub4e4\uc5b4 \ub300\uad00 \uace0\ub824\ub97c \uc694\uccad\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc8fc\ubbfc \uce21\uc740 \uc774\uc804\uc5d0\ub3c4 \uc5ec\ub7ec \ucc28\ub840 \uc678\ubd80 \uae30\uad00\uc5d0 \uc18c\uadf9\uc7a5\uc744 \ub300\uc5ec\ud574 \uc900 \uacbd\ud5d8\uc744 \ubc14\ud0d5\uc73c\ub85c \ub300\uc6a9 \uc870\uac74\uc744 \uc81c\uc2dc\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc8fc\ubbfc \ub300\ud45c\ub294 \ubb38\ud654 \uc13c\ud130\uac00 \uc8fc\ubbfc\uc744 \uc704\ud55c \uc2dc\uc124\uc774\uba70 \uc9c0\uae08\uae4c\uc9c0 \uc678\ubd80 \uae30\uad00\uc5d0 \ub300\uc5ec\ud55c \uc801\uc774 \uc5c6\uc5c8\ub2e4\uace0 \ubc1d\ud788\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ]
    },
    {
      "type": "multiple_choice",
      "question": "'\uc870\uc815 \ub2e8\uacc4 \u2460'\uc5d0\uc11c \uc8fc\ubbfc \ub300\ud45c\uac00 \uacf5\uc5f0 \uad00\ub78c \ud5c8\uc6a9 \uc678\uc5d0 \ub3d9\uc544\ub9ac \uce21\uc5d0 \uc694\uad6c\ud55c '\uc2e4\uc9c8\uc801\uc778 \uc774\uc775'\uc758 \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "hint": "\uc544\ud30c\ud2b8 \ubb38\ud654 \uc13c\ud130\uc5d0\uc11c 65\uc138 \uc774\uc0c1 \uc5b4\ub974\uc2e0\ub4e4\uc744 \uc704\ud574 \uc6b4\uc601 \uc911\uc778 \ud504\ub85c\uadf8\ub7a8\uacfc \uad00\ub828\uc774 \uc788\uc2b5\ub2c8\ub2e4.",
      "answerOptions": [
        {
          "text": "\uc544\ud30c\ud2b8 \ub178\uc778 \ud559\uad50\uc5d0\uc11c \uae30\ud68d \uc911\uc778 \uc5b4\ub974\uc2e0 \uc5f0\uadf9 \uacf5\uc5f0 \ud504\ub85c\uadf8\ub7a8\uc5d0 \ub300\ud55c \ud559\uc0dd\ub4e4\uc758 \uc5f0\uadf9 \ud65c\ub3d9 \uc9c0\uc6d0",
          "isCorrect": true,
          "rationale": "\uc8fc\ubbfc \ub300\ud45c\ub294 \ub178\uc778 \ud559\uad50 \ud504\ub85c\uadf8\ub7a8\uc73c\ub85c \uae30\ud68d \uc911\uc778 \uc5f0\uadf9 \uacf5\uc5f0 \uc9c4\ud589\uc5d0 \ub300\ud55c \uc804\ubb38\uac00 \ubd80\uc871 \ubb38\uc81c\ub97c \uc5b8\uae09\ud558\uba70 \ub3d9\uc544\ub9ac \ud559\uc0dd\ub4e4\uc758 \ub3c4\uc6c0\uc744 \uc694\uccad\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\uadf9\uc7a5 \ub300\uc6a9\uc5d0 \ub530\ub978 \uc815\uac00 \ub300\uad00\ub8cc \uc9c0\uae09 \ubc0f \uc2dc\uc124 \uc190\uc0c1 \ubc29\uc9c0\ub97c \uc704\ud55c \ubcf4\uc99d\uae08 \uc218\ub0a9",
          "isCorrect": false,
          "rationale": "\uc8fc\ubbfc \ub300\ud45c\uac00 \uc694\uad6c\ud55c \uc2e4\uc9c8\uc801\uc778 \uc774\uc775\uc740 \uae08\uc804\uc801 \ub300\uad00\ub8cc\ub098 \ubcf4\uc99d\uae08\uc774 \uc544\ub2cc \ub178\uc778 \ud559\uad50 \uc5f0\uadf9 \ud65c\ub3d9 \uc9c0\uc6d0\uc774\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc544\ud30c\ud2b8 \uc8fc\ubbfc \uc790\ub140\ub4e4\uc744 \uc704\ud55c \uc8fc\ub9d0 \uc5f0\uadf9 \uad50\uc2e4 \uc544\uce74\ub370\ubbf8\uc758 \uc815\uae30\uc801 \uac1c\uc124",
          "isCorrect": false,
          "rationale": "\uc8fc\ubbfc \uce21\uc774 \uc694\uccad\ud55c \ub300\uc0c1\uc740 \uc8fc\ubbfc \uc790\ub140\uac00 \uc544\ub2c8\ub77c \ub178\uc778 \ud559\uad50\ub97c \uc774\uc6a9\ud558\ub294 65\uc138 \uc774\uc0c1 \uc5b4\ub974\uc2e0\ub4e4\uc774\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\uc5f0 \ub2f9\uc77c \uad00\ub78c\uac1d\ub4e4\uc744 \uc704\ud55c \ubb34\ub8cc \uc74c\ub8cc \ubd09\uc0ac \ubc0f \ub9e4\uc810 \uc6b4\uc601\uad8c \uc591\ub3c4",
          "isCorrect": false,
          "rationale": "\uc74c\ub8cc \ubd09\uc0ac\ub098 \ub9e4\uc810 \uc6b4\uc601\uad8c \ub4f1\uc740 \ud611\uc0c1 \uacfc\uc815\uc5d0\uc11c \uc5b8\uae09\ub41c \ubc14 \uc5c6\uc2b5\ub2c8\ub2e4."
        }
      ]
    },
    {
      "type": "multiple_choice",
      "question": "'\uc870\uc815 \ub2e8\uacc4 \u2461'\uc5d0\uc11c \uc18c\uadf9\uc7a5 \uc5f0\uc2b5 \uc2dc\uac04 \uc870\uc815\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "hint": "\ub3d9\uc544\ub9ac\uac00 \ucc98\uc74c \uc694\uad6c\ud55c \uc5f0\uc2b5 \uc2dc\uac04\uacfc \uad00\ub9ac \uc9c1\uc6d0\uc758 \ud1f4\uadfc \uc2dc\uac04\uc744 \ube44\uad50\ud574 \ubcf4\uc138\uc694.",
      "answerOptions": [
        {
          "text": "\ub3d9\uc544\ub9ac \uce21\uc740 \uacf5\uc5f0 \uc77c\uc8fc\uc77c \uc804\ubd80\ud130 \ub9e4\uc77c \uc624\ud6c4 4\uc2dc\ubd80\ud130 9\uc2dc\uae4c\uc9c0 \uc5f0\uc2b5 \uacf5\uac04\uc744 \ub300\uc5ec\ud574 \uc904 \uac83\uc744 \ucd5c\ucd08\ub85c \uc694\uad6c\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub3d9\uc544\ub9ac \ub300\ud45c\ub294 \ubb34\ub300\uc640 \uc870\uba85 \uc801\uc751\uc744 \uc704\ud574 \uacf5\uc5f0 \uc77c\uc8fc\uc77c \uc804\ubd80\ud130 \ub9e4\uc77c \uc624\ud6c4 4\uc2dc~9\uc2dc\uae4c\uc9c0\uc758 \uc5f0\uc2b5 \uc2dc\uac04\uc744 \ucd5c\ucd08 \uc81c\uc548\uc73c\ub85c \uc81c\uc2dc\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc8fc\ubbfc \ub300\ud45c\ub294 \uad00\ub9ac \uc9c1\uc6d0\uc774 \uc624\ud6c4 6\uc2dc\uc5d0 \ud1f4\uadfc\ud558\ubbc0\ub85c \ubaa8\ub4e0 \uc5f0\uc2b5\uc744 \uc624\ud6c4 5\uc2dc 30\ubd84\uc5d0 \ub05d\ub0bc \uac83\uc744 \uc870\uac74\uc73c\ub85c \uc81c\uc2dc\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc8fc\ubbfc \uc13c\ud130 \uad00\ub9ac \uc9c1\uc6d0\uc758 \ud1f4\uadfc \uc2dc\uac04\uc740 \uc624\ud6c4 7\uc2dc(19\uc2dc)\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc591\uce21\uc758 \ud0c0\ud611\uc744 \ud1b5\ud574 \uacf5\uc5f0 \uc77c\uc8fc\uc77c \uc804\ubd80\ud130 \ub9e4\uc77c \uc624\ud6c4 9\uc2dc\uae4c\uc9c0 \uc18c\uadf9\uc7a5\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uc73c\ub85c \ucd5c\uc885 \ud569\uc758\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub9e4\uc77c 9\uc2dc\uae4c\uc9c0 \uc5f0\uc2b5\ud558\ub294 \uac83\uc740 \uac70\uc808\ub2f9\ud588\uc73c\uba70, \ud3c9\uc18c\uc5d0\ub294 7\uc2dc\uae4c\uc9c0, \uacf5\uc5f0 \ud558\ub8e8 \uc804\ub0a0\ub9cc 9\uc2dc\uae4c\uc9c0 \uc0ac\uc6a9\ud558\ub294 \uac83\uc73c\ub85c \uc870\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub3d9\uc544\ub9ac \uce21\uc740 \uc8fc\ubbfc \uc13c\ud130 \uc0ac\uc815\uc744 \uace0\ub824\ud558\uc5ec \uc18c\uadf9\uc7a5 \ub0b4\uc5d0\uc11c\uc758 \uc0ac\uc804 \uc5f0\uc2b5 \uc694\uccad\uc744 \ubaa8\ub450 \ucca0\ud68c\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub3d9\uc544\ub9ac \uce21\uc740 \uc5f0\uc2b5 \uc694\uccad\uc744 \ucca0\ud68c\ud558\uc9c0 \uc54a\uace0, \uc2dc\uac04\uc5d0 \uc81c\uc57d\uc774 \uc788\ub354\ub77c\ub3c4 \uacf5\uc5f0 \uc804\ub0a0 9\uc2dc \uc5f0\uc7a5 \uc0ac\uc6a9 \ub4f1\uc744 \uc81c\uc548\ud558\uba70 \ud0c0\ud611\uc548\uc744 \uc774\ub04c\uc5b4\ub0c8\uc2b5\ub2c8\ub2e4."
        }
      ]
    },
    {
      "type": "multiple_choice",
      "question": "'\uc870\uc815 \ub2e8\uacc4 \u2461'\uc5d0\uc11c \uacf5\uc5f0 \ud6c4 \uc18c\uadf9\uc7a5 \uccad\uc18c \ubb38\uc81c\uc640 \uad00\ub828\ud558\uc5ec \uc591\uce21\uc774 \ucd5c\uc885\uc801\uc73c\ub85c \ud0c0\ud611\ud558\uc5ec \ud569\uc758\ud55c \ub0b4\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?",
      "hint": "\ud559\uc0dd\ub4e4\uc774 \uc815\ub9ac\ud558\uae30 \ud798\ub4e0 \ubd80\ubd84\uacfc \uc815\ub9ac\ud560 \uc218 \uc788\ub294 \uad6c\uc5ed\uc744 \ub098\ub204\uc5b4 \uc5ed\ud560\uc744 \ubd84\ub2f4\ud588\uc2b5\ub2c8\ub2e4.",
      "answerOptions": [
        {
          "text": "\ub3d9\uc544\ub9ac \ud559\uc0dd\ub4e4\uc740 \ubb34\ub300 \uc815\ub9ac\uc640 \ubb34\ub300 \uc8fc\ubcc0 \uccad\uc18c\ub97c \ub2f4\ub2f9\ud558\uace0, \uac1d\uc11d \ubc0f \ubb38\ud654 \uc13c\ud130 \uc8fc\ubcc0 \uccad\uc18c\ub294 \uc8fc\ubbfc \uce21\uc5d0\uc11c \ub2f4\ub2f9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud559\uc0dd\ub4e4\uc774 \ubd84\uc7a5\uacfc \uc18c\ud488 \uc815\ub9ac\ub85c \uc548\ud30e \uc804\uccb4 \uccad\uc18c\uac00 \uc5b4\ub835\ub2e4\ub294 \uc0ac\uc815\uc744 \uc774\ud574\ud558\uace0, \ud559\uc0dd\uc740 \ubb34\ub300 \ubc0f \ubb34\ub300 \uc8fc\ubcc0\uc744, \uc8fc\ubbfc \uce21\uc740 \uac1d\uc11d\uacfc \uc678\ubd80 \uc8fc\ubcc0 \uccad\uc18c\ub97c \ub9e1\uae30\ub85c \uc870\uc815\ud55c \ub0b4\uc6a9\uc774 \ubcf8\ubb38\uc5d0 \uba85\uc2dc\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\uadf9\uc7a5 \uc548\ud30e \uc804\uccb4\uc5d0 \ub300\ud55c \uccad\uc18c \ucc45\uc784\uc740 \ub300\uad00\uc744 \uc774\uc6a9\ud55c \ub3d9\uc544\ub9ac \ud559\uc0dd \uce21\uc774 \uc804\uc801\uc73c\ub85c \ubd80\ub2f4\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub3d9\uc544\ub9ac \ub300\ud45c\uac00 \ubc30\uc6b0\ub4e4\uc758 \ubd84\uc7a5 \uc9c0\uc6b0\uae30 \ubc0f \uc18c\ud488 \uc815\ub9ac \uc2dc\uac04\uc744 \uc774\uc720\ub85c \uc804\uccb4 \uccad\uc18c\uc758 \uc5b4\ub824\uc6c0\uc744 \ud53c\ub825\ud558\uc790 \uad6c\uc5ed\uc744 \ub098\ub204\uc5b4 \uccad\uc18c\ud558\uae30\ub85c \ud558\uc600\uc2b5\ub2c8\ub2e4."
