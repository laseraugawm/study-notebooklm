{
  "title": "\ud55c\uae00\ub9de\ucda4\ubc95 \ud034\uc988",
  "questions": [
    {
      "question": "<\ud55c\uae00 \ub9de\ucda4\ubc95> \uc81c1\ud56d \"\ud55c\uae00 \ub9de\ucda4\ubc95\uc740 \ud45c\uc900\uc5b4\ub97c \uc18c\ub9ac\ub300\ub85c \uc801\ub418, \uc5b4\ubc95\uc5d0 \ub9de\ub3c4\ub85d \ud568\uc744 \uc6d0\uce59\uc73c\ub85c \ud55c\ub2e4.\"\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc54c\ub9de\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "'\uc5b4\ubc95\uc5d0 \ub9de\ub3c4\ub85d \ud568'\uc740 \ud45c\uc74c\uc8fc\uc758 \ud45c\uae30 \ubc29\uc2dd\uc73c\ub85c, \ud615\ud0dc\uc18c\uc758 \ubcf8\ub798 \ubaa8\uc591\uc744 \ubc1d\ud600 \uc801\ub294 \uac83\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "'\uc5b4\ubc95\uc5d0 \ub9de\ub3c4\ub85d \ud568'\uc740 \ud615\ud0dc\uc18c\uc758 \ubcf8\ub798 \ubaa8\uc591\uc744 \ubc1d\ud600 \uc801\ub294 \ud45c\uc758\uc8fc\uc758 \ud45c\uae30 \ubc29\uc2dd\uc5d0 \ud574\ub2f9\ud558\uba70, \uc18c\ub9ac\ub300\ub85c \uc801\ub294 \ubc29\uc2dd\uc774 \ud45c\uc74c\uc8fc\uc758\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\ub9ac\ub300\ub85c \uc801\ub294 \ubc29\uc2dd(\ud45c\uc74c\uc8fc\uc758)\uc740 \uc18c\ub9ac \ub098\ub294 \uadf8\ub300\ub85c \uc4f0\uae30 \ub54c\ubb38\uc5d0 \uae00\uc744 \uc4f8 \ub54c \ud45c\uae30\ud558\uae30\uac00 \uc6a9\uc774\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\ub9ac \ub098\ub294 \ub300\ub85c \uc801\ub294 \ud45c\uc74c\uc8fc\uc758 \ubc29\uc2dd\uc740 \ubc1c\uc74c\uc744 \uadf8\ub300\ub85c \ubc18\uc601\ud558\ubbc0\ub85c \ud45c\uae30\ud558\uae30 \uc27d\ub2e4\ub294 \uc7a5\uc810\uc774 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud615\ud0dc\uc18c\uc758 \ubcf8\ub798 \ubaa8\uc591\uc744 \ubc1d\ud600 \uc801\ub294 \ubc29\uc2dd(\ud45c\uc758\uc8fc\uc758)\uc740 \uae00\uc744 \uc77d\uc744 \ub54c \uadf8 \uc758\ubbf8\ub97c \uc27d\uac8c \ud30c\uc545\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5b4\uac04\uc774\ub098 \uc5b4\uadfc\uc758 \ubcf8\ub798 \ud615\ud0dc\ub97c \uc720\uc9c0\ud558\uba74 \ub2e8\uc5b4\uc758 \uc758\ubbf8\uc640 \uae30\ub2a5\uc744 \ud55c\ub208\uc5d0 \uc54c\uc544\ubcf4\uae30 \uc6a9\uc774\ud569\ub2c8\ub2e4."
        },
        {
          "text": "'\ub299\uc5b4[\ub298\uac70]', '\ub299\uc9c0[\ub291\ucc0c]'\ub97c \uc5b4\uac04\uc758 \ud615\ud0dc\ub97c \uace0\uc815\ud558\uc5ec '\ub299-'\uc73c\ub85c \uc801\ub294 \uac83\uc740 \uc5b4\ubc95\uc5d0 \ub9de\ub3c4\ub85d \uc801\uc740 \uc608\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud658\uacbd\uc5d0 \ub530\ub77c \ubc1c\uc74c\uc774 \ub2ec\ub77c\uc838\ub3c4 \uc5b4\uac04\uc758 \uc6d0\ud615\uc744 \uace0\uc815\ud558\uc5ec \uc801\ub294 \uac83\uc740 \ud45c\uc758\uc8fc\uc758(\uc5b4\ubc95\uc5d0 \ub9de\ub3c4\ub85d \ud568)\uc758 \ub300\ud45c\uc801 \uc0ac\ub840\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud45c\uc74c\uc8fc\uc758\uc640 \ud45c\uc758\uc8fc\uc758\uc758 \uac1c\ub150 \ucc28\uc774 \ubc0f \uac01\uac01\uc758 \uc7a5\uc810\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 <\ud55c\uae00 \ub9de\ucda4\ubc95> \uc81c5\ud56d(\ub41c\uc18c\ub9ac \ud45c\uae30)\uc5d0 \ub530\ub77c '\u3131, \u3142' \ubc1b\uce68 \ub4a4\uc5d0\uc11c \ub098\ub294 \ub41c\uc18c\ub9ac\ub97c \ud45c\uae30\uc5d0 \ubc18\uc601\ud558\uc9c0 \uc54a\uc740 \uc608\ub85c\ub9cc \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uae4d\ub450\uae30, \ubab9\uc2dc",
          "isCorrect": true,
          "rationale": "'\uae4d\ub450\uae30'([\uae4d\ub69c\uae30])\uc640 '\ubab9\uc2dc'([\ubab9\uc528])\ub294 '\u3131, \u3142' \ubc1b\uce68 \ub4a4\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \ub41c\uc18c\ub9ac\ub418\uae30\uac00 \ubcf4\ud3b8\uc801\uc774\ubbc0\ub85c \ub41c\uc18c\ub9ac\ub85c \uc801\uc9c0 \uc54a\uace0 \uc608\uc0ac\uc18c\ub9ac\ub85c \ud45c\uae30\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc2f9\uc2f9\ud558\ub2e4, \uc309\uc300\ud558\ub2e4",
          "isCorrect": false,
          "rationale": "\uac19\uac70\ub098 \ube44\uc2b7\ud55c \uc74c\uc808\uc774 \uacb9\uccd0 \ub098\ub294 \uacbd\uc6b0\uc5d0\ub294 \uc608\uc678\uc801\uc73c\ub85c \ub41c\uc18c\ub9ac\ub97c \ud45c\uae30\uc5d0 \ubc18\uc601\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\uca4d\uc0c8, \uc0b0\ub73b\ud558\ub2e4",
          "isCorrect": false,
          "rationale": "\ud55c \ud615\ud0dc\uc18c \uc548\uc758 \ub450 \ubaa8\uc74c \uc0ac\uc774\uc5d0\uc11c \ub098\ub294 \ub41c\uc18c\ub9ac\ub294 \uc18c\ub9ac \ub098\ub294 \ub300\ub85c \ub41c\uc18c\ub9ac\ub85c \uc801\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc4f1\uc2f9\uc4f1\uc2f9, \ub611\ub611\ud558\ub2e4",
          "isCorrect": false,
          "rationale": "\uac19\uc740 \uc74c\uc808\uc774\ub098 \ube44\uc2b7\ud55c \uc74c\uc808\uc774 \ubc18\ubcf5\ub418\ub294 \ub2e8\uc5b4\ub294 \uc608\uc678\uc801\uc73c\ub85c \ub41c\uc18c\ub9ac\ub97c \ud45c\uae30\uc5d0 \ubc18\uc601\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub41c\uc18c\ub9ac\ub418\uae30\uac00 \ubcf4\ud3b8\uc801\uc73c\ub85c \uc77c\uc5b4\ub098\ub294 \ubc1b\uce68 \uc870\uac74\uacfc, \uc74c\uc808\uc774 \ubc18\ubcf5\ub418\ub294 \uc608\uc678 \uaddc\uc815\uc744 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "<\ud55c\uae00 \ub9de\ucda4\ubc95> \uc81c7\ud56d\uc5d0\uc11c\ub294 \"'\u3137' \uc18c\ub9ac\ub85c \ub098\ub294 \ubc1b\uce68 \uc911\uc5d0\uc11c '\u3137'\uc73c\ub85c \uc801\uc744 \uadfc\uac70\uac00 \uc5c6\ub294 \uac83\uc740 '\u3145'\uc73c\ub85c \uc801\ub294\ub2e4.\"\ub77c\uace0 \uaddc\uc815\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c \uc911 \uc774 \uaddc\uc815\uc774 \uc801\uc6a9\ub41c \ub2e8\uc5b4\uac00 \uc544\ub2cc \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubc18\uc9c7\uace0\ub9ac",
          "isCorrect": true,
          "rationale": "'\ubc18\uc9c7\uace0\ub9ac'\ub294 \ub05d\uc18c\ub9ac\uac00 '\u3139'\uc778 \ub9d0('\ubc14\ub290\uc9c8')\uc774 \ub534 \ub9d0\uacfc \uc5b4\uc6b8\ub9b4 \ub54c '\u3139' \uc18c\ub9ac\uac00 '\u3137' \uc18c\ub9ac\ub85c \ub098\uc11c '\u3137'\uc73c\ub85c \uc801\ub294 \uacbd\uc6b0(\uc81c29\ud56d)\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub3d7\uc790\ub9ac",
          "isCorrect": false,
          "rationale": "\uc74c\uc808 \uc885\uc131\uc5d0\uc11c [\u3137]\uc73c\ub85c \uc18c\ub9ac \ub098\uc9c0\ub9cc '\u3137'\uc73c\ub85c \ubc1d\ud600 \uc801\uc744 \uadfc\uac70\uac00 \uc5c6\uc73c\ubbc0\ub85c \uc804\ud1b5\uc801 \uad00\uc2b5\uc5d0 \ub530\ub77c '\u3145'\uc73c\ub85c \uc801\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc6c3\uc5b4\ub978",
          "isCorrect": false,
          "rationale": "[\u3137] \uc18c\ub9ac\uac00 \ub098\ub294 \ubc1b\uce68\uc774\uc9c0\ub9cc '\u3137'\uc73c\ub85c \uace0\uc815\ud560 \uadfc\uac70\uac00 \uc5c6\uc5b4\uc11c '\u3145' \ubc1b\uce68\uc73c\ub85c \uc801\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub367\uc800\uace0\ub9ac",
          "isCorrect": false,
          "rationale": "\ubc1b\uce68 \ubc1c\uc74c\uc774 [\u3137]\uc774\uc9c0\ub9cc '\u3137'\uc73c\ub85c \uc801\uc744 \uc5b4\uc6d0\uc801 \uadfc\uac70\uac00 \ubd80\uc871\ud558\uc5ec '\u3145'\uc73c\ub85c \ud45c\uae30\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub2e8\uc5b4\uc758 \uc5b4\uc6d0\uc774 \ub05d\uc18c\ub9ac '\u3139'\uacfc \uc5f0\uad00\ub418\uc5b4 '\u3137'\uc73c\ub85c \uc18c\ub9ac \ub098\ub294 \uacbd\uc6b0\uc778\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub450\uc74c \ubc95\uce59(\uc81c10\ud56d)\uc5d0 \ub300\ud55c \uc124\uba85 \ubc0f \uc801\uc6a9 \uc0ac\ub840\ub85c \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub2e8\uc5b4 \uccab\uba38\ub9ac\uc758 \ud55c\uc790\uc74c '\ub140, \ub1e8, \ub274, \ub2c8'\ub294 \ub450\uc74c \ubc95\uce59\uc5d0 \ub530\ub77c '\uc5ec, \uc694, \uc720, \uc774'\ub85c \uc801\ub294\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud55c\uc790\uc74c \uccab\uba38\ub9ac\uc758 '\u3134' \uc18c\ub9ac\uac00 \ud0c8\ub77d\ud558\uc5ec '\uc5ec, \uc694, \uc720, \uc774'\ub85c \ud45c\uae30\ub418\ub294 \uac83\uc774 \ub450\uc74c \ubc95\uce59\uc758 \uae30\ubcf8 \uc6d0\uce59\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc758\uc874 \uba85\uc0ac\uc778 '\ub144'\uc774\ub098 '\ub0e5'\uc740 \ub3c5\ub9bd\uc131\uc774 \uac15\ud558\ubbc0\ub85c \ud56d\uc0c1 \ub450\uc74c \ubc95\uce59\uc744 \uc801\uc6a9\ud558\uc5ec '\uc5f0', '\uc591'\uc73c\ub85c \uc801\uc5b4\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc758\uc874 \uba85\uc0ac\ub294 \uc55e\ub9d0\uacfc \uacb0\ud569\ud558\uc5ec \ub2e8\uc704\ub97c \ub098\ud0c0\ub0b4\ubbc0\ub85c \ub450\uc74c \ubc95\uce59\uc744 \uc801\uc6a9\ud558\uc9c0 \uc54a\uace0 \ubcf8\ub798 \uc18c\ub9ac\ub300\ub85c '\ub144', '\ub0e5'\uc73c\ub85c \uc801\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "'\uc0dd\uc0b0 \uc5f0\ub3c4'\uc758 '\uc5f0\ub3c4'\ub294 \uc758\uc874 \uba85\uc0ac\uc774\ubbc0\ub85c \ub450\uc74c \ubc95\uce59\uc744 \uc801\uc6a9\ud558\uc9c0 \uc54a\uace0 '\ub144\ub3c4'\ub85c \uc801\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "'\uc0dd\uc0b0 \uc5f0\ub3c4'\uc758 '\uc5f0\ub3c4'\ub294 \ub3c5\ub9bd\ub41c \uba85\uc0ac\uc774\ubbc0\ub85c \ub450\uc74c \ubc95\uce59\uc774 \uc801\uc6a9\ub418\uc5b4 '\uc5f0\ub3c4'\ub85c \uc801\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "'2025\ub144\ub3c4'\uc758 '\ub144\ub3c4'\ub294 \ub3c5\ub9bd \uba85\uc0ac\uc774\uae30 \ub54c\ubb38\uc5d0 \ub450\uc74c \ubc95\uce59\uc744 \uc801\uc6a9\ud558\uc5ec '2025\uc5f0\ub3c4'\ub85c \uc801\uc5b4\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc22b\uc790 \ub4a4\uc5d0 \ubd99\ub294 '\ub144\ub3c4'\ub294 \uc758\uc874 \uba85\uc0ac\uc774\ubbc0\ub85c \ub450\uc74c \ubc95\uce59\uc744 \uc801\uc6a9\ud558\uc9c0 \uc54a\uace0 \uc18c\ub9ac \ub098\ub294 \ub300\ub85c '\ub144\ub3c4'\ub85c \uc801\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc758\uc874 \uba85\uc0ac\uc640 \ub3c5\ub9bd \uba85\uc0ac\uc5d0\uc11c \ub450\uc74c \ubc95\uce59\uc774 \uc5b4\ub5bb\uac8c \uc801\uc6a9\ub418\ub294\uc9c0 \uc608\uc678 \uc0ac\ub840\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "<\ud55c\uae00 \ub9de\ucda4\ubc95> \uc81c15\ud56d [\ubd99\uc784 1] \"\ub450 \uac1c\uc758 \uc6a9\uc5b8\uc774 \uc5b4\uc6b8\ub824 \ud55c \uac1c\uc758 \uc6a9\uc5b8\uc774 \ub420 \uc801\uc5d0, \uc55e\ub9d0\uc758 \ubcf8\ub73b\uc774 \uc720\uc9c0\ub418\uace0 \uc788\ub294 \uac83\uc740 \uadf8 \uc6d0\ud615\uc744 \ubc1d\ud788\uc5b4 \uc801\uace0, \uadf8 \ubcf8\ub73b\uc5d0\uc11c \uba40\uc5b4\uc9c4 \uac83\uc740 \ubc1d\ud788\uc5b4 \uc801\uc9c0 \uc544\ub2c8\ud55c\ub2e4.\"\ub97c \uc801\uc6a9\ud560 \ub54c \uc62c\ubc14\ub978 \ud45c\uae30\ub85c\ub9cc \ubb36\uc778 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub298\uc5b4\ub098\ub2e4, \ub4dc\ub7ec\ub098\ub2e4",
          "isCorrect": true,
          "rationale": "'\ub298\uc5b4\ub098\ub2e4'\ub294 \uc55e\ub9d0 '\ub298\ub2e4'\uc758 \ubcf8\ub73b\uc774 \uc720\uc9c0\ub418\uc5b4 \uc6d0\ud615\uc744 \ubc1d\ud788\uace0, '\ub4dc\ub7ec\ub098\ub2e4'\ub294 '\ub4e4\ub2e4'\uc758 \ubcf8\ub73b\uc5d0\uc11c \uba40\uc5b4\uc84c\uc73c\ubbc0\ub85c \uc18c\ub9ac\ub300\ub85c \uc801\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub290\ub7ec\ub098\ub2e4, \ub4e4\uc5b4\ub098\ub2e4",
          "isCorrect": false,
          "rationale": "'\ub298\uc5b4\ub098\ub2e4'\ub294 \ubcf8\ub73b\uc774 \uc720\uc9c0\ub418\ubbc0\ub85c \uc6d0\ud615\uc744 \ubc1d\ud600\uc57c \ud558\uba70, '\ub4dc\ub7ec\ub098\ub2e4'\ub294 \ubcf8\ub73b\uc5d0\uc11c \uba40\uc5b4\uc84c\uc73c\ubbc0\ub85c \uc18c\ub9ac\ub300\ub85c \uc801\uc5b4\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub298\uc5b4\ub098\ub2e4, \ub4e4\uc5b4\ub098\ub2e4",
          "isCorrect": false,
          "rationale": "'\ub4dc\ub7ec\ub098\ub2e4'\ub294 '\ub4e4\ub2e4'\uc758 \ubcf8\ub798 \uc758\ubbf8\uac00 \uba40\uc5b4\uc84c\uc73c\ubbc0\ub85c '\ub4e4\uc5b4\ub098\ub2e4'\ub85c \uc6d0\ud615\uc744 \ubc1d\ud600 \uc801\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub290\ub7ec\ub098\ub2e4, \ub4dc\ub7ec\ub098\ub2e4",
          "isCorrect": false,
          "rationale": "'\ub298\uc5b4\ub098\ub2e4'\ub294 '\ub298\ub2e4'\uc758 \uc758\ubbf8\uac00 \uadf8\ub300\ub85c \ub0a8\uc544 \uc788\uc73c\ubbc0\ub85c \uc18c\ub9ac\ub300\ub85c '\ub290\ub7ec\ub098\ub2e4'\ub77c\uace0 \uc801\uc73c\uba74 \uc548 \ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc55e\ub9d0 \uc6a9\uc5b8\uc758 \ubcf8\ub798 \uc758\ubbf8\uac00 \ud569\uc131\uc5b4 \ub0b4\uc5d0\uc11c \uacc4\uc18d \uc720\uc9c0\ub418\uace0 \uc788\ub294\uc9c0\ub97c \ud310\ub2e8\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "<\ud55c\uae00 \ub9de\ucda4\ubc95> \uc81c19\ud56d(\uc5b4\uac04\uc5d0 \uc811\ubbf8\uc0ac\uac00 \ubd99\uc5b4 \uba85\uc0ac\ub098 \ubd80\uc0ac\uac00 \ub41c \ub9d0\uc758 \ud45c\uae30)\uc5d0 \ub530\ub77c \uc5b4\uac04\uc758 \ubcf8\ub798 \ub73b \uc720\uc9c0 \uc5ec\ubd80\uc5d0 \ub530\ub77c \uc62c\ubc14\ub974\uac8c \ud45c\uae30\ub41c \ubb38\uc7a5\uc740?",
      "answerOptions": [
        {
          "text": "\uc81c\uc0ac\uc5d0 \uc4f8 \ub18b\uadf8\ub987\uc744 \uae68\ub057\uc774 \ub2e6\uace0, \ubaa9\uc5d0 \uac70\ub294 \ubaa9\uac78\uc774\ub97c \ucc59\uacbc\ub2e4.",
          "isCorrect": true,
          "rationale": "'\ub18b\uadf8\ub987'\uc740 '\u3145' \ubc1b\uce68 \ud45c\uae30 \uaddc\uc815\uc744 \ub530\ub974\uace0, '\ubaa9\uc5d0 \uac70\ub294 \ubb3c\uac74'\uc740 \uc5b4\uac04 '\uac78-'\uc758 \ubcf8\ub73b\uc774 \uc720\uc9c0\ub418\ubbc0\ub85c \uc6d0\ud615\uc744 \ubc1d\ud600 '\ubaa9\uac78\uc774'\ub85c \uc801\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa9\uc774 \ubd93\uace0 \uc544\ud508 \ubcd1\uc5d0 \uac78\ub824\uc11c \ubcd1\uc6d0\uc5d0 \uac00\uc11c \ubaa9\uac78\uc774 \uc57d\uc744 \ucc98\ubc29\ubc1b\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubaa9\uc774 \ubd93\ub294 \ubcd1\uc740 \uc5b4\uac04 '\uac78-'\uc758 \ubcf8\ub73b\uc5d0\uc11c \uba40\uc5b4\uc9c4 \uac83\uc774\ubbc0\ub85c \uc6d0\ud615\uc744 \ubc1d\ud788\uc9c0 \uc54a\uace0 '\ubaa9\uac70\ub9ac'\ub85c \uc801\uc5b4\uc57c \ud569\ub2c8\ub2e4."
        },
        {
