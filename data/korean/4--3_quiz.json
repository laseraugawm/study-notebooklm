{
  "title": "\ub9e4\uccb4 \uc18c\ud1b5 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uad6c\uc220 \ub9e4\uccb4\ub97c \ud65c\uc6a9\ud55c \uc18c\ud1b5\uc758 \ud2b9\uc131\uacfc \ud55c\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud654\uc790\uc640 \uccad\uc790\uac00 \uc9c1\uc811 \ub300\uba74\ud558\uc5ec \uc18c\ud1b5\ud558\ubbc0\ub85c \ub2f9\ub300\uc758 \uc0c1\ud669\uacfc \ub9e5\ub77d\uc744 \uacf5\uc720\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uad6c\uc220 \ub9e4\uccb4\ub294 \ub9d0\ud558\uae30\ub97c \ud1b5\ud55c \uc18c\ud1b5\uc73c\ub85c, \ud654\uc790\uc640 \uccad\uc790\uac00 \uac19\uc740 \uacf5\uac04\uc5d0\uc11c \uc9c1\uc811 \ub9c8\uc8fc\ud558\uc5ec \uc0c1\ud669\uacfc \ub9e5\ub77d\uc744 \uacf5\uc720\ud55c\ub2e4\ub294 \ud2b9\uc9d5\uc774 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uae00\uc4f4\uc774\uc640 \ub3c5\uc790\uc758 \uc2dc\uacf5\uac04 \uc0c1\ud669\uc774 \ubd84\ub9ac\ub418\ub294 \ud0c8\uc0c1\ud669\uc801, \ud0c8\ub9e5\ub77d\uc801 \uc18c\ud1b5\uc774 \uc8fc\ub97c \uc774\ub8ec\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae00\uc4f4\uc774\uc640 \ub3c5\uc790\uac00 \uc2dc\uacf5\uac04 \uc0c1\ud669\uc744 \uacf5\uc720\ud558\uc9c0 \uc54a\uace0 \ubd84\ub9ac\ub418\ub294 \ud0c8\uc0c1\ud669\uc801\u00b7\ud0c8\ub9e5\ub77d\uc801 \uc18c\ud1b5\uc740 \ubb38\uc790 \ub9e4\uccb4\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc2dd\uacfc \uc815\ubcf4\uac00 \ubb38\uc790\ub85c \uae30\ub85d\ub418\uc5b4 \uc2dc\uacf5\uac04\uc758 \uc81c\uc57d \uc5c6\uc774 \uba40\ub9ac\uae4c\uc9c0 \uc548\uc815\uc801\uc73c\ub85c \uc804\uc2b9\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6c\uc220 \ub9e4\uccb4\ub294 \uc785\uc5d0\uc11c \uc785\uc73c\ub85c \uc804\ud574\uc9c0\ub294 \uad6c\uc804\uc5d0 \uc758\uc874\ud558\uc600\uae30 \ub54c\ubb38\uc5d0 \uc9c0\uc2dd\uacfc \uc815\ubcf4\uc758 \uae30\ub85d, \ubcf4\uc874, \uc720\ud1b5\uc5d0 \ud55c\uacc4\uac00 \uc788\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc74c\uc131, \ubb38\uc790, \uc774\ubbf8\uc9c0 \ub4f1\uc774 \ubcf5\ud569\uc801\uc73c\ub85c \uc5b4\uc6b0\ub7ec\uc9c4 \ud558\uc774\ud37c\ud14d\uc2a4\ud2b8\ub97c \ub2a5\ub3d9\uc801\uc73c\ub85c \ud0d0\uc0c9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud558\uc774\ud37c\ud14d\uc2a4\ud2b8\uc640 \ubcf5\ud569\uc591\uc2dd\uc131\uc744 \ud65c\uc6a9\ud558\ub294 \ub2a5\ub3d9\uc801 \uc815\ubcf4 \ud0d0\uc0c9\uc740 \ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uad6c\uc220 \ub9e4\uccb4\ub294 \ubb38\uc790\uac00 \ubc1c\ub2ec\ud558\uae30 \uc804, \ud654\uc790\uc640 \uccad\uc790\uac00 \uc9c1\uc811 \ub9cc\ub098\ub294 \ub300\uba74 \uc0c1\ud669\uc744 \uc804\uc81c\ub85c \ud569\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ubb38\uc790 \ub9e4\uccb4\uc758 \ub4f1\uc7a5\uacfc \ubc1c\ub2ec\uc774 \uac00\uc838\uc628 \uc18c\ud1b5 \ubb38\ud654\uc758 \ubcc0\ud654\ub85c \uc62c\ubc14\ub974\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud654\uc790\uc640 \uccad\uc790\uac00 \uc9c1\uc811 \ub300\uba74\ud558\uc5ec \uc2e4\uc2dc\uac04\uc73c\ub85c \uc0c1\ud669\uacfc \ub9e5\ub77d\uc744 \uae34\ubc00\ud788 \uacf5\uc720\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud654\uc790\uc640 \uccad\uc790\uac00 \uc9c1\uc811 \ub300\uba74\ud558\uc5ec \uc0c1\ud669\uacfc \ub9e5\ub77d\uc744 \uacf5\uc720\ud558\ub294 \uac83\uc740 \uad6c\uc220 \ub9e4\uccb4\uc758 \ud2b9\uc9d5\uc774\uba70, \ubb38\uc790 \ub9e4\uccb4\ub294 \uc2dc\uacf5\uac04 \uc0c1\ud669\uc774 \ubd84\ub9ac\ub41c \ud0c8\uc0c1\ud669\uc801 \uc18c\ud1b5\uc744 \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc4f0\uae30\uc640 \uc77d\uae30\ub97c \uc911\uc2ec\uc73c\ub85c \uc18c\ud1b5\uc774 \uc774\ub8e8\uc5b4\uc9c0\uba70 \uc2dc\uacf5\uac04\uc801 \ud55c\uacc4\ub97c \uadf9\ubcf5\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb38\uc790 \ub9e4\uccb4\ub294 \uae00\ub85c \uc9c0\uc2dd\uc744 \uae30\ub85d\ud568\uc73c\ub85c\uc368 \uad6c\uc220 \ub9e4\uccb4\uac00 \uac00\uc84c\ub358 \uc2dc\uacf5\uac04\uc801 \uc81c\uc57d\uc744 \ub118\uc5b4\uc124 \uc218 \uc788\uac8c \ud574 \uc8fc\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uae00\uc4f4\uc774\uc640 \ub3c5\uc790\uac00 \uc11c\ub85c \ub5a8\uc5b4\uc838 \uc788\ub294 \ud658\uacbd\uc5d0\uc11c \uc18c\ud1b5\ud558\ub294 \ud0c8\uc0c1\ud669\uc801, \ud0c8\ub9e5\ub77d\uc801 \uc131\uaca9\uc744 \ub764\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb38\uc790 \ub9e4\uccb4\uc5d0\uc11c\ub294 \uae00\uc744 \uc4f0\ub294 \uc0c1\ud669\uacfc \uc77d\ub294 \uc0c1\ud669\uc774 \uacf5\uc720\ub418\uc9c0 \uc54a\uc73c\ubbc0\ub85c \ud0c8\uc0c1\ud669\uc801\u00b7\ud0c8\ub9e5\ub77d\uc801 \uc18c\ud1b5\uc774 \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uc1c4\uc220\uc758 \ubc1c\ub2ec\ub85c \ucc45\uc774 \ub300\ub7c9 \uc720\ud1b5\ub418\uba74\uc11c \uc9c0\uc2dd\uc758 \ucd95\uc801\uacfc \ub300\uc911\ud654\uc5d0 \uae30\uc5ec\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\uc1c4\uc220\uc758 \ubc1c\ub2ec\uc740 \ubb38\uc790 \ub9e4\uccb4\uc758 \uc720\ud1b5\uc744 \ud65c\uc131\ud654\ud558\uc5ec \uc9c0\uc2dd\uacfc \uc815\ubcf4\uc758 \ucd95\uc801 \ubc0f \uc9c0\uc2dd\uc758 \ub300\uc911\ud654\ub97c \uac00\uc838\uc654\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubb38\uc790\ub85c \uae30\ub85d\ub41c \uae00\uc744 \uc77d\uace0 \uc4f0\ub294 \uc18c\ud1b5 \ud658\uacbd\uc758 \ud2b9\uc9d5\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc601\uc0c1 \ub9e4\uccb4\ub97c \ud65c\uc6a9\ud55c \uc18c\ud1b5\uc758 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2dc\uccad\uac01 \uc774\ubbf8\uc9c0 \uc911\uc2ec\uc774\uc5b4\uc11c \uc218\uc6a9\uc790\uac00 \ubcf4\ud3b8\uc801\uc73c\ub85c \ub0b4\uc6a9\uc744 \uc27d\uac8c \uc774\ud574\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc601\uc0c1 \ub9e4\uccb4\ub294 \uae00 \uc911\uc2ec\uc758 \ubb38\uc790 \ub9e4\uccb4\uc640 \ub2ec\ub9ac \uc2dc\uccad\uac01 \uc774\ubbf8\uc9c0\ub97c \ud65c\uc6a9\ud558\ubbc0\ub85c \ub3c5\ud574 \ub2a5\ub825 \ucc28\uc774\uc640 \uc0c1\uad00\uc5c6\uc774 \ubcf4\ud3b8\uc801\uc73c\ub85c \uc27d\uac8c \ub0b4\uc6a9\uc744 \uc774\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc218\uc6a9\uc790\uc758 \ub3c5\ud574 \ub2a5\ub825 \ucc28\uc774\uc5d0 \ub530\ub77c \ub9e4\uccb4 \ub0b4\uc6a9\uc758 \uc774\ud574 \uc218\uc900 \ucc28\uc774\uac00 \ud06c\uac8c \ubc1c\uc0dd\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae00\uc744 \uc77d\uace0 \uc774\ud574\ud558\ub294 \ub2a5\ub825(\ub3c5\ud574\ub825)\uc5d0 \ub530\ub77c \ub0b4\uc6a9 \uc774\ud574 \uc815\ub3c4\uc5d0 \ucc28\uc774\uac00 \ubc1c\uc0dd\ud558\ub294 \uac83\uc740 \uae00 \uc911\uc2ec\uc758 \ubb38\uc790 \ub9e4\uccb4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc774\uc6a9\uc790\uac00 \uc815\ubcf4\uc758 \uc18c\ube44\uc790\uc774\uc790 \uc0dd\uc0b0\uc790\ub85c\uc11c \uc2e4\uc2dc\uac04\uc73c\ub85c \uc801\uadf9 \ucc38\uc5ec\ud558\ub294 \uc0c1\ud638 \uc791\uc6a9\uc131\uc774 \ud575\uc2ec\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\ube44\uc790\uc640 \uc0dd\uc0b0\uc790 \uc5ed\ud560\uc744 \uacb8\ud558\uba70 \ub2a5\ub3d9\uc801\uc73c\ub85c \ubb38\ud654\ub97c \ucc3d\uc870\ud558\ub294 \uac83\uc740 \ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 \uc0c1\ud638 \uc791\uc6a9\uc131\uc5d0 \ud574\ub2f9\ud558\ub294 \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubcf4\uc758 \uc0dd\uc0b0\uc790\uc640 \uc218\uc6a9\uc790\uac00 \uc77c\ub300\uc77c \uc218\ud3c9 \uad00\uacc4\uc5d0\uc11c \uc2e4\uc2dc\uac04 \uc30d\ubc29\ud5a5 \uc18c\ud1b5\uc744 \uc9c0\uc18d\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\uc874 \uc601\uc0c1 \ub9e4\uccb4(\uc601\ud654, TV \ub4f1)\ub294 \uc0dd\uc0b0\uc790\ub85c\ubd80\ud130 \ub2e4\uc218\uc758 \uc218\uc6a9\uc790\uc5d0\uac8c \uc815\ubcf4\uac00 \uc804\ub2ec\ub418\ub294 \ub300\uc911\ub9e4\uccb4 \uc131\uaca9\uc774 \uac15\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc601\ud654\ub098 \ud154\ub808\ube44\uc804 \ub4f1 \uc2dc\uccad\uac01 \uc774\ubbf8\uc9c0\ub97c \ud65c\uc6a9\ud558\ub294 \ub9e4\uccb4\uc758 \uc218\uc6a9 \ud2b9\uc131\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 \uc8fc\uc694 \ud2b9\uc131 \uc911 '\ubcf5\ud569\uc591\uc2dd\uc131'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc74c\uc131, \ubb38\uc790, \uadf8\ub9bc, \ub3d9\uc601\uc0c1 \ub4f1 \ub2e4\uc591\ud55c \uc591\uc2dd\uc774 \ud63c\ud569\ub418\uc5b4 \ub098\ud0c0\ub098\ub294 \ud2b9\uc131\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubcf5\ud569\uc591\uc2dd\uc131\uc740 \uc74c\uc131, \ubb38\uc790, \uadf8\ub9bc, \ub3d9\uc601\uc0c1 \ub4f1 \uc5ec\ub7ec \uc18c\ud1b5 \uc591\uc2dd\uc774 \uc5b4\uc6b0\ub7ec\uc838 \ub098\ud0c0\ub098\ub294 \ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc774\uc6a9\uc790\uac00 \ub9c1\ud06c \ub4f1\uc744 \uc774\uc6a9\ud574 \ub2e4\ub978 \ubb38\uc11c\ub098 \uad00\ub828 \uc815\ubcf4\ub85c \ubc14\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\ub294 \ud2b9\uc131\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e4\ub978 \ubb38\uc11c\ub098 \uc815\ubcf4\ub85c \ube60\ub974\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\ub294 \ud14d\uc2a4\ud2b8 \uc5f0\uacb0 \uad6c\uc870\ub294 \ud558\uc774\ud37c\ud14d\uc2a4\ud2b8\uc5d0 \ub300\ud55c \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc218\uc6a9\uc790\uac00 \uc9c0\uc2dd\uc744 \ub2a5\ub3d9\uc801\uc73c\ub85c \uc120\ud0dd\ud558\uace0 \uc0dd\uc0b0\uc790 \uc5ed\ud560\uc744 \uacb8\ud558\ub294 \ud2b9\uc131\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\uc0b0\uc790\uc640 \uc18c\ube44\uc790\uc758 \uc5ed\ud560\uc744 \uacb8\ud558\uba70 \uc30d\ubc29\ud5a5\uc73c\ub85c \ucc38\uc5ec\ud558\ub294 \uac83\uc740 \uc0c1\ud638 \uc791\uc6a9\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0\uc790\uac00 \uc804\ub2ec\ud558\ub294 \uc815\ubcf4\ub97c \ub2e4\uc218\uc758 \uc218\uc6a9\uc790\uac00 \ub3d9\uc2dc\uc5d0 \uc2dc\uccad\uac01\uc801\uc73c\ub85c \uc218\uc6a9\ud558\ub294 \ud2b9\uc131\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e4\uc218\uc758 \uc218\uc6a9\uc790\uac00 \ub3d9\uc2dc\uc5d0 \uc815\ubcf4\ub97c \uc77c\ubc29\ud5a5\uc801\uc73c\ub85c \uc218\uc6a9\ud558\ub294 \uac83\uc740 \ub300\uc911\ub9e4\uccb4(\uc601\uc0c1 \ub9e4\uccb4 \ub4f1)\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud558\ub098\uc758 \ub9e4\uccb4 \ud45c\ud604\ubb3c \uc548\uc5d0 \uc5ec\ub7ec \uc591\uc2dd(\uc74c\uc131, \ubb38\uc790, \uc601\uc0c1 \ub4f1)\uc774 \uc5b4\ub5bb\uac8c \uacb0\ud569\ud558\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub514\uc9c0\ud138 \ub9e4\uccb4 \ud658\uacbd\uc5d0\uc11c \uc81c\uacf5\ub418\ub294 '\ud558\uc774\ud37c\ud14d\uc2a4\ud2b8'\uc758 \uc5ed\ud560\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc774\uc6a9\uc790\uac00 \ub2e4\uc591\ud55c \ubb38\uc11c\ub098 \uc815\ubcf4\ub85c \ubc14\ub85c \uc774\ub3d9\ud558\uba70 \ud544\uc694\ud55c \uc815\ubcf4\ub97c \uc190\uc27d\uac8c \uc5bb\ub3c4\ub85d \ub3d5\ub294\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud558\uc774\ud37c\ud14d\uc2a4\ud2b8\ub294 \uc774\uc6a9\uc790\uac00 \ub2e4\ub978 \ubb38\uc11c\ub098 \uc815\ubcf4\ub85c \ubc14\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\ub3c4\ub85d \ud14d\uc2a4\ud2b8 \ub9c1\ud06c\ub97c \uc81c\uacf5\ud558\uc5ec \uc6d0\ud558\ub294 \uc815\ubcf4\ub97c \uc790\uc720\ub86d\uac8c \ub118\ub098\ub4e4\uac8c \ud574 \uc90d\ub2c8\ub2e4."
        },
        {
          "text": "\uae00\uc4f4\uc774\uc640 \ub3c5\uc790\uac00 \ub3d9\uc77c\ud55c \ub300\uba74 \uacf5\uac04\uc744 \uacf5\uc720\ud558\ub3c4\ub85d \ub3d5\ub294 \uc74c\uc131 \uc18c\ud1b5 \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud558\uc774\ud37c\ud14d\uc2a4\ud2b8\ub294 \uc74c\uc131 \ub300\uba74 \uc18c\ud1b5\uc774 \uc544\ub2cc \ub514\uc9c0\ud138 \ub124\ud2b8\uc6cc\ud06c \ub0b4 \ubb38\uc11c \uac04 \uc774\ub3d9 \uad6c\uc870\ub97c \ub73b\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uae00\uc744 \uc77d\uace0 \uc774\ud574\ud558\ub294 \ub2a5\ub825\uc774 \ubd80\uc871\ud55c \ub3c5\uc790\uc758 \uc811\uadfc\uc744 \uc81c\ud55c\ud558\ub294 \ubcf4\uc548 \uc7a5\uce58\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud558\uc774\ud37c\ud14d\uc2a4\ud2b8\ub294 \uc815\ubcf4 \uc811\uadfc\uc744 \uc81c\ud55c\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ub2e4\uc591\ud55c \uc815\ubcf4 \ud0d0\uc0c9 \uacbd\ub85c\ub97c \ud655\uc7a5\ud574 \uc8fc\ub294 \uae30\ub2a5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0\uc790\uac00 \uc815\ud574 \ub193\uc740 \uc21c\uc11c\ub300\ub85c\ub9cc \uc218\uc6a9\uc790\uac00 \uae00\uc744 \uc77d\ub3c4\ub85d \uac15\uc81c\ud558\ub294 \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud558\uc774\ud37c\ud14d\uc2a4\ud2b8\ub294 \uc774\uc6a9\uc790\uac00 \uc6d0\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \uc774\ub3d9\ud558\uba70 \uc2a4\uc2a4\ub85c \uc120\ud0dd\ud560 \uc218 \uc788\ub3c4\ub85d \uc790\uc728\uc131\uc744 \ub192\uc5ec \uc90d\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc778\ud130\ub137 \uae30\uc0ac\ub098 \uae00\uc5d0\uc11c \ud2b9\uc815 \ubb38\uad6c\ub97c \ub20c\ub7ec \uad00\ub828 \ubb38\uc11c\ub85c \uc774\ub3d9\ud558\ub294 \ubc29\uc2dd\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 '\uc0c1\ud638 \uc791\uc6a9\uc131'\uc774 \uae30\uc874 \ub300\uc911\ub9e4\uccb4\uc758 \uc18c\ud1b5 \ubc29\uc2dd\uacfc \uad6c\ubd84\ub418\ub294 \uac00\uc7a5 \ud070 \ud2b9\uc9d5\uc740?",
      "answerOptions": [
        {
          "text": "\uc774\uc6a9\uc790\uac00 \uc9c0\uc2dd\uacfc \uc815\ubcf4\uc758 \uc18c\ube44\uc790\uc778 \ub3d9\uc2dc\uc5d0 \uc0dd\uc0b0\uc790 \uc5ed\ud560\uc744 \uacb8\ud558\uba70 \ub2a5\ub3d9\uc801\uc73c\ub85c \ubb38\ud654\ub97c \ucc3d\uc870\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0c1\ud638 \uc791\uc6a9\uc131\uc5d0 \ub530\ub77c \ub514\uc9c0\ud138 \ub9e4\uccb4 \uc774\uc6a9\uc790\ub294 \ub2e8\uc21c\ud788 \uc815\ubcf4\ub97c \uc218\uc6a9\ud558\uae30\ub9cc \ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc9c1\uc811 \uc0dd\uc0b0\ud558\uace0 \ud574\uc11d\ud558\ub294 \uc8fc\uccb4\uac00 \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0\uc790\ub85c\ubd80\ud130 \uc218\uc6a9\uc790\uc5d0\uac8c \uc815\ubcf4\uac00 \uc77c\ubc29\uc801\uc73c\ub85c \uc804\ub2ec\ub418\uc5b4 \ub300\uc911\uc758 \ub3d9\uc2dc \uc218\uc6a9\uc744 \uc720\ub3c4\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ubcf4\uac00 \uc77c\ubc29\uc801\uc73c\ub85c \uc804\ub2ec\ub418\ub294 \ubc29\uc2dd\uc740 \uc804\ud1b5\uc801\uc778 \uae30\uc874 \ub300\uc911\ub9e4\uccb4\uc758 \uc18c\ud1b5 \ubc29\uc2dd\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubb38\uc790 \ub9e4\uccb4\uc758 \ud55c\uacc4\ub97c \ubcf4\uc644\ud558\uae30 \uc704\ud574 \ubb38\uc790\ub97c \ubc30\uc81c\ud558\uace0 \ub3d9\uc601\uc0c1\ub9cc \uc0ac\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub514\uc9c0\ud138 \ub9e4\uccb4\ub294 \ubb38\uc790\ub97c \ubc30\uc81c\ud558\uc9c0 \uc54a\uc73c\uba70, \ubcf5\ud569\uc591\uc2dd\uc131\uc5d0 \ub530\ub77c \uc74c\uc131, \ubb38\uc790, \uadf8\ub9bc, \uc601\uc0c1 \ub4f1\uc744 \ud568\uaed8 \uc0ac\uc6a9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\ud1b5 \ub2f9\uc0ac\uc790 \uac04\uc758 \uc2dc\uacf5\uac04\uc801 \uc81c\uc57d\uc774 \uc2ec\ud574\uc838\uc11c \uc0ac\uc804\uc5d0 \uc815\ud574\uc9c4 \uc7a5\uc18c\uc5d0\uc11c\ub9cc \ub300\ud654\uac00 \uc774\ub8e8\uc5b4\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub514\uc9c0\ud138 \ub9e4\uccb4\ub294 \ub313\uae00, \uc2e4\uc2dc\uac04 \ub300\ud654 \ub4f1\uc744 \ud1b5\ud574 \uc2dc\uacf5\uac04\uc758 \uc81c\uc57d\uc744 \ud06c\uac8c \uadf9\ubcf5\ud558\uc600\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub514\uc9c0\ud138 \ub9e4\uccb4 \uc774\uc6a9\uc790\uac00 \uc815\ubcf4\uc758 '\uc0dd\uc0b0\uc790'\uc774\uc790 '\uc18c\ube44\uc790'\ub85c\uc11c \uc5b4\ub5a4 \uc5ed\ud560\uc744 \ud558\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc18c\ud1b5 \ub9e4\uccb4\uc758 \uc5ed\uc0ac\uc801 \ubcc0\ucc9c \uacfc\uc815\uc744 \uc21c\uc11c\ub300\ub85c \uc62c\ubc14\ub974\uac8c \uc9dd\uc9c0\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uad6c\uc220 \ub9e4\uccb4 \u2192 \ubb38\uc790 \ub9e4\uccb4 \u2192 \uc601\uc0c1 \ub9e4\uccb4 \u2192 \ub514\uc9c0\ud138 \ub9e4\uccb4",
          "isCorrect": true,
          "rationale": "\uc18c\ud1b5 \ub9e4\uccb4\ub294 \ub9d0\ud558\uae30 \uc911\uc2ec\uc758 \uad6c\uc220 \ub9e4\uccb4\uc5d0\uc11c \uc4f0\uae30\u00b7\uc77d\uae30 \uc911\uc2ec\uc758 \ubb38\uc790 \ub9e4\uccb4, \uc2dc\uccad\uac01 \uc774\ubbf8\uc9c0 \uc911\uc2ec\uc758 \uc601\uc0c1 \ub9e4\uccb4\ub97c \uac70\uccd0 \ubcf5\ud569\uc801\uc778 \ub514\uc9c0\ud138 \ub9e4\uccb4\ub85c \ubc1c\uc804\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uad6c\uc220 \ub9e4\uccb4 \u2192 \uc601\uc0c1 \ub9e4\uccb4 \u2192 \ubb38\uc790 \ub9e4\uccb4 \u2192 \ub514\uc9c0\ud138 \ub9e4\uccb4",
          "isCorrect": false,
          "rationale": "\uc601\uc0c1 \ub9e4\uccb4\ub294 \uc601\ud654, TV \ub4f1\uc73c\ub85c \uc778\uc1c4\uc220 \ubc1c\ub2ec \uc774\ud6c4 \ubb38\uc790 \ub9e4\uccb4\ub97c \uac70\uce5c \ub4a4 \ub4f1\uc7a5\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubb38\uc790 \ub9e4\uccb4 \u2192 \uad6c\uc220 \ub9e4\uccb4 \u2192 \ub514\uc9c0\ud138 \ub9e4\uccb4 \u2192 \uc601\uc0c1 \ub9e4\uccb4",
          "isCorrect": false,
          "rationale": "\ubb38\uc790\uac00 \ubc1c\uba85\ub418\uae30 \uc774\uc804\uc758 \uc8fc\ub41c \uc18c\ud1b5 \ub9e4\uccb4\ub294 \uad6c\uc220 \ub9e4\uccb4(\ub9d0\ud558\uae30)\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc601\uc0c1 \ub9e4\uccb4 \u2192 \uad6c\uc220 \ub9e4\uccb4 \u2192 \ubb38\uc790 \ub9e4\uccb4 \u2192 \ub514\uc9c0\ud138 \ub9e4\uccb4",
          "isCorrect": false,
          "rationale": "\uad6c\uc220 \ub9e4\uccb4\uc640 \ubb38\uc790 \ub9e4\uccb4\uac00 \uadfc\ub300 \uc774\ud6c4 \ub4f1\uc7a5\ud55c \uc601\uc0c1 \ub9e4\uccb4\ubcf4\ub2e4 \uc55e\uc120 \uc5ed\uc0ac\uc801 \ub9e4\uccb4\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubb38\uc790\uac00 \uc0dd\uae30\uae30 \uc774\uc804\ubd80\ud130 \ud604\ub300 \uc2a4\ub9c8\ud2b8\ud3f0 \ud658\uacbd\uc5d0 \uc774\ub974\ub294 \ub9e4\uccb4\uc758 \ubc1c\uc804 \uacfc\uc815\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc0ac\ud68c \uad00\uacc4\ub9dd \uc11c\ube44\uc2a4[SNS]\uc640 1\uc778 \ubbf8\ub514\uc5b4 \ubc29\uc1a1\uc774 \ubcf4\uc5ec \uc8fc\ub294 \uacf5\ud1b5\uc801\uc778 \uc18c\ud1b5 \ubc29\uc2dd\uc740?",
      "answerOptions": [
        {
          "text": "\ub313\uae00\uacfc \uc2e4\uc2dc\uac04 \ub300\ud654\ub97c \ud65c\uc6a9\ud558\uc5ec \uc2dc\uacf5\uac04\uc758 \uc81c\uc57d\uc744 \ubc1b\uc9c0 \uc54a\uace0 \uc30d\ubc29\ud5a5\uc73c\ub85c \uc18c\ud1b5\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "SNS\uc640 1\uc778 \ubbf8\ub514\uc5b4 \ubc29\uc1a1\uc740 \uc218\uc6a9\uc790\uc640 \uc0dd\uc0b0\uc790\uac00 \ub313\uae00\uc774\ub098 \uc2e4\uc2dc\uac04 \ub300\ud654 \ub4f1\uc73c\ub85c \uc2dc\uacf5\uac04 \uc81c\uc57d \uc5c6\uc774 \uc30d\ubc29\ud5a5\uc73c\ub85c \ubc18\uc751\uc744 \ub098\ub204\uba70 \uc18c\ud1b5\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0\uc790\uac00 \uc81c\uc791\ud55c \ucf58\ud150\uce20\uac00 \uc218\uc6a9\uc790\uc5d0\uac8c \uc77c\ubc29\ud5a5\uc73c\ub85c\ub9cc \uc804\ub2ec\ub418\uba70 \uc218\uc6a9\uc790\uc758 \ud53c\ub4dc\ubc31\uc740 \ucc28\ub2e8\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "SNS\uc640 1\uc778 \ubbf8\ub514\uc5b4 \ubc29\uc1a1\uc740 \uc77c\ubc29\ud5a5 \uc804\ub2ec\uc774 \uc544\ub2c8\ub77c \uc30d\ubc29\ud5a5 \uc18c\ud1b5\uc774 \uc77c\uc5b4\ub098\ub294 \ub9e4\uccb4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud654\uc790\uc640 \uccad\uc790\uac00 \uc9c1\uc811 \uc5bc\uad74\uc744 \ub9c8\uc8fc\ubcf4\uace0 \ub300\uba74\ud558\ub294 \uad6c\uc220 \uc18c\ud1b5 \ud615\ud0dc\ub97c \ud544\uc218\ub85c \uc694\uad6c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e4\uc2dc\uac04 \ubc29\uc1a1\uc774\ub098 SNS\ub294 \uc628\ub77c\uc778 \ub124\ud2b8\uc6cc\ud06c\ub97c \uae30\ubc18\uc73c\ub85c \ud558\ubbc0\ub85c \uc9c1\uc811 \ub300\uba74\ud558\uc9c0 \uc54a\uace0\ub3c4 \uc18c\ud1b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud14d\uc2a4\ud2b8\ub9cc\uc744 \uc81c\uacf5\ud558\uc5ec \uc774\uc6a9\uc790\uc758 \uc77d\uae30 \ub2a5\ub825\uc774 \ub192\uc740 \uc9d1\ub2e8\uc5d0\uac8c\ub9cc \uc720\uc6a9\ud55c \uc815\ubcf4\ub97c \uc81c\uacf5\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\ub4e4 \ub9e4\uccb4\ub294 \ud14d\uc2a4\ud2b8\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc601\uc0c1, \uc774\ubbf8\uc9c0, \uc74c\uc131 \ub4f1\uc744 \ub2e4\uc591\ud558\uac8c \ud65c\uc6a9\ud558\ub294 \ubcf5\ud569\uc591\uc2dd\uc744 \ub771\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc774\uc6a9\uc790\ub4e4\uc774 \uc2e4\uc2dc\uac04\uc73c\ub85c \ubc18\uc751\ud558\uace0 \uc758\uacac\uc744 \ub098\ub20c \uc218 \uc788\uac8c \ud574 \uc8fc\ub294 \uae30\ub2a5\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub9e4\uccb4 \uae30\uc220\uc758 \ubcc0\ud654\uc640 \uc778\uac04\uc758 \uc18c\ud1b5 \ubb38\ud654 \uc0ac\uc774\uc758 \uad00\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c, \ubcf8\ubb38\uc758 \ub0b4\uc6a9\uacfc \uac00\uc7a5 \uc798 \ubd80\ud569\ud558\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc18c\ud1b5 \uae30\uc220\uc758 \ubcc0\ud654\ub294 \uc18c\ud1b5 \ubb38\ud654\uc758 \ubc1c\uc804\uc73c\ub85c \uc774\uc5b4\uc9c0\uba70, \ubc1c\uc804\ub41c \uc18c\ud1b5 \ubb38\ud654\ub294 \ub2e4\uc2dc \uae30\uc220\uc758 \uc9c4\ud654\ub97c \uc694\uad6c\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubcf8\ubb38 \uacb0\ubb38\uc5d0\uc11c\ub294 \uc18c\ud1b5 \uae30\uc220\uc758 \ubcc0\ud654\uac00 \ubb38\ud654\ub97c \ubc1c\uc804\uc2dc\ud0a4\uace0, \ubc1c\uc804\ub41c \ubb38\ud654\uac00 \ub2e4\uc2dc \uc0c8\ub85c\uc6b4 \uae30\uc220 \uc9c4\ud654\ub97c \uc694\uad6c\ud55c\ub2e4\uace0 \uc124\uba85\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0c8\ub85c\uc6b4 \ub9e4\uccb4\uac00 \ub4f1\uc7a5\uc744 \ud558\ub354\ub77c\ub3c4 \uc0ac\ub78c\ub4e4\uc774 \uc18c\ud1b5\ud558\ub294 \ubc29\uc2dd\uacfc \uc5b8\uc5b4\ubb38\ud654\uc5d0\ub294 \ubcc0\ud568\uc774 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0c8\ub85c\uc6b4 \ub9e4\uccb4\ub294 \uc0c8\ub85c\uc6b4 \ubb38\ud654\ub97c \ub9cc\ub4e4\uace0 \uc0c8\ub85c\uc6b4 \uc5b8\uc5b4\ub97c \ucc3d\uc870\ud558\uba70 \uc18c\ud1b5 \ubc29\uc2dd\uc744 \ubcc0\ud654\uc2dc\ud0b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub9e4\uccb4 \ubc1c\uc804\uc740 \uc9c0\uc2dd\uc758 \uc800\uc7a5 \ub2a5\ub825\uc5d0\ub9cc \uc601\ud5a5\uc744 \uc904 \ubfd0, \uc778\uac04 \uc0c1\ud638 \uac04\uc758 \uad00\uacc4 \ud615\uc131 \ubc29\uc2dd\uacfc\ub294 \ubb34\uad00\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub9e4\uccb4\uc758 \ubc1c\uc804\uc740 \uc774\uc6a9\uc790 \uac04 \uc778\ub9e5 \ud655\ub300 \ubc0f \uc0c8\ub85c\uc6b4 \uc0ac\ud68c\uc801 \uad00\uacc4 \ud615\uc131\uc5d0 \uc9c1\uac04\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ub07c\uce69\ub2c8\ub2e4."
        },
        {
          "text": "\uae09\uc18d\ud55c \ub514\uc9c0\ud138 \ud658\uacbd \ubcc0\ud654 \uc18d\uc5d0\uc11c\ub294 \ub9e4\uccb4 \uc18c\ud1b5 \ubb38\ud654\ub97c \uc131\ucc30\ud558\uae30\ubcf4\ub2e4 \uc624\uc9c1 \ub9e4\uccb4 \uae30\ub2a5 \uc2b5\ub4dd\uc5d0 \uc9d1\uc911\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf8\ubb38\uc5d0\uc11c\ub294 \ubcc0\ud654\ud558\ub294 \ub9e4\uccb4 \uc18c\ud1b5 \ubb38\ud654\ub97c \uc62c\ubc14\ub978 \ubc29\ud5a5\uc73c\ub85c \uc774\ub04c\uc5b4 \uac00\uae30 \uc704\ud574 \uc774\ud574\ud558\uace0 \uc131\ucc30\ud558\ub294 \ud0dc\ub3c4\uac00 \ub9e4\uc6b0 \uc911\uc694\ud558\ub2e4\uace0 \uac15\uc870\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub9e4\uccb4 \uae30\uc220\uacfc \uc18c\ud1b5 \ubb38\ud654\uac00 \uc11c\ub85c \uc5b4\ub5bb\uac8c \uc601\ud5a5\uc744 \uc8fc \uc8fc\uace0\ubc1b\ub294\uc9c0 \ubcf8\ubb38\uc758 \ub9c8\uc9c0\ub9c9 \ub2e8\ub77d\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc124\uba85\uc5d0 \ud574\ub2f9\ud558\ub294 \ub9e4\uccb4\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n\"\ubb38\uc790\uac00 \ub9cc\ub4e4\uc5b4\uc9c0\uae30 \uc804\uc5d0 \uc8fc\ub85c \uc0ac\uc6a9\ub418\uc5c8\uc73c\uba70, \ud654\uc790\uc640 \uccad\uc790\uac00 \uc9c1\uc811 \ub300\uba74\ud558\uc5ec \uc0c1\ud669\uacfc \ub9e5\ub77d\uc744 \uacf5\uc720\ud558\uc9c0\ub9cc, \ub2e4\ub978 \uc2dc\uac04\uacfc \uacf5\uac04\uc5d0 \uc788\ub294 \uc0ac\ub78c\uc5d0\uac8c \uc9c0\uc2dd\uacfc \uc815\ubcf4\ub97c \uc804\ub2ec\ud558\uac70\ub098 \uc628\uc804\ud788 \ubcf4\uc874\ud558\ub294 \ub370\ub294 \ud55c\uacc4\uac00 \uc788\uc5c8\ub2e4.\"",
      "answerOptions": [
        {
          "text": "\uad6c\uc220 \ub9e4\uccb4",
          "isCorrect": true,
          "rationale": "\uc74c\uc131 \uc5b8\uc5b4(\ub9d0\ud558\uae30)\ub97c \uc911\uc2ec\uc5d0 \ub450\uace0 \uc9c1\uc811 \ub300\uba74 \uc18c\ud1b5\ud558\uba70, \uad6c\uc804\uc758 \ud55c\uacc4\ub85c \uc2dc\uacf5\uac04\uc744 \ucd08\uc6d4\ud558\uae30 \uc5b4\ub824\uc6b4 \uac83\uc740 \uad6c\uc220 \ub9e4\uccb4\uc758 \ud2b9\uc131\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubb38\uc790 \ub9e4\uccb4",
          "isCorrect": false,
          "rationale": "\ubb38\uc790 \ub9e4\uccb4\ub294 \uc4f0\uae30\uc640 \uc77d\uae30\ub97c \uae30\ubc18\uc73c\ub85c \uc2dc\uacf5\uac04\uc801 \ud55c\uacc4\ub97c \uadf9\ubcf5\ud558\uace0 \ud0c8\uc0c1\ud669\uc801 \uc18c\ud1b5\uc744 \uac00\ub2a5\ud558\uac8c \ud55c \ub9e4\uccb4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc601\uc0c1 \ub9e4\uccb4",
          "isCorrect": false,
          "rationale": "\uc601\uc0c1 \ub9e4\uccb4\ub294 \uc601\ud654, TV \ub4f1 \uc2dc\uccad\uac01 \uc774\ubbf8\uc9c0\ub97c \ud65c\uc6a9\ud558\uc5ec \ub300\uc911\uc5d0\uac8c \uc218\uc6a9\ub418\ub294 \ub9e4\uccb4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub514\uc9c0\ud138 \ub9e4\uccb4",
          "isCorrect": false,
          "rationale": "\ub514\uc9c0\ud138 \ub9e4\uccb4\ub294 \uc778\ud130\ub137\uacfc \uc2a4\ub9c8\ud2b8\ud3f0\uc744 \uae30\ubc18\uc73c\ub85c \ubcf5\ud569\uc591\uc2dd\uc131, \ud558\uc774\ud37c\ud14d\uc2a4\ud2b8, \uc0c1\ud638 \uc791\uc6a9\uc131 \ub4f1\uc744 \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc785\uc73c\ub85c \ub9d0\uc744 \ud558\uc5ec \uc9c1\uc811 \ub300\uba74 \uc18c\ud1b5\ud558\ub358 \uac00\uc7a5 \ucd08\uae30\uc758 \ub9e4\uccb4 \ud615\ud0dc\uc785\ub2c8\ub2e4."
    }
  ]
