{
  "title": "\ud55c\uad6d \uc2dc\uac00 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d \uc2dc\uac00 \ubb38\ud559\uc758 \uc2dc\ub300\uc801 \uac08\ub798 \ubc1c\uc804 \ud750\ub984\uc744 \uc21c\uc11c\ub300\ub85c \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ub300 \uac00\uc694 \u2192 \ud5a5\uac00 \u2192 \uace0\ub824 \uac00\uc694 \u2192 \uc2dc\uc870 \u2192 \uac00\uc0ac \u2192 \ud604\ub300 \uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d \uc2dc\uac00 \ubb38\ud559\uc774 \ub0b4\uc6a9 \uba74\uc5d0\uc11c \uacf5\ud1b5\uc801\uc73c\ub85c \uc9c0\ud5a5\ud574 \uc628 \ub300\ud45c\uc801\uc778 \uc0b6\uc758 \ud0dc\ub3c4 \ub450 \uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04 \uc874\uc911, \uc790\uc5f0 \uce5c\ud654\uc801\uc778 \uc0b6"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d \uc804\ud1b5 \uc2dc\uac00\uc758 \ud615\uc2dd\uc801 \ubc14\ud0d5\uc774 \ub41c \ubbfc\uc694\uc758 \ub300\ud45c\uc801\uc778 \uc728\uaca9 \ub2e8\uc704\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "3\uc74c\ubcf4 \ub610\ub294 4\uc74c\ubcf4 \uc728\uaca9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "10\uad6c\uccb4 \ud5a5\uac00\uc5d0\uc11c \ud615\uc131\ub418\uc5b4 \uc2dc\uc870\uc640 \uace0\ub824 \uac00\uc694 \ub4f1\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce5c \ud615\uc2dd\uc0c1 \uad6c\uc870\uc801 \ud2b9\uc9d5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "3\ub2e8 \uc758\ubbf8 \uad6c\uc870 (\uae30-\uc11c-\uacb0 \uad6c\uc870)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc758 \uac08\ub798\uc640 \uc791\uc790\ub294 \ub204\uad6c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac08\ub798: 10\uad6c\uccb4 \ud5a5\uac00 / \uc791\uc790: \uc6d4\uba85\uc0ac (\uc2e0\ub77c \uacbd\ub355\uc655 \ub54c\uc758 \uc2b9\ub824)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\ubaa9 '\uc81c\ub9dd\ub9e4\uac00(\u796d\u4ea1\u59b9\u6b4c)'\uc758 \ud55c\uc790\uc5b4 \ud480\uc774\ub97c \ubc14\ud0d5\uc73c\ub85c \ud55c \uc791\ud488\uc758 \uc758\ubbf8\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fd\uc740 \ub204\uc774(\ub9dd\ub9e4)\ub97c \uc81c\uc0ac(\uc81c) \uc9c0\ub0b4\uba70 \ubd80\ub974\ub294 \ub178\ub798(\uac00)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc5d0\uc11c \ud654\uc790\uac00 \ucc98\ud55c \uc0c1\ud669\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub204\uc774\uc758 \uc0ac\ubcc4(\uc694\uc808)\ub85c \uc778\ud574 \uc774\ubcc4\uc758 \uc2ac\ud514\uacfc \uc544\ud514\uc744 \uacaa\ub294 \uc0c1\ud669"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc758 \uc2dc\uad6c '\uc774\ub978 \ubc14\ub78c'\uc774 \ube44\uc720\ud558\ub294 \uc6d0\uad00\ub150\uacfc \uadf8 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\ubbf8: \ub204\uc774\uc758 \uc694\uc808(\ube60\ub978 \uc8fd\uc74c)\n\uc774\uc720: \uac00\uc744\uc774 \ucc44 \uc9c0\ub098\uae30 \uc804\uc5d0 \ubd88\uc5b4\uc624\ub294 \ubc14\ub78c\ucc98\ub7fc \ub204\uc774\uac00 \uc77c\ucc0d \uc8fd\uc5c8\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc758 \uc2dc\uad6c '\ub5a8\uc5b4\uc9c8 \uc78e'\uc774 \ube44\uc720\ud558\ub294 \uc6d0\uad00\ub150\uacfc \uadf8 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\ubbf8: \uc8fd\uc740 \ub204\uc774\n\uc774\uc720: \ub098\ubb47\uac00\uc9c0\uc5d0\uc11c \ub5a8\uc5b4\uc838 \ub5a8\uc5b4\uc838 \ub098\uac00\ub294 \ub098\ubb47\uc78e\ucc98\ub7fc \uc0dd\uba85\uc744 \ub2e4\ud558\uace0 \uc8fd\uc740 \ub204\uc774\ub97c \ub73b\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc758 \uc2dc\uad6c '\ud55c \uac00\uc9c0'\uac00 \uc0c1\uc9d5\ud558\ub294 \ube44\uc720\uc801 \uc758\ubbf8\uc640 \uadf8 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\ubbf8: \uac19\uc740 \ubd80\ubaa8 (\ub3d9\uc77c\ud55c \ud608\uc721)\n\uc774\uc720: \ud55c \ub098\ubb47\uac00\uc9c0\uc5d0\uc11c \ub098\ubb47\uc78e\ub4e4\uc774 \uc790\ub77c\ub4ef \uac19\uc740 \ubd80\ubaa8\uc5d0\uac8c\uc11c \ud0dc\uc5b4\ub0ac\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc758 \uc2dc\uad6c '\uac00\ub294 \uacf3'\uc774 \ud568\ucd95\ud558\ub294 \uc758\ubbf8\uc640 \uadf8 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\ubbf8: \uc8fd\uc740 \ud6c4 \uac00\ub294 \uacf3 (\uc0ac\ud6c4 \uc138\uacc4)\n\uc774\uc720: \ub5a8\uc5b4\uc9c0\ub294 \uc78e\uc774 \ub0a0\uc544\uac00 \ud5a5\ud558\ub294 \uacf3\uc744 \uc54c \uc218 \uc5c6\ub4ef \ub204\uc774\uac00 \uc8fd\uc5b4 \uac04 \uacf3\uc744 \uc54c\uc9c0 \ubabb\ud558\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc5d0 \ub098\uc624\ub294 \ubd88\uad50\uc801 \uc2dc\uc5b4 '\ubbf8\ud0c0\ucc30'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ubbf8\ud0c0\ubd88\uc774 \uc0b4\uace0 \uc788\ub294 \uc815\ud1a0(\uadf9\ub77d\uc138\uacc4)\ub85c, \uad34\ub85c\uc6c0\uc774 \uc5c6\uace0 \uc9c0\uadf9\ud788 \uc548\ub77d\ud55c \uc138\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "10\uad6c\uccb4 \ud5a5\uac00 \u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc5d0\uc11c \uc2dc\uc0c1\uc758 \uc804\ud658\uc774 \uc77c\uc5b4\ub098\ub294 \uc2dc\uad6c\uc758 \uc704\uce58\ub294 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c9\uad6c (\ub099\uad6c\uc758 \uccab\uba38\ub9ac)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc758 \ub099\uad6c \uccab\uba38\ub9ac\uc5d0 \uc704\uce58\ud55c \uac10\ud0c4\uc0ac '\uc544\uc544(\u963f\u4e5f)'\uc758 \uc5ed\ud560\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub204\uc774\uc758 \uc8fd\uc74c\uc73c\ub85c \uc778\ud55c \uc2ac\ud514\uacfc \ud5c8\ubb34\ud568\uc744 \uadf9\ubcf5\ud558\uace0 \uc2dc\uc0c1\uc744 \ubd88\uad50\uc801/\uc885\uad50\uc801\uc73c\ub85c \uc2b9\ud654 \ubc0f \uc9d1\uc57d\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc758 \ud654\uc790\ub294 \ub204\uc774\uc640\uc758 \uc774\ubcc4\uc5d0\uc11c \uc624\ub294 \uc2ac\ud514\uc744 \uc5b4\ub5a4 \ud0dc\ub3c4\ub85c \uadf9\ubcf5\ud558\uace0\uc790 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ud0c0\ucc30(\uadf9\ub77d)\uc5d0\uc11c \ub2e4\uc2dc \ub9cc\ub0a0 \uac83\uc744 \ubbff\uace0, \ub3c4(\u9053)\ub97c \ub2e6\uc73c\uba70 \uae30\ub2e4\ub9ac\uaca0\ub2e4\ub294 \uc758\uc9c0\uc801\u00b7\ubd88\uad50\uc801 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc758 \uac08\ub798\uc640 \uc791\uc790\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac08\ub798: \ud3c9\uc2dc\uc870 / \uc791\uc790: \uc1a1\uc21c (\uc870\uc120 \uba85\uc885 \ub54c\uc758 \ubb38\uc2e0, \ud638\ub294 \uba74\uc559\uc815)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc5d0\uc11c \uc2dc\uc5b4 '\uacbd\uc601\ud558\uc57c'\uc758 \ub73b\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacc4\ud68d\ud558\uace0 \uc900\ube44\ud558\uc5ec (\uc560\uc368 \ub178\ub825\ud558\uc5ec)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc5d0\uc11c '\ucd08\ub824 \uc0bc\uac04'\uc774 \uc758\ubbf8\ud558\ub294 \ubc14\uc640 \ud654\uc790\uc758 \uc0dd\ud65c \ubc29\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\ubbf8: \uc138 \uce78\uc9dc\ub9ac \uc791\uc740 \ucd08\uac00\uc9d1\n\ud654\uc790\uc758 \uc0dd\ud65c \ubc29\uc2dd: \uc548\ube48\ub099\ub3c4\ud558\ub294 \uc18c\ubc15\ud55c \uc0b6"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc5d0\uc11c \ucd08\ub824 \uc0bc\uac04\uc744 \uac01 \ud55c \uce78\uc529 \ucc28\uc9c0\ud55c \uc138 \ub300\uc0c1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub098, \ub2ec, \uccad\ud48d(\ub9d1\uc740 \ubc14\ub78c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc5d0\uc11c '\uac15\uc0b0\uc740 \ub4dc\ub9b4 \ub4f8 \uc5c5\uc2a4\ub2c8 \ub458\ub108 \ub450\uace0 \ubcf4\ub9ac\ub77c'\uc5d0 \ub098\ud0c0\ub09c \ubc1c\uc0c1\uacfc \ud654\uc790\uc758 \ud0dc\ub3c4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\uc0c1: \uac15\uc0b0\uc744 \ubc29 \uc548\uc5d0 \ub4e4\uc77c \uc218 \uc5c6\uc5b4 \uc9d1 \ub458\ub808\uc5d0 \ubcd1\ud48d\ucc98\ub7fc \ub458\ub7ec\uce58\uace0 \ubcf4\uaca0\ub2e4\ub294 \uae30\ubc1c\ud55c \ubc1c\uc0c1\n\ud0dc\ub3c4: \uc790\uc5f0\uacfc \ud558\ub098\uac00 \ub418\ub294 \ubb3c\uc544\uc77c\uccb4 \ubc0f \uc790\uc5f0 \uce5c\ud654\uc801 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc758 \ud654\uc790\uac00 \uc9c0\ud5a5\ud558\ub294 \ud575\uc2ec \uac00\uce58\uad00 \ub450 \uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0 \uce5c\ud654 (\ubb3c\uc544\uc77c\uccb4), \uc548\ube48\ub099\ub3c4 (\uc548\ubd84\uc9c0\uc871)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc758 \uac08\ub798\uc640 \uc791\uc790\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac08\ub798: \uc0ac\uc124\uc2dc\uc870 / \uc791\uc790: \uc791\uc790 \ubbf8\uc0c1 (\uc870\uc120 \ud6c4\uae30 \uc11c\ubbfc)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0\uc11c '\ub450\ud130\ube44(\ub450\uaebc\ube44)'\uac00 \uc0c1\uc9d5\ud558\ub294 \uc778\ubb3c\uc0c1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc31\uc131\uc744 \uc218\ud0c8\ud558\ub294 \ubb34\ub2a5\ud558\uace0 \ubd80\ud328\ud55c \uc9c0\ubc29 \uad00\ub9ac (\ud0d0\uad00\uc624\ub9ac)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0\uc11c '\ud30c\ub9ac'\uac00 \uc0c1\uc9d5\ud558\ub294 \ub300\uc0c1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0d0\uad00\uc624\ub9ac\uc5d0\uac8c \uc218\ud0c8\ub2f9\ud558\ub294 \uc57d\ud558\uace0 \ud798\uc5c6\ub294 \uc11c\ubbfc(\ubc31\uc131)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0\uc11c '\ub450\ud5d8'\uc774 \uc0c1\uc9d5\ud558\ub294 \ubc14\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ubc29 \uad00\ub9ac\uac00 \ubd80\uc815\ud55c \ubc29\ubc95\uc73c\ub85c \ubaa8\uc740 \uc7ac\ubb3c \ub610\ub294 \uc790\uc2e0\uc758 \uc2e0\ubd84/\uad8c\ub825"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0\uc11c '\ubc31\uc1a1\uace8(\ud770 \uc1a1\uace8\ub9e4)'\uc774 \uc0c1\uc9d5\ud558\ub294 \uc778\ubb3c\uc0c1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ubc29 \uad00\ub9ac(\ub450\ud130\ube44)\ubcf4\ub2e4 \ud55c\uce35 \ub354 \uac15\ub825\ud55c \uc911\uc559 \uad00\ub9ac \ub610\ub294 \uc0c1\uae09 \uad8c\ub825\uc790"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0\uc11c \ub450\ud130\ube44\uc758 \uc6b0\uc2a4\uaf5d\uc2a4\ub7ec\uc6b4 \ud589\ub3d9 \uc911 \uc6c3\uc74c\uc744 \uc720\ubc1c\ud558\ub294 \uc2e0\uccb4\uc801 \ud589\ub3d9\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc31\uc1a1\uace8\uc744 \ubcf4\uace0 \uac00\uc2b4\uc774 \uc12c\ub729\ud558\uc5ec \ub6f0\uc5b4\ub0b4\ub9ac\ub2e4\uac00 \ub450\uc5c4 \uc544\ub798\uc5d0 \uac70\uafb8\ub85c \uc790\ube60\uc9c0\ub294 \ubaa8\uc2b5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc758 \uc885\uc7a5 '\ubaa8\uccd0\ub77c \ub0a0\ub0b8 \ub0bc\uc2c0\ub9cc\uc84d \uc5d0\ud5d0\uc9c8 \ubc88 \ud558\uad18\ub77c'\uc5d0 \ub4dc\ub7ec\ub09c \ub450\ud130\ube44\uc758 \ud0dc\ub3c4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ube60\uc838\uc11c \uba4d\ub4e4 \ubed4\ud55c \ube44\ucc38\ud55c \uc0c1\ud669\uc5d0\uc11c\ub3c4 \uc790\uc2e0\uc774 \ub0a0\uc314\uc11c \ub2e4\ud589\uc774\ub77c\uace0 \ud5c8\uc138\ub97c \ubd80\ub9ac\ub294 \uc790\ud654\uc790\ucc2c\uacfc \ud5c8\uc7a5\uc131\uc138\uc758 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0\uc11c \ud48d\uc790\uc640 \ud574\ud559\uc744 \ud1b5\ud574 \ub4dc\ub7ec\ub0b4\uace0\uc790 \ud558\ub294 \uc8fc\uc81c\uc758\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\ubc18/\uc9c0\ubc29 \uad00\ub9ac\uc758 \ubd80\ud328\uc640 \uc57d\uc790 \uad34\ub86d\ud788\uae30, \uad8c\ub825\uc790 \uc55e\uc5d0\uc11c\uc758 \ubb34\ub2a5\ud568\uacfc \ud5c8\uc138\ub97c \ud48d\uc790\ud558\uace0 \ube44\ud310\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d, \u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d, \u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\ub97c \ud1b5\ud574 \ubcf8 \uace0\uc804 \uc2dc\uac00 \ud5a5\uc720\uce35\uc758 \ubcc0\ud654 \uc591\uc0c1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2f9\ub300\uc758 \uc0c1\ub958\uce35(\uc2b9\ub824, \uc0ac\ub300\ubd80) \uc911\uc2ec\uc5d0\uc11c \uc870\uc120 \ud6c4\uae30\ub85c \uc624\uba74\uc11c \uc77c\ubc18 \uc11c\ubbfc\uce35\uc73c\ub85c \ud5a5\uc720\uce35\uc774 \ud655\ub300\ub428"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3c9\uc2dc\uc870 \u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc640 \uc0ac\uc124\uc2dc\uc870 \u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc758 \ub300\ud45c\uc801\uc778 \ud615\uc2dd\uc0c1 \ucc28\uc774\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3c9\uc2dc\uc870\ub294 \uc815\ud615\uc801 \uc81c\uc57d(3\uc7a5 6\uad6c)\uc744 \ub530\ub974\ub294 \ubc18\uba74, \uc0ac\uc124\uc2dc\uc870\ub294 \uc911\uc7a5 \ub4f1\uc774 \uae38\uc5b4\uc838 \ud615\uc2dd\uc0c1\uc758 \uc81c\uc57d\uc5d0\uc11c \uc790\uc720\ub85c\uc6cc\uc9d0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\u00b7\u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc640 \ube44\uad50\ud560 \ub54c \u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc758 \ub0b4\uc6a9\uc0c1 \ucc28\uc774\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc55e\uc758 \ub450 \uc791\ud488\uc740 \uac1c\uc778\uc801\uc778 \uc815\uc11c(\uc2ac\ud514, \uc790\uc5f0 \uce5c\ud654)\uac00 \ub450\ub4dc\ub7ec\uc9c0\ub294 \ubc18\uba74, \u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\ub294 \ub2f9\ub300 \uc0ac\ud68c \ubb38\uc81c\uc5d0 \ub300\ud55c \ub0a0\uce74\ub85c\uc6b4 \ube44\ud310\uc774 \ub450\ub4dc\ub7ec\uc9d0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "10\uad6c\uccb4 \ud5a5\uac00\uc758 \uac10\ud0c4\uc0ac\uac00 \uc2dc\uc870 \ud615\uc2dd\uc73c\ub85c \uacc4\uc2b9\ub41c \uad6c\uccb4\uc801\uc778 \uc704\uce58\uc640 \ud2b9\uc9d5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5a5\uac00 \ub099\uad6c\uc758 \uccab\uba38\ub9ac \uac10\ud0c4\uc0ac\uac00 \uc2dc\uc870 \uc885\uc7a5\uc758 \uccab \uc74c\ubcf4(3\uc74c\uc808 \uace0\uc815 \uac10\ud0c4\uc0ac \ub4f1)\ub85c \uacc4\uc2b9\ub428"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uadf9\uc778\uc758 \uac00\uc0ac \u300c\uc0c1\ucd98\uace1(\u8cde\u6625\u66f2)\u300d\uc758 \uc81c\ubaa9 \ub73b\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd04 \uacbd\uce58\ub97c \uc990\uae30\ub294 \ub178\ub798"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uadf9\uc778\uc758 \u300c\uc0c1\ucd98\uace1\u300d\uc774 \ud55c\uad6d \ubb38\ud559\uc0ac\uc5d0\uc11c \uac00\uc9c0\ub294 \uac08\ub798\uc801 \uc758\uc758\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\uc5d0 \ubb3b\ud600 \uc0ac\ub294 \uc990\uac70\uc6c0\uc744 \ub178\ub798\ud55c \uc0ac\ub300\ubd80 '\uac15\ud638\ud55c\uc815 \uac00\uc0ac'\uc758 \ud6a8\uc2dc(\uc2dc\ubc1c\uc810)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc0c1\ucd98\uace1\u300d\uc5d0\uc11c \uc2dc\uc5b4 '\ud64d\uc9c4(\u7d05\u5875)'\uc758 \ubb38\uc790 \uadf8\ub300\ub85c\uc758 \ub73b\uacfc \ube44\uc720\uc801 \uc758\ubbf8\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uc801 \ub73b: \ubd89\uc740 \uba3c\uc9c0\n\ube44\uc720\uc801 \uc758\ubbf8: \ubc88\ub1cc\uc2a4\ub7fd\uace0 \uc5bd\ub9e4\uc778 \uc18d\uc138(\uc778\uac04 \uc138\uc0c1)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc0c1\ucd98\uace1\u300d\uc5d0\uc11c \uc2dc\uc5b4 '\uc218\uac04\ubaa8\uc625(\u6578\u9593\u8305\u5c4b)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba87 \uce78 \uc548 \ub418\ub294 \uc791\uc740 \ucd08\uac00\uc9d1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc0c1\ucd98\uace1\u300d\uc5d0\uc11c '\ud48d\uc6d4\uc8fc\uc778(\u98a8\u6708\u4e3b\u4eba)'\uc774 \uc758\ubbf8\ud558\ub294 \uc0ac\ub78c\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0(\ubc14\ub78c\uacfc \ub2ec)\uc744 \ubc97 \uc0bc\uc544 \uc990\uae30\ub294 \uc8fc\uccb4(\ud654\uc790 \uc790\uc2e0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc0c1\ucd98\uace1\u300d\uc5d0\uc11c '\ubb3c\uc544\uc77c\uccb4(\u7269\u6211\u4e00\u9ad4)'\uc758 \ub73b\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\ubb3c(\ubb3c)\uacfc \ub098(\uc544)\uac00 \ud558\ub098\ub85c \uc5b4\uc6b0\ub7ec\uc9c0\ub294 \uacbd\uc9c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc0c1\ucd98\uace1\u300d\uc758 \uc2dc\uad6c '\uc18c\uc694\uc74c\uc601(\u900d\u9059\u541f\u8a60)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\ub86d\uac8c \uc774\ub9ac\uc800\ub9ac \uc2ac\uc2ac \uac70\ub2d0\uba70 \ub098\uc9c0\ub9c9\uc774 \uc2dc\ub97c \uc74a\uc870\ub9bc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc0c1\ucd98\uace1\u300d\uc758 \uc2dc\uad6c '\ud55c\uc911\uc9c4\ubbf8(\u9592\u4e2d\u771e\u5473)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uac00\ud568 \uc18d\uc5d0\uc11c \ub290\ub07c\ub294 \ucc38\ub41c \ub9db\uacfc \ucc38\ub41c \uc990\uac70\uc6c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc0c1\ucd98\uace1\u300d\uc5d0 \ub098\uc624\ub294 \ubd04\ucca0 \uc57c\uc678 \ud65c\ub3d9 '\ub2f5\uccad(\u8e0f\u9751)'\uacfc '\uc695\uae30(\u6d74\u6c82)'\uc758 \uc758\ubbf8\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2f5\uccad: \ud478\ub978 \ud480\uc744 \ubc1f\uc73c\uba70 \uc0b0\ucc45\ud568\n\uc695\uae30: \ub0c7\ubb3c\uc5d0\uc11c \ubaa9\uc695\ud558\uba70 \uba85\ub9ac\ub97c \uc78a\uace0 \uc720\uc720\uc790\uc801\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc0c1\ucd98\uace1\u300d\uc758 \uc2dc\uad6c '\uacf3\ub098\ubaa8 \uac00\uc9c0 \uac83\uac70 \uc218 \ub178\ucf54 \uba39\uc73c\ub9ac\ub77c'\uc5d0 \ub098\ud0c0\ub09c \ud654\uc790\uc758 \uc220\uc790\ub9ac \ubaa8\uc2b5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uaf43\ub098\ubb34 \uac00\uc9c0\ub97c \uaebe\uc5b4 \uc220\uc794 \uc218\ub97c \uc138\uba74\uc11c \ub9c8\uc2dc\ub294 \ud48d\ub958\uc801\uc774\uace0 \uba4b\uc2a4\ub7ec\uc6b4 \ubaa8\uc2b5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc870 \u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc640 \uac00\uc0ac \u300c\uc0c1\ucd98\uace1\u300d\uc758 \ub450 \ud654\uc790\uac00 \uacf5\ud1b5\uc801\uc73c\ub85c \uc9c0\ud5a5\ud558\ub294 \uac00\uce58\uad00\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0 \uce5c\ud654\uc801 \uc0b6, \uc548\ube48\ub099\ub3c4, \ubb3c\uc544\uc77c\uccb4\uc758 \uac00\uce58\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "10\uad6c\uccb4 \ud5a5\uac00\uc5d0\uc11c \uc2dc\uc0c1\uc744 \uacb0\ud569\u00b7\uc644\uacb0\ud558\ub294 \ub9c8\uc9c0\ub9c9 9~10\uad6c \ubd80\ubd84\uc744 \uac00\ub9ac\ud0a4\ub294 \uc6a9\uc5b4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub099\uad6c(\u843d\u53e5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uadf9\uc778\uc758 \u300c\uc0c1\ucd98\uace1\u300d\uc774 \uc601\ud5a5\uc744 \ubbf8\uccd0 \uc774\uc5b4\uc9c4 \uc870\uc120 \uc2dc\ub300 \uac00\uc0ac \ubb38\ud559\uc758 \ub9e5\ub77d\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc1a1\uc21c\uc758 \u300c\uba74\uc559\uc815\uac00\u300d\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc5c8\uace0, \uc815\ucca0\uc758 \u300c\uc131\uc0b0\ubcc4\uace1\u300d\uacfc \u300c\uad00\ub3d9\ubcc4\uace1\u300d\uc73c\ub85c \uacc4\uc2b9\ub428"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0\uc11c \uc57d\uc790\uc778 '\ud30c\ub9ac'\ub97c \uad34\ub86d\ud788\ub2e4\uac00 \uac15\uc790\uc778 '\ubc31\uc1a1\uace8' \uc55e\uc5d0\uc11c \uca54\uca54\ub9e4\ub294 \ub450\ud130\ube44\uc758 \ubaa8\uc2b5\uc744 \uac00\ub9ac\ud0a4\ub294 \ud55c\uc790\uc131\uc5b4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc57d\uc790\uc5d0\uac8c \uac15\ud558\uace0 \uac15\uc790\uc5d0\uac8c \uc57d\ud568 (\uac15\uc57d\uc57d\uac15)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc804 \uc2dc\uac00\uc5d0\uc11c \ub2e4\ub8e8\ub294 \ub300\ud45c\uc801 \uc8fc\uc81c\uc5b4 \uc911 \u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uac00 \ud574\ub2f9\ud558\ub294 \ud575\uc2ec \uc815\uc11c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ubcc4\uc758 \uc815\ud55c (\uc0ac\ubcc4\uc758 \uc2ac\ud514\uacfc \uc7ac\ud68c\uc758 \uae30\uc6d0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc804 \uc2dc\uac00\uc5d0\uc11c \ub2e4\ub8e8\ub294 \ub300\ud45c\uc801 \uc8fc\uc81c\uc5b4 \uc911 \u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc640 \u300c\uc0c1\ucd98\uace1\u300d\uc774 \uacf5\uc720\ud558\ub294 \ud575\uc2ec \uc815\uc11c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0 \uce5c\ud654 (\uac15\ud638\ud55c\uc815)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc804 \uc2dc\uac00\uc5d0\uc11c \ub2e4\ub8e8\ub294 \ub300\ud45c\uc801 \uc8fc\uc81c\uc5b4 \uc911 \uc0ac\uc124\uc2dc\uc870 \u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0 \uc8fc\ub85c \uc4f0\uc778 \ud45c\ud604\uc801 \ubbf8\uc758\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\uc790\uc640 \ud574\ud559"
          }
        ]
      }
    }
  ]
}