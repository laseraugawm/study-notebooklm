{
  "title": "\uad6c\uc6b4\ubabd \ud50c\ub798\uc2dc\uce74\ud0c0",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\ud559\uc5d0\uc11c '\uc11c\uc0ac(\u654d\u4e8b)'\uac00 \ub73b\ud558\ub294 \ubcf8\ub798 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub5a4 \uc778\ubb3c\uc774 \uacaa\ub294 \ud5c8\uad6c\uc758 \uc0ac\uac74\uc744 \uc774\uc57c\uae30\ub85c \ud45c\ud604\ud558\uace0 \ud3bc\uccd0 \ub0b8\ub2e4\ub294 \ub73b."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac \uc11c\uc0ac \ubb38\ud559\uc5d0\uc11c \uc18c\uc124 \uac08\ub798\uc758 \ubfcc\ub9ac\uac00 \ub41c \uc124\ud654(\u8aaa\u8a71)\uc758 \uc138 \uac00\uc9c0 \uc720\ud615\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\ud654, \uc804\uc124, \ubbfc\ub2f4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uad6d\uc73c\ub85c\ubd80\ud130 \uc804\ub798\ub418\uc5b4 \ud55c\uad6d \uc18c\uc124\uc758 \ud615\uc131\uc5d0 \ud070 \uc601\ud5a5\uc744 \uc900 \uc11c\uc0ac \uac08\ub798\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uae30(\u50b3\u5947)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc120 \ud6c4\uae30\uc5d0 \uc655\uc131\ud558\uac8c \ucc3d\uc791\u00b7\uc720\ud1b5\ub41c \uc6b0\ub9ac \uc18c\uc124\uc758 \ub300\ud45c\uc801 \ubd84\ud654 \uc720\ud615 4\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\ubabd \uc18c\uc124, \uc601\uc6c5 \uc18c\uc124, \uac00\ubb38 \uc18c\uc124, \ud310\uc18c\ub9ac\uacc4 \uc18c\uc124."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc120 \ud6c4\uae30 \uace0\uc804 \uc18c\uc124 \u300c\uad6c\uc6b4\ubabd(\u4e5d\u96f2\u5922)\u300d\uc758 \uc791\uac00\uc640 \uac08\ub798\uc801 \ud2b9\uc9d5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\uac00: \uc11c\ud3ec \uae40\ub9cc\uc911\n\uac08\ub798: \uc591\ubc18 \uc18c\uc124, \ud658\ubabd \uc18c\uc124, \uc591\ubc18 \uc601\uc6c5 \uc18c\uc124."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uc124 \u300c\uad6c\uc6b4\ubabd\u300d\uc758 \uc911\uc2ec\uc774 \ub418\ub294 \uc804\uccb4 \uc11c\uc0ac \uad6c\uc870 \ud2c0\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\uc2e4 - \uafc8 - \ud604\uc2e4\ub85c \uc774\uc5b4\uc9c0\ub294 '\ud658\ubabd \uad6c\uc870(\uc561\uc790 \uad6c\uc870)'."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uad6c\uc6b4\ubabd\u300d\uc758 \ud604\uc2e4 \uacf5\uac04 \ubc30\uacbd\uacfc \uc911\uc2ec \uc2a4\uc2b9 \uc778\ubb3c\uc740 \ub204\uad6c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uac04 \ubc30\uacbd: \uc911\uad6d \ub2f9\ub098\ub77c \ub0a8\uc545 \ud615\uc0b0 \uc5f0\ud654\ubd09\n\uc2a4\uc2b9: \uc721\uad00 \ub300\uc0ac."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\uc81c\uc790 '\uc131\uc9c4'\uc774 \ubd88\ubb38\uc758 \uc801\ub9c9\ud568\uc5d0 \ud68c\uc758\ub97c \ub290\ub07c\uace0 \uc138\uc18d\uc801 \ubd80\uadc0\uacf5\uba85\uc744 \uc6d0\ud558\uac8c \ub41c \uc9c1\uc811\uc801 \uacc4\uae30\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6a9\uad81\uc5d0 \uc2ec\ubd80\ub984\uc744 \ub2e4\ub140\uc624\ub294 \uae38\uc5d0 \uc5f0\ud654\ubd09 \ub3cc\ub2e4\ub9ac\uc5d0\uc11c \uc704 \ubd80\uc778\uc758 \ud314\uc120\ub140\ub97c \ub9cc\ub098 \ub9d0\uc744 \uc8fc\uace0\ubc1b\uc73c\uba70 \ud76c\ub871\ud588\uae30 \ub54c\ubb38."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uc18d\uc801 \uc695\ub9dd\uacfc \uc815\uc695\uc744 \ud488\uc740 \uc131\uc9c4\uc5d0\uac8c \uc721\uad00 \ub300\uc0ac\uac00 \ub0b4\ub9b0 \ubc8c\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud669\uac74\uc5ed\uc0ac\ub97c \uc2dc\ucf1c \uc131\uc9c4\uc744 \uc800\uc2b9(\ud48d\ub3c4 \uc9c0\uc625)\uc73c\ub85c \ucd94\ubc29\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5fc\ub77c\ub300\uc655\uc774 \uc9c0\uc625\uc5d0 \ub04c\ub824\uc628 \uc131\uc9c4\uacfc \ud314\uc120\ub140\uc5d0\uac8c \ub0b4\ub9b0 \ucd5c\uc885 \ud310\uacb0\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ud649 \uc0ac\ub78c\uc744 \uc800\uc2b9\uc0ac\uc790\ub97c \uc2dc\ucf1c \uc778\uac04 \uc138\uc0c1\uc73c\ub85c \uc18d\ud788 \uac00\uc11c \ud0dc\uc5b4\ub098\uac8c(\uc18d\ud658) \ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\uc9c4\uc774 \uc778\uac04 \uc138\uc0c1\uc5d0 \ud658\uc0dd\ud558\uc5ec \ud0dc\uc5b4\ub09c \uc9d1\uc548\uacfc \uc778\ubb3c \uc774\ub984\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2f9\ub098\ub77c \ud68c\ub0a8\ub3c4 \uc218\uc8fc\ud604\uc758 \uc591 \ucc98\uc0ac\uc640 \uc720\uc528 \ubd80\uc778 \uc0ac\uc774\uc5d0\uc11c '\uc591\uc18c\uc720(\uc790: \ucc9c\ub9ac)'\ub85c \ud0dc\uc5b4\ub0a8."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uafc8\uc18d \uc778\ubb3c '\uc591\uc18c\uc720'\uac00 \uc138\uc18d\uc5d0\uc11c \uc785\uc2e0\uc591\uba85\ud558\uba70 \uc624\ub974\uac8c \ub41c \ucd5c\uace0 \ubcbc\uc2ac\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70 \uae09\uc81c \ud6c4 \ud1a0\ubc88(\ud2f0\ubca0\ud2b8)\uc758 \uce68\ub7b5\uc744 \ub9c9\uc544\ub0b8 \uacf5\uc744 \uc138\uc6cc '\uc2b9\uc0c1(\ub300\uc2b9\uc0c1)'\uc758 \uc790\ub9ac\uc5d0 \uc624\ub984."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uc18c\uc720\uac00 \uc778\uac04 \uc138\uc0c1\uc5d0\uc11c \uc778\uc5f0\uc744 \ub9fa\uc740 \ucc98\ucca9\uc758 \uaddc\ubaa8\uc640 \uadf8 \uc804\uc0dd \uc778\ubb3c\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \uc544\ub0b4\uc640 \uc5ec\uc12f \ucca9(\ucd1d 8\uba85\uc758 \ucc98\ucca9)\uc744 \ub450\uc5c8\uc73c\uba70, \uc774\ub4e4\uc740 \uc804\uc0dd\uc758 \ud314\uc120\ub140\uc5d0 \ud574\ub2f9\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd5c\uace0\uc758 \ubd80\uadc0\uc601\ud654\ub97c \ub204\ub9ac\ub358 \uc591\uc18c\uc720\uac00 \ud241\uc18c\ub97c \uc5f0\uc8fc\ud558\uba70 \uad6c\uc2ac\ud508 \uc815\uc870\uc5d0 \ube60\uc9c0\uac8c \ub41c \uae4c\ub2ed\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc61b \uc601\uc6c5\ub4e4\uc758 \uc720\uc801\uc9c0\ub97c \ubc14\ub77c\ubcf4\uba70 \uc138\uc18d\uc758 \ubd80\uadc0\uc640 \ud48d\ub958\uac00 \uacb0\uad6d \uc8fd\uc74c \uc55e\uc5d0\uc11c\ub294 \ud55c\uc21c\uac04\uc5d0 \ubd88\uacfc\ud558\ub2e4\ub294 '\uc778\uc0dd\ubb34\uc0c1'\uc744 \uae68\ub2ec\uc558\uae30 \ub54c\ubb38."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uc18c\uc720\uac00 \uc778\uc0dd\uc758 \ub367\uc5c6\uc74c\uc744 \ube44\uc720\ud558\uae30 \uc704\ud574 \uc5b8\uae09\ud55c \uc911\uad6d\uc758 \uc138 \uc784\uae08(\uc601\uc6c5)\uacfc \uad00\ub828 \uc720\uc801\uc9c0 3\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc9c4\uc2dc\ud669 - \uc544\ubc29\uad81\n2. \ud55c \ubb34\uc81c - \ubb34\ub989\n3. \ub2f9 \ud604\uc885 - \ud654\uccad\uad81"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uc18c\uc720\uac00 \ud3c9\uac00\ud55c '\uc720\ub3c4(\u5112\u9053)'\uc758 \ud55c\uacc4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc774 \uc628\uc804\ud788 \uc774\ub8e8\uc5b4\uc9c4\ub2e4 \ud574\ub3c4 \uc778\ub95c\uc744 \ubc1d\ud788\uace0 \uc8fd\uc740 \ub4a4 \uc774\ub984\uc744 \ub0a8\uae30\ub294 \ub370 \uadf8\uce68."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uc18c\uc720\uac00 \ud3c9\uac00\ud55c '\uc120\ub3c4(\u4ed9\u9053)'\uc758 \ud55c\uacc4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5c8\ud0c4(\uac70\uc9d3\ub418\uace0 \ubbf8\ub86d\uc9c0 \ubabb\ud568)\uc5d0 \uac00\uae4c\uc6cc \uc608\ub85c\ubd80\ud130 \uad6c\ud558\ub294 \uc790\ub294 \ub9ce\uc558\uc73c\ub098 \uad6c\uccb4\uc801 \uc131\uacfc\ub97c \uc5bb\uc9c0 \ubabb\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uc18c\uc720\uac00 \uc720\ub3c4, \uc120\ub3c4, \ubd88\ub3c4 \uc138 \uac00\uc9c0 \ub3c4 \uc911 \uac00\uc7a5 \ub192\ub2e4\uace0 \ud310\ub2e8\ud558\uace0 \ub3c4\ub97c \uad6c\ud558\uace0\uc790 \ud55c \uac00\ub974\uce68\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\ub3c4(\u4f5b\u9053) \u2014 \ubd88\uc0dd\ubd88\uba78\uc758 \ub3c4\ub97c \uc5bb\uc5b4 \uc778\uac04 \uc138\uc0c1\uc758 \uad34\ub85c\uc6c0\uc744 \ubc97\uc5b4\ub098\uace0\uc790 \ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcbc\uc2ac\uc5d0\uc11c \ubb3c\ub7ec\ub098 \ucd9c\uac00\ud558\ub824\ub294 \uc591\uc18c\uc720 \uc55e\uc5d0 \ub098\ud0c0\ub09c \ube44\ubc94\ud55c \uc11c\uc5ed \ubd88\uc2b9\uc758 \uc815\uccb4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uc18c\uc720\uc758 \uc804\uc0dd \uc2a4\uc2b9\uc778 '\uc721\uad00 \ub300\uc0ac'."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\uc5ed \ubd88\uc2b9(\uc721\uad00 \ub300\uc0ac)\uc774 \uc591\uc18c\uc720\ub97c \uafc8\uc5d0\uc11c \uae68\uc5b4\ub098\uac8c \ud558\uae30 \uc704\ud574 \ucde8\ud55c \ud589\ub3d9\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ud321\uc774\ub97c \ub192\uc774 \ub4e4\uc5b4 \ub09c\uac04\uc744 \ub450\uc5b4 \ubc88 \uc138\uac8c \uccd0 \uad6c\ub984\uc744 \uc77c\uc73c\ud0b4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uafc8\uc5d0\uc11c \uae68\uc5b4\ub09c \uc9c1\ud6c4 \uc131\uc9c4 \uc790\uc2e0\uc758 \ubaa8\uc2b5\uacfc \uc8fc\ubcc0 \ud658\uacbd \ubcc0\ud654\ub294 \uc5b4\ub5a0\ud588\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ub824\ud55c \ub204\ub300\uc640 \ucc98\ucca9\uc740 \uc0ac\ub77c\uc9c0\uace0, \uc791\uc740 \uc554\uc790\uc758 \ubd80\ub4e4\ubc29\uc11d \uc704\uc5d0 \ubc31\ud314 \uc5fc\uc8fc\ub97c \ubaa9\uc5d0 \uac78\uace0 \uba38\ub9ac\ub97c \uc0c8\ub85c \uae4e\uc740 \uc80a\uc740 \ubd88\uc2b9(\uc131\uc9c4)\uc73c\ub85c \uc549\uc544 \uc788\uc5c8\uc74c."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uafc8\uc5d0\uc11c \uae68\uc5b4\ub09c \uc131\uc9c4\uc774 \uae68\ub2ec\uc740 \uc778\uac04 \uc138\uc0c1\uc758 \ubd80\uadc0\uc601\ud654\uc640 \ub0a8\ub140 \uc815\uc695\uc758 \ubcf8\uc9c8\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\uc2b9\uc774 \uc798\ubabb\ub41c \uc0dd\uac01\uc744 \uae68\uc6b0\uccd0 \uc8fc\uae30 \uc704\ud574 \uafb8\uac8c \ud55c '\uc77c\uc7a5\ucd98\ubabd'\uc774\uc790 \ub367\uc5c6\uace0 \ud5db\ub41c \uac83\uc784."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc721\uad00 \ub300\uc0ac\uac00 \uafc8\uc5d0\uc11c \uae6c \uc131\uc9c4\uc5d0\uac8c '\uc7a5\uc790\uc758 \ub098\ube44 \uafc8(\ud638\uc811\uc9c0\ubabd)' \uace0\uc0ac\ub97c \uc778\uc6a9\ud558\uc5ec \uc804\ub2ec\ud558\ub824 \ud55c \uad50\ud6c8\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uafc8\uacfc \ud604\uc2e4, \uc131\uc9c4\uacfc \uc18c\uc720\ub97c \ubd84\ub9ac\ud558\uc5ec \ub300\ub9bd\uc801\uc73c\ub85c \ubcf4\ub294 \uc9d1\ucc29\uc744 \ubc84\ub9ac\uace0 \ub458\uc774 \ubcf8\ub798 \ud558\ub098\uc784\uc744 \uae68\ub2ec\uc73c\ub77c\ub294 \uac83."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\uc9c4\uc774 \uae68\ub2ec\uc74c\uc744 \uc5bb\uc740 \ub4a4 \ub2e4\uc2dc \ucc3e\uc544\uc628 \ud314\uc120\ub140\uac00 \ubd88\ubb38\uc5d0 \uadc0\uc758\ud558\uae30 \uc704\ud574 \ubcf4\uc778 \uacb0\ub2e8 \ud589\ub3d9\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5bc\uad74\uc758 \uc5f0\uc9c0\uc640 \ubd84\uc744 \uc53b\uace0 \ube44\ub2e8\uc637\uc744 \ubc97\uc740 \ud6c4, \uac00\uc704\ub85c \uba38\ub9ac\ub97c \uc798\ub77c \uc0ad\ubc1c\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc721\uad00 \ub300\uc0ac\uac00 \uc124\ubc95\uc744 \ub9c8\uce58\uba70 \uc678\uc6b4 \u300e\uae08\uac15\uacbd\u300f \uac8c\uc1a1\uc758 \ud575\uc2ec \ub0b4\uc6a9(\uc8fc\uc81c)\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\"\uc138\uc0c1\ub9cc\uc0ac\uac00 \ubaa8\ub450 \uafc8 \uac19\uace0 \ubb3c\uac70\ud488 \uac19\uc73c\uba70 \uc774\uc2ac \uac19\uace0 \ubc88\uac1c \uac19\uc73c\ub2c8 \ub9c8\ub545\ud788 \uc138\uc0c1\uc740 \uc774\ub807\uac8c \ubcfc\uc9c0\ub77c.\""
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc721\uad00 \ub300\uc0ac\uac00 \uc131\uc9c4\uc5d0\uac8c \uac00\uc0ac, \ubc1c\uc6b0, \uc815\ubcd1, \uc11d\uc7a5, \uae08\uac15\uacbd\uc744 \uc8fc\uace0 \uc11c\uc5ed\uc73c\ub85c \ub3cc\uc544\uac04 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\uc9c4\uc774 \uc801\uba78\uc758 \ub3c4\ub9ac\ub97c \uc5bb\uace0 \uacc4\ud589\uc774 \uc644\uc804\ud574\uc838 \ubd88\ubc95\uc744 \ubb3c\ub824\uc904 \uc801\uc784\uc790(\ud6c4\uacc4\uc790)\uac00 \ub418\uc5c8\uae30 \ub54c\ubb38."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uad6c\uc6b4\ubabd\u300d\uc758 \uacb0\ub9d0\uc5d0\uc11c \uc131\uc9c4\uacfc \uc5ec\ub35f \ube44\uad6c\ub2c8(\ud314\uc120\ub140)\uac00 \ucd5c\uc885\uc801\uc73c\ub85c \ub3c4\ub2ec\ud55c \uacbd\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud070 \ub3c4\ub9ac\ub97c \uc5bb\uace0 \ub300\uc911\uc744 \uc774\ub04c\ub2e4\uac00 \ub9c8\uce68\ub0b4 \ubaa8\ub450 \uadf9\ub77d\uc73c\ub85c \uac10."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc778\uacf5\uc758 \ud604\uc2e4 \uc18d \uc774\ub984 '\uc131\uc9c4(\u6027\u771e)'\uc758 \ud55c\uc790\uc801 \uc758\ubbf8\uc640 \uc11c\uc0ac\uc801 \ubcf5\uc120\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ub9c9\ud798\uc774 \uc5c6\uc774 \ub3cc\uc544\uac00\ub294 \ubcf8\uc131'\uc744 \ub73b\ud558\uba70, \uc131\uc9c4\uc774 \uacb0\uad6d \uc790\uc2e0\uc774 \ub3cc\uc544\uac00\uc57c \ud560 \ubd80\ucc98\uc758 \uc138\uacc4\ub85c \ub418\ub3cc\uc544\uac08 \uc874\uc7ac\uc784\uc744 \ub73b\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc778\uacf5\uc758 \uafc8\uc18d \uc774\ub984 '\uc18c\uc720(\u5c11\u904a)'\uc758 \ud55c\uc790\uc801 \uc758\ubbf8\uc640 \uc11c\uc0ac\uc801 \ubcf5\uc120\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc7a0\uae50 \ub178\ub2d0\ub2e4'\ub77c\ub294 \ub73b\uc73c\ub85c, \uc778\uac04 \uc138\uc0c1\uc5d0\uc11c\uc758 \ubd80\uadc0\uc601\ud654\uc640 \uc138\uc18d\uc801 \uc0b6\uc774 \uc7a0\uc2dc \uba38\ubb34\ub294 \ucc30\ub098\uc758 \uafc8\uc5d0 \ubd88\uacfc\ud568\uc744 \uc0c1\uc9d5\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uc124 \u300c\uad6c\uc6b4\ubabd\u300d\uc5d0\uc11c '\uafc8'\uc774 \uc218\ud589\ud558\ub294 \ud575\uc2ec\uc801 \uc5ed\ud560 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc131\uc9c4\uc758 \uc138\uc18d\uc801 \uc695\ub9dd\uc744 \uc2e4\uc81c\ub85c \uc9c1\uc811 \uccb4\ud5d8\ud558\uac8c \ud558\ub294 \ub9e4\uac1c\uccb4.\n2. \uc138\uc18d\uc801 \uc695\ub9dd\uc758 \ubb34\uc0c1\ud568\uc744 \uae68\ub2eb\uace0 \uc9c4\uc815\ud55c \ubd88\uad50\uc801 \ub4dd\ub3c4\ub85c \uc774\ub044\ub294 \uad50\uc721\uc801 \uacc4\uae30."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uc124 \u300c\uad6c\uc6b4\ubabd\u300d\uc5d0\uc11c '\uc721\uad00 \ub300\uc0ac'\uac00 \ub2f4\ub2f9\ud558\ub294 \uc778\ubb3c\uc801 \uc5ed\ud560\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\uc9c4\uc774 \ubc88\ub1cc\uc5d0 \ube60\uc84c\uc744 \ub54c \uafc8\uc744 \ud65c\uc6a9\ud558\uc5ec \uc138\uc18d\uc801 \uc695\ub9dd\uc758 \ub367\uc5c6\uc74c\uc744 \uae68\uc6b0\uce58\uace0 \ucc38\ub41c \ubd88\ubc95\uc73c\ub85c \uc778\ub3c4\ud558\ub294 \uc2a4\uc2b9\uc774\uc790 \uc870\ub825\uc790."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc120 \uc601\uc870 \uc784\uae08\uc774 \u300e\uc2b9\uc815\uc6d0\uc77c\uae30\u300f\uc5d0\uc11c \u300c\uad6c\uc6b4\ubabd\u300d\uc744 \uc138 \ubc88 \uc5b8\uae09\ud558\uba70 \uce6d\ucc2c\ud55c \ub450 \uac00\uc9c0 \uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\"\uc9dc\uc784\uc774 \uc88b\ub2e4\", \"\ubb38\uc7a5\uc774 \uc88b\ub2e4\"."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uad6c\uc6b4\ubabd\u300d\uc774 \ucd5c\uc0c1\uce35 \uad6d\uc655\ubd80\ud130 \ucd5c\ud558\uce35 \uc2dc\uace8 \uae30\uc0dd\uc5d0 \uc774\ub974\uae30\uae4c\uc9c0 \ud3ed\ub113\uac8c \uc0ac\ub791\ubc1b\uc558\uc74c\uc744 \ubcf4\uc5ec \uc8fc\ub294 \ubb38\ud559\uc0ac\uc801 \uc758\uc758\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc120 \uc804 \uacc4\uce35\uc774 \ud5a5\uc720\ud55c \uc2e4\uc9c8\uc801\uc778 \ucd5c\ucd08\uc758 '\uad6d\ubbfc \ubb38\ud559'\uc774\uc790 \uc0c1\uc5c5\uc801\uc73c\ub85c \ucd9c\ud310\ub41c \ud55c\uad6d \uace0\uc804 \uc18c\uc124."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300e\uc0bc\uad6d\uc720\uc0ac\u300f\uc758 \u300c\uc870\uc2e0 \uc124\ud654\u300d\uc640 \uae40\ub9cc\uc911\uc758 \u300c\uad6c\uc6b4\ubabd\u300d\uc774 \uacf5\uc720\ud558\ub294 \ub300\ud45c\uc801\uc778 \uad6c\uc131\uc801 \uacf5\ud1b5\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc778\uacf5\uc758 '\uafc8'\uc744 \uc911\uc2ec\uc73c\ub85c \uc774\uc57c\uae30\ub97c \uc804\uac1c\ud558\ub294 '\ud604\uc2e4 - \uafc8 - \ud604\uc2e4' \ud658\ubabd \uad6c\uc870."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc870\uc2e0 \uc124\ud654\u300d\uc640 \u300c\uad6c\uc6b4\ubabd\u300d\uc5d0\uc11c \uc8fc\uc778\uacf5\ub4e4\uc774 \uafc8\uc744 \ud1b5\ud574 \ucd5c\uc885\uc801\uc73c\ub85c \uae68\ub2eb\uac8c \ub418\ub294 \uc8fc\uc81c\uc801 \uacf5\ud1b5\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uc18d\uc801 \uc695\ub9dd\uacfc \uc0b6\uc740 \ub367\uc5c6\ub294 \uac83(\uc778\uc0dd\ubb34\uc0c1)\uc774\ub77c\ub294 \uae68\ub2ec\uc74c."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc870\uc2e0 \uc124\ud654\u300d\uc758 \uafc8 \ub0b4\uc6a9\uacfc \u300c\uad6c\uc6b4\ubabd\u300d\uc758 \uafc8 \ub0b4\uc6a9 \uc0ac\uc774\uc758 \uacb0\uc815\uc801\uc778 \ucc28\uc774\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc870\uc2e0 \uc124\ud654\u300d\uc758 \uafc8: \uac00\ub09c, \uc9c8\ubcd1, \uc790\uc2dd\uc758 \uc8fd\uc74c, \uc774\ubcc4 \ub4f1 \ube44\ucc38\ud558\uace0 \uace0\ud1b5\uc2a4\ub7ec\uc6b4 \uc2dc\ub828\uc758 \uc5f0\uc18d.\n\u300c\uad6c\uc6b4\ubabd\u300d\uc758 \uafc8: \uc785\uc2e0\uc591\uba85, \uacf5\uba85\ub2ec\uc131, \ub450 \uc544\ub0b4\uc640 \uc5ec\uc12f \ucca9\uacfc\uc758 \ucd5c\uace0 \ubd80\uadc0\uc601\ud654 \uccb4\ud5d8."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc870\uc2e0 \uc124\ud654\u300d\uc640 \u300c\uad6c\uc6b4\ubabd\u300d\uc5d0\uc11c \uc8fc\uc778\uacf5\uc758 \uc2e0\ubd84 \ubc0f \uc695\ub9dd\uc758 \uc131\uaca9 \ucc28\uc774\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc2e0: \ud3c9\ubc94\ud55c \uad00\ub9ac \uc2b9\ub824\ub85c\uc11c \ud2b9\uc815 \uc5ec\uc778(\ud0dc\uc218\uc758 \ub538)\uc5d0 \ub300\ud55c \ub0a8\ub140 \uac04\uc758 \uc815\uc695\uacfc \uc77c\uc0c1\uc801 \ud589\ubcf5\uc744 \uc5f4\ub9dd\ud568.\n\uc131\uc9c4: \ub3c4\uac00 \uae4a\uc740 \ubd88\uc81c\uc790\ub85c\uc11c \uc138\uc18d\uc801 \uc785\uc2e0\uc591\uba85\uacfc \ucd5c\uace0\uc758 \uc601\uc6c5\uc801 \ubd80\uadc0\uacf5\uba85\uc744 \ubc14\ub78c."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uc11c\uc5ed(\u897f\u57df)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uad6d\uc758 \uc11c\ucabd\uc5d0 \uc788\ub358 \uc5ec\ub7ec \ub098\ub77c(\uc778\ub3c4 \ubc0f \uc911\uc559\uc544\uc2dc\uc544 \uc9c0\uc5ed)\ub97c \ud1b5\ud2c0\uc5b4 \uc774\ub974\ub294 \ub9d0."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uc120\ubc29(\u79aa\u623f)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc808\uc5d0\uc11c \ucc38\uc120(\ub3c4\uac00 \uae4a\uc740 \ubd88\uad50 \uc218\ud589)\uc744 \ud558\ub294 \ubc29."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\ud669\uac74\uc5ed\uc0ac(\u9ec3\u5dfe\u529b\u58eb)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud669\uc0c9 \ub450\uac74\uc744 \uc4f4 \ud798\uc774 \uc138\uace0 \uc601\ud5d8\ud55c \uc7a5\uc218 \uc2e0(\u795e)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uc74c\ub355(\u852d\u5fb7)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\uc9c0\ud560 \ub9cc\ud55c \ub300\uc0c1\uc758 \ubcf4\uc774\uc9c0 \uc54a\ub294 \uc740\ubc00\ud55c \ubcf4\ud638\ub098 \ud61c\ud0dd."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\ucc98\uc0ac(\u8655\u58eb)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcbc\uc2ac\uc744 \ud558\uc9c0 \uc54a\uace0 \uc2dc\uace8\uc774\ub098 \uc232\uc18d\uc5d0 \ubb3b\ud600 \uc0ac\ub294 \uc120\ube44."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uac08\uac74\uc57c\ubcf5(\u845b\u5dfe\u91ce\u670d)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce59 \uaecd\uc9c8\ub85c \ub9cc\ub4e0 \ub450\uac74\uacfc \ubca0\uc637\uc774\ub77c\ub294 \ub73b\uc73c\ub85c, \ubcbc\uc2ac\uc744 \ud558\uc9c0 \uc54a\ub294 \ucc98\uc0ac\ub098 \uc740\uc0ac\uc758 \uac70\uce60\uace0 \uc18c\ubc15\ud55c \uc637\ucc28\ub9bc."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uc7a5\uc0c1(\u5c07\u76f8)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7a5\uc218\uc640 \uc7ac\uc0c1\uc744 \uc544\uc6b8\ub7ec \uc774\ub974\ub294 \ub9d0\ub85c, \uad70\uc0ac\uc640 \uc815\ubb34\uc758 \ucd5c\uace0 \ubcbc\uc2ac."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uc625\uc6a9\ud654\ud0dc(\u7389\u5bb9\u82b1\u614b)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc625\uac19\uc774 \uace0\uc6b4 \uc6a9\ubaa8\uc640 \uaf43\uac19\uc774 \uc544\ub984\ub2e4\uc6b4 \uc790\ud0dc(\uc544\ub984\ub2e4\uc6b4 \uc5ec\uc778\uc758 \ubaa8\uc2b5)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\ud5c8\ud0c4(\u865b\u8a95)\ud558\ub2e4'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac70\uc9d3\ub418\uace0 \ubbf8\ub86d\uc9c0 \ubabb\ud558\uc5ec \uc2e4\uc0c1\uc774 \uc5c6\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uc790\uc131\uc5b4: '\uc77c\uc7a5\ucd98\ubabd(\u4e00\u5834\u6625\u5922)'\uc758 \ud55c\uc790\uc801 \ub73b\uacfc \ube44\uc720\uc801 \uc758\ubbf8\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\ubc14\ud0d5\uc758 \ubd04\uafc8\uc774\ub77c\ub294 \ub73b\uc73c\ub85c, \ubd80\uadc0\uc601\ud654\ub098 \ub367\uc5c6\ub294 \uc77c\uc774 \ud5db\ub418\uc774 \uc0ac\ub77c\uc9d0\uc744 \uc774\ub974\ub294 \ub9d0."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uc559\ud654(\u6b83\u798d)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub5a4 \uc798\ubabb\uc774\ub098 \uc77c\ub85c \uc778\ud558\uc5ec \uc0dd\uae30\ub294 \uc7ac\ub09c\uacfc \ud654\ub97c \uc758\ubbf8\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uac8c\uc1a1(\u5048\u980c)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\ucc98\uc758 \uacf5\ub355\uc774\ub098 \ubd88\uad50\uc758 \uac00\ub974\uce68\uacfc \uc2ec\uc624\ud55c \uad50\ub9ac\ub97c \ucc2c\ud0c4\ud558\uace0 \uc74a\uc740 \ub178\ub798 \uad6c\uc808."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uc801\uba78(\u5bc2\u6ec5)'\uc758 \ub73b\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\ub4e0 \uc0dd\uc0ac \ubc88\ub1cc\uc758 \uad34\ub85c\uc6c0\uc744 \ub04a\uace0 \uc601\uc6d0\ud55c \ud3c9\uc815\uc758 \uae68\ub2ec\uc74c\uc5d0 \ub3c4\ub2ec\ud558\ub294 \uc77c."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 \uc815\uc758: '\uacc4\ud589(\u6212\u884c)'\uc758 \ub73b\uc740?"
          }
        ]
