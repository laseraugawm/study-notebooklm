{
  "title": "\uc815\ub144\uc774 \ud034\uc988",
  "questions": [
    {
      "question": "\ub9e4\uccb4 \ube44\ud3c9\uc758 \ud3c9\uac00 \uc694\uc18c \uc911 '\ub0b4\uc6a9 \uce21\uba74'\uacfc '\ud615\uc2dd \uce21\uba74'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub0b4\uc6a9 \uce21\uba74\uc5d0\uc11c\ub294 \ub9e4\uccb4 \uc790\ub8cc\uc5d0 \ub4dc\ub7ec\ub09c \uad00\uc810\uc774\ub098 \uc758\ub3c4\uc758 \ud0c0\ub2f9\uc131, \uc8fc\uc81c\uc758 \uc801\ud569\uc131 \ub4f1\uc744 \ud3c9\uac00\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub9e4\uccb4 \ube44\ud3c9\uc5d0\uc11c \ub0b4\uc6a9 \uce21\uba74\uc740 \uc791\ud488\uc774 \ub2f4\uace0 \uc788\ub294 \uad00\uc810, \uc758\ub3c4, \uc8fc\uc81c, \uc81c\uc7ac\uc758 \uc801\ud569\uc131\uacfc \ud0c0\ub2f9\uc131\uc744 \ub2e4\ub8e8\uae30 \ub54c\ubb38\uc774\ub2e4."
        },
        {
          "text": "\ud615\uc2dd \uce21\uba74\uc5d0\uc11c\ub294 \uc81c\uc7ac\uc758 \uc131\uaca9\uacfc \uae30\ub2a5\uc774 \ub9e4\uccb4\uc5d0 \ub9de\uac8c \uc81c\uc2dc\ub418\uc5c8\ub294\uc9c0\ub97c \uc8fc\ub85c \ub2e4\ub8ec\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc81c\uc7ac\uc758 \uc131\uaca9\uacfc \uae30\ub2a5\uc5d0 \ub300\ud55c \ud3c9\uac00\ub294 \ub9e4\uccb4 \ube44\ud3c9\uc758 \ub0b4\uc6a9 \uce21\uba74\uc5d0 \ud574\ub2f9\ud558\ub294 \uc694\uc18c\uc774\ub2e4."
        },
        {
          "text": "\ud45c\ud604 \ubc29\ubc95\uc758 \ud6a8\uacfc\uc640 \uc801\uc808\uc131\uc744 \ud3c9\uac00\ud558\ub294 \uac83\uc740 \ub0b4\uc6a9 \uce21\uba74\uc758 \ub300\ud45c\uc801\uc778 \ube44\ud3c9 \uae30\uc900\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud45c\ud604 \ubc29\ubc95\uc758 \ud6a8\uacfc\uc131 \ubc0f \uc801\uc808\uc131\uc744 \ud3c9\uac00\ud558\ub294 \uac83\uc740 \ub0b4\uc6a9\uc774 \uc544\ub2cc \ud615\uc2dd \uce21\uba74\uc758 \ube44\ud3c9 \uc694\uc18c\uc5d0 \uc18d\ud55c\ub2e4."
        },
        {
          "text": "\ub9e4\uccb4 \uc790\ub8cc\uac00 \uac00\uc9c4 \ubaa9\uc801\uc774\ub098 \uad00\uc810\uc758 \ud0c0\ub2f9\uc131\uc744 \uac80\ud1a0\ud558\ub294 \uac83\uc740 \ud615\uc2dd \uce21\uba74\uc5d0 \uc18d\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad00\uc810\uc774\ub098 \ubaa9\uc801, \uc758\ub3c4\uc758 \ud0c0\ub2f9\uc131\uc744 \uac80\ud1a0\ud558\ub294 \ud65c\ub3d9\uc740 \ube44\ud3c9\uc758 \ub0b4\uc6a9 \uce21\uba74\uc5d0\uc11c \uc218\ud589\ub41c\ub2e4."
        }
      ],
      "hint": "\ube44\ud3c9 \uc694\uc18c \uc911 \uc791\ud488\uc758 \uba54\uc2dc\uc9c0\ub098 \uc8fc\uc81c\uc640 \uad00\ub828\ub41c \ubd80\ubd84\uacfc \ud45c\ud604 \ubc29\uc2dd\uc5d0 \uad00\ub828\ub41c \ubd80\ubd84\uc744 \uad6c\ubcc4\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \ubd84\uc11d\ud55c \uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc758 '\uc18c\ub9ac\uc758 \ud55c\uacc4' \uadf9\ubcf5 \ubc29\ubc95 \uc911 \ubcf8\ubb38\uc758 \ub0b4\uc6a9\uacfc \uc77c\uce58\ud558\uc9c0 \uc54a\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 \ud2b9\uc131\uc744 \ud65c\uc6a9\ud574 \ubc30\uacbd \uc74c\uc545(BGM)\uc744 \uc624\ub514\uc624\ub85c \uc9c1\uc811 \uc0bd\uc785\ud558\uc5ec \uc644\ubcbd\ud55c \uc18c\ub9ac\ub97c \uc804\ub2ec\ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\uae00\uc4f4\uc774\ub294 \ubc30\uacbd \uc74c\uc545 \uc0bd\uc785\ub9cc\uc73c\ub85c\ub294 \uc791\ud488\uc774 \uc804\ub2ec\ud558\ub824\ub294 \uc18c\ub9ac\ub97c \uc628\uc804\ud788 \uad6c\ud604\ud558\uae30 \uc5b4\ub835\ub2e4\uace0 \uc9c0\uc801\ud558\uba70, \uc2dc\uac01\uc801 \uc885\ud569 \uc5f0\ucd9c\ub85c \uc774\ub97c \uadf9\ubcf5\ud588\uc74c\uc744 \uc5b8\uae09\ud55c\ub2e4."
        },
        {
          "text": "\ub178\ub7ab\ub9d0 \uc0ac\uc774\uc5d0 \ubb3c\uacb0\ud45c(~) \uae30\ud638\ub97c \ud65c\uc6a9\ud574 \uc18c\ub9ac\uc758 \uc6b4\uc728\uac10\uacfc \uaebe\uc784\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \ud45c\ud604\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5b4\ubb38 \uaddc\uc815\uc5d0\ub294 \ub9de\uc9c0 \uc54a\uc9c0\ub9cc \ubb3c\uacb0\ud45c\ub97c \uc0ac\uc6a9\ud574 \ub178\ub7ab\ub9d0\uc758 \uc5f0\ucc3d\uc744 \ub3c5\uc790\uac00 \uc27d\uac8c \ub290\ub07c\ub3c4\ub85d \ub3c4\uc6b4 \uc5f0\ucd9c \uae30\ubc95\uc774\ub2e4."
        },
        {
          "text": "\ub178\ub798 \uac00\uc0ac\ub97c \uc77c\ubc18 \ub300\uc0ac\uc640 \uba85\ud655\ud788 \uad6c\ubcc4\ud560 \uc218 \uc788\ub3c4\ub85d \uc11c\uccb4\ub97c \ub2e4\ub974\uac8c \uc801\uc6a9\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc11c\uccb4\ub97c \ub2e4\ub974\uac8c \uc9c0\uc815\ud568\uc73c\ub85c\uc368 \ub300\uc0ac\uc640 \uc18c\ub9ac(\ub178\ub798)\uc758 \uad6c\ubd84\uc744 \uba85\ud655\ud788 \uc2dc\uac01\ud654\ud55c \ubc29\ubc95\uc774\ub2e4."
        },
        {
          "text": "\uc778\ubb3c\uc758 \ub2e4\ucc44\ub85c\uc6b4 \ub3d9\uc791, \uc5ed\ub3d9\uc801\uc778 \uc575\uae00, \uc8fc\ubcc0 \uad00\uac1d\uc758 \ud45c\uc815 \ub4f1\uc744 \uacb0\ud569\ud558\uc5ec \uc18c\ub9ac\ub97c \uc2dc\uac01\ud654\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e4\uc591\ud55c \uc2dc\uac01\uc801 \uc5f0\ucd9c \uc694\uc18c\uc640 \uc778\ubb3c\uc758 \ubc18\uc751 \ucef7\uc744 \uc885\ud569\ud558\uc5ec \uccad\uac01\uc801 \ubd80\uc7ac\ub97c \uadf9\ubcf5\ud574 \ub0b8 \uc5f0\ucd9c\ubc95\uc774\ub2e4."
        }
      ],
      "hint": "\uc6f9\ud230\uc774\ub77c\ub294 \ub9e4\uccb4\uc5d0\uc11c \uccad\uac01\uc801 \uc18c\ub9ac\ub97c \uc9c1\uc811 \ub4e4\ub824\uc8fc\ub294 \uac83\uc5d0\ub294 \uc5b4\ub5a4 \ud55c\uacc4\uac00 \uc788\uc5c8\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c \ub2e4\ub8ec '\uc5ec\uc131 \uad6d\uadf9'\uc774\ub77c\ub294 \uc81c\uc7ac(\uc18c\uc7ac)\uc5d0 \uc758\ubbf8\ub97c \ubd80\uc5ec\ud55c \uc774\uc720\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub3c5\uc790\ub4e4\uc5d0\uac8c \uc0dd\uc18c\ud558\uace0 \uc18c\ub9ac\ub97c \ub5a0\uc62c\ub9ac\uae30 \uc5b4\ub824\uc6b4 \uc7a5\ub974\uc784\uc5d0\ub3c4 \uc6f9\ud230 \ud2b9\uc720\uc758 \uc2dc\uac01\uc801 \uc885\ud569 \uc5f0\ucd9c\ub85c \ud55c\uacc4\ub97c \uadf9\ubcf5\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc775\uc219\ud558\uc9c0 \uc54a\uc740 '\uc5ec\uc131 \uad6d\uadf9'\uc744 \uc18c\uc7ac\ub85c \uc0bc\uc544 \uc18c\ub9ac\ub97c \uc5f0\uc0c1\ud558\uae30 \ud798\ub4e0 \ubd88\ub9ac\ud568 \uc18d\uc5d0\uc11c\ub3c4 \uc774\ub97c \ub9e4\uccb4\uc801 \uc5f0\ucd9c\ub85c \uadf9\ubcf5\ud588\uc74c\uc744 \uac15\uc870\ud55c\ub2e4."
        },
        {
          "text": "\uae30\uc874 \uc601\ud654\ub098 \ub4dc\ub77c\ub9c8\uc5d0\uc11c \ub300\uc911\uc801\uc73c\ub85c \ud06c\uac8c \uac80\uc99d\ub41c \uc548\uc804\ud55c \ud765\ud589 \uc18c\uc7ac\uc600\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf8\ubb38\uc5d0 \ub530\ub974\uba74 \uc5ec\uc131 \uad6d\uadf9\uc740 \uc6f9\ud230\ubfd0\ub9cc \uc544\ub2c8\ub77c \ub2e4\ub978 \ub9e4\uccb4\uc5d0\uc11c\ub3c4 \uc27d\uac8c \uc811\ud558\uae30 \ud798\ub4e0 \uc0dd\uc18c\ud55c \uc7a5\ub974\uc600\ub2e4."
        },
        {
          "text": "\ub85d \ubc34\ub4dc\ub098 \uad00\ud604\uc545\ub2e8\ucc98\ub7fc \ub300\uc911\uc5d0\uac8c \ub9e4\uc6b0 \uc775\uc219\ud558\uc5ec \ub3c5\uc790\ub4e4\uc774 \uc27d\uac8c \uc74c\uc545\uc744 \uc5f0\uc0c1\ud560 \uc218 \uc788\uc5c8\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub85d \ubc34\ub4dc\ub098 \uad00\ud604\uc545\ub2e8\uc740 \uae30\uc874 \uc6f9\ud230\ub4e4\uc758 \uc775\uc219\ud55c \uc81c\uc7ac\uc600\uc73c\ub098, \uc5ec\uc131 \uad6d\uadf9\uc740 \ub0af\uc120 \uc804\ud1b5 \uc74c\uc545\uc774\ub77c\ub294 \ucc28\uc774\uc810\uc774 \uc788\ub2e4."
        },
        {
          "text": "\uccad\uac01 \ub9e4\uccb4\uc778 \uc6f9\ud230\uc758 \ud2b9\uc131\uc5d0 \uac00\uc7a5 \uc798 \ubd80\ud569\ud558\ub294 \uc5f0\ucd9c \uae30\ubc95\uc744 \uc81c\uacf5\ud558\ub294 \uc18c\uc7ac\uc600\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc6f9\ud230\uc740 \uccad\uac01 \ub9e4\uccb4\uac00 \uc544\ub2c8\ub77c \ud3c9\uba74\uc5d0 \uad6c\ud604\ub418\ub294 \uc2dc\uac01 \ub9e4\uccb4\ub77c\ub294 \ud55c\uacc4\ub97c \uc9c0\ub2c8\uace0 \uc788\ub2e4."
        }
      ],
      "hint": "\uae30\uc874\uc758 \uc74c\uc545 \uc6f9\ud230 \uc18c\uc7ac(\ub85d \ubc34\ub4dc, \uad00\ud604\uc545\ub2e8)\uc640 \ube44\uad50\ud560 \ub54c '\uc5ec\uc131 \uad6d\uadf9'\uc774 \uac00\uc9c4 \uc0dd\uc18c\ud568\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \uc124\uba85\ud55c \uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c\uc758 '\uc624\ubc84\ub7a9(overlap)' \uae30\ubc95 \ud65c\uc6a9\uc758 \ud2b9\uc774\uc810\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uacfc\uac70\uc640 \ud604\uc7ac\uc758 \uc2dc\uac04\uc774 \uc77c\uc2dc\uc801\uc73c\ub85c \uacb9\uce58\ub294 \uc804\ud615\uc801\uc778 \ucc29\uc2dc \ud6a8\uacfc \uae30\ubc95\uc73c\ub85c \uc0ac\uc6a9\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc601\ud654\ub098 \ub4dc\ub77c\ub9c8\uc5d0\uc11c \uc2dc\uac04\uc5d0 \ub530\ub978 \uc624\ubc84\ub7a9\uc774 \uc8fc\ub85c \uc4f0\uc774\ub294 \ubc18\uba74, \ubcf8\ubb38\uc758 \ud2b9\uc774\uc810\uc740 \uc778\ubb3c \uac04 \uc624\ubc84\ub7a9\uc5d0 \uc788\ub2e4."
        },
        {
          "text": "\ubc30\uc6b0\uac00 \uacf5\uc5f0 \uce90\ub9ad\ud130\uc640 \ud63c\uc5f0\uc77c\uccb4\uac00 \ub418\ub294 \ubaa8\uc2b5\uc744 \ub098\ud0c0\ub0b4\uae30 \uc704\ud574 \ubc30\uc6b0\uc640 \uce90\ub9ad\ud130\ub97c \ub3d9\uc2dc\uc5d0 \uacb9\uccd0 \ud45c\ud604\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc601\uc0c1 \ub9e4\uccb4\uc5d0\uc11c \ubcf4\uae30 \ud798\ub4e0 '\uc778\ubb3c \uac04 \uc624\ubc84\ub7a9'\uc744 \ud65c\uc6a9\ud558\uc5ec \ubc30\uc6b0\uc640 \uc5ed\uc758 \uc77c\uccb4\uac10\uc744 \uac15\ub82c\ud558\uac8c \uc5f0\ucd9c\ud588\uc74c\uc744 \uc124\uba85\ud55c\ub2e4."
        },
        {
          "text": "\ubb34\ub300 \uc704 \uc778\ubb3c\uacfc \uac1d\uc11d\uc758 \ubc18\uc751\uc744 \ubc88\uac08\uc544 \ubcf4\uc5ec \uc8fc\ub294 \ubc29\uc2dd\uc73c\ub85c \ubb34\ub300\uc758 \uc785\uccb4\uac10\uc744 \ub192\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb34\ub300\uc640 \uac1d\uc11d\uc744 \uad50\ucc28\ud574 \ubcf4\uc5ec \uc8fc\ub294 \uac83\uc740 \uc778\ubb3c \ucef7 \ubc0f \ubc18\uc751 \ucef7 \ubc30\uce58 \ubc29\uc2dd\uc774\uba70 \uc624\ubc84\ub7a9 \ud6a8\uacfc\uac00 \uc544\ub2c8\ub2e4."
        },
        {
          "text": "\uc7a5\uc18c\uc758 \uae09\uaca9\ud55c \ubcc0\ud654\ub97c \ubd80\ub4dc\ub7fd\uac8c \uc5f0\uacb0\ud558\uae30 \uc704\ud55c \uc7a5\uba74 \uc804\ud658 \uc6a9\ub3c4\ub85c \uc81c\ud55c\ud558\uc5ec \uc0ac\uc6a9\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e8\uc21c\ud788 \uc7a5\uc18c \uc804\ud658\uc744 \uc704\ud574 \uc4f0\uc778 \uac83\uc774 \uc544\ub2c8\ub77c \uc778\ubb3c\uc758 \uc5f4\uc5f0\uacfc \ubab0\uc785\uac10\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \uadf9\ub300\ud654\ud558\ub294 \ub370 \uc4f0\uc600\ub2e4."
        }
      ],
      "hint": "\uc77c\ubc18\uc801\uc73c\ub85c \uc2dc\uac04 \uacbd\uacfc\ub97c \ub098\ud0c0\ub0b4\ub294 \uc601\uc0c1\uc758 \uc624\ubc84\ub7a9\uacfc \ub2ec\ub9ac, \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c\ub294 \ubb34\uc5c7\uacfc \ubb34\uc5c7\uc744 \uacb9\uccd0\uc11c \ud45c\ud604\ud588\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \uc124\uba85\ud55c \ubb34\ub300\uc758 \uacf5\uac04\uc801 \ud55c\uacc4\uc640 \uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uac00 \uc774\ub97c \uadf9\ubcf5\ud55c \uc11c\uc0ac\uc801 \ubc29\uc2dd\uc73c\ub85c \uc54c\ub9de\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb34\ub300\uc758 \ub2eb\ud78c \ud2b9\uc131\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \uc778\ubb3c \uac04\uc758 \uacbd\uc7c1\uacfc \uac08\ub4f1 \uc694\uc18c\ub97c \uc644\uc804\ud788 \uc81c\uac70\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uad6c\uc0dd\ub4e4\uc740 \ubb34\ub300\uc5d0 \uc624\ub974\uae30 \uc704\ud574 \uce58\uc5f4\ud558\uac8c \uacbd\uc7c1\ud558\uace0 \uac08\ub4f1\ud558\uc9c0\ub9cc, \uadf8\uac83\uc774 \uc785\uccb4\uc801 \uc131\uc7a5\uc758 \uacc4\uae30\uac00 \ub41c\ub2e4."
        },
        {
          "text": "\uc8fc\uc778\uacf5 1\uc778\uc758 \ub4dc\ub77c\ub9c8\ud2f1\ud55c \ub3c5\uc8fc\uc5d0 \uc9d1\uc911\ud558\uc5ec \uac1c\ubcc4 \uc11c\uc0ac\uc758 \uc644\uc131\ub3c4\ub97c \uadf9\ub300\ud654\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud2b9\uc815 \ub4f1\uc7a5\uc778\ubb3c \ub2e8 \ud55c \uba85\uc758 \uc131\uc7a5\ubcf4\ub2e4 \uc218\ub9ce\uc740 \uc778\ubb3c\ub4e4\uc758 \uc791\uace0 \ud070 \ubb3c\uacb0\uc774 \ud569\uccd0\uc9c4 \uc5ed\ub3d9\uc131\uc744 \uadf8\ub824 \ub0c8\ub2e4."
        },
        {
          "text": "\uc8fc\ubcc0 \uc778\ubb3c\ub4e4\uc5d0\uac8c\ub3c4 \uc785\uccb4\uc801\uc778 \uc5ed\ud560\uacfc \ubc18\uc804\uc744 \ubd80\uc5ec\ud558\uc5ec \ub2e4\ucc44\ub85c\uc6b4 \uc11c\uc0ac\uc758 \ud569\uc744 \ub9cc\ub4e4\uc5b4 \ub0c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub2e8\uc120\uc801 \uac08\ub4f1\uc5d0 \uadf8\uce58\uc9c0 \uc54a\uace0 \uc5ec\ub7ec \uc778\ubb3c\uc758 \uc11c\uc0ac\ub97c \uc785\uccb4\uc801\uc73c\ub85c \uc804\uac1c\ud568\uc73c\ub85c\uc368 \ubb34\ub300 \uacf5\uac04\uc758 \uc81c\ud55c\uc131\uc744 \uadf9\ubcf5\ud588\ub2e4."
        },
        {
          "text": "\ubb34\ub300\ub77c\ub294 \uac00\uc0c1 \uacf5\uac04 \ub300\uc2e0 \ud604\uc2e4\uc801\uc778 \uc678\ubd80 \ubc30\uacbd\ub9cc\uc744 \uacc4\uc18d \ud655\uc7a5\ud558\uba70 \uc774\uc57c\uae30\ub97c \uc804\uac1c\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uac04 \ubc30\uacbd \uc790\uccb4\ub97c \ub298\ub9b0 \uac83\uc774 \uc544\ub2c8\ub77c \ubb34\ub300 \uc548\ud30e\uc758 \ub4f1\uc7a5\uc778\ubb3c\ub4e4\uc5d0\uac8c \ub2e4\uc591\ud55c \uc11c\uc0ac\uc801 \uae4a\uc774\ub97c \ubd80\uc5ec\ud588\ub2e4."
        }
      ],
      "hint": "\uc8fc\uc778\uacf5 \ud55c \uba85\uc5d0\uac8c\ub9cc \uc9d1\uc911\ub418\ub294 \ub2e8\uc120\uc801\uc778 \uc804\uac1c \ub300\uc2e0 \ub2e4\ub978 \ub4f1\uc7a5\uc778\ubb3c\ub4e4\uc774 \uc5b4\ub5a0\ud55c \uc5ed\ud560\uc744 \ub098\ub204\uc5b4 \ub9e1\uc558\ub294\uc9c0 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0 \ub4f1\uc7a5\ud558\ub294 \uc778\ubb3c\ub4e4\uc5d0 \ub300\ud55c \uae00\uc4f4\uc774\uc758 \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc724\uc815\ub144: \uc5b4\uba38\ub2c8\uc758 \ud074\ub798\uc2dd \uc131\uc545\uc5d0 \ub300\ud55c \ud3b8\uacac \ub54c\ubb38\uc5d0 \uc0c1\ucc98\ubc1b\uc558\uc73c\ub098 \ub2f9\ub2f9\ud55c \uc2e4\ub825\uc73c\ub85c \uc774\ub97c \uadf9\ubcf5\ud574 \ub098\uac04\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud074\ub798\uc2dd \uc131\uc545\ub9cc\uc774 \uace0\uae09\ubb38\ud654\ub77c\ub294 \uc5b4\uba38\ub2c8\uc758 \ud3b8\uacac\uc73c\ub85c \uc0c1\ucc98\ub97c \uc785\uace0 \uc2e4\ub825\uc73c\ub85c \uc778\uc815\ubc1b\uace0\uc790 \ud55c \uc778\ubb3c\uc740 '\ud5c8\uc601\uc11c'\uc774\ub2e4."
        },
        {
          "text": "\ubc31\ub3c4\uc575: \ubb34\ub300 \ubc16 \uc778\ubb3c\ub85c\uc11c \uc5f0\ucd9c\uac00\uc640 \ube44\ud3c9\uac00\uc758 \uc2dc\uac01\uc744 \uac00\ub85c\uc9c0\ub974\uba70 \ub3c5\uc790\uc5d0\uac8c \uc0c1\ud669\uc744 \ud574\uc11d\ud574 \uc8fc\ub294 \uc778\ubb3c\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc31\ub3c4\uc575\uc740 \ud1b5\ucc30\ub825 \uc788\ub294 \ubd84\uc11d\uc73c\ub85c \ub0af\uc120 \uad6d\uadf9 \uc7a5\ub974\ub97c \ub3c5\uc790\uac00 \uc774\ud574\ud558\ub3c4\ub85d \ub3d5\ub294 \uad6c\uc2e4\uc744 \ud55c\ub2e4."
        },
        {
          "text": "\ud5c8\uc601\uc11c: \ub3c5\ubd88\uc7a5\uad70 \uc720\ud615\uc774\uc5c8\uc73c\ub098 \uc791\ud488 \uc18d \uacf5\uc5f0\uc744 \uac70\uce58\uba70 \uc0c1\ub300\uc640 \ud638\ud761\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uace0 \uc815\uc815\ub2f9\ub2f9\ud558\uac8c \uaca8\ub8ec\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud5c8\uc601\uc11c\ub294 \uacac\uc81c\uc5d0\uc11c \ubc97\uc5b4\ub098 \uc790\uc2e0\uc758 \uae38\uc744 \ub113\ud788\uba70 \uc815\uc815\ub2f9\ub2f9\ud558\uac8c \uc2b9\ubd80\ud558\ub294 \uc778\ubb3c\ub85c \ubcc0\ud654\ud55c\ub2e4."
        },
        {
          "text": "\ud64d\uc8fc\ub780: \ucc98\uc74c\uc5d0\ub294 \uc8fc\uc778\uacf5\uc758 \ub2e8\uc9dd \uce5c\uad6c \uc815\ub3c4\ub85c \ubcf4\uc600\uc73c\ub098 \uc624\ub514\uc158\uc744 \uac70\uccd0 \uc8fc\uc694 \uc5ed\ud560\uc744 \ub9e1\uc73c\uba70 \ubc18\uc804\uc744 \ubcf4\uc5ec \uc900\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud64d\uc8fc\ub780\uc740 '\uad6c\uc2ac\uc544\uae30' \uc5ed\uc744 \ub9e1\uc73c\uba70 \uac15\ub82c\ud55c \ube5b\uc744 \ubc1c\uc0b0\ud558\uace0 \uc778\ubb3c\uc758 \uc228\uaca8\uc9c4 \ud798\uc744 \ub4dc\ub7ec\ub0b8\ub2e4."
        }
      ],
      "hint": "\uc5b4\uba38\ub2c8\uc758 \ud074\ub798\uc2dd \uc131\uc545 \ud3b8\uacac \ub54c\ubb38\uc5d0 \uc0c1\ucc98\ub97c \ubc1b\uc558\ub358 \ub4f1\uc7a5\uc778\ubb3c\uc774 \ub204\uad6c\uc600\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc815\ub144\uc774\uac00 \"\uc65c \uad6d\uadf9\uc744 \ud558\ub824 \ud558\ub290\ub0d0?\"\ub77c\ub294 \uc9c8\ubb38\uc5d0 \ub0b4\ub193\uc740 \ub2f5\uc774 \ubcc0\ud574\uac00\ub294 \uc758\ubbf8\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub2e8\uc21c\ud788 \uc0dd\uacc4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud55c \uc218\ub2e8\uc5d0\uc11c \uc790\uc2e0\uc774 \uc9c4\uc815 \ud45c\ud604\ud558\uace0 \uc2f6\uc740 \uc874\uc7ac \uadf8 \uc790\uccb4\uac00 \ub418\uace0\uc790 \ud558\ub294 \uc5f4\ub9dd\uc73c\ub85c \ubc1c\uc804\ud55c \uac83.",
          "isCorrect": true,
          "rationale": "\ucc98\uc74c\uc5d0\ub294 \ub3c8\uc744 \ubc84\ub294 \uc0dd\uacc4 \uc218\ub2e8\uc774\uc5c8\uc73c\ub098, \uc810\ucc28 \uc608\uc220\uc801\uc73c\ub85c \uc790\uc544\ub97c \uad6c\ud604\ud558\ub824\ub294 \uc9c4\uc815\ud55c \uc5f0\uadf9\uc801 \uc5f4\ub9dd\uc73c\ub85c \ubcc0\ud654\ud568\uc744 \ubcf4\uc5ec \uc900\ub2e4."
        },
        {
          "text": "\uc5b4\uba38\ub2c8\uc5d0 \ub300\ud55c \ud6a8\uc2ec\uc5d0\uc11c \uc2dc\uc791\ud558\uc5ec \ucd5c\uace0 \uba85\uc608\ub97c \uc5bb\uc5b4 \uacbd\uc7c1\uc790\ub97c \uc555\ub3c4\ud558\ub824\ub294 \uc57c\ub9dd\uc73c\ub85c \uc804\ud658\ub41c \uac83.",
          "isCorrect": false,
          "rationale": "\uc815\ub144\uc758 \ubcc0\ud654\ub294 \ud0c0\uc778\uc744 \uaebe\uae30 \uc704\ud55c \uc57c\ub9dd\uc774 \uc544\ub2c8\ub77c \uc8fc\uccb4\uc801\uc778 \uc5f0\uae30\uc801 \uc874\uc7ac\uac00 \ub418\uace0\uc790 \ud558\ub294 \uc5f4\ub9dd\uc758 \uae4a\uc5b4\uc9d0\uc774\ub2e4."
        },
        {
          "text": "\uacbd\uc7c1\uc790 \ud5c8\uc601\uc11c\ub97c \uc774\uae30\uae30 \uc704\ud55c \uc624\uae30\uc5d0\uc11c \uad6d\uadf9\ub2e8\uc744 \uc9c1\uc811 \uc774\ub044\ub294 \uc5f0\ucd9c\uac00\uac00 \ub418\ub824\ub294 \uc758\uc9c0\ub85c \ubc14\ub010 \uac83.",
          "isCorrect": false,
          "rationale": "\uc5f0\ucd9c\uac00\uac00 \ub418\ub824\ub294 \ubaa9\uc801\uc774 \uc544\ub2c8\ub77c \ubc30\uc6b0\ub85c\uc11c \ud45c\ud604\ud558\uace0 \uc2f6\uc740 \uc874\uc7ac \uadf8 \uc790\uccb4\uac00 \ub418\ub824\ub294 \uc5f4\ub9dd\uc774\ub2e4."
        },
        {
          "text": "\ub300\uc911\uc801\uc778 \ubd80\uc640 \uba85\uc131\uc744 \uc5bb\uc73c\ub824\ub294 \ubaa9\uc801\uc5d0\uc11c \uc5ec\uc131 \uad6d\uadf9\uc774\ub77c\ub294 \uc804\ud1b5\ubb38\ud654\ub97c \uc9c0\ucf1c\uc57c \ud55c\ub2e4\ub294 \uc758\ubb34\uac10\uc73c\ub85c \ubc14\ub010 \uac83.",
          "isCorrect": false,
          "rationale": "\uc758\ubb34\uac10 \ub54c\ubb38\uc774 \uc544\ub2c8\ub77c \ubc29\uc790 \ub4f1 \uc790\uc2e0\uc774 \uc9c4\uc815 \uc5f0\uae30\ud558\uace0 \ud45c\ud604\ud558\uace0 \uc2f6\uc740 \uc778\ubb3c \uadf8 \uc790\uccb4\uac00 \ub418\ub824\ub294 \uc5f4\ub9dd\uc774\ub2e4."
        }
      ],
      "hint": "'\ubd80\uc790'\uac00 \ub418\ub824\uace0 \ud588\ub358 \ucd08\uae30 \ubaa9\uc801\uc5d0\uc11c '\ubc29\uc790'\ub77c\ub294 \uc5ed\ud560\uc744 \ud558\uace0 \uc2f6\uc5b4 \ud558\ub294 \ubaa9\uc801 \ubcc0\ud654\uc758 \ubcf8\uc9c8\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "<\ubcf4\uae30>\ub294 \uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0 \ub300\ud55c \ub2e4\ub978 \ube44\ud3c9\ubb38(\ucd5c\uae30\ud604)\uc774\ub2e4. \uc774 \uae00\uc5d0\uc11c \uc8fc\ubaa9\ud558\uc600\uc73c\ub098, \uae40\ud76c\uacbd\uc758 \ube44\ud3c9\ubb38\uc5d0\uc11c\ub294 \uae4a\uac8c \ub2e4\ub8e8\uc9c0 \uc54a\uc740 \ube44\ud3c9 \uc694\uc18c\ub294?",
      "answerOptions": [
        {
          "text": "\uc0c9\uc758 \ud65c\uc6a9\uacfc \uc120\uc758 \ubc00\ub3c4, \ub4f1\uc7a5\uc778\ubb3c\uc758 \uba38\ub9ac \ubaa8\uc591\uacfc \ubcf5\uc7a5\uc5d0 \ub098\ud0c0\ub09c \ubbf8\uc2dc\uc801 \uc870\ud615\uc131",
          "isCorrect": true,
          "rationale": "\ucd5c\uae30\ud604\uc758 \ube44\ud3c9\ubb38\uc740 \ud30c\ub780\uc0c9/\ud669\ud1a0\uc0c9\uc758 \uc0c9\ucc44 \ub300\ube44, \uc120\uc758 \ub450\uaed8\uc640 \ubc00\ub3c4, \uce90\ub9ad\ud130 \uc758\uc0c1/\ud5e4\uc5b4 \ub514\uc790\uc778 \ub4f1 \ud654\ud48d\uacfc visual \uc694\uc18c\uc5d0 \uc8fc\ubaa9\ud588\ub2e4."
        },
        {
          "text": "\uc18c\ub9ac\ub77c\ub294 \uccad\uac01\uc801 \uc694\uc18c\uc758 \ubd80\uc7ac\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud55c \uc11c\uccb4 \ubcc0\uc6a9\uacfc \ucef7 \uc5f0\ucd9c \uae30\ubc95",
          "isCorrect": false,
          "rationale": "\uc18c\ub9ac\uc758 \uc2dc\uac01\ud654 \ubc0f \uc11c\uccb4, \ucef7 \ubc30\uce58\ub294 \uae40\ud76c\uacbd\uc758 \ube44\ud3c9\ubb38\uc5d0\uc11c \ud575\uc2ec\uc801\uc73c\ub85c \ub2e4\ub8ec \ub0b4\uc6a9\uc774\ub2e4."
        },
        {
          "text": "\ub4f1\uc7a5\uc778\ubb3c\ub4e4\uc774 \ub0b4\uba74\ud654\ub41c \uc2dc\ub300\uc801\u00b7\uc0ac\ud68c\uc801 \ud3b8\uacac\uc744 \uae68\ub2ec\uc544\uac00\uba70 \uc131\uc7a5\ud558\ub294 \uc11c\uc0ac \uad6c\uc870",
          "isCorrect": false,
          "rationale": "\ud3b8\uacac \uadf9\ubcf5\uacfc \uc778\ubb3c\ub4e4\uc758 \ub0b4\uba74\uc801 \uc131\uc7a5\uc740 \uae40\ud76c\uacbd\uc758 \ube44\ud3c9\ubb38\uc5d0\uc11c \uc8fc\uc694\ud558\uac8c \uac15\uc870\ud55c \uc694\uc18c\uc774\ub2e4."
        },
        {
          "text": "\ubb34\ub300\ub77c\ub294 \uacf5\uac04\uc801 \ud55c\uacc4\ub97c \ub2e4\ucc44\ub85c\uc6b4 \uc8fc\ubcc0 \uc778\ubb3c\ub4e4\uc758 \uc785\uccb4\uc801 \uc11c\uc0ac\ub85c \uadf9\ubcf5\ud558\ub294 \ubc29\uc2dd",
          "isCorrect": false,
          "rationale": "\ubb34\ub300 \uacf5\uac04\uc758 \uc81c\ud55c\uc131\uc744 \uc778\ubb3c\ub4e4\uc758 \uc11c\uc0ac\uc801 \ud569\uc73c\ub85c \uadf9\ubcf5\ud558\ub294 \ubd84\uc11d\uc740 \uae40\ud76c\uacbd \ube44\ud3c9\ubb38\uc758 \ud575\uc2ec \ud56d\ubaa9\uc774\ub2e4."
        }
      ],
      "hint": "\ucd5c\uae30\ud604\uc758 \uae00\uc5d0\uc11c \ud30c\ub780\uc0c9\uacfc \ud669\ud1a0\uc0c9\uc758 \ub300\ube44, \uc120\uc758 \ub450\uaed8, \uc778\ubb3c\ub4e4\uc758 \ud5e4\uc5b4\uc2a4\ud0c0\uc77c \ubc0f \uc758\uc0c1 \uc5f0\ucd9c\uc744 \ub2e4\ub8ec \uc810\uc5d0 \uc8fc\ubaa9\ud558\uc138\uc694."
    },
    {
      "question": "\uad11\uace0 \"\uc5c4\ub9c8\uc758 \ube48\ubc29\"\uc744 \ube44\ud3c9\ud560 \ub54c '\ud615\uc2dd\uc758 \uce21\uba74'\uc5d0 \ud574\ub2f9\ud558\ub294 \ube44\ud3c9 \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ucd98\uae30 \ub538\uacfc \uc5c4\ub9c8 \uc0ac\uc774\uc5d0 \ubc8c\uc5b4\uc9c0\ub294 \uc18c\ud1b5 \ub2e8\uc808\uacfc \ubaa8\uc131\uc560\ub77c\ub294 \uc8fc\uc81c\ub97c \uc798 \uc804\ub2ec\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc8fc\uc81c\ub098 \uc804\ub2ec\ud558\ub294 \uba54\uc2dc\uc9c0\uc758 \ud0c0\ub2f9\uc131 \ubc0f \uc801\uc808\uc131\uc740 \ube44\ud3c9\uc758 \ub0b4\uc6a9 \uce21\uba74\uc5d0 \uc18d\ud55c\ub2e4."
        },
        {
          "text": "\uc5f4\uc77c\uacf1 \uc18c\ub140\uac00 \ub300\ud559\uc0dd \ubc0f \uc9c1\uc7a5\uc778\uc774 \ub418\uc5b4 \uc9d1\uc744 \ub5a0\ub098\ub294 \ud604\uc2e4\uc801 \uc0b6\uc758 \uacfc\uc815\uc744 \ubcf4\uc5ec \uc900\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\ubb3c\uc758 \uc77c\uc0c1\uc801 \uc131\uc7a5 \uacfc\uc815 \ubc0f \ub0b4\uc6a9\uc801 \uc904\uac70\ub9ac\ub294 \ube44\ud3c9\uc758 \ub0b4\uc6a9 \uce21\uba74 \ud56d\ubaa9\uc774\ub2e4."
        },
        {
          "text": "\uacf5\uac04\uc801 \ubc30\uacbd\uc744 \uace0\uc815\ud55c \ucc44 \ub2eb\ud78c \ubc29\ubb38\uc744 \uc0ac\uc774\uc5d0 \ub454 \uc778\ubb3c\uc758 \ubcc0\ud654\ub9cc\uc744 \ubcf4\uc5ec \uc8fc\ub294 \uc5f0\ucd9c\uc744 \ud65c\uc6a9\ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\uace0\uc815\ub41c \uacf5\uac04 \ubc30\uacbd\uacfc \ud504\ub808\uc784 \uc5f0\ucd9c \ub4f1 \ud45c\ud604 \ubc29\ubc95\uc758 \ud6a8\uacfc\ub97c \ubd84\uc11d\ud55c \uac83\uc740 \ud615\uc2dd \uce21\uba74\uc758 \ube44\ud3c9\uc774\ub2e4."
        },
        {
          "text": "\uc790\uc2dd\uc744 \ud5a5\ud574 \ube44\uc6b8 \uc218 \uc5c6\ub294 \ubc29\uc744 \ud488\uace0 \uc788\ub294 \uc5c4\ub9c8\uc758 \uae4a\uc740 \uc0ac\ub791\uacfc \uc2ac\ud514\uc744 \ub2f4\uc544\ub0b4\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc791\ud488\uc774 \uac10\uc0c1\uc790\uc5d0\uac8c \uc804\ub2ec\ud558\ub294 \uac10\uc815\uc801 \uba54\uc2dc\uc9c0\uc640 \ub0b4\ub7ec\ud2f0\ube0c\ub294 \ub0b4\uc6a9 \uce21\uba74\uc5d0\uc11c \ub2e4\ub904\uc9c4\ub2e4."
        }
      ],
      "hint": "\uad11\uace0\uc758 \uba54\uc138\uc9c0(\ub0b4\uc6a9)\uac00 \uc544\ub2c8\ub77c \uae30\ubc95, \ubc30\uacbd, \uce74\uba54\ub77c \uc5f0\ucd9c \ub4f1 \ud45c\ud604 \ubc29\uc2dd(\ud615\uc2dd)\uc5d0 \uc911\uc810\uc744 \ub454 \uc120\ud0dd\uc9c0\ub97c \ucc3e\uc73c\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \ube44\ud3c9\ubb38 \"\uacb9\uacb9\uc758 \ud55c\uacc4\ub4e4\ub85c \uc99d\uba85\ud55c \ubb34\ud55c\ud568\"\uc758 \uacb0\ub860\uc5d0\uc11c \uac15\uc870\ud55c \uad00\uc810\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\ub294 \uc778\ubb3c\ub4e4\uc758 \uc0b6\uacfc \ub9e4\uccb4\uc801 \ud55c\uacc4\uc5d0 \ubd80\ub52a\ud788\uba70 \uc774\ub97c \ub118\uc5b4\uc11c\ub824\ub294 '\uc5f4\ub9dd'\uc73c\ub85c \uc6f9\ud230\uc758 \ubb34\ud55c\ud568\uc744 \uc99d\uba85\ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc778\ubb3c\ub4e4\uc774 \ubd80\ub52a\ud788\ub294 \uacb9\uacb9\uc758 \ud55c\uacc4\uc640 \uc6f9\ud230 \ub9e4\uccb4\uc758 \ud55c\uacc4\ub97c \ubaa8\ub450 \uadf9\ubcf5\ud558\ub824\ub294 \uc5f4\ub9dd\uc774 \uc791\ud488 \uc804\uccb4\ub97c \uc774\ub04c\uc5b4\uac10\uc744 \uac15\uc870\ud55c\ub2e4."
        },
        {
          "text": "\uc6f9\ud230\uc740 \uc18c\ub9ac\uc640 \ubb34\ub300\ub97c \uc9c1\uc811 \uc804\ub2ec\ud560 \uc218 \uc5c6\ub294 \ud0dc\uc0dd\uc801 \ud55c\uacc4 \ub54c\ubb38\uc5d0 \uc644\uc131\ub3c4 \ub192\uc740 \uc608\uc220\uc774 \ub418\uae30 \uc5b4\ub835\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae00\uc4f4\uc774\ub294 \uc6f9\ud230\uc758 \ud0dc\uc0dd\uc801 \ud55c\uacc4\uac00 \uc5f0\ucd9c\uacfc \ud45c\ud604 \uae30\ubc95\uc744 \ud1b5\ud574 \uc624\ud788\ub824 \uadf9\ubcf5\ub418\uace0 \ubb34\ud55c\ud568\uc774 \uc99d\uba85\ub41c\ub2e4\uace0 \ud3c9\uac00\ud55c\ub2e4."
        },
        {
          "text": "\ub300\uc911\uc801 \ud765\ud589\uc744 \uc704\ud574\uc11c\ub294 \ub0af\uc120 \uc804\ud1b5 \uc7a5\ub974\ubcf4\ub2e4\ub294 \uccad\uc18c\ub144 \ub3c5\uc790\uce35\uc5d0 \uce5c\uc219\ud55c \ud604\ub300\uc801 \uc81c\uc7ac\ub97c \uc120\ud0dd\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae00\uc4f4\uc774\ub294 \ub0af\uc120 \uc5ec\uc131 \uad6d\uadf9\uc744 \uc120\ud0dd\ud588\uc74c\uc5d0\ub3c4 \uc774\ub97c \ub6f0\uc5b4\ub098\uac8c \uc2dc\uac01\ud654\ud558\uc5ec \ud55c\uacc4\ub97c \ub118\uc5b4\uc130\uc74c\uc744 \uae0d\uc815\uc801\uc73c\ub85c \ud3c9\uac00\ud55c\ub2e4."
        },
        {
