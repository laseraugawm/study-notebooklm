    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \uc81c\ub3c4\uac00 \uc9c0\ub2cc \ub300\ud45c\uc801\uc778 '\uae0d\uc815\uc801 \uce21\uba74(\uc21c\uae30\ub2a5)' \ub450 \uac00\uc9c0\ub97c \uaf3d\uc73c\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uc18c\ube44\uc790\uc758 \ud569\ub9ac\uc801 \uc120\ud0dd\uc744 \ub3d5\ub294 \uae38\uc7a1\uc774 \uc5ed\ud560, 2) \uc11c\ube44\uc2a4 \uac1c\uc120 \ubc0f \ub9c8\ucf00\ud305 \uc804\ub7b5 \uc218\ub9bd\uc5d0 \uae30\uc5ec"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \uc81c\ub3c4\uac00 \uc720\ubc1c\ud558\ub294 \ub300\ud45c\uc801\uc778 '\ubd80\uc791\uc6a9(\uc5ed\uae30\ub2a5)' \ub450 \uac00\uc9c0\ub97c \uaf3d\uc73c\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \ud5c8\uc704\u00b7\uac10\uc815\uc801 \ubcc4\uc810\uc73c\ub85c \uc778\ud55c \uc790\uc601\uc5c5\uc790 \ud53c\ud574, 2) \uc591\uadf9\ud654 \ubd84\ud3ec(M\uc790\ud615)\uc5d0 \ub530\ub978 \uc18c\ube44\uc790 \uc624\uc778 \ubc0f \uc624\uc120\ud0dd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \uc81c\ub3c4\uc758 \ubb38\uc81c\uc810\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574 \uae30\uc220\uc801\u00b7\uc81c\ub3c4\uc801 \ubcf4\uc644\ucc45\uacfc \ud568\uaed8 \ubc18\ub4dc\uc2dc \ubcd1\ud589\ub418\uc5b4\uc57c \ud558\ub294 \uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc6a9\uc790\ub4e4\uc758 \uc778\uc2dd \uac1c\uc120\uacfc \uc9c4\uc194\ud55c \ud3c9\uac00 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9\uc744 \ud1b5\ud574 \ubaa8\ub460\uc6d0\uc774 \uc0ac\ud68c\uc801 \ubb38\uc81c\ub97c \uacf5\uc720\ud55c \ub4a4 \ucd5c\uc885\uc801\uc73c\ub85c \uc2e4\ucc9c\ud558\ub294 \ud65c\ub3d9 \uc608\uc2dc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ub4dc \ub274\uc2a4\ub97c \uc81c\uc791\ud558\uc5ec \uc0ac\ud68c \uad00\uacc4\ub9dd \uc11c\ube44\uc2a4(SNS)\uc5d0 \uc62c\ub9ac\ub294 \ucea0\ud398\uc778 \ud65c\ub3d9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70 \uc18c\uc218 \uc9d1\ub2e8\uc774 \uc815\ubcf4\ub97c \ub3c5\uc810\ud558\ub358 \uc2dc\ub300\uc640 \ube44\uad50\ud560 \ub54c, \ud604\ub300 \uc9d1\ub2e8 \uc9c0\uc131 \ud615\uc131 \ud658\uacbd\uc758 \ucc28\uc774\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \uc0dd\uc0b0\u00b7\uc720\ud1b5 \uc7a5\ubcbd\uc774 \ub0ae\uc544\uc838 \uc77c\ubc18\uc778\ub3c4 \ub204\uad6c\ub098 \uc790\uc2e0\uc758 \uc77c\uc0c1\uc774\ub098 \uc815\ubcf4\ub97c \uacf5\uc720\ud560 \uc218 \uc788\uac8c \ub418\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \ud3c9\uac00\uc5d0\uc11c \ud3c9\uac00\uc790 \uc790\uaca9 \uc870\uac74\uc744 \uba85\ud655\ud788 \ud558\ub294 \uc81c\ub3c4\ub97c \ub3c4\uc785\ud560 \ub54c \uc5bb\uc744 \uc218 \uc788\ub294 \uc774\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ubd84\ubcc4\ud55c \uc545\uc758\uc801 \ud3c9\uac00 \ud589\uc704\ub97c \uc0ac\uc804\uc5d0 \ub9c9\uc744 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9\uc758 3\ub2e8\uacc4 \ud750\ub984\uc744 '\ubb38\uc81c \uc778\uc2dd - \uacf5\uc720 - \ud574\uacb0' \uad00\uc810\uc5d0\uc11c \uc791\uc131\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \ub3c5\uc11c\ub97c \ud1b5\ud55c \uc0ac\ud68c \ubb38\uc81c \uc778\uc2dd, 2) \ubaa8\ub460\uc6d0\uacfc \ucd94\uac00 \uc790\ub8cc \uacf5\uc720 \ubc0f \uc758\uacac \uad50\ud658, 3) \ucea0\ud398\uc778(\uce74\ub4dc\ub274\uc2a4 \ub4f1)\uc744 \ud1b5\ud55c \ubb38\uc81c \ud574\uacb0 \ubc29\uc548 \uc2e4\ucc9c"
          }
        ]
      }
    }
  ]
}