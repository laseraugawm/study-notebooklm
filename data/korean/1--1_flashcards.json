{
  "title": "\ubcc4\uc810\ub3c5\uc11c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc11c\ub97c \ud1b5\ud574 \uc5bb\uc740 \uc9c0\uc2dd\uc774\ub098 \uc815\ubcf4\ub97c \ub3c5\uc11c \ubaa8\uc784 \ub4f1\uc744 \ud1b5\ud574 \ub2e4\ub978 \uc0ac\ub78c\uacfc \uacf5\uc720\ud558\uace0 \uad50\ub958\ud558\ub294 \ub3c5\uc11c \ubc29\uc2dd\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9\uc5d0 \ucc38\uc5ec\ud568\uc73c\ub85c\uc368 \ud0c0\uc778\uc5d0 \ub300\ud574 \uc774\ud574\ud560 \uc218 \uc788\ub294 \ud575\uc2ec \uc694\uc18c \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc591\ud55c \uc0b6\uc758 \ubc29\uc2dd, \uac00\uce58\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9\uc774 '\ub3c5\uc790 \uac1c\uc778'\uc758 \ucc28\uc6d0\uc5d0\uc11c \uac00\uc838\ub2e4\uc8fc\ub294 \ub450 \uac00\uc9c0 \uae0d\uc815\uc801 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \ubb38\uc81c\ub97c \uc778\uc2dd\ud558\uac8c \ub418\uace0, \ud0c0\uc778\uc5d0 \ub300\ud55c \uc774\ud574\uc758 \ud3ed\uc744 \ub113\ud790 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9\uc774 '\uc0ac\ud68c\uc801' \ucc28\uc6d0\uc5d0\uc11c \ubb38\uc81c \ud574\uacb0\uc744 \uc774\ub04c\uc5b4\ub0b4\ub294 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc591\ud55c \uad6c\uc131\uc6d0\ub4e4\uacfc \uc5f0\ub300\ud558\uace0 \ud611\ub825\ud558\uc5ec \uc0ac\ud68c\uc801 \ubb38\uc81c\uc758 \ud574\uacb0 \ubc29\uc548\uc744 \ub9c8\ub828\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ub7ec \uc0ac\ub78c\uc774 \uc11c\ub85c \ud611\ub825\ud558\uac70\ub098 \uacbd\uc7c1\ud558\ub294 \uacfc\uc815\uc744 \ud1b5\ud574 \uc5bb\uac8c \ub41c \uc9d1\ub2e8\uc758 \uc9c0\uc801 \ub2a5\ub825\uc744 \ub73b\ud558\ub294 \uc6a9\uc5b4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9d1\ub2e8 \uc9c0\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\ub300 \uc0ac\ud68c\uc5d0\uc11c \ub204\uad6c\ub098 \uc9d1\ub2e8 \uc9c0\uc131 \ud615\uc131 \uacfc\uc815\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uac8c \ub41c \uac00\uc7a5 \uc911\uc694\ud55c \uc0ac\ud68c\u00b7\uae30\uc220\uc801 \ubc30\uacbd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4\uc758 \uc0dd\uc0b0\uacfc \uc720\ud1b5\uc758 \uc9c4\uc785 \uc7a5\ubcbd\uc774 \ub0ae\uc544\uc84c\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc218\uc758 \ucc38\uc5ec\uc790\uac00 \ub313\uae00\uacfc \uacf5\uc720\ub97c \ud1b5\ud574 \uc815\ubcf4\ub97c \uc218\uc815\ud558\uace0 \ubcf4\uc644\ud560 \ub54c \uc815\ubcf4\uac00 \uac16\ucd94\uac8c \ub418\ub294 \ud2b9\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1d\uad00\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9d1\ub2e8 \uc9c0\uc131\uc774\ub098 \uc9d1\ub2e8 \uc815\uc11c\uac00 \uc798\ubabb\ub41c \ubc29\ud5a5\uc73c\ub85c \ud615\uc131\ub418\ub3c4\ub85d \ub9cc\ub4dc\ub294 \ub450 \uac00\uc9c0 \uc8fc\ub41c \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc9dc \ub274\uc2a4, \ucd9c\ucc98 \uc5c6\ub294 \uc815\ubcf4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\ud488\uc774\ub098 \uc11c\ube44\uc2a4\uc5d0 \ub300\ud55c \ub300\uc911\uc758 \ub9cc\uc871\ub3c4\ub97c \ubcc4\uc758 \uac1c\uc218\ub85c \ud3c9\uac00\ud558\uc5ec \ud45c\ucd9c\ud558\ub294 \uc81c\ub3c4\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \uc81c\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790\uac00 \uc0c1\ud488 \uad6c\ub9e4\ub098 \uc11c\ube44\uc2a4 \uc774\uc6a9 \uc5ec\ubd80\ub97c \ud310\ub2e8\ud560 \ub54c \ubcc4\uc810 \uc81c\ub3c4\uac00 \ud574\uc8fc\ub294 \uc5ed\ud560\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\uc0ac \uacb0\uc815\uc744 \ub3d5\ub294 \uc2e4\uc6a9\uc801\uc778 \uae38\uc7a1\uc774 \uc5ed\ud560"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \uc81c\ub3c4\uac00 \ud310\ub9e4\uc790(\uae30\uc5c5/\uc790\uc601\uc5c5\uc790)\uc5d0\uac8c \uc81c\uacf5\ud558\ub294 \uc8fc\ub41c \uc720\uc6a9\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798\uc758 \ud310\ub9e4 \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \uadfc\uac70\uac00 \ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \uc81c\ub3c4\uac00 \uc18c\ube44\uc790 \uce21\uba74\uc5d0\uc11c \ubcf4\uc7a5\ud574 \uc8fc\ub294 \uad8c\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790\uc758 \uc54c\uad8c\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \uc81c\ub3c4\uc758 \uccab \ubc88\uc9f8 \ubb38\uc81c\uc810\uc73c\ub85c, \uc870\uc791\ub418\uac70\ub098 \uac10\uc815\uc801\uc73c\ub85c \ubd80\uc5ec\ub41c \ubcc4\uc810\uc774 \uac00\uc838\uc624\ub294 \ud3d0\ud574\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\ub7c9\ud55c \ud310\ub9e4\uc790\ub098 \uc774\uc6a9\uc790\uc5d0\uac8c \uacbd\uc81c\uc801\u00b7\uc815\uc2e0\uc801 \ud53c\ud574\ub97c \uc900\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uc0c1\uacf5\uc778\uc2dc\uc7a5\uc9c4\ud765\uacf5\ub2e8\uc758 2022\ub144 \uc870\uc0ac \uacb0\uacfc, \ubc30\ub2ec \ud50c\ub7ab\ud3fc \uc774\uc6a9 \uc18c\uc0c1\uacf5\uc778 \uc911 \ubcc4\uc810 \uad00\ub828 \ud53c\ud574 \uacbd\ud5d8\uc774 \uc788\ub2e4\uace0 \ub2f5\ud55c \ube44\uc728\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "78%"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "SNS \uc774\uc6a9\uc790 \uc911 \ucf58\ud150\uce20\ub97c \uc81c\uc791\ud558\ub294 1%\uc640 \uc804\ub2ec\ud558\ub294 9%\ub97c \uc81c\uc678\ud55c \ub098\uba38\uc9c0 90%\uc758 \uc774\uc6a9\uc790 \uc131\ud5a5\uc744 \uac00\ub9ac\ud0a4\ub294 \ub9d0\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\ubc1c \ub4a4\uc5d0\uc11c \ubc14\ub77c\ubcf4\ub294 \uc0ac\ub78c\ub4e4 (\uad00\ub9dd\uc790)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \ud3c9\uac00 \uacb0\uacfc\uac00 \uc804\uccb4 \uc774\uc6a9\uc790\uc758 \uac1d\uad00\uc801 \ud3c9\uac00\ub97c \ubc18\uc601\ud558\uc9c0 \ubabb\ud558\ub294 \ud1b5\uacc4\ud559\uc801 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \ucc38\uc5ec\uc790\uac00 \uc804\uccb4 \uc774\uc6a9\uc790\ub97c \ub300\ud45c\ud558\ub294 \ubb34\uc791\uc704 \ud45c\ubcf8\uc774 \uc544\ub2c8\ub77c \uc801\uadf9\uc801\uc778 10%\uc758 \uc758\uacac\uc77c \uc218 \uc788\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \uc81c\ub3c4\uc758 \uc138 \ubc88\uc9f8 \ubb38\uc81c\uc810\uc778 '\ud3c9\uade0 \ud3c9\uac00\uc810\uc218\uc758 \ucc29\uc2dc'\uac00 \uc720\ubc1c\ud558\ub294 \uacb0\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc6a9\uc790\ub85c \ud558\uc5ec\uae08 \uc81c\ud488\uc774\ub098 \uc11c\ube44\uc2a4\uc758 \ud488\uc9c8\uc5d0 \ub300\ud55c \uc798\ubabb\ub41c \ucd94\ub860\uc744 \uc774\ub04c\uc5b4 \ub0b8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ud3ec \uace1\uc120\uc774 \ud3c9\uade0\uac12\uc744 \uc911\uc559\uc73c\ub85c \ud558\uc5ec \uc88c\uc6b0 \ub300\uce6d\uc778 \uc885 \ubaa8\uc591\uc744 \uc774\ub8e8\ub294 \ud1b5\uacc4\uc801 \ubd84\ud3ec\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc0c1 \ubd84\ud3ec"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \ud3c9\uac00\uc5d0\uc11c '\uc815\uc0c1 \ubd84\ud3ec'\ub97c \ubcf4\uc77c \ub54c \uc774\uc6a9\uc790\ub4e4\uc758 \ud3c9\uac00 \uc810\uc218\ub294 \uc8fc\ub85c \uc5b4\ub514\uc5d0 \ubab0\ub824 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3c9\uc810\uc758 \uc911\uac04\uac12 \uadfc\ucc98 (\uc608: 3\uc810 \ubd80\uadfc)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \ud3c9\uac00\uc5d0\uc11c \uc774\uc6a9\uc790\ub4e4\uc758 \ud638\ubd88\ud638\uac00 \ub9e4\uc6b0 \ub69c\ub837\ud560 \ub54c \ub098\ud0c0\ub098\ub294 \ubd84\ud3ec \uace1\uc120\uc758 \ud615\ud0dc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5e0(M)\uc790\ud615 \ubd84\ud3ec \uace1\uc120"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810\uc758 'M\uc790\ud615 \ubd84\ud3ec'\uc5d0\uc11c \ud3c9\uac00 \uc810\uc218\uac00 \ubab0\ub9ac\ub294 \ub450 \uad6c\uac04\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uadf9\ub2e8\uc778 1\uc810\uacfc 5\uc810"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \ud3c9\uade0\uc774 3\uc810\uc774\ub77c\ub3c4 \uc2e4\uc81c \ubd84\ud3ec\uac00 M\uc790\ud615 \ubd84\ud3ec\uc77c \ub54c \uc18c\ube44\uc790\uac00 \ubc94\ud558\uac8c \ub418\ub294 \uc624\uc778\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud638\ubd88\ud638\uac00 \uadf9\ub2e8\uc801\uc73c\ub85c \uac08\ub9bc\uc5d0\ub3c4 \ub2e8\uc21c '\uc911\uac04 \uc815\ub3c4\uc758 \ud488\uc9c8'\uc774\ub77c\uace0 \ud310\ub2e8\ud558\uc5ec \uc798\ubabb\ub41c \uc120\ud0dd\uc744 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ub7ec \ubb38\uc81c\uc810\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \ubcc4\uc810 \uc81c\ub3c4\ub97c \uc644\uc804\ud788 \ud3d0\uc9c0\ud558\uae30 \uc5b4\ub824\uc6b4 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ubbf8 \uc6b0\ub9ac \uc0ac\ud68c\uc758 \ud55c \ubb38\ud654\ub85c \uae4a\uc774 \uc790\ub9ac \uc7a1\uc558\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadf9\uc18c\uc218\uc758 \ud5c8\uc704\u00b7\uadf9\ub2e8\uc801 \ud3c9\uac00\ub85c \uc804\uccb4 \ubcc4\uc810\uc774 \uc65c\uace1\ub418\ub294 \ud604\uc0c1\uc744 \ub9c9\uae30 \uc704\ud55c \uc870\uac74\uc801 \uc81c\uc548\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc38\uc5ec\ud558\ub294 \ud3c9\uac00\uc790\uc758 \uc218\uac00 \ud2b9\uc815 \uae30\uc900\uce58\ub97c \ub118\uc5b4\uc11c\ub294 \uacbd\uc6b0\uc5d0\ub9cc \ubcc4\uc810\uc744 \ud45c\uc2dc\ud558\uac8c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3c9\uac00 \uacb0\uacfc\ub97c \uc2e0\ub8b0\ud560 \uc218 \uc788\ub3c4\ub85d \ud50c\ub7ab\ud3fc\uc774 \uc2dc\uac01\ud654\ud558\uc5ec \ucd94\uac00 \uc81c\uacf5\ud574\uc57c \ud558\ub294 \uc815\ubcf4 \ub450 \uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\uc131\uc790\uc758 \uacfc\uac70 \ud3c9\uac00 \uc774\ub825, \ud574\ub2f9 \uc0c1\ud488/\uc11c\ube44\uc2a4 \uc774\uc6a9 \ud69f\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc545\uc131 \ubcc4\uc810\uc774\ub77c \ud558\ub354\ub77c\ub3c4 \ud3ec\ud138\uc774\ub098 \ud50c\ub7ab\ud3fc \uc0ac\uc5c5\uc790\uac00 \uc774\ub97c \ub9c8\uc74c\ub300\ub85c \uc0ad\uc81c\ud560 \uc218 \uc5c6\ub294 \ubc95\uc801 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\uc131\ub41c \ubcc4\uc810 \ud3c9\uac00\ub098 \ub9ac\ubdf0\uac00 \ubc95\ub839\uc0c1 '\uc800\uc791\ubb3c'\uc5d0 \ud574\ub2f9\ud558\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5c8\uc704\u00b7\uc545\uc131 \ud3c9\uac00\ub97c \uc790\ub3d9\uc73c\ub85c \ud544\ud130\ub9c1\ud558\uae30 \uc704\ud574 \ubcf4\uc644\ub418\uc5b4\uc57c \ud560 \uae30\uc220\uc801 \uc7a5\uce58\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub354 \uc815\uad50\ud558\uac8c \uac78\ub7ec\ub0b4\ub294 \uc81c\uc5b4 \uae30\uc220"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc545\uc758\uc801\uc778 \ud3c9\uac00\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ud3c9\uac00 \uc791\uc131\uc790\uc5d0\uac8c \uc124\uc815\ud574\uc57c \ud558\ub294 \uc81c\ub3c4\uc801 \uae30\uc900\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3c9\uac00\ub97c \uc791\uc131\ud560 \uc218 \uc788\ub294 \uc790\uaca9 \uc870\uac74\uc744 \ub354 \uba85\ud655\ud558\uac8c \uaddc\uc815\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc4\uc810 \uc81c\ub3c4\uc758 \ubb38\uc81c\uc810\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574 \uae30\uc220\uacfc \uc81c\ub3c4\uc758 \ub9c8\ub828 \uc678\uc5d0 '\uc774\uc6a9\uc790'\uc5d0\uac8c \ud544\uc694\ud55c \uadfc\ubcf8\uc801 \ud0dc\ub3c4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c4\uc194\ud55c \ud0dc\ub3c4\ub85c \ubcc4\uc810 \ud3c9\uac00\uc5d0 \ucc38\uc5ec\ud558\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc5b4\ub5a4 \uc77c\uc758 \uc5ec\ud30c\ub098 \uc601\ud5a5\uc774 \ucc28\ucc28 \ub2e4\ub978 \ub370\ub85c \ubbf8\uce58\ub294 \ud798'\uc744 \ub73b\ud558\ub294 \uc5b4\ud718\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uae09\ub825(\u6ce2\u53ca\u529b)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc815\ubcf4 \uc2dc\uc2a4\ud15c \ud658\uacbd\uc744 \uad6c\ucd95\u00b7\uac1c\ubc29\ud558\uc5ec \ub204\uad6c\ub098 \ubc29\ub300\ud55c \uc815\ubcf4\ub97c \uc27d\uac8c \ud65c\uc6a9\ud558\ub3c4\ub85d \uc81c\uacf5\ud558\ub294 \uae30\ubc18 \uc11c\ube44\uc2a4'\ub97c \ub73b\ud558\ub294 \uc6a9\uc5b4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud50c\ub7ab\ud3fc(platform)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc784\uc758 \ucd94\ucd9c\ubc95\uc5d0 \uc758\ud558\uc5ec \uc9d1\ub2e8\uc5d0\uc11c \ubf51\uc544\ub0b8 \ud45c\ubcf8'\uc744 \uac00\ub9ac\ud0a4\ub294 \ud1b5\uacc4\ud559 \uc6a9\uc5b4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc791\uc704 \ud45c\ubcf8"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc88b\uc74c\uacfc \uc88b\uc9c0 \uc54a\uc74c'\uc744 \uc758\ubbf8\ud558\ub294 \ud55c\uc790\uc5b4 \uc18d \ub73b\uc758 \uc5b4\ud718\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud638\ubd88\ud638(\u597d\u4e0d\u597d)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uae30\uacc4, \uc124\ube44, \ubc18\uc751 \ub530\uc704\uac00 \ubaa9\uc801\uc5d0 \uc54c\ub9de\uc740 \uc791\uc6a9\uc744 \ud558\ub3c4\ub85d \uc870\uc808\ud568'\uc744 \uc758\ubbf8\ud558\ub294 \uc5b4\ud718\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\uc5b4(\u5236\u5fa1)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ubbf8\uc9c0\uc640 \uc9e7\uc740 \ubb38\uad6c\ub97c \uc870\ud569\ud558\uc5ec \uce74\ub4dc \ud615\ud0dc\ub85c \uc815\ubcf4\ub97c \uc804\ub2ec\ud558\ub294 \uc2dc\uac01\uc801 \ub9e4\uccb4 \uc790\ub8cc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ub4dc \ub274\uc2a4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ub4dc \ub274\uc2a4\uac00 \ub2e4\ub978 \uc77c\ubc18 \uae00\uc5d0 \ube44\ud574 \uc815\ubcf4 \uc804\ub2ec\uc5d0\uc11c \ub192\uc740 \uc2dc\uac01\uc801 \ud6a8\uacfc\ub97c \uc5bb\ub294 \ud615\uc2dd\uc801 \ud2b9\uc9d5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \ud654\uba74\uc5d0 \uce74\ub4dc \ud55c \uc7a5\uc529 \uc81c\uc2dc\ub418\uc5b4 \uc2dc\uac01\uc801 \uc8fc\ubaa9\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ub4dc \ub274\uc2a4\ub97c \uc81c\uc791\ud558\ub294 4\ub2e8\uacc4 \uacfc\uc815 \uc911 \uac00\uc7a5 \uba3c\uc800 \uc218\ud589\ud574\uc57c \ud558\ub294 '1\ub2e8\uacc4'\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc81c\uc640 \ubaa9\uc801 \uc120\uc815\ud558\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ub4dc \ub274\uc2a4 \uc81c\uc791 \uacfc\uc815 \uc911 \uc8fc\uc81c \uc120\uc815 \uc9c1\ud6c4 \uc9c4\ud589\ud558\ub294 '2\ub2e8\uacc4' \uc791\uc5c5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc6a9\uc790\uc640 \ub9e4\uccb4 \ud2b9\uc131 \ubd84\uc11d\ud558\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ub4dc \ub274\uc2a4 \uc81c\uc791 3\ub2e8\uacc4\ub294 '\ub0b4\uc6a9 \ub9c8\ub828 \ubc0f \uad6c\uc131\ud558\uae30'\uc774\ub2e4. \uadf8\ub807\ub2e4\uba74 \ub9c8\uc9c0\ub9c9 '4\ub2e8\uacc4'\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ub4dc \ub274\uc2a4 \uc81c\uc791 \ubc0f \uacf5\uc720\ud558\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9 \ud6c4 \uac1c\uc778\uc774 \ud575\uc2ec \ub0b4\uc6a9\uc744 \uc815\ub9ac\ud558\uae30 \uc704\ud574 \uc791\uc131\ud558\ub294 \uae30\ub85d\ubb3c\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc11c \uc77c\uc9c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc11c \uc77c\uc9c0\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc8fc\uc694 \uae30\uc7ac \uc694\uc18c 4\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77d\uc740 \ub0a0\uc9dc/\uc81c\ubaa9, \ub0b4\uc6a9 \uc815\ub9ac(\ubb38\uc81c\uc810\u00b7\uac1c\uc120\ucc45), \uc778\uc0c1\uc801\uc778 \ubd80\ubd84\uacfc \uc774\uc720, \ub354 \uc54c\uace0 \uc2f6\uc740 \ub0b4\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc628\ub77c\uc778 \uacf5\uc720 \ubb38\uc11c\ub098 \ud50c\ub7ab\ud3fc\uc744 \ud65c\uc6a9\ud55c \uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9\uc758 \uc8fc\uc694 \uc7a5\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\ub460\uc6d0\uacfc \uc2e4\uc2dc\uac04\uc73c\ub85c \uc790\ub8cc \ubc0f \uc758\uacac\uc744 \uacf5\uc720\ud558\uace0 \ub313\uae00\ub85c \uc18c\ud1b5\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ubcc4\uc810 \uc81c\ub3c4, \uc9d1\ub2e8 \uc9c0\uc131\uc758 \ud798'\uc758 \uc800\uc790\uc778 \uae40\uc131\ud0dc\uc758 \uc8fc \uc5f0\uad6c \ubd84\uc57c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub514\uc5b4 \ud559\ubb38 (\ube45\ub370\uc774\ud130\u00b7\uc778\uacf5\uc9c0\ub2a5 \uae30\ubc18 \uc0ac\ud68c \ubb38\uc81c \ud574\uacb0 \uc5f0\uad6c)"
          }
        ]
