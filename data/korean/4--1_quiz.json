{
  "title": "\uad6d\uc5b4\uc0ac \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ub0b4\uc6a9 \uc911 \uad6d\uc5b4\uc758 \uc5ed\uc0ac\uc801 \uc2dc\ub300 \uad6c\ubd84\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n- \uace0\ub300 \uad6d\uc5b4(~\uace0\ub824 \uac74\uad6d \uc774\uc804)\n- \uc804\uae30 \uc911\uc138 \uad6d\uc5b4(10~14\uc138\uae30)\n- \ud6c4\uae30 \uc911\uc138 \uad6d\uc5b4(15~16\uc138\uae30)\n- \uadfc\ub300 \uad6d\uc5b4(17~19\uc138\uae30 \ub9d0)\n- \ud604\ub300 \uad6d\uc5b4(20\uc138\uae30~)",
      "answerOptions": [
        {
          "text": "\ud6c8\ubbfc\uc815\uc74c\uc774 \ucc3d\uc81c\ub418\uc5b4 \uad6d\uc5b4 \uc790\ub8cc\uac00 \ud48d\ubd80\ud574\uc9c4 15~16\uc138\uae30\ub294 \ud6c4\uae30 \uc911\uc138 \uad6d\uc5b4\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc81c\uc2dc\ub41c \uc2dc\ub300 \uad6c\ubd84\ud45c\uc5d0 \ub530\ub974\uba74 \ud6c8\ubbfc\uc815\uc74c\uc774 \ucc3d\uc81c\ub41c 15~16\uc138\uae30\ub294 \ud6c4\uae30 \uc911\uc138 \uad6d\uc5b4\ub85c \ubd84\ub958\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uace0\ub824 \uac74\uad6d \uc774\uc804\ubd80\ud130 14\uc138\uae30\uae4c\uc9c0\uc758 \uad6d\uc5b4\ub294 \ubaa8\ub450 \uace0\ub300 \uad6d\uc5b4\ub85c \ubd84\ub958\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uace0\ub824 \uac74\uad6d \uc774\uc804\uae4c\uc9c0\uac00 \uace0\ub300 \uad6d\uc5b4\uc774\uba70, \uace0\ub824 \uac74\uad6d \uc774\ud6c4\uc778 10~14\uc138\uae30\ub294 \uc804\uae30 \uc911\uc138 \uad6d\uc5b4\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc804\uae30 \uc911\uc138 \uad6d\uc5b4\uc640 \ud6c4\uae30 \uc911\uc138 \uad6d\uc5b4\ub97c \ub098\ub204\ub294 \uc8fc\uc694 \uad6c\ubcc4 \uae30\uc900\uc740 \uc870\uc120\uc758 \uac74\uad6d \ub144\ub3c4\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud6c4\uae30 \uc911\uc138 \uad6d\uc5b4\ub294 \uc870\uc120 \uac74\uad6d(1392\ub144)\uc774 \uc544\ub2c8\ub77c 15\uc138\uae30 \ud6c8\ubbfc\uc815\uc74c \ucc3d\uc81c\ub97c \uc911\uc2ec\uc73c\ub85c \uad6d\uc5b4 \uc790\ub8cc\uc758 \uc131\uaca9\uc774 \ub2ec\ub77c\uc9c0\ub294 \uc2dc\uae30\uc785\ub2c8\ub2e4."
        },
        {
          "text": "17\uc138\uae30\ubd80\ud130 19\uc138\uae30 \ub9d0\uae4c\uc9c0\uc758 \uad6d\uc5b4\ub294 \uc774\ubbf8 \ud604\ub300 \uad6d\uc5b4 \ub2e8\uacc4\uc5d0 \ub3c4\ub2ec\ud55c \uc2dc\uae30\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "17\uc138\uae30\ubd80\ud130 19\uc138\uae30 \ub9d0\uae4c\uc9c0\ub294 \uadfc\ub300 \uad6d\uc5b4\uc5d0 \ud574\ub2f9\ud558\uba70, \ud604\ub300 \uad6d\uc5b4\ub294 20\uc138\uae30 \uc774\ud6c4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud6c8\ubbfc\uc815\uc74c \ucc3d\uc81c \uc774\uc804\uc778 \uace0\ub824 \uc2dc\ub300\uc758 \uad6d\uc5b4\ub294 \uadfc\ub300 \uad6d\uc5b4\uc758 \uae30\ud2c0\uc744 \ub9c8\ub828\ud55c \uc2dc\uae30\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uace0\ub824 \uc2dc\ub300\uc758 \uad6d\uc5b4(10~14\uc138\uae30)\ub294 \uc804\uae30 \uc911\uc138 \uad6d\uc5b4\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud6c8\ubbfc\uc815\uc74c\uc774 \ucc3d\uc81c\ub41c 15~16\uc138\uae30\uac00 \uc5b4\ub290 \uc911\uc138 \uad6d\uc5b4 \ub2e8\uacc4\uc5d0 \ud574\ub2f9\ud558\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc911\uc138 \uad6d\uc5b4 \uc790\ub8cc '\uf4d4', '\ue588\ue1a7\ub178\ub2c8', '\ub3c4\ue8a7\uc2e4\uebe1', '\ue38a\ub9ac'\uc5d0 \uc4f0\uc600\uc73c\ub098 \ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c\ub294 \uc0ac\uc6a9\ub418\uc9c0 \uc54a\ub294 \uc790\uc74c\uc790 \ubc0f \ubaa8\uc74c\uc790\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "'\ue38a\ub9ac'\uc5d0 \uc4f0\uc778 '\u318d'(\uc544\ub798\uc544)\ub294 \ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c \ud615\ud0dc\ub97c \ubc14\uafb8\uc5b4 \uc790\uc74c\uc73c\ub85c \uae30\ub2a5\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "'\u318d'(\uc544\ub798\uc544)\ub294 \uc790\uc74c\uc790\uac00 \uc544\ub2c8\ub77c \ubaa8\uc74c\uc790\uc774\uba70, \ud604\ub300 \uad6d\uc5b4\uc758 \ubaa8\uc74c \ud45c\uae30 \uccb4\uacc4\uc5d0\uc11c\ub294 \uc18c\uba78\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "'\uf4d4'\uc5d0 \uc4f0\uc778 '\u3186'(\uc5ec\ub9b0\ud788\uc757)\uc740 \ud604\ub300 \uad6d\uc5b4 \ud45c\uae30\uc5d0\uc11c \uc0ac\ub77c\uc9c4 \uc790\uc74c\uc790\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "'\u3186'\uc740 \uc911\uc138 \uad6d\uc5b4\uc5d0 \uc4f0\uc774\ub2e4\uac00 \ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c \uc0ac\uc6a9\ub418\uc9c0 \uc54a\ub294 \uc0ac\ub77c\uc9c4 \uc790\uc74c\uc790\uac00 \ub9de\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "'\ue588\ue1a7\ub178\ub2c8'\uc5d0 \uc4f0\uc778 '\u318d'(\uc544\ub798\uc544)\ub294 \ud604\ub300 \uad6d\uc5b4 \uc790\ubaa8 \uccb4\uacc4\uc5d0 \uc874\uc7ac\ud558\uc9c0 \uc54a\ub294 \ubaa8\uc74c\uc790\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "'\u318d'\ub294 \ud604\ub300 \uad6d\uc5b4\uc758 \uc790\ubaa8 \uccb4\uacc4\uc5d0\uc11c \uc0ac\ub77c\uc9c4 \ubaa8\uc74c\uc790\uac00 \ub9de\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "'\ub3c4\ue8a7\uc2e4\uebe1'\uc5d0 \uc4f0\uc778 '\u3178'(\uc21c\uacbd\uc74c \ube44\uc74d)\uc740 \ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c \uc4f0\uc774\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "'\u3178'\uc740 \ud6c4\uae30 \uc911\uc138 \uad6d\uc5b4 \uc790\ub8cc\uc5d0 \ub098\ud0c0\ub098\uc9c0\ub9cc \ud604\ub300 \uad6d\uc5b4 \ud45c\uae30\uc5d0\uc11c\ub294 \uc0ac\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc885\uc131\uc758 '\u3147' \uc18c\ub9ac\ub97c \ud45c\uae30\ud558\ub358 '\u3181'(\uc61b\uc774\uc751)\uc740 \uc774\ud6c4 '\u3147' \uc790\ub85c \ud1b5\ud569\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc61b\uc774\uc751(\u3181)\uc740 \ucc3d\uc81c \uc774\ud6c4 '\u3147' \uc790\uc640 \ud63c\uc6a9\ub418\ub2e4\uac00 \ud55c\uae00 \ub9de\ucda4\ubc95 \ud1b5\uc77c\uc548 \ubc1c\ud45c \uc774\ud6c4 \uc644\uc804\ud788 '\u3147' \uc790\ub85c \ud1b5\ud569\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0ac\ub77c\uc9c4 \ubb38\uc790 \uc911 '\u318d'\uac00 \uc790\uc74c\uc778\uc9c0 \ubaa8\uc74c\uc778\uc9c0 \uc131\uaca9\uc744 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc911\uc138 \uad6d\uc5b4 \ub2e8\uc5b4 '\ue6d7\ub4e4(\ub73b\uc744)'\uacfc '\ue75d\uba54(\uc500\uc5d0)'\uc758 \uc5b4\ub450\uc5d0 \ub098\ud0c0\ub09c '\u36ee', '\u3144' \ud45c\uae30\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub2e8\uc5b4\uc758 \uccab\uba38\ub9ac\uc5d0 \ub458 \uc774\uc0c1\uc758 \uc790\uc74c\uc774 \uc5f0\uc18d\ud558\uc5ec \uc624\ub294 '\uc5b4\ub450 \uc790\uc74c\uad70'\uc774 \uc874\uc7ac\ud588\uc74c\uc744 \ubcf4\uc5ec \uc900\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc911\uc138 \uad6d\uc5b4\uc5d0\ub294 '\ue6da', '\ue789'\ucc98\ub7fc \ub2e8\uc5b4\uc758 \uccab\uba38\ub9ac\uc5d0 '\u3142'\uacc4 \uc790\uc74c\uad70(\u36ee, \u3144 \ub4f1)\uacfc \uac19\uc740 \ub458 \uc774\uc0c1\uc758 \uc790\uc74c\uc774 \uc62c \uc218 \uc788\uc5c8\uc73c\uba70 \uc774\ub97c \uc5b4\ub450 \uc790\uc74c\uad70\uc774\ub77c\uace0 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud604\ub300 \uad6d\uc5b4\uc758 \ub41c\uc18c\ub9ac \ud45c\uae30\uc778 '\u3138', '\u3146'\uacfc \uc74c\uc6b4\ub860\uc801\uc73c\ub85c \uc644\uc804\ud788 \ub3d9\uc77c\ud55c \ubc1c\uc74c \uccb4\uacc4\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5b4\ub450 \uc790\uc74c\uad70\uc740 \uc11c\ub85c \ub2e4\ub978 \uc790\uc74c\uc774 \uc5b4\ub450\uc5d0 \ubb34\ub9ac\ub97c \uc774\ub8e8\uc5b4 \ubc1c\uc74c\ub418\ub358 \uac83\uc73c\ub85c, \ud604\ub300 \uad6d\uc5b4\uc758 \ub2e8\uc21c \ub41c\uc18c\ub9ac\uc640\ub294 \ucc28\uc774\uac00 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubc1b\uce68\uc5d0 \ub458 \uc774\uc0c1\uc758 \uc790\uc74c\uc744 \uc801\uc5b4 \uc55e \uc18c\ub9ac\uc758 \ubc1b\uce68\uc744 \ubc1d\ud788\ub294 \ub04a\uc5b4\uc801\uae30 \ud45c\uae30 \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "'\u36ee', '\u3144'\uc740 \ubc1b\uce68\uc774 \uc544\ub2c8\ub77c \ub2e8\uc5b4 \uccab\uba38\ub9ac(\uc5b4\ub450)\uc5d0 \uc704\uce58\ud55c \uc790\uc74c\uad70 \ud45c\uae30\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud55c\uc790\uc5b4\uc758 \uc911\uad6d \ubc1c\uc74c\uc744 \uc815\ud655\ud558\uac8c \ubc18\uc601\ud558\uae30 \uc704\ud574 \ucc3d\uc81c\ub41c \ud2b9\uc218 \ubaa8\uc74c \ud45c\uae30\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5b4\ub450 \uc790\uc74c\uad70\uc740 \uc790\uc74c\uc758 \uc5f0\uc18d\uccb4\uc774\uba70 \ud55c\uc790\uc74c \ud45c\uae30\ub97c \uc704\ud55c \ubaa8\uc74c\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\uccb4\uc5b8 \ub4a4\uc5d0 \uacb0\ud569\ud558\ub294 \uc8fc\uaca9 \uc870\uc0ac\uc758 \ud615\ud0dc\uac00 \uc5b4\ub450\ub85c \uc774\ub3d9\ud558\uc5ec \ub098\ud0c0\ub09c \ubb38\ubc95 \ud604\uc0c1\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc870\uc0ac\uc758 \uc774\ub3d9\uc774 \uc544\ub2c8\ub77c \uc5b4\uac04\uc774\ub098 \uccb4\uc5b8 \uc790\uccb4\uc758 \uccab\uba38\ub9ac\uc5d0 \uc790\uc74c\uad70\uc774 \uc624\ub294 \ud45c\uae30\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub2e8\uc5b4 \uccab\uba38\ub9ac(\uc5b4\ub450)\uc5d0 \uc5ec\ub7ec \uc790\uc74c\uc774 \ubb34\ub9ac\ub97c \uc774\ub8e8\uc5b4 \uc624\ub294 \ud604\uc0c1\uc758 \uba85\uce6d\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "15\uc138\uae30 \uad6d\uc5b4\uc758 \uc131\uc870\uc640 \ubc29\uc810 \ud45c\uae30\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c\ub3c4 \uae00\uc790 \uc67c\ucabd\uc5d0 \uc810\uc744 \ucc0d\uc5b4 \uc131\uc870\ub97c \ud45c\uae30\ud558\ub294 \ubc29\uc2dd\uc774 \uadf8\ub300\ub85c \uc720\uc9c0\ub418\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "15\uc138\uae30 \uad6d\uc5b4\uc5d0\ub294 \uc18c\ub9ac\uc758 \ub192\ub0ae\uc774\uc778 \uc131\uc870\ub97c \ubc29\uc810\uc73c\ub85c \ud45c\uae30\ud588\uc73c\ub098, \ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c\ub294 \uc131\uc870\uc640 \ubc29\uc810\uc774 \ubaa8\ub450 \uc18c\uba78\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "15\uc138\uae30 \uad6d\uc5b4\ub294 \uc18c\ub9ac\uc758 \uace0\uc800(\ub192\ub0ae\uc774)\uc778 \uc131\uc870\ub97c \uc774\uc6a9\ud558\uc5ec \ub2e8\uc5b4\uc758 \ub73b\uc744 \uad6c\ubcc4\ud558\uae30\ub3c4 \ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "15\uc138\uae30 \uad6d\uc5b4\uc5d0\uc11c\ub294 \uc18c\ub9ac\uc758 \ub192\ub0ae\uc774(\uc131\uc870)\uac00 \ub2e8\uc5b4\uc758 \uc758\ubbf8\ub97c \uad6c\ubcc4\ud558\ub294 \uc74c\uc6b4\uc801 \uc5ed\ud560\uc744 \ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub0ae\uc740 \uc18c\ub9ac\uc778 '\ud3c9\uc131'\uc740 \uae00\uc790 \uc606\uc5d0 \uc810\uc744 \ucc0d\uc9c0 \uc54a\uace0 \ud45c\uae30\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud3c9\uc131\uc740 \uc810\uc744 \ucc0d\uc9c0 \uc54a\ub294 \uc18c\ub9ac\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub192\uc740 \uc18c\ub9ac\uc778 '\uac70\uc131'\uc740 \uae00\uc790 \uc67c\ucabd\uc5d0 \uc810 1\uac1c\ub97c \ucc0d\uc5b4 \ud45c\uae30\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac70\uc131\uc740 \uae00\uc790 \uc67c\ucabd\uc5d0 \uc810 1\uac1c\ub97c \ucc0d\uc5b4 \ub192\uc740 \uc18c\ub9ac\uc784\uc744 \ub098\ud0c0\ub0c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ucc98\uc74c\uc740 \ub0ae\uace0 \ub098\uc911\uc774 \ub192\uc740 \uc18c\ub9ac\uc778 '\uc0c1\uc131'\uc740 \uae00\uc790 \uc67c\ucabd\uc5d0 \uc810 2\uac1c\ub97c \ucc0d\uc5b4 \ud45c\uae30\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0c1\uc131\uc740 \uae00\uc790 \uc67c\ucabd\uc5d0 \uc810 2\uac1c\ub97c \ucc0d\uc5b4 \ud45c\uae30\ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubc29\uc810\uacfc \uc131\uc870\uac00 \ud604\ub300 \uad6d\uc5b4\uae4c\uc9c0 \uacc4\uc18d \uc720\uc9c0\ub418\uace0 \uc788\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc911\uc138 \uad6d\uc5b4 \ud45c\uae30 '\ub9d0\uebd4\ubbf8', '\ub178\ubbf8', '\ue6d7\ub4e4'\uc5d0 \uacf5\ud1b5\uc801\uc73c\ub85c \uc801\uc6a9\ub41c \ud45c\uae30\uc0c1\uc758 \ud2b9\uc9d5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc55e \ud615\ud0dc\uc18c\uc758 \ubc1b\uce68\uc744 \ub4a4 \ud615\ud0dc\uc18c \uccab\uba38\ub9ac\uc758 \ucd08\uc131\uc73c\ub85c \uc62e\uaca8 \uc801\ub294 '\uc774\uc5b4\uc801\uae30(\uc5f0\ucca0)' \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "'\ub9d0\uebd9+\uc774 $\\rightarrow$ \ub9d0\uebd4\ubbf8', '\ub188+\uc774 $\\rightarrow$ \ub178\ubbf8', '\ub73b+\uc744 $\\rightarrow$ \ue6d7\ub4e4'\uc740 \uc55e \uc18c\ub9ac\uc758 \ubc1b\uce68\uc744 \ub4a4 \uc18c\ub9ac\uc758 \uccab\uba38\ub9ac\ub85c \uc774\uc5b4 \uc801\uc740 \uc5f0\ucca0 \ud45c\uae30\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uac01 \ud615\ud0dc\uc18c\uc758 \ubcf8\ubaa8\uc591\uc744 \ubc1d\ud600 \uc801\ub294 \ud604\ub300 \uad6d\uc5b4\uc758 '\ub04a\uc5b4\uc801\uae30(\ubd84\ucca0)' \ubc29\uc2dd\uacfc \ub3d9\uc77c\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud615\ud0dc\uc18c\uc758 \uc6d0\ud615\uc744 \ubc1d\ud600 \uc801\ub294 \uac83\uc740 \ub04a\uc5b4\uc801\uae30(\ubd84\ucca0)\uc774\uba70, \uc911\uc138 \uad6d\uc5b4\uc758 \uc774 \ud45c\uae30\ub4e4\uc740 \uc18c\ub9ac \ub098\ub294 \ub300\ub85c \uc801\ub294 \uc774\uc5b4\uc801\uae30(\uc5f0\ucca0)\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub2e8\uc5b4\uc758 \ucd08\uc131\uc5d0 \ub450 \uac1c \uc774\uc0c1\uc758 \uc790\uc74c\uc744 \ub3d9\uc2dc\uc5d0 \uc801\ub294 '\uc5b4\ub450 \uc790\uc74c\uad70' \ud45c\uae30 \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc1b\uce68 \uc790\uc74c\uc774 \ub4a4 \uc870\uc0ac/\uc5b4\ubbf8\uc758 \ucd08\uc131\uc73c\ub85c \ub118\uc5b4\uac00\ub294 \uc5f0\ucca0 \ud45c\uae30\uc774\uba70, \uc5b4\ub450 \uc790\uc74c\uad70\uacfc\ub294 \uad6c\ubcc4\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc885\uc131\uc5d0 \uc62c \uc218 \uc788\ub294 \uc790\uc74c\uc744 8\uac1c\ub85c \uc81c\ud55c\ud558\uc5ec \uc801\ub294 '\ud314\uc885\uc131\ubc95'\uc5d0\ub9cc \ud574\ub2f9\ud558\ub294 \uaddc\uce59\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud314\uc885\uc131\ubc95\uc740 \ubc1b\uce68\uc5d0 \uc801\uc744 \uc218 \uc788\ub294 \uc790\uc74c\uc758 \uc885\ub958\ub97c \uc81c\ud55c\ud558\ub294 \uc6d0\uce59\uc774\uba70, \ubc1b\uce68\uc744 \ub4a4 \uc74c\uc808 \ucd08\uc131\uc73c\ub85c \ub118\uaca8 \uc801\ub294 \uac83\uc740 \uc774\uc5b4\uc801\uae30\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa8\uc74c\uc870\ud654\uc5d0 \ub530\ub77c \uc870\uc0ac\ub098 \uc5b4\ubbf8\uc758 \ud615\ud0dc\ub97c \ubcc0\ud615\ud558\uc9c0 \uc54a\uace0 \uc6d0\ud615\ub300\ub85c \uace0\uc815\ud55c \ud45c\uae30\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud615\ud0dc\uc18c\ub97c \uace0\uc815\ud558\uc9c0 \uc54a\uace0 \uc18c\ub9ac \ub098\ub294 \ub300\ub85c \ub118\uaca8 \uc801\uc740 \ud45c\uae30\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uccb4\uc5b8\uacfc \uc870\uc0ac\uac00 \uacb0\ud569\ud560 \ub54c \uc55e \uccb4\uc5b8\uc758 \ubc1b\uce68\uc774 \ub4a4 \uc870\uc0ac\uc758 \ucd08\uc131\uc73c\ub85c \uc62e\uaca8 \uc801\ud788\ub294 \ud45c\uae30\ubc95\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911\uc138 \uad6d\uc5b4\uc758 \ubc1b\uce68 \ud45c\uae30 \uaddc\uce59\uc778 '\ud314\uc885\uc131\ubc95'\uacfc \uad00\ub828\ub41c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud604\ub300 \uad6d\uc5b4\ub85c \uc624\uba74\uc11c \uc885\uc131\uc73c\ub85c \uc18c\ub9ac \ub098\ub294 \uc790\uc74c\uc758 \uac1c\uc218\uac00 \uc911\uc138 \uad6d\uc5b4\ubcf4\ub2e4 \ub298\uc5b4\ub098 9\uac1c\uac00 \ub418\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud604\ub300 \uad6d\uc5b4\ub85c \uc624\uba74\uc11c \uc885\uc131\uc73c\ub85c \uc18c\ub9ac \ub098\ub294 \uc790\uc74c\uc758 \uac1c\uc218\ub294 '\u3131, \u3134, \u3137, \u3139, \u3141, \u3142, \u3147'\uc758 7\uac1c\ub85c \uc904\uc5b4\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc911\uc138 \uad6d\uc5b4\uc5d0\uc11c\ub294 \uc885\uc131\uc73c\ub85c \ubc1c\uc74c\ub418\ub294 '\u3131, \u3134, \u3137, \u3139, \u3141, \u3142, \u3145, \u3181'\uc758 8\uac1c \uc790\uc74c\uc744 \ubc1b\uce68\uc73c\ub85c \uc801\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc911\uc138 \uad6d\uc5b4\uc5d0\ub294 \uc885\uc131 \ud45c\uae30\ub85c 8\uac1c \uc790\uc74c\ub9cc \uc0ac\uc6a9\ud558\ub294 \ud314\uc885\uc131\ubc95\uc774 \uc4f0\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "'\ue97d\ue576-'\uc758 \ubc1b\uce68 '\u314a'\uc774 '\ue97d\ue570\ub514'\uc5d0\uc11c '\u3145'\uc73c\ub85c \ubc14\ub00c\uc5b4 \ud45c\uae30\ub41c \uac83\uc740 \ud314\uc885\uc131\ubc95\uc774 \uc801\uc6a9\ub418\uc5c8\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "'\u314a'\uc740 8\uc885\uc131\uc5d0 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc73c\ubbc0\ub85c 8\uc790 \uc911 \ud558\ub098\uc778 '\u3145'\uc73c\ub85c \uad50\uccb4\ub418\uc5b4 \ud45c\uae30\ub41c \uac83\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\u300e\uc6a9\ube44\uc5b4\ucc9c\uac00\u300f\uc758 '\uae4a\uace0'\uc640 '\ub192\uace0'\ucc98\ub7fc \ubc1b\uce68 '\u314d'\uc774 '\u3142'\uc73c\ub85c \ubc14\ub00c\uc9c0 \uc54a\uace0 \uadf8\ub300\ub85c \uc801\ud78c \uc608\uc678\ub3c4 \uc874\uc7ac\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\ub8cc\uc5d0 \uc81c\uc2dc\ub41c \uac83\ucc98\ub7fc '\uae4a\uace0', '\ub192\uace0'\ub294 \ud314\uc885\uc131\ubc95\uc744 \ub530\ub974\uc9c0 \uc54a\uace0 '\u314d'\uc744 \uadf8\ub300\ub85c \ud45c\uae30\ud55c \uc0ac\ub840\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud314\uc885\uc131\ubc95\uc758 8\uac1c \uc790\uc74c \uc911 \ud558\ub098\uc778 '\u3181'(\uc61b\uc774\uc751)\uc740 \ub2f9\uc2dc \uc885\uc131\uc758 '\u3147' \uc18c\ub9ac\ub97c \ub098\ud0c0\ub0b4\ub358 \uae00\uc790\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc61b\uc774\uc751(\u3181)\uc740 \uc911\uc138 \uad6d\uc5b4\uc5d0\uc11c \uc885\uc131\uc758 '\u3147' \uc74c\uac00\ub97c \ud45c\uae30\ud558\ub358 \uc790\uc74c\uc790\uc600\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c \uc885\uc131(\ubc1b\uce68)\uc73c\ub85c \uc2e4\uc81c\ub85c \ubc1c\uc74c\ub418\ub294 \uc790\uc74c \uc18c\ub9ac\uc758 \uac1c\uc218(7\uc74c\uac00)\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911\uc138 \uad6d\uc5b4\uc758 \uc8fc\uaca9 \uc870\uc0ac \uc4f0\uc784\uc744 \ubd84\uc11d\ud55c \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?\n\n(\uac00) \ub098\ub78f \ub9d0\uebd4\ubbf8 / \ud558\ue288\ud788\n(\ub098) \uf4d4 \ubc30\n(\ub2e4) \ue668 \uc5c5\uac74\ub9c8\ue46e",
      "answerOptions": [
        {
          "text": "\ud604\ub300 \uad6d\uc5b4\uc640 \ub9c8\ucc2c\uac00\uc9c0\ub85c \uc911\uc138 \uad6d\uc5b4\uc5d0\uc11c\ub3c4 \ubaa8\uc74c \ub4a4\uc5d0\uc11c \uc8fc\uaca9 \uc870\uc0ac '\uac00'\uac00 \uac00\uc7a5 \ubcf4\ud3b8\uc801\uc73c\ub85c \uc4f0\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc911\uc138 \uad6d\uc5b4\uc5d0\ub294 \uc8fc\uaca9 \uc870\uc0ac '\uac00'\uac00 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc558\uc73c\uba70, \uccb4\uc5b8\uc758 \ud658\uacbd\uc5d0 \ub530\ub77c '\uc774', '\u3163', \uc601\ud615\ud0dc(\uac89\uc73c\ub85c \ub098\ud0c0\ub098\uc9c0 \uc54a\uc74c)\uac00 \uc0ac\uc6a9\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "(\uac00)\uc758 '\ub9d0\uebd4\ubbf8'\uc640 '\ud558\ue288\ud788'\ub294 \uccb4\uc5b8\uc774 \uc790\uc74c\uc73c\ub85c \ub05d\ub0ac\uc73c\ubbc0\ub85c \uc8fc\uaca9 \uc870\uc0ac '\uc774'\uac00 \uacb0\ud569\ud55c \uac83\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc74c\uc73c\ub85c \ub05d\ub09c \uccb4\uc5b8 '\ub9d0\uebd9'\uacfc '\ud558\ue288\u314e' \ub4a4\uc5d0 \uc8fc\uaca9 \uc870\uc0ac '\uc774'\uac00 \uacb0\ud569\ud558\uc5ec \ub098\ud0c0\ub09c \ud615\ud0dc\uc785\ub2c8\ub2e4."
        },
        {
          "text": "(\ub098)\uc758 '\ubc30'\ub294 '\u3163'\ub098 \ubc18\ubaa8\uc74c '\u3163[j]' \uc678\uc758 \ubaa8\uc74c\uc73c\ub85c \ub05d\ub09c \uccb4\uc5b8 '\ubc14' \ub4a4\uc5d0 \uc8fc\uaca9 \uc870\uc0ac '\u3163'\uac00 \uacb0\ud569\ud55c \ud615\ud0dc\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubaa8\uc74c '\u314f' \ub4a4\uc5d0 \uc8fc\uaca9 \uc870\uc0ac '\u3163'\uac00 \uacb0\ud569\ud558\uc5ec '\ubc30(\ubc14+\u3163)'\uac00 \ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "(\ub2e4)\uc758 '\ue668' \ub4a4\uc5d0\uc11c\ub294 '\u3163' \ubaa8\uc74c\uc73c\ub85c \ub05d\ub098 \uc8fc\uaca9 \uc870\uc0ac\uac00 \uac89\uc73c\ub85c \ub098\ud0c0\ub098\uc9c0 \uc54a\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "'\u3163' \ubaa8\uc74c\uc774\ub098 \ubc18\ubaa8\uc74c '\u3163[j]' \ub4a4\uc5d0\uc11c\ub294 \uc8fc\uaca9 \uc870\uc0ac\uac00 \ud615\ud0dc\uc0c1 \ub098\ud0c0\ub098\uc9c0 \uc54a\ub294 \uc601\ud615\ud0dc\ub85c \uc2e4\ud604\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc911\uc138 \uad6d\uc5b4\uc758 \uc8fc\uaca9 \uc870\uc0ac\ub294 \uccb4\uc5b8 \ub05d\uc18c\ub9ac\uc758 \uc790\uc74c/\ubaa8\uc74c \uc5ec\ubd80 \ubc0f \ubaa8\uc74c \uc885\ub958\uc5d0 \ub530\ub77c \uc11c\ub85c \ub2e4\ub978 \ud615\ud0dc\ub85c \uc2e4\ud604\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc911\uc138 \uad6d\uc5b4 \uc8fc\uaca9 \uc870\uc0ac\ub294 \uc55e \uccb4\uc5b8\uc758 \ub05d\uc18c\ub9ac \uc870\uac74\uc5d0 \ub530\ub77c '\uc774', '\u3163', \uc601\ud615\ud0dc\ub85c \uad50\uccb4\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc911\uc138 \uad6d\uc5b4 \uc2dc\uae30\uc5d0 \uc8fc\uaca9 \uc870\uc0ac '\uac00'\uac00 \uc874\uc7ac\ud588\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911\uc138 \uad6d\uc5b4\uc640 \ud604\ub300 \uad6d\uc5b4\uc758 \ub2e8\uc5b4 \ud615\ud0dc \ubc0f \ubb38\ubc95 \uc694\uc18c \ubcc0\ud654\ub97c \ube44\uad50\ud55c \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc911\uc138 \uad6d\uc5b4 '\ub3c4\ue8a7\uc2e4\uebe1'\uac00 \ud604\ub300 \uad6d\uc5b4 '\ub3c4\uc6b0\uc2dc\ubbc0\ub85c'\ub85c \ubcc0\ud55c \uac83\uc740 \uccb4\uc5b8\uc5d0 \uacb0\ud569\ud558\ub294 \uad00\ud615\uaca9 \uc870\uc0ac '\u3145'\uc774 \uc18c\uba78\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "'\ub3c4\ue8a7\uc2e4\uebe1 $\\rightarrow$ \ub3c4\uc6b0\uc2dc\ubbc0\ub85c'\uc758 \ubcc0\ud654\ub294 \uccb4\uc5b8\uacfc \uc870\uc0ac\uc758 \ubb38\uc81c\uac00 \uc544\ub2c8\ub77c \uc6a9\uc5b8 \ud65c\uc6a9\ud615 \uc5b4\uac04\uc5d0\uc11c\uc758 '\u3178' \ud45c\uae30 \ubc0f \ud615\ud0dc\uac00 '\ub3c4\uc6b0-'\ub85c \ubcc0\ud55c \ud604\uc0c1\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc911\uc138 \uad6d\uc5b4 '\ub2c8\ub974\uace0\uc838'\uac00 \ud604\ub300 \uad6d\uc5b4 '\uc774\ub974\uace0\uc790'\ub85c \ubcc0\ud55c \uac83\uc740 '\u3163' \ubaa8\uc74c \uc55e\uc5d0\uc11c \uc5b4\ub450\uc758 '\u3134'\uc774 \ud0c8\ub77d\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5b4\ub450\uc758 '\u3134'\uc774 '\u3163' \ubaa8\uc74c \uc55e\uc5d0\uc11c \ud0c8\ub77d\ud558\ub294 \ud604\uc0c1(\ub450\uc74c \ubc95\uce59)\uc5d0 \ub300\ud55c \uc62c\ubc14\ub978 \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc911\uc138 \uad6d\uc5b4 '\ud3b4\ub514'\uac00 \ud604\ub300 \uad6d\uc5b4 '\ud3b4\uc9c0'\ub85c \ubcc0\ud55c \uac83\uc740 '\u3163' \ubaa8\uc74c \uc55e\uc5d0\uc11c '\u3137'\uc774 '\u3148'\uc73c\ub85c \ubc14\ub010 \uad6c\uac1c\uc74c\ud654 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "'\u3137'\uc774 '\u3163' \ubaa8\uc74c \uc55e\uc5d0\uc11c '\u3148'\uc73c\ub85c \ubcc0\ud558\ub294 \uad6c\uac1c\uc74c\ud654 \ud604\uc0c1\uc744 \uc62c\ubc14\ub974\uac8c \uc124\uba85\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc911\uc138 \uad6d\uc5b4 '\uf537\ue288\ud788'\uac00 \ud604\ub300 \uad6d\uc5b4 '\ud558\ub298\uc774'\ub85c \ubcc0\ud55c \uac83\uc740 \uccb4\uc5b8 \ub05d\uc758 '\u314e' \uc18c\ub9ac\uac00 \uc18c\uba78\ud558\uc600\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc911\uc138 \uad6d\uc5b4 \u314e\uc885\uc131 \uccb4\uc5b8 \ub05d\uc758 '\u314e'\uc774 \ud604\ub300 \uad6d\uc5b4\ub85c \uc624\uba74\uc11c \uc0ac\ub77c\uc9c4 \ud615\ud0dc \ubcc0\ud654\ub97c \ub098\ud0c0\ub0c5\ub2c8\ub2e4."
        },
        {
          "text": "\uc911\uc138 \uad6d\uc5b4 '\ue75d\uba54(\ue770- + \uc6c0 + \uc5d0)'\uc5d0\uc11c \ud604\ub300 \uad6d\uc5b4 '\uc500\uc5d0(\uc4f0- + \u3141 + \uc5d0)'\ub85c\uc758 \ubcc0\ud654\ub294 \uba85\uc0ac\ud615 \uc5b4\ubbf8\uac00 '-\uc6c0'\uc5d0\uc11c '-\u3141/-\uc74c'\uc73c\ub85c \ubcc0\ud588\uc74c\uc744 \ubcf4\uc5ec \uc900\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc911\uc138 \uad6d\uc5b4\uc758 \uba85\uc0ac\ud615 \uc5b4\ubbf8 '-\uc6c0/-\uc634'\uc774 \ud604\ub300 \uad6d\uc5b4\uc758 '-\uc74c/-\u3141'\uc73c\ub85c \ubcc0\ud615\ub418\uc5c8\uc74c\uc744 \ubcf4\uc5ec \uc8fc\ub294 \uc801\uc808\ud55c \uc124\uba85\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "'\ub3c4\ue8a7\uc2e4\uebe1'\ub294 \uc6a9\uc5b8\uc758 \ud65c\uc6a9\ud615\uc778\uc9c0, \uccb4\uc5b8\uacfc \uc870\uc0ac\uc758 \uacb0\ud569\uc778\uc9c0 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911\uc138 \uad6d\uc5b4 \uc5b4\ud718\uac00 \ud604\ub300 \uad6d\uc5b4\ub85c \uc624\uba74\uc11c \uc77c\uc5b4\ub09c \uc758\ubbf8 \ubcc0\ud654\uc758 \uc720\ud615\uc744 \uc124\uba85\ud55c \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?\n\n- '\ub9d0\uebd9': (\uc911\uc138) \uc77c\ubc18\uc801\uc778 \ub9d0 $\\rightarrow$ (\ud604\ub300) \ub9d0\uc744 \ub192\uc774\uac70\ub098 \ub0ae\ucd94\uc5b4 \ubd80\ub974\ub294 \ub9d0\n- '\uc5b4\ub9ac\ub2e4': (\uc911\uc138) \uc5b4\ub9ac\uc11d\ub2e4 $\\rightarrow$ (\ud604\ub300) \ub098\uc774\uac00 \uc5b4\ub9ac\ub2e4\n- '\ub188': (\uc911\uc138) \uc77c\ubc18\uc801\uc778 \uc0ac\ub78c $\\rightarrow$ (\ud604\ub300) \ub0a8\uc790\ub97c \ube44\ud558\ud558\ub294 \ub9d0\n- '\ud558\ub2e4': (\uc911\uc138) \ub9ce\ub2e4 $\rightarrow$ (\ud604\ub300) \ud589\ub3d9\uc744 \ud558\ub2e4\n- '\uc5b4\uc5ff\ube0c\ub2e4': (\uc911\uc138) \ubd88\uc30d\ud558\ub2e4 $\rightarrow$ (\ud604\ub300) \uc608\uc058\ub2e4",
      "answerOptions": [
        {
          "text": "'\ub9d0\uebd9'\uacfc '\ub188'\uc740 \uac00\ub9ac\ud0a4\ub294 \ub300\uc0c1\uc758 \ubc94\uc704\uac00 \uc904\uc5b4\ub4e0 '\uc758\ubbf8 \ucd95\uc18c' \uc0ac\ub840\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "'\ub9d0\uebd9'\uc740 \uc77c\ubc18 \ub9d0\uc5d0\uc11c \ub192\uc784/\ub0ae\ucda4\ub9d0\ub85c, '\ub188'\uc740 \uc77c\ubc18 \uc0ac\ub78c\uc5d0\uc11c \ub0a8\uc790\ub97c \ube44\ud558\ud558\ub294 \ub9d0\ub85c \uc801\uc6a9 \ub300\uc0c1\uc758 \ubc94\uc704\uac00 \uc904\uc5b4\ub4e0 \uc758\ubbf8 \ucd95\uc18c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "'\uc5b4\ub9ac\ub2e4'\uc640 '\uc5b4\uc5ff\ube0c\ub2e4'\ub294 \ub2e8\uc5b4\uc758 \ub73b\uc774 \ud655\uc7a5\ub41c '\uc758\ubbf8 \ud655\ub300' \uc0ac\ub840\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "'\uc5b4\ub9ac\uc11d\ub2e4 $\\rightarrow$ \ub098\uc774\uac00 \uc5b4\ub9ac\ub2e4', '\ubd88\uc30d\ud558\ub2e4 $\rightarrow$ \uc608\uc058\ub2e4'\ub294 \uc758\ubbf8\uac00 \uc804\ud600 \ub2e4\ub978 \ub73b\uc73c\ub85c \uc774\ub3d9\ud55c '\uc758\ubbf8 \uc774\ub3d9' \uc0ac\ub840\uc785\ub2c8\ub2e4."
