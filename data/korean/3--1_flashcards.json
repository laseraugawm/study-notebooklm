          {
            "type": "text",
            "content": "\uc2dc\uc124 \uccad\uc18c \ubd84\ub2f4\uc5d0 \ub300\ud574 \uc131\ub9bd\ub41c \ucd5c\uc885 \ud569\uc758 \uc870\ud56d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ub300 \ubc0f \ubb34\ub300 \uc8fc\ubcc0 \uccad\uc18c\ub294 \uc5f0\uadf9 \ub3d9\uc544\ub9ac\uac00 \ub2f4\ub2f9\ud558\uace0, \uac1d\uc11d \ubc0f \ubb38\ud654 \uc13c\ud130 \uc8fc\ubcc0 \uccad\uc18c\ub294 \uc544\ud30c\ud2b8 \uce21\uc774 \ub2f4\ub2f9\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uc778 \ud559\uad50 \uc5f0\uadf9 \ud504\ub85c\uadf8\ub7a8 \uc9c0\uc6d0\uc5d0 \uad00\ud574 \uc131\ub9bd\ub41c \ucd5c\uc885 \ud569\uc758 \uc870\ud56d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uadf9 \ub3d9\uc544\ub9ac\ub294 \ub2f9\ubc88(2~3\uba85)\uc744 \uc815\ud574 \ud55c \ub2ec\uc5d0 \ub450 \ubc88 \uc5b4\ub974\uc2e0\ub4e4\uc758 \ub300\ubcf8 \uc791\uc131 \ubc0f \uc5f0\uae30 \uae30\ucd08 \ud6c8\ub828\uc744 \uc9c0\ub3c4\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc544\ub9ac \ub300\ud45c\uac00 \"\ucc45\uc784\uac10\uc744 \uac00\uc9c0\uace0 \uc624\ub298 \ub9d0\uc500\ub4dc\ub9b0 \ubd80\ubd84\uc774 \uc798 \uc774\ud589\ub418\ub3c4\ub85d \ub178\ub825\ud558\uaca0\uc2b5\ub2c8\ub2e4\"\ub77c\uace0 \ub9d0\ud55c \uc758\uc0ac\uc18c\ud1b5\uc801 \uc758\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc758 \ub9d0\uc774 \uc0ac\ud68c\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\ub825\uc744 \uc778\uc9c0\ud558\uace0, \ud569\uc758 \uc0ac\ud56d\uc5d0 \ub300\ud574 \ucc45\uc784\uac10 \uc788\uac8c \ub9d0\ud558\uba70 \uc0c1\ub300\uc758 \uc2e0\ub8b0\ub97c \uad6c\ucd95\ud558\uae30 \uc704\ud568\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1 \uacfc\uc815\uc5d0\uc11c \uac70\uc9d3\ub41c \ub0b4\uc6a9\uc774\ub098 \uc65c\uace1\ub41c \uc0ac\uc2e4\uc744 \ub9d0\ud558\uc9c0 \uc54a\uc544\uc57c \ud558\ub294 \uc6d0\uce59\uc758 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\ub8b0\uc5d0 \uae30\ubc18\ud55c \uc758\uc0ac\uc18c\ud1b5\uc744 \uc720\uc9c0\ud558\uace0 \ud0c0\ud611\uacfc \uc9c0\uc18d \uac00\ub2a5\ud55c \ud569\uc758 \ub3c4\ucd9c\uc744 \uac00\ub2a5\ud558\uac8c \ud558\uae30 \uc704\ud574\uc11c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1 \uc2dc \uc0c1\ub300\ubc29\uc758 \ucc98\uc9c0\uc640 \uc785\uc7a5\uc744 \uc774\ud574\ud558\uba70 \uc6b0\ud638\uc801\uc778 \uc790\uc138\ub85c \uc784\ud574\uc57c \ud558\ub294 \uacb0\uc815\uc801 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ub300\ubc29\uc758 \ud55c\uacc4\uc640 \uc694\uad6c\ub97c \uc874\uc911\ud574\uc57c \uc11c\ub85c \uc591\ubcf4\ud560 \uc218 \uc788\ub294 \uc811\uc810\uc744 \ucc3e\uace0 \uc0c1\ud638 \ub9cc\uc871\ud558\ub294 \ud569\uc758\uc5d0 \ub3c4\ub2ec\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1 \uc0c1\ud669\uc5d0\uc11c \uc77c\ubc29\uc801\uc778 \uc8fc\uc7a5\ub9cc \ud3bc\uce58\ub294 '\ud1a0\ub860'\uc774\ub098 '\ub17c\uc7c1'\uacfc \ud611\uc0c1\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc740 \uc2b9\ud328\ub97c \uac00\ub974\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc11c\ub85c\uc758 \uc785\uc7a5\uc744 \uc870\uc815\ud558\uace0 \uc591\ubcf4\ud558\uc5ec \uc591\uce21 \ubaa8\ub450\uac00 \ub9cc\uc871\ud558\ub294 \ub300\uc548\uc744 \ucc3e\ub294 \ud611\ub825\uc801 \uc758\uc0ac\uc18c\ud1b5\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc544\ub9ac \uce21\uc774 \uc774\ubc88 \ud611\uc0c1\uc5d0\uc11c \uc0c1\ub300(\uc8fc\ubbfc \uce21)\uc5d0\uac8c \uc694\uad6c\ud558\uc5ec \uc5bb\uc5b4\ub0b8 \ud575\uc2ec \uc774\uc775\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud559\uad50 \uc778\uadfc\uc758 \uc6b0\uc218\ud55c \uc18c\uadf9\uc7a5 \ubb34\ub300 \uc2dc\uc124\uc744 \uc815\uae30 \uacf5\uc5f0 \ubc0f \uc0ac\uc804 \uc5f0\uc2b5 \uc7a5\uc18c\ub85c \ub300\uc5ec\ubc1b\uc740 \uac83\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubbfc \uce21\uc774 \uc774\ubc88 \ud611\uc0c1\uc5d0\uc11c \ub3d9\uc544\ub9ac \uce21\uacfc\uc758 \ud0c0\ud611\uc744 \ud1b5\ud574 \uc5bb\uc5b4\ub0b8 \ud575\uc2ec \uc774\uc775 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc8fc\ubbfc\ub4e4\uc758 \uc5f0\uadf9 \uad00\ub78c \uae30\ud68c \ud655\ubcf4\n2. \uc9c8\uc11c \uc720\uc9c0 \ubc0f \ubb34\ub300 \uccad\uc18c \uc9c0\uc6d0\n3. \ub178\uc778 \ud559\uad50 \uc5b4\ub974\uc2e0 \uc5f0\uadf9 \ud65c\ub3d9 \uc815\uae30 \uc9c0\uc6d0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uadf9 \ub3d9\uc544\ub9ac \ub300\ud45c\uac00 \ud611\uc0c1 \uacfc\uc815\uc5d0\uc11c \ubcf4\uc778 \uae0d\uc815\uc801\uc778 \ub9d0\ud558\uae30 \ud0dc\ub3c4 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc8fc\ubbfc \uce21\uc758 \uad00\ub9ac\uc0c1 \uc81c\uc57d\uacfc \uc0ac\uc815\uc744 \uc801\uadf9\uc801\uc73c\ub85c \uacf5\uac10\ud558\uace0 \uc218\uc6a9\ud568.\n2. \uc0c1\ub300\uc758 \uc9c8\ubb38\uc5d0 \uba85\ud655\ud558\uace0 \uc815\uc911\ud558\uac8c \ucd94\uac00 \uc815\ubcf4\ub97c \uc81c\uacf5\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubbfc \ub300\ud45c\uac00 \ud611\uc0c1 \uacfc\uc815\uc5d0\uc11c \ubcf4\uc778 \uae0d\uc815\uc801\uc778 \ub9d0\ud558\uae30 \ud0dc\ub3c4 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ud559\uc0dd\ub4e4\uc758 \ud559\uc5c5 \uc0c1\ud669 \ubc0f \uace0\ucda9\uc5d0 \uce6d\ucc2c\uacfc \uc774\ud574\ub97c \ud45c\ud568.\n2. \uccad\uc18c \uad6c\uc5ed \ubc0f \uc9c0\uc6d0 \uc8fc\uae30 \ub4f1 \ud604\uc2e4\uc801 \uc5b4\ub824\uc6c0\uc744 \uace0\ub824\ud574 \uc694\uccad \uc0ac\ud56d\uc744 \uc870\uc815\ud574 \uc90c."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc5d0\uc11c \uc591\uce21\uc774 \ud0c0\ud611\uc548\uc744 \ub3c4\ucd9c\ud560 \ub54c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 'Give-and-Take(Give & Take)'\uc758 \uc6d0\ub9ac\ub294 \ubcf8\ubb38\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uad6c\ud604\ub418\uc5c8\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc544\ub9ac\ub294 \uc7a5\uc18c \ub300\uc5ec\ub97c \uc5bb\ub294 \ub300\uc2e0 \uc5b4\ub974\uc2e0 \uad50\uc721 \ubc0f \uccad\uc18c\ub97c \uc591\ubcf4\ud588\uace0, \uc8fc\ubbfc \uce21\uc740 \uc7a5\uc18c\ub97c \uc81c\uacf5\ud558\ub294 \ub300\uc2e0 \uad50\uc721 \uc9c0\uc6d0\uacfc \uccad\uc18c \ubd84\ub2f4\uc744 \uc5bb\uc5b4\ub0c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1 \uacb0\uacfc\uac00 '\ud568\uaed8 \ub9cc\uc871\ud558\ub294 \ud611\uc0c1'\uc774 \ub418\uc5c8\uc74c\uc744 \uc54c \uc218 \uc788\ub294 \ucd5c\uc885 \ud655\uc778 \ubb38\uad6c\uc758 \ud575\uc2ec \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uce21 \ubaa8\ub450 \uc790\uc2e0\uc758 \ubaa9\uc801\uc744 \uc774\ub8e8\uc5c8\uc73c\uba70, \uc0c1\ub300\ubc29\uc758 \ub3c4\uc6c0\uacfc \ud611\uc870\uc5d0 \uac10\uc0ac\ub97c \ud45c\ud558\uba70 \uc720\ucf8c\ud558\uac8c \ud611\uc0c1\uc744 \ub05d\ub9fa\uc740 \uc810\uc774\ub2e4."
          }
        ]
      }
    }
  ]
}