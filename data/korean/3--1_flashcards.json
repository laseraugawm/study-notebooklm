        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud559\uc0dd\ud68c\uc758 \ub3c4\uc6c0\uc744 \ubc1b\uc544 \uacf5\uc5f0\uc7a5 \uc8fc\ubcc0\uc5d0 \uc548\ub0b4 \uc694\uc6d0\uc744 \ubc30\uce58\ud558\uc5ec \uacf5\uc5f0 \uc548\ub0b4 \ubc0f \uc9c8\uc11c \uc720\uc9c0 \ud65c\ub3d9\uc744 \ud3bc\uce58\ub294 \uac83\uc774\ub2e4."
