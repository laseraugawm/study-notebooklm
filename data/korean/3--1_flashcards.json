{
  "title": "\ud611\uc0c1 \uce74\ub4dc\ub274\uc2a4",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc774\ub098 \uc9d1\ub2e8 \uc0ac\uc774\uc5d0\uc11c \uc774\uc775\uc774\ub098 \uc8fc\uc7a5\uc774 \ub2ec\ub77c \ubc1c\uc0dd\ud558\ub294 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc11c\ub85c \ud0c0\ud611\ud558\uace0 \uc870\uc815\ud558\uba74\uc11c \ud574\uacb0 \ubc29\ubc95\uc744 \ucc3e\uc544\uac00\ub294 \ud611\ub825\uc801 \uc758\uc0ac\uc18c\ud1b5\uc758 \ubc29\ubc95\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1(Negotiation)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc774 \ucd94\uad6c\ud558\ub294 \uad81\uadf9\uc801\uc778 \ubaa9\uc801\uacfc \uc758\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\ubcf4\uc640 \ud611\ub825\uc744 \ud1b5\ud574 \uc591\uce21 \ubaa8\ub450\uac00 \ub9cc\uc871\ud560 \ub9cc\ud55c \uacb0\uacfc\ub97c \uc5bb\uc5b4 \uac08\ub4f1\uc744 \ud574\uacb0\ud558\ub294 \uac83\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc758 \uc9c4\ud589 \uacfc\uc815\uc740 \ud06c\uac8c \uc5b4\ub5a4 3\ub2e8\uacc4\ub85c \uad6c\uc131\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc791 \ub2e8\uacc4, \uc870\uc815 \ub2e8\uacc4, \ud574\uacb0 \ub2e8\uacc4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc758 '\uc2dc\uc791 \ub2e8\uacc4'\uc5d0\uc11c \uc218\ud589\ud574\uc57c \ud558\ub294 \uc8fc\uc694 \ud65c\ub3d9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uce21\uc758 \uc785\uc7a5\uc744 \ud655\uc778\ud558\uace0, \uc785\uc7a5 \ucc28\uc774\uc758 \uc6d0\uc778\uc744 \ubd84\uc11d\ud558\uc5ec \ubb38\uc81c \ud574\uacb0\uc758 \ud544\uc694\uc131\uacfc \uac00\ub2a5\uc131\uc744 \ud655\uc778\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc758 '\uc870\uc815 \ub2e8\uacc4'\uc5d0\uc11c \uc218\ud589\ud574\uc57c \ud558\ub294 \uc8fc\uc694 \ud65c\ub3d9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ub300\uce21\uc758 \ucc98\uc9c0\uc640 \uad00\uc810\uc744 \ud30c\uc545\ud558\uace0, \uc81c\uc548\uc744 \uac80\ud1a0\ud558\uc5ec \uc785\uc7a5 \ucc28\uc774\ub97c \uc881\ud788\uba70, \uc591\ubcf4 \uac00\ub2a5\ud55c \uc9c0\uc810\uc744 \ucc3e\uc544 \ud569\uc758\ub97c \uc720\ub3c4\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc758 '\ud574\uacb0 \ub2e8\uacc4'\uc5d0\uc11c \uc218\ud589\ud574\uc57c \ud558\ub294 \uc8fc\uc694 \ud65c\ub3d9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\ud611\ud558\uace0 \uc870\uc815\ud558\uc5ec \ub0a8\uc740 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uace0, \ubaa8\ub450\uac00 \ub9cc\uc871\ud560 \uc218 \uc788\ub294 \ucd5c\uc120\uc758 \ub300\uc548\uc744 \ub9c8\ub828\ud558\uc5ec \ud569\uc758\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\uc0ac\uc18c\ud1b5 \uacfc\uc815\uc5d0\uc11c \uc790\uc2e0\uc758 \ub4e3\uace0 \ub9d0\ud558\ub294 \ud589\uc704\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \uc810\uac80\ud558\uace0 \ubb38\uc81c\uac00 \uc788\uc744 \uacbd\uc6b0 \uc801\uc808\ud788 \uc218\uc815\ud558\ub294 \uacfc\uc815\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\uc0ac\uc18c\ud1b5 \uacfc\uc815\uc758 \uc810\uac80\uacfc \uc870\uc815"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc744 \uc900\ube44\ud560 \ub54c '\uc591\ubcf4 \uac00\ub2a5\ud55c \ubc94\uc704'\ub97c \ubbf8\ub9ac \uc124\uc815\ud574 \ub450\uc5b4\uc57c \ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5bb\uace0\uc790 \ud558\ub294 \ubc14\uc640 \uc591\ubcf4\ud560 \uc218 \uc788\ub294 \ud55c\uacc4\ub97c \uba85\ud655\ud788 \ud574\uc57c \uc0c1\ub300\uce21\uc758 \uc694\uad6c\uc5d0 \uc801\uc808\ud55c \ub300\uc548\uc744 \ub9c8\ub828\ud558\uace0 \uc11c\ub85c \ub9cc\uc871\ud558\ub294 \uacb0\uacfc\ub97c \uc5bb\uc744 \uc218 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uadf9 \ub3d9\uc544\ub9ac\uac00 \ud559\uad50 \uc678\ubd80 \uc2dc\uc124\uc778 \uc544\ud30c\ud2b8 \uc8fc\ubbfc \ubb38\ud654 \uc13c\ud130 \uc18c\uadf9\uc7a5\uc744 \ube4c\ub9ac\uace0\uc790 \ud55c \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud559\uad50 \uac15\ub2f9 \uc9c0\ubd95 \uacf5\uc0ac\ub85c \uc778\ud574 \uc608\uc815\ub41c \uc815\uae30 \uacf5\uc5f0 \ubc0f \uc5f0\uc2b5\uc744 \uc9c4\ud589\ud560 \uc7a5\uc18c\uac00 \ub9c8\ub545\uce58 \uc54a\uc558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uadf9 \ub3d9\uc544\ub9ac \ub300\ud45c\uac00 \uc5ec\ub7ec \uc7a5\uc18c \uc911 \ub2e4\ube5b\uc544\ud30c\ud2b8 \ubb38\ud654 \uc13c\ud130 \uc18c\uadf9\uc7a5\uc744 \ucd5c\uc801\uc758 \uc7a5\uc18c\ub85c \uaf3d\uc740 \uc774\uc720 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ud559\uad50\uc640 \uc778\uc811\ud574 \uc788\ub2e4.\n2. \uc18c\uadf9\uc7a5 \ub0b4 \ubb34\ub300 \uc2dc\uc124\uc774 \uc798 \uac16\ucd94\uc5b4\uc838 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uadf9 \ub3d9\uc544\ub9ac \ub300\ud45c\uac00 \uc2dc\uc791 \ub2e8\uacc4\uc5d0\uc11c \ub300\uad00\uc744 \uc694\uccad\ud558\uba70 \uc81c\uc2dc\ud55c \ub17c\ub9ac\uc801 \uadfc\uac70(\uba85\ubd84)\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud559\uad50 \ud559\uc0dd\uc758 \uc808\ubc18\uac00\ub7c9\uc774 \ub2e4\ube5b\uc544\ud30c\ud2b8\uc5d0 \uac70\uc8fc\ud558\uace0 \uc788\ub2e4\ub294 \uc810\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubbfc \ub300\ud45c\uac00 \uc18c\uadf9\uc7a5 \uc678\ubd80 \ub300\uc5ec \uc694\uccad\uc5d0 \ub300\ud574 \ucc98\uc74c\uc5d0 \ub09c\uc0c9\uc744 \ud45c\ud55c \uc8fc\uc694 \uc774\uc720 2\uac00\uc9c0(\uc6b0\ub824 \uc0ac\ud56d)\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ub300\uc5ec \uc2dc \ucd94\uac00\uc801\uc778 \uad00\ub9ac \ube44\uc6a9\uc774 \ubc1c\uc0dd\ud55c\ub2e4.\n2. \uc544\ud30c\ud2b8 \uc8fc\ubbfc\ub4e4\uc758 \uc2dc\uc124 \uc774\uc6a9\uc5d0 \ubd88\ud3b8\ud568\uc774 \ub530\ub978\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubbfc \ub300\ud45c \ud68c\uc758\uc5d0\uc11c \uc18c\uadf9\uc7a5 \uc678\ubd80 \ub300\uc5ec \uc870\uac74\uc73c\ub85c \uc785\uc81c\uc2dc\ud55c \uae30\ubcf8 \uc785\uc7a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ud30c\ud2b8 \ub0b4 \uc2dc\uc124\uc744 \uc678\ubd80\uc5d0 \ub300\uc5ec\ud558\ub824\uba74 \uadf8\uc5d0 \uc0c1\uc751\ud558\ub294 \uc774\uc775\uc774\ub098 \ud61c\ud0dd\uc774 \uc8fc\uc5b4\uc838\uc57c \ud55c\ub2e4\ub294 \uac83\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc544\ub9ac \ub300\ud45c\uac00 1\ucc28 \uc870\uc815 \ub2e8\uacc4\uc5d0\uc11c \uc8fc\ubbfc\ub4e4\uc5d0\uac8c \uc81c\uacf5\ud558\uaca0\ub2e4\uace0 \ucc98\uc74c \uc81c\uc548\ud55c \ud61c\ud0dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\ube5b\uc544\ud30c\ud2b8 \uc8fc\ubbfc\ub4e4\ub3c4 \uc5f0\uadf9 \uacf5\uc5f0\uc744 \ubb34\ub8cc\ub85c \uad00\ub78c\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uaca0\ub2e4\ub294 \uc81c\uc548\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc544\ub9ac \uce21\uc758 '\uc8fc\ubbfc \uacf5\uc5f0 \uad00\ub78c \ud5c8\uc6a9' \uc81c\uc548\uc5d0 \ub300\ud574 \uc8fc\ubbfc \ub300\ud45c\uac00 \ubcf4\uc778 \ubc18\uc751\uc740 \uc5b4\ub5a0\ud588\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad00\ub78c \uc790\uccb4\ub294 \uae0d\uc815\uc801\uc774\uc9c0\ub9cc \uad00\ub9ac \ube44\uc6a9\uacfc \ubd88\ud3b8\uc744 \uac10\uc218\ud574\uc57c \ud558\ubbc0\ub85c '\ubcf4\ub2e4 \ub354 \uc2e4\uc9c8\uc801\uc778 \uc774\uc775'\uc774 \ud544\uc694\ud558\ub2e4\uace0 \uc694\uad6c\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubbfc \ub300\ud45c\uac00 \ub3d9\uc544\ub9ac \uce21\uc5d0 \uc694\uad6c\ud55c '\uc2e4\uc9c8\uc801\uc778 \uc774\uc775'\uc758 \uad6c\uccb4\uc801 \ub0b4\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\ud654 \uc13c\ud130 \ub178\uc778 \ud559\uad50\uc5d0\uc11c \uae30\ud68d \uc911\uc778 65\uc138 \uc774\uc0c1 \uc5b4\ub974\uc2e0 \ub300\uc0c1 \uc5f0\uadf9 \ud504\ub85c\uadf8\ub7a8 \uc9c4\ud589\uc744 \ub3c4\uc640 \ub2ec\ub77c\ub294 \uc694\uad6c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubbfc \uce21\uc758 \ub178\uc778 \ud559\uad50 \uc5f0\uadf9 \ud504\ub85c\uadf8\ub7a8 \uc9c0\uc6d0 \uc694\uad6c\uc5d0 \ub300\ud574 \ub3d9\uc544\ub9ac \ub300\ud45c\uac00 \ucc98\uc74c\uc5d0 \ub9dd\uc124\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud559\uc5c5\uacfc \ub3d9\uc544\ub9ac \ud65c\ub3d9\uc744 \ubcd1\ud589\ud558\uba74\uc11c \ucd94\uac00\ub85c \uc2dc\uac04\uc744 \ub0b4\ub294 \uac83\uc774 \uc6a9\uc774\ud558\uc9c0 \uc54a\uc558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub974\uc2e0 \uc5f0\uadf9 \ud504\ub85c\uadf8\ub7a8 \uc9c0\uc6d0 \uc694\uccad\uc5d0 \ub300\ud574 \uc5f0\uadf9 \ub3d9\uc544\ub9ac \ub300\ud45c\uac00 \uacb0\uad6d \uc591\ubcf4\ud558\uc5ec \uc218\uc6a9\ud55c \uacb0\uc815\uc801 \uacc4\uae30\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubbfc \ub300\ud45c\uac00 \ud559\uc0dd\ub4e4\uc758 \ud559\uc5c5 \ubd80\ub2f4 \ucc98\uc9c0\ub97c \uc774\ud574\ud574 \uc8fc\uc5c8\uace0, \uc5b4\ub824\uc6c0\uc744 \ubb34\ub985\uc4f0\uace0 \uc5b4\ub974\uc2e0 \uc5f0\uadf9 \ud65c\ub3d9\uc744 \uc9c0\uc6d0\ud558\uae30\ub85c \ud0c0\ud611\uc548\uc744 \uc218\uc6a9\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc544\ub9ac \ub300\ud45c\uac00 \uc694\uad6c\ud55c \ucd5c\ucd08\uc758 \uc5f0\uc2b5 \uae30\uac04\uacfc \uc2dc\uac04\ub300\ub294 \uc5b4\ub5bb\uac8c \ub418\uc5c8\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc5f0 \uc77c\uc8fc\uc77c \uc804\ubd80\ud130 \ub9e4\uc77c \uc624\ud6c4 4\uc2dc\ubd80\ud130 9\uc2dc\uae4c\uc9c0 \uc18c\uadf9\uc7a5\uc5d0\uc11c \uc5f0\uc2b5\ud558\uae30\ub97c \ud76c\ub9dd\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc544\ub9ac \uce21\uc758 '\uc624\ud6c4 4\uc2dc~9\uc2dc \uc5f0\uc2b5' \uc694\uad6c\uc5d0 \ub300\ud574 \uc8fc\ubbfc \ub300\ud45c\uac00 \uc81c\uc57d\uc744 \ub454 \uc2dc\uc124 \uad00\ub9ac\uc0c1\uc758 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubbfc \ubb38\ud654 \uc13c\ud130 \uad00\ub9ac \uc9c1\uc6d0\uc758 \ud1f4\uadfc \uc2dc\uac04\uc774 7\uc2dc(19\uc2dc)\uc774\uae30 \ub54c\ubb38\uc5d0 \uadf8 \uc774\ud6c4 \uc2dc\uc124 \uc0ac\uc6a9\uc774 \uace4\ub780\ud558\ub2e4\uace0 \uc124\uba85\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad00\ub9ac \uc9c1\uc6d0 \ud1f4\uadfc \uc2dc\uac04(19\uc2dc) \uc81c\uc57d\uc5d0 \ub300\ud574 \ub3d9\uc544\ub9ac \ub300\ud45c\uac00 \ubcf4\uc5ec\uc900 \ud0c0\ud611\uc801\uc778 \ud0dc\ub3c4\uc640 \ucd5c\uc885 \uc218\uc6a9 \ubc29\uc548\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "19\uc2dc \ub9c8\uac10 \uc0ac\uc815\uc744 \uc778\uc815\ud558\uace0 \ubc1b\uc544\ub4e4\uc774\ub418, \uc900\ube44\uac00 \ub9ce\uc740 \uacf5\uc5f0 \uc804\ub0a0 \ud558\ub8e8\ub9cc 21\uc2dc\uae4c\uc9c0 \uc0ac\uc6a9\ud558\uac8c \ud574 \ub2ec\ub77c\uace0 \uc591\ubcf4\u00b7\uc870\uc815\uc548\uc744 \uc81c\uc2dc\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc5f0 \uae30\uac04 \ub3d9\uc548 \uc678\ubd80\uc778 \ucd9c\uc785 \uc99d\uac00\uc640 \uad00\ub828\ud558\uc5ec \uc8fc\ubbfc \ub300\ud45c\uac00 \uc5fc\ub824\ud55c \ubb38\uc81c\uc810 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc18c\uc74c \ubc1c\uc0dd\n2. \uc4f0\ub808\uae30 \ubc1c\uc0dd \ubc0f \ubbfc\uc6d0\n3. \uc548\uc804\uc0ac\uace0 \ubc1c\uc0dd \uc5fc\ub824"
