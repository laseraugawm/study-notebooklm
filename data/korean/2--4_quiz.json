        {
          "text": "\u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d - \ud0d0\uad00\uc624\ub9ac\uc758 \uc218\ud0c8\uc5d0 \ub300\ud55c \uac00\ud639\ud55c \ube44\ud310\uacfc \ud48d\uc790",
          "isCorrect": false,
          "rationale": "\u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc758 \uc8fc\uc81c\ub294 '\uc790\uc5f0 \uce5c\ud654'\uc785\ub2c8\ub2e4."
