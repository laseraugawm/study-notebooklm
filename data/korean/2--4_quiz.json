{
  "title": "\ud55c\uad6d\ubb38\ud559 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \ud55c\uad6d \ubb38\ud559\uc0ac\uc758 \ud750\ub984 \uc18d\uc5d0\uc11c \uc2dc\ub300\ubcc4 \ud604\ub300 \uc18c\uc124\uc758 \uc8fc\uc694 \uc8fc\uc81c \ubc0f \uacbd\ud5a5\uc744 \uc5f0\uacb0\ud55c \ub0b4\uc6a9\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "1930\ub144\ub300 \uc18c\uc124 - \uc77c\uc81c \uac15\uc810\ud558\uc758 \ud604\uc2e4\uc744 \ub2f4\uc544\ub0c4.",
          "isCorrect": false,
          "rationale": "1930\ub144\ub300 \uc18c\uc124\uc740 \uc77c\uc81c \uac15\uc810\uc774\ub77c\ub294 \uc2dc\ub300\uc801 \ud604\uc2e4\uacfc \uadf8 \uc0c1\ud669 \uc18d \uc778\ubb3c\ub4e4\uc758 \uc0b6\uc744 \uc801\uadf9\uc801\uc73c\ub85c \ubc18\uc601\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "1950\ub144\ub300 \uc18c\uc124 - \uc804\ud6c4 \uc2dc\ub300\uc758 \ud63c\ub780\ud55c \uc0ac\ud68c\uc0c1\uacfc \uac08\ub4f1\uc744 \uadf8\ub824 \ub0c4.",
          "isCorrect": false,
          "rationale": "1950\ub144\ub300 \uc18c\uc124\uc740 \ud55c\uad6d\uc804\uc7c1 \uc9c1\ud6c4 \ud63c\ub780\uc2a4\ub7ec\uc6b4 \uc0ac\ud68c\uc801 \ubd84\uc704\uae30\uc640 \uc0b6\uc758 \uac08\ub4f1\uc744 \ub2e4\ub8e8\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "1970\ub144\ub300 \uc18c\uc124 - \uae09\uaca9\ud55c \uc0b0\uc5c5\ud654\uc640 \ub3c4\uc2dc\ud654 \ubb38\uc81c\uc5d0 \ub300\ud55c \uc131\ucc30\uc744 \ub4dc\ub7ec\ub0c4.",
          "isCorrect": false,
          "rationale": "1970\ub144\ub300 \uc18c\uc124\uc740 \uc0b0\uc5c5\ud654 \ubc0f \ub3c4\uc2dc\ud654 \uacfc\uc815\uc5d0\uc11c \ubc1c\uc0dd\ud55c \uc0ac\ud68c\uc801 \ud3d0\ud574\uc640 \uc774\uc5d0 \ub300\ud55c \uc131\ucc30\uc744 \uc911\uc2ec\uc73c\ub85c \uc804\uac1c\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "1990\ub144\ub300 \uc774\ud6c4 \uc18c\uc124 - \uc9d1\ub2e8\uc801 \uac00\uce58\uc640 \uc774\ub150\uc801 \ub300\ub9bd\uc744 \uc911\uc2ec\uc73c\ub85c \uac70\ub300 \uc11c\uc0ac\ub97c \ud615\uc131\ud568.",
          "isCorrect": true,
          "rationale": "1990\ub144\ub300 \uc774\ud6c4 \uc18c\uc124\uc740 \uac70\ub300 \uc11c\uc0ac\ub098 \uc774\ub150\uc801 \ub300\ub9bd\ubcf4\ub2e4\ub294 \uac1c\uc778\uc801\uc774\uace0 \uc77c\uc0c1\uc801\uc778 \uc774\uc57c\uae30\ub97c \uc911\uc2ec\uc73c\ub85c \uc0c8\ub85c\uc6b4 \uc2dc\ub300 \uac10\uac01\uc744 \ub2f4\uc544\ub0b4\uc5c8\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "1990\ub144\ub300 \uc774\ud6c4 \uc18c\uc124\uc774 \ub2e4\ub8ec \uc8fc\uc694 \uad00\uc2ec\uc0ac\uac00 \uac1c\uc778\uc801\uc778 \uc774\uc57c\uae30\uc778\uc9c0, \uc9d1\ub2e8\uc801\uc778 \uc774\ub150\uc778\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc5f0\uc6b0\uac00 \uc790\uae30 \ubc29 \ubcbd\uc5d0 \ub0a8\uaca8\uc9c4 '\ub099\uc11c'\uc640 \ub9de\uc740\ud3b8 '\uac70\uc6b8'\uc744 \ubcf4\uace0 \ud55c \ud589\ub3d9 \ubc0f \uc0dd\uac01\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubcbd\uc758 \ub099\uc11c\ub294 \uc804 \uc8fc\uc778\uc774 \uce68\ub300 \uc704\uc5d0\uc11c \ubb34\ub98e\uc744 \uafc7\uace0 \uadf8\ub824 \ub193\uc558\ub358 \ud76c\ubbf8\ud55c \uc0c8\uc758 \ub0a0\uac1c \ubaa8\uc591\uc774\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uc6b0\ub294 \ubcbd\uc758 \ub099\uc11c \uc704\uce58\uc640 \ud615\ud0dc\ub97c \ubcf4\uba70 \uc804 \uc8fc\uc778\uc774 \ubd88\ud3b8\ud55c \uc790\uc138\ub85c \uc0c8\uc758 \ub0a0\uac1c\ub97c \uadf8\ub824 \ub193\uc558\uc744 \uac83\uc774\ub77c \ucd94\uce21\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc5f0\uc6b0\ub294 \uc804 \uc8fc\uc778\uc774 \uac70\uc6b8 \uc18d\uc5d0 \ube44\uce5c \uc0c8\uc758 \uadf8\ub9bc\uc744 \ubcf4\ub824\uace0 \uc77c\ubd80\ub7ec \ubd88\ud3b8\ud55c \uc790\ub9ac\uc5d0 \ub099\uc11c\ud588\ub2e4\uace0 \uc0dd\uac01\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub9de\uc740\ud3b8 \uac70\uc6b8\uc758 \uc704\uce58\ub97c \ud655\uc778\ud55c \uc5f0\uc6b0\ub294 \uac70\uc6b8\uc5d0 \uc0c1\uc774 \ube44\uce58\ub3c4\ub85d \ud558\uae30 \uc704\ud574 \ubcbd\uc5d0 \ub099\uc11c\ub97c \ud55c \uac83\uc774\ub77c \uc774\ud574\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc5f0\uc6b0\ub294 \uae4c\uce58\ubc1c\uc744 \ud558\uace0 \uac70\uc6b8\uc744 \ubcf4\uba70, \uc804 \uc8fc\uc778\uc774 \uc790\uc2e0\uc5d0\uac8c \ub0a0\uac1c\ub97c \ub2ec\uc544 \uc6b0\uc8fc\ub85c \ub0a0\uc544\uac00\ub294 \uc0c1\uc0c1\uc744 \ud588\uc744 \uac83\uc774\ub77c\uace0 \uc0dd\uac01\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac70\uc6b8 \uc18d\uc5d0\uc11c \uc5b4\uae68 \ub192\uc774\uc5d0 \ub9de\ucd98 \ub0a0\uac1c\ub97c \ud655\uc778\ud558\uace0, \ub2f5\ub2f5\ud55c \ud604\uc2e4\uc744 \ubc97\uc5b4\ub098 \ube44\uc0c1\ud558\ub294 \ubaa8\uc2b5\uc744 \uc0c1\uc0c1\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc5f0\uc6b0\ub294 \ubc29\uc758 \uc804 \uc8fc\uc778\uc774 \ub0a8\uae34 \ub099\uc11c \ud754\uc801\uc774 \uae30\ubd84 \ub098\ube60 \uc9c0\uc6b0\uac1c\ub85c \uc644\uc804\ud788 \uc9c0\uc6b4 \ub4a4 \ub354 \uc774\uc0c1 \uc2e0\uacbd \uc4f0\uc9c0 \uc54a\uae30\ub85c \ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc5f0\uc6b0\ub294 \uc9c0\uc6cc\uc9c4 \ub099\uc11c\ub97c \uc644\uc804\ud788 \uc5c6\uc560\uc9c0 \uc54a\uace0 \uc5f0\ud544\uc744 \ub4e4\uace0 \ud76c\ubbf8\ud55c \uc120\uc744 \ub530\ub77c \ub367\uadf8\ub824 \uc0c8\uc758 \ubaa8\uc591\uc744 \ud655\uc2e4\ud558\uac8c \uc7a1\uc558\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc5f0\uc6b0\uac00 \uc5f0\ud544\uc744 \ub4e4\uace0 \ud76c\ubbf8\ud558\uac8c \ub0a8\uc544 \uc788\ub358 \uc120\uc744 \uc5b4\ub5bb\uac8c \ub2e4\ub8e8\uc5c8\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc18c\uc124 \u300c\uc18c\ub144\uc744 \uc704\ub85c\ud574 \uc918\u300d\uc5d0\uc11c \uc5f0\uc6b0\uac00 \ud559\uad50 \uc6b4\ub3d9\uc7a5\uc5d0\uc11c \uc57c\uac04 \uc790\uc728 \ud559\uc2b5 \ubd88\ucc38 \ud6c4 \ud63c\uc790 \ub18d\uad6c\ub97c \ud558\ub358 \ucc44\uc601\uc744 \ub3d5\ub294 \uc7a5\uba74\uc5d0 \ub300\ud55c \ud574\uc11d\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub0a8\ud559\uc0dd \ud0a4\uc5d0 \ub9de\ucdb0\uc9c4 \ub192\uc740 \ub18d\uad6c\ub300\ub294 \uccad\uc18c\ub144\uc5d0\uac8c \uc77c\ubc29\uc801\uc73c\ub85c \uc694\uad6c\ub418\ub294 \uc5b5\uc555\uc801\uc778 \uc0ac\ud68c\uc801 \uae30\uc900\uacfc \ud2c0\uc744 \uc0c1\uc9d5\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucc44\uc601\uc758 \ud0a4\uc5d0 \ube44\ud558\uc5ec \ub108\ubb34 \ub192\uc740 \ub18d\uad6c\ub300\ub294 \uac1c\uac1c\uc778\uc758 \ud2b9\uc131\uc744 \uace0\ub824\ud558\uc9c0 \uc54a\uace0 \ud68d\uc77c\uc801\uc778 \uc131\ucde8\ub97c \uc694\uad6c\ud558\ub294 \uc0ac\ud68c\uc801 \ud2c0\uc774\ub098 \uae30\uc900\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4."
        },
        {
          "text": "\uc5f0\uc6b0\uac00 \ucc44\uc601\uc758 \ud5c8\ub9ac\ub97c \ubd99\uc7a1\uc544 \uc29b\uc744 \uc2dc\ud0a8 \uac83\uc740 \uccb4\uc721 \uc9c4\ud559\uc744 \uad8c\uc720\ud558\uae30 \uc704\ud55c \ud589\ub3d9\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uc6b0\uac00 \ucc44\uc601\uc744 \uc548\uc544 \uc62c\ub9b0 \uac83\uc740 \uc5b5\uc555\uc801\uc778 \uae30\uc900(\uace8\ub300)\uc5d0 \ub2ff\uc9c0 \ubabb\ud558\ub294 \ucc44\uc601\uc758 \ud55c\uacc4\ub97c \ud568\uaed8 \uadf9\ubcf5\ud574 \uc8fc\uace0 \uc704\ub85c\ud558\ub824\ub294 \ub9c8\uc74c\uc5d0\uc11c \ube44\ub86f\ub41c \uac83\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ucc44\uc601\uc758 \uc29b\uc774 \uacc4\uc18d \uace8\ub300\uc5d0 \ubbf8\uce58\uc9c0 \ubabb\ud55c \uac83\uc740 \uc5f0\uc6b0\ub97c \uacbd\uacc4\ud558\ub290\ub77c \uc9d1\uc911\ud558\uc9c0 \ubabb\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uc774 \ub2ff\uc9c0 \uc54a\uc740 \uac83\uc740 \ucc44\uc601\uc758 \uc798\ubabb\uc774 \uc544\ub2c8\ub77c \ub0a8\ud559\uc0dd \ud0a4\uc5d0 \ub9de\ucdb0\uc9c4 \ub18d\uad6c\ub300 \ub192\uc774 \ub54c\ubb38\uc774\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc6b4\ub3d9\uc7a5\uc758 \uc815\uc801\uacfc \uc5b4\ub460\uc740 \ub450 \uc778\ubb3c\uc774 \ud0c0\ud611\ud558\uc9c0 \ubabb\ud558\uace0 \uac08\ub4f1\uc774 \uae4a\uc5b4\uc9c8 \uac83\uc784\uc744 \uc608\uc2dc\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5b4\ub450\uc6b4 \uc6b4\ub3d9\uc7a5\uc5d0\uc11c \ud568\uaed8 \uace8\uc744 \ub123\uace0 \ub300\ud654\ub97c \ub098\ub204\uba70 \ub450 \uc778\ubb3c\uc740 \uc11c\ub85c\uc758 \ub9c8\uc74c\uc5d0 \uacf5\uac10\ud558\uace0 \uc815\uc11c\uc801 \uc720\ub300\ub97c \ud615\uc131\ud558\uac8c \ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\ucc44\uc601\uc758 \ud0a4\uc5d0 \ube44\ud574 \ub18d\uad6c\ub300\uac00 \uc65c \ub108\ubb34 \ub192\uc740\uc9c0\uc5d0 \ub300\ud55c \uc18c\uc124 \uc18d \uad6c\uc808\uacfc \uc0c1\uc9d5\uc131\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc5f0\uc6b0\uc640 \ucc44\uc601\uc774 \uc2a4\ud0e0\ub4dc\uc5d0\uc11c \ub098\ub204\ub294 \ub300\ud654\ub97c \ubc14\ud0d5\uc73c\ub85c \ubcfc \ub54c, \ucc44\uc601\uc758 \uc0c1\ud669\uacfc \uc2ec\ub9ac\uc5d0 \ub300\ud55c \uc774\ud574\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucc44\uc601\uc740 \ubd80\ubaa8\ub2d8\uc758 \uae30\ub300\uc5d0 \ubd80\uc751\ud558\uc5ec \ud558\ub8e8\ube68\ub9ac \uc131\uacf5\ud55c \uc5b4\ub978\uc774 \ub418\uace0 \uc2f6\uc5b4 \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc44\uc601\uc740 \uc5b4\ub978\ub4e4\uc774 \ud574\uc57c \ud558\ub294 \uc77c\uc744 \uc790\uc2e0\uc774 \ud574\ub0b4\uc9c0 \ubabb\ud560 \uac83 \uac19\ub2e4\uba70 \uc5b4\ub978\uc774 \ub418\uace0 \uc2f6\uc9c0 \uc54a\ub2e4\uace0 \ub9d0\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ucc44\uc601\uc740 '\uc774\ub7f0 \uc0ac\ub78c\uc774 \ub418\uc5b4\uc57c \ud55c\ub2e4'\ub294 \ud0c0\uc778\uc758 \uae30\uc900\uacfc \uc5b4\ub978\uc774 \ub418\ub294 \uac83\uc5d0 \ub300\ud55c \ubd88\uc548\uc744 \ub290\ub07c\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucc44\uc601\uc740 \ubd80\ubaa8\ub2d8\uc758 \uc790\uc874\uc2ec\uc774\ub098 \ud0c0\uc778\uc758 \uae30\ub300\uc5d0 \ub9de\ucd94\uc5b4\uc57c \ud55c\ub2e4\ub294 \uc555\ubc15\uac10\uacfc \ubc84\ub9bc\ubc1b\uc744\uc9c0 \ubaa8\ub978\ub2e4\ub294 \ubd88\uc548\uc744 \uc548\uace0 \uc0b4\uc544\uac11\ub2c8\ub2e4."
        },
        {
          "text": "\ucc44\uc601\uc740 \uacb0\uc11d\ud588\ub358 \uc0ac\ud758 \ub3d9\uc548 \uc5f0\uc6b0\uac00 \uc790\uc8fc \uc5f0\ub77d\uc744 \uc8fc\uc5b4 \ubd88\uc548\uac10\uc744 \ud574\uc18c\ud588\ub2e4\uace0 \ub9d0\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc44\uc601\uc740 \uc5f0\uc6b0\uac00 \uacb0\uc11d \uae30\uac04 \ub3d9\uc548 \ud55c \ubc88\ub3c4 \uc5f0\ub77d\ud558\uc9c0 \uc54a\uc558\uc9c0\ub9cc, \uc624\ud788\ub824 \uc5f0\uc6b0\ub97c \uc88b\uc740 \uc0ac\ub78c\uc73c\ub85c \ubbff\uc5c8\uae30 \ub54c\ubb38\uc5d0 \ub9c8\uc74c\uc774 \ubd88\uc548\ud558\uc9c0 \uc54a\uc558\ub2e4\uace0 \ub9d0\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ucc44\uc601\uc740 \ube44\ud589\uae30\ub97c \ud0c0\uace0 \uc138\uc0c1 \ub05d\uc73c\ub85c \uac00\uc11c \uc0c8\ub85c\uc6b4 \uad6d\uc815\uc744 \uc9c0\ud0a4\ub294 \ud30c\uc218\uafbc\uc774 \ub418\ub294 \uc9c1\uc5c5\uc744 \uad6c\uccb4\uc801\uc73c\ub85c \uacc4\ud68d\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\uc0c1 \ub05d\uc774\ub098 \uc6b0\uc8fc \uc815\uac70\uc7a5\uc5d0 \uac00\uace0 \uc2f6\ub2e4\ub294 \ub9d0\uc740 \ud604\uc2e4\uc758 \ubd80\ub2f4\uc5d0\uc11c \ubc97\uc5b4\ub098\uace0 \uc2f6\uc740 \uc0c1\uc0c1\uc77c \ubfd0 \uc2e4\uc9c8\uc801\uc778 \uc9c1\uc5c5 \uacc4\ud68d\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\ucc44\uc601\uc774 \"\ub09c \uc5b4\ub978\uc774 \ub418\uace0 \uc2f6\uc9c0 \uc54a\uc544.\"\ub77c\uace0 \ub9d0\ud55c \uae4c\ub2ed\uacfc \ubd80\ubaa8\ub2d8\uacfc\uc758 \uad00\uacc4\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc18c\uc124 \uc18d \uc5f0\uc6b0\uc640 \ucc44\uc601\uc774 \uc5b8\uae09\ud55c '\uc2dc\uac04\uc744 \uc9c0\ud0a4\ub294 \uac83'\uacfc '\uc6b0\uc8fc \uc815\uac70\uc7a5'\uc774 \uc0c1\uc9d5\ud558\ub294 \uc758\ubbf8\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud0c0\uc778\uc758 \uae30\uc900\uacfc \uc5b4\ub978\uc774 \ub418\uc5b4\uc57c \ud55c\ub2e4\ub294 \uc555\ubc15\uc5d0\uc11c \ubc97\uc5b4\ub098 \uc790\uc2e0\uc758 \uace0\uc720\uc131\uacfc \uc790\uc544\ub97c \uc720\uc9c0\ud558\uace0\uc790 \ud558\ub294 \uc774\uc0c1\uc801 \uacf5\uac04\uacfc \ud0dc\ub3c4\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2dc\uac04\uc774 \uba48\ucd98 \uc7a5\uc18c\ub098 \uc6b0\uc8fc \uc815\uac70\uc7a5\uc740 \uc5b5\uc555\uc801\uc778 \uc0ac\ud68c\uc801 \uae30\uc900\uc5d0 \ub9de\ucd94\uc5b4 \uc5b4\ub978\uc774 \ub418\ub294 \uac83\uc744 \uc720\uc608\ud558\uace0, '\ub098 \uc790\uc2e0'\uc73c\ub85c \uc874\uc7ac\ud558\ub294 \uacf5\uac04\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub0a8\ub4e4\ubcf4\ub2e4 \ube60\ub974\uac8c \ucde8\uc5c5\ud558\uc5ec \uc0ac\ud68c\uc801 \uc131\ucde8\uc640 \uacbd\uc81c\uc801 \ubd80\ub97c \uc774\ub8e8\uaca0\ub2e4\ub294 \uc758\uc9c0\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub450 \uc778\ubb3c\uc740 \uc131\ucde8\ub098 \uacbd\uc7c1\uc801 \uc131\uacf5\ubcf4\ub2e4\ub294 \ud0c0\uc778\uc758 \uae30\uc900\uc5d0\uc11c \ubc97\uc5b4\ub098\ub294 \uc790\uc720\ub97c \uc5f4\ub9dd\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud559\uad50 \uaddc\uc728\uc744 \ucca0\uc800\ud788 \uc900\uc218\ud558\uc5ec \uad50\ub0b4 \uc6b0\uc218 \ud559\uc0dd\uc774 \ub418\uaca0\ub2e4\ub294 \ub2e4\uc9d0\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc44\uc601\uc740 \uc57c\uac04 \uc790\uc728 \ud559\uc2b5 \ubd88\ucc38 \ub4f1\uc73c\ub85c \uaddc\uc728\uc5d0 \ub2f5\ub2f5\ud568\uc744 \ub290\ub07c\uace0 \uc788\uc5c8\uc73c\uba70, \uae30\uc131 \uc0ac\ud68c\uc758 \uae30\uc900\uc5d0\uc11c \ubc97\uc5b4\ub098\uace0\uc790 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub0a0\uc9dc \ubcc0\uacbd\uc120\uc758 \uc9c0\ub9ac\uc801 \uc704\uce58\ub97c \uacfc\ud559\uc801\uc73c\ub85c \uc815\ub9bd\ud558\uaca0\ub2e4\ub294 \ud559\ubb38\uc801 \ubaa9\ud45c\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub0a0\uc9dc \ubcc0\uacbd\uc120\uc774\ub098 \uc6b0\uc8fc \uc815\uac70\uc7a5\uc740 \ub0ad\ub9cc\uc801\uc774\uace0 \uc774\uc0c1\uc801\uc778 \uc0c1\uc0c1\uc758 \ub9e4\uac1c\uccb4\uc77c \ubfd0 \uacfc\ud559\uc801 \uc5f0\uad6c \ubaa9\uc801\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        }
