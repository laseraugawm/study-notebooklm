      "hint": "\uc791\uac00\uac00 \uc774 \uc18c\uc124\uc744 \ud1b5\ud574 \uc804\ud558\uace0\uc790 \ud55c '\uc131\ucde8\uac00 \uc544\ub2cc \uc790\uc2e0\uc758 \uace0\uc720\uc131\uc744 \uae68\ub2eb\ub294 \uc774\uc57c\uae30'\ub77c\ub294 \uc810\uacfc \uc5f0\uacb0\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc5f0\uc6b0\uac00 \ubd80\ub978 '\ube44\uc0c1\uc758 \ub178\ub798(\ub808\uce20 \uace0 \uc2a4\ud398\uc774\uc2a4)' \ubc0f '\uc9c0(G)-\uadf8\ub9ac\ud540'\uc758 \uc74c\uc545\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0(G)-\uadf8\ub9ac\ud540\uc758 \uc74c\uc545\uc740 \uc5f0\uc6b0\uc758 \ub9c8\uc74c\uc18d \uae4a\uc740 \uc9c0\uc810\uc744 \uc815\ud655\ud788 \ub450\ub4dc\ub9ac\uba70 \uc124\ub818\uacfc \ud3b8\uc548\ud568\uc744 \uc120\uc0ac\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uc6b0\ub294 \uc9c0(G)-\uadf8\ub9ac\ud540\uc758 \ud799\ud569 \uc74c\uc545\uc744 \ub4e4\uc73c\uba70 \ub9c8\uc74c\uc758 \uc704\ub85c\uc640 \uc790\uc720\ub85c\uc6c0\uc744 \ub290\ub08d\ub2c8\ub2e4."
        },
        {
          "text": "'\ub808\uce20 \uace0 \uc2a4\ud398\uc774\uc2a4'\ub294 \ud604\uc2e4\uc758 \ud55c\uacc4\uc640 \ud2c0\uc744 \ub6f0\uc5b4\ub118\uc5b4 \uc774\uc0c1\uc744 \ud5a5\ud574 \ub0a0\uc544\uc624\ub974\uace0\uc790 \ud558\ub294 \ub9c8\uc74c\uc744 \ud615\uc0c1\ud654\ud55c \ub178\ub7ab\ub9d0\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "'\uc6b0\uc8fc\ub85c \uac00\uc790'\ub294 \ub178\ub7ab\ub9d0\uc740 \uc5b5\uc555\uc801 \ud604\uc2e4\uc744 \ub118\uc5b4 \uc790\uc2e0\ub9cc\uc758 \uc774\uc0c1\ud5a5\uc73c\ub85c \ube44\uc0c1\ud558\ub824\ub294 \uc18c\ub9dd\uc744 \ub2f4\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc5f0\uc6b0\ub294 \ucc44\uc601\uacfc \ub300\ud654\ud558\ub358 \uc911 \uacb0\ub860\uc744 \ub9d0\ud558\ub4ef \ub9ac\ub4ec\uc744 \uc2e4\uc5b4 \ub178\ub798\ub97c \ubd80\ub974\uba70 \ucc44\uc601\uacfc \uad50\uac10\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uc6b0\ub294 \uc9c0(G)-\uadf8\ub9ac\ud540\uc758 \uac00\uc0ac\ub97c \ub7a9\ucc98\ub7fc \uc74a\uc73c\uba70 \ucc44\uc601\uc5d0\uac8c \uc790\uc2e0\ub4e4\uc758 \ube44\uc0c1\uacfc \uad50\uac10\uc758 \uba54\uc2dc\uc9c0\ub97c \uc804\ub2ec\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc774 \ub178\ub798\ub294 \ud0c0\uc778\ubcf4\ub2e4 \uc6b0\uc6d4\ud55c \ub2a5\ub825\uc744 \uc99d\uba85\ud558\uc5ec \uc0ac\ud68c\uc801 \uad8c\ub825\uc744 \ud68d\ub4dd\ud558\uaca0\ub2e4\ub294 \uc5f0\uc6b0\uc758 \uc57c\ub9dd\uc744 \ud45c\ud604\ud55c \uac83\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc774 \ub178\ub798\ub294 \ud0c0\uc778\uacfc\uc758 \uacbd\uc7c1\uc774\ub098 \uad8c\ub825 \ud68d\ub4dd\uc774 \uc544\ub2c8\ub77c, \ubd88\uc644\uc804\ud55c \uc790\uc2e0\uc744 \uc778\uc815\ud558\uace0 \uace0\uc720\ud55c \uc790\uc544\ub85c\uc11c \ube44\uc0c1\ud558\uace0\uc790 \ud558\ub294 \uc18c\ub9dd\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc774 \uc18c\uc124\uc5d0\uc11c '\ube44\uc0c1'\uc774 \ud0c0\uc778\uc744 \ubc1f\uace0 \uc62c\ub77c\uc11c\ub294 \uc2b9\ub9ac\ub97c \uc758\ubbf8\ud558\ub294\uc9c0, \uc790\uc2e0\ub9cc\uc758 \uace0\uc720\uc131\uc744 \ucc3e\ub294 \uc790\uc720\uc778\uc9c0 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud559\uc2b5 \ud65c\ub3d9\uc5d0 \uc81c\uc2dc\ub41c '\uadf8\ub9ac\ud540(griffin)'\uc758 \uac1c\ub150 \ubc0f \uc791\ud488 \ub9e5\ub77d\uc744 \ucc38\uace0\ud560 \ub54c, \uc5f0\uc6b0\uac00 \ubcbd\uc758 '\ub099\uc11c'\uc5d0 \ubd80\uc5ec\ud55c \uc758\ubbf8\ub97c \ud574\uc11d\ud55c \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc804 \uc8fc\uc778\uc774 \ub0a8\uae34 \ubbf8\uc644\uc131 \uadf8\ub9bc\uc744 \uc218\ub9ac\ud558\uc5ec \uc9d1\uc744 \uc815\ub3c8\ud558\ub824\ub294 \uc2e4\uc6a9\uc801 \ubaa9\uc801\uc758 \ud589\uc704\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub099\uc11c\ub97c \ub367\uadf8\ub9ac\ub294 \ud589\uc704\ub294 \ub2e8\uc21c\ud788 \ubcbd\uc744 \uafb8\ubbf8\uac70\ub098 \uc218\ub9ac\ud558\ub824\ub294 \ubaa9\uc801\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\ub3c5\uc218\ub9ac\uc758 \ub0a0\uac1c\uc640 \uc0ac\uc790\uc758 \ubab8\ud1b5\uc744 \uc9c0\ub2cc '\uadf8\ub9ac\ud540'\ucc98\ub7fc, \ud0c0\uc778\uc774 \uc815\ud55c \uae30\uc900\uc774 \uc544\ub2cc '\ub098 \uc790\uc2e0'\uc758 \uace0\uc720\uc131\uc744 \uae68\ub2eb\uace0 \ube44\uc0c1\ud558\ub824\ub294 \uc8fc\uccb4\uc801 \uc790\uc544 \ud615\uc131\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc804 \uc8fc\uc778\uc740 \ub2e8\uc21c\ud55c \uc0c8\ub97c \uadf8\ub838\uc9c0\ub9cc, \uc5f0\uc6b0\ub294 \uc790\uc2e0\uc758 \uac00\uc2b4\uacfc \ud314\ub2e4\ub9ac\ub85c \uc0ac\uc790\uc758 \ubab8\ud1b5\uc744 \ucc44\uc6cc '\ub098\uc758 \uadf8\ub9ac\ud540'\uc744 \uc644\uc131\ud568\uc73c\ub85c\uc368 \uc8fc\uccb4\uc801\uc73c\ub85c \ub0a0\uc544\uc624\ub974\uace0\uc790 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0c1\uc0c1\uc758 \ub3d9\ubb3c\uc744 \ubcbd\uc5d0 \uadf8\ub824 \ub123\uc5b4 \uc2dc\ud5d8 \ud569\uaca9\uacfc \ud559\uc5c5\uc801 \uc131\uacf5\uc744 \uae30\uc6d0\ud558\ub294 \uae30\ubcf5\uc801 \uc18c\ub9dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uadf8\ub9ac\ud540\uc740 \ud559\uc5c5 \uc131\ucde8\uac00 \uc544\ub2c8\ub77c \uc790\uc544\uc758 \uc8fc\uccb4\uc801\uc778 \ube44\uc0c1\uacfc \uace0\uc720\uc131\uc744 \uc0c1\uc9d5\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc804 \uc8fc\uc778\uc778 \uae30\ud6c8 \uc120\ubc30\uc758 \uc0c1\ucc98\ub97c \ub300\uc2e0 \uc544\ud30c\ud558\uba70 \uae30\ud6c8\uc758 \uc0b6\uc744 \uadf8\ub300\ub85c \ubcf5\uc81c\ud558\uaca0\ub2e4\ub294 \ub2e4\uc9d0\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uc6b0\ub294 \uc804 \uc8fc\uc778\uc758 \ud754\uc801\uc744 \ubc14\ud0d5\uc73c\ub85c \uc0bc\ub418, \ud0c0\uc778\uc758 \uc0b6\uc744 \ubcf5\uc81c\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc790\uc2e0\ub9cc\uc758 '\uc5f0\uc6b0-\uadf8\ub9ac\ud540'\uc744 \ud0c4\uc0dd\uc2dc\ud0a4\uace0\uc790 \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc5f0\uc6b0\uac00 \uae43\ud138\uc744 \ub367\uadf8\ub9ac\uba70 \"\uc804 \uc8fc\uc778\uc740 \uc0c8\ub97c \uadf8\ub838\uc9c0\ub9cc \ub0b4\uac00 \uadf8\ub9ac\ub294 \uac74 \ub098\uc758 \uadf8\ub9ac\ud540\uc774\ub2e4\"\ub77c\uace0 \ub9d0\ud55c \uc758\ubbf8\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
