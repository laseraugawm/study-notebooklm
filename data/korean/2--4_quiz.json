    {
      "type": "multiple_choice",
      "question": "[\ub300\ub2e8\uc6d0 \ub0b4\uc6a9 \uc810\uac80]\uc5d0 \uc81c\uc2dc\ub41c \ud55c\uad6d \ubb38\ud559\uc758 \uc8fc\uc694 \uc791\ud488\uacfc \uadf8 \uc8fc\uc81c/\ud575\uc2ec \ub0b4\uc6a9\uc758 \uc5f0\uacb0\ub85c \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d - \uc790\uc5f0 \uc18d\uc5d0\uc11c\uc758 \uc720\uc720\uc790\uc801\ud55c \uc0b6\uacfc \uc548\ube48\ub099\ub3c4(\u5b89\u8ca7\u6a02\u9053)",
          "isCorrect": false,
