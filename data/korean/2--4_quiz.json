    {
      "type": "multiple_choice",
      "question": "\uc740\ud76c\uacbd\uc758 \uc18c\uc124 \u300c\uc18c\ub144\uc744 \uc704\ub85c\ud574 \uc918\u300d\uac00 \uc9c0\ub2cc \ubb38\ud559\uc0ac\uc801 \uc758\ubbf8 \ubc0f \uc18c\ud1b5 \ubc29\uc2dd\uc758 \ud2b9\uc9d5\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc778\ud130\ub137 \uce74\ud398\ub77c\ub294 \ub514\uc9c0\ud138 \ub9e4\uccb4\uc5d0 \uba3c\uc800 \uc5f0\uc7ac\ub41c \ud6c4 \ucc45\uc73c\ub85c \ucd9c\uac04\ub418\uc5b4 \ubb38\ud559 \uc18c\ud1b5 \ubc29\uc2dd\uc758 \ub2e4\ubcc0\ud654\ub97c \ubcf4\uc5ec\uc900\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774 \uc791\ud488\uc740 \ub514\uc9c0\ud138 \ub9e4\uccb4\uc778 \uc778\ud130\ub137 \uce74\ud398\uc5d0 \uc5f0\uc7ac\ub41c \ud6c4 \ucd9c\uac04\ub41c \ub300\ud45c\uc801\uc778 2000\ub144\ub300 \uc774\ud6c4 \ud604\ub300 \uc18c\uc124\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc791\uac00\uac00 \uc18c\uc124 \uad00\ub828 \uc815\ubcf4\ub098 \ub313\uae00\uc744 \ud1b5\ud574 \ub3c5\uc790\uc640 \uc801\uadf9\uc801\uc73c\ub85c \uc18c\ud1b5\ud558\ub294 \ud604\ub300 \uc18c\uc124\uc758 \uc0c8\ub85c\uc6b4 \uacbd\ud5a5\uc744 \ub2f4\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc740\ud76c\uacbd \uc791\uac00\ub294 \uc628\ub77c\uc778 \uc5f0\uc7ac \uacfc\uc815\uc5d0\uc11c \uc778\uc0c1\uc801\uc778 \ub313\uae00\uc774\ub098 \uad00\ub828 \uc815\ubcf4\ub97c \ub098\ub204\uba70 \ub3c5\uc790\uc640 \ub2e4\uac01\ub3c4\ub85c \uc18c\ud1b5\ud588\uc2b5\ub2c8\ub2e4."
