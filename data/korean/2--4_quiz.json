        {
          "text": "2000\ub144\ub300 \uc774\ud6c4 \ub514\uc9c0\ud138 \ud658\uacbd \ubcc0\ud654 \uc18d\uc5d0\uc11c \ub3c5\uc790\uc640 \uc791\uac00 \uac04\uc758 \uc77c\uc0c1\uc801 \uc18c\ud1b5 \uac00\ub2a5\uc131\uc744 \uc99d\uba85\ud55c \uc0ac\ub840\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub514\uc9c0\ud138 \ub9e4\uccb4 \ud65c\uc6a9\uc740 \uc791\uac00\uc640 \ub3c5\uc790 \uc0ac\uc774\uc758 \uc2ec\ub9ac\uc801\u00b7\uc2dc\uac04\uc801 \uac70\ub9ac\ub97c \uc904\uc5ec\uc8fc\ub294 \uc5ed\ud560\uc744 \ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub514\uc9c0\ud138 \ub9e4\uccb4\ub97c \ud65c\uc6a9\ud568\uc5d0 \ub530\ub77c \ubb38\ud559\uacfc \ub3c5\uc790 \uac04\uc758 \uac70\ub9ac\uac00 \uba40\uc5b4\uc9c0\uace0 \uc791\uac00\uc758 \uc77c\ubc29\uc801\uc778 \uc804\ub2ec \ubc29\uc2dd\uc774 \uac15\ud654\ub418\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub514\uc9c0\ud138 \ub9e4\uccb4\ub97c \ud1b5\ud55c \uc5f0\uc7ac\ub294 \uc77c\ubc29\uc801 \uc804\ub2ec\uc774 \uc544\ub2cc, \ub9e4\uc77c \uc5c5\ub370\uc774\ud2b8\ub418\ub294 \uae00\uacfc \ub313\uae00\uc744 \ud1b5\ud574 \ub3c5\uc790\uc640\uc758 \uc30d\ubc29\ud5a5 \uc18c\ud1b5\uc744 \ub2e4\ubcc0\ud654\uc2dc\ucf30\uc2b5\ub2c8\ub2e4."
        }
