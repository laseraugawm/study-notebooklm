    {
      "type": "multiple_choice",
      "question": "\uc724\ub3d9\uc8fc\uc758 \ud604\ub300\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0 \ub4f1\uc7a5\ud558\ub294 \ud575\uc2ec \ub9e4\uac1c\uccb4\uc640 \ud654\uc790\uc758 \uc2ec\ub9ac \ubcc0\ud654 \uacfc\uc815\uc73c\ub85c \uc62c\ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub9e4\uac1c\uccb4: \uc6b0\ubb3c / \uc2ec\ub9ac \ubcc0\ud654: \ubbf8\uc6c0 \u2192 \uc5f0\ubbfc \u2192 \ubbf8\uc6c0 \u2192 \uadf8\ub9ac\uc6c0",
