        {
          "text": "\u300c\uad6c\uc6b4\ubabd\u300d - \uc131\uc9c4\uc774 \uafc8\uc18d \uc591\uc18c\uc720\uc758 \uc0b6\uc744 \ud1b5\ud574 \uc785\uc2e0\uc591\uba85\ud558\ub2e4 \uae68\uc5b4\ub098 \uc778\uc0dd\ubb34\uc0c1\uc744 \uc5bb\uc74c",
          "isCorrect": true,
          "rationale": "\u300c\uad6c\uc6b4\ubabd\u300d\uc740 \uc131\uc9c4\uc774 \uafc8\uc18d\uc5d0\uc11c \uc591\uc18c\uc720\ub85c \ud0dc\uc5b4\ub098 \ubd80\uadc0\uc601\ud654\ub97c \ub204\ub9b0 \ub4a4 \uae68\ub2ec\uc74c\uc744 \uc5bb\uc5b4 \uc778\uc0dd\ubb34\uc0c1\uc744 \uae68\ub2eb\ub294 \uad6c\uc870\ub97c \uac00\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d - \uc694\uc808\ud55c \ub204\uc774\uc5d0 \ub300\ud55c \uc560\ub3c4\uc640 \uc22d\uace0\ud55c \uc885\uad50\uc801 \uc2b9\ud654",
          "isCorrect": false,
          "rationale": "\u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc758 \uc8fc\uc81c\ub294 '\ud0d0\uad00\uc624\ub9ac\uc5d0 \ub300\ud55c \ud48d\uc790\uc640 \ube44\ud310'\uc785\ub2c8\ub2e4."
