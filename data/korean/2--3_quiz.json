{
  "title": "\ud604\ub300\uc2dc \ud034\uc988",
  "questions": [
    {
      "question": "\ub2e4\uc74c \uc911 \uc81c\uc2dc\ub41c \uc9c0\ubb38\uc758 \ub0b4\uc6a9\uc744 \ubc14\ud0d5\uc73c\ub85c \ud55c\uad6d \ud604\ub300 \uc2dc\uc758 \ud750\ub984\uc744 \uc774\ud574\ud55c \uac83\uc73c\ub85c \uc54c\ub9de\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uadfc\ub300\ub97c \uc9c0\ub098\uba74\uc11c \uc2dc\uac00 \ubb38\ud559\uc740 \ub178\ub798\uc640\uc758 \uc5f0\uad00\uc131\uc774 \uc904\uc5b4\ub4e4\uba70 \uc790\uc720\uc2dc \ud615\ud0dc\ub85c \uc815\ucc29\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uadfc\ub300 \uc774\uc804\uc744 \uc9c0\ub098 \uc790\uc720\uc2dc\uac00 \ud615\uc131\ub418\uba74\uc11c '\uac00(\u6b4c)'\uac00 \ub5a8\uc5b4\uc838 \ub098\uac00 \uc2dc \ubb38\ud559\uc774 \ub418\uc5c8\ub2e4\ub294 \uc9c0\ubb38 \uc124\uba85\uacfc \uc77c\uce58\ud569\ub2c8\ub2e4."
        },
        {
          "text": "1920\ub144\ub300\uc5d0\ub294 \uc8fc\ub85c \uc804\ud1b5\uc801\uc778 \ubbfc\uc694\uc870\uc758 \uc6b4\uc728\uc5d0 \uac1c\uc778\uc801 \uc815\uc11c\ub97c \uacb0\ud569\ud558\ub294 \uacbd\ud5a5\uc774 \uac15\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "1920\ub144\ub300 \uc2dc\uc758 \uc8fc\uc694 \ud2b9\uc9d5\uc73c\ub85c \uc804\ud1b5\uc801 \ubbfc\uc694\uc870 \uc6b4\uc728\uacfc \uac1c\uc778\uc801 \uc815\uc11c\uc758 \uacb0\ud569\uc774 \uc81c\uc2dc\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "1930\ub144\ub300\uc5d0\ub294 \ubbfc\uc871\uc8fc\uc758\uc801 \uc800\ud56d\uc2dc\ub9cc\uc774 \ub2e8\uc77c\ud55c \uacbd\ud5a5\uc73c\ub85c \uc9c0\uc18d\ud558\uc5ec \ucc3d\uc791\ub418\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "1930\ub144\ub300\uc5d0\ub294 \ud55c\uce35 \ub2e4\uc591\ud55c \uc2dc\uc801 \uacbd\ud5a5\ub4e4\uc774 \ub4f1\uc7a5\ud558\uba70 \ud604\ub300 \uc2dc\uac00 \ud655\ub9bd\ub418\uc5c8\uace0, \uc800\ud56d\uc2dc\uc640 \uc790\uae30 \uc131\ucc30\uc801 \uc2dc\ub294 \ud574\ubc29 \uc804\uae4c\uc9c0\uc758 \uacbd\ud5a5\uc73c\ub85c \uc124\uba85\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ud574\ubc29 \uc774\ud6c4\uc5d0\ub294 \ud604\uc2e4 \ubb38\uc81c \ucc38\uc5ec/\ubb38\uba85 \ube44\ud310\uc801 \uacbd\ud5a5\uacfc \uc21c\uc218 \uc11c\uc815\uc758 \uc138\uacc4\ub97c \uadf8\ub9ac\ub294 \uc2dc\uac00 \uacf5\uc874\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud574\ubc29 \uc774\ud6c4 \uc804\uc7c1, \uc0b0\uc5c5\ud654, \ubbfc\uc8fc\ud654 \ub4f1\uc744 \uacaa\uc73c\uba70 \ud604\uc2e4 \ucc38\uc5ec\uc801 \uacbd\ud5a5\uacfc \uc21c\uc218 \uc11c\uc815\uc758 \uc138\uacc4\uac00 \uacf5\uc874\ud588\ub2e4\ub294 \ub0b4\uc6a9\uacfc \ubd80\ud569\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "1930\ub144\ub300 \uc2dc\uc801 \uacbd\ud5a5\uc758 \ub2e4\uc591\uc131 \ubc0f \ud574\ubc29 \uc804 \uc800\ud56d\uc2dc\uc758 \ud2b9\uc9d5\uc5d0 \uad00\ud55c \uc9c0\ubb38\uc758 \uc124\uba85\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc724\ub3d9\uc8fc\uc758 \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \ud654\uc790\uac00 \uc6b0\ubb3c \uc18d '\uc0ac\ub098\uc774'\ub97c \ubc14\ub77c\ubcf4\uba70 \ub290\ub07c\ub294 \uc815\uc11c \ubc0f \uc2ec\ub9ac\uc758 \ubcc0\ud654 \uacfc\uc815\uc73c\ub85c \uc62c\ubc14\ub978 \uc21c\uc11c\ub294?",
      "answerOptions": [
        {
          "text": "\ubbf8\uc6c0 \u2192 \uac00\uc5fe\uc74c \u2192 \ubbf8\uc6c0 \u2192 \uadf8\ub9ac\uc6c0",
          "isCorrect": true,
          "rationale": "\uc2dc\uc758 \uc9c4\ud589 \uacfc\uc815\uc5d0\uc11c '\ubbf8\uc6cc\uc838 \u2192 \uac00\uc5fe\uc5b4\uc9d0 \u2192 \ub2e4\uc2dc \ubbf8\uc6cc\uc838 \u2192 \uadf8\ub9ac\uc6cc\uc9d0'\uc758 \uc21c\uc11c\ub85c \ud654\uc790\uc758 \uc815\uc11c\uac00 \ubcc0\ud654\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uadf8\ub9ac\uc6c0 \u2192 \ubbf8\uc6c0 \u2192 \uac00\uc5fe\uc74c \u2192 \ubbf8\uc6c0",
          "isCorrect": false,
          "rationale": "\ud654\uc790\ub294 \uc0ac\ub098\uc774\ub97c \ucc98\uc74c \ubcf4\uc558\uc744 \ub54c \uadf8\ub9ac\uc6c0\uc774 \uc544\ub2cc \ubbf8\uc6c0\uc744 \uba3c\uc800 \ub290\ub08d\ub2c8\ub2e4."
        },
        {
          "text": "\uac00\uc5fe\uc74c \u2192 \ubbf8\uc6c0 \u2192 \uadf8\ub9ac\uc6c0 \u2192 \ubbf8\uc6c0",
          "isCorrect": false,
          "rationale": "\ud654\uc790\uac00 \uc0ac\ub098\uc774\uc5d0 \ub300\ud574 \uc5f0\ubbfc(\uac00\uc5fe\uc74c)\uc744 \ub290\ub07c\ub294 \uac83\uc740 \ubbf8\uc6c0 \uc774\ud6c4\uc758 \ub2e8\uacc4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubbf8\uc6c0 \u2192 \uadf8\ub9ac\uc6c0 \u2192 \ubbf8\uc6c0 \u2192 \uac00\uc5fe\uc74c",
          "isCorrect": false,
          "rationale": "\uadf8\ub9ac\uc6c0\uc740 \uac08\ub4f1 \uacfc\uc815\uc744 \uac70\uccd0 \ub9c8\uc9c0\ub9c9 \ub2e8\uacc4\uc5d0 \ub2e4\ub2e4\ub77c \uc790\uc544\uc640 \ud654\ud574\ud560 \ub54c \ud615\uc131\ub418\ub294 \uc815\uc11c\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc2dc 3\uc5f0\ubd80\ud130 5\uc5f0\uae4c\uc9c0 \ud654\uc790\uac00 \uc6b0\ubb3c\uc744 \ub4e4\uc5ec\ub2e4\ubcf4\uace0 \ubc1c\uae38\uc744 \ub3cc\ub9b4 \ub54c\ub9c8\ub2e4 \ub290\ub07c\ub294 \uac10\uc815\uc758 \uc21c\uc11c\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc724\ub3d9\uc8fc\uc758 \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c '\uc6b0\ubb3c'\uc774 \ud558\ub294 \uc8fc\uc694 \uae30\ub2a5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc2e0\uc758 \ubaa8\uc2b5\uc744 \ube44\ucd94\uc5b4 \ubcf4\uba70 \ub0b4\uba74\uc744 \uc131\ucc30\ud558\uac8c \ud558\ub294 \ub9e4\uac1c\uccb4",
          "isCorrect": true,
          "rationale": "\uc6b0\ubb3c\uc740 \uc790\uc2e0\uc758 \ubaa8\uc2b5\uc744 \ube44\ucd94\uc5b4 \uc2a4\uc2a4\ub85c\uc758 \uc0b6\uacfc \uc790\uc544\ub97c \ub3cc\uc544\ubcf4\uac8c \ud558\ub294 \uc131\ucc30\uc758 \ub9e4\uac1c\uccb4 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc678\ubd80 \uc138\uacc4\uc758 \uc554\uc6b8\ud55c \ud604\uc2e4\uacfc \ud654\uc790\ub97c \uc644\ubcbd\ud558\uac8c \ucc28\ub2e8\ud574 \uc8fc\ub294 \ub3c4\ud53c\ucc98",
          "isCorrect": false,
          "rationale": "\uc6b0\ubb3c\uc740 \ud604\uc2e4\uc744 \ud53c\ud558\uae30 \uc704\ud55c \uacf5\uac04\uc774 \uc544\ub2c8\ub77c, \uc790\uc2e0\uc758 \ud604\uc2e4 \ubaa8\uc2b5\uc744 \uc9c1\uba74\ud558\uac8c \ud558\ub294 \uacf5\uac04\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud0c0\uc778\uacfc\uc758 \uac08\ub4f1\uc744 \uc77c\uc2dc\uc801\uc73c\ub85c \ud574\uc18c\ud574 \uc8fc\ub294 \uc18c\ud1b5\uc758 \uacf5\uac04",
          "isCorrect": false,
          "rationale": "\uc6b0\ubb3c \uc18d\uc5d0 \ube44\uce5c \uc778\ubb3c\uc740 \ud0c0\uc778\uc774 \uc544\ub2c8\ub77c \ud654\uc790 \uc790\uc2e0\uc758 \ubd84\uc2e0(\uc790\uc544)\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uacfc\uac70\uc758 \ud589\ubcf5\ud588\ub358 \uc2dc\uc808\ub85c \ub3cc\uc544\uac00\uac8c \ud574 \uc8fc\ub294 \uc2e0\ube44\ub85c\uc6b4 \ud1b5\ub85c",
          "isCorrect": false,
          "rationale": "\uc6b0\ubb3c\uc740 \uacfc\uac70\ub85c \uc2dc\uac04 \uc774\ub3d9\uc744 \ud558\uac8c \ud574 \uc8fc\ub294 \uacf5\uac04\uc774 \uc544\ub2c8\ub77c, \ud604\uc7ac \uc790\uc2e0\uc758 \ub0b4\uba74\uc744 \ub4e4\uc5ec\ub2e4\ubcf4\uac8c \ud558\ub294 \uac70\uc6b8\uacfc \uac19\uc740 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac70\uc6b8\ucc98\ub7fc \uc790\uc2e0\uc758 \ubaa8\uc2b5\uc744 \ube44\ucd94\uc5b4 \ubcf4\ub294 \uc0c1\uc9d5\uc801 \uc758\ubbf8\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc724\ub3d9\uc8fc \uc2dc\uc778\uc758 \uc0b6\uacfc \uc2dc\ub300\uc801 \uc0c1\ud669\uc5d0 \ub300\ud55c \ubcf4\ucda9 \uc124\uba85\uc744 \ucc38\uace0\ud560 \ub54c, \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \uc2dc\uc778\uc774 \ub290\ub080 \ub0b4\uc801 \uac08\ub4f1\uc758 \ubc14\ud0d5\uc774 \ub418\ub294 \ub450 \uac00\uc9c0 \uc8fc\uc694 \uac10\uc815\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uae30\ud610\uc624\uc640 \uc790\uae30 \uc5f0\ubbfc",
          "isCorrect": true,
          "rationale": "\uc9c0\uc2dd\uc778\uc73c\ub85c\uc11c \uc2dc\ub300\ub97c \uc678\uba74\ud558\ub294 \ubd80\ub044\ub7ec\uc6c0\uc5d0\uc11c \ube44\ub86f\ub41c '\uc790\uae30\ud610\uc624(\ubbf8\uc6c0)'\uc640 \uc554\ub2f4\ud55c \ud604\uc2e4\uc744 \uacac\ub514\ub294 \uc790\uc2e0\uc5d0 \ub300\ud55c '\uc790\uae30 \uc5f0\ubbfc(\uac00\uc5fe\uc74c)' \uc0ac\uc774\uc758 \uac08\ub4f1\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
        },
        {
          "text": "\ud604\uc2e4 \ud0c0\ud611\uacfc \ubb34\uad00\uc2ec",
          "isCorrect": false,
          "rationale": "\uc724\ub3d9\uc8fc\ub294 \uce58\uc5f4\ud55c \uc790\uae30 \uc131\ucc30\uc744 \uc218\ud589\ud55c \uc2dc\uc778\uc73c\ub85c, \ubb34\uad00\uc2ec\uc774\ub098 \ud0c0\ud611\uacfc\ub294 \uac70\ub9ac\uac00 \ub3d5\ub2c8\ub2e4."
        },
        {
          "text": "\ubd84\ub178\uc640 \ubcf5\uc218\uc2ec",
          "isCorrect": false,
          "rationale": "\uc2dc\uc778\uc758 \uc5b4\uc870\ub294 \uc131\ucc30\uc801\uc774\uace0 \uc21c\uc218\ud55c \uac10\uc131\uc744 \ubc14\ud0d5\uc73c\ub85c \ud558\uace0 \uc788\uc73c\uba70 \ubd84\ub178\ub098 \ubcf5\uc218\ub97c \uc9c1\uc811 \ud45c\ud604\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uccb4\ub150\uacfc \uc624\ub9cc\ud568",
          "isCorrect": false,
          "rationale": "\ubd80\ub044\ub7ec\uc6c0\uacfc \uc131\ucc30\uc744 \ubc14\ud0d5\uc73c\ub85c \ud558\ub294 \uc778\ubb3c\uc774\ubbc0\ub85c \uc624\ub9cc\ud568\uc774\ub77c\ub294 \uac10\uc815\uc740 \uc131\ub9bd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc77c\uc81c \uac15\uc810\uae30 \uc9c0\uc2dd\uc778\uc73c\ub85c\uc11c \ubb34\ub825\ud55c \uc790\uc2e0\uc5d0\uac8c \ub290\ub080 \ubd80\ub044\ub7ec\uc6c0\uacfc \ubd88\uc30d\ud568\uc5d0 \uad00\ub828\ub41c \uac10\uc815\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc724\ub3d9\uc8fc\uc758 \u300c\uc790\ud654\uc0c1\u300d\uc5d0 \ub300\ud55c \ud45c\ud604 \ubc0f \ud615\uc2dd\uc0c1 \ud2b9\uc9d5\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "'-\uc2b5\ub2c8\ub2e4'\ub77c\ub294 \uc885\uacb0 \uc5b4\ubbf8\ub97c \ubc18\ubcf5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc6b4\uc728\uac10\uc744 \uc870\uc131\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\ubb38\uc801 \uc5b4\uc870 \uc18d\uc5d0\uc11c\ub3c4 \ub3d9\uc77c\ud55c \uc885\uacb0 \uc5b4\ubbf8\uc758 \ubc18\ubcf5\uc744 \ud1b5\ud574 \uc6b4\uc728\uc744 \ud615\uc131\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "2\uc5f0\uc758 \uc2dc\uad6c \uad6c\uc870\uac00 6\uc5f0\uc5d0\uc11c \uac70\uc758 \uadf8\ub300\ub85c \ubc18\ubcf5\ub418\uba70 \uc815\uc11c\uc801 \uc9c0\ud5a5\uc744 \uac15\uc870\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "2\uc5f0\uc758 \ub2e4\ucc44\ub85c\uc6b4 \uc790\uc5f0 \ud48d\uacbd \ubb18\uc0ac\uac00 6\uc5f0\uc5d0\uc11c \ubcc0\uc8fc \ubc0f \ubc18\ubcf5\ub418\ub294 \uad6c\uc870\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "'\ud30c\uc544\ub780'\uacfc \uac19\uc740 \uc2dc\uc801 \ud5c8\uc6a9\uc744 \ud65c\uc6a9\ud558\uc5ec \ub3d9\ud654\uc801\uc774\uace0 \uac10\uac01\uc801\uc778 \ubd84\uc704\uae30\ub97c \ubd80\uac01\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub9de\ucda4\ubc95\uc5d0\uc11c \ubc97\uc5b4\ub09c '\ud30c\uc544\ub780'\uc774\ub77c\ub294 \uc5b4\ud718\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc2dc\uc801 \ubd84\uc704\uae30\uc640 \uc2dc\uac01\uc801 \uc774\ubbf8\uc9c0\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0b4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud654\ub824\ud55c \uc740\uc720\uc640 \uaca9\uc815\uc801\uc778 \uc5b4\uc870\ub97c \ud1b5\ud574 \uc77c\uc81c\uc5d0 \ub300\ud55c \uc9c1\uc811\uc801\uc778 \ud22c\uc7c1 \uc758\uc9c0\ub97c \ub098\ud0c0\ub0b8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc774 \uc2dc\ub294 \uaca9\uc815\uc801\uc778 \uc5b4\uc870\ub098 \uc9c1\uc811\uc801\uc778 \ud22c\uc7c1 \uc120\uc5b8 \ub300\uc2e0, \ub2f4\ub2f4\ud558\uace0 \uc131\ucc30\uc801\uc778 \uc5b4\uc870\ub85c \ub0b4\uba74\uc758 \uac08\ub4f1\uc744 \ud45c\ud604\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc774 \uc2dc\uc758 \uc804\uccb4\uc801\uc778 \uc5b4\uc870\uac00 \uaca9\uc815\uc801\uc778\uc9c0, \uc544\ub2c8\uba74 \ucc28\ubd84\ud558\uace0 \ub2f4\ub2f4\ud55c \uc131\ucc30\uc801 \uc5b4\uc870\uc778\uc9c0 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc724\ub3d9\uc8fc\uc758 \u300c\uc790\ud654\uc0c1\u300d \ub9c8\uc9c0\ub9c9 \uc5f0(6\uc5f0)\uc5d0\uc11c '\ucd94\uc5b5\ucc98\ub7fc \uc0ac\ub098\uc774\uac00 \uc788\uc2b5\ub2c8\ub2e4'\uac00 \uc758\ubbf8\ud558\ub294 \ubc14\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc2e0\uc5d0 \ub300\ud55c \ubbf8\uc6c0\uacfc \uac00\uc5fe\uc74c\uc758 \uac08\ub4f1\uc744 \uadf9\ubcf5\ud558\uace0 \uc21c\uc218\ud588\ub358 \uacfc\uac70\uc758 \uc790\uc544\uc640 \ud654\ud574\ud568",
          "isCorrect": true,
          "rationale": "'\ucd94\uc5b5\ucc98\ub7fc'\uc774\ub77c\ub294 \ud45c\ud604\uc740 \uac08\ub4f1\uc744 \uac70\uccd0 \uc790\uae30 \uc131\ucc30\uc5d0 \ub2e4\ub2e4\ub974\uace0 \uc21c\uc218\ud588\ub358 \uc790\uc2e0\uacfc\uc758 \ud654\ud574\uc5d0 \ub3c4\ub2ec\ud588\uc74c\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
        },
        {
          "text": "\ud604\uc2e4\uacfc\uc758 \ud0c0\ud611\uc744 \uacb0\uc815\ud558\uace0 \uacfc\uac70\uc758 \uae30\uc5b5\uc744 \uc644\ubcbd\ud558\uac8c \uc78a\uc5b4\ubc84\ub9bc",
          "isCorrect": false,
          "rationale": "\uacfc\uac70\ub97c \uc78a\uac70\ub098 \ud604\uc2e4\uc5d0 \ud0c0\ud611\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc790\uc544 \ud0d0\uc0c9\uc744 \ud1b5\ud574 \ud3ec\uc6a9\ud558\ub294 \ud0dc\ub3c4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uace0\ud5a5\uc73c\ub85c \ub3cc\uc544\uac08 \uc218 \uc5c6\ub294 \uc790\uc2e0\uc758 \ucc98\uc9c0\uc5d0 \ub300\ud55c \uc808\ub9dd\uc801\uc778 \uccb4\ub150",
          "isCorrect": false,
          "rationale": "\uc2dc\uc801 \ud654\uc790\uc758 \ud0dc\ub3c4\ub294 \uc808\ub9dd\uc801 \uccb4\ub150\uc774 \uc544\ub2c8\ub77c \uc790\uc544\ub97c \uc218\uc6a9\ud558\uace0 \uc131\ucc30\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \uc218\ub834\ub429\ub2c8\ub2e4."
