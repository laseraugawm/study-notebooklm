{
  "title": "\ud55c\uad6d\uc2dc\ubb38\ud559 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc81c\uc2dc\ubb38\uc5d0 \uc5b8\uae09\ub41c \ud55c\uad6d \uc2dc\uac00 \ubb38\ud559\uc758 \ud750\ub984 \ubc0f \ub0b4\uc6a9\u00b7\ud615\uc2dd\uc801 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud55c\uad6d \uc2dc\uac00 \ubb38\ud559\uc740 \uc6d0\uc2dc\uc801\uc774\uace0 \uc9d1\ub2e8\uc801\uc778 \ub178\ub798\uc778 \uace0\ub300 \uac00\uc694\uc5d0\uc11c \uc2dc\uc791\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dc\uac00 \ubb38\ud559\uc758 \uae30\uc6d0\uc774 \uace0\ub300 \uac00\uc694\ub77c\ub294 \uc124\uba85\uc740 \ubcf8\ubb38\uc758 \ub0b4\uc6a9\uacfc \uc815\ud655\ud788 \uc77c\uce58\ud55c\ub2e4."
        },
        {
          "text": "\ub0b4\uc6a9 \uba74\uc5d0\uc11c\ub294 \uc778\uac04\uc744 \uc874\uc911\ud558\uace0 \uc790\uc5f0 \uce5c\ud654\uc801\uc778 \uc0b6\uc744 \uc9c0\ud5a5\ud558\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud55c\uad6d \uc2dc\uac00 \ubb38\ud559\uc758 \uc8fc\ub41c \ub0b4\uc6a9\uc801 \ud2b9\uc9d5\uc73c\ub85c \uc778\uac04 \uc874\uc911\uacfc \uc790\uc5f0 \uce5c\ud654\uac00 \uc81c\uc2dc\ub418\uc5b4 \uc788\ub2e4."
        },
        {
          "text": "10\uad6c\uccb4 \ud5a5\uac00\uc758 3\ub2e8 \uc758\ubbf8 \uad6c\uc870\ub294 \uc774\ud6c4\uc758 \uace0\ub824 \uac00\uc694\uc640 \uc2dc\uc870 \ub4f1\uc5d0\ub3c4 \uc601\ud5a5\uc744 \uc8fc\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "10\uad6c\uccb4 \ud5a5\uac00\uc5d0\uc11c \uc2dc\uc791\ub41c 3\ub2e8 \uc758\ubbf8 \uad6c\uc870\uac00 \uace0\ub824 \uac00\uc694 \ubc0f \uc2dc\uc870 \ub4f1\uc73c\ub85c \uc774\uc5b4\uc84c\ub2e4\ub294 \ubcf8\ubb38 \uc124\uba85\uc5d0 \ubd80\ud569\ud55c\ub2e4."
        },
        {
          "text": "\ubbfc\uc694 \uc728\uaca9\uc778 3\uc74c\ubcf4 \ub610\ub294 4\uc74c\ubcf4\ub294 \uc2dc\ub300\uc640 \uac08\ub798\uc758 \ubcc0\ud654\uc5d0 \uad00\uacc4\uc5c6\uc774 \ubcc0\ud615 \uc5c6\uc774 \uace0\uc815\ub418\uc5b4 \uc9c0\ucf1c\uc84c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubcf8\ubb38\uc5d0 \ub530\ub974\uba74 \ubbfc\uc694 \uc728\uaca9(3\uc74c\ubcf4 \ub610\ub294 4\uc74c\ubcf4)\uc740 \uac08\ub798\uc5d0 \ub530\ub77c \uace0\uc815\ub41c \uac83\uc774 \uc544\ub2c8\ub77c \ubcc0\ud615\ub418\uace0 \ubc1c\uc804\ub418\uc5b4 \uc654\ub2e4."
        },
        {
          "text": "\uc624\ub298\ub0a0\uc758 \ud604\ub300 \uc2dc\ub294 \uc804\ud1b5 \uc2dc\uac00\uc758 \ub0b4\uc6a9\uacfc \ud615\uc2dd\uc744 \uacc4\uc2b9\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud604\ub300 \uc2dc\uac00 \uc804\ud1b5 \uc2dc\uac00\uc758 \ub0b4\uc6a9\uacfc \ud615\uc2dd\uc744 \uacc4\uc2b9\ud558\uace0 \uc788\ub2e4\ub294 \ubcf8\ubb38\uc758 \uac1c\uad00 \uc124\uba85\uacfc \uc77c\uce58\ud55c\ub2e4."
        }
      ],
      "hint": "\ubcf8\ubb38\uc5d0\uc11c \ubbfc\uc694 \uc728\uaca9(3\uc74c\ubcf4 \ub610\ub294 4\uc74c\ubcf4)\uc774 \uac08\ub798\uc5d0 \ub530\ub77c \uc5b4\ub5bb\uac8c \ub2e4\ub8e8\uc5b4\uc84c\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc5d0 \ub4f1\uc7a5\ud558\ub294 \uc8fc\uc694 \uc2dc\uad6c\uc640 \uadf8 \ud568\ucd95\uc801 \uc758\ubbf8\uc5d0 \ub300\ud55c \ud574\uc11d\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "'\uc774\ub978 \ubc14\ub78c': \ub204\uc774\uac00 \ud55c\ucc3d\ub098\uc774\uc5d0 \uc77c\ucc0d \uc8fd\uc740 \uac83(\uc694\uc808)\uc744 \ube44\uc720\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "'\uc774\ub978 \ubc14\ub78c'\uc740 \uacc4\uc808\uc758 \ubcc0\ud654\uc640 \ub354\ubd88\uc5b4 \ub204\uc774\uac00 \uc77c\ucc0d \uc138\uc0c1\uc744 \ub5a0\ub09c \uc0c1\ud669\uc744 \uc801\uc808\ud788 \ube44\uc720\ud55c\ub2e4."
        },
        {
          "text": "'\ub5a8\uc5b4\uc9c8 \uc78e': \uc0dd\uba85\uc744 \ub2e4\ud558\uace0 \uc138\uc0c1\uc744 \ub5a0\ub09c \uc8fd\uc740 \ub204\uc774\ub97c \ube44\uc720\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc14\ub78c\uc5d0 \ub5a8\uc5b4\uc9c0\ub294 \uc78e\uc740 \ubc14\ub78c\uc5d0 \ud769\uc5b4\uc838 \uc8fd\uc740 \ub204\uc774\ub97c \uc0c1\uc9d5\ud55c\ub2e4."
        },
        {
          "text": "'\ud55c \uac00\uc9c0': \ud55c \ubd80\ubaa8\uc5d0\uac8c\uc11c \ud0dc\uc5b4\ub09c \ub3d9\uc721(\ud608\uc721) \uad00\uacc4\ub97c \ube44\uc720\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud55c \uac00\uc9c0\uc5d0\uc11c \uc78e\uc774 \ub098\ub4ef \ud55c \ubd80\ubaa8\uc5d0\uac8c\uc11c \ud0dc\uc5b4\ub09c \ud615\uc81c\uc790\ub9e4 \uad00\uacc4\ub97c \ube44\uc720\ud55c \ud45c\ud604\uc774\ub2e4."
        },
        {
          "text": "'\uac00\ub294 \uacf3': \ub204\uc774\uac00 \uc8fd\uc5b4\uc11c \ub3c4\ub2ec\ud558\uac8c \ub420 \uadf9\ub77d\uc815\ud1a0\uc758 \uad6c\uccb4\uc801\uc778 \uc704\uce58\ub97c \ube44\uc720\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "'\uac00\ub294 \uacf3 \ubaa8\ub974\uc628\uc800'\uc758 '\uac00\ub294 \uacf3'\uc740 \uc8fd\uc74c \uc774\ud6c4 \ub204\uc774\uac00 \uc5b4\ub514\ub85c \uac14\ub294\uc9c0 \uc54c\uc9c0 \ubabb\ud558\ub294 \uc0b6\uc758 \ubb34\uc0c1\uac10\uacfc \uc544\uc26c\uc6c0\uc744 \ub098\ud0c0\ub0b4\uba70, \uadf9\ub77d\uc815\ud1a0\uc758 \uad6c\uccb4\uc801 \uc704\uce58\ub97c \ub73b\ud558\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "'\ubbf8\ud0c0\ucc30': \uc544\ubbf8\ud0c0\ubd88\uc774 \uc0b4\uace0 \uc788\ub294 \uc815\ud1a0\ub85c, \uad34\ub85c\uc6c0\uc774 \uc5c6\ub294 \uc138\uc0c1\uc774\uc790 \ud654\uc790\uac00 \ub204\uc774\uc640 \uc7ac\ud68c\ud560 \uacf5\uac04\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubbf8\ud0c0\ucc30\uc740 \ubd88\uad50\uc758 \uadf9\ub77d\uc815\ud1a0\ub85c\uc11c \ud654\uc790\uac00 \uc2ac\ud514\uc744 \uadf9\ubcf5\ud558\uace0 \ub204\uc774\uc640 \ub2e4\uc2dc \ub9cc\ub0a0 \uac83\uc744 \ub2e4\uc9d0\ud558\ub294 \uacf5\uac04\uc774\ub2e4."
        }
      ],
      "hint": "'\uac00\ub294 \uacf3 \ubaa8\ub974\uc628\uc800'\ub77c\ub294 \uad6c\uc808 \uc18d \ud654\uc790\uc758 \uc815\uc11c\uc640 \uc5f0\uacb0\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc758 9~10\uad6c \"\uc544\uc544, \ubbf8\ud0c0\ucc30(\u5f4c\u9640\u5239)\uc5d0\uc11c \ub9cc\ub0a0 \ub098 / \ub3c4(\u9053) \ub2e6\uc544 \uae30\ub2e4\ub9ac\uaca0\ub178\ub77c.\"\uc5d0 \ub098\ud0c0\ub09c \ud615\uc2dd\uc801 \ud2b9\uc9d5\uacfc \ud654\uc790\uc758 \ud0dc\ub3c4\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub099\uad6c \uccab\uba38\ub9ac\uc758 \uac10\ud0c4\uc0ac '\uc544\uc544'\ub97c \ud1b5\ud574 \uc2dc\uc0c1\uc744 \uc804\ud658\ud558\uba70, \ubd88\uad50\uc801 \uc2e0\uc559\uc744 \ud1b5\ud574 \ub204\uc774\ub97c \uc783\uc740 \uc2ac\ud514\uc744 \uadf9\ubcf5\ud558\ub824\ub294 \uc758\uc9c0\ub97c \ubcf4\uc774\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "10\uad6c\uccb4 \ud5a5\uac00\uc758 \ub099\uad6c \uac10\ud0c4\uc0ac\ub294 \uc2dc\uc0c1\uc744 \uc9d1\uc57d\u00b7\uc804\ud658\ud558\uace0, \ub3c4\ub97c \ub2e6\uc544 \ubbf8\ud0c0\ucc30\uc5d0\uc11c \ub2e4\uc2dc \ub9cc\ub098\uaca0\ub2e4\ub294 \uc758\uc9c0\ub294 \uc2ac\ud514\uc758 \uc885\uad50\uc801 \uc2b9\ud654\ub97c \ubcf4\uc5ec\uc900\ub2e4."
        },
        {
          "text": "\ud615\uc2dd\uc0c1\uc758 \uc81c\uc57d\uc5d0\uc11c \ubc97\uc5b4\ub098 \uc0ac\uc124\uc2dc\uc870\ucc98\ub7fc \uad6c\uc808\uc758 \uae38\uc774\ub97c \uc790\uc720\ub86d\uac8c \ub298\ub824\uac00\uba70 \ud604\uc2e4\uc758 \uc5b5\uc6b8\ud568\uc744 \ud1a0\ub85c\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\ub294 \uc0ac\uc124\uc2dc\uc870\uac00 \uc544\ub2c8\ub77c \uc5c4\uaca9\ud55c \ud615\uc2dd\uc744 \uac16\ucd98 10\uad6c\uccb4 \ud5a5\uac00\uc774\ub2e4."
        },
        {
          "text": "\uc8fd\uc74c\uc5d0 \ub300\ud55c \uac70\ubd80\uac10\uacfc \ub450\ub824\uc6c0\uc73c\ub85c \uc778\ud574 \ub204\uc774\ub97c \ud5a5\ud55c \uc6d0\ub9dd\uc744 \ud55c\uce35 \ub354 \uac15\ud654\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud654\uc790\ub294 \uc2ac\ud514\uc744 \uc6d0\ub9dd\uc73c\ub85c \ubc14\uafb8\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ubd88\uad50\uc801 \uc2e0\uc559\uc73c\ub85c \uadf9\ubcf5\ud558\uace0\uc790 \ud55c\ub2e4."
        },
        {
          "text": "\uc790\uc5f0\uc758 \uc774\uce58\ub97c \uac70\uc2a4\ub974\uace0 \ubcbc\uc2ac\uae38\uc5d0 \uc62c\ub77c \uc138\uc18d\uc801 \uc131\uacf5\uc744 \uac70\ub450\uaca0\ub2e4\ub294 \ub2e4\uc9d0\uc744 \ub4dc\ub7ec\ub0b4\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud654\uc790\ub294 \uc2b9\ub824 \uc6d4\uba85\uc0ac\ub85c\uc11c \uc885\uad50\uc801 \uc218\ud589\uacfc \uadf9\ub77d\uc5d0\uc11c\uc758 \uc7ac\ud68c\ub97c \ub2e4\uc9d0\ud558\uace0 \uc788\uc73c\ubbc0\ub85c \uc138\uc18d\uc801 \uc131\uacf5\uacfc\ub294 \uac70\ub9ac\uac00 \uba40\ub2e4."
        },
        {
          "text": "\ubbfc\uc694\uc758 3\uc74c\ubcf4 \uc728\uaca9\uc744 \ucda9\uc2e4\ud788 \ubc18\uc601\ud558\uc5ec \uc6c3\uc74c\uacfc \ud48d\uc790\ub97c \uc720\ubc1c\ud558\ub294 \ud574\ud559\uc801 \ubd84\uc704\uae30\ub97c \ud615\uc131\ud558\uace0 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\u300c\uc81c\ub9dd\ub9e4\uac00\u300d\ub294 \uc774\ubcc4\uc758 \uc2ac\ud514\uacfc \uc22d\uace0\ud55c \uc885\uad50\uc801 \uc2b9\ud654\ub97c \ub2e4\ub8ec \uc791\ud488\uc73c\ub85c \ud574\ud559\uc801 \ubd84\uc704\uae30\uc640\ub294 \ubb34\uad00\ud558\ub2e4."
        }
      ],
      "hint": "10\uad6c\uccb4 \ud5a5\uac00 \ub099\uad6c\uc758 \ub300\ud45c\uc801 \uc5ed\ud560\uacfc \ud654\uc790\uac00 \uc2ac\ud514\uc744 \uadf9\ubcf5\ud558\ub294 \ubc29\uc2dd(\uc2e0\uc559)\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc2dc\uc870 \u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc5d0 \ub4dc\ub7ec\ub09c \ud654\uc790\uc758 \ud0dc\ub3c4 \ubc0f \ud45c\ud604\uc0c1 \ud2b9\uc9d5\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "10\ub144 \ub3d9\uc548 \uc815\uc131\uaecf \uc900\ube44\ud558\uc5ec \uc18c\ubc15\ud55c \ucd08\uac00 \uc0bc\uac04\uc744 \ub9c8\ub828\ud55c \ud654\uc790\uc758 \uc0b6\uc758 \ubaa8\uc2b5\uc774 \ub098\ud0c0\ub09c\ub2e4.",
          "isCorrect": false,
          "rationale": "'\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c \ucd08\ub824 \uc0bc\uac04 \uc9c0\uc5b4 \ub0b4\ub2c8'\uc5d0\uc11c \uc18c\ubc15\ud55c \uc0b6\uc744 \uc704\ud55c \ub178\ub825\uc774 \uc798 \ub4dc\ub7ec\ub09c\ub2e4."
        },
        {
          "text": "\ub098, \ub2ec, \uccad\ud48d\uc5d0\uac8c \ubc29\uc744 \ud55c \uac04\uc529 \ubc30\ubd84\ud558\uc5ec \uc790\uc5f0\uacfc \uc5b4\uc6b0\ub7ec\uc9c0\ub294 \uc548\ube48\ub099\ub3c4\uc758 \ud0dc\ub3c4\ub97c \ubcf4\uc5ec\uc900\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc5f0\ubb3c\uc778 \ub2ec\uacfc \uccad\ud48d\uc744 \uc0ac\ub78c\ucc98\ub7fc \ub300\ud558\uba70 \ucd08\uac00 \uc0bc\uac04\uc744 \ub098\ub204\uc5b4 \uc4f0\ub294 \uce5c\uadfc\ud55c \ubaa8\uc2b5\uc774 \ub4dc\ub7ec\ub09c\ub2e4."
        },
        {
          "text": "\uac15\uc0b0\uc740 \ubc29 \uc548\uc5d0 \ub4e4\uc77c \uc218 \uc5c6\uc5b4 \uc9d1 \uc8fc\uc704\uc5d0 \ubcd1\ud48d\ucc98\ub7fc \ub458\ub7ec\ub450\uace0 \ubcf4\uaca0\ub2e4\uace0 \ucc38\uc2e0\ud558\uac8c \ud45c\ud604\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "'\uac15\uc0b0\uc740 \ub4dc\ub9b4 \ub4f8 \uc5c5\uc2a4\ub2c8 \ub458\ub108 \ub450\uace0 \ubcf4\ub9ac\ub77c'\ub294 \uc790\uc5f0\uc744 \uc9d1 \uc8fc\uc704\uc5d0 \ub458\ub7ec\ub450\uace0 \uc990\uae30\uaca0\ub2e4\ub294 \ub3c5\ucc3d\uc801 \ud45c\ud604\uc774\ub2e4."
        },
        {
          "text": "\uc790\uc5f0\uacfc \uc778\uac04\uc774 \ud558\ub098\uac00 \ub418\ub294 '\ubb3c\uc544\uc77c\uccb4'\uc758 \uacbd\uc9c0\uc640 \uac15\ud638\ud55c\uc815\uc758 \uc990\uac70\uc6c0\uc774 \uc798 \ub2f4\uaca8 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc5f0\uc744 \uc8fc\uccb4\uc801 \ub3d9\ubc18\uc790\ub85c \uc778\uc9c0\ud558\uba70 \uc990\uac81\uac8c \uc0b4\uc544\uac00\ub294 \uac15\ud638\uac00\ub3c4\uc758 \uc120\uad6c\uc801 \ud0dc\ub3c4\uac00 \uc798 \ub4dc\ub7ec\ub09c\ub2e4."
        },
        {
          "text": "\ucd08\uac00 \uc0bc\uac04\uc774 \uc881\uc740 \uac83\uc744 \uc548\ud0c0\uae4c\uc6cc\ud558\uba70 \ubcbc\uc2ac\uc5d0 \ub098\uac00 \ub354 \ud070 \uc9d1\uc744 \uc9d3\uaca0\ub2e4\ub294 \uc138\uc18d\uc801 \uc695\ub9dd\uc744 \ub0b4\ube44\uce58\uace0 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud654\uc790\ub294 \ucd08\uac00 \uc0bc\uac04\uc5d0 \ub9cc\uc871\ud558\uba70 \uc790\uc5f0\uc744 \uc990\uae30\ub294 \uc18c\ubc15\ud55c \uc548\ubd84\uc9c0\uc871\uc758 \uc0b6\uc744 \ub178\ub798\ud558\uace0 \uc788\uc73c\ubbc0\ub85c \uc138\uc18d\uc801 \uc695\ub9dd\uacfc\ub294 \uc0c1\ubc18\ub41c\ub2e4."
        }
      ],
      "hint": "\ud654\uc790\uac00 \ucd08\uac00 \uc0bc\uac04\uacfc \uac15\uc0b0\uc744 \ub300\ud558\ub294 \ub9cc\uc871\uc2a4\ub7ec\uc6b4 \uc815\uc11c\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc0ac\uc124\uc2dc\uc870 \u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0 \ub4f1\uc7a5\ud558\ub294 \uc2dc\uc5b4\ub4e4\uc758 \uc0c1\uc9d5\uc801 \uc758\ubbf8\ub97c \uc5f0\uacb0\ud55c \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "'\ub450\ud130\ube44': \ubc31\uc131\uc744 \uc218\ud0c8\ud558\ub294 \uc9c0\ubc29 \uad00\ub9ac",
          "isCorrect": false,
          "rationale": "\uc120\uc0dd\ub2d8\uc758 \uc124\uba85 \ubc0f \ud559\uc2b5 \ud65c\ub3d9\uc5d0 \ub530\ub974\uba74 '\ub450\ud130\ube44'\ub294 \ud798\uc5c6\ub294 \ubc31\uc131\uc744 \uad34\ub86d\ud788\ub294 \uc9c0\ubc29 \uad00\ub9ac\ub97c \uc0c1\uc9d5\ud55c\ub2e4."
        },
        {
          "text": "'\ud30c\ub9ac': \uc9c0\ubc29 \uad00\ub9ac\uc5d0\uac8c \uc218\ud0c8\ub2f9\ud558\ub294 \ud798\uc5c6\uace0 \uc57d\ud55c \ubc31\uc131",
          "isCorrect": false,
          "rationale": "'\ud30c\ub9ac'\ub294 \ub450\ud130\ube44\uc5d0\uac8c \ubb3c\ud600 \uc218\ud0c8\ub2f9\ud558\ub294 \uc57d\ud55c \uc11c\ubbfc/\ubc31\uc131\uc744 \uc0c1\uc9d5\ud55c\ub2e4."
        },
        {
