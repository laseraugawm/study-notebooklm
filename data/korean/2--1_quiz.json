    {
      "type": "multiple_choice",
      "question": "\uac00\uc0ac \uc791\ud488\uc778 \uc815\uadf9\uc778\uc758 \u300c\uc0c1\ucd98\uace1\u300d\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
