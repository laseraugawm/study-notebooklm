{
  "title": "\uad6d\uc5b4 \ud034\uc988",
  "questions": [
    {
      "question": "\uc5b8\uc5b4 \uacf5\ub3d9\uccb4\uc758 \uc791\ubb38 \uad00\uc2b5\uacfc \uc791\ubb38 \uc724\ub9ac\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uae00\uc758 \uc885\ub958\uc5d0 \ub530\ub978 \uc804\ud615\uc801\uc778 \uad6c\uc870\ub098 \uc804\uac1c \ubc29\uc2dd\uc744 \ub530\ub974\ub294 \uac83\uc740 \uc791\ubb38 \uad00\uc2b5\uc5d0 \uc18d\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae00\uc758 \uc885\ubcc4 \uad00\uc2b5\uc744 \ub530\ub974\uba74 \uc5b8\uc5b4 \uacf5\ub3d9\uccb4 \ub0b4\uc5d0\uc11c \ubcf4\ub2e4 \ud6a8\uacfc\uc801\uc778 \uc18c\ud1b5\uc774 \uac00\ub2a5\ud574\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\ub3c5\uc790\ub97c \uc874\uc911\ud558\uace0 \ubc30\ub824\ud558\ub294 \ud45c\ud604\uc744 \uc0ac\uc6a9\ud558\ub294 \uc5b8\uc5b4\ubb38\ud654\ub3c4 \uc791\ubb38 \uad00\uc2b5\uc5d0 \ud3ec\ud568\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc6b0\ub9ac \uc5b8\uc5b4 \uacf5\ub3d9\uccb4\uc5d0\uc11c\ub294 \uc608\uc808\uc744 \uc911\uc2dc\ud558\uc5ec \ub3c5\uc790\ub97c \uace0\ub824\ud558\ub294 \uc5b8\uc5b4\ubb38\ud654\ub97c \uacf5\uc720\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc791\ubb38 \uc724\ub9ac\ub294 \uc790\uc2e0\uc758 \uacbd\ud5d8\uc744 \uc9c4\uc194\ud558\uac8c \uc4f0\uace0 \ud0c0\uc778\uc758 \uc800\uc791\uad8c\uc744 \uc874\uc911\ud558\ub294 \uac83\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uc801 \ucc28\uc6d0\uc758 \uc9c4\uc2e4\uc131\uacfc \uc0ac\ud68c\uc801 \ucc28\uc6d0\uc758 \ucd9c\ucc98 \uba85\uc2dc \ubc0f \uc800\uc791\uad8c \uc874\uc911\uc740 \uc791\ubb38 \uc724\ub9ac\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\ud130\ub137 \ub9e4\uccb4\uc5d0 \uae00\uc744 \uc4f8 \ub54c\ub294 \uc804\ud30c \uc18d\ub3c4\uac00 \ube60\ub974\ub354\ub77c\ub3c4 \uc791\ubb38 \uc724\ub9ac\ub97c \uc5c4\uaca9\ud558\uac8c \uc9c0\ud0ac \ud544\uc694\ub294 \uc5c6\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc778\ud130\ub137 \ub9e4\uccb4\ub294 \uae00\uc758 \uc0ac\ud68c\uc801 \ud30c\uae09\ub825\uc774 \ub9e4\uc6b0 \ud06c\ubbc0\ub85c \ub354\uc6b1 \uac15\ud55c \ucc45\uc784\uac10\uacfc \uc791\ubb38 \uc724\ub9ac\uac00 \uc694\uad6c\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc624\ub298\ub0a0 \uc778\ud130\ub137 \ub9e4\uccb4\uc5d0 \uae00\uc744 \uc4f8 \ub54c \uc0dd\uae30\ub294 \uc0ac\ud68c\uc801 \uc601\ud5a5\ub825\uacfc \ucc45\uc784\uac10\uc5d0 \ub300\ud574 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38 \u300c\uc591\uace1 \ucc3d\uace0, \uc608\uc220\uc758 \uc0b0\uc2e4\ub85c \ubcc0\uc2e0\ud558\ub2e4\u300d\uc5d0\uc11c \uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c\uc774 \uc9c0\ub2cc \uc5ed\uc0ac\uc801 \ubc30\uacbd\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc870\uc120 \uc2dc\ub300\ubd80\ud130 \uc804\uad6d\uc758 \ubb38\uc778\ub4e4\uc774 \ubaa8\uc5ec \uc2dc\uc640 \uae00\uc744 \uc8fc\uace0\ubc1b\ub358 \ud559\uc220 \uacf5\uac04\uc774\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c \uac74\ubb3c\ub4e4\uc740 \ubb34\ub824 100\ub144 \uac00\uae4c\uc774 \uc591\uace1 \ucc3d\uace0\ub85c \uc0ac\uc6a9\ub418\uc5c8\ub358 \uacf3\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc77c\uc81c \uac15\uc810\uae30\uc5d0 \ube44\uc625\ud55c \ud3c9\uc57c\uc5d0\uc11c \uc0dd\uc0b0\ub41c \uc300\uc744 \uc218\ud0c8\ud558\ub358 \uac70\uc810 \ucc3d\uace0\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0bc\ub840\ub294 \ud1a0\uc9c0\uac00 \ube44\uc625\ud558\uc5ec \uc77c\uc81c \uac15\uc810\uae30 \uc591\uace1 \uc218\ud0c8 \uae30\uc9c0\ub77c\ub294 \uc544\ud508 \uc5ed\uc0ac\ub97c \uac04\uc9c1\ud55c \uacf3\uc785\ub2c8\ub2e4."
        },
        {
          "text": "6\u00b725 \uc804\uc7c1 \ub2f9\uc2dc \uad70\uc218 \ubb3c\uc790\ub97c \ubcf4\uad00\ud558\uae30 \uc704\ud574 \uc784\uc2dc\ub85c \uc9c0\uc5b4\uc9c4 \ubaa9\uc870 \ucc3d\uace0\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\uacf3\uc740 \uc77c\uc81c \uac15\uc810\uae30\ubd80\ud130 1970~80\ub144\ub300 \ub18d\ucd0c\uae4c\uc9c0 \uc591\uace1\uc744 \ubcf4\uad00\ud558\ub358 \ucc3d\uace0\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uadfc\ub300\ud654 \uc2dc\uae30 \ud55c\uad6d \ucd5c\ucd08\ub85c \uc138\uc6cc\uc9c4 \uc11c\uc591\uc2dd \ucc45 \ucd9c\ud310 \ubc0f \uc778\uc1c4 \uc804\uc6a9 \uacf5\uc7a5\uc9c0\ub300\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc45 \uacf5\ubc29\uc774\ub098 \ucc45 \ubc15\ubb3c\uad00\uc740 \uc591\uace1 \ucc3d\uace0\uc600\ub358 \uacf5\uac04\uc744 \uac1c\uc870\ud558\uc5ec \ub098\uc911\uc5d0 \uc0c8\ub85c \uafb8\ubbfc \ubb38\ud654 \uacf5\uac04\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0bc\ub840\uc5ed \uc8fc\ubcc0 \ucc3d\uace0\ub4e4\uc774 \uacfc\uac70 \uc5b4\ub5a4 \uc6a9\ub3c4\ub85c \uc0ac\uc6a9\ub418\uc5c8\ub294\uc9c0 \ubcf8\ubb38 \ub0b4\uc6a9\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38\uc5d0 \ub4f1\uc7a5\ud558\ub294 \uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c\uc758 \uacf5\uac04\ubcc4 \uacac\ubb38 \ubc0f \uac10\uc0c1 \ub0b4\uc6a9\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubbf8\ub514\uc5b4 \uc544\ud2b8 \ubbf8\uc220\uad00: \uc77c\ud68c\uc6a9 \ube68\ub300\ub098 \ub9c1\uac70 \uc904 \ub4f1\uc758 \uc4f0\ub808\uae30\ub97c \ud65c\uc6a9\ud55c \uc815\ud06c \uc544\ud2b8 \uc791\ud488\uc744 \uac10\uc0c1\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubbf8\ub514\uc5b4 \uc544\ud2b8 \ubbf8\uc220\uad00\uc5d0\uc11c\ub294 \uc7ac\ud65c\uc6a9 \uc7ac\ub8cc\ub85c \ub9cc\ub4e0 \uc815\ud06c \uc544\ud2b8\uc640 \uc9c1\uc811 \ucc38\uc5ec\ud558\ub294 \uc778\ud130\ub799\ud2f0\ube0c \uc544\ud2b8\ub97c \uad00\ub78c\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ucc45 \uacf5\ubc29: 100\ub144\ub3c4 \ub354 \ub418\uc5b4 \ubcf4\uc774\ub294 \ubaa9\uada4\uc120\uc744 \ubcf4\uace0 \uad6d\uac00\uc720\uc0b0\uae09\uc758 \uc804\uc2dc \uc791\ud488\uc774\ub77c\uace0 \ub290\uaf08\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc45 \uacf5\ubc29\uc5d0\uc11c\ub294 \uac00\uacc4\ubd80 \ub4f1\uc5d0 \uc904\uc744 \uae0b\ub294 \uae30\uacc4\uc778 \ubaa9\uada4\uc120\uc744 \ubcf4\uace0 \uad6d\uac00\uc720\uc0b0 \uc218\uc900\uc774\ub77c \ud3c9\uac00\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ucc45 \ubc15\ubb3c\uad00: \ud654\uac00\ub4e4\uc774 \uc9c1\uc811 \uadf8\ub9b0 \uc61b \ucc45 \ud45c\uc9c0\uc640 \uae40\ud0dc\ud615 \uc791\uac00\uc758 \uad50\uacfc\uc11c \uc0bd\ud654\ub97c \ucc3e\uc544\ubcf4\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd81 \ub514\uc790\uc774\ub108\uac00 \uc5c6\ub358 \uc2dc\uc808 \ud654\uac00\ub4e4\uc774 \uadf8\ub9b0 \ud45c\uc9c0\uc640 \uad50\uacfc\uc11c\uc758 '\ucca0\uc218\uc640 \uc601\ud76c' \uc0bd\ud654\ub97c \uac10\uc0c1\ud558\uc600\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa9\uacf5\uc18c: \uc870\uc120 \ubaa9\uc218\ub4e4\uc758 \uac00\uad6c\ub97c \ud604\ub300\uc2dd \uae08\uc18d \ubc0f \ud50c\ub77c\uc2a4\ud2f1 \uc7ac\ub8cc\ub85c \uac1c\uc870\ud55c \ucca8\ub2e8 \uc791\ud488\uc744 \uad00\ub78c\ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubaa9\uacf5\uc18c\uc5d0\uc11c\ub294 \uae08\uc18d \uc7ac\ub8cc\uac00 \uc544\ub2cc \uc870\uc120 \ubaa9\uc218\ub4e4\uc758 \ucca0\ud559\uc774 \ub2f4\uae34 \ub098\ubb34 \uac00\uad6c\ub97c \uc7ac\ud604\ud558\uace0 \uc5f0\uc7a5\uc744 \uc804\uc2dc\ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubaa9\uacf5\uc18c \uc804\uc2dc \ub0b4\uc6a9 \uc911 \ub098\ubb34 \uac00\uad6c\ub97c \uc7ac\uc0dd\ud558\uac70\ub098 \ud45c\ud604\ud55c \ubc29\uc2dd\uc5d0 \ub300\ud574 \ubcf8\ubb38 \uae00\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c\uc744 \ubaa8\ub450 \ub458\ub7ec\ubcf8 \ud6c4 \ub0b4\ub9b0 \uad81\uadf9\uc801\uc778 \uac10\uc0c1\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc77c\uc81c \uc218\ud0c8\uc758 \uc544\ud514\uc774 \ub0a8\uae34 \ub0a1\uc740 \uc61b \ucc3d\uace0 \uac74\ubb3c\ub4e4\uc740 \uc870\uc18d\ud788 \ucca0\uac70\ub418\uc5b4\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae00\uc4f4\uc774\ub294 \ub0a1\uc740 \uc720\uc0b0\uc744 \uc5c6\uc560\uae30\ubcf4\ub2e4 \uc6d0\ud615\uc744 \ubcf4\uc874\ud558\uba70 \ubb38\ud654 \uc608\uc220 \uacf5\uac04\uc73c\ub85c \uc7ac\uc0dd\ud55c \uc810\uc744 \uae0d\uc815\uc801\uc73c\ub85c \ud3c9\uac00\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uacfc\uac70\uc758 \uc544\ud514\uc774 \ub2f4\uae34 \uc720\uc0b0\uacfc \ud604\ub300\uc758 \ubb38\ud654 \uc608\uc220\uc774 \uacf5\uc874\ud558\uba70 \uc2dc\uac04\uc740 \ud558\ub098\ub85c \uc774\uc5b4\uc838 \ud750\ub978\ub2e4.",
          "isCorrect": true,
          "rationale": "\uae00\uc4f4\uc774\ub294 \uacfc\uac70, \ud604\uc7ac, \ubbf8\ub798\uac00 \ub0a8\ub0a8\uc774 \uc544\ub2c8\ub77c \uace0\ud1b5\uc758 \uc720\uc0b0\uacfc \ubb38\ud654 \uc608\uc220\uc774 \uacf5\uc874\ud558\uba70 \ud758\ub7ec\uac10\uc744 \uae68\ub2eb\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub514\uc9c0\ud138 \uae30\uc220\uc758 \ubc1c\ub2ec\ub85c \uc778\ud574 \uc778\uc1c4 \ub9e4\uccb4\uc640 \uc544\ub0a0\ub85c\uadf8 \uc804\uc2dc \uacf5\uac04\uc740 \uc810\ucc28 \uc0ac\ub77c\uc9c8 \uac83\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae00\uc4f4\uc774\ub294 \ub514\uc9c0\ud138\uacfc \uc544\ub0a0\ub85c\uadf8, \uc624\ub798\ub41c \uac83\uacfc \uc0c8\ub85c\uc6b4 \uac83\uc774 \uc11c\ub85c \uc18c\ud1b5\ud558\uace0 \uc5b4\uc6b0\ub7ec\uc9d0\uc744 \uac15\uc870\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc5ed \uacbd\uc81c\ub97c \uc0b4\ub9ac\uae30 \uc704\ud574 \uc608\uc220\ucd0c\uc744 \ub300\uaddc\ubaa8 \ud604\ub300\uc2dd \uc0c1\uc5c5 \ubcf5\ud569 \uc1fc\ud551\ubab0\ub85c \ud0c8\ubc14\uafc8\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae00\uc4f4\uc774\ub294 \ucc3d\uace0\uc758 \uc6d0\ud615\uc744 \uc0b4\ub9ac\uace0 \ubb38\ud654\uc801 \ud488\uaca9\uc744 \uc9c0\ub2cc \ud604\uc7ac\uc758 \uacf5\uac04\uc5d0 \ub9e4\ud639\uacfc \uc815\uaca8\uc6c0\uc744 \ub290\ub08d\ub2c8\ub2e4."
        }
      ],
      "hint": "\uae00\uc758 \ub9c8\uc9c0\ub9c9 \ubd80\ubd84\uc5d0 \uc81c\uc2dc\ub41c \uc2dc\uac04\uacfc \uc5ed\uc0ac, \ubb38\ud654 \uc608\uc220\uc5d0 \ub300\ud55c \uae00\uc4f4\uc774\uc758 \uc131\ucc30\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae30\ud589\ubb38\uc744 \uc791\uc131\ud560 \ub54c \uac16\ucd94\uc5b4\uc57c \ud560 \uc8fc\uc694 \uad6c\uc131 \uc694\uc18c \uc138 \uac00\uc9c0\ub85c \uc633\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc7c1\uc810, \ud0c0\ud611, \uc774\ud574\uad00\uacc4",
          "isCorrect": false,
          "rationale": "\uc7c1\uc810, \ud0c0\ud611, \uc774\ud574\uad00\uacc4\ub294 \uc18c\ud1b5 \ubc29\uc2dd \uc911 '\ud611\uc0c1'\uc758 \uc8fc\uc694 \uad6c\uc131 \uc694\uc18c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc5ec\uc815, \uacac\ubb38, \uac10\uc0c1",
          "isCorrect": true,
          "rationale": "\uae30\ud589\ubb38\uc740 \uc5b4\ub514\ub97c \ub2e4\ub2c8\ub294\uc9c0(\uc5ec\uc815), \ubb34\uc5c7\uc744 \ubcf4\uace0 \ub4e4\uc5c8\ub294\uc9c0(\uacac\ubb38), \ubb34\uc5c7\uc744 \ub290\uaf08\ub294\uc9c0(\uac10\uc0c1)\ub97c \uc911\uc2ec\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub3d9\uae30, \uacfc\uc815, \uacb0\uacfc",
          "isCorrect": false,
          "rationale": "\uc77c\ubc18\uc801\uc778 \ubcf4\uace0\uc11c\ub098 \uc2e4\ud5d8 \uae30\ub85d\uc5d0 \uc790\uc8fc \uc4f0\uc774\ub294 \uad6c\uc870 \uc694\uc18c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc11c\ub860, \ubcf8\ub860, \uacb0\ub860",
          "isCorrect": false,
          "rationale": "\ub17c\uc124\ubb38\uc774\ub098 \uc124\uba85\ubb38 \ub4f1 \ub17c\ub9ac\uc801 \uae00\uc4f0\uae30\uc5d0\uc11c \ud754\ud788 \uc0ac\uc6a9\ud558\ub294 \ub17c\ub9ac\uc801 3\ub2e8\uacc4 \uad6c\uc870\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc5ec\ud589\uc744 \ub5a0\ub098\uc11c \uc5b4\ub514\ub97c \uac70\ucce4\uace0 \ubb34\uc5c7\uc744 \ubcf4\uace0 \ub4e4\uc5c8\uc73c\uba70 \uc5b4\ub5a4 \uc810\uc744 \ub290\uaf08\ub294\uc9c0 \ub098\ud0c0\ub0b4\ub294 \uc694\uc18c\ub4e4\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\uae00\uc4f0\uae30 \uacfc\uc815 \uc911 '\ub0b4\uc6a9 \uc870\uc9c1\ud558\uae30' \ub2e8\uacc4\uc5d0 \ud574\ub2f9\ud558\ub294 \ud65c\ub3d9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uae00\uc744 \uc4f0\ub294 \ubaa9\uc801, \uc608\uc0c1 \ub3c5\uc790, \uae00\uc758 \uc885\ub958\uc640 \ud65c\uc6a9 \ub9e4\uccb4\ub97c \uc124\uc815\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae00\uc758 \ubaa9\uc801, \uc608\uc0c1 \ub3c5\uc790, \ub9e4\uccb4 \ub4f1\uc744 \uacb0\uc815\ud558\ub294 \uac83\uc740 '\uacc4\ud68d\ud558\uae30' \ub2e8\uacc4\uc758 \ud65c\ub3d9\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc8fc\uc81c\uc640 \uad00\ub828\ub41c \uc544\uc774\ub514\uc5b4\ub97c \ub5a0\uc62c\ub9ac\uace0 \ud544\uc694\ud55c \ucc38\uace0 \uc790\ub8cc\ub97c \ub2e4\uc591\ud558\uac8c \uc218\uc9d1\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\uac01\uc744 \ub5a0\uc62c\ub9ac\uace0 \uc790\ub8cc\ub97c \uc218\uc9d1\ud558\ub294 \uac83\uc740 '\ub0b4\uc6a9 \uc0dd\uc131\ud558\uae30' \ub2e8\uacc4\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud575\uc2ec \ub0b4\uc6a9\uacfc \uc218\uc9d1\ud55c \uc790\ub8cc\ub97c \uccb4\uacc4\uc801\uc73c\ub85c \ubc30\uc5f4\ud558\uc5ec \uac1c\uc694\ub97c \uc791\uc131\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\uc694\ub97c \uc791\uc131\ud558\uace0 \uc790\ub8cc \ud65c\uc6a9 \uacc4\ud68d\uc744 \uc138\uc6cc \uae00\uc758 \uc804\uccb4 \uad6c\uc870\ub97c \uc7a1\ub294 \uac83\uc774 '\ub0b4\uc6a9 \uc870\uc9c1\ud558\uae30' \ub2e8\uacc4\uc785\ub2c8\ub2e4."
