    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc138 \uad6d\uc5b4\uc640 \ub2ec\ub9ac \ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c \uc0c8\ub86d\uac8c \ub3c4\uc785\ub418\uc5b4 \uc4f0\uc774\ub294 \uc8fc\uaca9 \uc870\uc0ac\ub294 \ubb34\uc5c7\uc778\uac00?"
