    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc0dd\uac01\uac74\ub300'\uc640 '\uc0dd\uac01\ucee8\ub300' \uc911 \uc62c\ubc14\ub978 \ud45c\uae30\uc640 \uadf8 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
