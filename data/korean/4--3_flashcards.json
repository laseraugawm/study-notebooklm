        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c \ud615\ud0dc\uc18c\uc758 \ubcf8\ub798 \ubaa8\uc591\uc744 \ubc1d\ud788\uc5b4 \uc801\ub294 \ud55c\uae00 \ub9de\ucda4\ubc95\uc758 \ud45c\uae30 \uc6d0\uce59\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
