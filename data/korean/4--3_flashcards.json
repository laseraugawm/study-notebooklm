      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud45c\uc758\uc8fc\uc758 \ud45c\uae30 (\uc5b4\ubc95\uc5d0 \ub9de\ub3c4\ub85d \uc801\uc74c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uaf3c\uaf3c\ud788'\uc640 '\uaf3c\uaf3c\uc774' \uc911 \ud55c\uae00 \ub9de\ucda4\ubc95\uc5d0 \ub9de\ub294 \uc62c\ubc14\ub978 \ud45c\uae30\ub294 \ubb34\uc5c7\uc778\uac00?"
