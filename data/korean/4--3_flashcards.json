    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ub9e4\uccb4 \ud658\uacbd\uc5d0\uc11c \ubc14\ub78c\uc9c1\ud55c \uad6d\uc5b4\uc0dd\ud65c\uc744 \uc704\ud574 \uac16\ucd94\uc5b4\uc57c \ud560 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
