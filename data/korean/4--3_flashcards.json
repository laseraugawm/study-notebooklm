      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc0\ud654\ud55c \ub9e4\uccb4 \ud658\uacbd\uacfc \uc18c\ud1b5 \ud2b9\uc131\uc744 \uc62c\ubc14\ub974\uac8c \uc774\ud574\ud558\uace0, \ub9e4\uccb4\ub97c \ud65c\uc6a9\ud55c \ub098\uc758 \uc5b8\uc5b4 \uc2b5\uad00\uacfc \uc18c\ud1b5 \ubb38\ud654\ub97c \uc131\ucc30\ud558\ub294 \ud0dc\ub3c4"
          }
        ]
