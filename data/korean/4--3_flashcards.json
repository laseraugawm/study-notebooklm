      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc62c\ubc14\ub978 \ud45c\uae30: '\uc0dd\uac01\uac74\ub300'\n\uc6d0\ub9ac: \uc548\uc6b8\ub9bc\uc18c\ub9ac(\u3131) \ub4a4\uc5d0\uc11c '\ud558'\uac00 \uc644\uc804\ud788 \uc904\uc5b4\ub4e4 \ub54c '\uac74\ub300'\ub85c \ud45c\uae30\ud568."
