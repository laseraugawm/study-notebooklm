      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub313\uae00, \ucabd\uc9c0(\uac1c\uc778 \uba54\uc2dc\uc9c0), \uacf5\uc720\ud558\uae30 \uae30\ub2a5"
          }
        ]
