        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uc220 \ub9e4\uccb4 \ud658\uacbd\uc5d0\uc11c \uc815\ubcf4 \uc804\ub2ec\uc758 \uc2e0\ub8b0\uc131\uacfc \uc628\uc804\ud568\uc5d0 \ud55c\uacc4\uac00 \uc0dd\uacbc\ub358 \uc8fc\ub41c \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
