{
  "title": "\ub9e4\uccb4\uc640\uad6d\uc5b4 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ub958\uc758 \ub9e4\uccb4 \ubc1c\uc804 \uacfc\uc815\uc744 \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud558\uba74 \uc5b4\ub5bb\uac8c \ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uc220 \ub9e4\uccb4 \u2192 \ubb38\uc790 \ub9e4\uccb4 \u2192 \uc601\uc0c1 \ub9e4\uccb4 \u2192 \ub514\uc9c0\ud138 \ub9e4\uccb4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uac00 \ubc1c\uba85\ub418\uae30 \uc804 \uc778\ub958\uac00 \uc8fc\ub85c \uc0ac\uc6a9\ud55c \uad6c\uc220 \ub9e4\uccb4\uc758 \ud575\uc2ec \uc18c\ud1b5 \uc218\ub2e8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc74c\uc131 \uc5b8\uc5b4(\ub9d0\ud558\uae30)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uc220 \ub9e4\uccb4\ub97c \ud1b5\ud55c \uc18c\ud1b5\uc758 \uac00\uc7a5 \ud070 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc790\uc640 \uccad\uc790\uac00 \uc9c1\uc811 \ub300\uba74\ud558\uc5ec \uc0c1\ud669\uacfc \ub9e5\ub77d\uc744 \uacf5\uc720\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uc220 \ub9e4\uccb4\uac00 \uc9c0\ub2cc \uacb0\uc815\uc801\uc778 \ud55c\uacc4\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\ub978 \uc2dc\uac04\ub300\uc640 \ub2e4\ub978 \uacf5\uac04\uc758 \uc0ac\ub78c\uacfc \uc18c\ud1b5\ud558\uae30 \uc5b4\ub824\uc6b0\uba70, \uc9c0\uc2dd\uacfc \uc815\ubcf4\uc758 \uae30\ub85d\u00b7\ubcf4\uc874\u00b7\uc720\ud1b5\uc5d0 \ud55c\uacc4\uac00 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uc220 \ub9e4\uccb4\uc758 \uc2dc\uacf5\uac04\uc801 \ud55c\uacc4\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \ub4f1\uc7a5\ud55c \ub9e4\uccb4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790 \ub9e4\uccb4(\ud3b8\uc9c0, \ubb38\uc11c, \ucc45 \ub4f1)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790 \ub9e4\uccb4\ub97c \uc911\uc2ec\uc73c\ub85c \ud615\uc131\ub418\ub294 \uc18c\ud1b5 \ubc29\uc2dd\uc758 \ub450 \uac00\uc9c0 \ucd95\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc4f0\uae30\uc640 \uc77d\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790 \ub9e4\uccb4\ub97c \ud1b5\ud55c \uc18c\ud1b5\uc5d0\uc11c '\ud0c8\uc0c1\ud669\uc801, \ud0c8\ub9e5\ub77d\uc801 \uc18c\ud1b5'\uc774 \uc77c\uc5b4\ub098\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc4f4\uc774\uc640 \ub3c5\uc790\uac00 \uc4f0\uae30\uc640 \uc77d\uae30 \uc2dc\uc810\uc758 \uc2dc\uacf5\uac04\uc801 \uc0c1\ud669\uc744 \uc9c1\uc811 \uacf5\uc720\ud558\uc9c0 \uc54a\uace0 \ubd84\ub9ac\ub418\uc5b4 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uc1c4\uc220\uc758 \ubc1c\ub2ec\uc774 \ubb38\uc790 \ub9e4\uccb4 \uc18c\ud1b5 \ubb38\ud654\uc5d0 \ubbf8\uce5c \uac00\uc7a5 \uc911\uc694\ud55c \uc601\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc45\uc758 \ub300\ub7c9 \uc720\ud1b5\uc744 \uac00\ub2a5\ud558\uac8c \ud558\uc5ec \uc9c0\uc2dd\uacfc \uc815\ubcf4\uc758 \uae30\ub85d\u00b7\ucd95\uc801\u00b7\uc720\ud1b5\uc744 \uc218\uc6d4\ud558\uac8c \ud558\uace0 \uc9c0\uc2dd\uc758 \ub300\uc911\ud654\ub97c \uc774\ub8e8\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ud654\ub098 \ud154\ub808\ube44\uc804 \ub4f1 \uc601\uc0c1 \ub9e4\uccb4\uc758 \uc815\ubcf4 \uc804\ub2ec \ubc29\uc2dd\uc774 \uc9c0\ub2cc \uc8fc\uc694 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uccad\uac01 \uc774\ubbf8\uc9c0 \uc911\uc2ec\uc73c\ub85c \uc815\ubcf4\uac00 \uc804\ub2ec\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc6a9\uc790\uc758 \uc815\ubcf4 \uc218\uc6a9 \uce21\uba74\uc5d0\uc11c \ubb38\uc790 \ub9e4\uccb4\uc640 \uc601\uc0c1 \ub9e4\uccb4\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790 \ub9e4\uccb4\ub294 \uae00\uc744 \uc77d\uace0 \uc774\ud574\ud558\ub294 \ub2a5\ub825(\ubb38\uc2dd\uc131)\uc5d0 \ub530\ub77c \ucc28\uc774\uac00 \ubc1c\uc0dd\ud558\uc9c0\ub9cc, \uc601\uc0c1 \ub9e4\uccb4\ub294 \ubcf4\ud3b8\uc801\uc73c\ub85c \ub0b4\uc6a9\uc744 \uc27d\uac8c \uc774\ud574\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\uc0c1 \ub9e4\uccb4\uac00 \uc0ac\ud68c \ubc0f \ub300\uc911\uc5d0\uac8c \uac15\ud55c \uc601\ud5a5\ub825\uc744 \ubbf8\uce58\uac8c \ub41c \uc6d0\uc778\uc740 \ub300\uc911\ub9e4\uccb4\uc758 \uc5b4\ub5a4 \ud2b9\uc131 \ub54c\ubb38\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc218\uc758 \uc218\uc6a9\uc790\uac00 \ub3d9\uc2dc\uc5d0 \uc815\ubcf4\ub97c \uc218\uc6a9\ud558\uace0 \uacf5\uc720\ud560 \uc218 \uc788\ub294 \ud2b9\uc131 \ub54c\ubb38\uc5d0 \uc601\ud5a5\ub825\uc774 \ucee4\uc84c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ub9e4\uccb4\ub294 \uc774\uc804 \ub9e4\uccb4\ub4e4\uc758 \uc5b4\ub5a0\ud55c \ud2b9\uc131\uc744 \uc885\ud569\ud558\uace0 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uc220 \ub9e4\uccb4, \ubb38\uc790 \ub9e4\uccb4, \uc601\uc0c1 \ub9e4\uccb4\uc758 \ud2b9\uc131\uc744 \ubcf5\ud569\uc801\uc73c\ub85c \uc9c0\ub2c8\uace0 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 \ub450\ub4dc\ub7ec\uc9c4 \ub300\ud45c\uc801 \ud2b9\uc9d5 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf5\ud569\uc591\uc2dd\uc131, \ud558\uc774\ud37c\ud14d\uc2a4\ud2b8, \uc0c1\ud638 \uc791\uc6a9\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 '\ubcf5\ud569\uc591\uc2dd\uc131'\uc774\ub780 \ubb34\uc2a8 \ub73b\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc74c\uc131, \ubb38\uc790, \uadf8\ub9bc, \ub3d9\uc601\uc0c1 \ub4f1 \ub2e4\uc591\ud55c \uae30\ud638 \uccb4\uacc4\uac00 \ud63c\ud569\ub418\uc5b4 \ub098\ud0c0\ub098\ub294 \ud2b9\uc131\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 '\ud558\uc774\ud37c\ud14d\uc2a4\ud2b8(Hypertext)' \uac1c\ub150\uacfc \uc7a5\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc6a9\uc790\uac00 \ub2e4\ub978 \ubb38\uc11c\ub098 \uc815\ubcf4\ub85c \ubc14\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\uac8c \uc81c\uacf5\ub418\ub294 \ud14d\uc2a4\ud2b8\ub85c, \uc6d0\ud558\ub294 \uc815\ubcf4\ub97c \uc190\uc27d\uac8c \uc120\ud0dd\ud574 \uc774\ub3d9\ud558\uba70 \uc5bb\uc744 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 '\uc0c1\ud638 \uc791\uc6a9\uc131'\uc774 \uc758\ubbf8\ud558\ub294 \uc774\uc6a9\uc790\uc758 \uc5ed\ud560 \ubcc0\ud654\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc6a9\uc790\uac00 \ub2e8\uc21c\ud55c \uc815\ubcf4 \uc18c\ube44\uc790\uc5d0 \uba38\ubb34\ub974\uc9c0 \uc54a\uace0, \uc9c1\uc811 \uc815\ubcf4\ub97c \uc0dd\uc131\u00b7\uacf5\uc720\ud558\ub294 \uc0dd\uc0b0\uc790 \uc5ed\ud560\uc744 \uacb8\ud558\uac8c \ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874 \ub300\uc911\ub9e4\uccb4\uc640 \ub514\uc9c0\ud138 \ub9e4\uccb4\uc758 \uc815\ubcf4 \uc804\ub2ec \ubc29\ud5a5\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874 \ub300\uc911\ub9e4\uccb4\ub294 \uc0dd\uc0b0\uc790\uc5d0\uc11c \uc218\uc6a9\uc790\ub85c \uc77c\ubc29\ud5a5 \uc804\ub2ec\ub418\uc9c0\ub9cc, \ub514\uc9c0\ud138 \ub9e4\uccb4\ub294 \uc0dd\uc0b0\uc790\uc640 \uc218\uc6a9\uc790 \uac04 \uc30d\ubc29\ud5a5\uc73c\ub85c \uc18c\ud1b5\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c \uad00\uacc4\ub9dd \uc11c\ube44\uc2a4(SNS)\uac00 \ud604\ub300 \uc18c\ud1b5 \ubb38\ud654\uc5d0 \uac00\uc838\uc628 \uc8fc\uc694 \ubcc0\ud654\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc6a9\uc790 \uac04 \uc790\uc720\ub85c\uc6b4 \uc758\uc0ac\uc18c\ud1b5\uacfc \uc815\ubcf4 \uacf5\uc720\uac00 \uc218\uc6d4\ud574\uc9c0\uace0, \uc778\ub9e5 \ud655\ub300\ub97c \ud1b5\ud574 \uc0c8\ub85c\uc6b4 \uc0ac\ud68c\uc801 \uad00\uacc4\ub97c \ub9fa\uc744 \uc218 \uc788\uac8c \ub418\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\uc778 \ubbf8\ub514\uc5b4 \ubc29\uc1a1\uc5d0\uc11c \uc2dc\uacf5\uac04\uc758 \uc81c\uc57d\uc744 \ubc1b\uc9c0 \uc54a\uace0 \uc2e4\uc2dc\uac04\uc73c\ub85c \uc18c\ud1b5\ud560 \uc218 \uc788\uac8c \ud574 \uc8fc\ub294 \ub300\ud45c\uc801 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub313\uae00\uacfc \uc2e4\uc2dc\uac04 \ub300\ud654(\ucc44\ud305) \uae30\ub2a5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ud1b5 \uae30\uc220\uc758 \ubcc0\ud654\uc640 \uc18c\ud1b5 \ubb38\ud654\uc758 \uc0c1\ud638 \uad00\uacc4\ub294 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ud1b5 \uae30\uc220\uc758 \ubcc0\ud654\ub294 \uc18c\ud1b5 \ubb38\ud654\uc758 \ubc1c\uc804\uc73c\ub85c \uc774\uc5b4\uc9c0\uace0, \ubc1c\uc804\ub41c \uc18c\ud1b5 \ubb38\ud654\ub294 \ub2e4\uc2dc \uc0c8\ub85c\uc6b4 \uae30\uc220\uc758 \uc9c4\ud654\ub97c \uc694\uad6c\ud558\uba70 \uae34\ubc00\ud788 \uc601\ud5a5\uc744 \uc8fc\uace0\ubc1b\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc2dc\ud0dc\uadf8(Hashtag)\uc758 \uc815\uc758\uc640 \ud65c\uc6a9 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \ud575\uc2ec\uc5b4 \uc55e\uc5d0 \uae30\ud638 '#'\uc744 \ubd99\uc5ec \uac8c\uc2dc\ubb3c\uc758 \uc8fc\uc81c\ub97c \ud45c\uc2dc\ud558\ub294 \ubc29\ubc95\uc73c\ub85c, \uac19\uc740 \ud574\uc2dc\ud0dc\uadf8\uac00 \ubd99\uc740 \uae00\uc744 \ubaa8\uc544\ubcf4\ub294 \ub370 \uc0ac\uc6a9\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub798 \ub514\uc9c0\ud138 \ub9e4\uccb4 \uac8c\uc2dc\ubb3c\uc5d0\uc11c \ud65c\uc6a9\ub41c \uc18c\ud1b5 \uc218\ub2e8\uacfc \ubc29\uc2dd\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4:"
          },
          {
            "type": "image",
            "reference": "c91122f0-5966-42b9-9126-35a842c417f6",
            "alt": "\uac15\uc544\uc9c0\ub97c \ucc3e\uc2b5\ub2c8\ub2e4 \uae00\uacfc \uacf5\uc720, \ucabd\uc9c0, \ub313\uae00 \ubc18\uc751\uc774 \uc788\ub294 \uac8c\uc2dc\ubb3c"
          },
          {
            "type": "text",
            "content": "\uac8c\uc2dc\ubb3c \uc791\uc131\uc790\uc640 \uc774\uc6a9\uc790\ub4e4\uc740 \uc5b4\ub5a4 \uae30\ub2a5\uc744 \ud1b5\ud574 \uc815\ubcf4\ub97c \uc8fc\uace0\ubc1b\uace0 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub313\uae00, \ucabd\uc9c0, \uac8c\uc2dc\ubb3c \uacf5\uc720 \uae30\ub2a5\uc744 \uc774\uc6a9\ud558\uc5ec \uc2dc\uacf5\uac04 \uc81c\uc57d \uc5c6\uc774 \uc30d\ubc29\ud5a5\uc73c\ub85c \ube60\ub974\uac8c \uc815\ubcf4\uc640 \uc5f0\ub77d\ucc98\ub97c \uc8fc\uace0\ubc1b\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\ud559 \uc9c0\uc2dd\uc744 \uc804\ub2ec\ud558\ub294 \uc0c1\ud669\uc5d0\uc11c (\uac00) \uad6c\uc220 \uc18c\ud1b5 \ubc29\uc2dd\uacfc (\ub098) \ubb38\uc790 \uc18c\ud1b5 \ubc29\uc2dd\uc758 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "(\uac00) \uad6c\uc220: \ud55c\uc758\uc0ac\uc640 \ud658\uc790\uac00 \uc9c1\uc811 \ub300\uba74\ud558\uc5ec \uc0c1\ud669/\ub9e5\ub77d\uc744 \uacf5\uc720\ud558\uba70 \uc77c\ub300\uc77c\ub85c \uc18c\ud1b5\ud568.\n(\ub098) \ubb38\uc790: \ucc45 \ud615\ud0dc\ub85c \uc9c0\uc2dd\uc744 \uae30\ub85d\ud558\uc5ec \uc9c1\uc811 \ub300\uba74\ud558\uc9c0 \uc54a\ub294 \ud6c4\ub300\uc758 \uc218\ub9ce\uc740 \ub300\uc911\uc5d0\uac8c \uc2dc\uacf5\uac04\uc744 \ucd08\uc6d4\ud558\uc5ec \uc9c0\uc2dd\uc744 \uc804\ub2ec\ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "TV \ub274\uc2a4(\uc601\uc0c1 \ub9e4\uccb4)\uc640 \uc778\ud130\ub137 \uc2e0\ubb38 \uae30\uc0ac(\ub514\uc9c0\ud138 \ub9e4\uccb4)\uc758 \uacf5\ud1b5\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub274\uc2a4\uc758 \ud575\uc2ec \ub0b4\uc6a9\uc744 \uc81c\ubaa9\uc73c\ub85c \uc81c\uc2dc\ud558\uc5ec \uc815\ubcf4 \uc804\ub2ec\uc758 \ud6a8\uacfc\ub97c \ub192\uc778\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub798 \uc778\ud130\ub137 \ub274\uc2a4 \ud654\uba74\uc5d0\uc11c \ubcfc \uc218 \uc788\ub4ef\uc774 \ub514\uc9c0\ud138 \ub274\uc2a4\uac00 TV \ub274\uc2a4\uc5d0 \ube44\ud574 \uac00\uc9c0\ub294 \ub3c5\uc790\uc801\uc778 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          },
          {
            "type": "image",
            "reference": "67f7aec0-97c9-4312-8f88-c667ec6367eb",
            "alt": "\uad00\ub828 \uae30\uc0ac \ub9c1\ud06c, \ub313\uae00 \uc791\uc131, \uacf5\uac10 \ubc0f \uacf5\uc720 \uae30\ub2a5\uc774 \ud3ec\ud568\ub41c \uc778\ud130\ub137 \ub274\uc2a4"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud558\uc774\ud37c\ud14d\uc2a4\ud2b8\ub97c \ud1b5\ud574 \uad00\ub828 \uae30\uc0ac\ub85c \uc27d\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uc73c\uba70, \uacf5\uac10 \ud45c\ud604, SNS \uacf5\uc720, \ub313\uae00 \uc791\uc131 \ub4f1\uc744 \ud1b5\ud574 \ub3c5\uc790\uac00 \ub2a5\ub3d9\uc801\uc73c\ub85c \ucc38\uc5ec\ud558\uace0 \uc30d\ubc29\ud5a5 \uc18c\ud1b5\uc744 \uc218\ud589\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub798 1\uc778 \ubbf8\ub514\uc5b4 \ubc29\uc1a1 \uc608\uc2dc\uc5d0\uc11c \ubcfc \uc218 \uc788\ub294 \uc18c\ud1b5 \ubc29\uc2dd\uc758 \ud2b9\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
          },
          {
            "type": "image",
            "reference": "7664ff1d-0cf4-48f4-a246-f703fa26accf",
            "alt": "\uc2e4\uc2dc\uac04 \ucc44\ud305 \ub313\uae00\ub85c \ub808\uc2dc\ud53c\ub97c \ubb3b\uace0 \ub2f5\ud558\ub294 1\uc778 \ubbf8\ub514\uc5b4 \ubc29\uc1a1 \ubc18\uc9dd \uc2dd\ud0c1"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c4\ud589\uc790\uc640 \uc2dc\uccad\uc790\uac00 \uc74c\uc131, \uc601\uc0c1, \uc2e4\uc2dc\uac04 \ub313\uae00 \ub4f1\uc744 \uc870\ud569\ud55c \ubcf5\ud569\uc591\uc2dd\uc73c\ub85c \uc2dc\uacf5\uac04\uc758 \uc81c\uc57d \uc5c6\uc774 \uc30d\ubc29\ud5a5\uc73c\ub85c \uc2e4\uc2dc\uac04 \uc18c\ud1b5\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc138 \uad6d\uc5b4\uc758 \ub2e8\uc5b4 '\uc5b4\uc5ff\ube44'\uc758 \ub2f9\uc2dc \uc758\ubbf8\uc640 \ud604\ub300 \uad6d\uc5b4\uc5d0\uc11c\uc758 \uc758\ubbf8\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc138 \uad6d\uc5b4: '\ubd88\uc30d\ud788' / \ud604\ub300 \uad6d\uc5b4: '\uc608\uc058\uac8c' (\uc758\ubbf8\uc758 \uc774\ub3d9)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc138 \uad6d\uc5b4\uc5d0\uc11c '\ub9d0\uc528\ubbf8', '\ub178\ubbf8'\uc640 \uac19\uc774 \ud615\ud0dc\uc18c\uc758 \ubaa8\uc2b5\uc744 \ubc1d\ud788\uc9c0 \uc54a\uace0 \uc18c\ub9ac \ub098\ub294 \ub300\ub85c \uc801\uc740 \ud45c\uae30 \ubc29\uc2dd\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
