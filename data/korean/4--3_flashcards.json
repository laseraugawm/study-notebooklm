    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ub9e4\uccb4\uc5d0\uc11c \uc815\ubcf4\uc758 \uc218\uc6a9\uc790\uac00 \uc815\ubcf4 \uc0dd\uc0b0\uc5d0 \ub2a5\ub3d9\uc801\uc73c\ub85c \uac1c\uc785\ud560 \uc218 \uc788\ub294 \ub300\ud45c\uc801 \uc18c\ud1b5 \uc218\ub2e8 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
