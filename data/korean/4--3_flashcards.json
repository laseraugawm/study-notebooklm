      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4\uac00 \uc785\uc5d0\uc11c \uc785\uc73c\ub85c \uc804\ud574\uc9c0\ub294 '\uad6c\uc804(\u53e3\u50b3)'\uc5d0 \uc758\uc874\ud558\uc600\uae30 \ub54c\ubb38\uc774\ub2e4."
