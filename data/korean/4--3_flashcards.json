      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc5b4\uc801\uae30(\uc5f0\ucca0) / \ud45c\uc74c\uc8fc\uc758 \ud45c\uae30"
