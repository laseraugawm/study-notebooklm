      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uaca9 \uc870\uc0ac '\uac00' (\uc911\uc138 \uad6d\uc5b4\uc5d0\uc11c\ub294 '\uc774' \uacc4\uc5f4\ub9cc \uc4f0\uc784)"
