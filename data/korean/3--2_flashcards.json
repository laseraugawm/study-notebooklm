{
  "title": "\uad6d\uc5b4 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b8\uc5b4 \uacf5\ub3d9\uccb4\uac00 \uae00\uc744 \uc4f8 \ub54c \uacf5\uc720\ud558\ub294 \uc804\ud615\uc801\uc778 \uad6c\uc870, \uc804\uac1c \ubc29\uc2dd, \ud45c\ud604 \ubc29\uc2dd\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\ubb38 \uad00\uc2b5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\ubb38 \uad00\uc2b5\uc5d0\uc11c \uae00\uc758 \uc885\ub958\uc5d0 \ub530\ub978 \uc804\ud615\uc801 \ud615\uc2dd \uc678\uc5d0, \uc6b0\ub9ac \uc5b8\uc5b4 \uacf5\ub3d9\uccb4\uc758 \ud2b9\uc131\uc0c1 \uc911\uc2dc\ub418\ub294 \ud45c\ud604 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc790\ub97c \uc874\uc911\ud558\uace0 \ubc30\ub824\ud558\ub294 \uc608\uc808 \ubc14\ub978 \ud45c\ud604"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc744 \uc4f8 \ub54c \uac1c\uc778\uc801\u00b7\uc0ac\ud68c\uc801 \ucc28\uc6d0\uc5d0\uc11c \uc9c0\ucf1c\uc57c \ud558\ub294 \ub3c4\ub355\uc801 \uaddc\ubc94\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\ubb38 \uc724\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\ubb38 \uc724\ub9ac\ub97c \uc900\uc218\ud558\uae30 \uc704\ud574 \uac1c\uc778\uc801 \ucc28\uc6d0\uc5d0\uc11c \uc9c0\ucf1c\uc57c \ud560 \ud575\uc2ec \uc790\uc138\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uac01, \ub290\ub08c, \uacbd\ud5d8, \uc758\uacac \ub4f1\uc744 \uac70\uc9d3\uc73c\ub85c \uafb8\ubbf8\uc9c0 \uc54a\uace0 \uc9c4\uc194\ud558\uac8c \uc4f0\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\ubb38 \uc724\ub9ac\ub97c \uc900\uc218\ud558\uae30 \uc704\ud574 \uc0ac\ud68c\uc801 \ucc28\uc6d0\uc5d0\uc11c \uc9c0\ucf1c\uc57c \ud560 \ud575\uc2ec \uaddc\ubc94 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc778\uc758 \uc800\uc791\uad8c\uc744 \uc874\uc911\ud558\ub294 \uac83, \uc790\ub8cc\uc758 \ucd9c\ucc98\ub97c \uba85\ud655\ud788 \ubc1d\ud788\uace0 \ubb34\ub2e8\uc73c\ub85c \ubca0\ub07c\uc9c0(\ud45c\uc808\ud558\uc9c0) \uc54a\ub294 \uac83"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ud130\ub137 \ub9e4\uccb4 \ud658\uacbd\uc5d0\uc11c \uae00\uc758 \uc0ac\ud68c\uc801 \ud30c\uae09\ub825\uc774 \ucee4\uc9d0\uc5d0 \ub530\ub77c \ud544\uc790\uc5d0\uac8c \ud2b9\ud788 \uac15\uc870\ub418\ub294 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc45\uc784\uac10 \uc788\uac8c \uae00\uc744 \uc4f0\ub294 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ud589\uc744 \ub2e4\ub140\uc628 \ud6c4 \ubcf4\uace0, \ub4e3\uace0, \ub290\ub080 \ubc14\ub97c \uae30\ub85d\ud558\ub294 \uae00\uc758 \uac08\ub798\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38\uc744 \uad6c\uc131\ud558\ub294 \ud575\uc2ec 3\uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\uc815, \uacac\ubb38, \uac10\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38\uc758 3\uc694\uc18c \uc911 '\uc5ec\ud589\ud558\ub294 \uacfc\uc815\uc774\ub098 \uacf5\uac04\uc758 \uc774\ub3d9 \uacbd\ub85c'\ub97c \ub73b\ud558\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\uc815"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38\uc758 3\uc694\uc18c \uc911 '\uc5ec\ud589\uc9c0\uc5d0\uc11c \uc9c1\uc811 \ubcf4\uac70\ub098 \ub4e4\uc740 \uac1d\uad00\uc801 \uc0ac\uc2e4 \ubc0f \uc815\ubcf4'\ub97c \ub73b\ud558\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacac\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38\uc758 3\uc694\uc18c \uc911 '\uc5ec\ud589\uc9c0\uc5d0\uc11c \ubcf4\uace0 \ub4e4\uc740 \uac83\uc5d0 \ub300\ud574 \uae00\uc4f4\uc774\uac00 \ub290\ub080 \uc0dd\uac01\uc774\ub098 \uac10\uc815'\uc744 \ub73b\ud558\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18\uc801\uc778 \uae00 \uc4f0\uae30 \uacfc\uc815\uc758 5\ub2e8\uacc4\ub97c \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacc4\ud68d\ud558\uae30 $\\rightarrow$ \ub0b4\uc6a9 \uc0dd\uc131\ud558\uae30 $\\rightarrow$ \ub0b4\uc6a9 \uc870\uc9c1\ud558\uae30 $\\rightarrow$ \ud45c\ud604\ud558\uae30 $\\rightarrow$ \uace0\uccd0\uc4f0\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 \uc4f0\uae30 \uacfc\uc815 \uc911 '\uacc4\ud68d\ud558\uae30' \ub2e8\uacc4\uc5d0\uc11c \uc124\uc815\ud558\uac70\ub098 \uace0\ub824\ud574\uc57c \ud560 \uc694\uc18c 4\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc758 \ubaa9\uc801, \uc8fc\uc81c, \uc608\uc0c1 \ub3c5\uc790, \uae00\uc774 \uc2e4\ub9b4 \ub9e4\uccb4(\ubc0f \uae00\uc758 \uc885\ub958\uc640 \uc791\ubb38 \uad00\uc2b5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc4f0\uae30 \uacfc\uc815 \uc911 '\ub0b4\uc6a9 \uc0dd\uc131\ud558\uae30' \ub2e8\uacc4\uc5d0\uc11c \uc218\ud589\ud558\ub294 \uc8fc\uc694 \ud65c\ub3d9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc81c\uc640 \uad00\ub828\ub41c \uc544\uc774\ub514\uc5b4\ub97c \ub5a0\uc62c\ub9ac\uace0, \ud544\uc694\ud55c \uc790\ub8cc\ub97c \uc218\uc9d1\ud558\ub294 \ud65c\ub3d9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc4f0\uae30 \uacfc\uc815 \uc911 '\ub0b4\uc6a9 \uc870\uc9c1\ud558\uae30' \ub2e8\uacc4\uc5d0\uc11c \uc8fc\uc694\ud558\uac8c \uc791\uc131\ud558\ub294 \uae00\uc758 \ubf08\ub300\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc694 (\ubc0f \uc790\ub8cc \ud65c\uc6a9 \uacc4\ud68d)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc4f0\uae30 \uacfc\uc815 \uc911 '\ud45c\ud604\ud558\uae30' \ub2e8\uacc4\uc5d0\uc11c \uace0\ub824\ud574\uc57c \ud560 \ud575\uc2ec \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc758 \uc885\ub958\uc5d0 \ub530\ub978 \uc791\ubb38 \uad00\uc2b5, \uc608\uc0c1 \ub3c5\uc790\uc640\uc758 \uad00\uacc4, \ud6a8\uacfc\uc801\uc778 \ud45c\ud604 \uc804\ub7b5 \ubc0f \uac1c\uc694\uc758 \ud750\ub984"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc4f0\uae30 \uacfc\uc815 \uc911 '\uace0\uccd0\uc4f0\uae30' \ub2e8\uacc4\uc5d0\uc11c \uc810\uac80\ud574\uc57c \ud560 \uc791\ubb38 \uc724\ub9ac\uc801 \ud56d\ubaa9 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c4\uc194\ud558\uac8c \uc37c\ub294\uc9c0(\uacfc\uc7a5\uc774\ub098 \uac70\uc9d3\uc774 \uc5c6\ub294\uc9c0) \uc5ec\ubd80, \ud0c0\uc778\uc758 \uae00\uc744 \ubca0\ub07c\uc9c0 \uc54a\uace0 \ucd9c\ucc98\ub97c \uba85\ud655\ud788 \ubc1d\ud614\ub294\uc9c0 \uc5ec\ubd80"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc591\uace1 \ucc3d\uace0, \uc608\uc220\uc758 \uc0b0\uc2e4\ub85c \ubcc0\uc2e0\ud558\ub2e4\u300d\uc758 \uae00\uc4f4\uc774 \uc774\ud638\uc900\uc758 \uc9c1\uc5c5\uc801 \uc774\ub825 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ud589 \uc791\uac00, \uc2dc\uc778"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38 \u300c\uc591\uace1 \ucc3d\uace0, \uc608\uc220\uc758 \uc0b0\uc2e4\ub85c \ubcc0\uc2e0\ud558\ub2e4\u300d\uc758 \uc5ec\uc815 \uc11c\ub450\uc5d0 \uc81c\uc2dc\ub41c \uac15\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9cc\uacbd\uac15"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9cc\uacbd\uac15\uc758 \ubc1c\uc6d0\uc9c0\uc640 \ubc14\ub2e4\ub85c \ud758\ub7ec\ub4dc\ub294 \uc885\uc810\uc740 \uac01\uac01 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc644\uc8fc\uad70 \ub3d9\uc0c1\uba74 \uc728\uce58\uc758 \ubc24\uc0d8\uc5d0\uc11c \ubc1c\uc6d0\ud558\uc5ec \uc0c8\ub9cc\uae08\uc744 \uc9c0\ub098 \ubc14\ub2e4\ub85c \ud758\ub7ec\ub4e6"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9cc\uacbd\uac15\uc774 \ud1b5\uacfc\ud558\ub294 \uc8fc\uc694 \uc9c0\uc790\uccb4 \ubc0f \ud589\uc815 \uad6c\uc5ed\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\ubd81\ud2b9\ubcc4\uc790\uce58\ub3c4 \uc644\uc8fc\uad70, \uae40\uc81c, \uc775\uc0b0, \uad70\uc0b0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc81c \uac15\uc810\uae30 \ub2f9\uc2dc\uc5d0 \uc0bc\ub840\uac00 \uc591\uace1 \uc218\ud0c8\uc758 \uc8fc\uc694 \uae30\uc9c0\uac00 \ub418\uc5c8\ub358 \uc9c0\ub9ac\uc801\u00b7\uae30\ud6c4\uc801 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud1a0\uc9c0\uac00 \ube44\uc625\ud558\uace0 \uae30\ud6c4\uac00 \uc628\ud654\ud558\uc5ec \ub18d\uc0ac\uac00 \uc798\ub418\uc5c8\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc81c \uac15\uc810\uae30 \ub2f9\uc2dc \uc0bc\ub840\uc5ed\uc774 \uc591\uace1 \uc218\ud0c8 \uacfc\uc815\uc5d0\uc11c \ub9e1\uc558\ub358 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad70\uc0b0\uc73c\ub85c \uc591\uace1\uc744 \ub098\ub974\ub294 \uac70\uc810 \uc5ed\ud560"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc81c \uac15\uc810\uae30 \uc591\uace1 \ucc3d\uace0\uc758 \uc6d0\ud615\uc744 \ubcf4\uc804\ud558\uc5ec \uafb8\uba70\uc9c4 \ubcf5\ud569 \ubb38\ud654 \uacf5\uac04\uc758 \uc774\ub984\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c \ucc3d\uace0 \uac74\ubb3c \uc2dc\ucee4\uba3c \ubcbd\uc5d0 \uc5ec\uc804\ud788 \uace0\uc2a4\ub780\ud788 \ub0a8\uc544 \uc788\ub294 \ubb38\uad6c \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ud611\ub3d9 \uc0dd\uc0b0 \uacf5\ub3d9 \ud310\ub9e4', '\uc0bc\ub840 \uc591\uace1 \ucc3d\uace0'"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c\uacfc \uc0bc\ub840\uc5ed \uc774\uc804 \uc790\ub9ac(\ub9c9\uc0ac\ubc1c \ubbf8\uc220\uad00)\ub97c \ud569\ud574 \uc6b4\uc601\ub418\ub294 \ubb38\ud654 \uc608\uc220 \uacf5\uac04\uc740 \ucd1d \uba87 \uacf3\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd1d 7\uacf3 (\uc608\uc220\ucd0c \ub0b4\ubd80 6\uacf3 + \uc0bc\ub840\uc5ed \uc774\uc804 \uc790\ub9ac \ubbf8\uc220\uad00 1\uacf3)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc4f4\uc774\uac00 \uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c\uc5d0\uc11c \uac00\uc7a5 \uba3c\uc800 \ucc3e\uc544\uac04 \uc804\uc2dc \uacf5\uac04\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub514\uc5b4 \uc544\ud2b8(Media Art) \ubbf8\uc220\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ud68c\uc6a9 \ube68\ub300\ub098 \ub9c1\uac70 \uc904 \ub4f1 \ud3d0\ud488\uacfc \uc4f0\ub808\uae30\ub97c \uc7ac\ub8cc\ub85c \ud65c\uc6a9\ud558\uc5ec \ub9cc\ub4e0 \ubbf8\uc220 \uc791\ud488 \uc7a5\ub974\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ud06c \uc544\ud2b8 (Junk Art)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad00\uac1d\uc774 \ub2e8\uc21c\ud788 \ubcf4\ub294 \uac83\uc5d0 \uadf8\uce58\uc9c0 \uc54a\uace0 \uc9c1\uc811 \ucc38\uc5ec\ud558\ub294 \uc30d\ubc29\ud5a5 \uac1c\ub150\uc758 \ubbf8\uc220\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ud130\ub799\ud2f0\ube0c \uc544\ud2b8 (Interactive Art)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub514\uc5b4 \uc544\ud2b8 \ubbf8\uc220\uad00 \ub0b4\ubd80 \ubcbd\uacfc \ucc9c\uc7a5\uc758 \uc6d0\ud615\uc744 \uc0b4\ub824 \uc5ec\ub984\uc5d0 \uc11c\ub298\ud558\uace0 \ubc14\ub78c\uc774 \ud1b5\ud558\uac8c \ubc30\uce58\ub41c \uc7ac\ub8cc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud1b5\ub098\ubb34 (\ud1b5\ub098\ubb34\ub4e4\uc758 \ubc30\uc5f4)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc4f4\uc774\uac00 \ub450 \ubc88\uc9f8\ub85c \ubc29\ubb38\ud55c \uacf5\uac04\uc73c\ub85c, \ucc45\uc744 \uc77d\uace0 \ub098\ub9cc\uc758 \ucc45\uc744 \ub9cc\ub4e4\uba70 \uc778\uc1c4 \uc7a5\ube44\ub97c \ubcfc \uc218 \uc788\ub294 \uccb4\ud5d8 \uc13c\ud130\ub294 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc45 \uacf5\ubc29"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc45 \uacf5\ubc29\uc5d0 \uc804\uc2dc\ub41c 100\ub144\ub3c4 \ub354 \ub41c \uac00\uacc4\ubd80 \ub4f1\uc5d0 \uc904\uc744 \uae0b\ub294 \uae30\uacc4\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa9\uada4\uc120"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc4f4\uc774\uac00 \uc138 \ubc88\uc9f8\ub85c \ucc3e\uc544\uac04 \uacf5\uac04\uc73c\ub85c, '\uc804\ub77c\ub3c4 \uc5ec\uc790' \uae30\ud68d\uc804 \ubc0f \uc190\ubc14\ub2e5\ub9cc \ud55c \ud504\ub791\uc2a4\uc5b4 \ubc88\uc5ed \u300e\ucd98\ud5a5\uc804\u300f\uc774 \uc804\uc2dc\ub41c \uacf3\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc45 \ubc15\ubb3c\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc45 \ubc15\ubb3c\uad00\uc758 '\ud55c\uad6d \ubd81 \ub514\uc790\uc778 100\ub144' \uc804\uc2dc\uc5d0\uc11c \uc724\ub3d9\uc8fc\uc758 \uc2dc\uc9d1 \u300e\ud558\ub298\uacfc \ubc14\ub78c\uacfc \ubcc4\uacfc \uc2dc\u300f \ud45c\uc9c0\ub97c \ub514\uc790\uc778\ud55c \ud654\uac00\ub294 \ub204\uad6c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae40\ud658\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc45 \ubc15\ubb3c\uad00\uc5d0\uc11c 1948\ub144\ubd80\ud130 30\ub144\uac04 \uad50\uacfc\uc11c \uc0bd\ud654\ub97c \uadf8\ub824 '\ucca0\uc218\uc640 \uc601\ud76c'\ub97c \ud0c4\uc0dd\uc2dc\ud0a8 \uc791\uac00\ub294 \ub204\uad6c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae40\ud0dc\ud615"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc120 \ubaa9\uc218\ub4e4\uc758 \ucca0\ud559\uc774 \ub2f4\uae34 \uac00\uad6c\uc640 \uc5f0\uc7a5\uc774 \uc804\uc2dc\ub418\uc5b4 \uc788\uc73c\uba70, \uc9d9\uc740 \ub098\ubb34 \ud5a5\uc774 \ud48d\uae30\ub294 \ub124 \ubc88\uc9f8 \uacf5\uac04\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa9\uacf5\uc18c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d\uc0b0\uc5c5\ub514\uc790\uc778\ud611\ud68c \uacf5\ubaa8\uc804 \uc218\uc0c1\uc791\ub4e4\uc744 \uc804\uc2dc\ud558\uc5ec \uc80a\uc740 \ubc29\ubb38\uac1d\ub4e4\uc774 \uc88b\uc544\ud558\ub294 \ub2e4\uc12f \ubc88\uc9f8 \uacf5\uac04\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc790\uc778 \ubc15\ubb3c\uad00"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed \uc8fc\ubbfc \ubc0f \ubc29\ubb38\uac1d\uc758 \ud734\uc2dd \uacf5\uac04\uc774\uc790 \ucee4\ud53c \uad00\ub828 \uad50\uc721\uc744 \ub2f4\ub2f9\ud558\ub294 \uc5ec\uc12f \ubc88\uc9f8 \uacf5\uac04\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\ud654 \uce74\ud398"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\ud654 \uc608\uc220\ucd0c \ucc3d\uace0 \uac74\ubb3c\ub4e4\uacfc \uc5b4\uc6b0\ub7ec\uc838 \uc61b\uac83\uacfc \uc0c8\uac83\uc758 \uc18c\ud1b5\uc744 \ubcf4\uc5ec \uc8fc\ub294 \uc778\uadfc \uc885\uad50 \uac74\ucd95\ubb3c\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0bc\ub840 \uc131\ub2f9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc4f4\uc774\uac00 \uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c\uc744 \ubaa8\ub450 \ub458\ub7ec\ubcf8 \ud6c4 \ub3c4\ub2ec\ud55c \ud575\uc2ec\uc801\uc778 \uac10\uc0c1 \ubc0f \uc8fc\uc81c \uc758\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc81c \uac15\uc810\uae30 \uc218\ud0c8\uc774\ub77c\ub294 \uace0\ud1b5\uc758 \uc720\uc0b0\uacfc \uc774 \uc2dc\ub300 \ubb38\ud654 \uc608\uc220\uc758 \uacf5\uc874\uc744 \ud1b5\ud574, \uacfc\uac70\u00b7\ud604\uc7ac\u00b7\ubbf8\ub798\uac00 \ud558\ub098\ub85c \uc5f0\uacb0\ub418\uc5b4 \uc788\uc74c\uc744 \ud655\uc778 \ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38 \u300c\uc591\uace1 \ucc3d\uace0, \uc608\uc220\uc758 \uc0b0\uc2e4\ub85c \ubcc0\uc2e0\ud558\ub2e4\u300d\uc5d0\uc11c \uae00\uc4f4\uc774\uc758 \uc804\uccb4 \uc774\ub3d9 \uacbd\ub85c(\uc5ec\uc815)\ub97c \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9cc\uacbd\uac15 $\\rightarrow$ \uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c $\\rightarrow$ \ubbf8\ub514\uc5b4 \uc544\ud2b8 \ubbf8\uc220\uad00 $\\rightarrow$ \ucc45 \uacf5\ubc29 $\\rightarrow$ \ucc45 \ubc15\ubb3c\uad00 $\\rightarrow$ \ubaa9\uacf5\uc18c $\\rightarrow$ \ub514\uc790\uc778 \ubc15\ubb3c\uad00 $\\rightarrow$ \ubb38\ud654 \uce74\ud398 $\\rightarrow$ \uc0bc\ub840 \uc131\ub2f9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38 \uc791\uc131 \uc2dc \uc2e4\uc81c \uacbd\ud5d8\ud558\uc9c0 \uc54a\uc740 \uc77c\uc744 \uacfc\uc7a5\ud558\uac70\ub098 \uafb8\uba70 \uc4f0\ub294 \ud589\uc704\ub294 \uc5b4\ub5a4 \uc724\ub9ac\ub97c \uc704\ubc18\ud55c \uac83\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac70\uc9d3 \uc5c6\uc774 \uc9c4\uc2e4\ud558\uac8c \uc4f0\uae30(\uc791\ubb38 \uc724\ub9ac)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc778\uc758 \uc790\ub8cc\ub098 \uc544\uc774\ub514\uc5b4\ub97c \ucd9c\ucc98 \ud45c\uae30 \uc5c6\uc774 \ubb34\ub2e8\uc73c\ub85c \uac00\uc838\ub2e4 \uc4f0\ub294 \uc791\ubb38 \uc724\ub9ac \uc704\ubc18 \ud589\uc704\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud45c\uc808"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ud574\uad00\uacc4\uac00 \uc11c\ub85c \ub2e4\ub978 \uc0c1\ud638 \uac04\uc5d0 \ud0c0\ud611\uc744 \ud1b5\ud574 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uace0 \uc0c1\ud638 \ub9cc\uc871\ud560 \ud569\uc758\uc810\uc5d0 \ub3c4\ub2ec\ud558\ub294 \uc758\uc0ac\uc18c\ud1b5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc744 \uc9c4\ud589\ud560 \ub54c \uc0c1\ud638 \uac04\uc5d0 \ubc18\ub4dc\uc2dc \ud30c\uc545\ud558\uace0 \uace0\ub824\ud574\uc57c \ud558\ub294 \ud575\uc2ec \uc694\uc18c \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7c1\uc810, \uc774\ud574\uad00\uacc4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc774 \uc774\ub8e8\uc5b4\uc9c0\ub294 \uc808\ucc28 3\ub2e8\uacc4\ub97c \uc21c\uc11c\ub300\ub85c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc791 $\\rightarrow$ \uc870\uc815 $\\rightarrow$ \ud574\uacb0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud611\uc0c1\uc5d0\uc11c \uc591\uce21 \ubaa8\ub450\uac00 \ub9cc\uc871\ud560 \ub9cc\ud55c \uc0c1\ud638 \uc774\uc775\uc758 \ud569\uc758\uc5d0 \ub3c4\ub2ec\ud558\uae30 \uc704\ud574 \uc694\uad6c\ub418\ub294 \ud0dc\ub3c4 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\ubcf4, \ud0c0\ud611"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9d0\uacfc \uae00\uc744 \uc0ac\uc6a9\ud560 \ub54c \ucc45\uc784\uac10 \uc788\uac8c \uc18c\ud1b5\ud574\uc57c \ud558\ub294 \uadfc\ubcf8\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9d0\uacfc \uae00\uc774 \ud0c0\uc778\uacfc \uc0ac\ud68c \uc804\uccb4\uc5d0 \ubbf8\uce58\ub294 \ud30c\uae09\ub825\uacfc \uc601\ud5a5\ub825\uc774 \ud06c\uae30 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uace0\uccd0\uc4f0\uae30' \ub2e8\uacc4\uc5d0\uc11c \ubb38\uc7a5\uc758 \ubb38\ubc95\uc801 \uc815\ud655\uc131\uc744 \uc810\uac80\ud558\ub294 \ub300\ud45c\uc801 \ud56d\ubaa9 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9de\ucda4\ubc95 \ubc0f \ub744\uc5b4\uc4f0\uae30\uc758 \uc624\ub958 \uc720\ubb34, \ubb38\uc7a5 \uc131\ubd84 \uac04\uc758 \ud638\uc751\uacfc \uc811\uc18d\uc5b4 \uc5f0\uacb0\uc758 \uc790\uc5f0\uc2a4\ub7ec\uc6c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uace0\uccd0\uc4f0\uae30' \ub2e8\uacc4\uc5d0\uc11c \ubb38\ub2e8 \uad6c\uc131 \ubc0f \ub0b4\uc6a9\uc758 \ud1b5\uc77c\uc131\uc744 \uc810\uac80\ud558\ub294 \ud3c9\uac00 \uae30\uc900 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\ub2e8 \uad6c\ubd84\uc758 \uc801\uc808\uc131, \uc8fc\uc81c\uc5d0\uc11c \ubc97\uc5b4\ub09c \ubb38\uc7a5\uc758 \uc720\ubb34"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38\uc5d0\uc11c \"\ub3d9\uacfc \ub3d9 \uc0ac\uc774\ub97c \ub098\ube44\ucc98\ub7fc \uc62e\uaca8 \ub2e4\ub2c8\uba70\"\ub77c\ub294 \ud45c\ud604\uc774 \ub4dc\ub7ec\ub0b4\ub294 \uae00\uc4f4\uc774\uc758 \uad00\ub78c \ubaa8\uc2b5\uc740 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ub7ec \uc804\uc2dc \uacf5\uac04\uc744 \uc990\uac81\uace0 \uacbd\ucf8c\ud55c \ub9c8\uc74c\uc73c\ub85c \uc624\uac00\uba70 \uacbd\ud5d8\ud558\ub294 \ubaa8\uc2b5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0bc\ub840 \ubb38\ud654 \uc608\uc220\ucd0c\uc758 \uc678\uad00 \ubcf4\uc804\uacfc \ub0b4\ubd80 \uc804\uc2dc \uac04\uc5d0 \ub098\ud0c0\ub098\ub294 \ub300\ube44\uc801 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud22c\ubc15\ud558\uace0 \uc624\ub798\ub41c 100\ub144 \uc5ed\uc0ac\uc758 \ucc3d\uace0 \uc678\uad00(\uc544\ub0a0\ub85c\uadf8)\uacfc \ucca8\ub2e8 \uc608\uc220 \ubc0f \ud604\ub300\uc801 \ub514\uc790\uc778 \uacf5\uac04(\ub514\uc9c0\ud138)\uc758 \ub300\ube44"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud589\ubb38 \uc18d \"\uc2dc\uac04 \uc704\uc5d0 \uc11c \uc788\ub294 \ubaa8\ub4e0 \uac83\ub4e4\uc740 \ud558\ub098\ub85c \uc774\uc5b4\uc838 \uac15\ubb3c\ucc98\ub7fc \ud758\ub7ec\uac00\ub294 \uac83\uc774\ub2e4\"\ub77c\ub294 \ubb38\uc7a5\uc774 \uc2dc\uc0ac\ud558\ub294 \ubc14\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70\uc758 \uc77c\uc81c \uc218\ud0c8 \uc5ed\uc0ac\uac00 \ub2e8\uc808\ub41c \uac83\uc774 \uc544\ub2c8\ub77c, \ud604\uc7ac\uc758 \ubb38\ud654 \uc608\uc220\uacfc \uc11c\ub85c \uc18c\ud1b5\ud558\uba70 \ubbf8\ub798\ub85c \uc774\uc5b4\uc838 \uc874\uc7ac\ud55c\ub2e4\ub294 \uc9c0\ud61c"
          }
        ]
      }
    }
  ]
}