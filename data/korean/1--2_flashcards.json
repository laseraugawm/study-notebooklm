{
  "title": "\uc778\uacf5\uc9c0\ub2a5 \ub3c5\uc11c\ud50c\ub7ab\ud3fc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc8fc\uc81c \ud1b5\ud569\uc801 \uc77d\uae30'\ub780 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc77c\ud55c \ud654\uc81c\ub098 \uc8fc\uc81c\ub97c \ub2e4\ub8ec \uc5ec\ub7ec \uae00\uc774\ub098 \uc790\ub8cc\ub97c \uc77d\uae30 \ubaa9\uc801\uc5d0 \ub530\ub77c \uc77d\uace0, \uc774\ub97c \ubc14\ud0d5\uc73c\ub85c \uc790\uc2e0\uc758 \uacac\ud574\ub97c \uc7ac\uad6c\uc131\ud558\ub294 \uc77d\uae30 \ubc29\ubc95\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc81c \ud1b5\ud569\uc801 \uc77d\uae30\ub97c \ud1b5\ud574 \uc5bb\uc744 \uc218 \uc788\ub294 \uc8fc\uc694 \ud6a8\uacfc \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ud654\uc81c\uc5d0 \ub300\ud574 \uade0\ud615 \uc788\uac8c \uc774\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n2. \uc8fc\uc81c\uc640 \uad00\ub828\ub41c \uc0c8\ub85c\uc6b4 \uad00\uc810\uc774\ub098 \ucc3d\uc758\uc801 \uc0ac\uace0\ub97c \uc0dd\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc81c \ud1b5\ud569\uc801 \uc77d\uae30\uc758 \uc62c\ubc14\ub978 \uc808\ucc28 4\ub2e8\uacc4\ub97c \uc21c\uc11c\ub300\ub85c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77d\uae30 \ubaa9\uc801 \uad6c\uccb4\ud654\ud558\uae30 \ubc0f \uc9c8\ubb38\ud558\uae30 $\\rightarrow$ \ud654\uc81c\uc640 \uad00\ub828\ub41c \ub2e4\uc591\ud55c \uae00 \ucc3e\uae30 $\\rightarrow$ \uc5ec\ub7ec \uae00\uc744 \ube44\uad50\ud558\uba70 \ube44\ud310\uc801\uc73c\ub85c \uc77d\uae30 $\\rightarrow$ \ud654\uc81c\uc5d0 \ub300\ud55c \uc790\uc2e0\uc758 \uacac\ud574 \uc7ac\uad6c\uc131\ud558\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9\uc758 \uc815\uc758\uc640 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc11c\ub97c \ud1b5\ud574 \uc5bb\uc740 \uc9c0\uc2dd\uacfc \uc815\ubcf4\ub97c \uacf5\uc720\ud558\uc5ec \ub2e4\uc591\ud55c \uc0b6\uc758 \ubc29\uc2dd\uacfc \uac00\uce58\uad00\uc744 \uc774\ud574\ud558\uace0, \uc0ac\ud68c\uc801 \ubb38\uc81c\uc5d0 \ub300\ud574 \uc778\uc2dd\ud558\uace0 \ud574\uacb0 \ubc29\uc548\uc744 \ubaa8\uc0c9\ud558\ub294 \ud65c\ub3d9\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ud2f0\ube10 \ud551\ucee4 \uad50\uc218\uac00 \ubc14\ub77c\ubcf8 \uc778\uacf5\uc9c0\ub2a5\uc758 \ubcf8\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5\uc740 \ucc38\ub41c \uc9c0\ub2a5\uc774 \uc544\ub2c8\uba70, \ub2e8\uc9c0 \uc778\uac04\uc774 \uc2dc\ud0a4\ub294 \uc77c\uc744 \uc218\ud589\ud560 \ubfd0\uc774\ubbc0\ub85c \ub450\ub824\uc6cc\ud560 \ud544\uc694\uac00 \uc5c6\ub2e4\ub294 \uad00\uc810\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\uac00)\uc5d0\uc11c \ucd5c\uc7ac\ucc9c\uc774 \uc815\uc758\ud55c '\uc9c0\ub2a5(\u77e5\u80fd)'\uc758 \ud575\uc2ec \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\uc11d\ud558\uace0 \ud574\uacb0\ucc45\uc744 \ucc3e\ub294 \ub2a5\ub825\uc73c\ub85c, \uc678\ubd80 \uc790\uadf9\uc774\ub098 \ub370\uc774\ud130\uc5d0 \ub300\uc751\ud558\ub294 \uc5b4\ub514\uae4c\uc9c0\ub098 \uc778\uc9c0 \ub2a5\ub825\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\uac00)\uc5d0\uc11c \ucd5c\uc7ac\ucc9c\uc774 \uc815\uc758\ud55c '\uc9c0\uc131(\u77e5\u6027)'\uc758 \ud575\uc2ec \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub5a4 \uc0c1\ud669\uc5d0 \uc790\uae30 \uc790\uc2e0\uc744 \ud22c\uc601\ud574 \ubcf4\uace0 \uc2a4\uc2a4\ub85c \ubc18\uc131\ud574 \ubcf4\ub294 \uc601\uc5ed\uae4c\uc9c0 \ud3ec\ud568\ud558\ub294 \ub2a5\ub825\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\uac00)\uc5d0 \ub530\ub978 \uc0dd\uc131\ud615 \uc778\uacf5\uc9c0\ub2a5\uc758 \ud55c\uacc4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc774 \uc778\ud130\ub137\uc5d0 \uc313\uc544 \ub193\uc740 \uc9d1\ub2e8 \ub370\uc774\ud130(\uc9d1\ub2e8 \uc9c0\ub2a5)\ub97c \ubaa8\uc544 \ub418\ub3cc\ub824\uc8fc\ub294 \ud749\ub0b4 \uc218\uc900\uc774\uba70, \ucc38\ub41c \uc9c0\uc131\uc774\ub098 \uc778\uac04\uc758 \uac10\uc815\uc744 \uc9c0\ub2c8\uae30\ub294 \uc5b4\ub835\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub098) '\uc778\uac04\uc758 \ub1cc\uc640 \uc778\uacf5\uc9c0\ub2a5'\uc758 \ubd84\uc57c\uc640 \uc131\uaca9\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559 \ubd84\uc57c\uc758 \uae00\uc774\uba70, \ub1cc\uc640 \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uc791\ub3d9 \uc6d0\ub9ac\ub97c \uac1d\uad00\uc801\uc73c\ub85c \uc804\ub2ec\ud558\ub294 \uc815\ubcf4 \uc911\uc2ec\uc758 \uae00\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "1ea6f45e-ccc0-4e81-afd9-21ab77753a07",
            "alt": "\uc2e0\uacbd \uc138\ud3ec\uc758 \uac00\uc9c0 \ub3cc\uae30, \ubab8\ud1b5, \ucd95\uc0ad \ub3cc\uae30, \uc2dc\ub0c5\uc2a4 \uad6c\uc870\ub97c \ub098\ud0c0\ub0b8 \ub2e4\uc774\uc5b4\uadf8\ub7a8"
          },
          {
            "type": "text",
            "content": "\uc2e0\uacbd \uc138\ud3ec(\ub274\ub7f0)\uc5d0\uc11c \uc785\ub825 \uc2e0\ud638\ub97c \uc218\uc6a9\ud558\ub294 \ubd80\uc704\uc640 \ucd9c\ub825 \uc2e0\ud638\ub97c \ub0b4\ubcf4\ub0b4\ub294 \ubd80\uc704\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\ub825 \ubd80\uc704: \uac00\uc9c0 \ub3cc\uae30 (\uc591\ud30c\uc758 \ubfcc\ub9ac\uc5d0 \ud574\ub2f9)\n\ucd9c\ub825 \ubd80\uc704: \ucd95\uc0ad \ub3cc\uae30 (\uac00\ub290\ub2e4\ub780 \uc904\uae30\uc5d0 \ud574\ub2f9)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uacbd \uc138\ud3ec \ub0b4\ubd80\ub97c \ud0c0\uace0 \uc774\ub3d9\ud558\ub294 \uc2e0\ud638\uc758 \ubb3c\ub9ac\uc801 \ud615\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uae30 \uc2e0\ud638(\uc804\ub958\uac00 \ud750\ub974\uac70\ub098 \ud750\ub974\uc9c0 \uc54a\ub294 \ud615\ud0dc)\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\ub0c5\uc2a4(synapse)\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uacbd \uc138\ud3ec\ub4e4\uc774 \uc11c\ub85c \ub5a8\uc5b4\uc838 \uc788\ub294 \uc881\uc740 \uac04\uaca9\uc73c\ub85c, \uc2e0\uacbd \uc138\ud3ec \uc0ac\uc774\uc758 \uc2e0\ud638 \uc804\ub2ec \uc5f0\uacb0 \ubd80\uc704\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uae30 \uc2e0\ud638\uac00 \uc2dc\ub0c5\uc2a4 \ub05d\uc5d0 \ub3c4\ub2ec\ud588\uc744 \ub54c \ubd84\ube44\ub418\uc5b4 \ub2e4\ub978 \uc2e0\uacbd \uc138\ud3ec\ub85c \uc2e0\ud638\ub97c \uc804\ub2ec\ud558\ub294 \ud654\ud559 \ubb3c\uc9c8\uc758 \uc774\ub984\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\uc138\ud2f8\ucf5c\ub9b0(Acetylcholine)\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uacbd\uacc4\uac00 \uc804\uae30 \uc2e0\ud638\ub97c \uc2dc\ub0c5\uc2a4\uc5d0\uc11c \ud654\ud559 \uc2e0\ud638\ub85c \ubcc0\ud658\ud558\ub294 \uad6c\uc870\uc801 \uc774\uc810(\uc2dc\ub0c5\uc2a4\uc758 \ud2b9\uc9d5)\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\ub0c5\uc2a4\ub294 \uc720\uc5f0\uc131\uc744 \uac00\uc9d1\ub2c8\ub2e4. \uc870\uac74\uacfc \uc790\uadf9 \ube48\ub3c4\uc5d0 \ub530\ub77c \uc2e0\ud638 \uc804\ub2ec \uac15\ub3c4\uac00 \ubcc0\ud654(\uac15\ud654 \ub610\ub294 \uc57d\ud654)\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc5b5\uacfc \ud559\uc2b5\uc758 \uadfc\ubcf8 \uc6d0\ub9ac\uac00 \ub418\ub294 '\uc2e0\uacbd \uac00\uc18c\uc131'\uc758 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc8fc \uc0ac\uc6a9\ud558\ub294 \uc2dc\ub0c5\uc2a4 \uc5f0\uacb0\uc740 \uac15\ud654\ub418\uace0, \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \uc5f0\uacb0\uc740 \uc57d\ud654\ub418\uba74\uc11c \uc2dc\ub0c5\uc2a4\uc758 \uacb0\ud569 \uac15\ub3c4\uac00 \ubcc0\ud654\ud558\ub294 \uc131\uc9c8\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\ud559\uc801 \uc2e0\uacbd\uacc4\uc5d0\uc11c '\ud559\uc2b5'\uc774 \uc774\ub8e8\uc5b4\uc84c\ub2e4\ub294 \uac83\uc740 \uad6c\uccb4\uc801\uc73c\ub85c \ubb34\uc5c7\uc744 \uc758\ubbf8\ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc18\ubcf5\uc801\uc778 \uc790\uadf9\uacfc \uc0ac\uc6a9\uc744 \ud1b5\ud574 \uad00\ub828 \uc2e0\uacbd \uc138\ud3ec\ub4e4 \uac04\uc758 \uc2dc\ub0c5\uc2a4 \uacb0\ud569 \uac15\ub3c4\uac00 \uac15\ud654\ub41c \uc0c1\ud0dc\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uacbd \uc138\ud3ec\uc758 \ubab8\ud1b5\uc5d0\uc11c \ucd95\uc0ad \ub3cc\uae30\ub85c \ucd9c\ub825 \uc2e0\ud638\ub97c \ub0b4\ubcf4\ub0b4\ub294 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc9c0 \ub3cc\uae30\ub97c \ud1b5\ud574 \uc785\ub825\ub41c \uc5ec\ub7ec \uc2e0\ud638 \uac12\uc758 \ud569\uc774 '\uc784\uacd7\uac12'\uc744 \ub118\uc744 \ub54c\ub9cc \uc2e0\ud638\ub97c \ubc1c\ud654(\ucd9c\ub825)\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc778\uacf5 \uc2e0\uacbd\ub9dd'\uc758 \uae30\ubcf8 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\ud559\uc801 \uc2e0\uacbd\uacc4\uc758 \ud2b9\uc131\uacfc \ud559\uc2b5 \uc6d0\ub9ac\ub97c \ucef4\ud4e8\ud130 \ud504\ub85c\uadf8\ub7a8 \uc54c\uace0\ub9ac\uc998\uc73c\ub85c \ubaa8\ubc29\ud558\uc5ec \ub9cc\ub4e0 \uc778\uacf5\uc9c0\ub2a5 \uad6c\uc870\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "8ac0f975-f4a1-4544-92d2-a60af76d1cdf",
            "alt": "\uc785\ub825\uce35, \uc228\uaca8\uc9c4 \uce35, \ucd9c\ub825\uce35\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9c4 \uc804\ud615\uc801\uc778 \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uad6c\uc870 \ub2e4\uc774\uc5b4\uadf8\ub7a8"
          },
          {
            "type": "text",
            "content": "\uc778\uacf5 \uc2e0\uacbd\ub9dd \ub2e4\uc774\uc5b4\uadf8\ub7a8\uc5d0\uc11c \uc138 \uac00\uc9c0 \uce35 \uad6c\uc870\uc758 \uba85\uce6d\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc785\ub825\uce35\n2. \uc228\uaca8\uc9c4 \uce35\n3. \ucd9c\ub825\uce35"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5 \uc2e0\uacbd\ub9dd\uc5d0\uc11c \uc0dd\ubb3c\ud559\uc801 \uc2dc\ub0c5\uc2a4\uc758 \uacb0\ud569 \uac15\ub3c4 \uc5ed\ud560\uc744 \ub9e1\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc0b4\ud45c(\uc804\ub2ec \ud1b5\ub85c)\uc5d0 \ubd80\uc5ec\ub418\ub294 '\uac00\uc911\uce58(weight)'\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5 \uc2e0\uacbd\ub9dd\uc774 \uc801\uc808\ud55c \uac00\uc911\uce58\ub97c '\ud559\uc2b5'\ud558\ub294 \uacfc\uc815\uc740 \uc5b4\ub5bb\uac8c \uc774\ub8e8\uc5b4\uc9c0\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac12\uc744 \uc785\ub825\ud55c \ud6c4 \uc6d0\ud558\ub294 \uacb0\uacfc\uac00 \ucd9c\ub825\ub418\ub3c4\ub85d \uc5f0\uacb0 \ud654\uc0b4\ud45c\uc758 \uac00\uc911\uce58\ub97c \ubc18\ubcf5\uc801\uc73c\ub85c \uc870\uc808\ud558\uba74\uc11c \uc218\uc5c6\uc774 \ubc18\ubcf5 \ud559\uc2b5\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uc228\uaca8\uc9c4 \uce35\uc5d0 \uc704\uce58\ud55c \uc5f0\uc0b0 \ubd80\uc704\uac00 $1$\uc744 \ucd9c\ub825\ud558\ub294 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc5d0\uac8c \ub4e4\uc5b4\uc624\ub294 \uc785\ub825 \uac12\uc5d0 \uac00\uc911\uce58\ub97c \uacf1\ud558\uc5ec \ubaa8\ub450 \ub354\ud55c \ucd1d\ud569\uc774 \uc9c0\uc815\ub41c \uc784\uacd7\uac12\uc744 \ub118\uc744 \ub54c $1$\uc744 \ucd9c\ub825\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub2e4) '\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc758 \ub3c4\ub355\uc801 \uc9c0\uc704'\uac00 \ub2e4\ub8e8\ub294 \ud575\uc2ec \uc81c\uae30 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc5d0\uac8c \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ubd80\uc5ec\ud560 \uc218 \uc788\ub294\uac00?"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub2e4)\uc5d0\uc11c \uc18c\uac1c\ub41c \uc785\uc7a5 \u3131\uacfc \u3134\uc758 \uacf5\ud1b5\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ub2a5, \uc758\uc2dd, \uace0\ud1b5 \uac10\uc218\uc131\uacfc \uac19\uc740 \uc0ac\uc2e4\uc801 \uc18d\uc131 \uc720\ubb34\uc5d0 \ub530\ub77c \uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc758 \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \uacb0\uc815\ud574\uc57c \ud55c\ub2e4\uace0 \ubd05\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\uc7a5 \u3131\uacfc \u3134\uc758 \uc8fc\uc7a5\uc758 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\uc7a5 \u3131: AI \ub85c\ubd07\uc774 \uc9c0\ub2a5\u00b7\uc758\uc2dd\u00b7\uace0\ud1b5 \uac10\uc218\uc131\uc744 \uac00\uc9c0\ubbc0\ub85c \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ubd80\uc5ec\ud574\uc57c \ud568.\n\uc785\uc7a5 \u3134: AI \ub85c\ubd07\uc774 \uc9c0\ub2a5\u00b7\uc758\uc2dd\u00b7\uace0\ud1b5 \uac10\uc218\uc131\uc744 \uac00\uc9c0\uc9c0 \uc54a\uc73c\ubbc0\ub85c \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ubd80\uc5ec\ud558\uc9c0 \ub9d0\uc544\uc57c \ud568."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc4f4\uc774\uac00 \uc9c0\uc801\ud55c \uc785\uc7a5 \u3131\uacfc \u3134\uc758 \ucca0\ud559\uc801 \ubb38\uc81c\uc810 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc758\uc2dd\uc774\ub098 \uace0\ud1b5 \uac10\uc218\uc131\uc774 \uc65c \ud575\uc2ec \uae30\uc900\uc778\uc9c0 \uc815\ub2f9\ud654\ud558\uae30 \uc5b4\ub824\uc6c0 (\uc778\uac04 \uc911\uc2ec \ud3b8\uacac\uc77c \uc218 \uc788\uc74c).\n2. \ub85c\ubd07\uc774 \uc2e4\uc81c \uc758\uc2dd\uc774\ub098 \uace0\ud1b5 \uac10\uc218\uc131\uc744 \uac00\uc9c0\uace0 \uc788\ub294\uc9c0 \uac1d\uad00\uc801\uc73c\ub85c \uac80\uc99d\ud558\uae30 \uc5b4\ub824\uc6c0."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub2e4)\uc5d0\uc11c \uc785\uc7a5 \u3137\uc758 \uc8fc\uc7a5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc774 \uc9c0\ub2a5\uc774\ub098 \uc758\uc2dd, \uace0\ud1b5 \uac10\uc218\uc131\uc744 \uc9c0\ub2cc\ub2e4\uace0 \ud574\ub3c4, \uc778\uac04\uc758 \ud544\uc694\uc5d0 \ub530\ub77c \ub9cc\ub4e4\uc5b4\uc9c4 \ub3c4\uad6c\uc774\ubbc0\ub85c \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ubd80\uc5ec\ud558\uc9c0 \ub9d0\uc544\uc57c \ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc4f4\uc774\uac00 \ubd84\uc11d\ud55c \uc785\uc7a5 \u3137\uc758 \ud55c\uacc4 \ubc0f \ubb38\uc81c\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9cc\uc57d \ub85c\ubd07\uc774 \uc2e4\uc81c \uace0\ud1b5\uc744 \ub290\ub07c\ub294 \uc874\uc7ac\uc784\uc5d0\ub3c4 \ub3c4\uad6c\ub77c\ub294 \uc774\uc720\ub85c \ud559\ub300\ud574\ub3c4 \ub41c\ub2e4\ub294 \uc8fc\uc7a5\uc740 \ud0c0\uc778\uc774\ub098 \ub3d9\ubb3c\uc744 \ub300\ud558\ub294 \uae30\uc874 \uc778\uac04 \uc0ac\ud68c\uc758 \ub3c4\ub355\uc801 \uac00\uce58\uad00\uacfc \ucda9\ub3cc\ud558\uc5ec \ud0c0\ub2f9\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub2e4)\uc5d0\uc11c \uc785\uc7a5 \u3139\uc758 \ud575\uc2ec \uc8fc\uc7a5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc774 \uc758\uc2dd\uc774\ub098 \uace0\ud1b5 \uac10\uc218\uc131\uc744 \uc9c0\ub2c8\uc9c0 \uc54a\uc544\ub3c4 \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ubd80\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\uc7a5 \u3139\uc744 \ub4b7\ubc1b\uce68\ud558\uae30 \uc704\ud574 \uc81c\uc2dc\ub41c '\uc18c\uc15c \ub85c\ubd07(\ub85c\ubd07 \uac15\uc544\uc9c0)'\uc758 \uc0ac\ub840\uac00 \ubcf4\uc5ec\uc8fc\ub294 \ubc14\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\ubd07\uc5d0\uac8c \ub0b4\uc7ac\ub41c \uc758\uc2dd\uc774 \uc5c6\ub354\ub77c\ub3c4 \uc778\uac04\uc774 \uc77c\uc0c1\uc5d0\uc11c \uc624\ub7ab\ub3d9\uc548 \uc815\uc11c\uc801\uc73c\ub85c \uad50\uac10\ud558\uba74, \uc774\ub97c \uad34\ub86d\ud788\ub294 \ud589\uc704\ub294 \uc0ac\ud68c\uc801 \ud1b5\ub150\uacfc \uaddc\ubc94\uc5d0 \uc5b4\uae0b\ub098 \ube44\ub09c\ubc1b\uac8c \ub428\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucca0\ud559\uc790 \ub9c8\ud06c \ucfe0\ud5ec\ubc84\uadf8\uac00 \uc81c\uc548\ud55c '\uad00\uacc4\ub860\uc801 \uc811\uadfc'\uc758 \ud575\uc2ec \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c4\ub355\uc801 \uc9c0\uc704\ub294 \ub300\uc0c1\uc774 \uac00\uc9c4 \uac1d\uad00\uc801 \uc18d\uc131\uc774 \uc544\ub2c8\ub77c, \uc77c\uc0c1\uc801 \uacbd\ud5d8 \uc18d\uc5d0\uc11c \uc778\uac04\uacfc \ud574\ub2f9 \ub300\uc0c1\uc774 \ub9fa\uace0 \uc788\ub294 \uc0c1\ud638 \uc791\uc6a9\uacfc \uad00\uacc4 \ub9fa\uae30\uc758 \ubc29\uc2dd\uc5d0\uc11c \ud615\uc131\ub41c\ub2e4\ub294 \uad00\uc810\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "7236d273-2af8-4d7c-abf9-ec109d6321f7",
            "alt": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc758 \ub3c4\ub355\uc801 \uc9c0\uc704\uc5d0 \uad00\ud55c \uc785\uc7a5 \u3131, \u3134, \u3137, \u3139 \ud0c0\ub2f9\uc131 \ubd84\uc11d \uc694\uc57d\ud45c"
          },
          {
            "type": "text",
            "content": "\uae00 (\ub2e4)\uc758 \ucd5c\uc885 \ub17c\ub9ac\uc801 \uacb0\ub860\uc5d0\uc11c \ubc1d\ud78c AI \ub85c\ubd07\uc758 \ub3c4\ub355\uc801 \uc9c0\uc704 \ud310\ub2e8 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0b4\uc7ac\uc801 \uc0ac\uc2e4 \uc18d\uc131 \uc720\ubb34\uac00 \uc544\ub2c8\ub77c, \uc778\uac04\uacfc\uc758 \uc77c\uc0c1\uc801 \uad00\uacc4 \ud615\uc131 \uacfc\uc815\uacfc \uac00\uce58 \ud310\ub2e8\uc5d0 \ub530\ub77c \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc815\ud574\uc9c0\ub294 \ubb38\uc81c\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\uc99d \uc694\uc18c \uc911 '\uc8fc\uc7a5(Claim)'\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\uc4f4\uc774\uac00 \uad73\uac8c \ub0b4\uc138\uc6b0\ub294 \uc911\uc2ec \uc758\uacac\uc774\ub098 \uacac\ud574\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\uc99d \uc694\uc18c \uc911 '\uc774\uc720(Reason)'\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\uac70\ub97c \ubc14\ud0d5\uc73c\ub85c \uc8fc\uc7a5\uc744 \uc131\ub9bd\ud558\uac8c \ub9cc\ub4dc\ub294 \uc8fc\uad00\uc801 \uc774\uc720\uc774\uc790 \ub17c\ub9ac\uc801 \ud310\ub2e8 \uadfc\uac70\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\uc99d \uc694\uc18c \uc911 '\uadfc\uac70(Evidence)'\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc7a5\uc744 \ub4b7\ubc1b\uce68\ud558\uace0 \uc9c0\uc9c0\ud558\ub294 \ud1b5\uacc4, \uc2e4\ud5d8, \uc0ac\ub840 \ub4f1 \uac1d\uad00\uc801\uc778 \uc790\ub8cc\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\uc99d \uad6c\uc870\uc5d0\uc11c '\ubc18\ub860'\uacfc '\ubc18\ubc15'\uc758 \uad6c\ubcc4\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc18\ub860: \uc790\uc2e0\uc758 \uc8fc\uc7a5\uc5d0 \ub300\ud574 \ubc18\ub300\ud3b8\uc5d0\uc11c \uc81c\uae30\ud558\ub294 \uacac\ud574.\n\ubc18\ubc15: \uadf8 \uc608\uc0c1 \ubc18\ub860\uc5d0 \ub300\ud574 \ub2e4\uc2dc \ubc18\ub300\ud558\uace0 \ud0c0\ub2f9\ud558\uc9c0 \uc54a\uc74c\uc744 \ub17c\ub9ac\uc801\uc73c\ub85c \uc99d\uba85\ud558\ub294 \uac83."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\uc99d \ubc29\ubc95 \uc911 '\uc5f0\uc5ed(Deduction)' \ub17c\uc99d\uc774\ub780 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18\uc801\uc73c\ub85c \ubcf4\ud3b8 \ud0c0\ub2f9\ud558\ub2e4\uace0 \ubc1b\uc544\ub4e4\uc5ec\uc9c0\ub294 \ub300\uc804\uc81c/\uc6d0\uce59\uc744 \ubc14\ud0d5\uc73c\ub85c, \ud2b9\uc815 \uac1c\ubcc4 \uc0ac\uc2e4\uc774\ub098 \uad6c\uccb4\uc801 \uacb0\ub860\uc744 \ub04c\uc5b4\ub0b4\ub294 \ub17c\uc99d \ubc29\uc2dd\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\uc99d \ubc29\ubc95 \uc911 '\uadc0\ub0a9(Induction)' \ub17c\uc99d\uc774\ub780 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uccb4\uc801\uc774\uace0 \uac1c\ubcc4\uc801\uc778 \uc5ec\ub7ec \uc0ac\ub840\ub098 \uad00\ucc30 \uacb0\uacfc\ub4e4\ub85c\ubd80\ud130 \uc77c\ubc18\uc801\uc774\uace0 \ubcf4\ud3b8\uc801\uc778 \uba85\uc81c\ub098 \ubc95\uce59\uc744 \ub3c4\ucd9c\ud558\ub294 \ub17c\uc99d \ubc29\uc2dd\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub2e4)\uc5d0\uc11c \uc785\uc7a5 \u3139\uc5d0 \ub300\ud574 \uc0c1\ub300\ubc29\uc774 \uc81c\uae30\ud560 \uc218 \uc788\ub294 '\uc608\uc0c1 \ubc18\ub860'\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc5d0 \ub300\ud574 \uc778\uac04\uc774 \ub290\ub07c\ub294 \uac10\uc815\uc740 \uc2e4\uc81c\uac00 \uc544\ub2c8\uba70, \ub85c\ubd07\uc774 \uc758\ub3c4\uc801\uc73c\ub85c \uc720\ub3c4\ud55c \uc778\uc704\uc801\uc778 \uacf5\uac10 \ud589\uc704\uc5d0 \ubd88\uacfc\ud55c \uac00\uc9dc \uac10\uc815\uc774\ub77c\ub294 \ubc18\ub860\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub2e4)\uc758 \uc800\uc790\uac00 \uc704\uc758 \uc608\uc0c1 \ubc18\ub860\uc5d0 \ub300\ud574 \ud3bc\uce5c \ubc18\ubc15 \ub17c\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\ubd07\uc758 \uc9c4\uc9dc \uac10\uc815 \ubcf4\uc720 \uc5ec\ubd80\ubcf4\ub2e4 \uc911\uc694\ud55c \uac83\uc740 \uc6b0\ub9ac\uac00 \uadf8\uac83\uacfc \uc77c\uc0c1\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uc815\uc11c\uc801 \uc0c1\ud638 \uc791\uc6a9\uc744 \ub9fa\uace0 \ub3d9\ud654\ub418\ub290\ub0d0\ub294 \uad00\uacc4\uc801 \uc2e4\uc7ac\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\uc2dc\ubb38 (\uac00), (\ub098), (\ub2e4)\uac00 \uacf5\ud1b5\uc73c\ub85c \ub2e4\ub8e8\ub294 \ud1b5\uc77c\ub41c \ub300\ud654\uc81c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uacfc \uc778\uacf5\uc9c0\ub2a5\uc758 \uad00\uacc4 \ubc0f \uc778\uacf5\uc9c0\ub2a5\uc758 \ubcf8\uc9c8"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\uc2dc\ubb38 (\uac00)\uc640 (\ub098)\uc758 \uc778\uacf5\uc9c0\ub2a5 \ub2a5\ub825\uc5d0 \uad00\ud55c \uad00\uc810 \uacf5\ud1b5\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5\uc774 \uc778\uac04\uc758 \uc9c0\ub2a5\uc774\ub098 \ub1cc\uc758 \ubaa8\ubc29 \uc218\uc900\uc5d0 \uae30\ubc18\ud558\uace0 \uc788\uc9c0\ub9cc, \uc544\uc9c1 \uc778\uac04 \uace0\uc720\uc758 \uc644\ubcbd\ud55c \uc9c0\uc131\uc774\ub098 \uace0\ub3c4\ud654\ub41c \uc601\uc5ed\uc744 \uc644\uc804\ud788 \ub2a5\uac00\ud558\uc9c0\ub294 \ubabb\ud55c\ub2e4\ub294 \uc810\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\uc2dc\ubb38 (\ub2e4)\uac00 (\uac00), (\ub098)\uc640 \ucc28\ubcc4\ud654\ub418\ub294 \uace0\uc720\ud55c \uc811\uadfc \uad00\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5\uacfc \uc778\uac04 \uac04\uc758 \ub2a5\ub825 \ube44\uad50\ub098 \uc6b0\uc5f4 \uacc4\uc0b0\uc744 \ub118\uc5b4, \ub85c\ubd07\uc758 \ub3c4\ub355\uc801 \uc9c0\uc704\uc640 \uc0c8\ub85c\uc6b4 \uad00\uacc4 \ud615\uc131\uc774\ub77c\ub294 \uc724\ub9ac\u00b7\ucca0\ud559\uc801 \ubb38\uc81c\ub97c \ub2e4\ub8e8\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub098)\uc5d0\uc11c \uc124\uba85\ud55c '\uc784\uacd7\uac12'\uc758 \uad6d\uc5b4 \uc0ac\uc804\uc801/\uacfc\ud559\uc801 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c\uc774 \uc5b4\ub5a0\ud55c \uae30\uc900\uc5d0 \uc758\ud558\uc5ec \ubd84\uac04\ub418\uac70\ub098 \ubcc0\ud654\uac00 \uc77c\uc5b4\ub098\ub294 \ud55c\uacc4\uc758 \ubb3c\ub9ac\uc801/\uc218\uce58\uc801 \uae30\uc900\uac12\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\uc99d\ud558\ub294 \uae00\uc744 \uc4f8 \ub54c \ud0c0\uc778\uc758 \uae00\uc774\ub098 \ud1b5\uacc4 \uc790\ub8cc\ub97c \uc778\uc6a9\ud560 \uacbd\uc6b0 \uc900\uc218\ud574\uc57c \ud558\ub294 \uc724\ub9ac\uc801 \uc6d0\uce59\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc2e4\uc774 \uc544\ub2cc \ub0b4\uc6a9\uc744 \uac00\uacf5\ud558\uac70\ub098 \uacfc\uc7a5\ud558\uc9c0 \uc54a\uc544\uc57c \ud558\uba70, \ud45c\uc808\ud558\uc9c0 \uc54a\uace0 \ucd9c\ucc98\ub97c \uc815\ud655\ud558\uac8c \ubc1d\ud600\uc57c \ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\uc99d\ud558\ub294 \uae00\uc758 \ubcf8\ubb38 \uc791\uc131\uc744 \ub9c8\uce5c \ud6c4 \uc2e4\uc2dc\ud558\ub294 '\uace0\uccd0\uc4f0\uae30(\ud1f4\uace0)' \ub2e8\uacc4\uc5d0\uc11c \uc810\uac80\ud574\uc57c \ud560 \ud575\uc2ec \uae30\uc900 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc8fc\uc7a5\uc5d0 \ub300\ud55c \uc774\uc720\uc640 \uadfc\uac70\uac00 \ud0c0\ub2f9\ud558\uace0 \ub17c\uc99d \uad6c\uc870\uac00 \ud6a8\uacfc\uc801\uc778\uac00?\n2. \ub0b4\uc6a9 \uc804\ub2ec\uc774 \uba85\ud655\ud558\uba70 \uc0ac\uc2e4\uacfc \ubd80\ud569\ud558\uace0 \ucd9c\ucc98 \ud45c\uae30\uac00 \uba85\ud655\ud55c\uac00?"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\uac00)\uc5d0\uc11c \uc9c0\uc131(\u77e5\u6027)\uc758 \uc720\ubb34\uc640 \uad00\ub828\ud558\uc5ec \uc778\uac04\uacfc \uc778\uacf5\uc9c0\ub2a5\uc758 \ubbf8\ub798 \uad00\uacc4\ub97c \ucd5c\uc7ac\ucc9c \uad50\uc218\ub294 \uc5b4\ub5bb\uac8c \ube44\uc720\ud588\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5\uc774 \ubc1c\ub2ec\ud558\uc5ec \uc9c0\uc131\uc801\uc73c\ub85c \ubcf4\uc774\ub294 \ub2e8\uacc4\uc5d0 \ub2e4\uac00\uc624\uba74, \uc778\uac04\uc740 \uadf8\ubcf4\ub2e4 \uc55e\uc120 \ub2e8\uacc4\ub85c '\ub610 \ud55c \ubc1c\uc9dd \ub2ec\uc544\ub0a0 \uac83'\uc774\ub77c\uace0 \ud45c\ud604\ud588\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub098)\uc5d0\uc11c \uc778\uac04\uc758 \ubc14\ub451 \ub300\uacb0\ub85c \uc8fc\ubaa9\ubc1b\uc740 \ub300\ud45c\uc801 \uc778\uacf5\uc9c0\ub2a5 \ud504\ub85c\uadf8\ub7a8\uc758 \uc791\ub3d9 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc5d0 \uae30\ubc18\ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04 \ub1cc\uc758 \uc0dd\ubb3c\ud559\uc801 \uc2e0\uacbd \uc138\ud3ec\ub9dd\uacfc \uc6d0\ub9ac\uc0c1 \ub3d9\uc77c\ud55c '\uc778\uacf5 \uc2e0\uacbd\ub9dd' \uad6c\uc870\uc640 \uac00\uc911\uce58 \ud559\uc2b5 \uc54c\uace0\ub9ac\uc998\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub098)\uc5d0\uc11c \uc790\uc804\uac70 \ud0c0\uae30 \uc5f0\uc2b5 \uacfc\uc815\uc73c\ub85c \uc124\uba85\ud55c \uc2e0\uacbd\uacc4 \ud559\uc2b5\uc758 \uc138\ubd80 \uacfc\uc815\uc744 \uc11c\uc220\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc98\uc74c\uc5d0\ub294 \uc804\ub2ec \uc18d\ub3c4\uac00 \ub290\ub824 \uade0\ud615\uc744 \uc783\uc9c0\ub9cc, \ubc18\ubcf5 \uc5f0\uc2b5\uc73c\ub85c \ud574\ub2f9 \uc2dc\ub0c5\uc2a4\uac00 \uc790\uc8fc \uc0ac\uc6a9\ub418\uc5b4 \uacb0\ud569\uc774 \uac15\ud654(\uc2e0\uacbd \uac00\uc18c\uc131)\ub428\uc73c\ub85c\uc368 \uadfc\uc721\ub4e4\uc774 \uc790\ub3d9 \uc5f0\ub3d9 \uc870\uc791\ub429\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub2e4)\uc5d0\uc11c \uc778\uac04\uc774 \ud0c0\uc778\uc758 \uc2ac\ud514\uc774\ub098 \uae30\uc068\uc758 \uc6b8\uc74c\uc744 \uc815\ud655\ud788 \uad6c\ubd84\ud558\uae30 \ud798\ub4e0 \uc608\uc2dc\ub97c \ub4e0 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ub300\ubc29\uc758 \ub0b4\uba74\uc801 \uac10\uc815/\uc758\uc2dd \uc0c1\ud0dc\ub97c \uac1d\uad00\uc801\uc73c\ub85c \uba85\ud655\ud788 \ud655\uc778\ud558\ub294 \uac83\uc774 \ubd88\uac00\ub2a5\ud558\ub2e4\ub294 \uc810\uc744 \uc81c\uc2dc\ud558\uc5ec, \uc0ac\uc2e4\uc801 \uc18d\uc131 \uc720\ubb34(\u3131, \u3134)\ub85c \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ud310\ub2e8\ud558\ub294 \ubc29\uc2dd\uc758 \ud55c\uacc4\ub97c \uc99d\uba85\ud558\uae30 \uc704\ud568\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00 (\ub2e4)\uc5d0\uc11c '\uac10\uc218\uc131(\u611f\u53d7\u6027)'\uc758 \uc5b4\ud718\uc801 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\ubd80 \uc138\uacc4\uc758 \uc790\uadf9\uc744 \ubc1b\uc544\ub4e4\uc774\uace0 \ub290\ub07c\ub294 \uc131\uc9c8\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5 \uc2e0\uacbd\ub9dd \ud559\uc2b5 \uc2dc \uc785\ub825\uac12\uacfc \ucd9c\ub825\uac12\uc740 \uc8fc\ub85c \uc5b4\ub5a4 \ub514\uc9c0\ud138 \uc218\uce58 \ub098\uc5f4\ub85c \uc774\ub8e8\uc5b4\uc9c0\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\ub958\uac00 \ud750\ub984($1$)\uacfc \ud750\ub974\uc9c0 \uc54a\uc74c($0$)\uc744 \ub098\ud0c0\ub0b4\ub294 $0$\uacfc $1$\uc758 \uc774\uc9c4\uc218 \ub098\uc5f4\ub85c \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc81c \ud1b5\ud569\uc801 \uc77d\uae30\ub97c \uc218\ud589\ud560 \ub54c \uac16\ucd94\uc5b4\uc57c \ud560 \ube44\ud310\uc801 \uc77d\uae30\uc758 \uc790\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uc790\ub8cc\uc758 \uad00\uc810, \uc815\ubcf4\uc758 \uc2e0\ub8b0\uc131, \ub17c\ub9ac\uc758 \ud0c0\ub2f9\uc131\uc744 \ub2e4\uac01\ub3c4\ub85c \uac80\ud1a0\ud558\uace0 \uc218\uc6a9 \uc5ec\ubd80\ub97c \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\ub294 \uc790\uc9c8\uc785\ub2c8\ub2e4."
          }
        ]
      }
    }
  ]
}