{
  "title": "\ubcf5\ud569\uc591\uc2dd \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ubcf5\ud569\uc591\uc2dd'\uc758 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790, \uadf8\ub9bc, \ud45c, \uadf8\ub798\ud504, \uc0ac\uc9c4, \ub3d9\uc601\uc0c1 \ub4f1 \uc5ec\ub7ec \uc591\uc2dd\uc774 \ubcf5\ud569\uc801\uc73c\ub85c \uc791\uc6a9\ud558\uc5ec \uc758\ubbf8\ub97c \uad6c\uc131\ud558\ub294 \uac83\uc744 \uc758\ubbf8\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c5\uc790\uac00 \ubcf5\ud569\uc591\uc2dd\uc73c\ub85c \uad6c\uc131\ub41c \uae00\uacfc \uc790\ub8cc\ub97c \uc77d\uc744 \ub54c \ud3c9\uac00\ud558\uba70 \uc77d\uc5b4\uc57c \ud560 3\uac00\uc9c0 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uae00\uc4f4\uc774\uc758 \uad00\uc810\n2. \uae00\uc4f4\uc774\uc758 \uc758\ub3c4\n3. \ud45c\ud604 \ubc29\ubc95"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \uc8fc\uc81c\uc5d0 \ub300\ud574 \ud611\ub825\uc801\uc73c\ub85c \uacf5\ub3d9 \ubcf4\uace0\uc11c\ub97c \uc791\uc131\ud560 \ub54c \ubcf5\ud569\uc591\uc2dd\uc744 \ud65c\uc6a9\ud558\uba74 \uc5b4\ub5a4 \ud6a8\uacfc\uac00 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc591\ud55c \uae00\uacfc \uc790\ub8cc\uc5d0\uc11c \uc5bb\uc740 \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294 \uc815\ubcf4\ub97c \uc885\ud569\ud558\uc5ec \ud6a8\uacfc\uc801\uc73c\ub85c \uc804\ub2ec\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc0ac\uae00 \ud45c\uc81c\uc5d0\uc11c \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc744 '\ub3c5\uc57d'\uc774\ub77c\uace0 \ud45c\ud604\ud55c \uae00\uc4f4\uc774\uc758 \uc758\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc774 \ud574\uc591 \uc0dd\ubb3c\uacfc \uc778\ub958\uc5d0 \ubbf8\uce58\ub294 \uc2ec\uac01\ud55c \uc720\ud574\uc131\uacfc \uc704\ud611\uc744 \uac15\ub82c\ud558\uac8c \uac15\uc870\ud558\uae30 \uc704\ud574\uc11c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\uc790\uc5f0\ubcf4\uc804\uc5f0\ub9f9(IUCN) \ubcf4\uace0\uc11c\uc5d0 \ub530\ub974\uba74 \ubc14\ub2e4\ub85c \uc720\uc785\ub418\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc758 \uc5f0\uac04 \uc591\uc740 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uac04 \uc57d 100\ub9cc \ud1a4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\uc790\uc5f0\ubcf4\uc804\uc5f0\ub9f9(IUCN, 2017) \uc870\uc0ac\uc5d0 \ub530\ub974\uba74, \ud574\uc591\uc73c\ub85c \uc720\uc785\ub418\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uc694\uc778 \uc911 \uac00\uc7a5 \ub192\uc740 \ube44\uc911\uc744 \ucc28\uc9c0\ud558\ub294 \ud56d\ubaa9\uacfc \uadf8 \ube44\uc728\uc740 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud569\uc131 \uc12c\uc720(\uc138\ud0c1\ubb3c)\uac00 35.0%\ub85c \uac00\uc7a5 \ub192\uc740 \ube44\uc911\uc744 \ucc28\uc9c0\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc591 \uc720\uc785 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uc694\uc778 \uc911 \ud569\uc131 \uc12c\uc720(35.0%) \ub2e4\uc74c\uc73c\ub85c \ub192\uc740 \ube44\uc911\uc744 \ucc28\uc9c0\ud558\ub294 2\uc704\uc640 3\uc704 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2\uc704\ub294 \ud0c0\uc774\uc5b4(28.0%), 3\uc704\ub294 \ub3c4\uc2dc \uba3c\uc9c0(24.0%)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub2f7\uc18d\uc744 \ub5a0\ub3c4\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uc870\uac01\ub4e4\uc744 '\ud654\ud559 \ubb3c\uc9c8\uc758 \ud63c\ud569\ubb3c'\uc774\ub77c\uace0 \ubd80\ub974\ub294 \ub450 \uac00\uc9c0 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc774 \ubb3c\uc18d\uc758 \uc794\ub958\uc131 \uc720\uae30 \uc624\uc5fc \ubb3c\uc9c8\uacfc \uc911\uae08\uc18d \ub4f1\uc744 \uc27d\uac8c \ud761\uc218\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.\n2. \ud50c\ub77c\uc2a4\ud2f1 \uc81c\uc870 \uc2dc \ucca8\uac00\ub41c \ub2e4\uc591\ud55c \uc720\ud574 \ud654\ud559 \ubb3c\uc9c8\uc774 \ucabc\uac1c\uc9c0\ub294 \uacfc\uc815\uc5d0\uc11c \uc0c8\uc5b4 \ub098\uc624\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc794\ub958\uc131 \uc720\uae30 \uc624\uc5fc \ubb3c\uc9c8'\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\ud658\uacbd\uc5d0\uc11c \ubd84\ud574\ub418\uc9c0 \uc54a\uace0 \uc0dd\ud0dc\uacc4\uc758 \uba39\uc774 \uc0ac\uc2ac\uc744 \uac70\uccd0 \ub3d9\uc2dd\ubb3c \uccb4\ub0b4\uc5d0 \ucd95\uc801\ub418\ub294 \uc720\ud574 \ubb3c\uc9c8\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud50c\ub77c\uc2a4\ud2f1 \uc81c\uc870 \uc2dc \ucca8\uac00\ubb3c\ub85c \uc0ac\uc6a9\ub418\ub294 '\ud504\ud0c8\ub808\uc774\ud2b8'\uc758 \uac1c\ub150\uacfc \uc720\ud574\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd \ud638\ub974\ubaac\uc758 \uc77c\uc885\uc73c\ub85c, \ub3d9\ubb3c\uc758 \uc0dd\uc2dd \uae30\uad00\uc5d0 \uc720\ud574\ud55c \ub3c5\uc131 \ubb3c\uc9c8\uc774\uba70 \ub0b4\ubd84\ube44 \uacc4\ud1b5\uc744 \uad50\ub780\ud558\uc5ec \uac1c\uccb4 \uc218\ub97c \uac10\uc18c\uc2dc\ud0ac \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2018\ub144 \uc57c\uc0dd \ubcd1\ucf54\ub3cc\uace0\ub798 12\ub9c8\ub9ac\uc758 \uc18c\ubcc0 \uc0d8\ud50c \uc5f0\uad6c\uc5d0\uc11c \uac80\ucd9c\ub418\uc5b4 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uc720\ud574 \ubb3c\uc9c8\uc758 \ub0b4\ubd84\ube44\uacc4 \uc601\ud5a5 \uac00\ub2a5\uc131\uc744 \ubcf4\uc5ec \uc900 \ubb3c\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ud0c8\ub808\uc774\ud2b8"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc591 \uc0dd\ubb3c\uc774 \uc12d\ucde8\ud55c \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc774 \uc778\uac04\uc5d0\uac8c \ucd5c\uc885 \ub3c4\ub2ec\ud558\ub294 \uacfc\uc815\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc744 \uba39\uc774\ub85c \ucc29\uac01\ud574 \uc12d\ucde8\ud55c \ud574\uc591 \uc0dd\ubb3c\uc774 \uba39\uc774 \uc0ac\uc2ac\uc744 \ub530\ub77c \uc0c1\uc704 \ud3ec\uc2dd\uc790\ub85c \uc774\ub3d9\ud558\uba70, \uc778\uac04\uc774 \ud574\uc0b0\ubb3c(\uc0dd\uc120, \ud64d\ud569, \uad74 \ub4f1)\uc744 \uc12d\ucde8\ud568\uc73c\ub85c\uc368 \uc778\uccb4\ub85c \ub418\ub3cc\uc544\uc628\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\uacc4\uc790\uc5f0\uae30\uae08(WWF) \uc5f0\uad6c \ubcf4\uace0\uc11c\uc5d0 \ub530\ub974\uba74, \uc77c\ubc18\uc801\uc778 \ud55c \uc0ac\ub78c\uc774 \uc77c\uc8fc\uc77c \ub3d9\uc548 \uc12d\ucde8\ud558\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc758 \uc591\uacfc \ube44\uad50 \ub300\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc8fc\uc77c\uc5d0 \uc57d 5g\uc744 \uc12d\ucde8\ud558\uba70, \uc774\ub294 \uc2e0\uc6a9 \uce74\ub4dc \ud55c \uc7a5\uc758 \ud06c\uae30(\ubb34\uac8c)\uc640 \uac19\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ubd80\ubd84\uc758 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uc54c\uac31\uc774\uac00 \ubab8 \ubc16\uc73c\ub85c \ubc30\ucd9c\ub428\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \uc12d\ucde8\uac00 \uc704\ud5d8\ud55c \uc9c8\ubcd1\uc744 \uc720\ubc1c\ud560 \uc218 \uc788\ub294 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc5d0 \ubb3b\uc5b4 \ub4e4\uc5b4\uc628 \ub3c5\uc131 \ubb3c\uc9c8\uacfc \ub354 \uc791\uc740 \uc785\uc790\ub85c \ubd84\ud574\ub41c \ub098\ub178 \ud50c\ub77c\uc2a4\ud2f1\uc774 \uccb4\ub0b4\uc5d0 \uc794\ub958\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc0ac\uae00\uc5d0\uc11c 2050\ub144\uc758 \ud574\uc591 \uc0dd\ud0dc\uacc4 \ud658\uacbd\uacfc \uad00\ub828\ud558\uc5ec \uc5b8\uae09\ud55c \uc608\uce21\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2050\ub144\uc774 \ub418\uba74 \uc804\uccb4 \ubb3c\uace0\uae30\uc758 \ubb34\uac8c\ubcf4\ub2e4 \ubc14\ub2f7\uc18d \ud50c\ub77c\uc2a4\ud2f1\uc758 \ubb34\uac8c\uac00 \ub354 \ub098\uac08 \uac83\uc774\ub77c\ub294 \uc608\uce21\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc0ac\uae00 \uc0c1\ub2e8\uc5d0 \uc601\uc0c1 \uc790\ub8cc('\uc6b0\ub9ac\uac00 \ubab0\ub790\ub358 \ud50c\ub77c\uc2a4\ud2f1 \uc774\uc57c\uae30')\ub97c \ubc30\uce58\ud55c \uae00\uc4f4\uc774\uc758 \uc758\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud50c\ub77c\uc2a4\ud2f1 \uc4f0\ub808\uae30 \ubb38\uc81c\uc758 \uc2e4\ud0dc\uc640 \uc2ec\uac01\uc131\uc744 \uc2dc\uac01\u00b7\uccad\uac01\uc801\uc73c\ub85c \ubcf4\uc5ec\uc8fc\uc5b4 \ub3c5\uc790\uc758 \uc2dc\uc120\uc744 \ub04c\uace0 \ubb38\uc81c\uc758\uc2dd\uc744 \uace0\ucde8\ud558\uae30 \uc704\ud574\uc11c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc0ac\uae00\uc5d0 \uc6d0\uadf8\ub798\ud504(IUCN, 2017) \uc790\ub8cc\ub97c \uc81c\uc2dc\ud55c \ud65c\uc6a9 \uc758\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc591 \uc720\uc785 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc758 \uc6d0\uc778\ubcc4 \ube44\uc728(\ud2b9\ud788 \ud569\uc131 \uc12c\uc720 \uc138\ud0c1\ubb3c\uc774 35%\ub85c \uac00\uc7a5 \ud07c)\uc744 \ud55c\ub208\uc5d0 \ud30c\uc545\ud560 \uc218 \uc788\ub3c4\ub85d \uc2dc\uac01\ud654\ud558\uae30 \uc704\ud574\uc11c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc0ac\uae00\uc5d0 \uadf8\ub9bc \uc790\ub8cc('\ud50c\ub77c\uc2a4\ud2f1\uc774 \uc6b0\ub9ac \uc2dd\ud0c1\uc5d0 \uc624\ub974\ub294 \uacfc\uc815')\ub97c \uc81c\uc2dc\ud55c \ud65c\uc6a9 \uc758\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc84\ub824\uc9c4 \ud50c\ub77c\uc2a4\ud2f1\uc774 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc774 \ub418\uc5b4 \uba39\uc774 \uc0ac\uc2ac\uc744 \uac70\uccd0 \uc6b0\ub9ac \uc2dd\ud0c1\uc5d0 \uc774\ub974\uae30\uae4c\uc9c0\uc758 \uacfc\uc815\uc744 \ub2e8\uacc4\ubcc4\ub85c \uc774\ud574\ud558\uae30 \uc27d\uac8c \ubcf4\uc5ec\uc8fc\uae30 \uc704\ud574\uc11c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc0ac\uae00 \uc544\ub798 \ub313\uae00 \uc911 '\ub124\ubaa8' \ud559\uc0dd\uc774 \ucda9\uaca9\uc744 \ubc1b\uc558\ub2e4\uace0 \uc5b8\uae09\ud55c \ub0b4\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc591\uc5d0 \uc720\uc785\ub418\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uc911\uc5d0\uc11c \ud569\uc131 \uc12c\uc720\uc758 \ube44\uc911\uc774 \uac00\uc7a5 \ud06c\ub2e4\ub294 \uc0ac\uc2e4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uacf5\ub3d9 \ubcf4\uace0\uc11c'\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815\ud55c \uc8fc\uc81c\uc5d0 \uad00\uc2ec\uc774 \uc788\ub294 \uc0ac\ub78c\ub4e4\uc774 \ud568\uaed8 \ubaa8\uc5ec \uc5b4\ub5a4 \ubaa9\uc801\uc744 \uac00\uc9c0\uace0 \uad00\ucc30, \uc870\uc0ac, \ub2f5\uc0ac, \uc5f0\uad6c, \uc2e4\ud5d8 \ub4f1\uc744 \uc218\ud589\ud55c \ub4a4 \uadf8 \uc808\ucc28\uc640 \uacb0\uacfc\ub97c \uc815\ub9ac\ud558\uc5ec \uc815\ubcf4\ub97c \uc804\ub2ec\ud558\ub294 \uae00\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc0ac \ubcf4\uace0\uc11c\uc758 \uc77c\ubc18\uc801\uc778 3\ub2e8\uacc4 \uad6c\uc131 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
