      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uc77c\ubc18 \ub300\uc0ac\uc640 \ub2e4\ub978 \ub3c5\ud2b9\ud55c \uc11c\uccb4 \uc801\uc6a9\n2) \ub178\ub7ab\ub9d0 \uc0ac\uc774\uc5d0 \ubb3c\uacb0\ud45c(~)\ub97c \ub123\uc5b4 \uc6b4\uc728\uac10 \ud45c\ud604"
