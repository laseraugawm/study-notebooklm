      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uac00 \uadf9\ubcf5\ud55c 4\uac00\uc9c0 \ud55c\uacc4 \uad6c\uc870:"
