{
  "title": "\ub9e4\uccb4 \ube44\ud3c9 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\uccb4 \ube44\ud3c9 \uc790\ub8cc\uc758 \uae30\ubcf8 \uc815\uc758\uc640 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc45, \uc2e0\ubb38, \uc601\ud654, \uad11\uace0, \uc6f9\ud230, \uc6f9\uc9c4 \ub4f1 \ub2e4\uc591\ud55c \ub9e4\uccb4 \uc790\ub8cc\uc5d0 \ub300\ud55c \uc774\ud574\uc640 \ud3c9\uac00\ub97c \ub0b4\uc6a9\uc73c\ub85c \ub2e4\ub8e8\ub294 \uc790\ub8cc\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\uccb4 \ube44\ud3c9\uc744 \uc218\ud589\ud560 \ub54c '\ub0b4\uc6a9 \uce21\uba74'\uc5d0\uc11c \uc8fc\ub85c \ud3c9\uac00\ud558\ub294 \ub450 \uac00\uc9c0 \uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uad00\uc810, \uc758\ub3c4, \ubaa9\uc801\uc758 \ud0c0\ub2f9\uc131\uacfc \uc801\uc808\uc131\n2) \uc8fc\uc81c\uc758 \uc801\ud569\uc131, \uc81c\uc7ac\uc758 \uc131\uaca9\uacfc \uae30\ub2a5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\uccb4 \ube44\ud3c9\uc744 \uc218\ud589\ud560 \ub54c '\ud615\uc2dd \uce21\uba74'\uc5d0\uc11c \uc8fc\ub85c \ud3c9\uac00\ud558\ub294 \uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud45c\ud604 \ubc29\ubc95\uc758 \ud6a8\uacfc\uc640 \uc801\uc808\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\uccb4 \uc790\ub8cc\ub97c \uc218\uc6a9\ud560 \ub54c \uc694\uad6c\ub418\ub294 \ubc14\ub78c\uc9c1\ud55c \uc218\uc6a9 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\uccb4 \uc790\uccb4\uc758 \ud2b9\uc131\uc744 \uace0\ub824\ud558\uc5ec \uc8fc\uccb4\uc801\uc774\uba74\uc11c\ub3c4 \ube44\ud310\uc801\uc73c\ub85c \uc218\uc6a9\ud558\uace0 \uc0dd\uc0b0\ud558\ub294 \ud0dc\ub3c4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\ud3c9\ubb38 \u300c\uacb9\uacb9\uc758 \ud55c\uacc4\ub4e4\ub85c \uc99d\uba85\ud55c \ubb34\ud55c\ud568\u300d(\uae40\ud76c\uacbd)\uc5d0\uc11c \ube44\ud3c9 \ub300\uc0c1\uc73c\ub85c \ub2e4\ub8ec \uc6f9\ud230 \uc791\ud488\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230\uc774\ub77c\ub294 \ub9e4\uccb4 \ubd84\uc57c\uc5d0\uc11c '\ubb34\ud55c\ud568'\uc774\ub77c\ub294 \ub2e8\uc5b4\uac00 \uc790\uc8fc \uc0ac\uc6a9\ub418\ub294 \uc77c\ubc18\uc801\uc778 \uc758\ubbf8\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230\uc774 \uc0c1\uc0c1\ub825, \uc7a5\ub974, \uc18c\uc7ac \ub4f1\uc758 \ud55c\uacc4 \uc5c6\uc774 \ub2e4\ucc44\ub85c\uc6b4 \ucc38\uc2e0\ud55c \uc2dc\ub3c4\ub97c \ud560 \uc218 \uc788\ub2e4\ub294 \uc758\ubbf8\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc758 \uc911\uc2ec \uc18c\uc7ac\uac00 \ub418\ub294 \ub0af\uc120 \uc804\ud1b5 \uacf5\uc5f0 \uc608\uc220 \uc7a5\ub974\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\uc131 \uad6d\uadf9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc5ec\uc131 \uad6d\uadf9' \uc7a5\ub974\uac00 \uac00\uc9c4 \ud575\uc2ec\uc801\uc778 \ub450 \uac00\uc9c0 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uc804\ud1b5 \uc74c\uc545(\ucc3d\uadf9)\uc744 \uae30\ubc18\uc73c\ub85c \ud558\ub294 \uacf5\uc5f0 \ud615\ud0dc\uc774\ub2e4.\n2) \uc5ec\uc131\uc774 \ub4f1\uc7a5\uc778\ubb3c\uc758 \uc131\ubcc4\uacfc \uad00\uacc4\uc5c6\uc774 \ubaa8\ub4e0 \uc5ed\ud560\uc744 \ub9e1\uc544 \uc5f0\uae30\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230\uc774\ub77c\ub294 \ub9e4\uccb4\uac00 \uc2dc\uac01 \ub9e4\uccb4\ub85c\uc11c \uc9c0\ub2cc \ud0dc\uc0dd\uc801 \ud55c\uacc4 \uc911 \ud558\ub098\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ub9ac\ub97c \uc628\uc804\ud788 \uccad\uac01\uc801\uc73c\ub85c \uad6c\ud604\ud558\uac70\ub098 \uc9c1\uc811 \uc804\ub2ec\ud558\uae30 \uc5b4\ub835\ub2e4\ub294 \uccad\uac01\uc801 \ud55c\uacc4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874 \uc74c\uc545 \uc18c\uc7ac \uc6f9\ud230\ub4e4\uc774 \uc18c\ub9ac\uc758 \ubd80\uc7ac\ub77c\ub294 \ud55c\uacc4\ub97c \uc790\uc5f0\uc2a4\ub7fd\uac8c \uadf9\ubcf5\ud560 \uc218 \uc788\uc5c8\ub358 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85d \ubc34\ub4dc\ub098 \uad00\ud604\uc545\ub2e8\ucc98\ub7fc \uc8fc \ub3c5\uc790\uce35\uc5d0\uac8c \uce5c\uc219\ud55c \uc74c\uc545 \uc7a5\ub974\ub97c \ub2e4\ub8e8\uc5b4 \ub3c5\uc790\uac00 \uba38\ub9bf\uc18d\uc73c\ub85c \uc18c\ub9ac\ub97c \uc27d\uac8c \uc5f0\uc0c1\ud560 \uc218 \uc788\uc5c8\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uac00 \uc18c\ub9ac\ub97c \ub3c5\uc790\uc5d0\uac8c \uc804\ub2ec\ud558\uae30 \ub354 \uc5b4\ub824\uc6e0\ub358 \uc18c\uc7ac\uc0c1\uc758 \uc870\uac74\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uc911\uc5d0\uac8c \uc0dd\uc18c\ud558\uace0 \ub0af\uc120 \uc804\ud1b5 \uc74c\uc545\uc778 '\uc5ec\uc131 \uad6d\uadf9'\uc744 \uc18c\uc7ac\ub85c \ub2e4\ub8e8\uc5c8\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c \ub178\ub798(\uc18c\ub9ac)\ub97c \uc77c\ubc18 \ub300\uc0ac\uc640 \uad6c\ubcc4\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud55c \uc2dc\uac01\uc801 \ud45c\ud604 \uae30\ubc95\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uc0ac\uc640 \uc11c\uccb4(\ud3f0\ud2b8)\ub97c \ub2e4\ub974\uac8c \uc9c0\uc815\ud558\uc5ec \uc2dc\uac01\uc801\uc73c\ub85c \uad6c\ubcc4\ud558\uc600\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c \ub178\ub7ab\ub9d0 \uc0ac\uc774\uc5d0 \ubb3c\uacb0\ud45c(~)\ub97c \uc801\uadf9 \ud65c\uc6a9\ud55c \ubaa9\uc801\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ub9ac\uc758 \uae38\uc774\uc640 \uc6b4\uc728\uac10\uc744 \uc2dc\uac01\ud654\ud558\uc5ec \ub3c5\uc790\uac00 \ub178\ub798\uc758 \uac00\ub77d\uc744 \uc9d0\uc791\ud558\uace0 \uc774\ud574\ud558\ub3c4\ub85d \ub3d5\uae30 \uc704\ud574\uc11c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c \uccad\uac01\uc801 \uc18c\ub9ac\uc758 \ud55c\uacc4\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \uc885\ud569\uc801\uc73c\ub85c \uacb0\ud569\ud55c \uc5f0\ucd9c \uc694\uc18c\ub4e4\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\ucc44\ub85c\uc6b4 \ub3d9\uc791, \uc5ed\ub3d9\uc801\uc778 \uce74\uba54\ub77c \uc575\uae00, \uc11c\uccb4\uc758 \ubcc0\ud654, \ubb3c\uacb0\ud45c \ub4f1\uc758 \uc2dc\uac01\uc801 \uae30\ubc95\uc744 \uacb0\ud569\ud558\uc5ec \uc18c\ub9ac\ub97c \uc2dc\uac01\uc801\uc73c\ub85c \ud615\uc0c1\ud654\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230\uc774 \ud3c9\uba74\uc5d0 \uad6c\ud604\ub418\ub294 \uc2dc\uac01 \ub9e4\uccb4\ub77c\ub294 \uc810\uc5d0\uc11c \ube44\ub86f\ub418\ub294 \ud55c\uacc4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc5f0\uc758 \ub178\ub798, \ucda4, \uc5f0\uae30 \ub4f1\uc744 \ud604\uc7a5\uac10 \uc788\uace0 \uc785\uccb4\uac10 \uc788\uac8c \ud45c\ud604\ud558\uae30 \ud798\ub4e4\ub2e4\ub294 \ud55c\uacc4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ucd9c \uae30\ubc95 \uc911 '\ud074\ub85c\uc988\uc5c5(close-up)'\uc758 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc0ac\uccb4\uc5d0 \uac00\uae4c\uc774 \uc811\uadfc\ud558\uc5ec \ud654\uba74 \uac00\ub4dd \ud3ec\ucc29\ud558\uc5ec \ucc0d\uac70\ub098 \uadf8\ub9b0 \uc7a5\uba74 \uc5f0\ucd9c \uae30\ubc95\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ucd9c \uae30\ubc95 \uc911 '\ud558\uc774 \uc575\uae00(high angle)'\uc758 \uac1c\ub150\uacfc \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\uba54\ub77c\ub97c \ud53c\uc0ac\uccb4\ubcf4\ub2e4 \ub192\uc740 \uacf3\uc5d0 \ub193\uc544 \uc704\uc5d0\uc11c \uc544\ub798\ub97c \ub0b4\ub824\ub2e4\ubcf4\ub294 \ub290\ub08c\uc774 \ub4e4\ub3c4\ub85d \ucd2c\uc601\u00b7\uc5f0\ucd9c\ud558\ub294 \uae30\ubc95\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ud654\ub098 \ub4dc\ub77c\ub9c8\uc5d0\uc11c \uc77c\ubc18\uc801\uc73c\ub85c \uc0ac\uc6a9\ub418\ub294 '\uc624\ubc84\ub7a9(overlap)' \ud6a8\uacfc\uc758 \uc8fc\uc694 \uae30\ub2a5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uc7a5\uba74\uc774 \uc11c\uc11c\ud788 \uc0ac\ub77c\uc9c0\uba70 \ub2e4\uc74c \uc7a5\uba74\uc774 \uacb9\uccd0 \ub4f1\uc7a5\ud558\uc5ec, \uacfc\uac70\uc640 \ud604\uc7ac \ub4f1 \uc2dc\uac04\uc758 \uad50\ucc28\ub098 \ucc29\uc2dc \ud6a8\uacfc\ub97c \uc904 \ub54c \uc8fc\ub85c \uc0ac\uc6a9\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uac00 \uae30\uc874 \ub9e4\uccb4\uc640 \ub2ec\ub9ac \ub3c5\ucc3d\uc801\uc73c\ub85c \ud65c\uc6a9\ud55c '\uc778\ubb3c \uac04 \uc624\ubc84\ub7a9' \uae30\ubc95\uc774\ub780?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\uc6b0\uac00 \uacf5\uc5f0 \uce90\ub9ad\ud130\uc640 \ud63c\uc5f0\uc77c\uccb4\uac00 \ub418\uc5b4 \ubab0\uc785\ud560 \ub54c, \ubc30\uc6b0 \uc790\uc2e0\uacfc \uacf5\uc5f0 \uce90\ub9ad\ud130\ub97c \ud55c \ud654\uba74\uc5d0 \uacb9\uccd0 \uadf8\ub824 \ub123\ub294 \ud45c\ud604 \ubc29\uc2dd\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c \uacf5\uc5f0 \uc2e4\ud669\uc758 \uc785\uccb4\uac10\uc744 \uc0b4\ub9ac\uae30 \uc704\ud574 \uad6c\uc0ac\ud55c \uc7a5\uba74 \ucef7 \uad6c\uc131 \uc21c\uc11c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uccb4 \ubb34\ub300 \ud55c \ud654\uba74 \uad6c\ub3c4 $\\rightarrow$ \uad70\ubb34 \uc7a5\uba74\uc744 \ud1b5\ud55c \ubb34\ub300 \ubd84\uc704\uae30 \uc804\ub2ec $\\rightarrow$ \ub178\ub798\uc640 \uc5f0\uae30 \ubcf8 \ubb34\ub300 \uc778\ubb3c \ud074\ub85c\uc988\uc5c5 \uc21c\uc73c\ub85c \uad6c\uc131\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc5f0 \ubb34\ub300\uac00 \uc9c0\ub2cc \uacf5\uac04\uc801 \ud2b9\uc131 \uc911 '\uc5f4\ub9b0 \uacf5\uac04'\uc73c\ub85c\uc11c\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ub300\uac00 \ud604\uc2e4 \uc138\uacc4\uc640 \ubd84\ub9ac\ub41c \ubcc4\ub3c4\uc758 \uac00\uc0c1 \uacf5\uac04\uc744 \uc790\uc720\ub86d\uac8c \ucc3d\uc870\ud574 \ub0b8\ub2e4\ub294 \uc810\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc5f0 \ubb34\ub300\uac00 \uc9c0\ub2cc \uacf5\uac04\uc801 \ud2b9\uc131 \uc911 '\ub2eb\ud78c \uacf5\uac04'\uc73c\ub85c\uc11c\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ub300\uc5d0 \uc624\ub97c \uc218 \uc788\ub294 \ub4f1\uc7a5\uc778\ubb3c\uc758 \uc218\uc640 \uacf5\uac04\uc801 \ud55c\uacc4\uac00 \uc81c\ud55c\ub418\uc5b4 \uc788\ub2e4\ub294 \uc810\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ub300\uac00 '\ub2eb\ud78c \uacf5\uac04'\uc774\ub77c\ub294 \ud55c\uacc4 \ub54c\ubb38\uc5d0 \ucd08\ub798\ub420 \uc218 \uc788\ub294 \uc11c\uc0ac\uc801 \ud55c\uacc4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc778\uacf5\uacfc \uc8fc\uc694 \uc778\ubb3c \uac04\uc758 \uacbd\uc7c1 \ubc0f \uac08\ub4f1\ub9cc\uc744 \uc911\uc2ec\uc73c\ub85c \uc11c\uc0ac\uac00 \ub2e8\uc21c\ud558\uace0 \ub2e8\uc120\uc801\uc73c\ub85c \uc804\uac1c\ub420 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uac00 \ubb34\ub300 \uacf5\uac04\uc758 \ub2e8\uc120\uc801 \ud55c\uacc4\ub97c \ub118\uc5b4\uc11c\ub294 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc778\uacf5\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc8fc\ubcc0 \uc778\ubb3c\ub4e4\uc5d0\uac8c\ub3c4 \uc8fc\uccb4\uc801 \uc5ed\ud560\uacfc \uc11c\uc0ac\uc801 \ubc18\uc804\uc744 \ubd80\uc5ec\ud558\uc5ec \ub2e4\ucc44\ub86d\uace0 \uc785\uccb4\uc801\uc778 \uc11c\uc0ac\ub97c \ud615\uc131\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4f1\uc7a5\uc778\ubb3c '\ubc31\ub3c4\uc575'\uc774 \uc791\ud488 \ub0b4\uc5d0\uc11c \ub2f4\ub2f9\ud558\ub294 \uc8fc\uc694 \uae30\ub2a5\uacfc \uc758\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ucd9c\uac00\uc640 \ube44\ud3c9\uac00\uc758 \uc2dc\uac01\uc744 \ub118\ub098\ub4e4\uba70 \ubb34\ub300 \uc0c1\ud669\uc744 \ubd84\uc11d\ud574\uc8fc\uc5b4 \ub3c5\uc790\uac00 \uc0dd\uc18c\ud55c \uc5ec\uc131 \uad6d\uadf9 \uc7a5\ub974\ub97c \uc27d\uac8c \uc774\ud574\ud558\ub3c4\ub85d \ub3d5\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4f1\uc7a5\uc778\ubb3c '\ubc31\ub3c4\uc575'\uc774 \uae68\ub2eb\uace0 \uadf9\ubcf5\ud558\ub824 \ud558\ub294 \ub0b4\uba74\uc758 \ud3b8\uacac\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc774 \uc591\ubc18 \uac00\ubb38 \ucd9c\uc2e0\uc774\ubbc0\ub85c \uae30\uc0dd \ucd9c\uc2e0\uc73c\ub85c \uad6d\uadf9\uc744 \uc2dc\uc791\ud55c \uc774\ub4e4\uacfc\ub294 \ub2e4\ub974\ub2e4\ub294 \uacc4\uae09\uc801\u00b7\uc2e0\ubd84\uc801 \ud3b8\uacac\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4f1\uc7a5\uc778\ubb3c '\ud5c8\uc601\uc11c'\uc758 \ucd08\uae30 \uc778\ubb3c \uac00\uce58\uad00\uacfc \uc131\uaca9\uc740 \uc5b4\ub5a0\ud588\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\"\ubb34\ub300\ub294 \ud63c\uc790 \uc11c\ub294 \uac70\uc57c\"\ub77c\ub294 \uc2e0\ub150\uc744 \uac00\uc9c4 \uc790\uae30\uc911\uc2ec\uc801\uc778 \ub3c5\ubd88\uc7a5\uad70 \uc720\ud615\uc758 \uc778\ubb3c\uc774\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4f1\uc7a5\uc778\ubb3c '\ud5c8\uc601\uc11c'\uac00 \u300c\uc790\uba85\uace0\u300d \ubb34\ub300\ub97c \uc900\ube44\ud558\uba70 \uacaa\uc740 \uc131\uc7a5\uc758 \ubaa8\uc2b5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ub300\ubc29\uacfc \ud638\ud761\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uace0, \uc815\ub144\uc744 \ub2e8\uc21c\ud788 \ubc29\ud574\u00b7\uacac\uc81c\ud558\ub294 \ub300\uc2e0 \uc815\uc815\ub2f9\ub2f9\ud558\uac8c \uc2e4\ub825\uc73c\ub85c \uc2b9\ubd80\ud558\uace0\uc790 \ubcc0\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4f1\uc7a5\uc778\ubb3c '\ud5c8\uc601\uc11c'\uac00 \uc5b4\uba38\ub2c8\ub85c\ubd80\ud130 \ubc1b\uc544\uc628 \ub0b4\uba74\uc801 \uc0c1\ucc98\uc640 \ud3b8\uacac\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub798\uc2dd \uc131\uc545\ub9cc\uc774 \uace0\uae09\ubb38\ud654\uc774\uace0 \uc804\ud1b5 \uad6d\uadf9\uc740 \ud558\ub4f1\ud558\ub2e4\ub294 \uc5b4\uba38\ub2c8\uc758 \uc608\uc220\uc801 \ud3b8\uacac\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4f1\uc7a5\uc778\ubb3c '\ud64d\uc8fc\ub780'\uc774 \ubcf4\uc5ec\uc8fc\ub294 \uc778\ubb3c\uc758 \uc785\uccb4\uc131\uacfc \ubc18\uc804\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e8\uc21c\ud55c \uc8fc\uc778\uacf5\uc758 \uce5c\uad6c \uc5ed\ud560\uc5d0 \uadf8\uce58\uc9c0 \uc54a\uace0 \uc624\ub514\uc158\uc744 \ud1b5\ud574 \ube44\uc911 \uc788\ub294 '\uad6c\uc2ac\uc544\uae30' \uc5ed\uc744 \ub9e1\uc73c\uba70 \uac15\ub82c\ud55c \uc5f0\uae30\ub825\uacfc \ubc18\uc804\uc744 \ubcf4\uc5ec\uc8fc\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0 \uc874\uc7ac\ud558\ub294 \ub2e4\uc591\ud55c \ud55c\uacc4\ub4e4\uc758 '\uc815\uc810'\uc5d0 \uc788\ub294 \uc2dc\ub300\uc801\u00b7\uc0ac\ud68c\uc801 \uc7a5\ubcbd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\ubcc4, \uc2e0\ubd84, \uc608\uc220 \uac00\uce58 \ub4f1\uc5d0 \ub300\ud574 \ub2f9\ub300 \uc2dc\ub300\uc640 \uc0ac\ud68c\uac00 \uc9d1\ub2e8\uc801\uc73c\ub85c \uac00\uc84c\ub358 \ud3b8\uacac\ub4e4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c \ub4f1\uc7a5\uc778\ubb3c\ub4e4\uc758 '\uc131\uc7a5'\uc774 \uc774\ub8e8\uc5b4\uc9c0\ub294 \uacc4\uae30\uc640 \uc870\uac74\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\ub3c4 \ubaa8\ub974\uac8c \ub0b4\uba74\uc5d0 \uc2a4\uba70\ub4e4\uc5b4 \uc788\ub358 \ud3b8\uacac\uc744 \uc2a4\uc2a4\ub85c \uc778\uc9c0\ud558\uace0 \uc774\ub97c \uadf9\ubcf5\ud574 \ub098\uac00\ub294 \uacfc\uc815\uc5d0\uc11c \uc774\ub8e8\uc5b4\uc9c4\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\uc6b0\ub4e4\uc758 \ub0b4\uba74\uc801 \uc131\uc7a5\uc774 \uc791\ud488 \uc548\uc758 '\uad00\uac1d'\ub4e4\uc5d0\uac8c \uc804\ud574\uc9c0\uace0 \uc601\ud5a5\uc744 \uc8fc\ub294 \uc5f0\uc1c4\uc801 \uacfc\uc815\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\uc6b0\uac00 \uc2a4\uc2a4\ub85c \ud3b8\uacac\uc744 \uae68\ud2b8\ub9ac\uba74 \ubb34\ub300 \uc704 \uc5f0\uae30\ub85c \uc2b9\ud654\ub418\uace0, \uc774\ub97c \ubcf4\ub294 \uac1d\uc11d \uad00\uac1d\ub4e4\uc774 \uc5f0\uae30\uc5d0 \uac10\ud654\ub418\uc5b4 \ud3b8\uacac\uc744 \uae68\uac8c \ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uac00 \uacf5\uc5f0 \uc7a5\uba74\ub9c8\ub2e4 \uac1d\uc11d \uad00\uac1d\ub4e4\uc758 \ubc18\uc751 \ucef7\uc744 \ubc30\uce58\ud558\ub294 \ud45c\ud604\uc0c1\uc758 \ud6a8\uacfc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\uc131\uc774 \ub0a8\uc131\uc744 \uc5f0\uae30\ud558\ub294 \uac83\uc5d0 \uacf1\uc9c0 \uc54a\uc740 \uc2dc\uc120\uc744 \ubcf4\ub0b4\ub358 \uc0ac\ub78c\ub4e4\ub3c4 \uc9c4\uc815\uc131 \uc788\ub294 \uc5f0\uae30\uc5d0 \uac10\ud654\ub418\uc5b4 \ubcc0\ud654\ud558\ub294 \uacfc\uc815\uc744 \uc0dd\uc0dd\ud788 \uc804\ub2ec\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc790\uba85\uace0\u300d \uacf5\uc5f0 \uc2dc \uc5ec\uc7a5\ub0a8\uc131\uc5d0 \ub208\uc0b4\uc744 \ucc0c\ud478\ub9ac\ub2e4 \uc815\ub144\uc774\uc758 \uc9c4\uc815\uc131 \uc788\ub294 \uc5f0\uae30\uc5d0 \uac10\ub3d9\ud574 \ub208\ubb3c\uc744 \ud758\ub9b0 \ud560\uc544\ubc84\uc9c0\uc758 \uacc4\uae30\uac00 \ub41c \uc5ed\ud560\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc871\uacfc \ub098\ub77c\ub97c \uc704\ud574 \uc22d\uace0\ud55c \ub9c8\uc74c\uc73c\ub85c \uc5f0\uae30\ud55c \ub2e8\uc5ed '\uad70\uc878 1' \uc5ed\ud560\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 '\uccb4\ud654(\u9ad4\u5316)'\uc758 \uc0ac\uc804\uc801 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uac01, \uc0ac\uc0c1, \uc774\ub860 \ub530\uc704\uac00 \ubab8\uc5d0 \ubc30\uc5b4\uc11c \uc644\uc804\ud788 \uc790\uc2e0\uc758 \uac83\uc774 \ub428\uc744 \ub73b\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 '\uac10\ud654(\u611f\u5316)'\uc758 \uc0ac\uc804\uc801 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc88b\uc740 \uc601\ud5a5\uc744 \ubc1b\uc544 \uc0dd\uac01\uc774\ub098 \uac10\uc815\uc774 \ubc14\ub78c\uc9c1\ud558\uac8c \ubcc0\ud654\ud568, \ub610\ub294 \uadf8\ub807\uac8c \ubcc0\ud558\uac8c \ud568\uc744 \ub73b\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 '\ud1b5\ucc30\ub825(\u6d1e\u5bdf\u529b)'\uc758 \uc0ac\uc804\uc801 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c\uc774\ub098 \ud604\uc0c1\uc744 \uae4a\uc774 \uc788\uac8c \uaff0\ub6ab\uc5b4 \ubcf4\ub294 \ub2a5\ub825\uc744 \ub73b\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ud718 '\uc815\uc810(\u9802\u9ede)'\uc758 \uc0ac\uc804\uc801 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c\uc758 \uc9c4\ud589\uc774\ub098 \ubc1c\uc804\uc774 \ucd5c\uace0\uc758 \uacbd\uc9c0\uc5d0 \ub2ec\ud55c \uc0c1\ud0dc\ub97c \ub73b\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc778\uacf5 '\uc815\ub144'\uc774 \uad6d\uadf9\ub2e8\uc5d0 \ub4e4\uc5b4\uc628 \ucd08\uae30 \ubaa9\uc801\uacfc \uac00\uce58\uad00\uc740 \ubb34\uc5c7\uc774\uc5c8\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c8\uc744 \ub9ce\uc774 \ubc8c\uc5b4 \uc5c4\ub9c8\uc5d0\uac8c \ubcf4\uc5ec\uc8fc\uae30 \uc704\ud55c '\uc0dd\uacc4\uc720\uc9c0 \ubc0f \ubd80\uc758 \ucd95\uc801'\uc774 \ubaa9\uc801\uc774\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\"\uc65c \uad6d\uadf9\uc744 \ud558\ub824 \ud558\ub290\ub0d0?\"\uc5d0 \ub300\ud55c \uc815\ub144\uc774\uc758 \ub300\ub2f5\uc774 \uad81\uadf9\uc801\uc73c\ub85c \ubcc0\ud55c \ubaa9\uc801\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e8\uc21c\ud55c \uc0dd\uacc4 \uc218\ub2e8\uc744 \ub118\uc5b4, \ubb34\ub300 \uc704\uc5d0\uc11c \uc790\uc2e0\uc774 \uc9c4\uc815 \ud45c\ud604\ud558\uace0 \uc2f6\uc740 \uc874\uc7ac \uadf8 \uc790\uccb4\uac00 \ub418\uace0\uc790 \ud558\ub294 \uc608\uc220\uc801 \uc5f4\ub9dd\uc73c\ub85c \ubcc0\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\ud3c9\uac00 \uae40\ud76c\uacbd\uc774 \ud30c\uc545\ud55c, \uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uac00 \uc5b4\ub835\uace0 \ub0af\uc120 \ud55c\uacc4\ub4e4\uc5d0 \ub3c4\uc804\ud55c \uad81\uadf9\uc801 \ub3d9\uae30\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4f1\uc7a5\uc778\ubb3c\ub4e4\uc758 \uc0b6\uc5d0\ub3c4, \uadf8\ub9ac\uace0 \uc6f9\ud230\uc774\ub77c\ub294 \ub9e4\uccb4\uc5d0\ub3c4 \ud55c\uacc4\ub780 \uc5c6\uc74c\uc744 \uc99d\uba85\ud574 \ub0b4\uace0\uc790 \ud558\ub294 \uac15\ub82c\ud55c \uc5f4\ub9dd \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\ud3c9\ubb38 \u300c\uacb9\uacb9\uc758 \ud55c\uacc4\ub4e4\ub85c \uc99d\uba85\ud55c \ubb34\ud55c\ud568\u300d\uc744 \uc77d\uc744 \ub54c \uc81c\uae30\ud560 \uc218 \uc788\ub294 \ube44\ud310\uc801 \uc758\ubb38\uc758 \uc608\uc2dc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\ud488 \uc18d \ub4f1\uc7a5\uc778\ubb3c\uc774 \ud3b8\uacac\uacfc \ud55c\uacc4\ub97c \uadf9\ubcf5\ud558\ub294 \uc11c\uc0ac\uc801 \ub0b4\uc6a9\uacfc \ub9e4\uccb4(\uc6f9\ud230) \uc790\uccb4\uc5d0 \ud55c\uacc4\uac00 \uc5c6\ub2e4\ub294 \uc810\uc744 \uc9c1\uc811 \uc5f0\uacb0\ud558\ub294 \ub17c\ub9ac\uac00 \uacfc\uc5f0 \ud0c0\ub2f9\ud55c\uac00?"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd5c\uae30\ud604\uc758 \ube44\ud3c9\ubb38(\u300c\uc5ec\uc131 \uad6d\uadf9\uc744 \ubc14\ub77c\ubcf4\ub294 3\uc778\uc758 \uad00\uc810\u300d)\uc5d0\uc11c \uc8fc\ubaa9\ud55c \uc2dc\uac01\uc801 \ube44\ud3c9 \uc694\uc18c 3\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uc0c9\uc758 \ud65c\uc6a9\n2) \uc120\uc758 \ud65c\uc6a9\n3) \uba38\ub9ac \ubaa8\uc591\uacfc \ubcf5\uc7a5\uc744 \ud1b5\ud55c \uc778\ubb3c \uac1c\uc131 \ud45c\ud604"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c \uc2dc\uac01\uc801 \uc548\uc815\uac10\uacfc \ud3b8\uc548\ud568\uc744 \uc8fc\uae30 \uc704\ud574 \ud65c\uc6a9\ud55c \ub300\ud45c\uc801\uc778 \ubcf4\uc0c9 \uad00\uacc4 \uc0c9\uc0c1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud558\ub298\uacfc \uce58\ub9c8\uc758 \ud30c\ub780\uc0c9\uacfc \uac74\ubb3c \ubc0f \ucc45\uc758 \ud669\ud1a0\uc0c9(\uc8fc\ud669\uacfc \ub178\ub780\uc0c9 \uc0ac\uc774)\uc758 \ub300\ube44\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc5d0\uc11c \uba85\uc554 \ud45c\ud604\uc744 \ucd5c\ub300\ud55c \uc790\uc81c\ud558\uace0 \ubc30\uacbd\uc744 \ud3c9\uba74 \ucc98\ub9ac\ud558\uc5ec \uc5bb\uc740 \uc2dc\uac01\uc801 \ud6a8\uacfc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\uacbd\uc758 \ubcf5\uc7a1\ud568\uc744 \uc904\uc5ec \ub3c5\uc790\uc758 \uc8fc\uc758\uc640 \uc2dc\uc120\uc774 \ub4f1\uc7a5\uc778\ubb3c\uc5d0\uac8c \ub354\uc6b1 \uc9d1\uc911\ub418\ub3c4\ub85d \ub9cc\ub4e4\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uc758 \uc120\uc758 \ub450\uaed8\uac00 \uc77c\uc815\ud558\uace0 \ubc00\ub3c4\uac00 \ub0ae\uc544 \ub3c5\uc790\uc5d0\uac8c \uc8fc\ub294 \ub3c5\ud2b9\ud55c \uc778\uc0c1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uba74\uc774 \ub2f5\ub2f5\ud558\uc9c0 \uc54a\uace0 \uc2dc\uc6d0\ud558\uace0 \ud0c1 \ud2b8\uc778 \uc2dc\uac01\uc801 \ub290\ub08c\uc744 \uc900\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\uc0c1 \uad11\uace0\ub97c \ube44\ud3c9\ud560 \ub54c '\ub0b4\uc6a9 \uce21\uba74'\uc5d0\uc11c \uc810\uac80\ud574\uc57c \ud560 \ud575\uc2ec \uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\uace0\uc758 \uc8fc\uc81c, \uc81c\uc791 \ubaa9\uc801 \ubc0f \uc758\ub3c4, \uc804\ub2ec \uba54\uc2dc\uc9c0\uc758 \ud0c0\ub2f9\uc131\uacfc \uc801\uc808\uc131\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\uc0c1 \uad11\uace0 \ube44\ud3c9 \uc2dc '\ud615\uc2dd \uce21\uba74'\uc5d0\uc11c \ub9e4\uccb4 \ud2b9\uc131\uc744 \uace0\ub824\ud558\uc5ec \ud3c9\uac00\ud560 \uad6c\uccb4\uc801 \uc694\uc18c\ub4e4\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uccad\uac01 \uc774\ubbf8\uc9c0, \ubc30\uacbd \uc74c\uc545, \uc790\ub9c9, \ud654\uba74 \uad6c\uc131 \ubc0f \uc5f0\ucd9c \uae30\ubc95\uc758 \ud6a8\uacfc\uc640 \uc801\uc808\uc131\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc775 \uad11\uace0 \u300c\uc5c4\ub9c8\uc758 \ube48\ubc29\u300d\uc774 '\ub0b4\uc6a9 \uce21\uba74'\uc5d0\uc11c \uc804\ub2ec\ud558\ub294 \uc911\uc2ec \uc8fc\uc81c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f4\uc77c\uacf1 \uc0ac\ucd98\uae30\ubd80\ud130 \uc131\uc778\uc774 \ub418\uc5b4 \ub3c5\ub9bd\ud560 \ub54c\uae4c\uc9c0 \uc18c\ud1b5\uc774 \ub2e8\uc808\ub418\uc5c8\ub358 \ub538\uc744 \ubb38 \ubc16\uc5d0\uc11c \ubcc0\ud568\uc5c6\uc774 \uae30\ub2e4\ub824\uc628 \uc5c4\ub9c8\uc758 \uae4a\uc740 \uc0ac\ub791\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\uace0 \u300c\uc5c4\ub9c8\uc758 \ube48\ubc29\u300d\uc5d0\uc11c \uc18c\ud1b5\uc758 \ub2e8\uc808\uacfc \uc5c4\ub9c8\uc758 \uae30\ub2e4\ub9bc\uc744 '\ud615\uc2dd \uce21\uba74'\uc5d0\uc11c \uc0c1\uc9d5\uc801\uc73c\ub85c \uc5f0\ucd9c\ud55c \ubc29\ubc95\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uac04 \ubc30\uacbd(\ub2eb\ud78c \ubc29\ubb38 \uc55e)\uc744 \uc77c\uc815\ud558\uac8c \uace0\uc815\ud55c \ucc44 \uc2dc\uac04\uc758 \ud750\ub984\uc5d0 \ub530\ub978 \ubaa8\ub140\uc758 \ubaa8\uc2b5 \ubcc0\ud654\ub9cc\uc744 \ud55c \ud654\uba74 \uc548\uc5d0 \ub2f4\uc544 \uc2dc\uac01\ud654\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uac00 \uadf9\ubcf5\ud55c \ub300\ud45c\uc801\uc778 4\uac00\uc9c0 \ud55c\uacc4\ub97c \uc815\ub9ac\ud558\uba74?"
