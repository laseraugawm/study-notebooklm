    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6f9\ud230 \u300c\uc815\ub144\uc774\u300d\uac00 \ubb34\ub300\ub77c\ub294 \ub2eb\ud78c \uacf5\uac04\uc758 \ud55c\uacc4\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \uc11c\uc0ac\uc5d0\uc11c \uac15\uc870\ud55c \ud2b9\uc9d5\uc740?"
