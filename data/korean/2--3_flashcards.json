    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc5d0\uc11c '\uac15\ubcc0\uc5d0 \ub098\uac00 \uc0bd\uc744 \uc53b\uc73c\uba70 / \uac70\uae30 \uc2ac\ud514\ub3c4 \ud37c\ub2e4 \ubc84\ub9b0\ub2e4'\uc758 \ud589\uc704\uac00 \ub2f4\uace0 \uc788\ub294 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
