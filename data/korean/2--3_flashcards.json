      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ub41c \ub178\ub3d9\uc73c\ub85c \uc778\ud55c \uc0dd\uacc4\uc758 \uc2dc\ub984\uacfc \uc0b6\uc758 \uc2ac\ud514\uc744 \uac15\ubb3c\uc5d0 \uc53b\uc5b4\ub0b4\uace0\uc790 \ud558\ub294 \ud589\uc704"
          }
        ]
