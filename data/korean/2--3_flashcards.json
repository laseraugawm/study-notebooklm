        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uc6c0(\uc790\uae30\ud610\uc624) $\\rightarrow$ \uac00\uc5fe\uc74c(\uc790\uae30\uc5f0\ubbfc) $\\rightarrow$ \ubbf8\uc6c0(\uc790\uae30\ud610\uc624) $\\rightarrow$ \uadf8\ub9ac\uc6c0(\uc790\uc544 \ud654\ud574)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d 2\uc5f0\uacfc 6\uc5f0\uc5d0\uc11c \uc5f0\uacb0 \uc5b4\ubbf8 '-\uace0'\uc758 \uc9c0\uc18d\uc801 \ubc18\ubcf5\uc774 \ud615\uc131\ud558\ub294 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc801 \ub098\uc5f4 \uad6c\uc808\ub4e4\uc744 \ubd80\ub4dc\ub7fd\uac8c \uc774\uc5b4 \uc8fc\uba70 \uc77c\uc815\ud55c \uc6b4\uc728\uac10\uacfc \ub9ac\ub4ec\uac10\uc744 \ud615\uc131\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc5d0\uc11c '\uc0bd\uc790\ub8e8\uc5d0 \ub9e1\uae34 \ud55c \uc0dd\uc560'\uac00 \ube44\uc720\ud558\ub294 \uc0b6\uc758 \ud615\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3c9\uc0dd\uc744 \uace0\ub2e8\ud55c \uc721\uccb4\ub178\ub3d9\uc5d0 \uc758\uc9c0\ud558\uc5ec \uc0b4\uc544\uc628 \ub178\ub3d9\uc790\uc758 \uc778\uc0dd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
