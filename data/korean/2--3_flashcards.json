    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc5d0\uc11c '\uba39\uc744 \uac83 \uc5c6\ub294 \uc0ac\ub78c\ub4e4\uc758 \ub9c8\uc744\ub85c / \ub2e4\uc2dc \uc5b4\ub450\uc6cc \ub3cc\uc544\uac00\uc57c \ud55c\ub2e4'\ub77c\ub294 \ub9c8\uc9c0\ub9c9 \uad6c\uc808\uc5d0 \ub098\ud0c0\ub09c \ud654\uc790\uc758 \uc815\uc11c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\ud560 \uc218 \uc5c6\ub294 \uc554\ub2f4\ud55c \uac00\ub09c\uc758 \ud604\uc2e4\ub85c \ub2e4\uc2dc \ubcf5\uadc0\ud574\uc57c\ub9cc \ud558\ub294 \ubb34\ub825\uac10\uacfc \uccb4\ub150"
          }
        ]
