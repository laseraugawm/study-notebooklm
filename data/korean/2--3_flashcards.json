    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c 2\uc5f0\uc758 \ub0b4\uc6a9 \uad6c\uc870\uac00 \uac70\uc758 \uadf8\ub300\ub85c \ubcc0\ud615\ub418\uc5b4 \ubc18\ubcf5\ub418\ub294 \uc5f0\uc740 \uba87 \uc5f0\uc778\uac00?"
          }
