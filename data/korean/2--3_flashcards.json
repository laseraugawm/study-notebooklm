    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc790\ud654\uc0c1\u300d\uacfc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc758 \ucc3d\uc791 \uc2dc\ub300\uc801 \ubc30\uacbd \ucc28\uc774\ub97c \ube44\uad50\ud558\uc2dc\uc624."
