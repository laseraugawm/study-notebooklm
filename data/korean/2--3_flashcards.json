    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc5d0\uc11c \ubc18\ubcf5\ud574\uc11c \ub098\ud0c0\ub098\ub294 \uad6c\uc808 '\uc6b0\ub9ac\uac00 \uc800\uc640 \uac19\uc544\uc11c'\uc5d0\uc11c '\uc800'\uac00 \uac00\ub9ac\ud0a4\ub294 \ub300\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud758\ub7ec\uac00\ub294 \uac15\ubb3c (\ub610\ub294 \uc0db\uac15 \ubc14\ub2e5\uc758 \uc369\uc740 \ubb3c)"
