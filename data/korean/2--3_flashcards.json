    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc758 2\uc5f0\uacfc 6\uc5f0 \uad6c\uc870 \ube44\uad50 \uc2dc, 6\uc5f0\uc758 \ub9c8\uc9c0\ub9c9\uc5d0 \uc0c8\ub86d\uac8c \ucd94\uac00\ub41c \uc2dc\uad6c\ub294 \ubb34\uc5c7\uc778\uac00?"
