      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc5c5\ud654 \uc2dc\ub300 \uc18c\uc678\ub41c \ub3c4\uc2dc \ub178\ub3d9\uc790(\ubbfc\uc911)\uc758 \uace0\ub2ec\ud508 \uc0b6\uacfc \ubb34\ub825\uac10, \uc2ac\ud514"
