    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc790\ud654\uc0c1\u300d 1\uc5f0\uc5d0\uc11c \ud654\uc790\uac00 \uc870\uc6a9\ud788 \uc6b0\ubb3c\uc744 \ub4e4\uc5ec\ub2e4\ubcf4\ub294 \ud589\ub3d9\uc744 \uc131\ucc30\uc801\uc73c\ub85c \ud45c\ud604\ud55c \ud575\uc2ec \uc2dc\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
