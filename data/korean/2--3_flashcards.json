{
  "title": "\ud604\ub300\uc2dc \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d \uc2dc\uac00 \ubb38\ud559\uc5d0\uc11c \uadfc\ub300\ub97c \uc9c0\ub098\uba70 \uc774\ub984\uc5d0\uc11c '\uac00(\u6b4c)'\uac00 \ub5a8\uc5b4\uc838 \ub098\uac00\uace0 '\uc2dc(\u8a69)'\uac00 \ub41c \uae4c\ub2ed\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uac00 \ubb38\ud559\uc774 \ub178\ub798\uc640\uc758 \uc5f0\uad00\uc131\uc744 \uc810\ucc28 \uc783\uace0 \uc790\uc720\uc2dc \ud615\ud0dc\ub85c \uc804\ud658\ub418\uc5c8\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1920\ub144\ub300 \ud55c\uad6d \ud604\ub300 \uc2dc\uc758 \uc8fc\ub41c \uc6b4\uc728 \ubc0f \uc815\uc11c\uc801 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\ud1b5\uc801\uc778 \ubbfc\uc694\uc870\uc758 \uc6b4\uc728\uc5d0 \uac1c\uc778\uc801\uc778 \uc815\uc11c\ub97c \uacb0\ud569\ud558\ub294 \ud750\ub984\uc774 \uac15\ud588\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1930\ub144\ub300 \ud55c\uad6d \ud604\ub300 \uc2dc \ubc1c\uc804 \uacfc\uc815\uc5d0\uc11c \uc77c\uc5b4\ub09c \uc8fc\uc694 \ubcc0\ud654\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uce35 \ub2e4\uc591\ud55c \uc2dc\uc801 \uacbd\ud5a5\ub4e4\uc774 \ub4f1\uc7a5\ud558\uba70 \ud604\ub300 \uc2dc\uac00 \ubcf8\uaca9\uc801\uc73c\ub85c \ud655\ub9bd\ub418\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\ubc29 \uc774\uc804 \uc77c\uc81c \uac15\uc810\uae30\uc5d0 \uc8fc\ub85c \ucc3d\uc791\ub41c \ud55c\uad6d \uc2dc\uc758 \ub300\ud45c\uc801 \ub450 \uac00\uc9c0 \uacbd\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbfc\uc871\uc8fc\uc758\uc801 \uc800\ud56d\uc2dc\uc640 \uc790\uae30 \uc131\ucc30\uc801\uc778 \uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\ubc29 \uc774\ud6c4 \ud55c\uad6d \ud604\ub300 \uc2dc\uc5d0\uc11c \uacf5\uc874\ud574 \uc628 \ub300\ud45c\uc801\uc778 \ub450 \uc2dc\uc801 \ud750\ub984\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc7c1\u00b7\uc0b0\uc5c5\ud654\u00b7\ubbfc\uc8fc\ud654 \ub4f1 \ud604\uc2e4 \ubb38\uc81c \ucc38\uc5ec \ubc0f \ubb38\uba85 \ube44\ud310\uc801\uc778 \uc2dc\uc640 \uc21c\uc218 \uc11c\uc815\uc758 \uc138\uacc4\ub97c \uadf8\ub9ac\ub294 \uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc778 \uc724\ub3d9\uc8fc(1917~1945)\uac00 \ud65c\ub3d9\ud558\uba70 \uc2dc\ub97c \uc4f4 \uc5ed\uc0ac\uc801 \uc2dc\ub300 \ubc30\uacbd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc81c \uac15\uc810\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub3d9\uc8fc \uc2dc\uc778\uc774 \uc791\ud488\uc744 \ud1b5\ud574 \uc8fc\ub85c \ud45c\ud604\ud558\uace0\uc790 \ud55c \uc778\ubb3c\uc0c1\uacfc \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc554\uc6b8\ud55c \ud604\uc2e4\uc744 \uc0b4\uc544\uac00\ub294 \uc9c0\uc2dd\uc778\uc758 \uace0\ub1cc, \uc21c\uc218\ud55c \uac10\uc131, \uadf8\ub9ac\uace0 \uc131\ucc30\uc801 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub3d9\uc8fc \uc2dc\uc778\uc758 \uc720\uace0 \uc2dc\uc9d1 \uc81c\ubaa9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300e\ud558\ub298\uacfc \ubc14\ub78c\uacfc \ubcc4\uacfc \uc2dc\u300f"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub3d9\uc8fc \uc2dc\uc778\uc758 \ub300\ud45c\uc801\uc778 \uc720\uace0 \uc2dc \uc791\ud488 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc11c\uc2dc\u300d, \u300c\ucc38\ud68c\ub85d\u300d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub3d9\uc8fc\uc758 \uc2dc\uc5d0\uc11c \uc9c0\uc2dd\uc778\uc73c\ub85c\uc11c \uc2dc\ub300\uc801 \ucc45\uc784\uc744 \ub2e4\ud558\uc9c0 \ubabb\ud55c\ub2e4\ub294 \ube44\uadf9\uc801 \uc778\uc2dd\uc5d0\uc11c \ube44\ub86f\ub418\ub294 \ud575\uc2ec \uc815\uc11c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\ub044\ub7ec\uc6c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub3d9\uc8fc\uc758 \uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc758 \uac08\ub798\uc801 \uc131\uaca9 \uc138 \uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc720\uc2dc, \uc11c\uc815\uc2dc, \uc131\ucc30\uc801(\uace0\ubc31\uc801) \uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub3d9\uc8fc\uc758 \uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc758 \uc911\uc2ec \uc8fc\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc544 \uc131\ucc30\uc744 \ud1b5\ud55c \uc790\uae30\ud610\uc624\uc640 \uc790\uae30\uc5f0\ubbfc\uc758 \uac08\ub4f1, \uadf8\ub9ac\uace0 \ud654\ud574"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \ud654\uc790\uac00 \ub4e4\uc5ec\ub2e4\ubcf4\uba70 \uc790\uc544 \uc131\ucc30\uc744 \uc218\ud589\ud558\ub294 \uc911\uc2ec \ub9e4\uac1c\uccb4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ubb3c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c '\uc6b0\ubb3c'\uc774 \uc218\ud589\ud558\ub294 \uc0c1\uc9d5\uc801 \uae30\ub2a5\uc740 \uc0ac\ubb3c\uc744 \ube44\ucd94\ub294 \ubb34\uc5c7\uacfc \uc720\uc0ac\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac70\uc6b8 (\uc790\uc2e0\uc758 \ubaa8\uc2b5\uc744 \ube44\ucd94\uc5b4 \ubcf4\uace0 \ub0b4\uba74\uc744 \uc131\ucc30\ud558\uac8c \ud558\ub294 \uae30\ub2a5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \uc6b0\ubb3c \uc18d\uc5d0 \ube44\uce5c '\ud55c \uc0ac\ub098\uc774'\uac00 \ucd94\ub860\uc801\uc73c\ub85c \uc0c1\uc9d5\ud558\ub294 \uc778\ubb3c\uc740 \ub204\uad6c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc790 \uc790\uc2e0 (\uc77c\uc81c \uac15\uc810\uae30 \uc554\uc6b8\ud55c \ud604\uc2e4 \uc18d\uc5d0\uc11c \ubc88\ubbfc\ud558\ub294 \ucd08\ub77c\ud558\uace0 \ubb34\ub2a5\ub825\ud55c \uc790\uc544)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d 2\uc5f0\uc5d0 \ub4f1\uc7a5\ud558\ub294 \uc6b0\ubb3c \uc18d \uc790\uc5f0 \ud48d\uacbd(\ub2ec, \uad6c\ub984, \ud558\ub298, \ud30c\uc544\ub780 \ubc14\ub78c, \uac00\uc744)\uc774 \uc9c0\ub2cc \ubd84\uc704\uae30\ub294 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1d\uace0 \uc21c\uc218\ud558\uba70 \ud3c9\ud654\ub85c\uc6b4 \uc774\uc0c1\uc801 \uc138\uacc4\uc758 \ubd84\uc704\uae30\ub97c \ud615\uc131\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c '\uc6b0\ubb3c \uc18d \uc21c\uc218\ud558\uace0 \uc544\ub984\ub2e4\uc6b4 \uc790\uc5f0 \ud48d\uacbd'\uacfc '\uc6b0\ubb3c \uc18d\uc5d0 \ube44\uce5c \uc0ac\ub098\uc774' \uc0ac\uc774\uc5d0\ub294 \uc5b4\ub5a4 \uad00\uacc4\uac00 \uc131\ub9bd\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub984\ub2e4\uc6b4 \uc790\uc5f0 \ud48d\uacbd\uacfc \ucd08\ub77c\ud55c \uc790\uc544(\uc0ac\ub098\uc774)\uac00 \uc120\uba85\ud55c \ub300\uc870\ub97c \uc774\ub8ec\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \uc678\ub534 \uc6b0\ubb3c\uc744 \ucc3e\uc544\uac00 \uc0ac\ub098\uc774\ub97c \ub9c8\uc8fc\ud55c \ud654\uc790\uac00 \ucc98\uc74c \ub290\ub080 \uc2ec\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\uc6c0 (\uc790\uae30\ud610\uc624)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \uc6b0\ubb3c \uc55e\uc744 \ub5a0\ub098 \ub3cc\uc544\uac00\ub2e4 \uc0dd\uac01\ud588\uc744 \ub54c \ud654\uc790\uac00 \ub290\ub07c\ub294 \uc2ec\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc5fe\uc74c (\uc790\uae30\uc5f0\ubbfc)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \ub3c4\ub85c \uc6b0\ubb3c\uc5d0 \uac00\uc11c \ub4e4\uc5ec\ub2e4\ubcf8 \ud6c4 \ub2e4\uc2dc \ub5a0\ub098\uba70 \ud654\uc790\uac00 \ucd5c\uc885\uc801\uc73c\ub85c \uc0ac\ub098\uc774\uc5d0 \ub300\ud574 \uac16\uac8c \ub418\ub294 \uc2ec\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadf8\ub9ac\uc6c0 (\uacfc\uac70 \uc21c\uc218\ud588\ub358 \uc790\uc544\uc5d0 \ub300\ud55c \uadf8\ub9ac\uc6c0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc758 6\uc5f0 \uad6c\uc808 '\ucd94\uc5b5\ucc98\ub7fc \uc0ac\ub098\uc774\uac00 \uc788\uc2b5\ub2c8\ub2e4'\uac00 \ub0b4\ud3ec\ud558\ub294 \uc790\uc544\uc758 \uc0c1\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uae30\ud610\uc624\uc640 \uc790\uae30\uc5f0\ubbfc\uc758 \ub0b4\uc801 \uac08\ub4f1\uc744 \uadf9\ubcf5\ud558\uace0 \uc21c\uc218\ud588\ub358 \uacfc\uac70 \uc790\uc544\ub97c \ud68c\ubcf5\ud558\uc5ec \uc790\uc544\uc640 \ud654\ud574\ub97c \uc774\ub8ec \uc0c1\ud0dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \ud654\uc790\uc758 \uc815\uc11c\uc640 \ud0dc\ub3c4\uac00 '\ubbf8\uc6c0 $\\rightarrow$ \uac00\uc5fe\uc74c $\\rightarrow$ \ubbf8\uc6c0 $\\rightarrow$ \uadf8\ub9ac\uc6c0'\uc73c\ub85c \ubcc0\ud654\ud558\ub294 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc81c \uac15\uc810\uae30 \uc554\ub2f4\ud55c \ud604\uc2e4 \uc18d \uc9c0\uc2dd\uc778\uc73c\ub85c\uc11c \uacaa\ub294 \uc790\uae30\ud610\uc624\uc640 \uc790\uae30\uc5f0\ubbfc \uc0ac\uc774\uc758 \uce58\uc5f4\ud55c \ub0b4\uc801 \uac08\ub4f1 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc758 \ud45c\ud604 '\ud30c\uc544\ub780 \ubc14\ub78c'\uc5d0 \uc4f0\uc778 \uac10\uac01\uc801 \uc2ec\uc0c1 \uae30\ubc95\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uac10\uac01\uc801 \uc2ec\uc0c1 (\ubc14\ub78c\uc758 \ucd09\uac01/\uccad\uac01\uc801 \ub290\ub08c\uc744 \uc0c9\ucc44\ub85c \ud45c\ud604\ud55c \uccad\uac01\uc758 \uc2dc\uac01\ud654)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \ubb38\ubc95 \uc5b4\ubc95\uc5d0 \ub9de\uc9c0 \uc54a\uc9c0\ub9cc \uc0ac\uc6a9\ub41c '\ud30c\uc544\ub780 \ubc14\ub78c'\uc774\ub77c\ub294 \uc2dc\uad6c\uac00 \uc8fc\ub294 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ubb3c \uc18d\uc5d0 \ube44\uce5c \ud48d\uacbd\uc758 \ub3d9\ud654\uc801\uc774\uace0 \uc21c\uc218\ud55c \ubd84\uc704\uae30\ub97c \ud55c\uce35 \ub354 \uc2dc\uac01\uc801\uc73c\ub85c \uc544\ub984\ub2f5\uac8c \ubd80\uac01\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \ubc18\ubcf5\ub418\uba70 \ubb38\uc7a5 \uc885\uacb0\uc744 \uc774\ub8e8\uace0 \uc0b0\ubb38\uc801 \uc6b4\uc728\uc744 \ud615\uc131\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc885\uacb0 \uc5b4\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'-\ubd05\ub2c8\ub2e4', '-\uc2b5\ub2c8\ub2e4'"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \uacbd\uc5b4\uccb4 \uc885\uacb0 \uc5b4\ubbf8('-\ubd05\ub2c8\ub2e4', '-\uc2b5\ub2c8\ub2e4')\uc758 \ubc18\ubcf5\uc774 \ud615\uc131\ud558\ub294 \ud654\uc790\uc758 \uc5b4\uc870\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ubc31\uc801\uc774\uace0 \ucc28\ubd84\ud558\uba70 \uc131\ucc30\uc801\uc778 \uc5b4\uc870"
