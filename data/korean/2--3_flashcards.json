    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc790\ud654\uc0c1\u300d\uacfc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc758 \ud654\uc790\uac00 \ub300\ubcc0\ud558\ub294 \uc2e0\ubd84\uc758 \ucc28\uc774\ub97c \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc790\ud654\uc0c1\u300d\uc758 \ud654\uc790\ub294 \uace0\ub1cc\ud558\ub294 \uc9c0\uc2dd\uc778 \uc790\uc544\uc774\uba70, \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc758 \ud654\uc790\ub294 \uace0\ub41c \ub178\ub3d9\uc744 \uc218\ud589\ud558\ub294 \ub178\ub3d9\uc790(\ubbfc\uc911) \uc790\uc544\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc790\ud654\uc0c1\u300d\uacfc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc5d0\uc11c \uc790\uc544 \uc131\ucc30\uc758 \ub9e4\uac1c\uccb4\ub85c \ub4f1\uc7a5\ud558\ub294 \uc790\uc5f0\ubb3c/\uacf5\uac04\uc744 \uac01\uac01 \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc790\ud654\uc0c1\u300d: \uc6b0\ubb3c / \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d: \uac15(\uac15\ubb3c)"
