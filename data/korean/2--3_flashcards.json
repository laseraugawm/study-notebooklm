      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ub3d9\uc790\uc758 \uc0dd\uacc4 \uc720\uc9c0 \uc218\ub2e8\uc774\uc790 \uace0\ub2e8\ud55c \ub178\ub3d9\uc790\uc758 \uc0b6"
