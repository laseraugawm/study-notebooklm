      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\ub09c\ud558\uace0 \uace0\ub2e8\ud55c \ub178\ub3d9\uc758 \ud604\uc2e4\uc744 \ud53c\ud560 \uc218 \uc5c6\uc74c\uc744 \uc778\uc815\ud558\uace0 \ub2f4\ub2f4\ud558\uac8c \uccb4\ub150\ud558\uba70 \uc218\uc6a9\ud55c\ub2e4."
