    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc5d0\uc11c '\uc6b0\ub9ac\uac00 \uc800\uc640 \uac19\uc544\uc11c'\ub97c \ubc14\ud0d5\uc73c\ub85c \uc54c \uc218 \uc788\ub294 \ud654\uc790\uc758 \uc790\uc544 \uc778\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc2ec\ud558\uac8c \ud750\ub974\ub294 \uac15\ubb3c\ucc98\ub7fc \uace0\ub2e8\ud558\uace0 \uac00\ub09c\ud55c \ub178\ub3d9\uc790\uc758 \uc0b6\uc744 \ubb35\ubb35\ud788 \ubc1b\uc544\ub4e4\uc774\uace0 \uacac\ub514\ub294 \uc790\uc544 \uc778\uc2dd"
          }
