      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ucd94\uc5b5\ucc98\ub7fc \uc0ac\ub098\uc774\uac00 \uc788\uc2b5\ub2c8\ub2e4'"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ud76c\uc131\uc758 \uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uac00 \ubc1c\ud45c\ub41c \uc5f0\ub3c4\uc640 \uadf8 \uc2dc\ub300\uc758 \uc0ac\ud68c\uc801 \ubc30\uacbd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1978\ub144 (\uadfc\ub300\ud654, \uc0b0\uc5c5\ud654, \ub3c4\uc2dc\ud654\uac00 \uae09\uc18d\ud788 \ucd94\uc9c4\ub418\ub358 1970\ub144\ub300)"
