    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc5d0\uc11c \ud604\uc2e4 \uc778\uc2dd\uacfc \uc0b6\uc5d0 \ub300\ud55c \ucd5c\uc885 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
