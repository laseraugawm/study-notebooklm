    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \uc790\uc544 \uac08\ub4f1\uc774 \ucd5c\uc885\uc801\uc73c\ub85c \ub3c4\ub2ec\ud558\ub294 \uadc0\uacb0\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70 \uc21c\uc218\ud588\ub358 \uc790\uc544\uc5d0 \ub300\ud55c \uadf8\ub9ac\uc6c0\uc744 \ud68c\ubcf5\ud558\uba70 \uc790\uc544\uc640\uc758 \ud654\ud574\uc5d0 \ub3c4\ub2ec\ud55c\ub2e4."
