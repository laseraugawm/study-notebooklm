    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc5d0\uc11c \ud575\uc2ec \uc18c\uc7ac\uc778 '\uc0bd'\uc774 \uc0c1\uc9d5\ud558\ub294 \ubc14\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
