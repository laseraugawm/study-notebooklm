    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc758 \uc804\ubc18\uc801\uc778 \uc5b4\uc870\uc758 \ud2b9\uc9d5\uc740 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbfc\uc911\uc758 \uc544\ud514\uc744 \uaca9\uc815\uc801\uc73c\ub85c \ud1a0\ub85c\ud558\uc9c0 \uc54a\uace0, \ucc28\ubd84\ud558\uace0 \uc815\uc81c\ub41c \uc5b4\uc870\ub85c \ub178\ub798\ud55c\ub2e4."
          }
        ]
