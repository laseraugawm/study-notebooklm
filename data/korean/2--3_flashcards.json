      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u300c\uc790\ud654\uc0c1\u300d\uc740 \uc77c\uc81c \uac15\uc810\uae30\uc774\uba70, \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\ub294 1970\ub144\ub300 \uc0b0\uc5c5\ud654\u00b7\ub3c4\uc2dc\ud654 \uc2dc\uae30\uc774\ub2e4."
          }
        ]
