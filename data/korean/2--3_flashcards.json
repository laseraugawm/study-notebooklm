    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \ud654\uc790\uac00 \ub290\ub07c\ub294 \uc815\uc11c \ubcc0\ud654 \uc21c\uc11c\ub97c 4\uac1c\uc758 \ub2e8\uacc4\ub85c \uc4f0\uc2dc\uc624."
