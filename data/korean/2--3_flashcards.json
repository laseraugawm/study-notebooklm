    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc758 \ud654\uc790\uac00 \ub300\ubcc0\ud558\ub294 \uc778\ubb3c\uc0c1\uacfc \uacc4\uce35\uc740 \ub204\uad6c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud558\ub8e8\uc758 \uace0\ub41c \ub178\ub3d9\uc744 \ub9c8\uce5c \ub3c4\uc2dc \ub178\ub3d9\uc790 (\uc911\ub144 \uc0ac\ub0b4 / \uc18c\uc678\ub41c \ubbfc\uc911)"
