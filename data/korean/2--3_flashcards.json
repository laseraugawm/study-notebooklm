    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub3d9\uc8fc\uc758 \u300c\uc790\ud654\uc0c1\u300d\uacfc \uc815\ud76c\uc131\uc758 \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uac00 \uac16\ub294 \uacf5\ud1b5\uc801\uc778 \uc2dc\uc801 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc774 \ucc98\ud55c \uc2dc\ub300\uc801 \uc0c1\ud669\uc744 \ubc14\ud0d5\uc73c\ub85c \uc790\uc2e0\uc758 \uc0b6\uacfc \uc790\uc544\ub97c \uae4a\uc774 \uc131\ucc30\ud55c\ub2e4."
