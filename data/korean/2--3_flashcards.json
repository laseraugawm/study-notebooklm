    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc758 \uc2dc\uc801 \uacf5\uac04 \ubc0f \uc2dc\uac04 \ubc30\uacbd\uc740 \uc5b4\ub514\uc778\uac00?"
