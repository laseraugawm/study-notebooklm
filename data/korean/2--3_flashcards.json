    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc5d0\uc11c '\uc0db\uac15 \ubc14\ub2e5 \uc369\uc740 \ubb3c'\uc774 \uc0c1\uc9d5\ud558\ub294 \ud604\uc2e4\uc801 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc5c5\ud654 \uacfc\uc815\uc5d0\uc11c \uc624\uc5fc\ub418\uace0 \ud669\ud3d0\ud574\uc9c4 \ubbfc\uc911\ub4e4\uc758 \uc554\ub2f4\ud558\uace0 \uac00\ub09c\ud55c \uc0b6\uc758 \ud130\uc804"
          }
        ]
