    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc \u300c\uc800\ubb38 \uac15\uc5d0 \uc0bd\uc744 \uc53b\uace0\u300d\uc758 \ud575\uc2ec \uc8fc\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
