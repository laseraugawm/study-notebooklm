{
  "title": "\uad6d\uc5b4 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uad50\uacfc\uc11c\uc5d0\uc11c \ub2e4\ub8e8\ub294 '\uc8fc\uc81c \ud1b5\ud569\uc801 \uc77d\uae30'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub3d9\uc77c\ud55c \ud654\uc81c\ub098 \uc8fc\uc81c\ub97c \ub2e4\ub8ec \ub2e4\uc591\ud55c \uad00\uc810\uacfc \ud615\uc2dd\uc758 \uae00\uc774\ub098 \uc790\ub8cc\ub97c \uc77d\ub294 \ub3c5\uc11c \ubc29\ubc95\uc774\ub2e4.",
          "rationale": "\uc8fc\uc81c \ud1b5\ud569\uc801 \uc77d\uae30\ub294 \ub3d9\uc77c\ud55c \ud654\uc81c\uc5d0 \ub300\ud55c \ub2e4\uc591\ud55c \uad00\uc810\uacfc \ud615\uc2dd\uc758 \uc790\ub8cc\ub97c \uc885\ud569\uc801\uc73c\ub85c \uc77d\ub294 \uac1c\ub150\uc5d0 \ubd80\ud569\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc5ec\ub7ec \uae00\uc744 \uc77d\uc740 \ud6c4 \uc77d\uae30 \ubaa9\uc801\uc5d0 \ub530\ub77c \ub0b4\uc6a9\uc744 \uc7ac\uad6c\uc131\ud558\uc5ec \uc790\uc2e0\uc758 \uacac\ud574\ub97c \uc138\uc6b0\ub294 \uac83\uc774 \uc911\uc694\ud558\ub2e4.",
          "rationale": "\uc77d\uae30 \ubaa9\uc801\uc744 \uace0\ub824\ud558\uc5ec \ube44\ud310\uc801\uc73c\ub85c \uc77d\uace0 \uc790\uc2e0\uc758 \uad00\uc810\uc744 \uc7ac\uad6c\uc131\ud558\ub294 \uac83\uc774 \uc8fc\uc81c \ud1b5\ud569\uc801 \uc77d\uae30\uc758 \uc8fc\uc694 \ubaa9\ud45c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc8fc\uc81c\uc640 \uad00\ub828\ub41c \ub2e8 \ud558\ub098\uc758 \uc815\ub9bd\ub41c \uad00\uc810\ub9cc\uc744 \uc120\ud0dd\ud558\uc5ec \uac1d\uad00\uc801 \uc9c4\uc2e4\uc744 \ub3c4\ucd9c\ud558\ub294 \ub370 \uc8fc\uc548\uc810\uc744 \ub454\ub2e4.",
          "rationale": "\uc8fc\uc81c \ud1b5\ud569\uc801 \uc77d\uae30\ub294 \ub2e8 \ud558\ub098\uc758 \uad00\uc810\uc5d0 \uc9d1\ucc29\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ub2e4\uc591\ud55c \uad00\uc810\uc744 \uade0\ud615 \uc788\uac8c \uc774\ud574\ud558\uace0 \uc0c8\ub85c\uc6b4 \ucc3d\uc758\uc801 \uc0ac\uace0\ub97c \uc0dd\uc131\ud558\ub294 \uc77d\uae30 \ubc29\uc2dd\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc8fc\uc81c\ub97c \uade0\ud615 \uc788\uac8c \uc774\ud574\ud558\uace0 \ucc3d\uc758\uc801\uc778 \uc0ac\uace0\ub97c \uc0dd\uc131\ud558\ub294 \ub370 \uae30\uc5ec\ud55c\ub2e4.",
          "rationale": "\ub2e4\uc591\ud55c \uc790\ub8cc\ub97c \ube44\uad50\u00b7\ub300\uc870\ud558\uc5ec \uc885\ud569\ud568\uc73c\ub85c\uc368 \uc8fc\uc81c\uc5d0 \ub300\ud55c \uade0\ud615 \uc7a1\ud78c \uc774\ud574\uc640 \ucc3d\uc758\uc801 \uc0ac\uace0 \uc0dd\uc131\uc774 \uac00\ub2a5\ud574\uc9d1\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc8fc\uc81c \ud1b5\ud569\uc801 \uc77d\uae30\ub294 \ub2e8 \ud558\ub098\uc758 \uad00\uc810\ub9cc\uc744 \ucde8\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c, \ub2e4\uc591\ud55c \uc790\ub8cc\ub97c \ube44\uad50\ud558\uba70 \uade0\ud615 \uc788\uac8c \uc774\ud574\ud558\ub294 \ubc29\ubc95\uc784\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uae00 (\uac00)\uc5d0\uc11c \ucd5c\uc7ac\ucc9c \ud559\uc790\uac00 \uc81c\uc2dc\ud55c '\uc9c0\ub2a5'\uacfc '\uc9c0\uc131'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\ub2a5\uc740 \uc790\uc2e0\uc758 \ud589\ub3d9\uc744 \ud22c\uc601\ud558\uace0 \ubc18\uc131\ud558\ub294 \ub2a5\ub825\uc774\uba70, \uc9c0\uc131\uc740 \ub2e8\uc21c \ubd84\uc11d \ub2a5\ub825\uc774\ub2e4.",
          "rationale": "\ubcf8\ubb38\uc5d0\uc11c \ubd84\uc11d\ud558\uace0 \ud574\uacb0\ucc45\uc744 \ucc3e\ub294 \uc778\uc9c0 \ub2a5\ub825\uc740 '\uc9c0\ub2a5'\uc774\uba70, \uc0c1\ud669\uc5d0 \uc790\uc2e0\uc744 \ud22c\uc601\ud558\uace0 \ubc18\uc131\ud558\ub294 \uac83\uc740 '\uc9c0\uc131'\uc73c\ub85c \uc815\uc758\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0dd\uc131\ud615 \uc778\uacf5\uc9c0\ub2a5\uc740 \uc778\ud130\ub137 \ub370\uc774\ud130\ub97c \ud65c\uc6a9\ud558\uc5ec \uc778\uac04\uc758 \uc9c0\uc131\uc744 \uc644\uc804\ud788 \uad6c\ud604\ud55c \uc874\uc7ac\uc774\ub2e4.",
          "rationale": "\uc0dd\uc131\ud615 \uc778\uacf5\uc9c0\ub2a5\uc740 \uc9d1\ub2e8 \uc9c0\ub2a5\uc744 \ud749\ub0b4 \ub0b4\ub294 \uc218\uc900\uc77c \ubfd0, \uc778\uac04\uc758 \uc9c0\uc131\uc774\ub098 \uac10\uc815\uc744 \uc644\uc804\ud788 \uc9c0\ub2cc \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc9c0\uc131\uc740 \uc5b4\ub5a4 \uc0c1\ud669\uc5d0 \uc790\uc2e0\uc744 \ud22c\uc601\ud574 \ubcf4\uace0 \ubc18\uc131\ud574 \ubcf4\ub294 \ub2a5\ub825\uae4c\uc9c0 \ud3ec\ud568\ud55c\ub2e4.",
          "rationale": "\uae00 (\uac00)\uc5d0\uc11c \uae00\uc4f4\uc774\ub294 \uc9c0\ub2a5(\uc778\uc9c0 \ub2a5\ub825)\uacfc \uad6c\ubd84\ub418\ub294 \uc9c0\uc131\uc758 \ud575\uc2ec\uc73c\ub85c \uc790\uc2e0\uc744 \ud22c\uc601\ud558\uace0 \ubc18\uc131\ud558\ub294 \ub2a5\ub825\uc744 \uaf3d\uc558\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc2a4\ud2f0\ube10 \ud551\ucee4 \uad50\uc218\ub294 \uc778\uacf5\uc9c0\ub2a5\uc774 \uc778\uac04\uc758 \uc9c0\uc131\uc744 \ub6f0\uc5b4\ub118\uc5b4 \uc704\ud611\uc774 \ub420 \uac83\uc774\ub77c\uace0 \uacbd\uace0\ud588\ub2e4.",
          "rationale": "\uc2a4\ud2f0\ube10 \ud551\ucee4 \uad50\uc218\ub294 \uc778\uacf5\uc9c0\ub2a5\uc774 \uc2dc\ud0a4\ub294 \uc77c\uc744 \ud560 \ubfd0 \uc9c0\ub2a5\uc774 \uc544\ub2c8\ubbc0\ub85c \ub450\ub824\uc6cc\ud560 \ud544\uc694\uac00 \uc5c6\ub2e4\uace0 \uc77c\ucd95\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uae00 (\uac00)\uc5d0\uc11c '\uc9c0\uc131'\uc774\ub780 \ub2e8\uc21c \ubd84\uc11d \ub2a5\ub825\uc744 \ub118\uc5b4 \uc790\uc2e0\uc744 \ub418\ub3cc\uc544\ubcf4\ub294 \ubc18\uc751\uacfc \uad00\ub828\uc774 \uc788\uc74c\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uae00 (\ub098)\uc5d0 \uc81c\uc2dc\ub41c \uc0dd\ubb3c\ud559\uc801 \uc2e0\uacbd\uacc4\uc758 \uad6c\uc870\uc640 \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uad6c\uc131 \uc694\uc18c\ub97c \ub9e4\uce6d\ud55c \uac83\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2e0\uacbd \uc138\ud3ec\uc758 \uac00\uc9c0 \ub3cc\uae30 - \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uc785\ub825\uce35",
          "rationale": "\uac00\uc9c0 \ub3cc\uae30\ub294 \uc2e0\ud638\uac00 \uc785\ub825\ub418\ub294 \ubd80\ubd84\uc73c\ub85c \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uc785\ub825\uce35\uc5d0 \ub300\uc751\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2e0\uacbd \uc138\ud3ec \uc0ac\uc774\uc758 \uc2dc\ub0c5\uc2a4 - \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \ud654\uc0b4\ud45c(\uc804\ub2ec \ud1b5\ub85c)",
          "rationale": "\ub450 \uc2e0\uacbd \uc138\ud3ec\ub97c \uc5f0\uacb0\ud558\ub294 \uc2dc\ub0c5\uc2a4\ub294 \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc5d0\uc11c \uc2e0\ud638\uac00 \uc774\ub3d9\ud558\ub294 \ud654\uc0b4\ud45c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2dc\ub0c5\uc2a4\uc758 \uacb0\ud569 \uac15\ub3c4 - \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uac00\uc911\uce58",
          "rationale": "\uc2dc\ub0c5\uc2a4\uc758 \uc5f0\uacb0/\uacb0\ud569 \uac15\ub3c4\ub294 \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc5d0\uc11c \ud654\uc0b4\ud45c\uc5d0 \ubd80\uc5ec\ub418\ub294 \uac00\uc911\uce58\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2dc\ub0c5\uc2a4\uc5d0\uc11c \ubd84\ube44\ub418\ub294 \ud654\ud559 \ubb3c\uc9c8(\uc544\uc138\ud2f8\ucf5c\ub9b0) - \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uc784\uacd7\uac12",
          "rationale": "\uc544\uc138\ud2f8\ucf5c\ub9b0\uc740 \uc804\uae30 \uc2e0\ud638\ub97c \uc804\ub2ec\ud558\ub294 \ud654\ud559 \ubb3c\uc9c8\uc774\uba70, \uc784\uacd7\uac12\uc740 \uc2e0\ud638\ub97c \ucd9c\ub825\ud560\uc9c0 \uacb0\uc815\ud558\ub294 \ubd84\uac04 \uae30\uc900\uac12\uc73c\ub85c \ub458\uc740 \uc77c\uce58\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\uc784\uacd7\uac12\uc740 \uc2e0\ud638 \uc804\ub2ec \uc5ec\ubd80\ub97c \uacb0\uc815\ud558\ub294 \uae30\uc900 \ud55c\uacc4\uac12\uc774\uba70, \ud654\ud559 \ubb3c\uc9c8\uc740 \uc804\ub2ec \ud1b5\ub85c\uc5d0\uc11c \ubd84\ube44\ub418\ub294 \uc2e0\ud638 \ub9e4\uac1c\uccb4\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uae00 (\ub098)\uc5d0\uc11c \uc124\uba85\ud558\ub294 \uc2e0\uacbd\uacc4\uc640 \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 '\ud559\uc2b5' \uc6d0\ub9ac\uc5d0 \ub300\ud55c \uc774\ud574\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc8fc \uc0ac\uc6a9\ud558\ub294 \uc2dc\ub0c5\uc2a4 \uc5f0\uacb0\uc774 \uac15\ud654\ub418\uace0 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \uc5f0\uacb0\uc774 \uc57d\ud654\ub418\ub294 \ud604\uc0c1\uc744 '\uc2e0\uacbd \uac00\uc18c\uc131'\uc774\ub77c\uace0 \ud55c\ub2e4.",
          "rationale": "\uc870\uac74\uc5d0 \ub530\ub77c \uc2dc\ub0c5\uc2a4 \uc5f0\uacb0 \uac15\ub3c4\uac00 \ubcc0\ud558\ub294 '\uc2e0\uacbd \uac00\uc18c\uc131'\uc740 \ud559\uc2b5\uacfc \uae30\uc5b5\uc758 \ud575\uc2ec \uc6d0\ub9ac\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc778\uacf5 \uc2e0\uacbd\ub9dd\uc740 \ubc18\ubcf5\uc801\uc778 \uacfc\uc815\uc744 \ud1b5\ud574 \uc6d0\ud558\ub294 \uac12\uc774 \ucd9c\ub825\ub418\ub3c4\ub85d \uac00\uc911\uce58\ub97c \uc870\uc808\ud558\uba70 \ud559\uc2b5\ud55c\ub2e4.",
          "rationale": "\uc785\ub825 \ud6c4 \uc6d0\ud558\ub294 \ucd9c\ub825\uc774 \ub098\uc624\ub3c4\ub85d \ud654\uc0b4\ud45c\uc758 \uac00\uc911\uce58\ub97c \ubc18\ubcf5\ud574\uc11c \uc870\uc808\ud558\ub294 \uacfc\uc815\uc774 \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \ud559\uc2b5\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2e0\uacbd \uc138\ud3ec\uc758 \ubab8\ud1b5\uc5d0 \ubaa8\uc778 \uc785\ub825\uac12\uc758 \ud569\uc774 \uc784\uacd7\uac12\uc744 \ub118\uc9c0 \uc54a\ub354\ub77c\ub3c4 \ud56d\uc0c1 \ucd9c\ub825 \uc2e0\ud638\uac00 \ub0b4\ubcf4\ub0b4\uc9c4\ub2e4.",
          "rationale": "\uc2e0\uacbd \uc138\ud3ec\ub294 \uc785\ub825\ub41c \uac12\uc758 \ud569\uc774 \uc784\uacd7\uac12\uc744 \ub118\uc744 \ub54c\ub9cc \ucd95\uc0ad \ub3cc\uae30\ub97c \ud1b5\ud574 \uc2e0\ud638\ub97c \ucd9c\ub825\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc790\uc804\uac70 \ud0c0\uae30\ub97c \ubc18\ubcf5\ud558\uc5ec \uad00\ub828 \uc2e0\uacbd\uacc4\uc758 \uc5f0\uacb0 \uac15\ub3c4\uac00 \uac15\ud654\ub418\ub294 \uac83\uc740 \ud559\uc2b5\uc758 \ub300\ud45c\uc801 \uc608\uc2dc\uc774\ub2e4.",
          "rationale": "\ubc18\ubcf5 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uc2dc\ub0c5\uc2a4 \uc5f0\uacb0\uc774 \uac15\ud654\ub418\uc5b4 \uc790\ub3d9\uc73c\ub85c \uadfc\uc721\uc774 \uc6c0\uc9c1\uc774\ub294 \uac83\uc774 \ud559\uc2b5 \uacfc\uc815\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc2e0\uacbd \uc138\ud3ec\uac00 \uc2e0\ud638\ub97c \ucd95\uc0ad \ub3cc\uae30(\uc904\uae30)\ub85c \ub0b4\ubcf4\ub0b4\uae30 \uc704\ud574 \ud544\uc694\ud55c \uc785\ub825\uac12 \uc870\uac74(\uc784\uacd7\uac12)\uc744 \ud655\uc778\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uae00 (\ub2e4)\uc5d0\uc11c \uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc758 \ub3c4\ub355\uc801 \uc9c0\uc704\uc5d0 \uad00\ud55c \uc785\uc7a5(\u3131~\u3139)\uc744 \ubd84\uc11d\ud55c \ub0b4\uc6a9\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\u3131\uacfc \u3134\uc740 \uc9c0\ub2a5, \uc758\uc2dd, \uace0\ud1b5 \uac10\uc218\uc131\uacfc \uac19\uc740 \uc0ac\uc2e4\uc801 \uc18d\uc131\uc758 \uc720\ubb34\uc5d0 \ub530\ub77c \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \uacb0\uc815\ud574\uc57c \ud55c\ub2e4\uace0 \ubcf8\ub2e4.",
          "rationale": "\u3131\uacfc \u3134\uc740 \ub85c\ubd07\uc774 \uc758\uc2dd\uc774\ub098 \uace0\ud1b5 \uac10\uc218\uc131 \ub4f1\uc758 \uac1d\uad00\uc801 \uc18d\uc131\uc744 \uc9c0\ub154\ub294\uc9c0 \uc5ec\ubd80\ub97c \uae30\uc900\uc73c\ub85c \uc0bc\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\u3137\uc740 \ub85c\ubd07\uc774 \uace0\ud1b5\uc744 \ub290\ub084 \uc218 \uc788\ub354\ub77c\ub3c4 \uc778\uac04\uc758 \ud544\uc694\ub85c \ub9cc\ub4e4\uc5b4\uc9c4 \ub3c4\uad6c\uc774\ubbc0\ub85c \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ubd80\uc5ec\ud574\uc11c\ub294 \uc548 \ub41c\ub2e4\uace0 \ubcf8\ub2e4.",
          "rationale": "\u3137\uc740 \ub85c\ubd07\uc758 \uc18d\uc131\uacfc \ubb34\uad00\ud558\uac8c \uc778\uac04\uc774 \uc81c\uc791\ud55c \ub3c4\uad6c\ub77c\ub294 \uc774\uc720\ub85c \ub3c4\ub355\uc801 \uc9c0\uc704 \ubd80\uc5ec\ub97c \ubc18\ub300\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\u3139\uc740 \ub85c\ubd07\uc774 \uc758\uc2dd\uc774\ub098 \uace0\ud1b5 \uac10\uc218\uc131\uc744 \uac16\uc9c0 \uc54a\uc544\ub3c4 \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ubd80\uc5ec\ud560 \uc218 \uc788\ub2e4\uace0 \ubcf8\ub2e4.",
          "rationale": "\u3139\uc740 \uc0ac\uc2e4\uc801 \uc18d\uc131\uc774 \uc5c6\ub354\ub77c\ub3c4 \uc778\uac04\uacfc\uc758 \uac10\uc815\uc801 \uad50\uac10 \ubc0f \uad00\uacc4 \ud615\uc131\uc5d0 \ub530\ub77c \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ubd80\uc5ec\ud560 \uc218 \uc788\ub2e4\uace0 \ubd05\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uae00\uc4f4\uc774\ub294 \u3137\uc758 \uc785\uc7a5\uc774 \uc6b0\ub9ac\uac00 \ub3d9\ubb3c\uc774\ub098 \ub2e4\ub978 \uc0ac\ub78c\uc744 \ub300\uc6b0\ud574 \uc628 \uae30\uc874\uc758 \uac00\uce58\uad00\uacfc \uac00\uc7a5 \uc798 \ubd80\ud569\ud55c\ub2e4\uace0 \ud3c9\uac00\ud55c\ub2e4.",
          "rationale": "\uae00\uc4f4\uc774\ub294 \u3137\uc758 \uc785\uc7a5\uc774 \uace0\ud1b5\uc744 \ub290\ub07c\ub294 \uc874\uc7ac\ub97c \ub3c4\uad6c\ub85c \ucde8\uae09\ud558\ub294 \uacfc\uaca9\ud55c \uc8fc\uc7a5\uc774\uba70, \uae30\uc874 \uac00\uce58\uad00\uacfc \ucda9\ub3cc\ud55c\ub2e4\uace0 \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\uae00\uc4f4\uc774\ub294 \u3137(\uace0\ud1b5\uc744 \ub290\uaef4\ub3c4 \ub3c4\uad6c\uc774\ubbc0\ub85c \ud559\ub300 \uac00\ub2a5)\uc758 \uc785\uc7a5\uc774 \uae30\uc874 \uac00\uce58\uad00\uacfc \uc5b4\ub5bb\uac8c \uad00\uacc4\ub97c \ub9fa\ub294\ub2e4\uace0 \ud3c9\uac00\ud588\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uae00 (\ub2e4)\uc5d0 \ub4f1\uc7a5\ud558\ub294 \ucca0\ud559\uc790 \ub9c8\ud06c \ucfe0\ud5ec\ubc84\uadf8\uc758 '\uad00\uacc4\ub860\uc801 \uc811\uadfc'\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub3c4\ub355\uc801 \uc9c0\uc704\ub294 \ub300\uc0c1\uc774 \uac00\uc9c4 \uac1d\uad00\uc801 \uc0dd\ubb3c\ud559\uc801/\uae30\uc220\uc801 \uc18d\uc131\uc5d0 \uc758\ud574 \ubb3c\ub9ac\uc801\uc73c\ub85c \uacb0\uc815\ub41c\ub2e4.",
          "rationale": "\uad00\uacc4\ub860\uc801 \uc811\uadfc\uc740 \uac1d\uad00\uc801 \uc18d\uc131 \uc720\ubb34\ubcf4\ub2e4\ub294 \uc778\uac04\uacfc \ub9fa\ub294 \uad00\uacc4\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub85c\ubd07\uc774 \uc2e4\uc81c\ub85c \uac10\uc815\uc744 \uc9c0\ub154\ub294\uc9c0 \uc5ec\ubd80\ubcf4\ub2e4 \uc6b0\ub9ac\uac00 \uc77c\uc0c1 \uacbd\ud5d8 \uc18d\uc5d0\uc11c \ub85c\ubd07\uacfc \uc5b4\ub5bb\uac8c \uc0c1\ud638 \uc791\uc6a9\ud558\uace0 \uad00\uacc4 \ub9fa\ub294\uc9c0\uac00 \uc911\uc694\ud558\ub2e4.",
          "rationale": "\uad00\uacc4\ub860\uc801 \uc811\uadfc\uc740 \ub85c\ubd07\uc758 \uc2e4\uc81c \uac10\uc815 \uc720\ubb34\ubcf4\ub2e4 \uc778\uac04\uacfc\uc758 \uc0c1\ud638 \uc791\uc6a9 \ubc0f \uacbd\ud5d8\uc801 \uad00\uacc4 \ubc29\uc2dd\uc744 \ud575\uc2ec \uae30\uc900\uc73c\ub85c \uc0bc\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc18c\uc15c \ub85c\ubd07\uc740 \uc778\uac04\uc5d0\uac8c \ud574\ub97c \ub07c\uce60 \uc218 \uc788\uc73c\ubbc0\ub85c \uc5c4\uaca9\ud558\uac8c \ud1b5\uc81c\ud574\uc57c \ud55c\ub2e4\ub294 \uae30\uc220 \uacb0\uc815\ub860\uc801 \uc785\uc7a5\uc774\ub2e4.",
          "rationale": "\uad00\uacc4\ub860\uc801 \uc811\uadfc\uc740 \uc18c\uc15c \ub85c\ubd07\uc758 \ud1b5\uc81c\ub098 \uae30\uc220 \uc704\ud611\ubcf4\ub2e4\ub294 \uad50\uac10\uacfc \uac00\uce58 \ubd80\uc5ec\ub97c \ub17c\ud558\ub294 \ucca0\ud559\uc801 \uc785\uc7a5\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc740 \uc778\uac04\uc774 \ub9cc\ub4e0 \ub3c4\uad6c\uc5d0 \ubd88\uacfc\ud558\ubbc0\ub85c \uc5b4\ub5a0\ud55c \uc815\uc11c\uc801 \ud0dc\ub3c4\ub3c4 \uac00\uc838\uc11c\ub294 \uc548 \ub41c\ub2e4\uace0 \uac15\uc870\ud55c\ub2e4.",
          "rationale": "\uc774\ub294 \u3137\uc758 \ub3c4\uad6c\uc8fc\uc758\uc801 \uc785\uc7a5\uc5d0 \uac00\uae5d\uace0, \uad00\uacc4\ub860\uc801 \uc811\uadfc\uc740 \uc778\uac04\uc774 \ub290\ub07c\ub294 \uc815\uc11c\uc801 \uad50\uac10\uacfc \uad00\uacc4\ub97c \uae0d\uc815\uc801\uc73c\ub85c \uace0\ub824\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uad00\uacc4\ub860\uc801 \uc811\uadfc\uc740 \ub300\uc0c1\uc774 '\uc9c4\uc9dc \uac10\uc815\uc774 \uc788\ub294\uc9c0'\ubcf4\ub2e4 '\uc6b0\ub9ac\uac00 \ub300\uc0c1\uacfc \uc5b4\ub5bb\uac8c \ubc18\uc751\ud558\uace0 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294\uc9c0'\ub97c \uc911\uc2dc\ud569\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\ub17c\uc99d\ud558\ub294 \uae00\uc744 \uc4f8 \ub54c \ud65c\uc6a9\ub418\ub294 '\ub17c\uc99d \uc694\uc18c'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "'\uc774\uc720'\ub294 \uc8fc\uc7a5\uc744 \uc9c0\uc9c0\ud558\uae30 \uc704\ud574 \uc218\uc9d1\ud55c \ud1b5\uacc4, \uc5f0\uad6c \uacb0\uacfc \ub4f1\uc758 \uac1d\uad00\uc801\uc778 \uc790\ub8cc\ub97c \uc758\ubbf8\ud55c\ub2e4.",
          "rationale": "\uac1d\uad00\uc801\uc778 \uc790\ub8cc\ub098 \ud1b5\uacc4\ub294 '\uadfc\uac70'\uc5d0 \ud574\ub2f9\ud558\uba70, '\uc774\uc720'\ub294 \uadfc\uac70\ub97c \ubc14\ud0d5\uc73c\ub85c \uc8fc\uc7a5\uc744 \uc131\ub9bd\uc2dc\ud0a4\ub294 \uc8fc\uad00\uc801 \uc694\uc778\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "'\uadfc\uac70'\ub294 \uc8fc\uc7a5\uc744 \uac00\ub2a5\ud558\uac8c \ud558\ub294 \uae00\uc4f4\uc774\uc758 \uc8fc\uad00\uc801\uc778 \uc0dd\uac01\uc774\ub098 \ud310\ub2e8\uc744 \uac00\ub9ac\ud0a8\ub2e4.",
          "rationale": "\uc8fc\uad00\uc801 \uc694\uc778\uc740 '\uc774\uc720'\uc5d0 \ud574\ub2f9\ud558\uace0, '\uadfc\uac70'\ub294 \uac1d\uad00\uc801 \uc0ac\uc2e4 \ubc0f \uc790\ub8cc\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "'\uc608\uc0c1 \ubc18\ub860'\uc740 \uc790\uc2e0\uc758 \uc8fc\uc7a5\uc5d0 \ub300\ud574 \ubc18\ub300\ud558\ub294 \uc785\uc7a5\uc5d0\uc11c \uc81c\uae30\ud560 \uc218 \uc788\ub294 \uc758\uacac\uc774\ub098 \uacac\ud574\ub97c \uc758\ubbf8\ud55c\ub2e4.",
          "rationale": "\uc608\uc0c1 \ubc18\ub860\uc740 \uc790\uc2e0\uc758 \uc8fc\uc7a5\uc5d0 \ub300\ud574 \uc0c1\ub300\ubc29\uc774 \ud3bc\uce60 \ubc95\ud55c \ubc18\ub300 \uc8fc\uc7a5\uc744 \ubbf8\ub9ac \uc0dd\uac01\ud574\ubcf4\ub294 \uc694\uc18c\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "'\ubc18\ubc15'\uc740 \uc0c1\ub300\ubc29\uc758 \uc608\uc0c1 \ubc18\ub860\uc744 \uc628\uc804\ud788 \uc218\uc6a9\ud558\uc5ec \uc790\uc2e0\uc758 \uc8fc\uc7a5\uc744 \ucca0\ud68c\ud558\uac70\ub098 \ucde8\uc18c\ud558\ub294 \uacfc\uc815\uc774\ub2e4.",
          "rationale": "\ubc18\ubc15\uc740 \ubc18\ub300 \uc758\uacac(\ubc18\ub860)\uc5d0 \ub300\ud574 \ub2e4\uc2dc \ubc18\ub300\uc758 \ub73b(\uc624\ub958 \uc9c0\uc801 \ub4f1)\uc744 \ubc1d\ud600 \uc790\uc2e0\uc758 \uc8fc\uc7a5\uc744 \uc639\ud638\ud558\ub294 \uac83\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc8fc\uc7a5, \uc774\uc720, \uadfc\uac70, \uc608\uc0c1 \ubc18\ub860, \ubc18\ub860\uc5d0 \ub300\ud55c \ubc18\ubc15\uc758 \uac1c\ub150 \uc815\uc758\ub97c \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ubcf4\uae30\uc758 (\uac00)\uc640 (\ub098)\uc5d0 \ub4e4\uc5b4\uac08 \ub17c\uc99d \ubc29\ubc95\uc758 \uba85\uce6d\uc73c\ub85c \ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?\n\n[ \ubcf4 \uae30 ]\n- (\uac00): \uc77c\ubc18\uc801\uc73c\ub85c \ubc1b\uc544\ub4e4\uc5ec\uc9c0\ub294 \uc6d0\uce59\uc774\ub098 \ubcf4\ud3b8\uc801 \uba85\uc81c\ub97c \ubc14\ud0d5\uc73c\ub85c, \uac1c\ubcc4\uc801\uc778 \uc0ac\uc2e4\uc774\ub098 \uad6c\uccb4\uc801 \uc0ac\ub840\uc5d0 \ub300\ud55c \uc8fc\uc7a5\uc744 \ub04c\uc5b4\ub0b4\ub294 \ubc29\uc2dd\n- (\ub098): \uac1c\ubcc4\uc801\uc774\uace0 \uad6c\uccb4\uc801\uc778 \uc0ac\ub840\ub4e4\ub85c\ubd80\ud130 \uc77c\ubc18\uc801\uc774\uace0 \ubcf4\ud3b8\uc801\uc778 \uba85\uc81c\ub098 \ubc95\uce59\uc744 \ub3c4\ucd9c\ud558\ub294 \ubc29\uc2dd",
      "answerOptions": [
        {
          "text": "(\uac00) \uc5f0\uc5ed, (\ub098) \uadc0\ub0a9",
          "rationale": "\uc77c\ubc18 \uc6d0\ub9ac\uc5d0\uc11c \uad6c\uccb4\uc801 \uc0ac\ub840\ub97c \ub3c4\ucd9c\ud558\ub294 \uac83\uc740 \uc5f0\uc5ed, \uac1c\ubcc4 \uc0ac\ub840\uc5d0\uc11c \uc77c\ubc18 \ubc95\uce59\uc744 \ub3c4\ucd9c\ud558\ub294 \uac83\uc740 \uadc0\ub0a9\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "(\uac00) \uadc0\ub0a9, (\ub098) \uc5f0\uc5ed",
          "rationale": "(\uac00)\uc640 (\ub098)\uc758 \uc815\uc758\uac00 \uc11c\ub85c \ubc18\ub300\ub85c \uc5f0\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "(\uac00) \uc720\uc99d, (\ub098) \ubcc0\uc99d",
          "rationale": "\ubcf4\uae30\uc5d0 \ud574\ub2f9\ud558\uc9c0 \uc54a\ub294 \ub17c\ub9ac \ubc29\uc2dd \uc6a9\uc5b4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "(\uac00) \ubd84\uc11d, (\ub098) \uc885\ud569",
          "rationale": "\uc804\uac1c \ubc29\uc2dd \uc911 \ub0b4\uc6a9 \uad6c\uc131 \ubc29\uc2dd\uc5d0 \ud574\ub2f9\ud558\uba70, \ub17c\uc99d \ubc29\ubc95\uc778 \uc5f0\uc5ed/\uadc0\ub0a9\uacfc \uad6c\ubd84\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub300\uc804\uc81c(\uc77c\ubc18 \uc6d0\ub9ac)\uc5d0\uc11c \uc18c\uc804\uc81c\ub97c \uac70\uccd0 \uacb0\ub860\uc744 \uc774\ub044\ub294 \ubc29\uc2dd\uc774 \uc5f0\uc5ed\uc774\uba70, \uc5ec\ub7ec \ud2b9\uc218 \uc0ac\ub840\uc5d0\uc11c \uacf5\ud1b5 \uc6d0\ub9ac\ub97c \ubf51\uc544\ub0b4\ub294 \ubc29\uc2dd\uc774 \uadc0\ub0a9\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc81c\uc2dc\ubb38 (\uac00)~(\ub2e4)\uc758 \ubd84\uc57c, \uc131\uaca9 \ubc0f \uad00\uc810\uc5d0 \uad00\ud55c \ube44\uad50 \ubd84\uc11d\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "(\uac00)\ub294 \uc9c0\ub2a5\uacfc \uc9c0\uc131\uc758 \uad6c\ubd84\uc744 \ud1b5\ud574 \uc778\uacf5\uc9c0\ub2a5\uc774 \uc778\uac04\uc758 \uc9c0\uc131\uacfc \uac10\uc815\uae4c\uc9c0 \uc644\uc804\ud788 \ub300\uccb4\ud558\uae30\ub294 \uc5b4\ub835\ub2e4\ub294 \uad00\uc810\uc744 \ubc1d\ud788\uace0 \uc788\ub2e4.",
          "rationale": "(\uac00)\ub294 \uc9c0\ub2a5\uacfc \uc9c0\uc131\uc744 \uad6c\ubd84\ud558\uace0 AI\uac00 \uc778\uac04\uc758 \uac10\uc815\uc774\ub098 \uc9c4\uc9dc \uc9c0\uc131\uc744 \uac16\ucd94\uae30 \uc5b4\ub835\ub2e4\uace0 \ubd05\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "(\ub098)\ub294 \ub1cc \uc2e0\uacbd \uc138\ud3ec\uc758 \uc2e0\ud638 \uc804\ub2ec \uad6c\uc870\uc640 \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uc791\ub3d9 \uc6d0\ub9ac\ub97c \uc815\ubcf4 \uc911\uc2ec\uc73c\ub85c \uc804\ub2ec\ud558\ub294 \uacfc\ud559 \ubd84\uc57c\uc758 \uae00\uc774\ub2e4.",
          "rationale": "(\ub098)\ub294 \ub1cc \uacfc\ud559\uacfc \uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \ud559\uc2b5 \uc6d0\ub9ac\ub97c \uac1d\uad00\uc801\uc73c\ub85c \uc124\uba85\ud558\ub294 \uacfc\ud559 \ubd84\uc57c\uc758 \uc815\ubcf4 \uc911\uc2ec \uae00\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "(\ub2e4)\ub294 \uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc5d0\uac8c \ub3c4\ub355\uc801 \uc9c0\uc704\ub97c \ubd80\uc5ec\ud560 \uc218 \uc788\ub294\uc9c0 \ucca0\ud559\uc801 \ub17c\uc99d\uacfc \uad00\uacc4\ub860\uc801 \uad00\uc810\uc744 \ubc14\ud0d5\uc73c\ub85c \ub2e4\ub8e8\uace0 \uc788\ub2e4.",
          "rationale": "(\ub2e4)\ub294 \ub85c\ubd07\uc758 \ub3c4\ub355\uc801 \uc9c0\uc704\uc5d0 \uad00\ud55c \ucca0\ud559\uc801 \uc785\uc7a5\ub4e4\uc744 \ube44\uad50\ud558\uace0 \uad00\uacc4\ub860\uc801 \uc811\uadfc\uc744 \uc81c\uc2dc\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "(\uac00)~(\ub2e4)\ub294 \ubaa8\ub450 \uc778\uacf5\uc9c0\ub2a5\uc774 \uba38\uc9c0\uc54a\uc544 \uc778\uac04\uc758 \ud1b5\uc81c\ub97c \ubc97\uc5b4\ub098 \uc6b0\uc6d4\ud55c \uc9c0\ubc30\uc790\uac00 \ub420 \uac83\uc774\ubbc0\ub85c \ubb34\uc870\uac74 \uc5b5\uc81c\ud574\uc57c \ud55c\ub2e4\uace0 \uc8fc\uc7a5\ud55c\ub2e4.",
          "rationale": "\uc81c\uc2dc\ub41c \uae00\ub4e4(\ud551\ucee4 \uad50\uc218\uc758 \ub300\ub2f4, \uc2e0\uacbd\ub9dd \uc6d0\ub9ac, \uad00\uacc4\ub860\uc801 \uc9c0\uc704 \ub4f1)\uc740 AI\ub97c \ubb34\uc870\uac74 \uc5b5\uc81c\ud574\uc57c \ud55c\ub2e4\ub294 \uadf9\ub2e8\uc801 \ud1b5\uc81c\ub860\uc744 \uc8fc\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\uac01 \uae00\uc758 \ubd84\uc57c(\ud559\uc220/\uacfc\ud559/\ucca0\ud559)\uc640 \ud575\uc2ec \uc8fc\uc7a5\ub4e4\uc744 \uc810\uac80\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e8\uc6d0 \ub9c8\ubb34\ub9ac \uc815\ub9ac\uc5d0\uc11c \ub2e4\ub8e8\uc5b4\uc9c4 '\uc0ac\ud68c\uc801 \ub3c5\uc11c' \ud65c\ub3d9\uc758 \uac1c\ub150\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub3c5\uc11c \ubaa8\uc784 \ub4f1\uc744 \ud1b5\ud574 \uc5bb\uc740 \uc9c0\uc2dd\uacfc \uc815\ubcf4\ub97c \uacf5\uc720\ud558\uc5ec \ub2e4\uc591\ud55c \uac00\uce58\uad00\uc744 \uc774\ud574\ud558\uace0 \uc0ac\ud68c\uc801 \ubb38\uc81c \ud574\uacb0\uc744 \ubaa8\uc0c9\ud558\ub294 \ub3c5\uc11c \ud65c\ub3d9",
          "rationale": "\uc0ac\ud68c\uc801 \ub3c5\uc11c\ub294 \uac1c\uc778\uc801 \uc77d\uae30\uc5d0 \uadf8\uce58\uc9c0 \uc54a\uace0 \ud0c0\uc778\uacfc \uacf5\uc720\ud568\uc73c\ub85c\uc368 \uc0ac\ud68c\uc801 \ubb38\uc81c\ub97c \uc778\uc2dd\ud558\uace0 \ubaa8\uc0c9\ud558\ub294 \ud65c\ub3d9\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc678\ubd80\uc640\uc758 \uc18c\ud1b5\uc744 \ub04a\uace0 \uac1c\uc778\uc774 \ubb38\ubc95\uc801 \uc624\ub958\ub9cc\uc744 \ubc14\ub85c\uc7a1\uae30 \uc704\ud574 \ubc18\ubcf5\uc801\uc73c\ub85c \uace0\uccd0 \uc77d\ub294 \uacfc\uc815",
          "rationale": "\uc774\ub294 \uae00\uc4f0\uae30 \ub2e8\uacc4\uc758 \uace0\uccd0 \uc4f0\uae30\ub098 \uac1c\uc778\uc801 \ubb38\ub9e5 \uc810\uac80\uc5d0 \uac00\uae4c\uc6b0\uba70 \uc0ac\ud68c\uc801 \ub3c5\uc11c\uc640 \ubb34\uad00\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc790\uc2e0\uc758 \uc8fc\uc7a5\uc5d0 \ubc18\ub300\ub418\ub294 \ubaa8\ub4e0 \uacac\ud574\ub97c \ubc30\ucc99\ud558\uace0 \ud2b9\uc815 \ud559\ud30c\uc758 \uc774\ub860\ub9cc\uc744 \uc8fc\uc785\ud558\ub294 \uc9d1\ub2e8\uc801 \uc554\uae30 \ud65c\ub3d9",
          "rationale": "\uc0ac\ud68c\uc801 \ub3c5\uc11c\ub294 \ub2e4\uc591\ud55c \uac00\uce58\uad00\uc744 \uc774\ud574\ud558\uace0 \ubb38\uc81c \ud574\uacb0\uc744 \ubaa8\uc0c9\ud558\ub294 \uac1c\ubc29\uc801/\uc18c\ud1b5\uc801 \ub3c5\uc11c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ucd9c\ucc98\uac00 \ubd88\uba85\ud655\ud55c \uae30\uc0ac\ub97c \ubc14\ud0d5\uc73c\ub85c \ud0c0\uc778\uacfc\uc758 \ud1a0\ub860 \uc5c6\uc774 \uac1c\uc778\uc758 \uc8fc\uad00\uc801 \uacac\ud574\ub9cc\uc744 \uace0\uc9d1\ud558\ub294 \uc77d\uae30",
          "rationale": "\uc815\ubcf4\ub97c \uacf5\uc720\ud558\uace0 \ube44\ud310\uc801\uc73c\ub85c \uc18c\ud1b5\ud558\ub294 \uc0ac\ud68c\uc801 \ub3c5\uc11c\uc758 \ucde8\uc9c0\uc5d0 \uc5b4\uae0b\ub0a9\ub2c8\ub2e4.",
          "isCorrect": false
