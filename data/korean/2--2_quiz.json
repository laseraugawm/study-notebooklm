          "text": "\ub2f9\uc2dc \uc18c\uc124\uc740 \ubb38\ud559\uc801 \uac00\uce58\ub97c \ub9e4\uc6b0 \ub192\uac8c \ub300\uc6b0\ubc1b\ub294 \uc8fc\ub958 \uc7a5\ub974\uc600\uae30\uc5d0 \uc601\uc870\uc758 \uad00\uc2ec\uc740 \ub2f9\uc5f0\ud55c \uac83\uc774\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubcf4\uae30\uc5d0 \ub530\ub974\uba74 \ub2f9\uc2dc \uc18c\uc124\uc740 \ubb38\ud559\uc801 \uac00\uce58\ub97c \uc81c\ub300\ub85c \uc778\uc815\ubc1b\uc9c0 \ubabb\ud558\ub358 \uc2dc\uc808\uc774\uc5c8\uc73c\ubbc0\ub85c \uc601\uc870\uc758 \uadf9\ucc2c\uc740 \ub9e4\uc6b0 \ub180\ub77c\uc6b4 \uc77c\uc774\uc5c8\uc2b5\ub2c8\ub2e4."
