        {
          "text": "\uc778\uae30\uc5d0 \ud798\uc785\uc5b4 \ud55c\uad6d \uc18c\uc124 \uc911 \uac00\uc7a5 \uba3c\uc800 \uc0c1\uc5c5\uc801\uc73c\ub85c \ucd9c\ud310\ub418\uae30\ub3c4 \ud558\uc600\ub2e4.",
