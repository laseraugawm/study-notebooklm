        {
          "text": "\uc131\uc9c4\uc774 \uafbc \uafc8\uc740 \ud658\uc220\uc5d0 \ubd88\uacfc\ud558\ubbc0\ub85c \ucc38\uc120 \ub300\uc2e0 \ubd88\uacbd\uc744 \uc678\uc6b0\ub294 \ub370\ub9cc \uc804\ub150\ud558\ub77c\uace0 \uc9c0\uc2dc\ud558\uae30 \uc704\ud574",
          "isCorrect": false,
          "rationale": "\uafc8\uacfc \ud604\uc2e4\uc5d0 \ub300\ud55c \uadfc\ubcf8\uc801\uc778 \uad00\uc810 \uc804\ud658\uc744 \uc694\uad6c\ud558\ub294 \uc124\ubc95\uc785\ub2c8\ub2e4."
