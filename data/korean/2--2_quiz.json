        {
          "text": "\uc704 \ubd80\uc778\uc758 \uad81\uc911\uc73c\ub85c \ub3cc\uc544\uac00 \uc2e0\uc120\uc774 \ub418\uae30 \uc704\ud55c \uaddc\uc728\uc744 \uc900\uc218\ud558\ub294 \uacfc\uc815",
