    {
      "question": "\u300c\uc870\uc2e0 \uc124\ud654\u300d\uc640 \u300c\uad6c\uc6b4\ubabd\u300d\uc744 \ube44\uad50\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
