          "rationale": "\ub300\uc0ac\ub294 \uc774\ub4e4\uc758 \uc9c4\uc815\ud55c \ub9c8\uc74c\uc744 \ubcf4\uace0 \uac10\ub3d9\ud558\uc5ec \uc81c\uc790\ub85c \ubc1b\uc544\ub4e4\uc600\uc2b5\ub2c8\ub2e4."
