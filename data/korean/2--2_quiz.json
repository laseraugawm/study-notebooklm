{
  "title": "\uad6c\uc6b4\ubabd \ud034\uc988",
  "questions": [
    {
      "question": "\ub2e4\uc74c \uc911 \ubcf8\ubb38\uc5d0 \uc81c\uc2dc\ub41c \uc11c\uc0ac \uac08\ub798 \ubc0f \uc18c\uc124\uc758 \ubc1c\ub2ec \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc11c\uc0ac \uac08\ub798\ub294 \uc778\ubb3c\uc774 \uacaa\ub294 \ud5c8\uad6c\uc758 \uc0ac\uac74\uc744 \uc774\uc57c\uae30\ub85c \ud45c\ud604\ud55c \ubb38\ud559 \uc591\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc11c\uc0ac\ub294 \uc0ac\uac74\uc744 \ud3bc\uccd0 \ub0b8\ub2e4\ub294 \ub73b\uc73c\ub85c, \ud5c8\uad6c\uc758 \uc0ac\uac74\uc744 \ub2e4\ub8e8\ub294 \ubb38\ud559 \uc791\ud488\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\uc124\uc740 \uc2e0\ud654, \uc804\uc124, \ubbfc\ub2f4 \ub4f1\uc758 \uc124\ud654\uc5d0 \ubfcc\ub9ac\ub97c \ub450\uace0 \ud615\uc131\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\uc124\uc740 \uace0\ub300 \uc124\ud654\uc640 \uc911\uad6d\uc5d0\uc11c \uc804\ud574\uc9c4 \uc804\uae30 \ub4f1\uc758 \uc601\ud5a5\uc744 \ubc1b\uc544 \ubc1c\uc804\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc870\uc120 \ud6c4\uae30\uc5d0\ub294 \ud658\ubabd \uc18c\uc124, \uc601\uc6c5 \uc18c\uc124 \ub4f1 \ub2e4\uc591\ud55c \uc720\ud615\uc758 \uc18c\uc124\uc774 \uc655\uc131\ud558\uac8c \ucc3d\uc791\ub418\uace0 \uc720\ud1b5\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc870\uc120 \ud6c4\uae30\uc5d0\ub294 \ub2e4\uc591\ud55c \uc18c\uc124 \uc720\ud615\uc774 \ubd84\ud654\ud558\uc5ec \uc655\uc131\ud558\uac8c \uc720\ud1b5\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc870\uc120 \ud6c4\uae30\uc758 \uc6b0\ub9ac \uc18c\uc124\uc740 \ubb38\ud559\uc801 \uac00\uce58\ub97c \uc778\uc815\ubc1b\uc9c0 \ubabb\ud558\uc5ec \uc0c1\uc5c5\uc801\uc778 \uc720\ud1b5\uc740 \uc804\ud600 \uc774\ub8e8\uc5b4\uc9c0\uc9c0 \uc54a\uc558\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubcf8\ubb38\uacfc \ud559\uc2b5 \ud65c\ub3d9 \ub0b4\uc6a9\uc5d0 \ub530\ub974\uba74 \uc870\uc120 \ud6c4\uae30\uc5d0\ub294 \uc18c\uc124\uc774 \uc655\uc131\ud558\uac8c \uc720\ud1b5\ub418\uc5c8\uc73c\uba70 \uc0c1\uc5c5\uc801\uc73c\ub85c \ucd9c\ud310\ub418\uae30\ub3c4 \ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc870\uc120 \ud6c4\uae30 \uc18c\uc124\uc758 \uc0dd\uc0b0\uacfc \uc18c\ube44(\uc720\ud1b5) \uc591\uc0c1\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\u300c\uad6c\uc6b4\ubabd\u300d\uc5d0\uc11c \uc8fc\uc778\uacf5 \uc131\uc9c4\uc774 \uc2a4\uc2b9 \uc721\uad00 \ub300\uc0ac\uc5d0 \uc758\ud574 \uc9c0\uc625(\uc800\uc2b9)\uc73c\ub85c \ucd94\ubc29\ub41c \uc9c1\uc811\uc801\uc778 \uacc4\uae30\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc6a9\uad81\uc5d0 \uac14\ub2e4\uac00 \ub3cc\uc544\uc624\ub294 \uae38\uc5d0 \ud314\uc120\ub140\ub97c \ub9cc\ub098 \ud76c\ub871\ud558\uace0 \uc18d\uc138\uc758 \ubd80\uadc0\uacf5\uba85\uc744 \ud0d0\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc131\uc9c4\uc740 \ud314\uc120\ub140\uc640\uc758 \ub9cc\ub0a8 \uc774\ud6c4 \ubd88\ubb38\uc758 \uc801\ub9c9\ud568\uc5d0 \ud68c\uc758\ub97c \ub290\ub07c\uace0 \ubd80\uadc0\uacf5\uba85\uc744 \ubc14\ub77c\ub294 \ub9c8\uc74c\uc744 \ud488\uc5b4 \ubc8c\uc744 \ubc1b\uc558\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub3d9\uc815\ud638 \uc6a9\uc655\uc758 \uc794\uce58\uc5d0\uc11c \uc220\uc5d0 \ucde8\ud574 \ubc95\ub2f9\uc758 \uae30\ubb3c\uc744 \ud30c\uc190\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc220\uc5d0 \ucde8\ud55c \uac83\uc740 \uc6a9\uad81\uc5d0\uc11c\uc758 \uc77c\uc774\uc9c0\ub9cc, \ucd94\ubc29\uc758 \ud575\uc2ec \uc6d0\uc778\uc740 \ud314\uc120\ub140\uc640\uc758 \ub9cc\ub0a8 \ubc0f \uc18d\uc138 \uc695\ub9dd \ubc1c\uc0dd \ub54c\ubb38\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc721\uad00 \ub300\uc0ac\uc758 \uba85\uc744 \uac70\uc5ed\ud558\uace0 \u300e\uae08\uac15\uacbd\u300f \uac15\ub860\uc5d0 \ucc38\uc11d\ud558\uc9c0 \uc54a\uc558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc131\uc9c4\uc740 \uc2a4\uc2b9\uc758 \uc2ec\ubd80\ub984\uc73c\ub85c \uc6a9\uad81\uc5d0 \ub2e4\ub140\uc654\uc73c\uba70 \uacbd\uc804 \uac15\ub860\uc744 \uac70\ubd80\ud55c \uc801\uc740 \uc5c6\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uc7a5\ubcf4\uc0b4\uc758 \ucc45\uc0c1\uc5d0 \uc788\ub358 \ubd88\uacbd\uc744 \ubab0\ub798 \ud6d4\uccd0 \uc778\uac04 \uc138\uc0c1\uc73c\ub85c \ub2ec\uc544\ub0ac\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc131\uc9c4\uc758 \uc774\ub984\uc774 \uc9c0\uc7a5\ubcf4\uc0b4\uc758 \ucc45\uc0c1 \uc704\uc5d0 \uc801\ud600 \uc788\uc5c8\uc744 \ubfd0, \uc131\uc9c4\uc774 \ubd88\uacbd\uc744 \ud6d4\uce5c \uc801\uc740 \uc5c6\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub3cc\ub2e4\ub9ac\uc5d0\uc11c \ub9cc\ub09c \uc778\ubb3c\ub4e4\uacfc \uc131\uc9c4\uc758 \ub9c8\uc74c\uc18d \ubcc0\ud654\ub97c \uc0c1\uae30\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc591\uc18c\uc720\uac00 \ub192\uc740 \ub204\ub300\uc5d0\uc11c \uc9c4\uc2dc\ud669\uc758 \uc544\ubc29\uad81, \ud55c \ubb34\uc81c\uc758 \ubb34\ub989, \ub2f9 \ud604\uc885\uc758 \ud654\uccad\uad81\uc744 \ubc14\ub77c\ubcf4\uba70 \ub290\ub080 \uac10\uc815 \ubc0f \uae68\ub2ec\uc74c\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucc9c\ud558\ub97c \ud638\ub839\ud588\ub358 \uc601\uc6c5\ub4e4\uc758 \uc601\ud654\ub3c4 \uacb0\uad6d \uc0ac\ub77c\uc9c0\ubbc0\ub85c \uc778\uc0dd\uc758 \ubd80\uadc0\uc601\ud654\uac00 \ub367\uc5c6\uc74c\uc744 \ub290\uaf08\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc18c\uc720\ub294 \uc601\uc6c5\ud638\uac78\ub4e4\uc758 \uac70\ub300\ud55c \uc131\uc5c5\ub3c4 \uacb0\uad6d \ud5c8\ubb3c\uc5b4\uc9c0\uace0 \ud480\ub9cc \ub0a8\ub294\ub2e4\ub294 \uc0ac\uc2e4\uc5d0\uc11c \uc778\uc0dd\ubb34\uc0c1\uc744 \uc808\uac10\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uacfc\uac70 \uc784\uae08\ub4e4\uc758 \uc704\uc5c5\uc744 \ubcf8\ubc1b\uc544 \ubc31\uc131\ub4e4\uc744 \uc704\ud55c \uc815\uce58\ub97c \ub354\uc6b1 \ud3bc\uccd0\uc57c\uaca0\ub2e4\uace0 \ub2e4\uc9d0\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\uc720\ub294 \uc815\uce58\uc801 \uc5c5\uc801\uc744 \ub354 \uc313\uc73c\ub824 \ud55c \uac83\uc774 \uc544\ub2c8\ub77c, \ubcbc\uc2ac\uc5d0\uc11c \ubb3c\ub7ec\ub098 \ub3c4\ub97c \uad6c\ud558\uace0\uc790 \ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc2e0\ub3c4 \ud654\uccad\uad81\uacfc \uac19\uc740 \ud654\ub824\ud55c \uad81\uc804\uc744 \uc9c0\uc5b4 \ucc98\ucca9\ub4e4\uacfc \uc601\uc6d0\ud788 \uc990\uaca8\uc57c\uaca0\ub2e4\uace0 \uc0dd\uac01\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\uc720\ub294 \ubd80\uadc0\uc601\ud654\uac00 \ud55c\uc21c\uac04\uc784\uc744 \uae68\ub2eb\uace0 \uc18d\uc138\uc758 \uc990\uac70\uc6c0\uc5d0\uc11c \ubc97\uc5b4\ub098\uace0\uc790 \ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc720\uad50\uc801 \uacf5\uba85\uc2ec\uc744 \ub2ec\uc131\ud588\uc73c\ubbc0\ub85c \uc2e0\uc120\uc774 \ub418\uc5b4 \ubd88\ub85c\uc7a5\uc0dd\ud558\ub294 \uc120\ub3c4(\u4ed9\u9053)\ub97c \ub2e6\uae30\ub85c \uacb0\uc2ec\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\uc720\ub294 \uc120\ub3c4\uac00 \ud5c8\ud0c4\ud558\ub2e4\uace0 \ubcf4\uc558\uc73c\uba70, \ubd88\ub3c4(\u4f5b\u9053)\uc57c\ub9d0\ub85c \uac00\uc7a5 \ub192\uc740 \ub3c4\ub9ac\ub77c\uace0 \ud310\ub2e8\ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc5ed\uc0ac\uc801 \uc778\ubb3c\ub4e4\uc758 \ud654\ub824\ud55c \uc720\uc801\uc774 \uc9c0\uae08\uc740 \uc5b4\ub5bb\uac8c \ubcc0\ud588\ub294\uc9c0\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc591\uc18c\uc720\uac00 \uc5b8\uae09\ud55c '\uc720\ub3c4', '\uc120\ub3c4', '\ubd88\ub3c4'\uc5d0 \ub300\ud55c \uc0dd\uac01 \uc911 \ubcf8\ubb38\uc758 \ub0b4\uc6a9\uacfc \uc77c\uce58\ud558\uc9c0 \uc54a\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc720\ub3c4\ub294 \uc644\ubcbd\ud788 \uc774\ub8e8\uc5b4\uc9c0\ub354\ub77c\ub3c4 \uc778\ub95c\uc744 \ubc1d\ud788\uace0 \uc774\ub984\uc744 \ub0a8\uae30\ub294 \ub370 \uadf8\uce5c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\uc720\ub294 \uc720\ub3c4\uac00 \uacf5\uc744 \uc138\uc6b0\uace0 \ud6c4\uc138\uc5d0 \uc774\ub984\uc744 \ub0a8\uae30\ub294 \uc218\uc900\uc5d0 \uba38\ubb34\ub978\ub2e4\uace0 \ud3c9\uac00\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc120\ub3c4\ub294 \ud5c8\ud0c4\ud55c \ub370 \uac00\uae4c\uc6cc \uc608\ub85c\ubd80\ud130 \uad6c\ud558\ub294 \uc790\ub294 \ub9ce\uc558\uc73c\ub098 \uc9c4\uc815\ud55c \uc131\uacfc\ub97c \uc5bb\uc9c0 \ubabb\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\uc720\ub294 \uc9c4\uc2dc\ud669\uc774\ub098 \ud55c \ubb34\uc81c\uc758 \uc0ac\ub840\ub97c \ub4e4\uc5b4 \uc120\ub3c4\uc758 \ud55c\uacc4\ub97c \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubd88\ub3c4\ub294 \ubd88\uc0dd\ubd88\uba78\uc758 \ub3c4\ub97c \uc5bb\uc5b4 \uc778\uac04 \uc138\uc0c1\uc758 \uad34\ub85c\uc6c0\uc744 \ubc97\uc5b4\ub098\uac8c \ud558\ubbc0\ub85c \uac00\uc7a5 \ub192\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\uc720\ub294 \uc138 \uac00\uc9c0 \ub3c4 \uc911 \ubd88\ub3c4\ub97c \uac00\uc7a5 \uc73c\ub738\uc73c\ub85c \uc5ec\uacbc\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc120\ub3c4\ub294 \uc2e0\uc120 \uc801\uc1a1\uc790\ub97c \ub530\ub77c \ub3c4\ub97c \uc5bb\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c \uc720\ub3c4\ub098 \ubd88\ub3c4\ubcf4\ub2e4 \uc6b0\uc6d4\ud558\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc18c\uc720\ub294 \uc801\uc1a1\uc790\ub97c \ub530\ub978 \uc7a5\uc591\uc758 \ubaa8\ubc94\uc744 \uc5b8\uae09\ud558\uae34 \ud588\uc73c\ub098, \uc120\ub3c4 \uc790\uccb4\uac00 \uac70\uc9d3\ub418\uace0 \uc131\uacfc\uac00 \uc5c6\ub2e4\uace0 \ubcf4\uc558\uc73c\uba70 \ubd88\ub3c4\ub97c \uac00\uc7a5 \ub192\uac8c \ud3c9\uac00\ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc138 \uac00\uc9c0 \ub3c4 \uc911\uc5d0\uc11c \uc18c\uc720\uac00 \uc778\uc0dd\uc758 \uad34\ub85c\uc6c0\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \ucd5c\uc885\uc801\uc73c\ub85c \uc120\ud0dd\ud558\ub824 \ud55c \ub3c4\uac00 \ubb34\uc5c7\uc778\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc591\uc18c\uc720\uac00 \uafc8\uc5d0\uc11c \uae68\uc5b4\ub098 \ub2e4\uc2dc \uc5f0\ud654 \ub3c4\ub7c9\uc758 '\uc131\uc9c4'\uc73c\ub85c \ub3cc\uc544\uc624\uac8c \ub418\ub294 \uc9c1\uc811\uc801\uc778 \uacc4\uae30\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ud638\uc0c1\uc5d0 \ub098\ud0c0\ub09c \ubd88\uc2b9(\uc721\uad00 \ub300\uc0ac)\uc774 \uc9c0\ud321\uc774\ub85c \ub09c\uac04\uc744 \uce58\uc790 \uad6c\ub984\uc774 \uac10\uc30c\ub2e4\uac00 \uac77\ud614\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub178\ub300\uc0ac\uac00 \uc9c0\ud321\uc774\ub85c \ub09c\uac04\uc744 \uce58\uc790 \ud770 \uad6c\ub984\uc774 \ud53c\uc5b4\uc62c\ub77c \ub204\ub300\ub97c \uac10\uc30c\uace0, \uad6c\ub984\uc774 \uac77\ud788\uba70 \uafc8\uc5d0\uc11c \uae68\uc5b4\ub0ac\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ucc98\ucca9\ub4e4\uc774 \uc62c\ub9b0 \uc804\ubcc4\uc8fc\ub97c \ub9c8\uc2dc\uace0 \uc220\uc5d0 \ucde8\ud574 \ub204\ub300 \uc704\uc5d0\uc11c \uc7a0\uc774 \ub4e4\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804\ubcc4\uc8fc\ub97c \ub9c8\uc2dc\ub824\ub358 \ucc28\uc5d0 \uc9c0\ud321\uc774 \uc18c\ub9ac\uc640 \ud568\uaed8 \ubd88\uc2b9\uc774 \ucc3e\uc544\uc654\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub0a8\ud574\ub85c \uac74\ub108\uac00 \uad00\uc74c\ubcf4\uc0b4\uc744 \ucc3e\uc544\uac00\ub358 \ub3c4\uc911 \ud48d\ub791\uc744 \ub9cc\ub098 \ubc14\ub2e4\uc5d0 \ube60\uc84c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub5a0\ub098\uae30 \uc804 \ub204\ub300\uc5d0\uc11c \ubd88\uc2b9\uc744 \ub9cc\ub098\ub294 \uacfc\uc815\uc5d0\uc11c \uae68\uc5b4\ub0ac\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud1a0\ubc88\uc744 \uc815\ubc8c\ud560 \ub54c \uc785\uc740 \uc0c1\ucc98\uac00 \ub3c4\uc838\uc11c \ubcd1\uc11d\uc5d0 \ub204\uc6e0\ub2e4\uac00 \uc758\uc2dd\uc744 \uc783\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud1a0\ubc88 \uc815\ubc8c\uc740 \uacfc\uac70 \uc591\uc18c\uc720\uc758 \uacf5\uc801 \uc911 \ud558\ub098\uc77c \ubfd0, \uafc8\uc5d0\uc11c \uae68\uc5b4\ub098\ub294 \uacc4\uae30\uac00 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub204\ub300\uc5d0 \ucc3e\uc544\uc628 \ube44\ubc94\ud55c \uc778\ubb3c\uc758 \ud589\ub3d9\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uafc8\uc5d0\uc11c \uae68\uc5b4\ub09c \uc131\uc9c4\uc5d0\uac8c \uc721\uad00 \ub300\uc0ac\uac00 '\uc7a5\uc790\uc758 \ub098\ube44 \uafc8(\ud638\uc811\ubabd)' \uc774\uc57c\uae30\ub97c \ub4e4\ub824\uc900 \uc758\ub3c4\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uafc8\uacfc \ud604\uc2e4\uc744 \uc774\ubd84\ubc95\uc801\uc73c\ub85c \uad6c\ubd84\ud558\ub294 \uc9d1\ucc29\uc5d0\uc11c \ubc97\uc5b4\ub098 \ub458\uc758 \uacbd\uacc4\uac00 \ubb34\uc758\ubbf8\ud568\uc744 \uae68\ub2eb\uac8c \ud558\uae30 \uc704\ud574",
          "isCorrect": true,
          "rationale": "\ub300\uc0ac\ub294 '\uc131\uc9c4'\uacfc '\uc591\uc18c\uc720', '\uafc8'\uacfc '\ud604\uc2e4'\uc744 \ub098\ub258\uc5b4 \ubcf4\ub294 \uc131\uc9c4\uc758 \ubbf8\ud639\uc744 \uc9c0\uc801\ud558\uba70 \ub9cc\ubb3c\uc774 \ubcf8\ub798 \ud558\ub098\uc784\uc744 \uc77c\uae68\uc6e0\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uafc8\uc18d\uc5d0\uc11c\uc758 \uc8c4\uc5c5\uc774 \ud604\uc2e4\ubcf4\ub2e4 \ud6e8\uc52c \ubb34\uac70\uc6b0\ubbc0\ub85c \uc9c0\uc625\uc73c\ub85c \ub2e4\uc2dc \ub3cc\uc544\uac00\uc57c \ud568\uc744 \uc54c\ub9ac\uae30 \uc704\ud574",
          "isCorrect": false,
          "rationale": "\ub300\uc0ac\ub294 \uc131\uc9c4\uc744 \ubc8c\ud558\uae30 \uc704\ud574\uc11c\uac00 \uc544\ub2c8\ub77c \uae68\ub2ec\uc74c\uc744 \uc8fc\uae30 \uc704\ud574 \uc774 \ube44\uc720\ub97c \uc0ac\uc6a9\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uac04 \uc138\uc0c1\uc758 \uc0b6\uc774 \ub098\ube44\ucc98\ub7fc \uc790\uc720\ub86d\uace0 \uc544\ub984\ub2e4\uc6b0\ub2c8 \uc18d\uc138\ub85c \ub3cc\uc544\uac00\ub77c\uace0 \uad8c\uc720\ud558\uae30 \uc704\ud574",
          "isCorrect": false,
          "rationale": "\uc18d\uc138\ub85c \ub3cc\uc544\uac00\ub77c\ub294 \ub73b\uc774 \uc544\ub2c8\ub77c \ucc28\uc6d0 \ub192\uc740 \ubd88\uad50\uc801 \uae68\ub2ec\uc74c\uc744 \uc5bb\uac8c \ud558\ub824\ub294 \ubaa9\uc801\uc785\ub2c8\ub2e4."
