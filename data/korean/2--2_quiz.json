      "hint": "\uc131\uc9c4\uc774 \"\uafc8\uc744 \uafb8\uc5c8\ub2e4\"\uace0 \ub9d0\ud558\uc790, \ub300\uc0ac\uac00 \"\uafc8\uacfc \uc778\uac04 \uc138\uc0c1\uc744 \ub098\ub204\uc5b4 \ubcf8\ub2e4\"\uace0 \uc9c0\uc801\ud55c \ubd80\ubd84\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uafc8\uc5d0\uc11c \uae68\uc5b4\ub09c \ud6c4 \uc721\uad00 \ub300\uc0ac\ub97c \ucc3e\uc544\uc628 \ud314\uc120\ub140\uac00 \uba38\ub9ac\uce74\ub77d\uc744 \uc790\ub974\uace0 \uc637\ucc28\ub9bc\uc744 \ubc14\uafbc \ud589\uc704\uc5d0 \ub2f4\uae34 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc18d\uc138\uc758 \uc815\uc695\uacfc \ubbf8\ub828\uc744 \uc644\uc804\ud788 \ub04a\uace0 \ubd88\ubb38\uc5d0 \uadc0\uc758\ud558\uaca0\ub2e4\ub294 \uac15\ud55c \uc758\uc9c0\uc640 \uc815\uc131\uc758 \ud45c\ucd9c",
          "isCorrect": true,
          "rationale": "\ub2e8\uc7a5\uacfc \ube44\ub2e8\uc637\uc744 \ubc84\ub9ac\uace0 \uba38\ub9ac\ub97c \uae4e\uc740 \uac83\uc740 \uc138\uc18d\uacfc\uc758 \uc778\uc5f0\uc744 \ub04a\uace0 \ubd88\uc81c\uc790\uac00 \ub418\uaca0\ub2e4\ub294 \uc9c0\uadf9\ud55c \uacb0\uc758\ub97c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
