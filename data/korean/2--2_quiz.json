        {
          "text": "\uc591\uc18c\uc720\uc640\uc758 \uc774\ubcc4\uc744 \uc2ac\ud37c\ud558\uc5ec \uc0c1\ubcf5\uc744 \uc785\uace0 \uadfc\uc2e0\ud558\ub294 \ud0dc\ub3c4",
          "isCorrect": false,
          "rationale": "\uc591\uc18c\uc720\uc640\uc758 \uc18d\uc138 \uc778\uc5f0\uc774 \uafc8\uc774\uc5c8\uc74c\uc744 \uae68\ub2eb\uace0 \ubd88\ubc95\uc744 \ubc30\uc6b0\uae30 \uc704\ud55c \ud589\uc704\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc721\uad00 \ub300\uc0ac\uc758 \uc5c4\ud55c \ud638\ud1b5\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc784\uc2dc\ubc29\ud3b8\uc73c\ub85c \ucde8\ud55c \ud589\ub3d9",
