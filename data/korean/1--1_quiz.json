{
  "title": "\uc0ac\ud68c\ub3c5\uc11c \ud034\uc988",
  "questions": [
    {
      "question": "'\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9'\uc758 \uac1c\ub150\uacfc \ud6a8\uacfc\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778\uc758 \ub3c5\uc11c \uc5ed\ub7c9\uc744 \ub192\uc5ec \ud0c0\uc778\uacfc\uc758 \uacbd\uc7c1\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud558\ub294 \uac83\uc744 \ucd5c\uc6b0\uc120 \ubaa9\ud45c\ub85c \ud55c\ub2e4.",
          "rationale": "\uc0ac\ud68c\uc801 \ub3c5\uc11c \ud65c\ub3d9\uc740 \uac1c\uc778\uc758 \uc9c0\uc2dd \uc2b5\ub4dd\uc774\ub098 \uacbd\uc7c1\ubcf4\ub2e4\ub294 \uad6c\uc131\uc6d0 \uac04\uc758 \uc5f0\ub300, \ud611\ub825, \ud0c0\uc778 \uc774\ud574 \ubc0f \uc0ac\ud68c\uc801 \ubb38\uc81c \ud574\uacb0\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub3c5\uc11c\ub97c \ud1b5\ud574 \uc6b0\ub9ac \uc0ac\ud68c\uc758 \ubb38\uc81c\ub97c \uc778\uc2dd\ud558\uace0 \ud0c0\uc778\uc5d0 \ub300\ud55c \uc774\ud574\uc758 \ud3ed\uc744 \ub113\ud790 \uc218 \uc788\ub2e4.",
          "rationale": "\uc0ac\ud68c\uc801 \ub3c5\uc11c\ub97c \ud1b5\ud574 \ud0c0\uc778\uc758 \ub2e4\uc591\ud55c \uc0b6\uc758 \ubc29\uc2dd\uacfc \uac00\uce58\uad00\uc744 \uc774\ud574\ud558\uace0 \uc0ac\ud68c \ubb38\uc81c\ub97c \uc778\uc2dd\ud558\uac8c \ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3c5\uc11c\ub97c \ud1b5\ud574 \uc5bb\uac8c \ub41c \uc9c0\uc2dd\uc774\ub098 \uc815\ubcf4\ub97c \ub2e4\ub978 \uc0ac\ub78c\uacfc \uacf5\uc720\ud558\uba70 \uad50\ub958\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\ub3c5\uc11c \ubaa8\uc784\uc774\ub098 \uc628\ub77c\uc778 \ud50c\ub7ab\ud3fc \ub4f1\uc744 \ud1b5\ud574 \uc815\ubcf4\uc640 \uc9c0\uc2dd\uc744 \ub098\ub204\ub294 \uac83\uc740 \uc0ac\ud68c\uc801 \ub3c5\uc11c\uc758 \ud575\uc2ec \ud65c\ub3d9\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub2e4\uc591\ud55c \uad6c\uc131\uc6d0\ub4e4\uc774 \uc5f0\ub300\ud558\uace0 \ud611\ub825\ud558\uba74\uc11c \uc0ac\ud68c\uc801 \ubb38\uc81c\ub97c \ud574\uacb0\ud560 \ubc29\uc548\uc744 \ub9c8\ub828\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\uad6c\uc131\uc6d0 \uac04 \ud611\ub825\uc744 \ud1b5\ud574 \uacf5\ub3d9\uccb4\uc758 \ubb38\uc81c\ub97c \uc778\uc2dd\ud558\uace0 \ud574\uacb0\ucc45\uc744 \ubaa8\uc0c9\ud558\ub294 \uac83\uc774 \uc0ac\ud68c\uc801 \ub3c5\uc11c\uc758 \uc8fc\uc694 \ud6a8\uacfc\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc0ac\ud68c\uc801 \ub3c5\uc11c\uac00 \uac1c\uc778 \ucc28\uc6d0\uc5d0 \uba38\ubb34\ub974\ub294\uc9c0, \uc544\ub2c8\uba74 \ud0c0\uc778 \ubc0f \uacf5\ub3d9\uccb4\uc640 \uad00\uacc4\ub97c \ub9fa\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \uc124\uba85\ud558\ub294 '\uc9d1\ub2e8 \uc9c0\uc131'\uc5d0 \ub300\ud55c \uc774\ud574\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub2e4\uc218\uc5d0 \uc758\ud574 \uac80\uc99d\ub41c \uc815\ubcf4\ub77c \ud558\ub354\ub77c\ub3c4 \ud56d\uc0c1 \uc624\ub958\uac00 \ubc1c\uc0dd\ud558\uc5ec \uac1d\uad00\uc131\uc744 \ud655\ubcf4\ud558\uae30 \uc5b4\ub835\ub2e4.",
          "rationale": "\ubcf8\ubb38\uc5d0\uc11c\ub294 \ub2e4\uc218\uc758 \ucc38\uc5ec\uc790\uac00 \uc815\ubcf4\ub97c \uc218\uc815\ud558\uace0 \ubcf4\uc644\ud558\uc5ec \uac80\uc99d\ud55c \uc815\ubcf4\ub294 \uac1d\uad00\uc131\uc744 \ud655\ubcf4\ud558\uac8c \ub41c\ub2e4\uace0 \uc124\uba85\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud604\ub300 \uc0ac\ud68c\ub294 \uc815\ubcf4 \uc0dd\uc0b0\uacfc \uc720\ud1b5\uc758 \uc9c4\uc785 \uc7a5\ubcbd\uc774 \ub0ae\uc544\uc838 \ub204\uad6c\ub098 \uacfc\uc815\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uac8c \ub418\uc5c8\ub2e4.",
          "rationale": "\uc815\ubcf4 \uae30\uc220\uc758 \ubc1c\ub2ec\ub85c \uc815\ubcf4 \uc0dd\uc131 \ubc0f \uacf5\uc720 \uacfc\uc815\uc5d0 \uc77c\ubc18\uc778\ub4e4\ub3c4 \uc190\uc27d\uac8c \ucc38\uc5ec\ud560 \uc218 \uc788\uac8c \ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc18c\uc218 \uc9d1\ub2e8\uc774 \uc815\ubcf4\ub97c \ub3c5\uc810\ud558\ub358 \uacfc\uac70\uc640 \ub2ec\ub9ac \uc77c\ubc18\uc778\ub4e4\ub3c4 \uc815\ubcf4\ub97c \uc62c\ub9ac\uace0 \uacf5\uc720\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\uacfc\uac70\uc640 \ub2ec\ub9ac \uc815\ubcf4 \ub3c5\uc810\uc774 \ud574\uc81c\ub418\uace0 \ub2e4\uc218\uac00 \uc9c0\uc131\uc744 \ubc1c\ud718\ud560 \uc218 \uc788\ub294 \ud658\uacbd\uc774 \uc870\uc131\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac00\uc9dc \ub274\uc2a4\ub098 \ucd9c\ucc98 \uc5c6\ub294 \uc815\ubcf4\uac00 \ud30c\uae09\ub825\uc744 \uac00\uc9c0\uba74 \uc798\ubabb\ub41c \uc9d1\ub2e8 \uc9c0\uc131\uc774\ub098 \uc815\uc11c\ub97c \ud615\uc131\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\uac80\uc99d\ub418\uc9c0 \uc54a\uc740 \ud5c8\uc704 \uc815\ubcf4\uac00 \ud655\uc0b0\ub420 \uacbd\uc6b0 \uc9d1\ub2e8 \uc9c0\uc131\uc758 \uadf8\ub298(\ubd80\uc791\uc6a9)\uc774 \ub098\ud0c0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub2e4\uc218\uc758 \ucc38\uc5ec\uc790\uac00 \uc791\uc131\ud55c \uc815\ubcf4\uac00 \uc218\uc815\u00b7\ubcf4\uc644 \ubc0f \uac80\uc99d \uacfc\uc815\uc744 \uac70\ucce4\uc744 \ub54c \ud655\ubcf4\ub418\ub294 \ud2b9\uc131\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \ubcf8\ubb38\uc5d0\uc11c \uc81c\uc2dc\ud55c \ubcc4\uc810 \uc81c\ub3c4\uc758 \uc720\uc6a9\uc131 \ubc0f \uc7a5\uc810\uc73c\ub85c \ubcf4\uae30 \uc5b4\ub824\uc6b4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubcc4\uc810 \ud3c9\uac00 \ucc38\uc5ec\uc790\uac00 \ubb34\uc791\uc704 \ud45c\ubcf8\uc73c\ub85c \uad6c\uc131\ub418\uc5b4 \uc804\uccb4 \uc774\uc6a9\uc790\uc758 \ud3c9\uac00\ub97c \uc815\ud655\ud558\uac8c \ub300\ud45c\ud55c\ub2e4.",
          "rationale": "\ubcf8\ubb38\uc5d0\uc11c\ub294 \ubcc4\uc810 \ucc38\uc5ec\uc790\uac00 \uc804\uccb4 \uc774\uc6a9\uc790\ub97c \ub300\ud45c\ud558\ub294 \ubb34\uc791\uc704 \ud45c\ubcf8\uc774 \uc544\ub2c8\ub77c\ub294 \uc810\uc744 \ubb38\uc81c\uc810\uc73c\ub85c \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc81c\ud488\uc774\ub098 \uc11c\ube44\uc2a4\uc5d0 \ub300\ud55c \ub300\uc911\uc758 \ud3c9\uac00\uac00 \ubaa8\uc5ec \uc2e4\uc6a9\uc801\uc774\uace0 \ud65c\uc6a9\ub3c4 \ub192\uc740 \uae38\uc7a1\uc774 \uc5ed\ud560\uc744 \ud55c\ub2e4.",
          "rationale": "\ubcc4\uc810 \uc81c\ub3c4\ub294 \uc18c\ube44\uc790\uac00 \uc0c1\ud488\uc744 \uad6c\ub9e4\ud558\uac70\ub098 \uc11c\ube44\uc2a4\ub97c \uc120\ud0dd\ud560 \ub54c \ud310\ub2e8\uc744 \ub3d5\ub294 \uc720\uc6a9\ud55c \uae38\uc7a1\uc774\uac00 \ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud310\ub9e4\uc790\uc5d0\uac8c\ub294 \ubbf8\ub798\uc758 \ud310\ub9e4 \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \uadfc\uac70\uac00 \ub41c\ub2e4.",
          "rationale": "\uae30\uc5c5\uc774\ub098 \ud310\ub9e4\uc790\uac00 \uc774\uc6a9\uc790\uc758 \ud3c9\uac00 \ud53c\ub4dc\ubc31\uc744 \ud1b5\ud574 \ud5a5\ud6c4 \ud310\ub9e4 \uc804\ub7b5\uc744 \uc218\ub9bd\ud560 \uc218 \uc788\ub2e4\ub294 \uc810\uc740 \ubcc4\uc810\uc758 \uc7a5\uc810\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0ac\uc6a9 \ubc29\ubc95\uc774 \uc27d\uace0 \ud3b8\ub9ac\ud558\uba70 \ub098\uc758 \uc758\uacac\uc744 \ub354\ud574 \uc5ec\ub860\uc758 \ud750\ub984\uc744 \ub9cc\ub4dc\ub294 \uc18c\ud1b5\uc758 \uc990\uac70\uc6c0\uc744 \uc900\ub2e4.",
          "rationale": "\uc0ac\uc6a9 \ud3b8\uc758\uc131\uacfc \ub354\ubd88\uc5b4 \uc790\uc2e0\uc758 \uc758\uacac\uc744 \ubcf4\ud0dc\uc5b4 \ud750\ub984\uc744 \ub9cc\ub4e4\uc5b4 \uac00\ub294 \uc18c\ud1b5\uc758 \uac00\uce58\ub97c \uc9c0\ub2c8\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubcc4\uc810 \ud3c9\uac00\uc5d0 \ucc38\uc5ec\ud558\ub294 \uc0ac\ub78c\ub4e4\uc774 \uc804\uccb4 \uc774\uc6a9\uc790\ub97c \ub300\ud45c\ud560 \uc218 \uc788\ub294 \uadf8\ub8f9\uc778\uc9c0 \uc870\uc0ac\ud55c \ub0b4\uc6a9\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcc4\uc810 \uc81c\ub3c4\uc758 \ubb38\uc81c\uc810 \uc911 '\uc798\ubabb\ub41c \ucd94\ub860\uc744 \uc774\ub04c\uc5b4\ub0b4\ub294 \uacbd\uc6b0'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc774\uc6a9\uc790\uc758 \ud638\ubd88\ud638\uac00 \ub69c\ub837\ud558\uc5ec 1\uc810\uacfc 5\uc810\uc5d0 \uce58\uc6b0\uce5c \uc5e0(M)\uc790\ud615 \ubd84\ud3ec\ub77c\ub3c4 \ud3c9\uade0\ub9cc \ubcf4\uba74 '\uc911\uac04 \uc815\ub3c4'\ub85c \uc624\uc778\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\uc591\uadf9\ub2e8\uc73c\ub85c \ud3c9\uc810\uc774 \uac08\ub9b0 \uc5e0\uc790\ud615 \ubd84\ud3ec\ub77c\ub3c4 \ud3c9\uade0\uac12(\uc608: 3\uc810)\ub9cc \ud655\uc778\ud55c \uc18c\ube44\uc790\ub294 \ud574\ub2f9 \uc5c5\uc18c\ub97c '\ud3c9\uade0\uc801\uc778 \ub9db\uc9d1'\uc73c\ub85c \uc798\ubabb \ud310\ub2e8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud3c9\uc810\uc774 3\uc810\uc77c \ub54c \uc815\uc0c1 \ubd84\ud3ec \uace1\uc120\uc744 \uadf8\ub9ac\ub294 \uacbd\uc6b0\uc5d0\ub9cc \uc774\uc6a9\uc790\uac00 \uc798\ubabb\ub41c \uc120\ud0dd\uc744 \ud558\uac8c \ub41c\ub2e4.",
          "rationale": "\uc815\uc0c1 \ubd84\ud3ec\ub294 \uc911\uac04\uac12 \uadfc\ucc98\uc5d0 \uc774\uc6a9\uc790\uac00 \uc9d1\uc911\ub41c \uc77c\ubc18\uc801\uc778 \uc0c1\ud669\uc73c\ub85c, \uc798\ubabb\ub41c \ucd94\ub860\uc744 \uc774\ub04c\uc5b4\ub0b4\ub294 \ub300\ud45c\uc801 \uc608\uc2dc\uac00 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubcc4\uc810 \ud3c9\uac00\uc790 \uc218\uac00 \uc801\uc744 \ub54c \ud56d\uc0c1 \ub9cc\uc871\ub3c4\uac00 \ucd5c\uc0c1\uc73c\ub85c \uc65c\uace1\ub418\ub294 \ud604\ub9cc\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "rationale": "\ud3c9\uac00\uc790 \uc218\uac00 \uc801\uc740 \ubb38\uc81c\ub294 \uadf9\ub2e8\uc801 \ud3c9\uac00\ub098 \ud5c8\uc704 \ub313\uae00\ub85c \uc778\ud55c \uc65c\uace1 \ubb38\uc81c\uc5d0 \ud574\ub2f9\ud558\uba70, \ubd84\ud3ec \uace1\uc120\uc5d0 \ub530\ub978 \ucc29\uc2dc\uc640\ub294 \ubcc4\uac1c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud50c\ub7ab\ud3fc \uc0ac\uc5c5\uc790\uac00 \uc791\uc131\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \ud3c9\uc810\uc744 \uc784\uc758\ub85c \ubcc0\uacbd\ud558\uac70\ub098 \uc0ad\uc81c\ud558\uc5ec \ubc1c\uc0dd\ud558\ub294 \ubb38\uc81c\uc774\ub2e4.",
          "rationale": "\ud50c\ub7ab\ud3fc \uc0ac\uc5c5\uc790\uc758 \uc784\uc758 \uc0ad\uc81c \ubd88\uac00 \uc6d0\uce59\uc740 \ubc95\ub839\uc0c1 \uc800\uc791\ubb3c \uaddc\uc815\uacfc \uad00\ub828\ub41c \ub0b4\uc6a9\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc911\uac04\uac12(\ud3c9\uade0)\uc740 \ub3d9\uc77c\ud558\uac8c 3\uc810\uc774\ub77c\ub3c4 \uc774\uc6a9\uc790\uc758 \ud638\ubd88\ud638\uac00 \uadf9\uba85\ud788 \uac08\ub9ac\ub294 \ubd84\ud3ec \ud615\ud0dc\uac00 \ubb34\uc5c7\uc778\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \ubcc4\uc810 \uc81c\ub3c4\ub97c \ud3d0\uc9c0\ud558\uae30\ubcf4\ub2e4 \ubb38\uc81c\uc810\uc744 \ubcf4\uc644\ud558\ub294 \uac1c\uc120\ucc45\uc744 \ucc3e\uace0\uc790 \ud558\ub294 \uacb0\uc815\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ubcc4\uc810 \uc81c\ub3c4\uac00 \uc88b\uace0 \ub098\uc068\uc758 \ubb38\uc81c\ub97c \ub5a0\ub098 \uc774\ubbf8 \uc6b0\ub9ac \uc0ac\ud68c\uc758 \ud55c \ubb38\ud654\ub85c \uc790\ub9ac \uc7a1\uc558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uae00\uc4f4\uc774\ub294 \ubcc4\uc810 \uc81c\ub3c4\uac00 \uc774\ubbf8 \uc0ac\ud68c \ubb38\ud654\ub85c \ud655\ub9bd\ub418\uc5b4 \uc644\uc804\ud788 \ud3d0\uc9c0\ud558\uae30 \uc5b4\ub835\uae30 \ub54c\ubb38\uc5d0 \ubcf4\uc644\ucc45\uc774 \ucd5c\uc120\uc774\ub77c\uace0 \ubcf4\uc558\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubcc4\uc810 \uc81c\ub3c4\ub97c \ub300\uccb4\ud560 \uc218 \uc788\ub294 \ub2e4\ub978 \uc81c\ub3c4\uac00 \uae30\uc220\uc801\uc73c\ub85c \uac1c\ubc1c\ub420 \uc218 \uc5c6\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ub2e4\ub978 \ub300\uc548 \uc81c\ub3c4\ub97c \ud0d0\uc0c9\ud558\uae30\ubcf4\ub2e4 \ud604\uc7ac \uc2dc\uc2a4\ud15c\uc758 \ubb38\uc81c\uc810\uc744 \ubcf4\uc644\ud558\ub294 \uac83\uc774 \ud604\uc2e4\uc801\uc774\uace0 \uc9c0\ud61c\ub86d\ub2e4\uace0 \ubcf8 \uac83\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubc30\ub2ec \ud50c\ub7ab\ud3fc \uc0ac\uc5c5\uc790\ub4e4\uacfc \uc18c\uc0c1\uacf5\uc778\ub4e4\uc774 \ubcc4\uc810 \uc81c\ub3c4 \ud3d0\uc9c0\uc5d0 \uc804\uba74 \ubc18\ub300\ud558\uace0 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc18c\uc0c1\uacf5\uc778\uc758 \ud53c\ud574 \uc870\uc0ac\ub294 \ubcc4\uc810 \uc81c\ub3c4\uc758 \uc704\ud5d8\uc131\uc744 \ub098\ud0c0\ub0b4\ub294 \uc790\ub8cc\uc77c \ubfd0 \ud3d0\uc9c0 \ubc18\ub300 \uc8fc\uc7a5\uc758 \uadfc\uac70\ub85c \uc81c\uc2dc\ub41c \uac83\uc774 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubcc4\uc810 \ud3c9\uac00\uc790\uac00 \uc804\uccb4 \uc774\uc6a9\uc790\ub97c \uc644\ubcbd\ud558\uac8c \ubb34\uc791\uc704\ub85c \ub300\ud45c\ud558\uace0 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uae00\uc4f4\uc774\ub294 \uc624\ud788\ub824 \ubcc4\uc810 \ucc38\uc5ec\uc790\uac00 \uc804\uccb4 \uc774\uc6a9\uc790\ub97c \ub300\ud45c\ud558\ub294 \ubb34\uc791\uc704 \ud45c\ubcf8\uc774 \uc544\ub2c8\ub77c\uace0 \ubc1d\ud614\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubcc4\uc810 \uc81c\ub3c4\uac00 \ud604\uc7ac \uc6b0\ub9ac \uc77c\uc0c1\uacfc \uc0ac\ud68c\uc5d0\uc11c \ucc28\uc9c0\ud558\uace0 \uc788\ub294 \uc704\uc0c1\uc5d0 \uad00\ud55c \ubcf8\ubb38\uc758 \uc124\uba85\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uae00\uc4f4\uc774\uac00 \uc81c\uc548\ud55c \ubcc4\uc810 \uc81c\ub3c4\uc758 \uac1c\uc120\ucc45 \ub0b4\uc6a9\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud5c8\uc704 \uc545\uc131 \ub313\uae00\uc774\ub098 \ud3c9\uac00\uac00 \ubc1c\uacac\ub418\uba74 \ud50c\ub7ab\ud3fc \uc0ac\uc5c5\uc790\uac00 \uc791\uc131\uc790 \ub3d9\uc758 \uc5c6\uc774 \uc989\uc2dc \uc784\uc758 \uc0ad\uc81c\ud55c\ub2e4.",
          "rationale": "\ubcc4\uc810 \ud3c9\uac00\ub098 \ud3c9\ub3c4 \ubc95\ub839\uc0c1 \uc800\uc791\ubb3c\uc5d0 \ud574\ub2f9\ud558\uc5ec \uc791\uc131\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \uc0ac\uc5c5\uc790\uac00 \uc784\uc758 \uc0ad\uc81c\ud560 \uc218 \uc5c6\ub2e4\uace0 \uc9c0\uc801\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ucc38\uc5ec\ud558\ub294 \ud3c9\uac00\uc790\uc758 \uc218\uac00 \uc77c\uc815 \uae30\uc900\uce58\ub97c \ub118\uc5b4\uc11c\ub294 \uacbd\uc6b0\uc5d0\ub9cc \ubcc4\uc810\uc744 \ud45c\uc2dc\ud558\uac8c \ud55c\ub2e4.",
          "rationale": "\uadf9\uc18c\uc218 \uc774\uc6a9\uc790\uc758 \ud5c8\uc704\u00b7\uadf9\ub2e8\uc801 \ud3c9\uac00\ub85c \uc778\ud574 \uc804\uccb4 \ubcc4\uc810\uc774 \uc65c\uace1\ub418\ub294 \ud604\uc0c1\uc744 \ub9c9\uae30 \uc704\ud55c \ub300\uc548\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud3c9\uac00 \uc791\uc131\uc790\uc758 \uacfc\uac70 \ud3c9\uac00 \uc774\ub825\uc774\ub098 \uc0c1\ud488 \uc774\uc6a9 \ud69f\uc218 \ub4f1\uc758 \ucd94\uac00 \uc815\ubcf4\ub97c \uc2dc\uac01\ud654\ud558\uc5ec \uc81c\uacf5\ud55c\ub2e4.",
          "rationale": "\uc5f4\ub78c\uc790\uac00 \ud3c9\uac00 \uacb0\uacfc\uc758 \uc2e0\ub8b0\uc131\uc744 \uc62c\ubc14\ub974\uac8c \ud310\ub2e8\ud560 \uc218 \uc788\ub3c4\ub85d \ub3d5\ub294 \ucd94\uac00 \uc815\ubcf4 \uc81c\uacf5 \ubc29\uc548\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud5c8\uc704\u00b7\uc545\uc131 \ud3c9\uac00\ub97c \uac78\ub7ec\ub0b4\ub294 \uc81c\uc5b4 \uae30\uc220\uc744 \ubcf4\uc644\ud558\uace0 \ud3c9\uac00 \uc791\uc131\uc790\uc758 \uc790\uaca9 \uc870\uac74\uc744 \uba85\ud655\ud788 \ud55c\ub2e4.",
          "rationale": "\uc784\uc758 \uc0ad\uc81c\uac00 \ubd88\uac00\ub2a5\ud55c \ubc95\uc801 \ud55c\uacc4 \ub0b4\uc5d0\uc11c \uae30\uc220\uc801 \uc81c\uc5b4\uc640 \uc791\uc131 \uc790\uaca9 \uc694\uac74 \uac15\ud654\ub77c\ub294 \uac1c\uc120\ucc45\uc744 \uc81c\uc2dc\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubb38\uc81c \uc788\ub294 \ubcc4\uc810 \ud3c9\uac00\ub098 \ub313\uae00\uc774\ub77c \ud558\ub354\ub77c\ub3c4 \ubc95\ub839\uc0c1 \uc5b4\ub5a4 \uad8c\ub9ac\uac00 \uc801\uc6a9\ub418\uc5b4 \uc784\uc758 \uc870\uce58\uac00 \ubd88\uac00\ub2a5\ud55c\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38\uc5d0 \uc81c\uc2dc\ub41c 2022\ub144 \uc18c\uc0c1\uacf5\uc778\uc2dc\uc7a5\uc9c4\ud765\uacf5\ub2e8\uc758 \uc870\uc0ac \uacb0\uacfc\ub97c \ud1b5\ud574 \uc54c \uc218 \uc788\ub294 \uc0ac\uc2e4\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ubc30\ub2ec \ud50c\ub7ab\ud3fc \uc0ac\uc6a9 \uc18c\uc0c1\uacf5\uc778 \uc0ac\uc5c5\uccb4\uc758 78%\uac00 \ubcc4\uc810 \uc81c\ub3c4 \uad00\ub828 \ud53c\ud574 \uacbd\ud5d8\uc774 \uc788\ub2e4.",
          "rationale": "\uc870\uc0ac \uacb0\uacfc \uc18c\uc0c1\uacf5\uc778 \uc0ac\uc5c5\uccb4 300\uac1c \uc911 78%\uac00 \uc545\uc6a9\ub41c \ubcc4\uc810 \uc81c\ub3c4\ub85c \uc778\ud574 \ud53c\ud574\ub97c \uc785\uc5c8\ub2e4\uace0 \uc751\ub2f5\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc870\uc0ac \ub300\uc0c1 \uc18c\uc0c1\uacf5\uc778\uc758 90%\uac00 \ubcc4\uc810 \uc81c\ub3c4\ub85c \uc778\ud574 \ub9e4\ucd9c \uc99d\ub300 \ud6a8\uacfc\ub97c \ubcf4\uc558\ub2e4.",
          "rationale": "\ubcf8\ubb38\uc758 \uc870\uc0ac \uc790\ub8cc\ub294 \ubcc4\uc810 \uc81c\ub3c4\uac00 \uc790\uce6b \uc545\uc6a9\ub420 \ub54c \uc18c\uc0c1\uacf5\uc778\uc5d0\uac8c \uac00\ud574\uc9c0\ub294 \ud53c\ud574 \uc2e4\ud0dc\ub97c \ub098\ud0c0\ub0c5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc18c\uc0c1\uacf5\uc778 \uc911 1%\ub9cc\uc774 \ubcc4\uc810 \uc81c\ub3c4\ub97c \ud1b5\ud574 \ub9c8\ucf00\ud305 \uc804\ub7b5\uc744 \uc218\ub9bd\ud558\uace0 \uc788\ub2e4.",
          "rationale": "1%\ub77c\ub294 \uc218\uce58\ub294 SNS \uc774\uc6a9\uc790 \uc911 \ucf58\ud150\uce20\ub97c \uc9c1\uc811 \uc0dd\uc0b0\ud558\ub294 \uc0ac\ub78c\uc758 \ube44\uc728\uc744 \ube44\uc720\ud55c \uc218\uce58\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubc30\ub2ec \ud50c\ub7ab\ud3fc \uc0ac\uc5c5\uccb4\uc758 78%\uac00 \uc545\uc131 \ubcc4\uc810 \ud3c9\uac00\ub97c \uc784\uc758 \uc0ad\uc81c\ud55c \uc801\uc774 \uc788\ub2e4.",
          "rationale": "\ud574\ub2f9 \ud1b5\uacc4\ub294 \ubc30\ub2ec \ud50c\ub7ab\ud3fc\uc744 \uc774\uc6a9\ud558\ub294 \uc18c\uc0c1\uacf5\uc778\uc744 \ub300\uc0c1\uc73c\ub85c \ud55c \ud53c\ud574 \uacbd\ud5d8 \uc2e4\ud0dc \uc870\uc0ac\uc785\ub2c8\ub2e4.",
          "isCorrect": false
