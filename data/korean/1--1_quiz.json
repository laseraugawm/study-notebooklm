      "hint": "\ubc30\ub2ec \ud50c\ub7ab\ud3fc \uc774\uc6a9 \uc18c\uc0c1\uacf5\uc778 300\uac1c\ub97c \ub300\uc0c1\uc73c\ub85c \uc2e4\uc2dc\ud55c \uc2e4\ud0dc \uc870\uc0ac \ud1b5\uacc4 \uc218\uce58\ub97c \ubcf8\ubb38\uc5d0\uc11c \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38\uc5d0\uc11c SNS \uc774\uc6a9\uc790 \uc18d\uc131\uc744 \uc124\uba85\ud55c \ube44\uc720('1% \uc0dd\uc0b0\uc790, 9% \uacf5\uc720\uc790, 90% \uad00\ub9dd\uc790')\uac00 \uc2dc\uc0ac\ud558\ub294 \ubcc4\uc810 \uc81c\ub3c4\uc758 \ubb38\uc81c\uc810\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ubcc4\uc810 \ud3c9\uac00\uac00 \uc804\uccb4 \uc774\uc6a9\uc790\uc758 \uac1d\uad00\uc801 \ud3c9\uac00\uac00 \uc544\ub2cc \uc801\uadf9\uc801\uc778 \uc77c\ubd80(10%)\uc758 \uc758\uacac\uc5d0 \ud3b8\ud5a5\ub420 \uc218 \uc788\ub2e4.",
          "rationale": "\uad00\ub9dd\ud558\ub294 90%\ub97c \uc81c\uc678\ud558\uace0, \uae00\uc744 \uc62c\ub9ac\uac70\ub098 \uc801\uadf9\uc801\uc73c\ub85c \uc804\ub2ec\ud558\ub294 \uc0c1\uc704 10%\uc758 \uc758\uacac\ub9cc \ubc18\uc601\ub420 \uc218 \uc788\uc74c\uc744 \uc9c0\uc801\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc774\uc6a9\uc790\uc758 90%\uac00 \ubb34\uc791\uc704 \ud45c\ubcf8\uc73c\ub85c \uc120\ucd9c\ub418\uc5b4 \ud1b5\uacc4\uc801 \uc2e0\ub8b0\uc131\uc744 \uc800\ud574\ud55c\ub2e4.",
          "rationale": "90%\uc758 \uc774\uc6a9\uc790\ub294 \ud55c\ubc1c \ub4a4\uc5d0\uc11c \ubc14\ub77c\ubcf4\ub294 \uad00\ub9dd\uc790\uc5d0 \ubd88\uacfc\ud558\uba70, \ud3c9\uac00\uc790 \uc790\uccb4\uac00 \ubb34\uc791\uc704 \ud45c\ubcf8\uc774 \uc544\ub2c8\ub77c\ub294 \uc810\uc774 \ud575\uc2ec\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "1%\uc758 \uc0dd\uc0b0\uc790\ub9cc\uc774 \uc815\uc0c1 \ubd84\ud3ec \uace1\uc120\uc744 \uc774\ud574\ud558\uace0 \uc815\ud655\ud55c \ubcc4\uc810\uc744 \ubd80\uc5ec\ud55c\ub2e4.",
          "rationale": "1% \uc0dd\uc0b0\uc790\ub294 \ub2e8\uc21c\ud788 \ucf58\ud150\uce20\ub098 \ud3c9\uac00\ub97c \uc9c1\uc811 \uc791\uc131\ud558\ub294 \uc801\uadf9\uc801 \uc18c\uc218\ub97c \uac00\ub9ac\ud0ac \ubfd0\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "9%\uc758 \uacf5\uc720\uc790\uac00 \uc791\uc131\ud558\ub294 \ud5c8\uc704 \ub274\uc2a4\uc5d0 \uc758\ud574 \uc18c\uc0c1\uacf5\uc778\uc758 \ud53c\ud574\uac00 \uadf9\ub300\ud654\ub41c\ub2e4.",
          "rationale": "9%\ub294 \uc5f4\uc131\uc801\uc73c\ub85c \uc18c\uc2dd\uc744 \uacf5\uc720\ud558\ub294 \uadf8\ub8f9\uc744 \uac00\ub9ac\ud0a4\uba70 \ud5c8\uc704 \ub274\uc2a4 \uc791\uc131\uc790\ub9cc\uc744 \ub73b\ud558\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc801\uadf9\uc801\uc73c\ub85c \uc218\uce58\uc640 \ud3c9\uac00\ub97c \ub0a8\uae30\ub294 \uc0c1\uc704 10%\uc758 \uadf8\ub8f9\uc774 '\uc804\uccb4 \ub300\ud45c\uc131' \ubb38\uc81c\uc640 \uc5b4\ub5bb\uac8c \uc5f0\uacb0\ub418\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcc4\uc810 \uc81c\ub3c4\uc758 \uadfc\ubcf8\uc801\uc778 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uae00\uc4f4\uc774\uac00 \ucd5c\uc885\uc801\uc73c\ub85c \ubaa8\ub4e0 \uc774\uc6a9\uc790\uc5d0\uac8c \uac15\uc870\ud558\ub294 \ud0dc\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc7a5\ub09c\uc774\ub098 \uac10\uc815\uc5d0 \uce58\uc6b0\uce58\uc9c0 \uc54a\uace0 \uc9c4\uc194\ud55c \ud0dc\ub3c4\ub85c \ubcc4\uc810 \ud3c9\uac00\uc5d0 \uc784\ud558\ub294 \uc790\uc138",
          "rationale": "\uae00\uc4f4\uc774\ub294 \uae30\uc220\uc801\u00b7\uc81c\ub3c4\uc801 \uc7a5\uce58\ub3c4 \ud544\uc694\ud558\uc9c0\ub9cc \uc774\uc6a9\uc790 \uc2a4\uc2a4\ub85c\uac00 \uc9c4\uc194\ud55c \ud0dc\ub3c4\ub85c \ud3c9\uac00\ud558\ub294 \uac83\uc774 \uadfc\ubcf8\uc801 \ud574\uacb0\ucc45\uc774\ub77c\uace0 \ub9d0\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc18c\uc0c1\uacf5\uc778\uc744 \uace0\ub824\ud558\uc5ec \uc774\uc6a9 \ud6c4\uc5d0\ub294 \ubb34\uc870\uac74 5\uc810 \ub9cc\uc810\uc744 \ubd80\uc5ec\ud558\ub294 \ud0dc\ub3c4",
          "rationale": "\uc194\uc9c1\ud558\uc9c0 \uc54a\uc740 \ubb34\uc870\uac74\uc801\uc778 \uace0\ub4dd\uc810 \ubd80\uc5ec\ub294 \uc62c\ubc14\ub978 \uc9d1\ub2e8 \uc9c0\uc131 \ud615\uc131\uc744 \ubc29\ud574\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud0c0\uc778\uc758 \ud3c9\uc810\uc744 \ucc38\uace0\ud558\uc9c0 \uc54a\uace0 \uac1c\uc778\uc758 \uc8fc\uad00\uc801 \uac10\uc815\ub9cc\uc744 \uadf9\ub300\ud654\ud558\uc5ec \ud45c\ud604\ud558\ub294 \ud0dc\ub3c4",
          "rationale": "\uac10\uc815\uc801\uc778 \ud3c9\uc810 \ubd80\uc5ec\ub294 \ud310\ub9e4\uc790\uc640 \ud0c0 \uc774\uc6a9\uc790\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\ub294 \uc8fc\uc694 \uc6d0\uc778 \uc911 \ud558\ub098\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubcc4\uc810 \uc2dc\uc2a4\ud15c\uc758 \uacb0\ud568\uc774 \uc644\uc804\ud788 \uc644\ube44\ub420 \ub54c\uae4c\uc9c0 \ud3c9\uac00 \uc791\uc131\uc744 \uc804\uba74 \uac70\ubd80\ud558\ub294 \ud0dc\ub3c4",
          "rationale": "\uae00\uc4f4\uc774\ub294 \ubcc4\uc810 \uc81c\ub3c4\ub97c \uc18c\ud1b5\uc758 \uc990\uac70\uc6c0\uc744 \uc8fc\ub294 \ubb38\ud654\ub85c \uc778\uc815\ud558\uba70 \uc62c\ubc14\ub978 \uc774\uc6a9 \ucc38\uc5ec\ub97c \ub3c5\ub824\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uae00\uc758 \ub9e8 \ub9c8\uc9c0\ub9c9 \ub2e8\ub77d\uc5d0\uc11c \uae30\uc220 \uac1c\ubc1c\uc774\ub098 \uc81c\ub3c4 \ub9c8\ub828\ubcf4\ub2e4 \ub354\uc6b1 \uadfc\ubcf8\uc801\uc778 \ud574\uacb0\ucc45\uc73c\ub85c \uc5b8\uae09\ub41c \uc774\uc6a9\uc790\uc758 \uc790\uc138\ub97c \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "\ud559\uc2b5 \ud65c\ub3d9\uc5d0 \uc81c\uc2dc\ub41c '\uce74\ub4dc \ub274\uc2a4 \uc81c\uc791 \uacfc\uc815'\uc758 \uc62c\ubc14\ub978 \uc21c\uc11c\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc8fc\uc81c\uc640 \ubaa9\uc801 \uc120\uc815\ud558\uae30 \u2192 \uc218\uc6a9\uc790\uc640 \ub9e4\uccb4 \ud2b9\uc131 \ubd84\uc11d\ud558\uae30 \u2192 \ub0b4\uc6a9 \ub9c8\ub828 \ubc0f \uad6c\uc131\ud558\uae30 \u2192 \uce74\ub4dc \ub274\uc2a4 \uc81c\uc791 \ubc0f \uacf5\uc720\ud558\uae30",
          "rationale": "\uce74\ub4dc \ub274\uc2a4\ub294 \uc8fc\uc81c/\ubaa9\uc801 \uc120\uc815\uc744 \uc2dc\uc791\uc73c\ub85c \uc218\uc6a9\uc790\u00b7\ub9e4\uccb4 \ubd84\uc11d, \ub0b4\uc6a9 \ub9c8\ub828\u00b7\uad6c\uc131, \ucd5c\uc885 \uc81c\uc791\u00b7\uacf5\uc720\uc758 \ub2e8\uacc4\ub85c \uc9c4\ud589\ub429\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc218\uc6a9\uc790\uc640 \ub9e4\uccb4 \ud2b9\uc131 \ubd84\uc11d\ud558\uae30 \u2192 \uc8fc\uc81c\uc640 \ubaa9\uc801 \uc120\uc815\ud558\uae30 \u2192 \ub0b4\uc6a9 \ub9c8\ub828 \ubc0f \uad6c\uc131\ud558\uae30 \u2192 \uce74\ub4dc \ub274\uc2a4 \uc81c\uc791 \ubc0f \uacf5\uc720\ud558\uae30",
          "rationale": "\uc81c\uc791\ud560 \ub274\uc2a4\uc758 \uc8fc\uc81c\uc640 \ubaa9\uc801\uc744 \uba85\ud655\ud788 \uc124\uc815\ud558\ub294 \uac83\uc774 \ubd84\uc11d \ub2e8\uacc4\ubcf4\ub2e4 \uc6b0\uc120\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc8fc\uc81c\uc640 \ubaa9\uc801 \uc120\uc815\ud558\uae30 \u2192 \ub0b4\uc6a9 \ub9c8\ub828 \ubc0f \uad6c\uc131\ud558\uae30 \u2192 \uc218\uc6a9\uc790\uc640 \ub9e4\uccb4 \ud2b9\uc131 \ubd84\uc11d\ud558\uae30 \u2192 \uce74\ub4dc \ub274\uc2a4 \uc81c\uc791 \ubc0f \uacf5\uc720\ud558\uae30",
          "rationale": "\ub0b4\uc6a9\uc744 \uae30\ud68d\ud558\uace0 \uad6c\uc131\ud558\uae30\uc5d0 \uc55e\uc11c \ub300\uc911(\uc218\uc6a9\uc790)\uacfc \ud50c\ub7ab\ud3fc(\ub9e4\uccb4)\uc758 \ud2b9\uc131\uc744 \uba3c\uc800 \ud30c\uc545\ud574\uc57c \ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub0b4\uc6a9 \ub9c8\ub828 \ubc0f \uad6c\uc131\ud558\uae30 \u2192 \uc8fc\uc81c\uc640 \ubaa9\uc801 \uc120\uc815\ud558\uae30 \u2192 \uc218\uc6a9\uc790\uc640 \ub9e4\uccb4 \ud2b9\uc131 \ubd84\uc11d\ud558\uae30 \u2192 \uce74\ub4dc \ub274\uc2a4 \uc81c\uc791 \ubc0f \uacf5\uc720\ud558\uae30",
          "rationale": "\ub0b4\uc6a9 \ub9c8\ub828 \ubc0f \uad6c\uc131\uc740 \ubaa9\uc801 \uc124\uc815\uacfc \ud0c0\uae43/\ub9e4\uccb4 \ubd84\uc11d\uc774 \ub05d\ub09c \ud6c4 \uc9c4\ud589\ub418\ub294 3\ub2e8\uacc4 \uacfc\uc815\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc804\ub2ec\ud558\ub824\ub294 \ud575\uc2ec \uc8fc\uc81c\ub97c \uc815\ud55c \ub4a4, \ub204\uad6c\uc5d0\uac8c \uc5b4\ub5a4 \ub9e4\uccb4\ub85c \uc804\ub2ec\ud560\uc9c0 \ubd84\uc11d\ud558\ub294 \uc21c\uc11c\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    }
  ]
