    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub450\uc6b4 \uc6b4\ub3d9\uc7a5\uc5d0\uc11c \ucc44\uc601\uc774 \ud0a4\uc5d0 \ub9de\uc9c0 \uc54a\ub294 \ub192\uc740 \ub18d\uad6c\ub300\uc5d0 \uacf5\uc744 \ub358\uc9c8 \ub54c \uc5f0\uc6b0\uac00 \ud55c \ud589\ub3d9\uc740?"
