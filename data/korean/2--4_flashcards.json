    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc6b0\uac00 \ucc44\uc601\uc744 \ub4e4\uc5b4 \uc62c\ub9ac\ub294 \uc21c\uac04 \ub290\ub080 \uac10\uc815\uc740 \uc5b4\ub5a0\ud558\uc600\ub294\uac00?"
