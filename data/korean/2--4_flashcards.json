    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc6b0\ub294 \uc804 \uc8fc\uc778\uc774 \uadf8\ub9b0 \uc0c8 \uadf8\ub9bc\uc5d0 \uc0ac\ube44 \uc5f0\ud544\ub85c \ubb34\uc5c7\uc744 \ub367\uadf8\ub824 \uc5b4\ub5a4 \uc0c1\uc0c1\uc758 \uc874\uc7ac\ub97c \uc644\uc131\ud558\ub824 \ud558\ub294\uac00?"
