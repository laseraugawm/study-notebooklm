    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ud0e0\ub4dc\uc5d0 \uc549\uc544 \ubc24\ud558\ub298\uc758 \ube5b\uc744 \ubcf4\uba70 \uc5f0\uc6b0\uc640 \ucc44\uc601\uc774 \ud655\uc778\ud55c \uc815\uccb4\ub294 \ubb34\uc5c7\uc778\uac00?"
