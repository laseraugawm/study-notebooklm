    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc44\uc601\uc774 \ubc84\ub9bc\ubc1b\ub294 \uafc8\uc774\ub098 \uc785\uc591\uc544 \uc774\uc57c\uae30\ub97c \ub5a0\uc62c\ub9ac\uba70 \uacf5\ud3ec\ub97c \ub290\ub07c\ub294 \uadfc\ubcf8\uc801\uc778 \uc774\uc720\ub294?"
