      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc44\uc601\uc758 \ubb34\uac8c\uc640 \ud615\uccb4\uac00 \uc5f0\uc6b0 \uc790\uc2e0\uc744 \ub108\ubb34\ub098 \uac15\ud558\uac8c \ub9cc\ub4e0\ub2e4\uace0 \ub290\uaf08\uc73c\uba70, \uc228\uc774 \ub9c9\ud790 \ub4ef\ud55c \uc124\ub818\uacfc \uac10\ub3d9\uc744 \ub290\uaf08\ub2e4."
