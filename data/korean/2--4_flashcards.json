      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac70\uc6b8\uc744 \ubc14\ub77c\ubcf4\uc558\uc744 \ub54c \uc790\uc2e0\uc758 \uc5b4\uae68 \ub4a4\ub85c \ub0a0\uac1c\uac00 \ud3bc\uccd0\uc9c4 \ubaa8\uc2b5\uc744 \ube44\ucd94\uc5b4 \ubcf4\uae30 \uc704\ud574\uc11c\uc774\ub2e4."
