      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a0\uac1c\ub97c \ub354 \ud06c\uac8c \uadf8\ub9ac\uace0 \uc0ac\uc790\uc758 \uaf2c\ub9ac\ub97c \ubd99\uc5ec '\uadf8\ub9ac\ud540'\uc744 \uc644\uc131\ud558\ub824 \ud55c\ub2e4."
