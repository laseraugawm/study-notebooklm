        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4f1 \ub4a4\uc5d0\uc11c \ucc44\uc601\uc758 \ud5c8\ub9ac\ub97c \ubd99\uc7a1\uc544 \uc548\uace0 \ud798\uaecf \uc704\ub85c \ub4e4\uc5b4 \uc62c\ub824 \uc29b\uc744 \uace8\uc778\uc2dc\ucf30\ub2e4."
