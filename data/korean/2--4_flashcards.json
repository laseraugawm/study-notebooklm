    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804 \uc8fc\uc778\uc774 \uad73\uc774 \ubd88\ud3b8\ud55c \uc790\uc138\ub85c \uac70\uc6b8 \ub9de\uc740\ud3b8 \ubcbd\uc5d0 \ub099\uc11c\ub97c \uadf8\ub824 \ub193\uc740 \uc758\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00?"
