    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc6b0\uc5d0\uac8c '\ub098\uc758 \uadf8\ub9ac\ud540'\uc744 \uc644\uc131\ud558\uace0 \ub0a0\uc544\uc624\ub974\ub294 \uc0c1\uc0c1\uc740 \uc5b4\ub5a4 \uc0c1\uc9d5\uc801 \uc758\ubbf8\ub97c \uac00\uc9c0\ub294\uac00?"
