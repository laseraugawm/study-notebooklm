        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae4c\uce58\ubc1c\ub85c \uc130\uc744 \ub54c \uba38\ub9ac/\uc5b4\uae68 \ub4a4\uc5d0\uc11c \uc0c8\uac00 \ub0a0\uac1c\ub97c \ud65c\uc9dd \ud3bc\uce58\uace0 \ub0a0\uc544\uc624\ub974\ub294 \ub4ef\ud55c \ubaa8\uc2b5"
