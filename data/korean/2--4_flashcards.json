      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\ubaa8\uc758 \uae30\ub300\ub098 \uae30\uc900\uc5d0 \ubd80\uc751\ud558\uc9c0 \ubabb\ud574 \uc0ac\ub791\ubc1b\uc9c0 \ubabb\ud558\uace0 \ubc84\ub824\uc9c8\uc9c0 \ubaa8\ub978\ub2e4\ub294 \ubd88\uc548\uac10 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc44\uc601\uc774 \uc5f0\uc6b0\uc5d0\uac8c \"\ub108\ud558\uace0\ub77c\uba74 \uba40\ub9ac\uae4c\uc9c0 \uac00\ub3c4 \ub420 \uac83 \uac19\ub2e4\"\uace0 \ub9d0\ud558\uba70 \uc5f0\uc6b0\ub97c \uc2e0\ub8b0\ud558\uac8c \ub41c \uae4c\ub2ed\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc6b0\ub294 \uc790\uc2e0\uc5d0\uac8c \uc5b4\ub5a0\ud55c \uc870\uac74\uc774\ub098 \uae30\uc900\uc744 \uc694\uad6c\ud558\uc9c0 \uc54a\uace0, \uc788\ub294 \uadf8\ub300\ub85c\uc758 \uc790\uc2e0\uc744 \ubc1b\uc544 \uc8fc\ub294 '\uc88b\uc740 \uc0ac\ub78c'\uc774\ub77c\uace0 \ubbff\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc44\uc601\uc774 \ub9d0\ud55c \"\uc774\ub7f0 \uc0ac\ub78c\uc774 \ub418\uc5b4\uc57c \ud55c\ub2e4\ub294 \uac83\"\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd80\ubaa8\ub098 \uc0ac\ud68c \ub4f1 \ud0c0\uc778\uc774 \uc694\uad6c\ud558\ub294 \uac00\uce58\uad00, \uc131\ucde8 \uae30\uc900, \uaddc\ubc94\uc801\uc778 \uc778\uac04\uc0c1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\"\ub300\uc2e0 \ub09c \uc5b4\ub978\uc774 \ub3fc\uc57c \ud574\"\ub77c\ub294 \uc5f0\uc6b0\uc758 \ub9d0\uc5d0 \ub2f4\uae34 \uace0\ubbfc\uc758 \ubcf8\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc55e\uc73c\ub85c \ubb34\uc5c7\uc744 \ud574\uc57c \ud560\uc9c0 \ubaa9\ud45c\ub97c \uc815\ud558\uc9c0 \ubabb\ud588\uc73c\ub098, \uc2dc\uac04\uc774 \ud750\ub984\uc5d0 \ub530\ub77c \uc5b4\ub978\uc774 \ub418\uc5b4\uc57c \ud55c\ub2e4\ub294 \ubb34\uac70\uc6b4 \ucc45\uc784\uac10\uc744 \ub290\ub07c\ub294 \uc0c1\ud669"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc44\uc601\uc774 \"\ub09c \uc5b4\ub978\uc774 \ub418\uace0 \uc2f6\uc9c0 \uc54a\uc544\"\ub77c\uace0 \ub9d0\ud558\uba70 \ud76c\ub9dd\ud55c \uc774\uc0c1\uc801\uc778 \uc7a5\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uac04\uc774 \uba48\ucd94\uc5b4 \uc5b4\ub978\ub4e4\uc758 \ucc45\uc784\uc774\ub098 \ud3c9\uac00\ub97c \ubc1b\uc9c0 \uc54a\ub294 \uc7a5\uc18c (\ub0a0\uc9dc \ubcc0\uacbd\uc120\uc744 \uc9c0\ud0a4\ub294 \uc6b0\uc8fc \uc815\uac70\uc7a5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc6b0\uac00 \uc81c\uc548\ud55c '\ub0a0\uc9dc \ubcc0\uacbd\uc120\uc744 \uc9c0\ud0a4\uba70 \uc2dc\uac04\uc744 \uc9c0\ud0a4\ub294 \uc77c'\uc758 \uc0c1\uc9d5\uc801 \uc758\ubbf8\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uac04\uc758 \ud750\ub984\uacfc \uc0ac\ud68c\uc801 \uc694\uad6c\uc5d0 \ucad3\uae30\uc9c0 \uc54a\uace0 \uccad\uc18c\ub144\uae30\uc758 \uc21c\uc218\ud568\uacfc \uc790\uc544\ub97c \uc9c0\ud0a4\ub824\ub294 \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc6b0\uc640 \ucc44\uc601\uc774 \uac00\uace0 \uc2f6\ub2e4\uace0 \ud55c '\uc138\uc0c1 \ub05d\uc5d0 \uc788\ub294 \uc6b0\uc8fc \uc815\uac70\uc7a5'\uc758 \uc0c1\uc9d5\uc801 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc778\uc758 \uc2dc\uc120\uc774\ub098 \uae30\uc900\uc5d0\uc11c \ubc97\uc5b4\ub098 \uc790\uc2e0 \uace0\uc720\uc758 \ubaa8\uc2b5\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\ub294 \uc790\uc720\ub86d\uace0 \uc774\uc0c1\uc801\uc778 \uacf5\uac04"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc6b0\uac00 \ucc44\uc601\uc5d0\uac8c \ub7a9\uc744 \ud558\ub4ef \ub9ac\ub4ec\uc744 \uc2e4\uc5b4 \uc678\uce5c '\uacb0\ub860'\uc758 \uac00\uc0ac \ud575\uc2ec \uad6c\uc808\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\"\ub808\uce20 \uace0 \uc2a4\ud398\uc774\uc2a4(Let's go space)!\""
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc6b0\uac00 \ubd80\ub978 \ube44\uc0c1\uc758 \ub178\ub798 \"\ub808\uce20 \uace0 \uc2a4\ud398\uc774\uc2a4(Let's go space)\"\uc5d0 \ub2f4\uae34 \uc758\ubbf8\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b5\uc555\uc801\uc778 \ud604\uc2e4\uacfc \ubd88\uc548\uc744 \uadf9\ubcf5\ud558\uace0, \uc790\uc2e0\ub9cc\uc758 \uc774\uc0c1\uacfc \uc790\uc720\ub97c \ucc3e\uc544 \ube44\uc0c1\ud558\uace0\uc790 \ud558\ub294 \uc8fc\uccb4\uc801 \uc758\uc9c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uc124 \uacb0\ub9d0 \ubd80\ubd84\uc5d0\uc11c \ub450 \uc0ac\ub78c\uc774 \uc190\uc744 \uc7a1\uace0 \uac78\uc5b4 \ub098\uac08 \ub54c \ubd88\uc5b4\uc624\ub294 '\ubc14\ub78c'\uc758 \uc5ed\ud560\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c8\ub85c\uc6b4 \uc138\uacc4\uc640 \uc131\uc7a5\uc73c\ub85c \ub098\uc544\uac00\ub294 \ub450 \uc18c\ub144\u00b7\uc18c\ub140\uc758 \ub9c8\uc74c\uc744 \ubd80\ud480\ub9ac\uace0 \ubcc0\ud654\ub97c \uc720\ub3c4\ud558\ub294 \uc5ed\ub3d9\uc801 \ubc30\uacbd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0(G)-\uadf8\ub9ac\ud540\uc758 \uc74c\uc545\uc774 \uc5f0\uc6b0\uc5d0\uac8c \uc81c\uacf5\ud558\ub294 \uae30\ub2a5\uacfc \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc74c\uc18d \uace0\ub3c5\uacfc \ubd88\uc548\uc744 \uc704\ub85c\ud574 \uc8fc\uace0, \uc790\uc2e0\ub9cc\uc758 \uafc8\uacfc \uc774\uc0c1\uc744 \ud5a5\ud574 \ub098\uc544\uac08 \uc218 \uc788\ub3c4\ub85d \uc790\uadf9\ud558\ub294 \ub9e4\uac1c\uccb4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc6b0\uc640 \ucc44\uc601\uc774 \ub098\ub204\ub294 \ub300\ud654\ub97c \ud1b5\ud574 \ud655\uc778\ud560 \uc218 \uc788\ub294 \ub450 \uc0ac\ub78c\uc758 \uc0c1\ud638\uc801\uc778 \uad00\uacc4 \ud0dc\ub3c4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\ub85c\uc758 \ubd88\uc548\uacfc \uc678\ub85c\uc6c0\uc744 \uc788\ub294 \uadf8\ub300\ub85c \uc774\ud574\ud558\uace0 \ubcf4\ub4ec\uc5b4 \uc8fc\uba70, \uae4a\uc740 \uc2e0\ub8b0\ub97c \ubc14\ud0d5\uc73c\ub85c \uacf5\uac10\ud558\ub294 \uad00\uacc4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\uac00 \uc778\ud130\ubdf0\uc5d0 \ub530\ub974\uba74 \uc774 \uc18c\uc124\uc774 \uc804\ub2ec\ud558\ub824\ub294 \ud575\uc2ec \uba54\uc2dc\uc9c0(\"\ub098\ub294 \ub098\ub2e4\")\ub294 \uc5b4\ub5a4 \uc0b6\uc758 \uc790\uc138\ub97c \ubcf4\uc5ec \uc8fc\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc778\uc758 \uae30\uc900\uc774\ub098 \uc0ac\ud68c\uc801 \uc131\ucde8\uc5d0 \uc5bd\ub9e4\uc774\uc9c0 \uc54a\uace0, \ubd88\uc644\uc804\ud55c \uc790\uc2e0 \uace0\uc720\uc758 \ubaa8\uc2b5\uc744 \uc778\uc815\ud558\uace0 \uae68\ub2ec\uc544 \uac00\ub294 \uc0b6"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uc124 \u300c\uc18c\ub144\uc744 \uc704\ub85c\ud574 \uc918\u300d\uac00 \uc778\ud130\ub137 \uce74\ud398 \uc5f0\uc7ac\ub77c\ub294 \ub9e4\uccb4\ub97c \ud65c\uc6a9\ud568\uc73c\ub85c\uc368 \uc5bb\uc740 \ubb38\ud559\uc801 \ud6a8\uacfc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\uc77c \uc774\uc5b4\uc9c0\ub294 \uc5c5\ub370\uc774\ud2b8\uc640 \ub313\uae00 \uc18c\ud1b5\uc744 \ud1b5\ud574 \uc791\uac00\uc640 \ub3c5\uc790\uac00 \uc30d\ubc29\ud5a5\uc73c\ub85c \uc2e0\uc18d\ud558\uace0 \uc801\uadf9\uc801\uc73c\ub85c \uc18c\ud1b5\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\ud45c \uacc4\ud68d\uc744 \uc138\uc6b8 \ub54c '\uccad\uc911 \ubd84\uc11d'\uc5d0\uc11c \uc870\uc0ac\ud558\uace0 \uace0\ub824\ud574\uc57c \ud558\ub294 \uc8fc\uc694 \uc694\uc18c 4\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub839\ub300, \uc8fc\uc81c\uc5d0 \ub300\ud55c \uad00\uc2ec \uc815\ub3c4, \ubc30\uacbd\uc9c0\uc2dd \ubc0f \uc9c0\uc801 \uc218\uc900, \uc8fc\uc81c\uc5d0 \ub300\ud55c \ud0dc\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\ud45c \ub0b4\uc6a9\uc744 \uc870\uc9c1\ud560 \ub54c \uac70\uce58\ub294 \uae30\ubcf8 3\ub2e8\uacc4 \uad6c\uc870\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c4\uc785\ubd80 - \uc804\uac1c\ubd80 - \uc815\ub9ac\ubd80"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b8\uc5b4\uc801 \ud45c\ud604\uc5d0 \uacb0\ud569\ud558\uc5ec \uc758\ubbf8 \uc804\ub2ec\uc744 \ub3d5\ub294 '\uc900\uc5b8\uc5b4\uc801 \ud45c\ud604'\uc758 \ub300\ud45c\uc801 \uc608\uc2dc \uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa9\uc18c\ub9ac\uc758 \ud06c\uae30, \ub192\ub0ae\uc774, \ub9d0\uc758 \uc18d\ub3c4, \uc5b4\uc870, \uc5b5\uc591"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b8\uc5b4\uc640 \ub3c5\ub9bd\ub418\uc5b4 \uc758\ubbf8\ub97c \uc804\ub2ec\ud558\ub294 '\ube44\uc5b8\uc5b4\uc801 \ud45c\ud604'\uc758 \ub300\ud45c\uc801 \uc608\uc2dc \uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubab8\uc9d3, \uc190\ub3d9\uc791, \uc790\uc138, \ud45c\uc815, \uc2dc\uc120, \uc637\ucc28\ub9bc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\ud45c\uc5d0\uc11c \uc9c8\uc758\uc751\ub2f5 \uc2dc\uac04\uc744 \ucda9\ubd84\ud788 \ud655\ubcf4\ud558\ub294 \uac83\uc774 \uccad\uc911\uacfc\uc758 \uc18c\ud1b5\uc5d0 \uc8fc\ub294 \uc774\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccad\uc911\uc758 \uad81\uae08\uc99d\uc744 \ud574\uc18c\ud558\uace0 \ubc1c\ud45c \ub0b4\uc6a9 \ubc0f \uc8fc\uc81c\uc5d0 \ub300\ud55c \uc774\ud574\ub97c \uae4a\uc774 \uc788\uac8c \uc2ec\ud654\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5a5\uac00 \u300c\uc81c\ub9dd\ub9e4\uac00\u300d\uc758 \ud575\uc2ec \uc8fc\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fd\uc740 \ub204\uc774\uc5d0 \ub300\ud55c \uc560\ub3c4\uc640 \uc885\uad50\uc801(\ubd88\uad50\uc801) \uadf9\ubcf5 \uc758\uc9c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dc\uc870 \u300c\uc2ed \ub144\uc744 \uacbd\uc601\ud558\uc57c\u300d\uc758 \ud575\uc2ec \uc8fc\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0\uce5c\ud654 \ubc0f \uc548\ube48\ub099\ub3c4(\uc548\uad6c\uc9c0\uc871)\uc758 \uc0b6"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc124\uc2dc\uc870 \u300c\ub450\ud130\ube44 \ud30c\ub9ac\ub97c \ubb3c\uace0\u300d\uc5d0\uc11c \ud76c\ud654\ud654\ud558\uc5ec \ube44\ud310\u00b7\ud48d\uc790\ud558\ub294 \ub300\uc0c1\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc57d\uc790\uc5d0\uac8c \uac15\ud558\uace0 \uac15\uc790\uc5d0\uac8c \uc57d\ud55c \ud0d0\uad00\uc624\ub9ac(\uc591\ubc18 \uc9c0\ubc30\uce35)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc804 \uc18c\uc124 \u300c\uad6c\uc6b4\ubabd\u300d\uc5d0\uc11c \uc8fc\uc778\uacf5 \uc131\uc9c4\uc774 \uafc8\uc18d\uc5d0\uc11c \uc785\uc2e0\uc591\uba85\ud55c \uc778\ubb3c\uc758 \uc774\ub984\uacfc \uae68\ub2ec\uc740 \uc8fc\uc81c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uafc8\uc18d \uc774\ub984: \uc591\uc18c\uc720 / \uae68\ub2ec\uc740 \ubc14: \ubd80\uadc0\uacf5\uba85\uc758 \ubd80\uc9c8\uc5c6\uc74c(\uc778\uc0dd\ubb34\uc0c1)\uacfc \ubd88\uad50\uc801 \ub3c4\uc758 \uae68\uc6b0\uce68"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc724\ub3d9\uc8fc\uc758 \ud604\ub300\uc2dc \u300c\uc790\ud654\uc0c1\u300d\uc5d0\uc11c \ud654\uc790\uac00 \uc790\uc544\ub97c \uc131\ucc30\ud558\ub294 \ub9e4\uac1c\uccb4\uc640, \uc2dc\uc801 \ud654\uc790\uc758 \uc2ec\ub9ac \ubcc0\ud654 4\ub2e8\uacc4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc131\ucc30 \ub9e4\uac1c\uccb4: \uc6b0\ubb3c / \uc2ec\ub9ac \ubcc0\ud654: \ubbf8\uc6c0 \u2192 \uc5f0\ubbfc \u2192 \ubbf8\uc6c0 \u2192 \uadf8\ub9ac\uc6c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \uc18c\uc124 \uc18d \uc2a4\ud0e0\ub4dc \uc7a5\uba74\uacfc \uad00\ub828\ub41c \uc778\ubb3c\ub4e4\uc758 \ubd84\uc704\uae30 \ubc0f \ud0dc\ub3c4\ub97c \uc124\uba85\ud558\uc2dc\uc624."
          },
          {
            "type": "image",
            "reference": "76c06f56-a9bc-4623-a854-fbc35cc57902",
