      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0c0\uc778\uc758 \uae30\uc900\uc774\ub098 \ub2f5\ub2f5\ud55c \ud604\uc2e4\uc5d0\uc11c \ubc97\uc5b4\ub098 \uc8fc\uccb4\uc801\uc774\uace0 \uace0\uc720\ud55c \uc790\uc544\ub85c \ube44\uc0c1(\uc131\uc7a5)\ud558\ub824\ub294 \uc5f4\ub9dd"
