{
  "title": "\ubbf8\uc138\ud50c\ub77c\uc2a4\ud2f1 \ud034\uc988",
  "questions": [
    {
      "question": "\u2018\ubcf5\ud569\uc591\uc2dd(Multimodal)\u2019\uc758 \uac1c\ub150\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb38\uc790\ub9cc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uae00\uc4f4\uc774\uc758 \uad00\uc810\uc744 \uac00\uc7a5 \uba85\ud655\ud558\uace0 \uac04\uacb0\ud558\uac8c \uc804\ub2ec\ud558\ub294 \uc591\uc2dd\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf5\ud569\uc591\uc2dd\uc740 \ub2e8\uc77c\ud55c \ubb38\uc790 \ub9e4\uccb4\uc5d0 \ud55c\uc815\ub418\uc9c0 \uc54a\uace0 \ub2e4\uc591\ud55c \uc2dc\uac01\uc801 \ubc0f \uccad\uac01\uc801 \uc591\uc2dd\uc774 \uacb0\ud569\ub418\ub294 \uac1c\ub150\uc774\ub2e4."
        },
        {
          "text": "\ubb38\uc790, \uadf8\ub9bc, \ud45c, \uadf8\ub798\ud504, \uc0ac\uc9c4, \ub3d9\uc601\uc0c1 \ub4f1 \ub458 \uc774\uc0c1\uc758 \ub2e4\uc591\ud55c \uc591\uc2dd\uc774 \ubcf5\ud569\uc801\uc73c\ub85c \uc791\uc6a9\ud558\uc5ec \uc758\ubbf8\ub97c \uad6c\uc131\ud558\ub294 \uac83\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud14d\uc2a4\ud2b8\uc5d0 \uc218\ubc18\ub418\ub294 \uc5ec\ub7ec \uc2dc\uac01 \uc790\ub8cc \ubc0f \ub9e4\uccb4\uc801 \uc591\uc2dd\uc774 \uc11c\ub85c \uc791\uc6a9\ud558\uc5ec \ud1b5\ud569\uc801\uc778 \uc758\ubbf8\ub97c \ud615\uc131\ud568\uc744 \ub098\ud0c0\ub0b8\ub2e4."
        },
        {
          "text": "\uc2dc\uac01\uc801 \uc790\ub8cc\ub97c \uc644\uc804\ud788 \uc81c\uc678\ud558\uace0 \uc74c\uc131 \ubc0f \ub3d9\uc601\uc0c1 \uc790\ub8cc\ub85c\ub9cc \uc815\ubcf4\ub97c \uad6c\uc131\ud558\ub294 \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf5\ud569\uc591\uc2dd\uc740 \uc2dc\uac01 \uc790\ub8cc(\uadf8\ub9bc, \ud45c, \uc0ac\uc9c4 \ub4f1)\uc640 \ubb38\uc790 \ud45c\uae30\ub97c \ud3ec\ud568\ud55c \ub2e4\uc591\ud55c \ud45c\ud604 \uc591\uc2dd\uc744 \uc885\ud569\uc801\uc73c\ub85c \ud65c\uc6a9\ud55c\ub2e4."
        },
        {
          "text": "\ub3c5\uc790\uac00 \uae00\uc4f4\uc774\uc758 \uc758\ub3c4\ub098 \uad00\uc810\uc744 \ud3c9\uac00\ud560 \ud544\uc694 \uc5c6\uc774 \uc815\ubcf4\ub97c \uc218\ub3d9\uc801\uc73c\ub85c \uc218\uc6a9\ud558\ub3c4\ub85d \ub3d5\ub294 \ud615\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf5\ud569\uc591\uc2dd\uc73c\ub85c \uad6c\uc131\ub41c \uae00\uc744 \uc77d\uc744 \ub54c\ub294 \uae00\uc4f4\uc774\uc758 \uad00\uc810, \uc758\ub3c4, \ud45c\ud604 \ubc29\uc2dd\uc744 \ub3c5\uc790\uac00 \ube44\ud310\uc801\uc73c\ub85c \ud3c9\uac00\ud558\uba70 \uc77d\uc5b4\uc57c \ud55c\ub2e4."
        }
      ],
      "hint": "\ub2e4\uc591\ud55c \ud45c\ud604 \uc218\ub2e8(\ubb38\uc790, \uc2dc\uac01 \uc790\ub8cc, \uc601\uc0c1 \ub4f1)\uc774 \ud568\uaed8 \uc5b4\uc6b0\ub7ec\uc838 \uc758\ubbf8\ub97c \ub9cc\ub4e4\uc5b4 \ub0b4\ub294 \ud2b9\uc9d5\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc138\uacc4\uc790\uc5f0\ubcf4\uc804\uc5f0\ub9f9(IUCN, 2017\ub144) \ubcf4\uace0\uc11c\uc5d0 \uc81c\uc2dc\ub41c \ubc14\ub2e4 \uc720\uc785 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uc694\uc778 \uc911 \uac00\uc7a5 \ub192\uc740 \ube44\uc911\uc744 \ucc28\uc9c0\ud558\ub294 \ud56d\ubaa9\uc740?",
      "answerOptions": [
        {
          "text": "\ud569\uc131 \uc12c\uc720(\uc138\ud0c1\ubb3c)",
          "isCorrect": true,
          "rationale": "\ud574\uc591 \uc720\uc785 \uc694\uc778 \uc911 \ud569\uc131 \uc12c\uc720 \uc138\ud0c1\ubb3c\uc774 35.0%\ub85c \uac00\uc7a5 \ub192\uc740 \ube44\uc911\uc744 \ucc28\uc9c0\ud55c\ub2e4\uace0 \uc790\ub8cc\uc5d0 \uba85\uc2dc\ub418\uc5b4 \uc788\ub2e4."
        },
        {
          "text": "\ud0c0\uc774\uc5b4",
          "isCorrect": false,
          "rationale": "\ud0c0\uc774\uc5b4\ub294 28.0%\ub85c \ud569\uc131 \uc12c\uc720 \ub2e4\uc74c\uc73c\ub85c \ub192\uc740 \ube44\uc911\uc744 \ucc28\uc9c0\ud558\ub294 \ud56d\ubaa9\uc774\ub2e4."
        },
        {
          "text": "\ub3c4\uc2dc \uba3c\uc9c0",
          "isCorrect": false,
          "rationale": "\ub3c4\uc2dc \uba3c\uc9c0\ub294 24.0%\ub97c \ucc28\uc9c0\ud558\ub294 \uc138 \ubc88\uc9f8 \uc8fc\uc694 \uc720\uc785 \uc694\uc778\uc774\ub2e4."
        },
        {
          "text": "\uac1c\uc778 \uad00\ub9ac \uc6a9\ud488",
          "isCorrect": false,
          "rationale": "\uac1c\uc778 \uad00\ub9ac \uc6a9\ud488\uc740 2.0%\uc5d0 \ubd88\uacfc\ud558\uc5ec \ube44\uc911\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \ub9e4\uc6b0 \uc801\ub2e4."
        }
      ],
      "hint": "\ubcf8\ubb38\uc5d0 \uc81c\uc2dc\ub41c \uc6d0\ud615 \uadf8\ub798\ud504\uc5d0\uc11c 35.0%\ub77c\ub294 \uac00\uc7a5 \ud070 \ube44\uc728\uc744 \ub098\ud0c0\ub0b4\ub294 \ud56d\ubaa9\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38 \uae30\uc0ac\uae00\uc5d0\uc11c \uc5b8\uae09\ub41c \ud658\uacbd \ud638\ub974\ubaac '\ud504\ud0c8\ub808\uc774\ud2b8'\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud50c\ub77c\uc2a4\ud2f1\uc744 \ub9cc\ub4dc\ub294 \uacfc\uc815\uc5d0\uc11c \ucca8\uac00\uc81c\ub85c \ud22c\uc785\ub418\ub294 \ud654\ud559 \ubb3c\uc9c8 \uc911 \ud558\ub098\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud50c\ub77c\uc2a4\ud2f1 \uc81c\uc870 \uc2dc \uc720\ud574 \uc131\ubd84\uc744 \ubc1c\uc0dd\uc2dc\ud0a4\ub294 \ud654\ud559 \ucca8\uac00\ubb3c \uc911 \ud558\ub098\ub85c \ubcf8\ubb38\uc5d0 \uae30\uc220\ub418\uc5b4 \uc788\ub2e4."
        },
        {
          "text": "\uc628\ub3c4\uac00 \ub192\uc544\uc9c0\uac70\ub098 \ube5b\uc744 \uc624\ub798 \ubc1b\uc744 \uacbd\uc6b0 \ud50c\ub77c\uc2a4\ud2f1\uc5d0\uc11c \uc0c8\uc5b4 \ub098\uc62c \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc628\ub3c4 \uc0c1\uc2b9\uc774\ub098 \uc7a5\uc2dc\uac04 \ube5b \ub178\ucd9c \uc870\uac74\uc5d0\uc11c \ud504\ud0c8\ub808\uc774\ud2b8 \uc131\ubd84\uc774 \uc6a9\ucd9c\ub420 \uc704\ud5d8\uc774 \ub192\uc544\uc9c4\ub2e4."
        },
        {
          "text": "\ub3d9\ubb3c\uc758 \uc0dd\uc2dd \uae30\uad00\uc5d0 \uc720\ud574\ud558\uba70 \ud574\uc591 \uc0dd\ubb3c\uc758 \ub0b4\ubd84\ube44 \uacc4\ud1b5\uc744 \uad50\ub780\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub3d9\ubb3c \uc0dd\uc2dd\uacc4 \uc720\ud574 \ub3c5\uc131 \ubb3c\uc9c8\ub85c \ub0b4\ubd84\ube44 \uacc4\ud1b5 \uad50\ub780 \ubc0f \uac1c\uccb4 \uc218 \uac10\uc18c\ub97c \uc720\ubc1c\ud560 \uc218 \uc788\ub2e4\uace0 \uc11c\uc220\ub418\uc5b4 \uc788\ub2e4."
        },
        {
          "text": "\uc12d\ucde8 \uc989\uc2dc \uccb4\uc678\ub85c 100% \ubc30\ucd9c\ub418\ubbc0\ub85c \uc0dd\ubb3c \ubab8\uc18d\uc5d0 \uc794\ub958\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud504\ud0c8\ub808\uc774\ud2b8 \ub4f1 \uc720\ud574 \ud654\ud559 \ubb3c\uc9c8\uc740 \uc0dd\ubb3c \uccb4\ub0b4\uc5d0 \uc9c0\uc18d\uc801\uc73c\ub85c \ucd95\uc801\ub418\uc5b4 \uba39\uc774 \uc0ac\uc2ac\uc744 \ud0c0\uace0 \uc0c1\uc704 \ud3ec\uc2dd\uc790\uc640 \uc778\uac04\uc5d0\uac8c \uc545\uc601\ud5a5\uc744 \ubbf8\uce5c\ub2e4."
        }
      ],
      "hint": "\ud504\ud0c8\ub808\uc774\ud2b8\uac00 \ud574\uc591 \uc0dd\ubb3c\uc758 \uc0dd\uc2dd\uacc4 \ubc0f \uccb4\ub0b4 \ucd95\uc801\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc5d0 \uc8fc\ubaa9\ud558\uc5ec \ubcf8\ubb38 \ub0b4\uc6a9\uc744 \uc810\uac80\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc138\uacc4\uc790\uc5f0\uae30\uae08(WWF)\uacfc \ud638\uc8fc \ub274\uce90\uc2ac\ub300\ud559\uad50 \uc5f0\uad6c \ubcf4\uace0\uc11c\uc5d0 \ub530\ub974\uba74, \uc77c\ubc18\uc801\uc778 \uc0ac\ub78c \ud55c \uba85\uc774 \uc77c\uc8fc\uc77c \ub3d9\uc548 \uc12d\ucde8\ud558\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc758 \uc591\uacfc \uadf8 \ube44\uc720\ub85c \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc57d 5g \u2014 \uc2e0\uc6a9 \uce74\ub4dc \ud55c \uc7a5 \ud06c\uae30",
          "isCorrect": true,
          "rationale": "\ubcf8\ubb38\uc5d0\uc11c \uc77c\uc8fc\uc77c \ub3d9\uc548 \uc0ac\ub78c\uc774 \uba39\uac8c \ub418\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uc591\uc744 \uc57d 5g\uc73c\ub85c \uc81c\uc2dc\ud558\uace0 \uc774\ub97c \uc2e0\uc6a9 \uce74\ub4dc \ud55c \uc7a5\uc758 \ud06c\uae30\uc640 \uac19\ub2e4\uace0 \ube44\uc720\ud588\ub2e4."
        },
        {
          "text": "\uc57d 50g \u2014 \uc2a4\ub9c8\ud2b8\ud3f0 \ud55c \ub300 \ubb34\uac8c",
          "isCorrect": false,
          "rationale": "\uc77c\uc8fc\uc77c \uc12d\ucde8\ub7c9 \uc218\uce58\ub294 50g\uc774 \uc544\ub2cc \uc57d 5g\uc73c\ub85c \uc11c\uc220\ub418\uc5b4 \uc788\ub2e4."
        },
        {
          "text": "\uc57d 1g \u2014 \ub3d9\uc804 \ud55c \uac1c \ubb34\uac8c",
          "isCorrect": false,
          "rationale": "\ubcf8\ubb38\uc5d0 \uc81c\uc2dc\ub41c \uc2e4\uc81c \uc218\uce58\uc778 \uc57d 5g\ubcf4\ub2e4 \ud604\uc800\ud788 \uc801\uac8c \uc81c\uc2dc\ub41c \uc624\ub2f5\uc774\ub2e4."
        },
        {
          "text": "\uc57d 15g \u2014 \uc5f0\ud544 \ud55c \uc790\ub8e8 \ud06c\uae30",
          "isCorrect": false,
          "rationale": "\ubcf8\ubb38\uc5d0 \uba85\uc2dc\ub41c \uc12d\ucde8\ub7c9 \uc591\uc774\ub098 \ube44\uad50 \ub300\uc0c1 \ube44\uc720 \ud45c\ud604\uacfc \uc77c\uce58\ud558\uc9c0 \uc54a\ub294\ub2e4."
        }
      ],
      "hint": "\uc77c\uc0c1\uc0dd\ud65c\uc5d0\uc11c \ub110\ub9ac \uc0ac\uc6a9\ud558\ub294 \uce74\ub4dc \ud615\ud0dc\uc758 \uc18c\uc9c0\ud488\uc5d0 \ube44\uc720\ud55c \ub300\ubaa9\uc758 \uc218\uce58\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ud658\uacbd \ub3d9\uc544\ub9ac \ud559\uc0dd\ub4e4\uc774 \uacf5\ub3d9 \ubcf4\uace0\uc11c\ub97c \uc791\uc131\ud558\uae30 \uc704\ud574 \uc5ed\ud560\uc744 \ubd84\ub2f4\ud55c \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubbfc\ud638 - \ud559\uad50 \ud559\uc0dd\ub4e4\uc744 \ub300\uc0c1\uc73c\ub85c \ud569\uc131 \uc12c\uc720 \uc774\uc6a9\uacfc \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \ubc30\ucd9c\uc5d0 \ub300\ud55c \uc124\ubb38 \uc870\uc0ac\ub97c \ub2f4\ub2f9\ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubbfc\ud638\ub294 \ud559\uad50 \ud559\uc0dd \ub300\uc0c1\uc758 \uc124\ubb38 \uc870\uc0ac\ub97c \uc9c1\uc811 \ub9e1\uc544 \uc2e4\uc2dc\ud558\uae30\ub85c \ub300\ud654\uc5d0\uc11c \ubd84\ub2f4\ud588\ub2e4."
        },
        {
          "text": "\uc0c1\ubbfc - \uc124\ubb38 \uc870\uc0ac \ubb38\ud56d\uc744 \uc9c1\uc811 \uc791\uc131\ud558\uace0 \ubd84\uc11d\ud558\ub294 \uc124\ubb38 \ub2f4\ub2f9 \uc5ed\ud560\uc744 \ub9e1\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0c1\ubbfc\uc740 \uc124\ubb38 \uc870\uc0ac\uac00 \uc544\ub2c8\ub77c \uad00\ub828 \ubb38\ud5cc \ubc0f \ub3d9\uc601\uc0c1 \ub4f1\uc758 \uc790\ub8cc \uc870\uc0ac\ub97c \ub2f4\ub2f9\ud588\ub2e4."
        },
        {
          "text": "\uc9c0\uc5f0 - \uc804\ubb38\uac00 \uc778\ud130\ubdf0\ub97c \uc704\ud574 \uc678\ubd80 \uae30\uad00\uc744 \uc9c1\uc811 \ubc29\ubb38 \ucde8\uc7ac\ud558\ub294 \uc5ed\ud560\uc744 \ub9e1\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uc5f0\uacfc \uc218\uc9c0\ub294 \uc870\uc0ac \uacb0\uacfc\ub97c \uc815\ub9ac\ud558\uace0 \uc2dc\uac01 \uc790\ub8cc\ub85c \uad6c\uc131\ud558\ub294 \uc5ed\ud560\uc744 \ub9e1\uc558\ub2e4."
        },
        {
          "text": "\uc218\uc9c0 - \ud569\uc131 \uc12c\uc720 \uc758\ub958 \uc138\ud0c1 \uc2dc \ubc1c\uc0dd\ud558\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uce21\uc815 \uc2e4\ud5d8\uc744 \uc9c4\ud589\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc9c0\ub294 \uc9c1\uc811 \uc2e4\ud5d8\uc744 \uc218\ud589\ud55c \uac83\uc774 \uc544\ub2c8\ub77c \uae30\uc874 \uc870\uc0ac\ub41c \uc790\ub8cc\ub97c \ubc14\ud0d5\uc73c\ub85c \uc2dc\uac01 \uc790\ub8cc\ub97c \uad6c\uc131\ud558\ub294 \uc5ed\ud560\uc744 \ub9e1\uc558\ub2e4."
        }
      ],
      "hint": "\ud559\uc0dd\ub4e4\uc758 \ub300\ud654 \uc911 \ubbfc\ud638\uac00 \uc218\ud589\ud558\uaca0\ub2e4\uace0 \uc9c1\uc811 \uc5b8\uae09\ud55c \uc870\uc0ac \ubc29\uc2dd\uc774 \ubb34\uc5c7\uc774\uc5c8\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc218\uc9c0\uac00 \ubcf4\uace0\uc11c \uc790\ub8cc\ub85c \ud65c\uc6a9\ud558\uace0\uc790 \uc218\uc9d1\ud55c '\uc138\ud0c1 \uc2dc \ubc1c\uc0dd\ud558\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1\uc758 \uc591(\uc601\uad6d \ud50c\ub9ac\uba38\uc2a4\ub300, 2016\ub144)' \uc790\ub8cc\uc5d0 \ub300\ud55c \ud574\uc11d\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc544\ud06c\ub9b4 \uc18c\uc7ac\uc758 \uc758\ub958\ub97c \uc138\ud0c1\ud560 \ub54c \ubc1c\uc0dd\ud558\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uac1c\uc218\uac00 \uac00\uc7a5 \ub9ce\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc544\ud06c\ub9b4 \uc138\ud0c1 \uc2dc 728,789\uac1c\uac00 \ubc1c\uc0dd\ud558\uc5ec \uc81c\uc2dc\ub41c 3\uac00\uc9c0 \uc758\ub958 \uc18c\uc7ac \uc911 \uac00\uc7a5 \ub9ce\uc740 \uc218\uce58\ub97c \ubcf4\uc778\ub2e4."
        },
        {
          "text": "\ud3f4\ub9ac\uc5d0\uc2a4\ud14c\ub974 \ub2e8\uc77c \uc18c\uc7ac\ubcf4\ub2e4 \ud3f4\ub9ac\uc5d0\uc2a4\ud14c\ub974\uc640 \uba74 \ud63c\ubc29 \uc18c\uc7ac\uc5d0\uc11c \ubc30\ucd9c\ub7c9\uc774 \ub354 \uc801\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud63c\ubc29 \uc18c\uc7ac\ub294 132,951\uac1c\ub85c \ud3f4\ub9ac\uc5d0\uc2a4\ud14c\ub974 \ub2e8\uc77c(496,030\uac1c)\ubcf4\ub2e4 \ubc30\ucd9c\ub7c9\uc774 \ud604\uc800\ud788 \uc801\ub2e4."
        },
        {
          "text": "\ucc9c\uc5f0 \uc12c\uc720\uac00 \uc11e\uc778 \uc637\uc744 \uc138\ud0c1\ud560 \uacbd\uc6b0 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \ubc30\ucd9c\uc744 \uc904\uc774\ub294 \ub370 \ud6a8\uacfc\uc801\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc9c\uc5f0 \uc12c\uc720\uc778 \uba74\uc774 \ud63c\ubc29\ub41c \uc758\ub958\uc5d0\uc11c \ubc1c\uc0dd \uac1c\uc218\uac00 \ud06c\uac8c \uc904\uc5b4\ub4e0\ub2e4\ub294 \ubd84\uc11d\uacfc \ubd80\ud569\ud55c\ub2e4."
        },
        {
          "text": "\ud569\uc131 \uc12c\uc720\uc758 \uc885\ub958\uc5d0 \uc0c1\uad00\uc5c6\uc774 6kg \uc138\ud0c1 \uc2dc \ubc30\ucd9c\ub418\ub294 \ubbf8\uc138 \ud50c\ub77c\uc2a4\ud2f1 \uac1c\uc218\ub294 \ubaa8\ub450 \uc77c\uc815\ud558\ub2e4.",
          "isCorrect": true,
