{
  "title": "Computer Networks Flashcards",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucef4\ud4e8\ud130 \ub124\ud2b8\uc6cc\ud06c(Computer Network)\ub780 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc591\ud55c \ucef4\ud4e8\ud305 \uae30\uae30\uac00 \uc720\uc120 \ub610\ub294 \ubb34\uc120 \ud1b5\uc2e0\ub9dd\uc73c\ub85c \uc5f0\uacb0\ub418\uc5b4 \ub370\uc774\ud130\ub97c \uc8fc\uace0\ubc1b\uc744 \uc218 \uc788\ub294 \ud1b5\uc2e0\ub9dd\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc120 \ub124\ud2b8\uc6cc\ud06c\uc758 \uae30\ubcf8 \uc811\uc18d \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11 \ucf00\uc774\ube14\uc774\ub098 \uc774\ub354\ub137 \ucf00\uc774\ube14 \ub4f1 \ubb3c\ub9ac\uc801\uc778 \ucf00\uc774\ube14\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucef4\ud4e8\ud305 \uc2dc\uc2a4\ud15c\uc744 \uc120\uc73c\ub85c \uc9c1\uc811 \uc5f0\uacb0\ud558\ub294 \ubc29\uc2dd\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc120 \ub124\ud2b8\uc6cc\ud06c\uac00 \uac00\uc9c4 \uc8fc\uc694 \uc7a5\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ub97c \uc548\uc815\uc801\uc774\uace0 \ube60\ub974\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc120 \ub124\ud2b8\uc6cc\ud06c\uac00 \uac00\uc9c4 \uc8fc\uc694 \ub2e8\uc810(\ud55c\uacc4)\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c\ub9ac\uc801\uc778 \ucf00\uc774\ube14 \uc5f0\uacb0\uc774 \ud544\uc694\ud558\uc5ec \uc7a5\uce58\ub97c \ubc30\uce58\ud558\uac70\ub098 \ud65c\uc6a9\ud560 \ub54c \uc7a5\uc18c\uc758 \uc81c\uc57d\uc744 \ubc1b\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ub85c \uace0\uc18d \ub370\uc774\ud130 \uc804\uc1a1 \ubc0f \uc6d0\uac70\ub9ac \uc804\uc1a1\uc5d0 \ud65c\uc6a9\ub418\ub294 \uc720\uc120 \ucf00\uc774\ube14\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11 \ucf00\uc774\ube14"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\ub834\ud55c \uad6c\ucd95 \ube44\uc6a9\uacfc \uc720\uc5f0\uc131\uc744 \ubc14\ud0d5\uc73c\ub85c \uc8fc\ub85c \uadfc\uac70\ub9ac \ud1b5\uc2e0\ub9dd(LAN) \uad6c\ucd95\uc5d0 \uc0ac\uc6a9\ub418\ub294 \ucf00\uc774\ube14\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ub354\ub137 \ucf00\uc774\ube14"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub124\ud2b8\uc6cc\ud06c \uc7a5\ube44 \uc911 '\ud5c8\ube0c \ubc0f \uc2a4\uc704\uce58'\uc758 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ub7ec \ub300\uc758 \ucef4\ud4e8\ud305 \uc2dc\uc2a4\ud15c\uacfc \uc8fc\ubcc0 \uc7a5\uce58\ub97c \uc5f0\uacb0\ud558\uc5ec \ud558\ub098\uc758 \ub0b4\ubd80 \ub124\ud2b8\uc6cc\ud06c\ub97c \ud615\uc131\ud558\uace0 \ub0b4\ubd80 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\ub85c \ub2e4\ub978 \ub124\ud2b8\uc6cc\ud06c \uc0ac\uc774\ub97c \uc5f0\uacb0\ud558\uace0 \ub370\uc774\ud130\uac00 \uc678\ubd80\ub85c \ub098\uac00\ub294 \uacbd\ub85c\ub97c \uc9c0\uc815\ud574 \uc8fc\ub294 \uc7a5\ube44\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub77c\uc6b0\ud130(Router)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub77c\uc6b0\ud130\uc640 \ud5c8\ube0c/\uc2a4\uc704\uce58\uc758 \uac00\uc7a5 \ud070 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud5c8\ube0c/\uc2a4\uc704\uce58\ub294 \ud558\ub098\uc758 \ub124\ud2b8\uc6cc\ud06c \uc548\uc5d0\uc11c \uae30\uae30\ub4e4\uc744 \uc5f0\uacb0\ud558\uc9c0\ub9cc, \ub77c\uc6b0\ud130\ub294 \uc11c\ub85c \ub2e4\ub978 \ub124\ud2b8\uc6cc\ud06c \uac04\uc744 \uc5f0\uacb0\ud558\uace0 \uacbd\ub85c\ub97c \uc9c0\uc815\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\ubd80\ub85c\ubd80\ud130\uc758 \ubd88\ubc95 \uc811\uadfc\uc774\ub098 \uc545\uc758\uc801\uc778 \uacf5\uaca9\uc744 \ub9c9\uc544 \ub124\ud2b8\uc6cc\ud06c \ubcf4\uc548\uc744 \uc720\uc9c0\ud558\ub294 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc29\ud654\ubcbd(Firewall)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc120 \ub79c\uacfc \ubb34\uc120 \ub79c\uc744 \uc5f0\uacb0\ud558\uc5ec \uc640\uc774\ud30c\uc774 \uae30\uc220\ub85c \uc778\ud130\ub137\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uac8c \ud574\uc8fc\ub294 \uc7a5\uce58\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc120 AP(\uc561\uc138\uc2a4 \ud3ec\uc778\ud2b8, Access Point)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb34\uc2e4\uc774\ub098 \uc8fc\ud0dd \ub4f1 \uc77c\uc815\ud55c \uc81c\ud55c\ub41c \ubc94\uc704 \uc548\uc5d0\uc11c \uae30\uae30\ub4e4\uc744 \uc5f0\uacb0\ud55c \uadfc\uac70\ub9ac \ud1b5\uc2e0\ub9dd\uc744 \ub73b\ud558\ub294 \uc6a9\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub79c(LAN; Local Area Network)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc120 \ub124\ud2b8\uc6cc\ud06c\ub294 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud558\uae30 \uc704\ud574 \ubb34\uc5c7\uc744 \ub9e4\uac1c\ub85c \uc0ac\uc6a9\ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uac04\uc758 \ubb34\uc120 \uc8fc\ud30c\uc218(\uc8fc\ud30c\uc218)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc120 \ub124\ud2b8\uc6cc\ud06c\uc758 \uac00\uc7a5 \ud575\uc2ec\uc801\uc778 \uc7a5\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucf00\uc774\ube14\uc774 \ud544\uc694 \uc5c6\uc5b4 \uc7a5\uc18c\uc758 \uc81c\uc57d\uc744 \ubc1b\uc9c0 \uc54a\uace0 \uc790\uc720\ub86d\uac8c \uae30\uae30\ub4e4\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud65c \uc18d \ub2e4\uc591\ud55c \ubb3c\uac74\uc774 \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \ub370\uc774\ud130\ub97c \uc8fc\uace0\ubc1b\uc73c\uba70 \uc678\ubd80\uc5d0\uc11c \uc6d0\uaca9 \uc81c\uc5b4\uac00 \uac00\ub2a5\ud558\ub3c4\ub85d \ud558\ub294 \uc2dc\uc2a4\ud15c\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137(IoT; Internet of Things)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ud615 \ubc18\ub3c4\uccb4 \uce69\uc774 \ub0b4\uc7a5\ub41c \ud0dc\uadf8\ub098 \uce74\ub4dc \ub4f1\uc758 \ub370\uc774\ud130\ub97c \ubb34\uc120 \uc8fc\ud30c\uc218\ub85c \uc77d\uc5b4 \uc0c1\ud488\uc774\ub098 \uc815\ubcf4\ub97c \uc2dd\ubcc4\ud558\ub294 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc790 \ud0dc\uadf8(RFID; Radio Frequency IDentification)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc18d\ub3c4\ub85c \ud558\uc774\ud328\uc2a4, \uad50\ud1b5\uce74\ub4dc, \uc0c1\uc810\uc758 \uc0c1\ud488 \uc815\ubcf4 \uc778\uc2dd\uc5d0 \uc8fc\ub85c \uc0ac\uc6a9\ub418\ub294 \ubb34\uc120 \uc2dd\ubcc4 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc790 \ud0dc\uadf8(RFID)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\uac70\ub9ac \ubb34\uc120 \ud1b5\uc2e0(NFC)\uc758 \uc8fc\uc694 \ud1b5\uc2e0 \uac70\ub9ac\ub294 \uc5bc\ub9c8 \uc774\ub0b4\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "10cm \uc774\ub0b4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "NFC(\uadfc\uac70\ub9ac \ubb34\uc120 \ud1b5\uc2e0)\uc640 RFID(\uc804\uc790 \ud0dc\uadf8) \uc0ac\uc774\uc758 \uad00\uacc4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "NFC\ub294 RFID \uae30\uc220 \uc911 \ud558\ub098\ub85c, 10cm \uc774\ub0b4\uc758 \ub9e4\uc6b0 \uac00\uae4c\uc6b4 \uac70\ub9ac\uc5d0\uc11c \ube44\uc811\ucd09\uc73c\ub85c \ub370\uc774\ud130\ub97c \uc8fc\uace0\ubc1b\ub294 \uae30\uc220\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8\ud3f0\uc744 \uc774\uc6a9\ud55c \ube44\uc811\ucd09\uc2dd \uacb0\uc81c, \uad50\ud1b5 \uc694\uae08 \uacb0\uc81c, \ucd9c\uc785 \ud1b5\uc81c, \ud2f0\ucf13 \ubc1c\ub9e4\uc5d0 \uc8fc\ub85c \ud65c\uc6a9\ub418\ub294 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadfc\uac70\ub9ac \ubb34\uc120 \ud1b5\uc2e0(NFC)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube14\ub8e8\ud22c\uc2a4(Bluetooth) \uae30\uc220\uc758 \uc720\ud6a8 \ud1b5\uc2e0 \uac70\ub9ac\ub294 \ubcf4\ud1b5 \uc5bc\ub9c8 \uc774\ub0b4\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "10m \uc774\ub0b4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube14\ub8e8\ud22c\uc2a4\uc5d0\uc11c \ub450 \uac1c\uc758 \ubb34\uc120 \uc7a5\uce58\ub97c \uc11c\ub85c \uc778\uc2dd\uc2dc\ucf1c \uc5f0\uacb0\ud558\ub294 \uacfc\uc815\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud398\uc5b4\ub9c1(pairing)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc640\uc774\ud30c\uc774\uc640 \ube14\ub8e8\ud22c\uc2a4\ub97c \uc804\uc1a1 \uc18d\ub3c4 \uce21\uba74\uc5d0\uc11c \ube44\uad50\ud558\uba74 \uc5b4\ub5a0\ud55c\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube14\ub8e8\ud22c\uc2a4\ub294 \uc640\uc774\ud30c\uc774\ubcf4\ub2e4 \uc804\uc1a1 \uc18d\ub3c4\uac00 \ub290\ub9bd\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc120 \uc774\uc5b4\ud3f0\uc774\ub098 \uc778\uacf5\uc9c0\ub2a5(AI) \uc2a4\ud53c\ucee4 \uc5f0\uacb0\uc5d0 \uc8fc\ub85c \uc774\uc6a9\ub418\ub294 \uadfc\uac70\ub9ac \ubb34\uc120 \ud1b5\uc2e0 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube14\ub8e8\ud22c\uc2a4(Bluetooth)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uae4c\uc6b4 \uac70\ub9ac\uc5d0\uc11c \ub178\ud2b8\ubd81\uc774\ub098 \uc2a4\ub9c8\ud2b8\ud3f0\uc73c\ub85c \uc778\ud130\ub137\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \ub79c(LAN)\uc744 \ubb34\uc120\ud654\ud55c \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc640\uc774\ud30c\uc774(WiFi)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc640\uc774\ud30c\uc774\uac00 \uc774\ub3d9 \ud1b5\uc2e0 \ub124\ud2b8\uc6cc\ud06c(\ubaa8\ubc14\uc77c \ub370\uc774\ud130)\uc640 \ube44\uad50\ud588\uc744 \ub54c \uac00\uc9c0\ub294 \ub450 \uac00\uc9c0 \uc8fc\uc694 \uc7a5\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc6a9\uc774 \uc800\ub834\ud558\uace0 \uc804\uc1a1 \uc18d\ub3c4\uac00 \ube60\ub985\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uae30\uae30\uc5d0\uc11c \ubcf4\uc5ec\uc9c0\ub294 \ub514\uc2a4\ud50c\ub808\uc774 \ud654\uba74\uc744 \uadf8\ub300\ub85c \ub2e4\ub978 \uae30\uae30\uc5d0 \uc804\uc1a1\ud558\uc5ec \uacf5\uc720\ud558\ub294 \uac83\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub7ec\ub9c1(mirroring)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc2a4\ud50c\ub808\uc774 \ud654\uba74\uc744 \uacf5\uc720\ud560 \uc218 \uc788\ub294 \ub300\ud45c\uc801\uc778 \uae30\uc220 \uaddc\uaca9 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
