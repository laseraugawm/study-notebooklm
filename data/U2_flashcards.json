    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc758 \ub300\ud45c \uc608\uc2dc\uc778 \ud654\uc7ac \uac10\uc9c0 \uc2dc\uc2a4\ud15c\uc758 \uc791\ub3d9 \ub2e8\uacc4 3\uac00\uc9c0\ub294?"
