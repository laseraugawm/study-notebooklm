    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137 \ud658\uacbd\uc5d0\uc11c \uc778\ud130\ub137 \ub124\ud2b8\uc6cc\ud06c\ub85c \uc0c1\ud638 \uc5f0\uacb0\ub418\ub294 \ub300\uc0c1 \ub450 \uac00\uc9c0 \uc870\ud569\uc740?"
