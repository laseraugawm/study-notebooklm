{
  "title": "Networking Flashcards",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucef4\ud4e8\ud305 \uc2dc\uc2a4\ud15c\uc73c\ub85c \uc778\ud130\ub137\uc744 \uc0ac\uc6a9\ud558\uae30 \uc704\ud574 \ub79c \uc120\uc744 \uc5f0\uacb0\ud558\uc9c0 \uc54a\uace0 \ubb34\uc120\uc73c\ub85c \uc5f0\uacb0\ud560 \ub54c \uc8fc\ub85c \uc0ac\uc6a9\ud558\ub294 \ub124\ud2b8\uc6cc\ud06c \ubc29\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc640\uc774\ud30c\uc774(Wi-Fi)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc708\ub3c4 \uc6b4\uc601\uccb4\uc81c\uc5d0\uc11c \ub0b4 \ucef4\ud4e8\ud130\uc758 \ub124\ud2b8\uc6cc\ud06c \uc5f0\uacb0 \uc0c1\ud0dc\uc640 IP \uc8fc\uc18c\ub97c \uc54c\uc544\ubcf4\uae30 \uc704\ud574 \ud074\ub9ad\ud574\uc57c \ud558\ub294 \uacbd\ub85c\uc758 \uba54\ub274\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "[\uc124\uc815] - [\ub124\ud2b8\uc6cc\ud06c \ubc0f \uc778\ud130\ub137] - \uc774\ub354\ub137\uc758 [\uc18d\uc131]"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ud130\ub137\uc5d0\uc11c \ucef4\ud4e8\ud305 \uc2dc\uc2a4\ud15c\uc774\ub098 \uae30\uae30\ub97c \uc2dd\ubcc4\ud558\uace0 \ud1b5\uc2e0\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \uc8fc\uc18c\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "IP \uc8fc\uc18c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\uc7ac \uc778\ud130\ub137 \ub124\ud2b8\uc6cc\ud06c\uc5d0\uc11c \uc0ac\uc6a9\ub418\uace0 \uc788\ub294 \ub450 \uac00\uc9c0 IP \uc8fc\uc18c \uccb4\uacc4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "IPv4, IPv6"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc708\ub3c4\uc758 \ucee4\ub9e8\ub4dc\ucc3d(cmd)\uc5d0\uc11c \ub0b4 \ucef4\ud4e8\ud130\uc758 IP \uc8fc\uc18c\ub97c \ud655\uc778\ud558\uae30 \uc704\ud574 \uc785\ub825\ud558\ub294 \uba85\ub839\uc5b4\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "ipconfig"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ud130\ub137 \uc5f0\uacb0 \ud6c4 \uc708\ub3c4 \uac80\uc0c9\ucc3d\uc5d0 \uac80\uc0c9\ud558\uc5ec \uc5f0\uacb0\ub41c \uae30\uae30\uc758 IP \uc8fc\uc18c\ub97c \uc27d\uac8c \ud655\uc778\ud560 \uc218 \uc788\ub294 \uc601\uc5b4 \uac80\uc0c9 \ubb38\uad6c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "What is my ip"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc708\ub3c4 \uc791\uc5c5 \ud45c\uc2dc\uc904\uc758 Wi-Fi \uc544\uc774\ucf58\uc744 \ud1b5\ud574 \ubcf4\uc548 \uc124\uc815\ub41c \ubb34\uc120 \ub124\ud2b8\uc6cc\ud06c\uc5d0 \uc5f0\uacb0\ud560 \ub54c \ubc18\ub4dc\uc2dc \uc785\ub825\ud574\uc57c \ud558\ub294 \uac83\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\ubc00\ubc88\ud638"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub124\ud2b8\uc6cc\ud06c \uacf5\uc720 \uc124\uc815\uc744 \ud1b5\ud574 \uac1c\uc778\uc6a9 \ucef4\ud4e8\ud130\uc5d0\uc11c \ud0c0\uc778\uacfc \uacf5\uc720\ud560 \uc218 \uc788\ub294 \uc790\uc6d0 \ub450 \uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc815\ub41c \ud3f4\ub354\uc758 \ud30c\uc77c, \ucef4\ud4e8\ud130\uc5d0 \uc5f0\uacb0\ub41c \ud504\ub9b0\ud130"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc6a9\uc790\uac00 \uc2dc\uac04\uacfc \uc7a5\uc18c\uc5d0 \uc0c1\uad00\uc5c6\uc774 \ub124\ud2b8\uc6cc\ud06c\ub85c \uc5f0\uacb0\ub41c \ucef4\ud4e8\ud305 \uc790\uc6d0\uc744 \uc774\uc6a9\ud560 \uc218 \uc788\ub294 \uc2dc\uc2a4\ud15c\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305\uc744 \ud65c\uc6a9\ud560 \ub54c \ub370\uc774\ud130\ub97c \uacf5\uc720\ud558\uace0 \ud65c\uc6a9\ud558\ub294 \uc8fc\uc694 \ubc29\ubc95 \ub450 \uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\ubc84\uc5d0 \ub370\uc774\ud130\ub97c \uc800\uc7a5\ud558\uace0 \ub370\uc774\ud130 \uacf5\uc720\ud558\uae30, \uc11c\ubc84\uc5d0\uc11c \ub3d9\uc791\ud558\ub294 \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uc0ac\uc6a9\ud558\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305\uc744 \ud65c\uc6a9\ud55c \ubb38\uc11c \uc791\uc5c5\uc758 \uac00\uc7a5 \ub300\ud45c\uc801\uc778 \ud611\uc5c5 \uc7a5\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc7a5\uc18c\uc5d0 \uc0c1\uad00\uc5c6\uc774 \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \uc774\uc6a9\ud558\uc5ec \uc5ec\ub7ec \uc0ac\ub78c\uc774 \ud568\uaed8 \ubb38\uc11c\ub97c \uc644\uc131\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc18c\uc5d0\uc11c \uce5c\uad6c\uc5d0\uac8c \uc0ac\uc9c4 \ud30c\uc77c \ub9c1\ud06c\ub97c \uc804\ub2ec\ud560 \ub54c \ubaa8\ub4e0 \uce5c\uad6c\uac00 \ubcfc \uc218 \uc788\ub3c4\ub85d \ubcc0\uacbd\ud574\uc57c \ud558\ub294 \uc124\uc815 \ud56d\ubaa9\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "[\uc561\uc138\uc2a4 \uad00\ub9ac]\uc5d0\uc11c '\ub9c1\ud06c\uac00 \uc788\ub294 \ubaa8\ub4e0 \uc0ac\uc6a9\uc790'\ub85c \uad8c\ud55c \ubcc0\uacbd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc77c\uc774\ub098 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud560 \uc218 \uc788\ub294 \ubb34\uc120 \ub124\ud2b8\uc6cc\ud06c \uae30\uc220 \uc608\uc2dc 4\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc640\uc774\ud30c\uc774 \uc0ac\uc6a9, \ube14\ub8e8\ud22c\uc2a4 \uc0ac\uc6a9, \uc5d0\uc5b4\ub4dc\ub86d(AirDrop), \ud035\uc170\uc5b4(Quick Share)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8\ud3f0, \ud0dc\ube14\ub9bf, \ub178\ud2b8\ubd81\uc758 \ud654\uba74\uc744 \uad50\uc2e4\uc758 TV \ub4f1 \uc678\ubd80 \ub514\uc2a4\ud50c\ub808\uc774\uc5d0 \uadf8\ub300\ub85c \ucd9c\ub825\ud558\ub294 \uae30\uc220\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub7ec\ub9c1(Mirroring)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8\ud3f0\uc5d0\uc11c \uc560\ud50c(Apple) \uae30\uae30\uc758 \ud654\uba74\uc744 TV\ub85c \ubbf8\ub7ec\ub9c1\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \uae30\ub2a5\uc758 \uba85\uce6d\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\uc5b4\ud50c\ub808\uc774(AirPlay)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc2a4\ud50c\ub808\uc774 \ubbf8\ub7ec\ub9c1 \uc2dc \uc120\ud0dd\ud560 \uc218 \uc788\ub294 \ub300\ud45c\uc801\uc778 \ub450 \uac00\uc9c0 \ubbf8\ub7ec\ub9c1 \ubaa8\ub4dc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf5\uc81c \ubaa8\ub4dc, \ud655\uc7a5 \ubaa8\ub4dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8\ud3f0\uc744 TV\uc5d0 \ubbf8\ub7ec\ub9c1\ud560 \ub54c TV \ud654\uba74 \uc804\uccb4\uc5d0 \uaf49 \ucc2c \ud654\uba74\uc73c\ub85c \ud45c\uc2dc\ud558\uae30 \uc704\ud55c \uc2a4\ub9c8\ud2b8\ud3f0\uc758 \ud654\uba74 \ubc29\ud5a5\uc740?"
