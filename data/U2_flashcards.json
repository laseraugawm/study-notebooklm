      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc13c\uc11c\ub85c \ud654\uc7ac \uac10\uc9c0 \u2192 \ucef4\ud4e8\ud130\uac00 \ud654\uc7ac \uc0c1\ud0dc \ud310\ub2e8 \u2192 \ud654\uc7ac \uacbd\ubcf4 \uc791\ub3d9"
