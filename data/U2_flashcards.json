      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\ub85c \ubaa8\ub4dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc0c1\uc0dd\ud65c \uc18d \ub2e4\uc591\ud55c \ubb3c\uac74\uc774 \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \ub370\uc774\ud130\ub97c \uc8fc\uace0\ubc1b\uc744 \uc218 \uc788\ub294 \uc2dc\uc2a4\ud15c\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
