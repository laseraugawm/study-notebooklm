    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c\uc774 \uc778\ud130\ub137 \ub124\ud2b8\uc6cc\ud06c\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc11c\ub85c \uc815\ubcf4\ub97c \uc8fc\uace0\ubc1b\uae30 \uc704\ud574 \uc0ac\ubb3c\uc5d0 \ubc18\ub4dc\uc2dc \ud0d1\uc7ac\ub418\uc5b4\uc57c \ud558\ub294 \uc7a5\uce58 \ub450 \uac00\uc9c0\ub294?"
