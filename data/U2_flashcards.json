    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc5d0\uc11c \ub9d0\ud558\ub294 '\uc0ac\ubb3c'\uc758 \ubc94\uc704\uc5d0\ub294 \ucef4\ud4e8\ud305 \uae30\uae30 \uc678\uc5d0 \uc5b4\ub5a4 \uc7a5\uce58\ub4e4\uc774 \ud3ec\ud568\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ud53c\ucee4, \ub0c9\uc7a5\uace0, \uc804\ub4f1, TV \ub4f1 \uc8fc\ubcc0\uc5d0\uc11c \uc811\ud560 \uc218 \uc788\ub294 \uad6c\uccb4\uc801\uc774\uace0 \uac1c\ubcc4\uc801\uc778 \ubaa8\ub4e0 \uc0ac\ubb3c"
