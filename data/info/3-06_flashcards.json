      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc131\uc740 \uc18d\uc131 (Attribute), \uae30\ub2a5\uc740 \uba54\uc18c\ub4dc (Method)"
