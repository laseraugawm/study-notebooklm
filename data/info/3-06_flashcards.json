    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL \ubaa8\ub4c8\uc5d0\uc11c \uc800\uc7a5\ub41c \uc774\ubbf8\uc9c0 \ud30c\uc77c\uc744 \uc5f4\uc5b4\uc11c \uc774\ubbf8\uc9c0 \uc778\uc2a4\ud134\uc2a4\ub97c \uc0dd\uc131\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \uba54\uc18c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
