    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL \uc774\ubbf8\uc9c0 \uac1d\uccb4\uc5d0\uc11c \ud2b9\uc815 $(x, y)$ \uc88c\ud45c\uc758 \ud53d\uc140 \uc0c9\uc0c1 \uac12\uc744 \uac00\uc838\uc624\ub294 \uba54\uc18c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`getpixel((x, y))`"
