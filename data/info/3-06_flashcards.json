        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub370\ub2cc(A), \uad6c\uc544\ub2cc(G), \uc0ac\uc774\ud1a0\uc2e0(C), \ud0c0\uc774\ubbfc(T) 4\uac1c\uc758 \uc5fc\uae30\ub97c \uac00\uc9c0\ub294 \uc774\uc911 \ub098\uc120 \uad6c\uc870\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "RNA \uad6c\uc870 \ubc0f \uc5fc\uae30 \uc870\uc131\uc774 DNA\uc640 \ub2e4\ub978 \ud575\uc2ec \ucc28\uc774\uc810 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ud0c0\uc774\ubbfc(T) \ub300\uc2e0 \uc720\ub77c\uc2e4(U) \uc5fc\uae30\ub97c \uac16\ub294\ub2e4.\n2. \uc774\uc911 \ub098\uc120\uc774 \uc544\ub2cc \ub2e8\uc77c \uac00\ub2e5 \uad6c\uc870\ub85c \uc774\ub8e8\uc5b4\uc9c4\ub2e4."
