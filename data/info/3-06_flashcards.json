      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uc218\ub294 \uc67c\ucabd(\uc2dc\uacc4 \ubc18\ub300 \ubc29\ud5a5), \uc74c\uc218\ub294 \uc624\ub978\ucabd(\uc2dc\uacc4 \ubc29\ud5a5)\uc73c\ub85c \ud68c\uc804\ud55c\ub2e4."
