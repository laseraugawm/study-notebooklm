    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "DNA \uc5fc\uae30 \uc11c\uc5f4 \uc785\ub825\uac12\uc744 \ud55c \uae00\uc790\uc529 \uac80\uc0ac\ud558\uc5ec RNA \uc804\uc0ac \ubb38\uc790\uc5f4\uc744 \uc644\uc131\ud558\uae30 \uc704\ud574 \ud30c\uc774\uc36c \ud504\ub85c\uadf8\ub798\ubc0d\uc5d0\uc11c \uacb0\ud569\ud558\uc5ec \uc0ac\uc6a9\ud558\ub294 \ub450 \uc81c\uc5b4\uad6c\uc870\ub294 \ubb34\uc5c7\uc778\uac00?"
