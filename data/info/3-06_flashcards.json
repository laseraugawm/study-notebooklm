    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ubb38\uc790\uc5f4 \uc5f0\uc0b0\uc5d0\uc11c `+` \uc5f0\uc0b0\uc790\ub294 \uc5b4\ub5a4 \uc5ed\ud560\uc744 \uc218\ud589\ud558\ub294\uac00?"
