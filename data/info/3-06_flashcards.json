    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL \uc774\ubbf8\uc9c0 \uac1d\uccb4\uc758 \ud2b9\uc815 $(x, y)$ \uc88c\ud45c\uc5d0 \uc9c0\uc815\ud55c \uc0c9\uc0c1 \ud53d\uc140\uac12\uc744 \uc800\uc7a5\ud558\ub294 \uba54\uc18c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
