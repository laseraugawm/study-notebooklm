      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uc5f4\ub07c\ub9ac \uc5f0\uacb0(\uc774\uc5b4 \ubd99\uc774\uae30)\ud55c\ub2e4. (\uc608: `'Hello' + 'World'` $\\rightarrow$ `'HelloWorld'`)"
