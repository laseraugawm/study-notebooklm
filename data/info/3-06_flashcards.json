    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL\uc758 `rotate()` \uba54\uc18c\ub4dc\uc5d0\uc11c \uc778\uc790\uac12\uc73c\ub85c \uc591\uc218\uc640 \uc74c\uc218\ub97c \uc804\ub2ec\ud560 \ub54c\uc758 \ud68c\uc804 \ubc29\ud5a5 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
