    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "DNA\ub97c RNA\ub85c \uc804\uc0ac\ud560 \ub54c DNA \uc5fc\uae30 \uc0ac\uc774\ud1a0\uc2e0(C)\uacfc \uad6c\uc544\ub2cc(G)\uc740 \uac01\uac01 \uc5b4\ub5a4 RNA \uc5fc\uae30\ub85c \uc804\uc0ac\ub418\ub294\uac00?"
