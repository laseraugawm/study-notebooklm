      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc774\ud1a0\uc2e0(C)\uc740 \uad6c\uc544\ub2cc(G)\uc73c\ub85c, \uad6c\uc544\ub2cc(G)\uc740 \uc0ac\uc774\ud1a0\uc2e0(C)\uc73c\ub85c \uc804\uc0ac\ub41c\ub2e4."
