    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud074\ub798\uc2a4 \ub0b4\ubd80\uc5d0\uc11c \uc18d\uc131\uacfc \uba54\uc18c\ub4dc\ub294 \uad6c\uccb4\uc801\uc73c\ub85c \uc5b4\ub5a4 \ud615\ud0dc\ub85c \ud45c\ud604\ub418\ub294\uac00?"
