    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "DNA\ub97c RNA\ub85c \uc804\uc0ac\ud560 \ub54c DNA \uc5fc\uae30 \ud0c0\uc774\ubbfc(T)\uc740 \uc5b4\ub5a4 RNA \uc5fc\uae30\ub85c \uc804\uc0ac\ub418\ub294\uac00?"
          }
        ]
