    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uac1d\uccb4'\uc640 '\uc778\uc2a4\ud134\uc2a4'\uc758 \ucc28\uc774\ub294 \uc8fc\ub85c \uc5b4\ub5a4 \uad00\uc810\uc5d0\uc11c \uc124\uba85\ub420 \ub54c \ub4dc\ub7ec\ub098\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uc2a4\ud134\uc2a4\ub294 \ud074\ub798\uc2a4\uc640 \uac1d\uccb4 \uac04\uc758 \uad00\uacc4\ub97c \uc911\uc2ec\uc73c\ub85c \ud2b9\uc815 \ud074\ub798\uc2a4\uc758 \uad6c\uccb4\uc801\uc778 \uc2e4\uccb4\ub97c \ud45c\ud604\ud560 \ub54c \uc0ac\uc6a9\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \uc774\ubbf8\uc9c0 \ubd84\uc11d \ubc0f \ucc98\ub9ac\ub97c \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \ub77c\uc774\ube0c\ub7ec\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL (Python Imaging Library)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL \ub77c\uc774\ube0c\ub7ec\ub9ac\uc758 \uc774\ubbf8\uc9c0 \uc778\uc2a4\ud134\uc2a4\uac00 \uac00\uc9c4 \ub300\ud45c\uc801\uc778 2\uac00\uc9c0 \uc18d\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud06c\uae30 (`size`) \ubc0f \ubaa8\ub4dc (`mode`)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL \ub77c\uc774\ube0c\ub7ec\ub9ac\uc5d0\uc11c \uc774\ubbf8\uc9c0\ub97c \uc870\uc791\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 3\uac00\uc9c0 \ub300\ud45c\uc801\uc778 \uc778\uc2a4\ud134\uc2a4 \uba54\uc18c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud68c\uc804 (`rotate`), \ubc18\uc804 (`transpose`), \ud544\ud130 \ucc98\ub9ac (`filter`)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uae00 \ucf54\ub7a9(Colaboratory) \ud658\uacbd\uc5d0\uc11c \uc678\ubd80 \ud30c\uc77c\uc744 \uc5c5\ub85c\ub4dc\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \ud30c\uc774\uc36c \ubaa8\ub4c8\uacfc \uba54\uc18c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
