    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "DNA\ub97c RNA\ub85c \uc804\uc0ac\ud560 \ub54c DNA \uc5fc\uae30 \uc544\ub370\ub2cc(A)\uc740 \uc5b4\ub5a4 RNA \uc5fc\uae30\ub85c \uc804\uc0ac\ub418\ub294\uac00?"
          }
        ]
