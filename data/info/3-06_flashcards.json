    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL\uc5d0\uc11c \uc774\ubbf8\uc9c0\ub97c \uc624\ub978\ucabd\uc73c\ub85c 50\ub3c4 \ud68c\uc804\uc2dc\ud0a4\ub294 \uba85\ub839\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
