    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL \ub77c\uc774\ube0c\ub7ec\ub9ac\uc5d0\uc11c \ud544\ud130 \ud6a8\uacfc\ub97c \uc801\uc6a9\ud558\uae30 \uc704\ud574 \ubd88\ub7ec\uc640\uc57c \ud558\ub294 \ubaa8\ub4c8\uc740 \ubb34\uc5c7\uc778\uac00?"
