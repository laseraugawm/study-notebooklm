    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uba85\uacfc\ud559\uc5d0\uc11c DNA \uc5fc\uae30 \uc11c\uc5f4\uc774 \uc0c1\ubcf4\uc801\uc778 RNA \uc5fc\uae30 \uc11c\uc5f4\ub85c \ubcf5\uc0ac\ub418\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
