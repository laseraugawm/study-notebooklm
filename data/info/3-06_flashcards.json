{
  "title": "\uac1d\uccb4\uc9c0\ud5a5 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\uc2e4 \uc138\uacc4\uc758 \uc0ac\ubb3c\uc744 \ucd94\uc0c1\ud654\ud558\uc5ec \uac1d\uccb4\ub85c \ud45c\ud604\ud558\uace0, \uac1d\uccb4 \uac04\uc758 \uc0c1\ud638 \uc791\uc6a9\uc744 \ud1b5\ud574 \ud504\ub85c\uadf8\ub7a8\uc744 \uad6c\ud604\ud558\ub294 \uac1c\ubc1c \ubc29\ubc95\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1d\uccb4\uc9c0\ud5a5 \ud504\ub85c\uadf8\ub798\ubc0d (OOP)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1d\uccb4\uc9c0\ud5a5 \ud504\ub85c\uadf8\ub798\ubc0d\uc744 \uad6c\ud604\ud558\uae30 \uc704\ud574 \uc774\ud574\ud574\uc57c \ud558\ub294 3\uac00\uc9c0 \ud575\uc2ec \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1d\uccb4 (object), \ud074\ub798\uc2a4 (class), \uc778\uc2a4\ud134\uc2a4 (instance)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1d\uccb4\uc9c0\ud5a5 \ud504\ub85c\uadf8\ub798\ubc0d\uc5d0\uc11c \ud504\ub85c\uadf8\ub7a8 \ub3d9\uc791\uc758 \uc8fc\uccb4\uac00 \ub418\uba70, \uace0\uc720\ud55c \uc18d\uc131\uacfc \uae30\ub2a5\uc744 \uac16\ub294 \ub370\uc774\ud130 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1d\uccb4 (Object)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1d\uccb4\ub97c \ub9cc\ub4e4\uae30 \uc704\ud55c '\uc124\uacc4\ub3c4'\uc5d0 \ud574\ub2f9\ud558\uba70, \uac1d\uccb4\ub4e4\uc758 \uacf5\ud1b5\ub41c \uc18d\uc131\uacfc \uba54\uc18c\ub4dc\ub97c \uc815\uc758\ud55c \uac83\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub798\uc2a4 (Class)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1d\uccb4\uc9c0\ud5a5 \ud504\ub85c\uadf8\ub798\ubc0d\uc5d0\uc11c \ud074\ub798\uc2a4\uac00 \uac00\uc9c0\ub294 '\ud2b9\uc131'\uacfc '\uae30\ub2a5'\uc744 \uac01\uac01 \ubb34\uc5c7\uc774\ub77c \ubd80\ub974\ub294\uac00?"
          }
        ]
