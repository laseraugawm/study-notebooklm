          {
            "type": "text",
            "content": "\uc0dd\uc131\ub41c \uc778\uc2a4\ud134\uc2a4\uc758 \uc18d\uc131\uacfc \uba54\uc18c\ub4dc\ub97c \uac01\uac01 \ud638\ucd9c(\ubd88\ub7ec\uc624\uae30)\ud558\ub294 \uae30\ubcf8 \ubb38\ubc95\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18d\uc131 \ubd88\ub7ec\uc624\uae30: `\uc778\uc2a4\ud134\uc2a4\uba85.\uc18d\uc131`, \uba54\uc18c\ub4dc \ubd88\ub7ec\uc624\uae30: `\uc778\uc2a4\ud134\uc2a4\uba85.\uba54\uc18c\ub4dc\uba85()`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc0ac\uc704 \ud074\ub798\uc2a4 `Dice` \uc815\uc758 \uc2dc `__init__(self)` \uc0dd\uc131\uc790 \ub0b4\ubd80\uc5d0\uc11c \uc8fc\uc0ac\uc704 \ucd08\uae30 \uc18d\uc131 `self.value`\ub97c \uc5bc\ub9c8\ub85c \ucd08\uae30\ud654\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`0`"
