        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc0ac\uc704 \ud074\ub798\uc2a4 `Dice`\uc5d0\uc11c \uc8fc\uc0ac\uc704 \uac12\uc744 1\ubd80\ud130 6\uae4c\uc9c0\uc758 \uc784\uc758 \uc815\uc218\ub85c \uc124\uc815\ud558\uae30 \uc704\ud574 `roll(self)` \uba54\uc18c\ub4dc\uc5d0 \uc0ac\uc6a9\ud558\ub294 \ud30c\uc774\uc36c \ud45c\uc900 \ub77c\uc774\ube0c\ub7ec\ub9ac \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`random.randint(1, 6)` (`random` \ubaa8\ub4c8 \ud544\uc694)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc0ac\uc704 \uc778\uc2a4\ud134\uc2a4 `dice1`\uc758 \uc784\uc758 \uac12\uc744 \uad6c\ud55c \ub4a4 \ud574\ub2f9 \uac12\uc744 \ubd88\ub7ec\uc624\uae30 \uc704\ud55c \ub450 \uba54\uc18c\ub4dc\uc758 \ud638\ucd9c \uc21c\uc11c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`dice1.roll()`\uc744 \ud638\ucd9c\ud558\uc5ec \uac12\uc744 \uc124\uc815\ud55c \ud6c4 `dice1.get_value()`\ub97c \ud638\ucd9c\ud558\uc5ec \uac12\uc744 \ubc18\ud658\ubc1b\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PIL \ubaa8\ub4c8\uc5d0\uc11c \uc9c0\uc815\ud55c \ubaa8\ub4dc, \ud06c\uae30, \uc0c9\uc0c1\uc73c\ub85c \uc644\uc804\ud55c \uc0c8 \uc774\ubbf8\uc9c0\ub97c \uc0dd\uc131\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \uba54\uc18c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`Image.new(mode, size, color)`"
          }
