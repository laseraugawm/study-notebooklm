    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub798\uc2a4\ub85c\ubd80\ud130 \uc0dd\uc131\ub41c \uad6c\uccb4\uc801\uc778 \uac1c\ubcc4 \uac1d\uccb4\ub97c \ubb34\uc5c7\uc774\ub77c \ubd80\ub974\ub294\uac00?"
          }
        ]
