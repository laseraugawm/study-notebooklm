{
  "title": "\uc778\uacf5\uc9c0\ub2a5 \ud034\uc988",
  "questions": [
    {
      "question": "\ub2e4\uc74c \uc911 \uc778\uacf5\uc9c0\ub2a5\uc744 '\uc8fc\uc5b4\uc9c4 \ud658\uacbd\uc5d0\uc11c \uc2a4\uc2a4\ub85c \ucd5c\uc801\uc758 \ud589\ub3d9\uc744 \uacb0\uc815\ud558\ub294 \uc9c0\ub2a5\ud615 \uc5d0\uc774\uc804\ud2b8\ub97c \ub9cc\ub4dc\ub294 \ud559\ubb38'\uc73c\ub85c \uc815\uc758\ud55c \ud559\uc790\ub294 \ub204\uad6c\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc2a4\ud29c\uc5b4\ud2b8 \ub7ec\uc140",
          "isCorrect": true,
          "rationale": "\uc2a4\ud29c\uc5b4\ud2b8 \ub7ec\uc140\uc740 \uc778\uacf5\uc9c0\ub2a5\uc744 \ud658\uacbd\uacfc\uc758 \uc0c1\ud638 \uc791\uc6a9\uc744 \ud1b5\ud574 \uc2a4\uc2a4\ub85c \ucd5c\uc801\uc758 \ud589\ub3d9\uc744 \uacb0\uc815\ud558\ub294 \uc9c0\ub2a5\ud615 \uc5d0\uc774\uc804\ud2b8\ub97c \uac1c\ubc1c\ud558\ub294 \ud559\ubb38\uc73c\ub85c \uc815\uc758\ud588\ub2e4."
        },
        {
          "text": "\uc568\ub7f0 \ud29c\ub9c1",
          "isCorrect": false,
          "rationale": "\uc568\ub7f0 \ud29c\ub9c1\uc740 \uae30\uacc4\uc758 \ud310\ub2e8\uacfc \ud589\ub3d9\uc774 \uc0ac\ub78c\uacfc \uad6c\ubd84\ud558\uae30 \ud798\ub4e4 \ub54c \uc9c0\ub2a5\uc801\uc774\ub77c\uace0 \ub9d0\ud560 \uc218 \uc788\ub2e4\ub294 \ud29c\ub9c1 \ud14c\uc2a4\ud2b8\uc758 \uac1c\ub150\uc744 \uc81c\uc2dc\ud588\ub2e4."
        },
        {
          "text": "\uc874 \ub9e4\uce74\uc2dc",
          "isCorrect": false,
          "rationale": "\uc874 \ub9e4\uce74\uc2dc\ub294 '\uc778\uacf5\uc9c0\ub2a5'\uc774\ub77c\ub294 \uc6a9\uc5b4\ub97c \ucc98\uc74c \uc81c\uc548\ud558\uace0 \uc9c0\ub2a5\uc801\uc778 \uae30\uacc4\ub97c \ub9cc\ub4dc\ub294 \uacfc\ud559\uacfc \uacf5\ud559\uc73c\ub85c \uc815\uc758\ud588\ub2e4."
        },
        {
          "text": "\ud328\ud2b8\ub9ad \uc708\uc2a4\ud134",
          "isCorrect": false,
          "rationale": "\ud328\ud2b8\ub9ad \uc708\uc2a4\ud134\uc740 \uc778\uacf5\uc9c0\ub2a5\uc744 \uc778\uc9c0\ud558\uace0 \ucd94\ub860\ud558\uba70 \ud310\ub2e8\ud558\ub294 \uac83\uc744 \uac00\ub2a5\ud558\uac8c \ud558\ub294 \ucef4\ud4e8\ud130 \uacfc\ud559 \ubd84\uc57c\ub85c \uc815\uc758\ud588\ub2e4."
        }
      ],
      "hint": "\uc778\uacf5\uc9c0\ub2a5\uc744 '\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8' \uad00\uc810\uc5d0\uc11c \uc815\uc758\ud558\uba70 \ud658\uacbd\uc5d0\uc11c\uc758 \uc790\uc728\uc801 \ud310\ub2e8\uc744 \uac15\uc870\ud55c \ud559\uc790\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc628\ub3c4 \uc870\uc808\uae30\uc640 \uac19\uc740 \uc77c\ubc18 \uc5d0\uc774\uc804\ud2b8\uc640 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \uad6c\ubd84 \uc9d3\ub294 \uac00\uc7a5 \ud575\uc2ec\uc801\uc778 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ud559\uc2b5\uacfc \ucd94\ub860\uc744 \ud1b5\ud574 \uc2a4\uc2a4\ub85c \ud589\ub3d9\uc744 \uac1c\uc120\ud558\uace0 \uc0c8\ub85c\uc6b4 \uaddc\uce59\uc744 \ub9cc\ub4e4\uc5b4\ub0b8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc77c\ubc18 \uc5d0\uc774\uc804\ud2b8\ub294 \uc124\uc815\ub41c \uaddc\uce59\uc5d0 \ub530\ub77c\uc11c\ub9cc \ub2e8\uc21c \ube44\uad50\u00b7\uc791\ub3d9\ud558\uc9c0\ub9cc, \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ud559\uc2b5\uacfc \ucd94\ub860\uc744 \ud1b5\ud574 \uc790\uc728\uc801\uc73c\ub85c \uaddc\uce59\uacfc \uc804\ub7b5\uc744 \uc0dd\uc131 \ubc0f \uac1c\uc120\ud55c\ub2e4."
        },
        {
          "text": "\uc77c\ubc18 \uc5d0\uc774\uc804\ud2b8\ub294 \uc13c\uc11c\ub97c \uc0ac\uc6a9\ud558\uc9c0\ub9cc \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \uc13c\uc11c\ub97c \uc804\ud600 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \uc5ed\uc2dc \uc8fc\ubcc0 \ud658\uacbd\uc744 \uc778\uc9c0\ud558\uae30 \uc704\ud574 \uce74\uba54\ub77c\uc778, \uc801\uc678\uc120 \uc13c\uc11c \ub4f1 \uc13c\uc11c\ub97c \ud544\uc218\uc801\uc73c\ub85c \ud65c\uc6a9\ud55c\ub2e4."
        },
        {
          "text": "\uc77c\ubc18 \uc5d0\uc774\uc804\ud2b8\ub9cc \ubaa9\ud45c\ub97c \uac00\uc9c0\uace0 \ud589\ub3d9\ud558\uba70 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ubaa9\ud45c \uc5c6\uc774 \ubb34\uc791\uc704\ub85c \ubc18\uc751\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \uba85\ud655\ud55c \ubaa9\uc801 \ub2ec\uc131\uc744 \ud5a5\ud574 \ud589\ub3d9\ud558\ub294 \ubaa9\uc801\uc131\uc744 \ud575\uc2ec \ud2b9\uc131\uc73c\ub85c \uac16\ub294\ub2e4."
        },
        {
          "text": "\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \uc678\ubd80 \ud658\uacbd\uacfc \uc804\ud600 \uc0c1\ud638 \uc791\uc6a9\ud558\uc9c0 \uc54a\uace0 \ub0b4\ubd80 \ud504\ub85c\uadf8\ub7a8\ub9cc \uc218\ud589\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \uc678\ubd80 \ud658\uacbd\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \uc778\uc2dd\ud558\uace0 \uc0c1\ud669\uc5d0 \ub9de\ub294 \uacb0\uc815\uc744 \ub0b4\ub824 \uc791\ub3d9\ud558\ubbc0\ub85c \ub04a\uc784\uc5c6\uc774 \uc0c1\ud638 \uc791\uc6a9\ud55c\ub2e4."
        }
      ],
      "hint": "\ub2e8\uc21c\ud788 '\uc124\uc815\ub41c \uac12\uc774\ub098 \uaddc\uce59'\uc744 \ub530\ub974\ub294\uc9c0, \uc2a4\uc2a4\ub85c \ud559\uc2b5\ud558\uc5ec \uc0c8\ub85c\uc6b4 \uc804\ub7b5\uc744 \ub300\uc751\ud574 \ub9cc\ub4e4\uc5b4\ub0b4\ub294\uc9c0\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uc8fc\uc694 \ud2b9\uc131 \uc911 '\ud658\uacbd \ubcc0\ud654\uc5d0 \ub530\ub77c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uac00 \uc790\uc2e0\uc758 \ud310\ub2e8\uacfc \ud589\ub3d9\uc744 \uc870\uc815\ud558\ub294 \uc131\uc9c8'\uc5d0 \ud574\ub2f9\ud558\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc801\uc751\uc131",
          "isCorrect": true,
          "rationale": "\ud658\uacbd\uc774 \ubcc0\ud654\ud568\uc5d0 \ub530\ub77c \uc0c1\ud669 \ud310\ub2e8\uacfc \ud589\ub3d9\uc744 \uadf8\uc5d0 \ub9de\ucd94\uc5b4 \uc720\uc5f0\ud558\uac8c \uc870\uc815\ud558\ub294 \uc131\uc9c8\uc744 \uc801\uc751\uc131\uc774\ub77c\uace0 \ud55c\ub2e4."
        },
        {
          "text": "\uc790\uc728\uc131",
          "isCorrect": false,
          "rationale": "\uc790\uc728\uc131\uc740 \uc0ac\uc6a9\uc790\ub098 \uc678\ubd80\uc758 \uc9c1\uc811\uc801\uc778 \uac1c\uc785 \uc5c6\uc774 \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uace0 \ud589\ub3d9\uc744 \uacb0\uc815\ud558\ub294 \ud2b9\uc131\uc744 \uc758\ubbf8\ud55c\ub2e4."
        },
        {
          "text": "\ubaa9\uc801\uc131",
          "isCorrect": false,
          "rationale": "\ubaa9\uc801\uc131\uc740 \ub2e8\uc21c\ud788 \ud658\uacbd\uc5d0 \ubb34\uc791\uc704\ub85c \ubc18\uc751\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc8fc\uc5b4\uc9c4 \ud2b9\uc815 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \ud589\ub3d9\ud558\ub294 \uc131\uc9c8\uc774\ub2e4."
        },
        {
          "text": "\uc0ac\ud68c\uc131",
          "isCorrect": false,
          "rationale": "\uc0ac\ud68c\uc131\uc740 \ub2e4\ub978 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub4e4\uacfc \uc11c\ub85c \ub370\uc774\ud130 \ubc0f \uc815\ubcf4\ub97c \uc8fc\uace0\ubc1b\uc73c\uba70 \ud611\ub825\ud558\uac70\ub098 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ud2b9\uc131\uc774\ub2e4."
        }
      ],
      "hint": "\uc0c8\ub85c\uc6b4 \uc7a5\uc560\ubb3c\uc774\ub098 \uc608\uc678\uc801\uc778 \ud658\uacbd \uc870\uac74\uc5d0 \ub9de\ucd94\uc5b4 \uc720\uc5f0\ud558\uac8c \ubc18\uc751\uc744 \ubc14\uafb8\ub294 \uc131\uc9c8\uc744 \ub098\ud0c0\ub0b4\ub294 \ub2e8\uc5b4\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub85c\uc11c \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\uc758 \uad6c\uc131 \uc694\uc18c \uc911 '\uad6c\ub3d9\uae30(\ud589\ub3d9)'\uc5d0 \ud574\ub2f9\ud558\ub294 \uac83\ub4e4\ub85c\ub9cc \uc62c\ubc14\ub974\uac8c \uc9dd\uc9c0\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud578\ub4e4, \uac00\uc18d \ud398\ub2ec, \ube0c\ub808\uc774\ud06c, \uacbd\uc801",
          "isCorrect": true,
          "rationale": "\uad6c\ub3d9\uae30\ub294 \ud310\ub2e8\ub41c \uacb0\uacfc\uc5d0 \ub530\ub77c \uc2e4\uc81c\ub85c \ubb3c\ub9ac\uc801\uc778 \ub3d9\uc791\uc774\ub098 \uac00\uc2dc\uc801\uc778 \ud589\ub3d9\uc744 \uc2e4\ud589\ud558\ub294 \uae30\uacc4 \uc7a5\uce58(\ub4dc\ub77c\uc774\ubc84)\ub97c \uc758\ubbf8\ud55c\ub2e4."
        },
        {
          "text": "\uce74\uba54\ub77c, GPS, \uc18d\ub3c4\uacc4, \ub77c\uc774\ub2e4",
          "isCorrect": false,
          "rationale": "\uce74\uba54\ub77c, GPS, \uc18d\ub3c4\uacc4, \ub77c\uc774\ub2e4 \ub4f1\uc740 \uc678\ubd80 \ud658\uacbd \uc815\ubcf4\ub97c \ubc1b\uc544\ub4e4\uc774\ub294 '\uc13c\uc11c(\uc778\uc2dd)'\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\ub3c4\ub85c \uc0c1\ud669, \ub2e4\ub978 \ucc28\ub7c9, \uc2b9\uac1d, \ubcf4\ud589\uc790",
          "isCorrect": false,
          "rationale": "\ub3c4\ub85c \uc0c1\ud669, \ud0c0 \ucc28\ub7c9, \uc2b9\uac1d \ub4f1\uc740 \uc5d0\uc774\uc804\ud2b8\uac00 \ub193\uc5ec \uc788\ub294 '\ud658\uacbd' \uc694\uc18c\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\uacbd\ub85c \ud0d0\uc0c9 \uc54c\uace0\ub9ac\uc998, \uc0ac\uace0 \uc608\uce21 \ubaa8\ub378, \ud559\uc2b5 \uc2e0\uacbd\ub9dd",
          "isCorrect": false,
          "rationale": "\uc54c\uace0\ub9ac\uc998 \ubc0f \uc608\uce21 \ubaa8\ub378\uc740 \uc778\uacf5\uc9c0\ub2a5\uc758 '\ud559\uc2b5 \ubc0f \ucd94\ub860(\uc9c0\ub2a5\uc801 \ud310\ub2e8)' \uae30\ub2a5\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        }
      ],
      "hint": "\uc778\uc2dd\uacfc \ud310\ub2e8\uc744 \ubc14\ud0d5\uc73c\ub85c \uc790\ub3d9\ucc28\ub97c \uc9c1\uc811 \uc6c0\uc9c1\uc774\uac70\ub098 \uc18c\ub9ac\ub97c \ub0b4\ub294 \uc2e0\ud638 \uc804\ub2ec \uc7a5\uce58\ub4e4\uc744 \uace8\ub77c\ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 \uc5ec\ub7ec \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uac00 \uc11c\ub85c \ud611\ub825\ud558\uac70\ub098 \uacbd\uc7c1\ud558\uc5ec \uc784\ubb34\ub97c \uc218\ud589\ud558\ub294 '\ub2e4\uc911 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8'\uc758 \uc0ac\ub840\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc7ac\ub09c \uc0c1\ud669\uc5d0\uc11c \ub2e4\uc218\uc758 \ub4dc\ub860\uc774 \ud53c\ud574 \uc9c0\uc5ed\uc744 \ud0d0\uc0c9\ud558\uace0 \uc0dd\uc874\uc790\ub97c \ud0d0\uc9c0\ud558\ub294 \uc2dc\uc2a4\ud15c",
          "isCorrect": true,
          "rationale": "\uc5ec\ub7ec \ub4dc\ub860\uc774 \ub3c5\ub9bd\uc801\uc73c\ub85c \ud310\ub2e8\ud558\uba74\uc11c \ub3d9\uc2dc\uc5d0 \uc11c\ub85c \uc815\ubcf4\ub97c \uad50\ud658\ud558\uace0 \ud611\ub825\ud558\uc5ec \uacf5\ub3d9 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\ubbc0\ub85c \ub2e4\uc911 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\uc0ac\uc6a9\uc790\uc758 \uc218\uba74 \ud328\ud134\uc744 \uce21\uc815\ud558\uc5ec \uac74\uac15 \uc0c1\ud0dc\ub97c \uc54c\ub824\uc8fc\ub294 \uc2a4\ub9c8\ud2b8 \ub9c1",
          "isCorrect": false,
          "rationale": "\uc2a4\ub9c8\ud2b8 \ub9c1\uc740 \uac1c\uc778 \uc0ac\uc6a9\uc790\uc758 \ub2e8\uc77c \uc0dd\uccb4 \ub370\uc774\ud130\ub97c \uc218\uc9d1\u00b7\ubd84\uc11d\ud558\ub294 \ub2e8\uc77c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \ud65c\uc6a9 \uc608\uc2dc\uc774\ub2e4."
        },
        {
          "text": "\ucc57GPT \uae30\ubc18\uc758 AI \ud540\uc744 \uc637\uc5d0 \ubd80\ucc29\ud558\uc5ec \uc77c\uc0c1 \uc5c5\ubb34\ub97c \ub3d5\ub294 \ube44\uc11c \uc11c\ube44\uc2a4",
          "isCorrect": false,
          "rationale": "AI \ud540\uc740 \uc0ac\uc6a9\uc790 \uac1c\uc778\uacfc 1:1\ub85c \ub300\ud654\ud558\uba70 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ub2e8\uc77c \ud615\ud0dc\uc758 AI \uc5b4\uc2dc\uc2a4\ud134\ud2b8\uc774\ub2e4."
        },
        {
          "text": "\uc0ac\uc6a9\uc790\uc758 \ub3d9\uc601\uc0c1 \uc2dc\uccad \uae30\ub85d\uc744 \ubd84\uc11d\ud558\uc5ec \uc5f0\uad00 \uc601\uc0c1\uc744 \ucd94\ucc9c\ud574 \uc8fc\ub294 \uc2dc\uc2a4\ud15c",
          "isCorrect": false,
          "rationale": "\ucf58\ud150\uce20 \ucd94\ucc9c \uc2dc\uc2a4\ud15c\uc740 \uac1c\ubcc4 \uc0ac\uc6a9\uc790\uc758 \ub370\uc774\ud130\ub97c \ud559\uc2b5\ud558\uc5ec \ucd5c\uc120\uc758 \ucf58\ud150\uce20\ub97c \uc81c\uc2dc\ud558\ub294 \ucd94\ucc9c \uc5d0\uc774\uc804\ud2b8\uc774\ub2e4."
        }
      ],
      "hint": "'\ub2e8\uc77c' \uc5d0\uc774\uc804\ud2b8\uac00 \uc544\ub2cc, '\uc5ec\ub7ec \uac1c(Multi)'\uc758 \uc5d0\uc774\uc804\ud2b8\uac00 \uc11c\ub85c \ud611\ub825\ud558\uac70\ub098 \uacbd\uc7c1\ud558\ub294 \uc0ac\ub840\ub97c \ucc3e\uc73c\uc138\uc694."
    },
    {
      "question": "\uc0dd\uc131\ud615 AI(Generative AI)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc62c\ubc14\ub974\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0dd\uc131\ud615 AI\ub294 \uae30\uc874 \ub370\uc774\ud130\uc758 \ud328\ud134\ub9cc \ubd84\uc11d\ud560 \ubfd0 \uc0c8\ub85c\uc6b4 \uae00, \uc774\ubbf8\uc9c0, \uc601\uc0c1 \ub4f1\uc744 \uc9c1\uc811 \ub9cc\ub4e4\uc5b4\ub0b4\ub294 \uac83\uc740 \ubd88\uac00\ub2a5\ud558\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0dd\uc131\ud615 AI\ub294 \uae30\uacc4\ud559\uc2b5 \ubaa8\ub378\uc744 \uae30\ubc18\uc73c\ub85c \ub300\ub7c9\uc758 \ub370\uc774\ud130\ub97c \ud559\uc2b5\ud558\uc5ec \uae30\uc874\uc5d0 \uc5c6\ub358 \uae00, \uc774\ubbf8\uc9c0, \uc601\uc0c1, \uc18c\uc2a4 \ucf54\ub4dc \ub4f1 \uc0c8\ub85c\uc6b4 \uacb0\uacfc\ub97c \ucc3d\uc791 \ubc0f \uc0dd\uc131\ud560 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\ucc57GPT\ub294 \uc8fc\uc5b4\uc9c4 \ud14d\uc2a4\ud2b8 \ub4a4\uc5d0 \uc774\uc5b4\uc9c8 \uc801\ud569\ud55c \ub2e8\uc5b4\ub97c \uc608\uce21\ud558\uace0 \uc120\ud0dd\ud558\ub294 \uacfc\uc815\uc744 \ud559\uc2b5\ud558\uc5ec \ubb38\uc7a5\uc744 \uc0dd\uc131\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc57GPT\ub294 \uc5b8\uc5b4 \ubaa8\ub378\ub9c1 \ud559\uc2b5\uc744 \ud1b5\ud574 \uc790\uc5f0\uc2a4\ub7fd\uace0 \ub9e5\ub77d\uc5d0 \ub9de\ub294 \ub2e4\uc74c \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud558\uc5ec \uc0ac\ub78c\uacfc \uc720\uc0ac\ud55c \ubb38\uc7a5\uc744 \uc0dd\uc131\ud55c\ub2e4."
