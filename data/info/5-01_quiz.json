{
  "title": "\ub514\uc9c0\ud138\uae30\uc220 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub514\uc9c0\ud138 \uae30\uc220 \uc911 \ud558\ub098\uc778 '\uacf5\uac04 \ucef4\ud4e8\ud305 \uae30\uc220'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub514\uc9c0\ud138 \ucf58\ud150\uce20\ub97c \uc2e4\uc81c \uacf5\uac04\uc5d0 \uad6c\ud604\ud558\uc5ec \uc0ac\uc6a9\uc790\uac00 \uac00\uc0c1 \ud658\uacbd\uacfc \uc0c1\ud638\uc791\uc6a9\ud558\uac70\ub098 \uc804\ubb38\uac00\uc640 \uc2e4\uc2dc\uac04 \uc18c\ud1b5\ud558\ub3c4\ub85d \ub3d5\ub294 \uae30\uc220\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub514\uc9c0\ud138 \ucf58\ud150\uce20\ub97c \ud604\uc2e4 \uacf5\uac04\uc5d0 \uad6c\ud604\ud568\uc73c\ub85c\uc368 \uc2dc\uacf5\uac04 \uc81c\uc57d \uc5c6\uc774 \ubcf5\uc7a1\ud55c \uae30\uacc4 \uc218\ub9ac\ub098 \uc2e4\uc2dc\uac04 \ud611\uc5c5\uc744 \uac00\ub2a5\ud558\uac8c \ud558\ub294 \uae30\uc220\uc774\ub2e4."
        },
        {
          "text": "\ub300\ub7c9\uc758 \ube44\uad6c\uc870\ud654 \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uc5ec \uae30\uc5c5\uc758 \uc758\uc0ac \uacb0\uc815 \ubc0f \uc608\uce21 \ubaa8\ub378 \uad6c\ucd95\uc744 \uc804\ub2f4\ud558\ub294 \uae30\uc220\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub300\uc6a9\ub7c9 \ub370\uc774\ud130 \uc218\uc9d1 \ubc0f \ubd84\uc11d\uc744 \ud1b5\ud574 \uc870\uc9c1\uc758 \ud569\ub9ac\uc801 \ud310\ub2e8\uc744 \ub3d5\ub294 \uac83\uc740 \ub370\uc774\ud130 \uacfc\ud559\uc758 \uc601\uc5ed\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\ubd84\uc0b0 \ub124\ud2b8\uc6cc\ud06c\ub97c \ud1b5\ud574 \uac70\ub798 \uc815\ubcf4\ub97c \uc554\ud638\ud654\ud558\uace0 \uac1c\uc778 \uc815\ubcf4\uc758 \ubb34\ub2e8 \uc720\ucd9c\uc744 \ubc29\uc9c0\ud558\ub294 \ubcf4\uc548 \uae30\uc220\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e0\uc6a9\uce74\ub4dc \ubc88\ud638 \ub300\uccb4\ub098 \uac70\ub798 \uae30\ub85d\uc758 \uc554\ud638\ud654 \ub4f1 \uac1c\uc778\uc815\ubcf4\ub97c \ubcf4\ud638\ud558\ub294 \uae30\uc220\uc740 \ube14\ub85d\uccb4\uc778\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\uc0ac\uc6a9\uc790 \uba85\ub839\uc5b4\ub97c \uc74c\uc131\uc73c\ub85c \uc778\uc2dd\ud558\uc5ec \uac00\uc815 \ub0b4 \ubaa8\ub4e0 \uc804\uc790\uc81c\ud488\uc758 \uc81c\uc5b4\ub97c \uc790\ub3d9\ud654\ud558\ub294 \uae30\uc220\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc74c\uc131\uc744 \ud1b5\ud55c \uac00\uc804\uc81c\ud488 \uc81c\uc5b4\ub294 \uc74c\uc131 \uc778\uc2dd \uae30\ubc18\uc758 \ud648 \uc11c\ube44\uc2a4 \ubc0f \uac00\uc804 \uc81c\uc5b4 \uae30\uc220\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        }
      ],
      "hint": "\ub514\uc9c0\ud138 \ucf58\ud150\uce20\ub97c \ud604\uc2e4 \uc138\uacc4\uc758 \uc7a5\uc18c\uc5d0 \uacb9\uccd0 \ub098\ud0c0\ub0b4\uc5b4 \uc18c\ud1b5\ud558\ub294 \ubc29\uc2dd\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub514\uc9c0\ud138 \uae30\uc220\uc774 \uc801\uc6a9\ub418\uc5b4 \ub098\ud0c0\ub09c \uc0ac\ud68c \ubcc0\ud654 \ubaa8\uc2b5 \uc911, \uae08\uc735 \uc601\uc5ed\uc5d0\uc11c\uc758 \uc8fc\uc694 \ud65c\uc6a9 \uc0ac\ub840\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ube14\ub85d\uccb4\uc778 \uae30\uc220\uc744 \ud65c\uc6a9\ud574 \uace0\uac1d\uc758 \uc2e0\uc6a9\uce74\ub4dc \ubc88\ud638\ub97c \uc548\uc804\ud55c \ub514\uc9c0\ud138 \uae30\ub85d\uc73c\ub85c \ub300\uccb4\ud558\uace0 \uc774\uc0c1 \uac70\ub798\ub97c \ud0d0\uc9c0\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uae08\uc735 \ubd84\uc57c\uc5d0\uc11c\ub294 \ube14\ub85d\uccb4\uc778\uc744 \ud1b5\ud574 \uac1c\uc778 \uc815\ubcf4\ub97c \ubcf4\ud638\ud558\uace0 \uc0ac\uae30 \ubc29\uc9c0 \ubc0f \uc774\uc0c1 \uac70\ub798\ub97c \uc2e4\uc2dc\uac04\uc73c\ub85c \ud0d0\uc9c0\ud55c\ub2e4."
        },
        {
          "text": "\uc74c\uc131 \uc778\uc2dd \uae30\uc220\uacfc \uc811\ubaa9\ud558\uc5ec \uac00\uc804\uc81c\ud488\uc744 \uc81c\uc5b4\ud558\uace0 \uc774\uc0c1 \uc0c1\ud669\uc744 \uc2e4\uc2dc\uac04 \uac10\uc9c0\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac00\uc804\uc81c\ud488\uc758 \uc571 \uc81c\uc5b4 \ubc0f \uc774\uc0c1 \ud0d0\uc9c0\ub294 \uae08\uc735\uc774 \uc544\ub2cc \ud648 \uc11c\ube44\uc2a4 \uc601\uc5ed\uc758 \ubcc0\ud654 \ubaa8\uc2b5\uc774\ub2e4."
        },
        {
          "text": "\ubc14\ub2f7\ubb3c\uc5d0 \ub179\ub294 \ud50c\ub77c\uc2a4\ud2f1\uacfc \uac00\ubcbc\uc6b4 \uc2e0\uc18c\uc7ac\ub97c \uac1c\ubc1c\ud558\uc5ec \ud0c4\uc18c \ubc30\ucd9c\uc744 \uc904\uc778\ub2e4.",
          "isCorrect": false,
          "rationale": "\uce5c\ud658\uacbd \uc2e0\uc18c\uc7ac \uac1c\ubc1c\uacfc \ud0c4\uc18c \ubc30\ucd9c \uc808\uac10\uc740 \uae30\uc220\u00b7\uacf5\ud559 \uc601\uc5ed\uc5d0 \ud574\ub2f9\ud558\ub294 \uc124\uba85\uc774\ub2e4."
        },
        {
          "text": "3D \ud504\ub9b0\ud130\ub97c \ud65c\uc6a9\ud558\uc5ec \uc8fc\ubb38\ubd80\ud130 \ubc30\uc1a1\uae4c\uc9c0 \uc81c\ud488 \uc0dd\uc0b0 \uacf5\uc815\uc744 \uc804\uccb4 \uc790\ub3d9\ud654\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "3D \ud504\ub9b0\ud130 \ud65c\uc6a9 \ubc0f \ub9de\ucda4\ud615 \uc9c1\uc811 \uc81c\uc870\u00b7\ud310\ub9e4\ub294 \uc81c\uc870\uc640 \ubb3c\ub958 \uc601\uc5ed\uc5d0 \uad00\ud55c \ub0b4\uc6a9\uc774\ub2e4."
        }
      ],
      "hint": "\uc2e0\uc6a9 \uc815\ubcf4 \ubcf4\ud638, \uc2e0\uc6d0 \uc99d\uba85, \uac70\ub798 \ub0b4\uc5ed\uc758 \uc548\uc804\ud55c \ub514\uc9c0\ud138 \uae30\ub85d \ubcf4\uad00\uacfc \uad00\ub828\ub41c \uae30\uc220\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc591\ud55c \ubd84\uc57c\uc5d0 \ub514\uc9c0\ud138 \uae30\uc220\uc774 \uc811\ubaa9\ub41c \uc0ac\ub840\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc62c\ubc14\ub974\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc694\uc2dd\uc5c5 \ubd84\uc57c\uc5d0\uc11c\ub294 \ub85c\ubd07\uc774 \ud280\uae40 \uc791\uc5c5\uc744 \uc218\ud589\ud568\uc73c\ub85c\uc368 \uade0\uc9c8\ud55c \ub9db\uc744 \ub0b4\uace0 \uc694\ub9ac\uc0ac\uc758 \ud654\uc0c1\uc774\ub098 \ud638\ud761\uae30 \uc9c8\ud658 \uc704\ud5d8\uc744 \uc904\uc5ec\uc900\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc694\uc2dd\uc5c5 \ub85c\ubd07 \ub3c4\uc785\uc740 \ub9e4\ub274\uc5bc\uc5d0 \ub530\ub978 \uc815\ud655\ud55c \uc870\ub9ac\ub85c \uade0\uc9c8\ud55c \ub9db\uc744 \uc81c\uacf5\ud558\uace0 \uc694\ub9ac\uc0ac\uc758 \uc704\ud5d8 \ubd80\ub2f4\uc744 \ub0ae\ucdb0\uc900\ub2e4."
        },
        {
          "text": "\uc2a4\ud3ec\uce20 \ubd84\uc57c\uc5d0\uc11c\ub294 \uc120\uc218\ub4e4\uc758 \ub2ec\ub9ac\uae30 \uc18d\ub3c4, \uacf5\uc758 \ud68c\uc804\uc218 \ub4f1 \ub370\uc774\ud130 \ubd84\uc11d\uc744 \ud1b5\ud574 \uc120\uc218 \ucee8\ub514\uc158\uc744 \uce21\uc815\ud558\uace0 \uacbd\uae30 \uc804\ub7b5\uc744 \uc218\ub9bd\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ud3ec\uce20 \ubd84\uc57c\uc5d0\uc11c\ub294 \uc138\ubc00\ud55c \ub370\uc774\ud130 \ubd84\uc11d\uc744 \ud65c\uc6a9\ud574 \uc120\uc218 \uad00\ub9ac\uc640 \uc815\uad50\ud55c \uc804\ub7b5 \uc218\ub9bd\uc774 \uc774\ub8e8\uc5b4\uc9c4\ub2e4."
        },
        {
          "text": "\uc758\ub8cc \ubd84\uc57c\uc5d0\uc11c\ub294 \ucea1\uc290 \ub0b4\uc2dc\uacbd\uc744 \ud65c\uc6a9\ud574 \uc18c\ud654\uad00 \ub0b4\ubd80\ub97c \ud655\uc778\ud558\uba70, \uac00\uc0c1 \ud604\uc2e4(VR) \uae30\uc220\uc744 ADHD\ub098 \uc57d\ubb3c \uc911\ub3c5 \uce58\ub8cc\uc5d0 \ud65c\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc758\ub8cc \ud604\uc7a5\uc5d0\uc11c\ub294 \uac00\uc0c1 \ud604\uc2e4 \ubc0f \ubaa8\ubc14\uc77c \uae30\uc220, \ucea1\uc290 \ub0b4\uc2dc\uacbd \ub4f1\uc744 \uc885\ud569\uc801\uc73c\ub85c \uce58\ub8cc\uc640 \uc9c4\ub2e8\uc5d0 \uc801\uc6a9\ud55c\ub2e4."
        },
        {
          "text": "\uc81c\uc870 \ubd84\uc57c\uc5d0\uc11c\ub294 \uc791\uc5c5\uc790\uac00 \uc99d\uac15 \ud604\uc2e4(AR) \uae30\uc220\ub85c \ubd80\ud488\uacfc \ub3c4\uba74\uc744 \ud655\uc778\ud558\uc9c0\ub9cc, \uc790\ub3d9\ucc28 \uad6c\uc870 \uac80\ud1a0\ub294 \ubc18\ub4dc\uc2dc \uc2e4\ubb3c \uc2dc\uc81c\ud488 \uc81c\uc791\uc744 \ud1b5\ud574\uc11c\ub9cc \uc774\ub8e8\uc5b4\uc9c4\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub514\uc790\uc774\ub108\ub294 \uc2e4\ubb3c \uc81c\uc791 \uc5c6\uc774\ub3c4 \uac00\uc0c1 \ud658\uacbd(VR)\uc5d0\uc11c \uc790\ub3d9\ucc28\uc758 \ub514\uc790\uc778\uacfc \uad6c\uc870\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uac80\ud1a0\ud558\uace0 \uc218\uc815\ud560 \uc218 \uc788\ub2e4."
        }
      ],
      "hint": "\uc790\ub3d9\ucc28 \ub514\uc790\uc778 \uac80\ud1a0 \ub2e8\uacc4\uc5d0\uc11c \uac00\uc0c1 \ud658\uacbd \uae30\uc220\uc774 \uc5b4\ub5bb\uac8c \uc4f0\uc774\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub514\uc9c0\ud138 \uae30\uc220 \uad00\ub828 \ubbf8\ub798 \uc9c1\uc5c5\uacfc \ud574\ub2f9 \uc9c1\uc5c5\uc774 \uc218\ud589\ud558\ub294 \uc5ed\ud560\uc758 \uc5f0\uacb0\uc774 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub370\uc774\ud130 \uacfc\ud559\uc790 - \ub300\ub7c9\uc758 \ub370\uc774\ud130\ub97c \uc218\uc9d1\u00b7\ubd84\uc11d\ud558\uc5ec \uae30\uc5c5\uc774\ub098 \uc870\uc9c1\uc758 \uc758\uc0ac \uacb0\uc815\uc5d0 \ub3c4\uc6c0\uc744 \uc900\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub300\uaddc\ubaa8 \ube45\ub370\uc774\ud130 \ubd84\uc11d\uc744 \ubc14\ud0d5\uc73c\ub85c \uc870\uc9c1\uc758 \ubb38\uc81c \ud574\uacb0 \ubc0f \ud569\ub9ac\uc801 \uc758\uc0ac \uacb0\uc815\uc744 \uc9c0\uc6d0\ud558\ub294 \ud575\uc2ec \uc5c5\ubb34\ub97c \ub9e1\ub294\ub2e4."
        },
        {
          "text": "\uc0ac\ubb3c \uc778\ud130\ub137 \uac1c\ubc1c\uc790 - \ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305 \ud658\uacbd\uc5d0\uc11c \uc791\ub3d9\ud558\ub294 \uc11c\ube44\uc2a4\uc758 \uc124\uacc4, \uad6c\ucd95 \ubc0f \uc720\uc9c0\u00b7\ubcf4\uc218\ub97c \ub2f4\ub2f9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud074\ub77c\uc6b0\ub4dc \ud658\uacbd \uc2dc\uc2a4\ud15c\uc744 \uc124\uacc4\ud558\uace0 \uc720\uc9c0\u00b7\ubcf4\uc218\ud558\ub294 \uc5ed\ud560\uc740 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4 \uae30\uc220\uc790\uc758 \uc5c5\ubb34\uc774\ub2e4."
        },
        {
          "text": "\ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4 \uae30\uc220\uc790 - \uc2e4\uc81c \uc138\uacc4\uc640 \ub514\uc9c0\ud138 \uc138\uacc4\ub97c \ud63c\ud569\ud558\uc5ec \uc0ac\uc6a9\uc790\uac00 \uac00\uc0c1 \ud658\uacbd\uc5d0\uc11c \uacbd\ud5d8\ud560 \uc218 \uc788\ub294 \uc2dc\uc2a4\ud15c\uc744 \uac1c\ubc1c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud604\uc2e4\uacfc \ub514\uc9c0\ud138\uc744 \ud63c\ud569\ud558\uc5ec \uac00\uc0c1 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\ub294 \uc2dc\uc2a4\ud15c \uac1c\ubc1c\uc740 \uac00\uc0c1(\uc99d\uac15) \ud604\uc2e4 \uc124\uacc4\uc790\uc758 \uc5ed\ud560\uc774\ub2e4."
        },
        {
          "text": "\uac00\uc0c1(\uc99d\uac15) \ud604\uc2e4 \uc124\uacc4\uc790 - \uc0ac\ubb3c \uac04\uc758 \uc778\ud130\ub137 \uc5f0\uacb0\uacfc \ud1b5\uc2e0\uc744 \uad00\ub9ac\ud558\ub294 \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \ubc0f \uc2dc\uc2a4\ud15c\uc744 \uac1c\ubc1c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ubb3c \uac04 \ub124\ud2b8\uc6cc\ud06c \uc5f0\uacb0\uacfc \ud1b5\uc2e0 \uc2dc\uc2a4\ud15c\uc744 \uac1c\ubc1c\ud558\ub294 \uc77c\uc740 \uc0ac\ubb3c \uc778\ud130\ub137 \uac1c\ubc1c\uc790\uc758 \uc5ed\ud560\uc774\ub2e4."
        }
      ],
      "hint": "\ube45\ub370\uc774\ud130 \uc218\uc9d1 \ubc0f \ubd84\uc11d\uc744 \ud1b5\ud55c \uc758\uc0ac \uacb0\uc815 \uc9c0\uc6d0 \uc5c5\ubb34\ub97c \uc8fc\ub3c4\ud558\ub294 \uc9c1\ubb34\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc778\uacf5\uc9c0\ub2a5(AI) \uae30\ubc18 \ub300\ud654\ud615 \uc0c1\ub2f4 \uc2dc\uc2a4\ud15c(\ucc57\ubd07)\uc758 \ub3c4\uc785\uc774 \uae30\uc5c5\uacfc \uc0c1\ub2f4 \uc11c\ube44\uc2a4 \ubd84\uc57c\uc5d0 \uac00\uc838\uc628 \ubcc0\ud654\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubaa8\ub4e0 \uc0c1\ub2f4 \uc5c5\ubb34\uac00 \uc778\uacf5\uc9c0\ub2a5\uc73c\ub85c \uc644\uc804 \ub300\uccb4\ub418\uc5b4 \uc0ac\ub78c \uc0c1\ub2f4\uc6d0\uc774\ub77c\ub294 \uc9c1\ubb34 \uc790\uccb4\uac00 \uc804\uba74 \ud3d0\uc9c0\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc57\ubd07 \ub3c4\uc785\uc740 \uc5c5\ubb34 \uc5ed\ud560\uc744 \uc7ac\uc815\ub9bd\ud560 \ubfd0, \uace0\ub3c4\ud654\ub41c \ud310\ub2e8\uc744 \uc694\ud558\ub294 \uc0ac\ub78c \uc0c1\ub2f4\uc6d0\uc758 \uc5ed\ud560\uc744 \uc644\uc804\ud788 \ub300\uccb4\ud558\uc9c0\ub294 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\ub2e8\uc21c \ubc18\ubcf5\uc801\uc778 \uc0c1\ub2f4\uc740 \uc778\uacf5\uc9c0\ub2a5\uc774 \ub2f4\ub2f9\ud558\uace0, \uc0ac\ub78c\uc740 \uace0\ub3c4\ud654\ub41c \ud310\ub2e8\uacfc \ubcf5\uc7a1\ud55c \ubb38\uc81c \ud574\uacb0\uc744 \uc694\uad6c\ud558\ub294 \uc0c1\ub2f4\uc5d0 \uc9d1\uc911\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "AI \uc2dc\uc2a4\ud15c\uc774 \uc815\ud615\ud654\ub41c \uc5c5\ubb34\ub97c \ucc98\ub9ac\ud568\uc73c\ub85c\uc368 \uc0ac\ub78c \uc0c1\ub2f4\uc6d0\uc740 \uac00\uce58 \ub192\uace0 \uace0\ucc28\uc6d0\uc801\uc778 \uc0c1\ub2f4 \uc791\uc5c5\uc5d0 \uc9d1\uc911\ud558\ub294 \ud611\ub825 \uccb4\uacc4\ub97c \uad6c\ucd95\ud55c\ub2e4."
        },
        {
          "text": "\ucc57\ubd07\uc758 \ub3c4\uc785\uc73c\ub85c \uc18c\ube44\uc790\ub294 \ud2b9\uc815 \uc601\uc5c5 \uc2dc\uac04\uc5d0\ub9cc \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\uac8c \ub418\uc5b4 \uc811\uadfc\uc131\uc774 \uc81c\ud55c\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub300\ud654\ud615 \uc2dc\uc2a4\ud15c\uc744 \ud65c\uc6a9\ud558\uba74 \uc18c\ube44\uc790\ub294 \uc2dc\uacf5\uac04 \uc81c\uc57d \uc5c6\uc774 24\uc2dc\uac04 \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\ub2e4."
        },
        {
