          "text": "\uac1c\uc778\uc801\uc778 \uc57c\uc678 \ucd2c\uc601 \ub3c4\uc911 \ubd88\ud2b9\uc815 \ub2e4\uc218\uc758 \uc5bc\uad74\uc774 \uc6b0\uc5f0\ud788 \ucd2c\uc601\ub41c \uacbd\uc6b0\uc5d0\ub294 \ucd08\uc0c1\uad8c \ubcf4\ud638 \ub300\uc0c1\uc5d0\uc11c \uc644\uc804\ud788 \uc81c\uc678\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc758\ub3c4\uce58 \uc54a\uac8c \ucd2c\uc601\ub418\uc5c8\ub354\ub77c\ub3c4 \ud0c0\uc778\uc758 \uc5bc\uad74\uc774 \uba85\ud655\ud788 \ub178\ucd9c\ub41c \ucf58\ud150\uce20\ub97c \ud5c8\ub77d \uc5c6\uc774 \uacf5\uc720\ud558\uba74 \ucd08\uc0c1\uad8c \uce68\ud574 \ubb38\uc81c\uac00 \ub41c\ub2e4."
