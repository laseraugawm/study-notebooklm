    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\ubd80\ud130 100\uae4c\uc9c0 \ud569\uc744 \uad6c\ud560 \ub54c, \uc21c\ucc28\uc801\uc73c\ub85c \uc22b\uc790\ub97c \ub354\ud558\ub294 \ubc29\uc2dd\uc758 \ub2e8\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
