      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub354\ud558\ub294 \uc22b\uc790\uc758 \uac1c\uc218\uac00 \ub298\uc5b4\ub0a0\uc218\ub85d \ub367\uc148 \uc5f0\uc0b0 \ud69f\uc218\uac00 \uc99d\uac00\ud558\uc5ec \uc218\ud589 \uc2dc\uac04\uc774 \uae38\uc5b4\uc9c4\ub2e4."
