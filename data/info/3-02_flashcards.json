    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\ubd80\ud130 100\uae4c\uc9c0 \ud569\uc744 \uad6c\ud558\ub294 \uc5f0\uc0b0\uc2dd\uc744 $101 \\times 100 \\div 2$ \ub85c \uacc4\uc0b0\ud558\ub294 \ubc29\ubc95\uc774 \uc77c\uc815\ud55c \uc218\ud589 \uc2dc\uac04\uc744 \uac16\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
