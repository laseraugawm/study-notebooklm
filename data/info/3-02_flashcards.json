      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\uc758 \uc591\uacfc \uad00\uacc4\uc5c6\uc774 \ub367\uc148, \uacf1\uc148, \ub098\ub217\uc148 \uc5f0\uc0b0\uc744 \uac01\uac01 \ud55c \ubc88\uc529\ub9cc \uc218\ud589\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
