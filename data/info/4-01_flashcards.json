    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd5c\uadfc \uc778\uacf5\uc9c0\ub2a5\uc744 \uc815\uc758\ud560 \ub54c \uc8fc\ub41c \uad00\uc810\uc774 \ub418\ub294 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
