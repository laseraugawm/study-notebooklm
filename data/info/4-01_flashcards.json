    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ub78c\uc744 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub77c\uace0 \ud560 \uc218 \uc788\ub294 \uc774\uc720\ub294 \ub450\ub1cc\uc758 \uc5b4\ub5a4 \uc791\ub3d9 \ubc29\uc2dd \ub54c\ubb38\uc778\uac00?"
