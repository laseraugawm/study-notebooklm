    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5\uc744 \"\uc778\uc9c0\ud558\uace0 \ucd94\ub860\ud558\uace0 \ud310\ub2e8\ud558\ub294 \uac83\uc774 \uac00\ub2a5\ud558\ub3c4\ub85d \ud558\ub294 \ucef4\ud4e8\ud130 \uacfc\ud559 \ubd84\uc57c\"\ub85c \uc815\uc758\ud55c \ud559\uc790\ub294 \ub204\uad6c\uc778\uac00?"
