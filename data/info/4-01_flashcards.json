          {
            "type": "text",
            "content": "\uac8c\uc784 AI\uc5d0\uc11c \uc774\uc6a9\uc790\uc758 \uc218\uc900\uc5d0 \ub9de\ucd94\uc5b4 \ub09c\uc774\ub3c4\ub97c \uc870\uc808\ud558\uace0 \uce90\ub9ad\ud130\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \uac83\uc740 \ubb34\uc5c7\uc744 \ud65c\uc6a9\ud55c \uac83\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uacc4\ud559\uc2b5 \uae30\ubc18 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \uae30\uc220"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uac00 \ud658\uacbd\uc5d0 \ubc18\uc751\ud560 \ub54c \uc8fc\ubcc0 \ubcc0\ud654\uc5d0 \ubc18\uc751\ud558\uc5ec \uc2a4\uc2a4\ub85c \ud589\ub3d9\uc744 \uc870\uc815\ud558\ub294 \uc131\uc9c8\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc801\uc751\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \uc2dc\uc2a4\ud15c(AI System)\uacfc \uc778\uacf5\uc9c0\ub2a5 \uae30\uc220(AI Technology)\uc758 \uac1c\ub150 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \uae30\uc220\uc740 \uc9c0\ub2a5\uc801 \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub97c \uc124\uacc4\ud558\uace0 \ub9cc\ub4dc\ub294 \uae30\uc220\uc774\uba70, \uc778\uacf5\uc9c0\ub2a5 \uc2dc\uc2a4\ud15c\uc740 \uadf8 \uae30\uc220\uc744 \uc801\uc6a9\ud574 \ub9cc\ub4e0 \uc81c\ud488\uc774\ub098 \uc11c\ube44\uc2a4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc99d\uad8c \uac70\ub798\uc778\uc774 \uacbd\uc81c \uc9c0\ud45c\ub97c \uad00\ucc30\ud558\uc5ec \uc8fc\uc2dd\uc744 \uac70\ub798\ud558\ub294 \uacfc\uc815\uc744 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc5d0 \ube44\uc720\ud560 \ub54c, \uacbd\uc81c \uc9c0\ud45c\ub294 \ubb34\uc5c7\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\ubd80 \ud658\uacbd \uc785\ub825 (\uc13c\uc11c\ub85c \uc778\uc9c0\ud558\ub294 \uc815\ubcf4)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc131\ud615 AI \uc11c\ube44\uc2a4\uac00 \uc774\uc6a9\uc790 100\ub9cc \uba85\uc744 \ub2ec\uc131\ud558\ub294 \uc18c\uc694 \uae30\uac04\uc774 \uae30\uc874 \uc11c\ube44\uc2a4\uc5d0 \ube44\ud574 \uc9e7\uc544\uc9c4 \uac83\uc740 \ubb34\uc5c7\uc744 \uc758\ubbf8\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc131\ud615 AI \uae30\uc220\uc758 \ub300\uc911\uc801 \ud30c\uae09\ub825\uacfc \uc218\uc6a9 \uc18d\ub3c4\uac00 \ub9e4\uc6b0 \ube60\ub974\uac8c \uc9c4\ud589\ub428\uc744 \uc758\ubbf8\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\ubd07 \uccad\uc18c\uae30\uac00 \ubc14\ub2e5\uc758 \ubc18\uc9dd\uc774\ub294 \ubb3c\uccb4\ub97c \ubc1c\uacac\ud558\uace0 \"\uc4f0\ub808\uae30\uac00 \uc544\ub2c8\uc57c\"\ub77c\uace0 \ud310\ub2e8\ud558\uc5ec \ub418\ub3cc\uc544\uac00\ub294 \uacfc\uc815\uc740 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uc5b4\ub290 \ub2e8\uacc4\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ud669 \ud310\ub2e8 \ubc0f \ud589\ub3d9 \uacb0\uc815"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e8\uc77c \uc5d0\uc774\uc804\ud2b8\uc640 \ube44\uad50\ud560 \ub54c \ub2e4\uc911 \uc5d0\uc774\uc804\ud2b8\uac00 \uac00\uc9c4 \uace0\uc720\ud55c \uc0c1\ud638 \uc791\uc6a9 \ubc29\uc2dd 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc7c1\uacfc \ud611\ub825"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\uac00 \uc2a4\ucfe8\uc874 \uc9c4\uc785 \uc2dc \uc18d\ub3c4\ub97c \uc904\uc774\uace0 \ud3ed\uc6b0 \ubc1c\uc0dd \uc2dc \uacbd\ub85c\ub97c \uc7ac\uc124\uc815\ud558\ub294 \uac83\uc740 \uc5d0\uc774\uc804\ud2b8\uc758 \uc5b4\ub5a4 \ud2b9\uc131 \ub54c\ubb38\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd \ubcc0\ud654\uc5d0 \ub300\ucc98\ud558\ub294 \uc801\uc751\uc131 \ubc0f \ubaa9\uc801 \ub2ec\uc131\uc744 \uc704\ud55c \uc790\uc728\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uacc4\ud559\uc2b5\uc5d0\uc11c '\ubaa8\ub378(Model)'\uc774\ub780 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucef4\ud4e8\ud130\uac00 \uc218\ub9ce\uc740 \ub370\uc774\ud130\ub97c \ud559\uc2b5\ud558\uc5ec \uc0c8\ub85c\uc6b4 \ub370\uc774\ud130\uc5d0 \ub300\ud55c \uc608\uce21 \ubc0f \ud310\ub2e8\uc744 \uc218\ud589\ud560 \uc218 \uc788\ub3c4\ub85d \ud615\uc131\ub41c \uacb0\uacfc \uad6c\uc870\uccb4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc131\ud615 AI \uae30\uc220\uc774 \ub514\uc790\uc778, \ub9c8\ucf00\ud305, \ubc88\uc5ed, \ud504\ub85c\uadf8\ub798\ubc0d, \uad11\uace0 \ub4f1 \ub2e4\uc591\ud55c \ubd84\uc57c\uc5d0 \ud65c\uc6a9\ub418\ub294 \uc774\uc720\ub97c \uae30\uc220\uc801 \ud2b9\uc131\uacfc \uc5f0\uad00\uc9c0\uc5b4 \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uacc4\ud559\uc2b5 \ubaa8\ub378\uc744 \uae30\ubc18\uc73c\ub85c \uc0ac\ub78c\uc758 \uc9c8\uc758\uc640 \ud14d\uc2a4\ud2b8 \ubb38\ub9e5\uc744 \uc774\ud574\ud558\uace0 \uc0c8\ub85c\uc6b4 \uae00, \uc774\ubbf8\uc9c0, \ucf54\ub4dc \ub4f1\uc758 \ucf58\ud150\uce20\ub97c \uc9c1\uc811 \ub2e4\ubc29\uba74\uc73c\ub85c \uc0dd\uc131\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    }
  ]
}