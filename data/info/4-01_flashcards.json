    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18 \uc5d0\uc774\uc804\ud2b8\uc640 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uacb0\uc815\uc801\uc778 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\ubc18 \uc5d0\uc774\uc804\ud2b8\ub294 '\uc124\uc815\ub41c \uaddc\uce59'\uc5d0 \ub530\ub77c \ud589\ub3d9\ud558\uc9c0\ub9cc, \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 '\ud559\uc2b5\uacfc \ucd94\ub860'\uc73c\ub85c \uc2a4\uc2a4\ub85c \ud589\ub3d9\uc744 \uac1c\uc120\ud558\uac70\ub098 \uc0c8\ub85c\uc6b4 \uaddc\uce59\uacfc \uc804\ub7b5\uc744 \ub9cc\ub4e4\uc5b4 \ub300\uc751\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc29 \uc548\uc758 \uc628\ub3c4 \uc870\uc808\uae30\uac00 \uc628\ub3c4\ub97c \uac10\uc9c0\ud558\uc5ec \ub09c\ubc29\uc744 \ucf1c\uace0 \ub044\uc9c0\ub9cc \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uac00 \uc544\ub2cc \uc77c\ubc18 \uc5d0\uc774\uc804\ud2b8\ub85c \ubd84\ub958\ub418\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\uc2a4\ub85c \ud559\uc2b5\u00b7\ucd94\ub860\ud558\uc9c0 \uc54a\uace0 \ub2e8\uc9c0 \ub2e8\uc21c\ud558\uac8c \uc124\uc815\ub41c \uac12\uacfc \uce21\uc815\uac12\uc744 \ube44\uad50\ud558\ub294 \uaddc\uce59\uc5d0 \ub530\ub77c \ud589\ub3d9\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
