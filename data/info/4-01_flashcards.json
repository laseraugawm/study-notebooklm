      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uad00\uc810 (\uc8fc\ubcc0 \uc0c1\ud669\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\uba70 \uc790\uc728\uc801\uc774\uace0 \uc9c0\ub2a5\uc801\uc778 \ud310\ub2e8\uc73c\ub85c \uc8fc\uc5b4\uc9c4 \ubaa9\ud45c\ub97c \uc774\ub8e8\ub294 \uad00\uc810)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub204\uad70\uac00\ub97c \ub300\uc2e0\ud558\uc5ec \uc8fc\uc5b4\uc9c4 \ud658\uacbd\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\uba70 \uc5b4\ub5a4 \ubaa9\uc801\uc744 \uc704\ud574 \uc790\uc728\uc801\uc73c\ub85c \ud589\ub3d9\ud558\ub294 \uc2dc\uc2a4\ud15c\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
