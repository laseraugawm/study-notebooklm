      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ub78c\uc758 \ub450\ub1cc\uac00 \uc678\ubd80 \ud658\uacbd\uacfc \uc9c0\uc18d\uc801\uc73c\ub85c \uc0c1\ud638 \uc791\uc6a9\ud558\uba74\uc11c \uc0c1\ud669\ub9c8\ub2e4 \uc9c0\ub2a5\uc801\uc778 \ud310\ub2e8\uacfc \uacb0\uc815\uc744 \ubc18\ubcf5\ud558\uc5ec \ucd5c\uc885 \ubaa9\uc801\uc744 \ub2ec\uc131\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
