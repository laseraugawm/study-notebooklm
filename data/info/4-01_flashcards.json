    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5\uc744 \"\uc8fc\uc5b4\uc9c4 \ud658\uacbd\uc5d0\uc11c \uc2a4\uc2a4\ub85c \ucd5c\uc801\uc758 \ud589\ub3d9\uc744 \uacb0\uc815\ud558\ub294 \uc9c0\ub2a5\ud615 \uc5d0\uc774\uc804\ud2b8\ub97c \ub9cc\ub4dc\ub294 \ud559\ubb38\"\uc73c\ub85c \uc815\uc758\ud55c \ud559\uc790\ub294 \ub204\uad6c\uc778\uac00?"
          }
