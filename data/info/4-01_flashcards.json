    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc57c\uad6c \ucf54\uce58\uac00 \ud22c\uc218\uc758 \ud22c\uad6c \ubaa8\uc2b5\uc744 \uad00\ucc30\ud574 \uace0\uce60 \uc810\uc744 \ud30c\uc545\ud558\ub294 \uacfc\uc815\uc740 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uc5b4\ub5a4 \ud2b9\uc9d5\uc744 \ubcf4\uc5ec\uc8fc\ub294\uac00?"
