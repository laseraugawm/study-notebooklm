      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\ubd80 \ud658\uacbd\uc744 \uc778\uc9c0 \ubc0f \uad00\ucc30\ud558\uace0 \ubd84\uc11d\u00b7\ucd94\ub860\ud558\uc5ec \uc9c0\ub2a5\uc801\uc73c\ub85c \uc218\uc815 \ud589\ub3d9\uc744 \uacb0\uc815\ud558\ub294 \ud2b9\uc131"
