{
  "title": "IoT Flashcards",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud65c \uc18d \uc0ac\ubb3c \uc778\ud130\ub137(IoT)\uc744 \uad6c\uc131\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c 3\uac00\uc9c0 \uae30\ubcf8 \uc7a5\uce58\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc13c\uc11c, \ud1b5\uc2e0 \uc7a5\uce58, \ucc98\ub9ac \uc7a5\uce58(\uc81c\uc5b4 \uc7a5\uce58)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137 \uad6c\uc131 \uc694\uc18c \uc911 \uc8fc\ubcc0\uc758 \uc628\ub3c4, \ube5b, \uc18c\ub9ac \ub4f1 \ud658\uacbd \uc0c1\ud669\uc744 \uc778\uc2dd\ud558\ub294 \uc7a5\uce58\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc13c\uc11c(Sensor)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137 \uad6c\uc131 \uc694\uc18c \uc911 \uc0ac\ubb3c \uac04 \ub370\uc774\ud130\ub97c \uc8fc\uace0\ubc1b\uc744 \uc218 \uc788\ub3c4\ub85d \uc0c1\ud638 \uc5f0\uacb0\ud574 \uc8fc\ub294 \uc7a5\uce58\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud1b5\uc2e0 \uc7a5\uce58"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137 \uad6c\uc131 \uc694\uc18c \uc911 \uc13c\uc11c\ub85c \uc785\ub825\ub41c \uc815\ubcf4\ub97c \ubd84\uc11d \ubc0f \ud310\ub2e8\ud558\uc5ec \uc0ac\ubb3c\uc744 \ub3d9\uc791\uc2dc\ud0a4\ub294 \uc7a5\uce58\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc98\ub9ac \uc7a5\uce58(\uc81c\uc5b4 \uc7a5\uce58)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8(micro:bit) v2\uc5d0 \ub0b4\uc7a5\ub418\uc5b4 \uc788\ub294 \ub300\ud45c\uc801\uc778 \uc785\ub825 \uc13c\uc11c 4\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube5b \uc13c\uc11c, \uc628\ub3c4 \uc13c\uc11c, \uac00\uc18d\ub3c4 \uc13c\uc11c, \uc18c\ub9ac \uac10\uc9c0 \uc13c\uc11c(\ub0b4\uc7a5 \ub9c8\uc774\ud06c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uc5d0 \ub0b4\uc7a5\ub418\uc5b4 \uc2dc\uac01 \ubc0f \uccad\uac01 \uc815\ubcf4\ub97c \ucd9c\ub825\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc7a5\uce58 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "LED \ud654\uba74(25\uac1c\uc758 LED), \uc2a4\ud53c\ucee4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \ud504\ub85c\uadf8\ub7a8\uc744 \uc791\uc131\ud560 \uc218 \uc788\ub294 \ub450 \uac00\uc9c0 \ub300\ud45c\uc801\uc778 \ucf54\ub529 \ubc29\uc2dd \ubc0f \uc5d0\ub514\ud130\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube14\ub85d \uae30\ubc18 \ud504\ub85c\uadf8\ub798\ubc0d(MakeCode editor), \ud14d\uc2a4\ud2b8 \uae30\ubc18 \ud504\ub85c\uadf8\ub798\ubc0d(Python editor)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\ub97c \ud65c\uc6a9\ud558\uc5ec \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub294 5\ub2e8\uacc4 \uc808\ucc28\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc81c \uc815\uc758\ud558\uae30 \u2192 \uc7a5\uce58 \uad6c\uc131\ud558\uae30 \u2192 \uc54c\uace0\ub9ac\uc998 \uc124\uacc4\ud558\uae30 \u2192 \ud504\ub85c\uadf8\ub798\ubc0d\ud558\uae30 \u2192 \uc2e4\ud589\ud558\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \ub0b4\uc7a5 \ub9c8\uc774\ud06c\uac00 \uc778\uc2dd\ud558\ub294 \uc18c\ub9ac \ud06c\uae30\uc758 \uc218\uce58 \ubc94\uc704\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "0 ~ 255"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc190\ubf09\uc744 \uccd0\uc11c \uc804\ub4f1\uc744 \ucf1c\uace0 \ub044\ub294 \uc2e4\uc2b5\uc5d0\uc11c \uc0ac\uc6a9\ub418\ub294 \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uc758 \uc785\ub825 \uc7a5\uce58\uc640 \ucd9c\ub825 \uc7a5\uce58\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\ub825 \uc7a5\uce58: \uc18c\ub9ac \uac10\uc9c0 \uc13c\uc11c(\ub0b4\uc7a5 \ub9c8\uc774\ud06c) / \ucd9c\ub825 \uc7a5\uce58: LED(25\uac1c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc190\ubf09 \uc18c\ub9ac\ub97c \uac10\uc9c0\ud558\uc5ec \uc804\ub4f1\uc758 \uc628/\uc624\ud504 \uc0c1\ud0dc\ub97c \uae30\uc5b5\ud558\uace0 \uc804\ud658(\ud1a0\uae00)\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ub418\ub294 \ud504\ub85c\uadf8\ub798\ubc0d \uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc0\uc218 (\uc608: \ucd08\uae43\uac12\uc744 0\uc73c\ub85c \uc9c0\uc815\ud55c tag \ubcc0\uc218)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc15\uc218\ub97c \ud55c \ubc88 \ucce4\uc744 \ub54c \uc5ec\ub7ec \ubc88 \uccd0\uc9c4 \uac83\uc73c\ub85c \uc911\ubcf5 \uc778\uc2dd\ub418\uc9c0 \uc54a\ub3c4\ub85d \uc54c\uace0\ub9ac\uc998\uc5d0 \ucd94\uac00\ud558\ub294 \ucc98\ub9ac \uc870\uac74\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ub9ac\ub97c \uc778\uc2dd\ud55c \uc9c1\ud6c4 0.5\ucd08(500ms) \ub3d9\uc548 \uc77c\uc2dc \uc911\uc9c0(\uba48\ucda4)\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \uc2dc\ubbac\ub808\uc774\ud130\ub85c \uc18c\ub9ac \uc81c\uc5b4 \ucf54\ub4dc\ub97c \ud14c\uc2a4\ud2b8\ud560 \ub54c LED\uac00 \ubc18\ubcf5\ud574\uc11c \uae5c\ube61\uc774\uc9c0 \uc54a\uac8c \ud558\ub824\uba74 \uc18c\ub9ac \ud06c\uae30\ub97c \uc5b4\ub5bb\uac8c \uc870\uc808\ud574\uc57c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ub9ac \ud06c\uae30\ub97c \uc7a0\uc2dc \ub3d9\uc548 100 \uc774\uc0c1\uc73c\ub85c \uc62c\ub838\ub2e4\uac00 \ube60\ub974\uac8c 100 \uc774\ud558\ub85c \ub0b4\ub824\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc74c\uc2dd\uc810 \ud638\ucd9c \uc7a5\uce58 \uc2e4\uc2b5\uc5d0\uc11c \ud14c\uc774\ube14\uc6a9 \uc7a5\uce58\uc640 \ud45c\uc2dc\uc6a9 \uc7a5\uce58 \uac04\uc758 \ubb34\uc120 \uc2e0\ud638 \uc1a1\uc218\uc2e0\uc744 \ub2f4\ub2f9\ud558\ub294 \ub0b4\uc7a5 \uc7a5\uce58\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub77c\ub514\uc624 \uc7a5\uce58(\ub77c\ub514\uc624 \ud1b5\uc2e0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ub7ec \ubaa8\ub460\uc774 \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \ub77c\ub514\uc624 \ud1b5\uc2e0\uc744 \uc0ac\uc6a9\ud560 \ub54c \ud0c0 \ubaa8\ub460\uacfc\uc758 \uc2e0\ud638 \ud63c\uc120\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc124\uc815\ud558\ub294 \uc18d\uc131\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub77c\ub514\uc624 \uadf8\ub8f9(Radio Group) \ubc88\ud638 (\ubaa8\ub460\ubcc4\ub85c \ub2e4\ub974\uac8c \uc9c0\uc815)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc74c\uc2dd\uc810 \ud638\ucd9c \uc7a5\uce58 \uc2e4\uc2b5\uc5d0\uc11c \ud14c\uc774\ube14\uc6a9 \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uc758 A \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \uc77c\uc5b4\ub098\ub294 \ub450 \uac00\uc9c0 \uc8fc\uc694 \ub3d9\uc791\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\ub2f9 \ud14c\uc774\ube14 \ubc88\ud638\ub97c \ub77c\ub514\uc624 \uc2e0\ud638\ub85c \uc1a1\ucd9c\ud558\uace0, \uc1a1\ucd9c \ud655\uc778\uc744 \uc704\ud574 LED\uc5d0 'V' \ud45c\uc2dc\ub97c 1\ucd08\uac04 \ub744\uc6b4\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc74c\uc2dd\uc810 \ud638\ucd9c \uc7a5\uce58 \uc2e4\uc2b5\uc5d0\uc11c \ud45c\uc2dc\uc6a9 \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uac00 \ud14c\uc774\ube14\uc6a9 \uc7a5\uce58\ub85c\ubd80\ud130 \ub77c\ub514\uc624 \uc2e0\ud638\ub97c \ubc1b\uc558\uc744 \ub54c \uc218\ud589\ud558\ub294 \ub450 \uac00\uc9c0 \ucd9c\ub825 \ub3d9\uc791\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc2e0\ud55c \ud14c\uc774\ube14 \ubc88\ud638\ub97c LED\uc5d0 1\ucd08\uac04 \ucd9c\ub825\ud558\uace0, \uc2a4\ud53c\ucee4\ub85c \"\ub529\ub3d9\" \uc18c\ub9ac('\uc194', '\ubbf8' \uc74c)\ub97c \ub0b8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\ud589 \uc2e0\ud638\ub4f1 \uc7a5\uce58\uac00 \ud734\ub300 \uc804\ud654 \uc7a5\uce58\ub85c 1\ucd08 \uac04\uaca9\uc758 \uce74\uc6b4\ud2b8\ub2e4\uc6b4 \uc2e0\ud638(10~1)\ub97c \ubcf4\ub0b4\uae30 \uc2dc\uc791\ud558\ub294 \uc2dc\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd08\ub85d\uc0c9('green') \uc2e0\ud638\uac00 \ucf1c\uc9c0\uace0 10\ucd08\uac00 \uc9c0\ub09c \ud6c4 (\ube68\uac04\uc0c9\uc73c\ub85c \ubc14\ub00c\uae30 10\ucd08 \uc804)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\ud589 \uc2e0\ud638\ub4f1 \ud734\ub300 \uc804\ud654 \uc7a5\uce58\uac00 \uce74\uc6b4\ud2b8\ub2e4\uc6b4 \uc218\uc2e0 \uc2dc \ub0a8\uc740 \uc2dc\uac04\uc5d0 \ub530\ub77c \ub2e4\ub974\uac8c \ucd9c\ub825\ud558\ub294 \uc74c\ub192\uc774\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "10\ubd80\ud130 6 \uc218\uc2e0 \uc2dc: '\ubbf8' \uc74c \ucd9c\ub825 / 5\ubd80\ud130 1 \uc218\uc2e0 \uc2dc: \ub354 \ub192\uc740 '\uc194' \uc74c \ucd9c\ub825"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\ud589 \uc2e0\ud638\ub4f1 \uce74\uc6b4\ud2b8\ub2e4\uc6b4\uc5d0\uc11c \ub9c8\uc9c0\ub9c9 5\ucd08 \ub3d9\uc548 \ub354 \ub192\uc740 \uc74c('\uc194')\uc744 \ucd9c\ub825\ud558\ub3c4\ub85d \uc124\uacc4\ud55c \uc8fc\uc694 \ubaa9\uc801\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\ud638 \ubcc0\uacbd\uc774 \uc784\ubc15\ud588\uc74c\uc744 \uc2dc\uac01 \uc7a5\uc560\uc778\uc774\ub098 \ubcf4\ud589\uc790\uc5d0\uac8c \uc18c\ub9ac\uc758 \ubcc0\ud654\ub85c \uc704\ud5d8\uc744 \uc778\uc9c0\uc2dc\ud0a4\uae30 \uc704\ud568\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud63c\uc790 \uc0dd\ud65c\ud558\uc2dc\ub294 \ud560\uba38\ub2c8\uc758 \uc704\ud5d8 \uc0c1\ud669(\ubb38 \uc6c0\uc9c1\uc784 \uc5c6\uc74c)\uc744 \uac10\uc9c0\ud558\uae30 \uc704\ud574 \ud654\uc7a5\uc2e4 \ubb38 \ubd80\ucc29 \uc7a5\uce58\uc5d0 \uc0ac\uc6a9\ub41c \ub0b4\uc7a5 \uc13c\uc11c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc18d\ub3c4 \uc13c\uc11c (x\ucd95\uac12 \uce21\uc815)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \uac00\uc18d\ub3c4 \uc13c\uc11c\uac00 \uce21\uc815\ud558\uc5ec \ucd9c\ub825\ud558\ub294 \uc218\uce58\uc758 \uc804\uccb4 \ubc94\uc704\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "-1024 ~ +1024"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc7a5\uc2e4 \ubb38 \ubd80\ucc29 \uc7a5\uce58\uc5d0\uc11c \ubb38\uc5d0 \uc6c0\uc9c1\uc784\uc774 \uc5c6\ub2e4\uace0 \ud310\ub2e8\ud558\ub294 \uac00\uc18d\ub3c4 \uc13c\uc11c \ubcc0\uc218(a, b) \ube44\uad50 \uc54c\uace0\ub9ac\uc998\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "100ms \uac04\uaca9\uc73c\ub85c \uce21\uc815\ud55c \ub450 \uac00\uc18d\ub3c4 \uc13c\uc11c\uac12\uc758 \ucc28\uc774\uc778 a - b \uac12\uc774 100\ubcf4\ub2e4 \uc791\uc744 \ub54c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "100ms \uc8fc\uae30\ub85c \uac00\uc18d\ub3c4 \uc13c\uc11c \ubcc0\ud654\ub97c \uce21\uc815\ud560 \ub54c, count \ubcc0\uc218\uac00 100\uc774 \ub418\ub294 \uac83\uc740 \uba87 \ucd08 \ub3d9\uc548 \uc6c0\uc9c1\uc784\uc774 \uc5c6\uc74c\uc744 \uc758\ubbf8\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "10\ucd08 (100ms \u00d7 100 = 10,000ms = 10\ucd08)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc704\ud5d8 \uac10\uc9c0 \uae30\uc900 \uc2dc\uac04\uc744 10\ucd08\uc5d0\uc11c 5\uc2dc\uac04\uc73c\ub85c \ub298\ub9ac\ub824\uba74, \uc54c\uace0\ub9ac\uc998\uc5d0\uc11c \ube44\uad50\ud560 count \ubaa9\ud45c\uac12\uc744 \uc5bc\ub9c8\ub85c \uc815\ud574\uc57c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "180,000 (5\uc2dc\uac04 = 18,000\ucd08\uc774\uace0 0.1\ucd08\ub9c8\ub2e4 count\uac00 1\uc529 \uc99d\uac00\ud558\ubbc0\ub85c 180,000)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc704\ud5d8 \uac10\uc9c0 \uc218\uc2e0 \uc7a5\uce58\uc5d0 'danger' \uc2e0\ud638\uac00 \uc2a4\ud06c\ub864\ub420 \ub54c, \uc0ac\uc6a9\uc790\uac00 \uc704\ud5d8 \uc0c1\ud669\uc744 \ud655\uc778\ud55c \ud6c4 \ud654\uba74\uc744 \uc9c0\uc6b0\ub294 \ubc29\ubc95\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uc758 A \ubc84\ud2bc\uc744 \ub204\ub978\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc18d\ub3c4 \uc13c\uc11c\ub098 \ub3d9\uc791 \uc13c\uc11c\ub97c \ud65c\uc6a9\ud560 \ub54c, '\uc6c0\uc9c1\uc784 \uc5c6\uc74c'\uc744 \uac10\uc9c0\ud558\ub294 \uc2dc\uc2a4\ud15c\uacfc '\uc6c0\uc9c1\uc784 \ubc1c\uc0dd'\uc744 \uac10\uc9c0\ud558\ub294 \uc2dc\uc2a4\ud15c\uc758 \uc2e4\uc0dd\ud65c \ud65c\uc6a9 \uc608\uc2dc\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6c0\uc9c1\uc784 \uc5c6\uc74c \uac10\uc9c0: \uace0\ub3c5\uc0ac/\ub3c5\uac70\ub178\uc778 \uc704\ud5d8 \ubc29\uc9c0 \uc2dc\uc2a4\ud15c / \uc6c0\uc9c1\uc784 \ubc1c\uc0dd \uac10\uc9c0: \uc678\ubd80 \uce68\uc785\uc790 \ubc29\ubc94 \uac10\uc9c0 \uc2dc\uc2a4\ud15c"
