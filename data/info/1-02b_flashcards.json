    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0b4\ubd80 \ub124\ud2b8\uc6cc\ud06c(LAN)\uc640 \uc678\ubd80 \ub124\ud2b8\uc6cc\ud06c(\uc778\ud130\ub137)\ub97c \uc5f0\uacb0\ud558\uace0 \ucd5c\uc801\uc758 \uacbd\ub85c\ub97c \uc124\uc815\ud574 \uc8fc\ub294 \uc7a5\ube44\ub294?"
