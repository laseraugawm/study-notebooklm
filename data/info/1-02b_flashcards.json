    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub124\ud2b8\uc6cc\ud06c \uad6c\uc131 \uc2dc \ub2e8\uc77c \ucf00\uc774\ube14 \uc120\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5ec\ub7ec \ub300\uc758 \ucef4\ud4e8\ud305 \uc7a5\ube44\ub97c \uc5f0\uacb0\ud574 \uc8fc\ub294 \uc7a5\uce58\ub294?"
          }
