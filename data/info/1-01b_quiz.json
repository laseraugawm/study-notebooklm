  "questions": [
    {
      "question": "\uc708\ub3c4 \uc6b4\uc601\uccb4\uc81c\uc758 \ucee4\ub9e8\ub4dc \ucc3d(cmd)\uc5d0\uc11c \ub0b4 \ucef4\ud4e8\ud130\uc5d0 \uc5f0\uacb0\ub41c IP \uc8fc\uc18c\ub97c \uc9c1\uc811 \ud655\uc778\ud558\uae30 \uc704\ud574 \uc785\ub825\ud558\ub294 \uba85\ub839\uc5b4\ub85c \uc62c\ubc14\ub978 \uac83\uc740?",
