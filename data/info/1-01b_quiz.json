      "hint": "\uc2a4\ub9c8\ud2b8\ud3f0\uc744 \uc7a1\ub294 \ubc29\ud5a5(\uac00\ub85c/\uc138\ub85c) \ubcc0\ud654\uac00 \ub514\uc2a4\ud50c\ub808\uc774 \ud654\uba74 \ud45c\uc2dc\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc778\ud130\ub137 \ub124\ud2b8\uc6cc\ud06c\uc5d0\uc11c \ud604\uc7ac \uae30\uae30 \uc2dd\ubcc4\uc744 \uc704\ud574 \uc0ac\uc6a9\ub418\uace0 \uc788\ub294 \ub300\ud45c\uc801\uc778 IP \uc8fc\uc18c \uccb4\uacc4 \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
