          "rationale": "\uc13c\uc11c\ub294 \uc8fc\ubcc0\uc758 \ubc1d\uae30, \uc6c0\uc9c1\uc784, \uc628\ub3c4, \uc2b5\ub3c4 \ub4f1\uc744 \uc790\uc728\uc801\uc73c\ub85c \uce21\uc815\ud558\uc5ec \ub370\uc774\ud130\ub97c \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc678\ubd80 \uc778\ud130\ub137 \ub124\ud2b8\uc6cc\ud06c\uc640\uc758 \uc5f0\uacb0 \uc5c6\uc774 \ub0b4\ubd80 \ud53c\uc9c0\uceec \uc7a5\uce58\ub9cc\uc73c\ub85c \ub2e8\ub3c5 \ub3d9\uc791\ud558\ub294 \uc2dc\uc2a4\ud15c\uc744 \uc77c\uceeb\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ubb3c \uc778\ud130\ub137\uc740 '\uc778\ud130\ub137 \ub124\ud2b8\uc6cc\ud06c'\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \ud1b5\uc2e0\ud558\ub294 \uac83\uc744 \ud544\uc218\uc801\uc778 \uad6c\uc131 \uc694\uc18c\ub85c \ud569\ub2c8\ub2e4."
