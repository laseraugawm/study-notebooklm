          "rationale": "\uac1c\uc778 \uc815\ubcf4 \uc124\uc815 \uba54\ub274\ub294 \ubcf4\uc548 \ubc0f \uad8c\ud55c \uad00\ub9ac\uc640 \uad00\ub828\ub418\uba70, IP \uc8fc\uc18c \ub4f1 \ub124\ud2b8\uc6cc\ud06c \uc0c1\uc138 \uc815\ubcf4\ub97c \ud45c\uc2dc\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "[\uc791\uc5c5 \ud45c\uc2dc\uc904] - [\ud30c\uc77c \ud0d0\uc0c9\uae30] - [\uacf5\uc720 \ud3f4\ub354]",
          "isCorrect": false,
          "rationale": "\ud30c\uc77c \ud0d0\uc0c9\uae30\uc758 \uacf5\uc720 \ud3f4\ub354\ub294 \ud30c\uc77c \uacf5\uc720\uc640 \uad00\ub828\ub418\uba70, \ucef4\ud4e8\ud130\uc758 \ub124\ud2b8\uc6cc\ud06c \uc8fc\uc18c \uc815\ubcf4\ub97c \ub2e4\ub8e8\ub294 \uc124\uc815 \uacbd\ub85c\uac00 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc708\ub3c4 [\uc124\uc815] \uba54\ub274 \ub0b4\uc5d0\uc11c \ub124\ud2b8\uc6cc\ud06c \uad00\ub828 \ud56d\ubaa9\uc744 \ucc3e\uc544 \uc774\ub354\ub137 \uc18d\uc131\uc73c\ub85c \ub4e4\uc5b4\uac00\ub294 \uc21c\uc11c\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305(Cloud Computing) \uae30\uc220\uc758 \uc8fc\uc694 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\uc6a9\uc790\uac00 \uc2dc\uac04\uacfc \uc7a5\uc18c\uc5d0 \uc0c1\uad00\uc5c6\uc774 \ub124\ud2b8\uc6cc\ud06c\ub85c \uc5f0\uacb0\ub41c \ucef4\ud4e8\ud305 \uc790\uc6d0\uacfc \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305\uc740 \ub124\ud2b8\uc6cc\ud06c\ub85c \uc5f0\uacb0\ub41c \uc11c\ubc84\ub97c \ud1b5\ud574 \uc7a5\uc18c\uc5d0 \uad6c\uc560\ubc1b\uc9c0 \uc54a\uace0 \ub370\uc774\ud130 \uc800\uc7a5 \ubc0f \uc18c\ud504\ud2b8\uc6e8\uc5b4 \ud65c\uc6a9\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubb3c\ub9ac\uc801\uc73c\ub85c \uc9c1\uc811 \uc5f0\uacb0\ub41c \uc720\uc120 \ub79c \uc120\uc744 \ud1b5\ud574\uc11c\ub9cc \ub370\uc774\ud130\uc640 \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305\uc740 \uc720\uc120 \uc5f0\uacb0\uc5d0 \uad6d\ud55c\ub418\uc9c0 \uc54a\uace0 \ubb34\uc120 \ub124\ud2b8\uc6cc\ud06c\ub97c \ud3ec\ud568\ud55c \uc778\ud130\ub137 \uc5f0\uacb0 \uc804\ubc18\uc5d0\uc11c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud55c \ubc88 \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub294 \ubcf4\uc548\uc744 \uc704\ud574 \ub4f1\ub85d\ud55c \uac1c\uc778 \ub2e8\ub9d0\uae30 \uc774\uc678\uc758 \uacf5\uc720\uac00 \uc5c4\uaca9\ud788 \ucc28\ub2e8\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305\uc740 \ub9c1\ud06c \ubcf5\uc0ac\ub098 \uad8c\ud55c \uc124\uc815\uc744 \ud1b5\ud574 \uc5ec\ub7ec \uc0ac\ub78c\uc774 \ub370\uc774\ud130\ub97c \ud568\uaed8 \uc774\uc6a9\ud558\uace0 \ubb38\uc11c \uc791\uc5c5\uc744 \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \ub370\uc774\ud130 \ucc98\ub9ac\uac00 \ub124\ud2b8\uc6cc\ud06c \uc811\uc18d \uc5c6\uc774 \uac1c\uc778 \ucef4\ud4e8\ud130\uc758 \ub0b4\uc7a5 \ub2e8\ub9d0\uae30 \ub0b4\ubd80\uc5d0\uc11c\ub9cc \ub3c5\ub9bd\uc801\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305\uc740 \uc790\uccb4 \ub2e8\ub9d0\uae30 \ub0b4\ubd80 \ucc98\ub9ac\uac00 \uc544\ub2cc \uc6d0\uaca9\uc5d0 \uc788\ub294 \ud074\ub77c\uc6b0\ub4dc \uc11c\ubc84 \uc790\uc6d0\uc744 \ub124\ud2b8\uc6cc\ud06c\ub85c \ud65c\uc6a9\ud569\ub2c8\ub2e4."
        }
