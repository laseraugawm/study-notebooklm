        {
          "text": "\uc2a4\ub9c8\ud2b8\ud3f0\uc744 \uc138\ub85c \ubaa8\ub4dc\ub85c \ub4e4\uc5c8\uc744 \ub54c\ub9cc TV \ud654\uba74\uc5d0 \uc88c\uc6b0 \uc5ec\ubc31 \uc5c6\uc774 \uc804\uccb4 \ud654\uba74\uc73c\ub85c \ud45c\uc2dc\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\ub85c \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud654\uba74 \uc88c\uc6b0\uc5d0 \uc5ec\ubc31\uc774 \uc0dd\uae30\uba70, \uc804\uccb4 \ud654\uba74 \ud45c\uc2dc\ub294 \uac00\ub85c \ubaa8\ub4dc\ub85c \uc804\ud658\ud588\uc744 \ub54c \uac00\ub2a5\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubbf8\ub7ec\ub9c1 \uc2dc \ud654\uba74 \ucd9c\ub825 \ubaa8\ub4dc\ub294 \ud56d\uc0c1 \ud654\uba74 \ubcf5\uc81c\ub9cc \uc9c0\uc6d0\ud558\uba70 \ud655\uc7a5 \ubaa8\ub4dc\ub294 \uc81c\uacf5\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubbf8\ub7ec\ub9c1 \ud658\uacbd\uc5d0\uc11c\ub294 \uae30\uae30 \ubc0f \uc124\uc815 \ubc29\uc2dd\uc5d0 \ub530\ub77c \ud655\uc7a5, \ubcf5\uc81c \ub4f1 \ub2e4\uc591\ud55c \ubaa8\ub4dc\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubbf8\ub7ec\ub9c1 \uae30\ub2a5\uc740 \ubb34\uc120 \ub124\ud2b8\uc6cc\ud06c \uae30\uc220\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc73c\uba70 \ubc18\ub4dc\uc2dc \uc720\uc120 \ucf00\uc774\ube14\uc744 \uc5f0\uacb0\ud574\uc57c\ub9cc \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5d0\uc5b4\ud50c\ub808\uc774 \ub4f1 \ubb34\uc120 \ub124\ud2b8\uc6cc\ud06c \uae30\uc220\uc744 \uc774\uc6a9\ud558\uc5ec \ud654\uba74\uc744 \ubb34\uc120\uc73c\ub85c \ubbf8\ub7ec\ub9c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
