      "answerOptions": [
        {
          "text": "\uc2a4\ub9c8\ud2b8\ud3f0\uc744 \uac00\ub85c \ubaa8\ub4dc\ub85c \ub4e4\uc5c8\uc744 \ub54c TV \ud654\uba74\uc5d0 \uc804\uccb4 \ud654\uba74\uc73c\ub85c \ud06c\uac8c \ud45c\uc2dc\ud558\ub294 \uac83\uc774 \uac00\ub2a5\ud558\ub2e4.",
