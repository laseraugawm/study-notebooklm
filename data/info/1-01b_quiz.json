    {
      "question": "\uc708\ub3c4 \uc6b4\uc601\uccb4\uc81c\uc5d0\uc11c \ub0b4 \ucef4\ud4e8\ud130\uc758 \ub124\ud2b8\uc6cc\ud06c \uc5f0\uacb0 \uc0c1\ud0dc\uc640 IP \uc8fc\uc18c \ub4f1\uc758 \ub124\ud2b8\uc6cc\ud0b9 \uc815\ubcf4\ub97c \ud655\uc778\ud558\uae30 \uc704\ud55c \uc124\uc815 \uacbd\ub85c\ub85c \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
