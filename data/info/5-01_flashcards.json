    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\ub8cc \ubc0f \ubcf4\uac74 \uc601\uc5ed\uc5d0\uc11c \uac1c\uc778\uc758 \uc2a4\ub9c8\ud2b8 \uae30\uae30\ub97c \ud65c\uc6a9\ud558\uc5ec \uc218\uc9d1\ud55c \uc0dd\uccb4 \ub370\uc774\ud130\ub97c \ubc14\ud0d5\uc73c\ub85c \uc81c\uacf5\ub418\ub294 \uc11c\ube44\uc2a4\ub294 \ubb34\uc5c7\uc778\uac00?"
