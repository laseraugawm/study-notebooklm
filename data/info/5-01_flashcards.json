    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ub3d9\ucc28 \uc870\ub9bd \ubc0f \ub514\uc790\uc778 \ubd84\uc57c\uc5d0\uc11c AR(\uc99d\uac15 \ud604\uc2e4)\uacfc VR(\uac00\uc0c1 \ud604\uc2e4)\uc774 \ud65c\uc6a9\ub418\ub294 \ubc29\uc2dd\uc744 \ube44\uad50\ud558\uc5ec \uc124\uba85\ud558\uc2dc\uc624."
