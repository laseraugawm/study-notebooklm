    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ud3ec\uce20 \ubd84\uc57c\uc5d0\uc11c \uc57c\uad6c \ucf54\uce6d\uc2a4\ud0dc\ud504\uac00 \uc131\uacf5\uc801\uc778 \uacbd\uae30 \uc804\ub7b5\uc744 \uc218\ub9bd\ud558\uae30 \uc704\ud574 \uc218\uc9d1\u00b7\ubd84\uc11d\ud558\ub294 \ub370\uc774\ud130 \uc694\uc18c 3\uac00\uc9c0\ub294?"
