        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\uc5c5\uc790\ub294 AR/VR\ub85c \ubd80\ud488\u00b7\ub3c4\uba74 \uc815\ubcf4\ub97c \ud655\uc778\ud558\uba70 \uc791\uc5c5\ud558\uace0, \ub514\uc790\uc774\ub108\ub294 \uac00\uc0c1 \ud658\uacbd\uc5d0\uc11c \ucc28\ub7c9 \ub514\uc790\uc778 \ubc0f \uad6c\uc870\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uac80\ud1a0\u00b7\ubcc0\uacbd\ud568"
