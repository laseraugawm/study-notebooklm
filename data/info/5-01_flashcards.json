      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub2f7\ubb3c\uc5d0 \ub179\ub294 \ud50c\ub77c\uc2a4\ud2f1 (\ub610\ub294 \ubd88\uc18c \ud654\ud569\ubb3c\uc744 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \uc2e0\uc18c\uc7ac)"
