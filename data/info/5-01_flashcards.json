      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub18d\uc5c5 \uc601\uc5ed\uc5d0\uc11c \uc0ac\ubb3c \uc778\ud130\ub137(IoT)\uacfc AI \uae30\uc220\uc744 \uc811\ubaa9\ud558\uc5ec \ub18d\uc791\ubb3c\uc758 \uc0c1\ud0dc\ub97c \uc6d0\uaca9 \uad00\ub9ac\ud558\ub294 \ucca8\ub2e8 \ub18d\uc7a5 \uccb4\uacc4\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
