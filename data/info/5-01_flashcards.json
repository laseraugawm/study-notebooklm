          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \uae30\uc220\uc774 \ubc1c\uc804\ud568\uc5d0 \ub530\ub77c \uc778\uac04\uc774 \uc9c1\uc5c5 \ud604\uc7a5\uc5d0\uc11c \ub354 \uc9d1\uc911\ud574\uc57c \ud560 \uc5c5\ubb34\uc758 \uc131\uaca9\uc740 \uc5b4\ub5a0\ud55c\uac00?"
