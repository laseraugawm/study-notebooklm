      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud280\uae40 \ub4f1 \uc704\ud5d8\ud55c \uc870\ub9ac \uc791\uc5c5 \ubd84\ub2f4\uc744 \ud1b5\ud55c \ud654\uc0c1 \ubc0f \ud638\ud761\uae30 \uc9c8\ud658 \uc704\ud5d8 \uac10\uc18c"
