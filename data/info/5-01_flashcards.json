    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ucf58\ud150\uce20\ub97c \uc2e4\uc81c \uacf5\uac04\uc5d0 \uad6c\ud604\ud558\uc5ec \uc804\ubb38\uac00\uc640 \uc2e4\uc2dc\uac04 \uc18c\ud1b5 \ubc0f \uae30\uacc4 \uc218\ub9ac \ub4f1\uc5d0 \ud65c\uc6a9\ud558\ub294 \uae30\uc220\uc740?"
