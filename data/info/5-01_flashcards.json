    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4\ub97c \ub514\uc9c0\ud138 \ud615\ud0dc\ub85c \ucc98\ub9ac, \uc800\uc7a5, \uc804\uc1a1\ud558\ub294 \uc7a5\uce58\ub97c \uc5f0\uad6c\u00b7\uac1c\ubc1c\ud558\uba70 \uc0ac\ub78c\uacfc \uae30\uae30 \uac04\uc758 \uc0c1\ud638\uc791\uc6a9\uc744 \uac00\ub2a5\ud558\uac8c \ud558\ub294 \uae30\uc220\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
