    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\uc870 \ubc0f \ubb3c\ub958 \uc601\uc5ed\uc5d0\uc11c \uac1c\uc778 \ub9de\ucda4\ud615 \ubb3c\ud488\uc744 \uc9c1\uc811 \uc81c\uc870\ud558\uace0 \ud310\ub9e4\ud560 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc8fc\ub294 \ub514\uc9c0\ud138 \uc7a5\ube44\ub294 \ubb34\uc5c7\uc778\uac00?"
