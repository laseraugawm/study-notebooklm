    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc220\u00b7\uacf5\ud559 \ubd84\uc57c\uc5d0\uc11c \ud658\uacbd\uc624\uc5fc\uacfc \ud0c4\uc18c \ubc30\ucd9c\uc744 \uc904\uc774\uae30 \uc704\ud574 \uac1c\ubc1c\ub41c \uce5c\ud658\uacbd \uc2e0\uc18c\uc7ac \uc0ac\ub840 \ud55c \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
