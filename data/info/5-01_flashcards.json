      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ubbf8\uc9c0 \uae30\ubc18 \uc2e4\uc2dc\uac04 \ubc88\uc5ed \uae30\ub2a5"
