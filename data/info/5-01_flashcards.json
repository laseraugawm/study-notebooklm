      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \uae30\uc220"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc95\ub960 \ubd84\uc57c\uc5d0\uc11c AI \uc0ac\ubb34 \uc790\ub3d9\ud654\ub97c \ud65c\uc6a9\ud560 \ub54c \uc778\uacf5\uc9c0\ub2a5\uc774 \uc218\ud589\ud558\ub294 \uc8fc\uc694 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\ub9ce\uc740 \ud310\ub840 \uc911 \ubcc0\ub860\uc744 \ub4b7\ubc1b\uce68\ud558\ub294 \ucd5c\uc801\uc758 \uadfc\uac70\ub97c \ucd94\ucd9c\ud558\uace0 \ud559\uc2b5\ud558\uc5ec \ucd94\ucc9c \uc81c\uc2dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc0c1\uc0dd\ud65c \uc601\uc5ed\uc5d0\uc11c \uc2a4\ub9c8\ud2b8\ud3f0\uc744 \ud65c\uc6a9\ud574 \uc678\uad6d\uc5b4\uac00 \ucc0d\ud78c \uc0ac\uc9c4\uc744 \uc989\uc2dc \ub2e4\ub8e8\ub294 AI \uae30\uc220 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00?"
