    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\ud0dd \uc0ac\ud56d\uc774 \uc5ec\ub7ec \uac1c\uc77c \ub54c, \uc5ec\ub7ec \uc870\uac74\uc2dd\uc5d0 \ub530\ub77c \uba85\ub839\uc744 \ub2e4\ub974\uac8c \uc2e4\ud589\ud558\ub3c4\ub85d \uad6c\ubcc4\ud558\ub294 \uc870\uac74\ubb38 \ud615\ud0dc\ub294 \ubb34\uc5c7\uc778\uac00?"
