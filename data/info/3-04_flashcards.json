    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud504\ub85c\uadf8\ub798\ubc0d\uc5d0\uc11c \ucf54\ub4dc \ube14\ub85d\uc744 \uad6c\ubd84\ud558\uace0 \ud504\ub85c\uadf8\ub7a8 \uad6c\uc870\ub97c \uba85\ud655\ud558\uac8c \ub9cc\ub4e4\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \uc791\uc131 \uaddc\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
