{
  "title": "\ud30c\uc774\uc36c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub85c\uadf8\ub7a8\uc5d0\uc11c \ud2b9\uc815 \uae30\ub2a5\uc744 \uc218\ud589\ud558\uae30 \uc704\ud574 \uc5ec\ub7ec \uac1c\uc758 \uba85\ub839\ubb38\uc744 \uc791\uc740 \ub2e8\uc704\uc758 \ucf54\ub4dc\ub85c \ubb36\uc740 \uac83\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218(function)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub85c\uadf8\ub7a8\uc5d0\uc11c \ubc18\ubcf5\ub418\ub294 \uc791\uc5c5\uc744 \ud568\uc218\ub85c \ub9cc\ub4e4\uc5b4 \ud544\uc694\ud560 \ub54c\ub9c8\ub2e4 \ud638\ucd9c\ud558\uc5ec \uc0ac\uc6a9\ud560 \ub54c \uc5bb\uc744 \uc218 \uc788\ub294 \uc7a5\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub85c\uadf8\ub7a8\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc791\uc131\ud558\uace0 \ud3b8\ub9ac\ud558\uac8c \uad00\ub9ac\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \uc81c\uacf5\ud558\ub294 \ud568\uc218\uc758 \ub300\ud45c\uc801\uc778 3\uac00\uc9c0 \uc885\ub958\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0b4\uc7a5 \ud568\uc218, \uc678\uc7a5 \ud568\uc218, \uc0ac\uc6a9\uc790 \uc815\uc758 \ud568\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc744 \uc124\uce58\ud560 \ub54c \uae30\ubcf8\uc801\uc73c\ub85c \ud568\uaed8 \uc81c\uacf5\ub418\ub294 \ud568\uc218\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0b4\uc7a5 \ud568\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ub77c\uc774\ube0c\ub7ec\ub9ac \ubaa8\ub4c8\uc5d0 \ud3ec\ud568\ub418\uc5b4 \uc788\uc73c\uba70 `import` \ubb38\uc744 \ud1b5\ud574 \ubd88\ub7ec\uc640 \uc0ac\uc6a9\ud558\ub294 \ud568\uc218\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\uc7a5 \ud568\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc6a9\uc790\uac00 \uc6d0\ud558\ub294 \uae30\ub2a5\uc744 \uc9c1\uc811 \uc815\uc758\ud558\uc5ec \uc0ac\uc6a9\ud558\ub294 \ud568\uc218\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc6a9\uc790 \uc815\uc758 \ud568\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218 \uc0ac\uc6a9 \uacfc\uc815\uc5d0\uc11c \ud2b9\uc815 \uae30\ub2a5\uc744 \uc218\ud589\ud558\ub294 \ud568\uc218\ub97c \ubbf8\ub9ac \ub9cc\ub4e4\uc5b4 \ub193\ub294 \ud589\uc704\uc640, \uc791\uc5c5\uc774 \ud544\uc694\ud560 \ub54c \uc774\ub97c \uc2e4\ud589\uc2dc\ud0a4\ub294 \ud589\uc704\ub97c \uac01\uac01 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218\ub97c \ubbf8\ub9ac \ub9cc\ub4dc\ub294 \uac83\uc740 '\ud568\uc218 \uc815\uc758', \uc815\uc758\ub41c \ud568\uc218\ub97c \uc2e4\ud589\ud558\ub294 \uac83\uc740 '\ud568\uc218 \ud638\ucd9c'\uc774\ub77c\uace0 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud568\uc218\uba85\uc744 \uc791\uc131\ud560 \ub54c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ubb38\uc790 \uc885\ub958 4\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc22b\uc790, \ud55c\uae00, \uc54c\ud30c\ubcb3, \uc5b8\ub354\ubc14(_)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud568\uc218\uba85 \uc791\uc131 \uc2dc \uacf5\ubc31(\ub744\uc5b4\uc4f0\uae30)\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud568\uc218\uba85\uc73c\ub85c `if`, `and`\uc640 \uac19\uc740 \ud0a4\uc6cc\ub4dc(\uc608\uc57d\uc5b4)\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud568\uc218\uba85\uc744 \uc22b\uc790\ub85c \uc2dc\uc791\ud560 \uc218 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc22b\uc790\ub85c \uc2dc\uc791\ud560 \uc218 \uc5c6\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218 \ud638\ucd9c \uc2dc \uc804\ub2ec\ub41c \uac12\uc744 \ubc1b\ub294 \ubcc0\uc218\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\uac1c\ubcc0\uc218 (parameter)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218\ub97c \ud638\ucd9c\ud560 \ub54c \ud568\uc218 \uc804\ub2ec\uc6a9\uc73c\ub85c \ubcf4\ub0b4\ub294 \uc2e4\uc81c \uac12\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uc218 (argument)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218\uc758 \ucc98\ub9ac \uacb0\uacfc\ub97c \ud638\ucd9c\ud55c \uacf3\uc73c\ub85c \uc804\ub2ec\ud558\ub294 \uac12\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc18\ud658\uac12 (return value)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud568\uc218 \ub0b4\uc5d0\uc11c \ud2b9\uc815 \uac12\uc744 \ud568\uc218\ub97c \ud638\ucd9c\ud588\ub358 \uc704\uce58\ub85c \uc804\ub2ec\ud558\uace0 \ud568\uc218 \uc2e4\ud589\uc744 \uc885\ub8cc\uc2dc\ud0a4\ub294 \ud0a4\uc6cc\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`return` \ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud568\uc218\ub97c \uc815\uc758\ud560 \ub54c \ub9e4\uac1c\ubcc0\uc218, \uc778\uc218, \ubc18\ud658\uac12\uc740 \ud56d\uc0c1 \ud544\uc218\ub85c \ud3ec\ud568\ub418\uc5b4\uc57c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud544\uc218 \uc694\uac74\uc774 \uc544\ub2c8\ub2e4. (\uc778\uc218\ub098 \ubc18\ud658\uac12\uc774 \uc5c6\ub294 \ud568\uc218\ub3c4 \uc815\uc758 \ubc0f \ud638\ucd9c \uac00\ub2a5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c `math` \ubaa8\ub4c8\uc5d0\uc11c \uc8fc\uc5b4\uc9c4 \uc22b\uc790\ub97c \uc62c\ub9bc\ud558\uc5ec \uc815\uc218\ub97c \ubc18\ud658\ud558\ub294 \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`math.ceil()`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c `math` \ubaa8\ub4c8\uc5d0\uc11c \uc8fc\uc5b4\uc9c4 \uc22b\uc790\ub97c \ub0b4\ub9bc\ud558\uc5ec \uc815\uc218\ub97c \ubc18\ud658\ud558\ub294 \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`math.floor()`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c `math` \ubaa8\ub4c8\uc5d0\uc11c \ub450 \uc218\uc758 \ucd5c\ub300\uacf5\uc57d\uc218\ub97c \uad6c\ud558\ub294 \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`math.gcd()`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218 \ub0b4\ubd80\uc640 \uac19\uc740 \ud2b9\uc815 \uc9c0\uc5ed\uc5d0\uc11c\ub9cc \uc0dd\uc131\ub418\uace0 \uc0ac\uc6a9\ub418\ub294 \ubcc0\uc218\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed \ubcc0\uc218 (local variable)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218 \uc678\ubd80\uc5d0 \uc0dd\uc131\ub418\uc5b4 \ud504\ub85c\uadf8\ub7a8 \uc804\uccb4\uc5d0\uc11c \uc811\uadfc \ubc0f \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ubcc0\uc218\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc5ed \ubcc0\uc218 (global variable)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc5ed \ubcc0\uc218\uc640 \uc804\uc5ed \ubcc0\uc218\ub97c \uad6c\ubd84\ud558\ub294 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub85c\uadf8\ub7a8 \ub0b4\uc5d0\uc11c \ubcc0\uc218\uac00 \uc120\uc5b8\ub41c \uc704\uce58 \ubc0f \ubcc0\uc218\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ubc94\uc704(\uc720\ud6a8 \ubc94\uc704)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud568\uc218 \ub0b4\ubd80\uc5d0\uc11c \uc678\ubd80\uc5d0 \uc815\uc758\ub41c \uc804\uc5ed \ubcc0\uc218\uc758 \uac12\uc744 \uc218\uc815\ud558\uace0\uc790 \ud560 \ub54c \uc120\uc5b8\ud558\ub294 \ud0a4\uc6cc\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`global` \ud0a4\uc6cc\ub4dc (\uc608: `global count`)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9ac\uc2a4\ud2b8\uc758 \uccab \ubc88\uc9f8 \uc694\uc18c\ubd80\ud130 \uc21c\uc11c\ub300\ub85c \ucc3e\uace0\uc790 \ud558\ub294 \uac12\uacfc \ube44\uad50\ud558\ub294 \ud0d0\uc0c9 \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc21c\ucc28 \ud0d0\uc0c9 (Sequential Search)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0d0\uc0c9 \ud568\uc218\uc5d0\uc11c \ucc3e\uc73c\ub824\ub294 \ub370\uc774\ud130(`target`)\uac00 \ub9ac\uc2a4\ud2b8\uc5d0 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc744 \ub54c \ud754\ud788 \ubc18\ud658\ud558\ub294 \uac12\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "-1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc9c4 \ud0d0\uc0c9(Binary Search) \uc54c\uace0\ub9ac\uc998\uc744 \uc218\ud589\ud558\uae30 \uc704\ud574 \ud0d0\uc0c9 \ub300\uc0c1 \ub370\uc774\ud130\uac00 \ubc18\ub4dc\uc2dc \uac16\ucd94\uc5b4\uc57c \ud558\ub294 \uc0ac\uc804 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\uac00 \uc624\ub984\ucc28\uc21c\uc774\ub098 \ub0b4\ub9bc\ucc28\uc21c\uc73c\ub85c \uc0ac\uc804 \uc815\ub82c(sort)\ub418\uc5b4 \uc788\uc5b4\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc9c4 \ud0d0\uc0c9\uc5d0\uc11c \ubc94\uc704\uc758 \uc67c\ucabd \ub05d \uc778\ub371\uc2a4\uac00 `left`, \uc624\ub978\ucabd \ub05d \uc778\ub371\uc2a4\uac00 `right`\uc77c \ub54c \uc911\uac04 \uc778\ub371\uc2a4 `mid`\ub97c \uad6c\ud558\ub294 \uc815\uc218 \uc5f0\uc0b0\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`mid = (left + right) // 2`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc9c4 \ud0d0\uc0c9 \uc911 \uc911\uac04 \uc778\ub371\uc2a4\uc758 \uac12 `a[mid]`\uac00 \ucc3e\ub294 \uac12 `target`\ubcf4\ub2e4 \uc791\uc744 \ub54c, \uc67c\ucabd \uc778\ub371\uc2a4 `left`\ub294 \uc5b4\ub5bb\uac8c \uc5c5\ub370\uc774\ud2b8\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`left = mid + 1` (\uc624\ub978\ucabd \ubd80\ubd84\uc73c\ub85c \ud0d0\uc0c9 \ubc94\uc704 \ubcc0\uacbd)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc9c4 \ud0d0\uc0c9 \uc911 \uc911\uac04 \uc778\ub371\uc2a4\uc758 \uac12 `a[mid]`\uac00 \ucc3e\ub294 \uac12 `target`\ubcf4\ub2e4 \ud074 \ub54c, \uc624\ub978\ucabd \uc778\ub371\uc2a4 `right`\ub294 \uc5b4\ub5bb\uac8c \uc5c5\ub370\uc774\ud2b8\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`right = mid - 1` (\uc67c\ucabd \ubd80\ubd84\uc73c\ub85c \ud0d0\uc0c9 \ubc94\uc704 \ubcc0\uacbd)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ub82c\ub41c \ub300\uc6a9\ub7c9 \ub370\uc774\ud130\uc5d0\uc11c \ud2b9\uc815 \ub370\uc774\ud130\ub97c \uac80\uc0c9\ud560 \ub54c, \uc21c\ucc28 \ud0d0\uc0c9\uacfc \uc774\uc9c4 \ud0d0\uc0c9 \uc911 \ud0d0\uc0c9 \ud69f\uc218\uac00 \ud6e8\uc52c \uc801\uc5b4 \ud6a8\uc728\uc801\uc778 \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
