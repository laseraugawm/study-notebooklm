{
  "title": "Physical Computing Flashcards",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305(Physical Computing)\uc774\ub780 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc13c\uc11c, \ub9c8\uc774\ud06c\ub85c\ucee8\ud2b8\ub864\ub7ec, \uc561\ucd94\uc5d0\uc774\ud130 \ub4f1\uc744 \uc774\uc6a9\ud558\uc5ec \ucef4\ud4e8\ud130\uc640 \ud604\uc2e4 \uc138\uacc4\ub97c \uc5f0\uacb0\ud558\uace0 \uc18c\ud1b5\ud558\uac8c \ud558\ub294 \uc2dc\uc2a4\ud15c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc744 \uad6c\uc131\ud558\ub294 \uc8fc\uc694 \uc7a5\uce58 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc13c\uc11c(\uc785\ub825 \uc7a5\uce58), \ub9c8\uc774\ud06c\ub85c\ucee8\ud2b8\ub864\ub7ec(\ucc98\ub9ac \uc7a5\uce58), \uc561\ucd94\uc5d0\uc774\ud130(\ucd9c\ub825 \uc7a5\uce58)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc5d0\uc11c '\uc13c\uc11c(Sensor)'\uc758 \uc8fc\uc694 \uc5ed\ud560\uacfc \uae30\ub2a5\uc0c1\uc758 \ubd84\ub958\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc628\ub3c4, \ubc1d\uae30 \ub4f1 \uc8fc\ubcc0 \uc0c1\ud669\uc744 \uc778\uc2dd\ud558\ub294 \uc785\ub825 \uc7a5\uce58 \uc5ed\ud560\uc744 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc5d0\uc11c '\ub9c8\uc774\ud06c\ub85c\ucee8\ud2b8\ub864\ub7ec(Microcontroller)'\uc758 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc13c\uc11c\ub85c \uc5bb\uc740 \uc815\ubcf4\ub97c \ucc98\ub9ac\ud558\uace0 \uc561\ucd94\uc5d0\uc774\ud130\ub97c \uc81c\uc5b4\ud558\ub294 \ucc98\ub9ac \uc7a5\uce58 \uc5ed\ud560\uc744 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc5d0\uc11c '\uc561\ucd94\uc5d0\uc774\ud130(Actuator)'\uc758 \uac1c\ub150\uacfc \ub2e4\ub978 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\ub3d9\uae30\ub77c\uace0\ub3c4 \ud558\uba70, \ub9c8\uc774\ud06c\ub85c\ucee8\ud2b8\ub864\ub7ec\uc758 \uc81c\uc5b4\uc5d0 \uc758\ud574 \ubb3c\ub9ac\uc801\uc73c\ub85c \ub3d9\uc791\ud558\ub294 \ucd9c\ub825 \uc7a5\uce58\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc758 \uad6c\uc131 \uc7a5\uce58 \uc911 \uc785\ub825 \uc7a5\uce58\uc640 \ucd9c\ub825 \uc7a5\uce58\ub97c \uac01\uac01 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\ub825 \uc7a5\uce58\ub294 \uc13c\uc11c, \ucd9c\ub825 \uc7a5\uce58\ub294 \uc561\ucd94\uc5d0\uc774\ud130(\uad6c\ub3d9\uae30)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137(IoT)\uc758 \uae30\ubcf8 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\ub4e0 \uc0ac\ubb3c\uc744 \uc778\ud130\ub137\uc73c\ub85c \uc5f0\uacb0\ud558\uc5ec \uc815\ubcf4\uc640 \ub370\uc774\ud130\ub97c \uc8fc\uace0\ubc1b\uc73c\uba70 \ub2e4\uc591\ud558\uac8c \ud65c\uc6a9\ud558\ub294 \uae30\uc220 \ud658\uacbd\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac74\uc124 \ud604\uc7a5\uc5d0\uc11c \ub4dc\ub860, \uc548\uc804 \ub85c\ubd07, \uc13c\uc11c \ub4f1\uc744 \ud65c\uc6a9\ud55c \uc0ac\ubb3c \uc778\ud130\ub137\uc758 \uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ub97c \uc218\uc9d1\ud558\uace0 \ud1b5\ud569 \ubd84\uc11d\ud558\uc5ec \uac74\uc124\uc758 \ud6a8\uc728\uc131\uacfc \uc548\uc804\uc131\uc744 \ub192\uc778\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc84\uc2a4 \uc704\uce58 \ucd94\uc801 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \uc0ac\ubb3c \uc778\ud130\ub137\uc774 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud558\ub294 \ub300\uc0c1 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uc815\ub958\uc7a5\uacfc \uc2b9\uac1d\uc758 \uc2a4\ub9c8\ud2b8\ud3f0\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137(IoT) \uc2dc\uc2a4\ud15c\uc744 \uad6c\uc131\ud558\ub294 \ud575\uc2ec 4\uac00\uc9c0 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc13c\uc11c\ub97c \ud3ec\ud568\ud55c \uc0ac\ubb3c(\ub514\ubc14\uc774\uc2a4)\n2. \ud1b5\uc2e0 \uc7a5\uce58\n3. \ub370\uc774\ud130 \ucc98\ub9ac \ubc0f \uc800\uc7a5 \uc7a5\uce58\n4. \uac01 \uc694\uc18c\ub97c \uc81c\uc5b4\ud558\uace0 \ud65c\uc6a9\ud558\ub294 \uc18c\ud504\ud2b8\uc6e8\uc5b4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc758 \uae30\ubcf8 \ub3d9\uc791 \uc6d0\ub9ac 4\ub2e8\uacc4\ub97c \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130 \uc218\uc9d1(\uc13c\uc11c) \u2192 \ub370\uc774\ud130 \uc804\uc1a1(\ub124\ud2b8\uc6cc\ud06c) \u2192 \ub370\uc774\ud130 \ucc98\ub9ac(\ubd84\uc11d\u00b7\ud310\ub2e8) \u2192 \uc11c\ube44\uc2a4 \uc81c\uacf5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648 \ubcf4\uc548 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \ub3d9\uc791 \uc13c\uc11c\uac00 \ubb38 \uc5f4\ub9bc\uc744 \uac10\uc9c0\ud558\ub294 \ub2e8\uacc4\ub294 \uc0ac\ubb3c \uc778\ud130\ub137 \ub3d9\uc791 \uc6d0\ub9ac \uc911 \uc5b4\ub290 \ub2e8\uacc4\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130 \uc218\uc9d1 \ub2e8\uacc4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648 \ubcf4\uc548 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \ubcf4\uc548 \ubaa8\ub4dc \uc0c1\ud0dc\uc640 \uc13c\uc11c \uc2e0\ud638\ub97c \ubd84\uc11d\ud574 \uc678\ubd80\uc778 \uce68\uc785 \uac00\ub2a5\uc131\uc744 \ud310\ub2e8\ud558\ub294 \ub2e8\uacc4\ub294 \uc0ac\ubb3c \uc778\ud130\ub137 \ub3d9\uc791 \uc6d0\ub9ac \uc911 \uc5b4\ub290 \ub2e8\uacc4\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130 \ucc98\ub9ac \ub2e8\uacc4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648 \ubcf4\uc548 \uc2dc\uc2a4\ud15c\uc774 \uc678\ubd80\uc778 \uce68\uc785 \ud310\ub2e8 \uc2dc \uacbd\ucc30\uc11c\uc5d0 \uc790\ub3d9 \uc5f0\uacb0\ud558\ub294 \ub2e8\uacc4\ub294 \uc0ac\ubb3c \uc778\ud130\ub137 \ub3d9\uc791 \uc6d0\ub9ac \uc911 \uc5b4\ub290 \ub2e8\uacc4\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\ube44\uc2a4 \uc81c\uacf5 \ub2e8\uacc4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc744 \uad6c\ud604\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \uc8fc\uc694 \uae30\uc220 5\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc13c\uc11c \uae30\uc220, \uc800\uc7a5 \uae30\uc220, \ubd84\uc11d \uae30\uc220, \ub370\uc774\ud130 \ubcf4\uc548 \uae30\uc220, \uc18c\ud504\ud2b8\uc6e8\uc5b4(\ubc0f \ub124\ud2b8\uc6cc\ud06c) \uae30\uc220"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc758 '\uc13c\uc11c \uae30\uc220'\uc774\ub780 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubcc0 \ud658\uacbd\uc5d0\uc11c \ub370\uc774\ud130\ub97c \uac10\uc9c0\ud558\uace0 \uce21\uc815\ud558\ub294 \uae30\uc220\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc5d0 \uc0ac\uc6a9\ub418\ub294 \uc13c\uc11c \uae30\uc220\uc758 \uc8fc\uc694 \uc885\ub958 4\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc628\ub3c4 \uc13c\uc11c, \uc555\ub825 \uc13c\uc11c, \ube5b \uc13c\uc11c, \uac00\uc18d\ub3c4 \uc13c\uc11c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc13c\uc11c\ub85c \uc218\uc9d1\ub41c \ub300\uc6a9\ub7c9 \ub370\uc774\ud130\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc800\uc7a5\u00b7\uad00\ub9ac\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \uae30\uc220 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ubca0\uc774\uc2a4 \uae30\uc220, \ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305 \uae30\uc220"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ub370\uc774\ud130\ubca0\uc774\uc2a4(Database)'\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4\ub97c \uad6c\uc870\uc801\uc73c\ub85c \uc800\uc7a5\ud558\uace0 \uad00\ub9ac\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc5d0\uc11c \uc804\uc1a1 \ubc0f \uc800\uc7a5\ub418\ub294 \ub370\uc774\ud130\uc758 \ud574\ud0b9 \ubc29\uc9c0\ub97c \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \ub370\uc774\ud130 \ubcf4\uc548 \uae30\uc220 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc554\ud638\ud654 \uae30\uc220, \uce68\uc785 \ud0d0\uc9c0 \uc2dc\uc2a4\ud15c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874 \uc0ac\ubb3c \uc778\ud130\ub137(IoT) \ub370\uc774\ud130\uac00 \uac00\uc9c4 \ud55c\uacc4\uc810\uacfc \ubcf4\uc548\uc0c1\uc758 \uc704\ud5d8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\uc548 \uc704\ud5d8\uc5d0 \ub178\ucd9c\ub418\uc5b4 \uc788\uace0, \ub370\uc774\ud130\uc758 \uc704\u00b7\ubcc0\uc870 \uac80\uc99d\uc774 \ubd88\uac00\ub2a5\ud558\uc5ec \ub370\uc774\ud130\ub97c \uc644\uc804\ud788 \uc2e0\ub8b0\ud558\uae30 \uc5b4\ub835\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc5d0 \ube14\ub85d\uccb4\uc778 \uae30\uc220\uc744 \uc801\uc6a9\ud588\uc744 \ub54c \uc5bb\uc744 \uc218 \uc788\ub294 \uc7a5\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130 \uc704\u00b7\ubcc0\uc870\uac00 \uc6d0\ucc9c \ucc28\ub2e8\ub418\uc5b4 \ud22c\uba85\ud55c \uc774\ub825 \uad00\ub9ac\uac00 \uac00\ub2a5\ud574\uc9c0\uba70, \uc815\ud655\uc131\uacfc \ubcf4\uc548\uc131\uc774 \uac15\ud654\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ube14\ub85d\uccb4\uc778(Blockchain)' \uae30\uc220\uc774\ub780 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ub97c \ube14\ub85d\uc774\ub77c\ub294 \uc791\uc740 \ub2e8\uc704\ub85c \ub098\ub204\uace0 \uc5f0\uacb0\ud558\uc5ec \uccb4\uc778 \ud615\ud0dc\ub85c \uc800\uc7a5\ud558\ub294 \uae30\uc220\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube14\ub85d\uccb4\uc778 \ub124\ud2b8\uc6cc\ud06c\uc5d0\uc11c \ub370\uc774\ud130\uc758 \uc815\ubd07\uac12\uc744 \uc720\uc9c0\ud558\uace0 \uac31\uc2e0\ud558\ub294 \ubc29\uc2dd\uc758 \ud2b9\uc9d5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub124\ud2b8\uc6cc\ud06c\uc5d0 \uc5f0\uacb0\ub41c \ub2e4\uc218\uc758 \ucef4\ud4e8\ud305 \uc2dc\uc2a4\ud15c\uc774 \ub3d9\uc2dc\uc5d0 \uc815\ubd07\uac12\uc744 \uc720\uc9c0\ud558\uace0 \uac31\uc2e0\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube14\ub85d\uccb4\uc778 \uae30\uc220\uc774 \ub370\uc774\ud130\uc758 \uc2e0\ub8b0\uc131\uacfc \ubcf4\uc548\uc131\uc774 \uc6b0\uc218\ud55c \uad6c\uc870\uc801 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \uc11c\ubc84\uc5d0 \uc9d1\uc911\ub418\uc9c0 \uc54a\uace0, \uc5f0\uacb0\ub41c \ubaa8\ub4e0 \uae30\uae30\uac00 \uac19\uc740 \ubcf5\uc0ac\ubcf8\uc744 \uacf5\uc720\ud558\uba70 \uc554\ud638\ud654\ub41c \uc778\uc99d\uc744 \uc0ac\uc6a9\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\ud6c4 \uac74\ucd95\ubb3c \uc548\uc804 \uad00\ub9ac\uc5d0 IoT \uc13c\uc11c\uc640 \ube14\ub85d\uccb4\uc778 \uae30\uc220\uc744 \uacb0\ud569\ud558\uc5ec \uc704\ud5d8\uc744 \uac10\uc9c0\ud558\uba74 \uc9c4\ud589\ub418\ub294 \uc870\uce58\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac74\ubb3c \uc18c\uc720\uc790\uc5d0\uac8c \uacbd\ubcf4 \uc54c\ub9bc\uc744 \ubb38\uc790\ub85c \uc804\uc1a1\ud558\uc5ec \uc0ac\uc804\uc5d0 \uc608\ubc29 \uc870\uce58\ub97c \ucde8\ud558\ub3c4\ub85d \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e4\uc0dd\ud65c\uc5d0\uc11c \uc0ac\ubb3c \uc778\ud130\ub137\uacfc \ube14\ub85d\uccb4\uc778\uc774 \ud568\uaed8 \uc801\uc6a9\ub41c \uc608\uc2dc 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dd\ubc30 \ubcf4\uad00\ud568\uc758 \ud0a4 \uad00\ub9ac, \uac01 \uac00\uc815\uc758 \ub3c4\uc5b4\ub85d \uad00\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc(Smart Grid)'\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220(ICT)\uc744 \uae30\uc874\uc758 \uc804\ub825\ub9dd\uc5d0 \uc735\ud569\ud558\uc5ec \uc804\uae30 \uacf5\uae09\uc790\uc640 \uc18c\ube44\uc790\uac00 \uc2e4\uc2dc\uac04\uc73c\ub85c \uc804\ub825 \uc815\ubcf4\ub97c \uad50\ud658\ud558\ub294 \uc9c0\ub2a5\ud615 \uc804\ub825\ub9dd\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc\ub97c \ub3c4\uc785\ud568\uc73c\ub85c\uc368 \uc5bb\uc744 \uc218 \uc788\ub294 \uac00\uc7a5 \ud070 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\ub108\uc9c0\ub97c \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \uc0dd\uc0b0\ud558\uace0 \uc0ac\uc6a9\ud560 \uc218 \uc788\uac8c \ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc \ud658\uacbd\uc5d0\uc11c \uc2e4\uc2dc\uac04 \uc804\ub825 \uc815\ubcf4\ub97c \uad50\ud658\ud558\ub294 \uc8fc\uccb4 2\uc30d\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uae30 \uacf5\uae09\uc790\uc640 \uc804\uae30 \uc18c\ube44\uc790"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc \uc2dc\uc2a4\ud15c\uc5d0\uc11c \uc804\uae30 \uacf5\uae09\uc790\uc758 \uc608\uc2dc\uc5d0\ub294 \uc5b4\ub5a4 \ubc1c\uc804\uc18c\ub4e4\uc774 \ud3ec\ud568\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\uc790\ub825 \ubc1c\uc804\uc18c, \ud654\ub825 \ubc1c\uc804\uc18c, \uc218\ub825 \ubc1c\uc804\uc18c, \ud48d\ub825 \ubc1c\uc804\uc18c, \ud0dc\uc591\uad11 \ubc1c\uc804 \uc2dc\uc124"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc \uc2dc\uc2a4\ud15c\uc5d0\uc11c \uc804\uae30 \uc18c\ube44\uc790\uc758 \uc608\uc2dc 4\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc815 \uc8fc\ud0dd, \uacf5\uc7a5, \ub3c4\uc2dc\uc640 \ube4c\ub529, \uacf5\uacf5 \uc2dc\uc124, \uc804\uae30\ucc28 \ubc0f \ucda9\uc804\uc18c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc774 \uc801\uc6a9\ub41c '\uc2a4\ub9c8\ud2b8 \uad50\uc721'\uc758 \uc8fc\uc694 \uc7a5\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud559\uc2b5\uc790 \uc218\uc900\uc5d0 \ub9de\ub294 \ud559\uc2b5 \uc790\ub8cc\u00b7\ubb38\ud56d \uc81c\uacf5 \ubc0f \ud53c\ub4dc\ubc31\uc774 \uac00\ub2a5\ud558\uba70, \uc7a5\uc18c\uc5d0 \uc0c1\uad00\uc5c6\uc774 \uad50\uc721\uc744 \ubc1b\uc744 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc2a4\ub9c8\ud2b8\ud31c(Smart Farm)'\uc758 \ud575\uc2ec \uc791\ub3d9 \uc6d0\ub9ac\uc640 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc628\ub3c4, \uc2b5\ub3c4 \ub4f1 \uc8fc\ubcc0 \ud658\uacbd\uc744 \uc790\ub3d9\uc73c\ub85c \uac10\uc9c0\ud558\uc5ec \uc0ac\ub78c\uc758 \uc190\uc744 \uac70\uce58\uc9c0 \uc54a\uace0 \ub18d\uc791\ubb3c\uc5d0 \uc218\ubd84\uc744 \uacf5\uae09\ud558\uac70\ub098 \uc628\ub3c4\ub97c \uc81c\uc5b4\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc2a4\ub9c8\ud2b8 \ud5ec\uc2a4\ucf00\uc5b4'\uc5d0\uc11c \uc2e4\uc2dc\uac04\uc73c\ub85c \ubaa8\ub2c8\ud130\ub9c1\ud558\uace0 \ubd84\uc11d\ud558\ub294 \uac1c\uc778 \uac74\uac15 \uc815\ubcf4\uc758 \ub300\ud45c\uc801 \ud56d\ubaa9 3\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2ec\ubc15\uc218, \uc2ec\uc804\ub3c4, \ud608\uc555"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud5ec\uc2a4\ucf00\uc5b4\uc758 \uc6d0\uaca9 \uc9c4\ub8cc \uc11c\ube44\uc2a4\uac00 \ud658\uc790\uc5d0\uac8c \uc8fc\ub294 \ud3b8\uc758\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uc790\uac00 \ubcd1\uc6d0\uc5d0 \uc9c1\uc811 \uac00\uc9c0 \uc54a\uace0\ub3c4 \uc9c8\ubcd1\uc744 \uc9c4\ub2e8\ubc1b\uace0 \ucc98\ubc29\ubc1b\uc744 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc2a4\ub9c8\ud2b8 \ud648(Smart Home)' \ud658\uacbd\uc5d0\uc11c \uc0ac\uc6a9\uc790\uac00 \uc9d1 \uc548\uc758 \uae30\uae30\ub97c \uc791\ub3d9\uc2dc\ud0a4\ub294 \ub300\ud45c\uc801\uc778 \uc81c\uc5b4 \ubc29\ubc95 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8\ud3f0 \uc81c\uc5b4, \uc74c\uc131 \uc81c\uc5b4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648\uc758 \uc6d0\uaca9 \uc81c\uc5b4 \uae30\ub2a5\uc744 \ud1b5\ud574 \uc678\ubd80\uc5d0\uc11c \uc218\ud589\ud560 \uc218 \uc788\ub294 \uc791\uc5c5\uc758 \uc608\uc2dc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9d1 \ubc16\uc5d0\uc11c \uc9d1 \uc548\uc758 \uc0c1\ud0dc\ub97c \ud30c\uc545\ud558\uace0 \ub0c9\ub09c\ubc29\uae30, \uc804\ub4f1 \ub4f1\uc758 \uc0c1\ud0dc\ub97c \uc81c\uc5b4\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc2a4\ub9c8\ud2b8 \ube4c\ub529'\uc5d0\uc11c \uc5d0\ub108\uc9c0 \uc0ac\uc6a9\uc744 \ud6a8\uc728\ud654\ud558\uae30 \uc704\ud574 \uc81c\uc5b4\ud558\ub294 \uc8fc\uc694 \uc124\ube44 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\ub4f1(\uc870\uba85/\uc870\ub3c4)\uacfc \ub0c9\ub09c\ubc29\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ube4c\ub529\uc5d0\uc11c \uc8fc\ucc28 \uacf5\uac04\uc758 \ud6a8\uc728\uc801 \ud65c\uc6a9\uc744 \ub3c4\uc640\uc8fc\ub294 \uc2dc\uc2a4\ud15c\uc758 \uba85\uce6d\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \uc8fc\ucc28 \uc2dc\uc2a4\ud15c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc2a4\ub9c8\ud2b8 \uacf5\uc7a5(Smart Factory)'\uc758 \ub3c4\uc785 \ubaa9\uc801 \ubc0f \uae30\ub300 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0 \ub77c\uc778\uc744 \uad00\ub9ac\ud558\uace0 \uc790\ub3d9\ud654\ud558\uc5ec \uc0dd\uc0b0 \uacfc\uc815\uc744 \ubaa8\ub2c8\ud130\ub9c1\ud558\uace0 \uc0dd\uc0b0 \ube44\uc6a9\uc744 \uc808\uac10\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uc2a4\ub9c8\ud2b8 \uad50\ud1b5' \uc2dc\uc2a4\ud15c\uc774 \ub3c4\uc2ec \uad50\ud1b5 \ud750\ub984\uc744 \uac1c\uc120\ud558\uace0 \uc0ac\uace0\ub97c \uc904\uc774\uae30 \uc704\ud574 \ud65c\uc6a9\ud558\ub294 \ud575\uc2ec \uae30\uc220 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\uc758 \uc81c\uc5b4, \uad50\ud1b5 \uc2e0\ud638 \uccb4\uacc4 \uc870\uc815"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc758 \uad6c\uc131 \uc694\uc18c \uc911 \uc13c\uc11c\uc640 \uc561\ucd94\uc5d0\uc774\ud130\uc758 \uc5ed\ud560 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc13c\uc11c\ub294 \uc8fc\ubcc0 \ud658\uacbd \ub370\uc774\ud130\ub97c \uac10\uc9c0\ud558\ub294 \uc785\ub825 \uc7a5\uce58\uc774\uace0, \uc561\ucd94\uc5d0\uc774\ud130\ub294 \uc81c\uc5b4 \uc2e0\ud638\uc5d0 \ub530\ub77c \ubb3c\ub9ac\uc801\uc73c\ub85c \ub3d9\uc791\ud558\ub294 \ucd9c\ub825 \uc7a5\uce58\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874 \uc804\ub825\ub9dd\uacfc \uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc\uc758 \uac00\uc7a5 \ud070 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874 \uc804\ub825\ub9dd\uc740 \ub2e8\ubc29\ud5a5 \uacf5\uae09 \uc704\uc8fc\uc774\ub098, \uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc\ub294 ICT\ub97c \uc735\ud569\ud558\uc5ec \uc804\ub825 \uc815\ubcf4\ub97c \uc2e4\uc2dc\uac04 \uc591\ubc29\ud5a5\uc73c\ub85c \uad50\ud658\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc559 \uc9d1\uc911\ud615 \ub370\uc774\ud130 \uc11c\ubc84 \uad00\ub9ac \ubc29\uc2dd\uacfc \ube14\ub85d\uccb4\uc778 \uae30\ubc18 \ub370\uc774\ud130 \uad00\ub9ac \ubc29\uc2dd\uc758 \uacb0\uc815\uc801 \ucc28\uc774\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc559 \uc9d1\uc911\ud615\uc740 \ub2e8\uc77c \uc11c\ubc84\uc5d0 \ub370\uc774\ud130\uac00 \uc9d1\uc911\ub418\ub098, \ube14\ub85d\uccb4\uc778\uc740 \ud2b9\uc815 \uc11c\ubc84\uc5d0 \uc9d1\uc911\ub418\uc9c0 \uc54a\uace0 \uc5f0\uacb0\ub41c \ubaa8\ub4e0 \uae30\uae30\uac00 \ub3d9\uc77c\ud55c \ubcf5\uc0ac\ubcf8\uc744 \uacf5\uc720\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc758 \ub3d9\uc791 \uacfc\uc815 \uc911 [ \ub370\uc774\ud130 \uc218\uc9d1 \u2192 \ub370\uc774\ud130 ____ \u2192 \ub370\uc774\ud130 \ucc98\ub9ac \u2192 \uc11c\ube44\uc2a4 \uc81c\uacf5 ]\uc758 \ube48\uce78\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc1a1 (\ub124\ud2b8\uc6cc\ud06c\ub97c \ud1b5\ud574 \uc218\uc9d1\ub41c \ub370\uc774\ud130\ub97c \ubaa8\uc73c\ub294 \uacfc\uc815)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc5d0\uc11c \uc13c\uc11c\ub85c \uc5bb\uc740 \uc815\ubcf4\ub97c \ucc98\ub9ac\ud558\uace0 \uc561\ucd94\uc5d0\uc774\ud130\ub97c \uc81c\uc5b4\ud558\ub294 \ud575\uc2ec \ucc98\ub9ac \uc7a5\uce58\ub294 _____\uc774\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9c8\uc774\ud06c\ub85c\ucee8\ud2b8\ub864\ub7ec"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874\uc758 \uc804\ub825\ub9dd\uc5d0 \uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220(ICT)\uc744 \uc735\ud569\ud558\uc5ec \uc5d0\ub108\uc9c0 \uc0dd\uc0b0\uacfc \uc18c\ube44\ub97c \ud6a8\uc728\ud654\ud558\ub294 \uc9c0\ub2a5\ud615 \uc804\ub825\ub9dd\uc744 _____\ub77c \ud55c\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube14\ub85d\uccb4\uc778 \uae30\uc220\uc740 \ub370\uc774\ud130\ub97c '____'\uc774\ub77c\ub294 \uc791\uc740 \ub2e8\uc704\ub85c \ub098\ub204\uace0 \uc5f0\uacb0\ud558\uc5ec \uc800\uc7a5\ud55c\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube14\ub85d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137 \uc13c\uc11c\ub85c \ubaa8\uc740 \ub300\ub7c9\uc758 \ub370\uc774\ud130\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uae30 \uc704\ud55c \ub300\ud45c\uc801\uc778 \uc800\uc7a5 \uae30\uc220 2\uac00\uc9c0\ub294 \ub370\uc774\ud130\ubca0\uc774\uc2a4 \uae30\uc220\uacfc _____ \ucef4\ud4e8\ud305 \uae30\uc220\uc774\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\uc6b0\ub4dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc758 \ucd9c\ub825 \uc7a5\uce58\ub85c, \ub9c8\uc774\ud06c\ub85c\ucee8\ud2b8\ub864\ub7ec\uc758 \uc81c\uc5b4\ub85c \ubb3c\ub9ac\uc801 \ub3d9\uc791\uc744 \uc218\ud589\ud558\ub294 \uc7a5\uce58\ub97c \ub2e4\ub978 \ub9d0\ub85c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\ub3d9\uae30 (\uc561\ucd94\uc5d0\uc774\ud130)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ube4c\ub529\uc758 \ub300\ud45c\uc801\uc778 \uc2e4\ub0b4 \ud658\uacbd \ubaa8\ub2c8\ud130\ub9c1 \uad00\ub9ac \uc694\uc18c 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc0b0\ud654 \ud0c4\uc18c \uce21\uc815, \uac00\uc2a4 \uce21\uc815 (\ud654\uc7ac \uac10\uc9c0 \ud3ec\ud568)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ube4c\ub529\uc5d0\uc11c \uc548\uc804 \ubc0f \ucd9c\uc785 \ubcf4\uc548 \uad00\ub9ac\ub97c \uc790\ub3d9\ud654\ud558\ub294 \uc2dc\uc2a4\ud15c\uc758 \uae30\ub2a5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ub3d9 \ucd9c\uc785 \uc81c\uc5b4 \uc2dc\uc2a4\ud15c (\uce68\uc785 \uac10\uc9c0, \ucd9c\uc785\ubb38 \uc81c\uc5b4, \uae34\uae09 \uc2e0\uace0 \uae30\ub2a5 \uc81c\uacf5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648\uc5d0\uc11c \uc81c\uacf5\ub418\ub294 \ub9de\ucda4\ud615 \uc0ac\uc6a9\uc790 \ud3b8\uc758 \uc11c\ube44\uc2a4 2\uac00\uc9c0 \uc608\uc2dc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc6a9\uc790 \uc0c1\ud0dc\uc5d0 \ub530\ub978 \uc74c\uc545 \uc5f0\uacb0, \uc694\ub9ac \ub808\uc2dc\ud53c \uc81c\uacf5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac74\ucd95\ubb3c \uc548\uc804 \uad00\ub9ac \uc2dc \uae30\uc874 \ud604\uc7a5 \uc810\uac80 \ubc29\uc2dd\uacfc IoT\u00b7\ube14\ub85d\uccb4\uc778 \uae30\ubc18 \ub514\uc9c0\ud138 \uad00\ub9ac \ubc29\uc2dd\uc758 \ucc28\uc774\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874\uc5d0\ub294 \uc0ac\ub78c\uc774 \uc77c\uc77c\uc774 \uc810\uac80\ud558\ub358 \uc778\ub825 \uc911\uc2ec\uc774\uc5c8\uc73c\ub098, \ub514\uc9c0\ud138 \ub370\uc774\ud130 \uae30\ubc18\uc73c\ub85c \uc804\ud658\ub418\uc5b4 \uc2e0\uc18d\ud558\uace0 \uc815\ud655\ud55c \uad00\ub9ac\uac00 \uac00\ub2a5\ud574\uc9c4\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137 \uc13c\uc11c \uae30\uc220 \uc911 \ucc28 \uc18d\ub3c4\ub098 \uae30\uc6b8\uc784 \ub4f1\uc744 \uac10\uc9c0\ud558\ub294 \ub370 \ud65c\uc6a9\ub418\ub294 \uc13c\uc11c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc18d\ub3c4 \uc13c\uc11c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137 \uc2dc\uc2a4\ud15c \uac1c\ubc1c \uc2dc \ub370\uc774\ud130\ub97c \ucc98\ub9ac\ud558\uace0 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \ud575\uc2ec \uae30\uc220 \uc601\uc5ed\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\uc11d \uae30\uc220 \ubc0f \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uae30\uc220"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucef4\ud4e8\ud305 \uc2dc\uc2a4\ud15c \ubc1c\uc804\uc758 3\ub2e8\uacc4 \ud750\ub984\uc744 \ub2e8\uc21c \ud558\ub4dc\uc6e8\uc5b4/\uc18c\ud504\ud2b8\uc6e8\uc5b4 \ub4f1\uc7a5\ubd80\ud130 \uc0ac\ubb3c \uc778\ud130\ub137\uae4c\uc9c0 \uc21c\uc11c\ub300\ub85c \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd08\uae30 \ucef4\ud4e8\ud305 \uc2dc\uc2a4\ud15c(HW+SW) \u2192 \ub124\ud2b8\uc6cc\ud06c/\uc778\ud130\ub137 \uc5f0\uacb0(\uc815\ubcf4 \uacf5\uc720) \ubc0f \ud53c\uc9c0\uceec \ucef4\ud4e8\ud305(\ud604\uc2e4-\ub514\uc9c0\ud138 \uc18c\ud1b5) \u2192 \uc0ac\ubb3c \uc778\ud130\ub137(\ubaa8\ub4e0 \uc0ac\ubb3c \uc5f0\uacb0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8\uc6cc\uce58\ub97c \uc774\uc6a9\ud55c \uac1c\uc778 \uac74\uac15 \uad00\ub9ac \ub3d9\uc791 \uacfc\uc815\uc740 \uc0ac\ubb3c \uc778\ud130\ub137\uc758 \uc5b4\ub5a4 \ub2e8\uacc4\ub4e4\uc744 \uac70\uce58\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac78\uc74c \uc218\u00b7\uc2ec\uc7a5 \uc0c1\ud0dc \uae30\ub85d(\uc218\uc9d1) \u2192 \uc2e4\uc2dc\uac04 \ub3d9\uae30\ud654(\uc804\uc1a1) \u2192 \uac74\uac15 \uad00\ub9ac \uc13c\ud130 \ubd84\uc11d(\ucc98\ub9ac) \u2192 \uac74\uac15 \uad00\ub9ac \ud53c\ub4dc\ubc31(\uc11c\ube44\uc2a4 \uc81c\uacf5)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc\uac00 \uc5d0\ub108\uc9c0 \uc808\uac10\uc5d0 \uae30\uc5ec\ud558\ub294 \uc2e4\uc2dc\uac04 \uc815\ubcf4 \uad50\ud658 \uc6d0\ub9ac\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\ub825 \uc218\uc694\uc640 \uacf5\uae09\ub7c9 \uc815\ubcf4\ub97c \uc2e4\uc2dc\uac04\uc73c\ub85c \ubaa8\ub2c8\ud130\ub9c1\ud558\uace0 \uad50\ud658\ud558\uc5ec \ud544\uc694\ud55c \ub9cc\ud07c\ub9cc \uc804\ub825\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc0dd\uc0b0\ud558\uace0 \ubd84\ubc30\ud55c\ub2e4."
          }
        ]
      }
    }
  ]
}