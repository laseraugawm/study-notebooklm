{
  "title": "\ub514\uc9c0\ud138\ub370\uc774\ud130 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub514\uc9c0\ud138 \ub370\uc774\ud130 \uc555\ucd95 \uacfc\uc815\uc5d0\uc11c \uc778\ucf54\ub529(encoding)\uacfc \ub514\ucf54\ub529(decoding), \uadf8\ub9ac\uace0 \uc555\ucd95 \ubc29\uc2dd(\uc190\uc2e4/\ube44\uc190\uc2e4)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc778\ucf54\ub529\uc740 \ub370\uc774\ud130\uc758 \ube44\ud2b8 \uc218\ub97c \uc904\uc774\uae30 \uc704\ud574 \ub2e4\ub978 \ud615\ud0dc\ub85c \ubcc0\ud658\ud558\ub294 \uacfc\uc815\uc774\uace0, \uc555\ucd95 \ud574\uc81c \ud6c4 \uc785\ub825 \ub370\uc774\ud130\uc640 \ucd9c\ub825 \ub370\uc774\ud130\uac00 \uc644\uc804\ud788 \ub3d9\uc77c\ud558\uba74 \ube44\uc190\uc2e4 \uc555\ucd95\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc778\ucf54\ub529\uc740 \uc804\uccb4 \ube44\ud2b8 \uc218\ub97c \uc904\uc774\uae30 \uc704\ud574 \ud615\uc2dd\uc744 \ubcc0\ud658\ud558\ub294 \ubd80\ud638\ud654 \uacfc\uc815\uc774\uba70, \uc555\ucd95 \ud6c4 \ub514\ucf54\ub529\ud588\uc744 \ub54c \uc6d0\ubcf8\uacfc \ucd9c\ub825 \ub370\uc774\ud130\uac00 \uc644\uc804\ud788 \uc77c\uce58\ud558\ub294 \uac83\uc744 \ube44\uc190\uc2e4 \uc555\ucd95\uc774\ub77c\uace0 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub514\ucf54\ub529 \uacfc\uc815\uc740 \uc554\ud638\ud654 \ub610\ub294 \ubd80\ud638\ud654\ub77c\uace0\ub3c4 \ubd88\ub9ac\uba70, \uc785\ub825 \ub370\uc774\ud130\uc758 \ud06c\uae30\ub97c \uc904\uc774\ub294 \uc5ed\ud560\uc744 \ub2f4\ub2f9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd80\ud638\ud654\ub098 \uc554\ud638\ud654\ub294 \ub514\ucf54\ub529\uc774 \uc544\ub2cc \uc778\ucf54\ub529\uc758 \ub2e4\ub978 \uba85\uce6d\uc774\uba70, \ub514\ucf54\ub529\uc740 \uc555\ucd95\ub41c \ub370\uc774\ud130\ub97c \uc6d0\ub798 \ud615\ud0dc\ub85c \ubcf5\uc6d0(\ubcf5\ud638\ud654)\ud558\ub294 \uacfc\uc815\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc190\uc2e4 \uc555\ucd95\uc740 \ub514\ucf54\ub529 \uacb0\uacfc\uac00 \uc6d0\ubcf8 \ub370\uc774\ud130\uc640 \ub2ec\ub77c\uc9c0\ubbc0\ub85c, \ubb38\uc790 \ub370\uc774\ud130\ucc98\ub7fc \uc815\ud655\ud574\uc57c \ud558\ub294 \uc601\uc5ed\uc5d0\ub294 \uc801\uc6a9\ud560 \uc218 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb38\uc790 \ub370\uc774\ud130\ub294 \uc190\uc2e4 \uc555\ucd95\uc744 \uc801\uc6a9\ud558\uba74 \uc6d0\ubcf8 \ub0b4\uc6a9\uc774 \ubcc0\uc9c8\ub420 \uc704\ud5d8\uc774 \uc788\uc73c\ubbc0\ub85c \ud56d\uc0c1 \ube44\uc190\uc2e4 \uc555\ucd95 \ubc29\uc2dd\uc744 \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\ucf54\ub529\ub41c \ub370\uc774\ud130\ub97c \uc6d0\ub798 \ud615\ud0dc\uc758 \ub370\uc774\ud130\ub85c \ubcf5\uc6d0\ud558\ub294 \uacfc\uc815\uc744 \uc778\ucf54\ub529\uc774\ub77c \ud558\uace0, \ube44\ud2b8 \uc218\ub97c \uc904\uc774\ub294 \uacfc\uc815\uc744 \ub514\ucf54\ub529\uc774\ub77c\uace0 \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube44\ud2b8 \uc218\ub97c \uc904\uc5ec \uc555\ucd95\ud558\ub294 \uac83\uc774 \uc778\ucf54\ub529\uc774\uba70, \uc778\ucf54\ub529\ub41c \ub370\uc774\ud130\ub97c \uc555\ucd95 \uc804 \ub370\uc774\ud130\ub85c \ub418\ub3cc\ub9ac\ub294 \ubcf5\uc6d0 \uacfc\uc815\uc774 \ub514\ucf54\ub529\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub370\uc774\ud130 \ubcc0\ud658 \ubc29\ud5a5\uacfc \ubcf5\uc6d0 \ud6c4 \uc6d0\ubcf8\uacfc\uc758 \uc77c\uce58 \uc5ec\ubd80\ub97c \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ubb38\uc790\uc5f4 \ube44\uc190\uc2e4 \uc555\ucd95 \uc54c\uace0\ub9ac\uc998\uc778 \ub7f0-\ub81d\uc2a4(Run-Length) \uc778\ucf54\ub529\uacfc \ub818\ud3a0-\uc9c0\ube0c(Lempel-Ziv) \uc778\ucf54\ub529\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub818\ud3a0-\uc9c0\ube0c \uc778\ucf54\ub529\uc740 \ub5a8\uc5b4\uc838 \uc788\ub294 \uac19\uc740 \ud328\ud134\ub3c4 \uc0c1\ub300\uc801 \uc704\uce58\uc640 \ud328\ud134\uc758 \uae38\uc774\ub97c \uc774\uc6a9\ud574 \uce58\ud658\ud558\ubbc0\ub85c \ubc18\ubcf5 \ud328\ud134\uc774 \ub9ce\uc740 \uae34 \ubb38\uc790\uc5f4\uc5d0\uc11c \uc555\ucd95 \ud6a8\uc728\uc774 \ub192\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub818\ud3a0-\uc9c0\ube0c \uc778\ucf54\ub529\uc740 \uc5f0\uc18d\ub418\uc9c0 \uc54a\uace0 \ub5a8\uc5b4\uc838 \uc874\uc7ac\ud558\ub294 \ubc18\ubcf5 \ud328\ud134\uc758 \uc0c1\ub300 \uc704\uce58\uc640 \uae38\uc774\ub97c \uc774\uc6a9\ud558\ubbc0\ub85c, \uae34 \ubb38\ub9e5 \ub0b4 \uc911\ubcf5\uc774 \ub9ce\uc740 \ub370\uc774\ud130 \uc555\ucd95\uc5d0 \uc720\ub9ac\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub7f0-\ub81d\uc2a4 \uc778\ucf54\ub529\uc740 \uc5f0\uc18d \ubc18\ubcf5 \ubb38\uc790\uac00 \uc801\uace0 \ubb34\uc791\uc704 \ubb38\uc790\uac00 \uae38\uac8c \uc774\uc5b4\uc9c8\uc218\ub85d \uc555\ucd95 \ud6a8\uc728\uc774 \ub354 \ub192\uc544\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub7f0-\ub81d\uc2a4 \uc778\ucf54\ub529\uc740 \ub3d9\uc77c\ud55c \ubb38\uc790\uac00 \uc5f0\uc18d\ud574\uc11c \uae38\uac8c \ubc18\ubcf5\ub420 \ub54c \uc555\ucd95 \ud6a8\uc728\uc774 \ub192\uc544\uc9c0\ub294 \uc54c\uace0\ub9ac\uc998\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub818\ud3a0-\uc9c0\ube0c \uc778\ucf54\ub529\uc740 \uc624\uc9c1 \ubc14\ub85c \uc778\uc811\ud558\uc5ec \uc5f0\uc18d\uc73c\ub85c \uc911\ubcf5\ub418\ub294 \ubb38\uc790\ub9cc \ucc98\ub9ac\ud560 \uc218 \uc788\ub2e4\ub294 \uc81c\ud55c\uc774 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uc18d\ub41c \uc911\ubcf5 \ubb38\uc790\ub97c \uac1c\uc218\uc640 \ubb38\uc790\uc758 \uc30d\uc73c\ub85c \ud45c\ud604\ud558\ub294 \uac83\uc740 \ub7f0-\ub81d\uc2a4\uc774\uba70, \ub818\ud3a0-\uc9c0\ube0c\ub294 \ub5a8\uc5b4\uc838 \uc788\ub294 \ud328\ud134\ub3c4 \uc555\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub7f0-\ub81d\uc2a4 \uc778\ucf54\ub529 \uc2dc \ubc18\ubcf5 \uc5c6\ub294 \ub2e8\uc77c \ubb38\uc790\ub294 \ubb38\uc790 \uc55e\uc5d0 \ubc18\ubcf5 \ud69f\uc218 '1'\uc744 \ubc18\ub4dc\uc2dc \ud45c\uae30\ud574\uc57c \uc555\ucd95\uc774 \uc815\uc0c1 \uc218\ud589\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc18\ubcf5\uc774 \uc5c6\ub294 \ubb38\uc790\uc758 \uacbd\uc6b0 \uc22b\uc790 '1'\uc744 \uc0dd\ub7b5\ud568\uc73c\ub85c\uc368 \ube44\ud2b8\ub97c \uc808\uc57d\ud558\uace0 \uc555\ucd95 \ud6a8\uc728\uc744 \ub354 \ub192\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc5f0\uc18d\ub41c \ubc18\ubcf5 \ubb38\uc790\ub97c \uc904\uc774\ub294 \uc54c\uace0\ub9ac\uc998\uacfc \ub5a8\uc5b4\uc9c4 \ud328\ud134\uc758 \uc0c1\ub300 \uc704\uce58/\uae38\uc774\ub97c \ud65c\uc6a9\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc758 \ucc28\uc774\ub97c \ube44\uad50\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc6d0\ubcf8 \ubb38\uc790\uc5f4\uc5d0 \uc22b\uc790\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\ub294 \uacbd\uc6b0, \ub7f0-\ub81d\uc2a4 \uc778\ucf54\ub529\uc744 \uc801\uc6a9\ud560 \ub54c \uc22b\uc790 \ub370\uc774\ud130\uc640 \ubb38\uc790\uc758 \ubc18\ubcf5 \ud69f\uc218 \ud45c\uae30\ub97c \uad6c\ubd84\ud558\uae30 \uc704\ud55c \ubc29\ubc95\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucd9c\ud604 \ube48\ub3c4\uac00 \uc801\uc740 \ubb38\uc790\ub97c \ud0c8\ucd9c \ubb38\uc790(escape character)\ub85c \uc9c0\uc815\ud558\uc5ec \ubc18\ubcf5 \ubb38\uc790 \uac1c\uc218\uc640 \uad6c\ubd84\ud558\uc5ec \uc555\ucd95\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc6d0\ubcf8 \ubb38\uc790\uc5f4\uc5d0 \uc22b\uc790\uac00 \ud3ec\ud568\ub41c \uacbd\uc6b0, \ucd9c\ud604 \ube48\ub3c4\uac00 \uc801\uc740 \ud2b9\uc218 \ubb38\uc790(\uc608: `*`)\ub97c \ud0c8\ucd9c \ubb38\uc790\ub85c \uc0ac\uc6a9\ud558\uc5ec \ub370\uc774\ud130\uc0c1\uc758 \uc22b\uc790\uc640 \ubc18\ubcf5 \ud69f\uc218 \uc22b\uc790\ub97c \uad6c\ubd84\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubb38\uc790\uc5f4 \ub0b4\uc758 \ubaa8\ub4e0 \uc22b\uc790\ub97c 16\uc9c4\uc218 \ucf54\ub4dc\ub85c \uc77c\uad04 \ubcc0\ud658\ud558\uc5ec \uc555\ucd95 \ubb38\uc790\uc5f4\uc758 \ub9e8 \ub4a4\ub85c \uc774\ub3d9\uc2dc\ud0a8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc22b\uc790\ub97c \uad6c\ubd84\ud558\uae30 \uc704\ud574 \uc704\uce58\ub97c \uc774\ub3d9\uc2dc\ud0a4\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ud0c8\ucd9c \ubb38\uc790\ub97c \uae30\ud638\ub85c \uc0bd\uc785\ud558\uc5ec \ud45c\uc2dc\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc22b\uc790\uac00 \ud3ec\ud568\ub41c \ubb38\uc790\uc5f4\uc740 \ub7f0-\ub81d\uc2a4 \uc778\ucf54\ub529\uc774 \ubd88\uac00\ub2a5\ud558\ubbc0\ub85c \ubc18\ub4dc\uc2dc \uc190\uc2e4 \uc555\ucd95 \uc54c\uace0\ub9ac\uc998\uc73c\ub85c \ubcc0\ud658\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb38\uc790\uc5f4 \uc555\ucd95\uc740 \ube44\uc190\uc2e4 \uc555\ucd95\uc744 \uae30\ubcf8\uc73c\ub85c \ud558\uba70, \ud0c8\ucd9c \ubb38\uc790\ub97c \ud65c\uc6a9\ud558\uba74 \uc22b\uc790\uac00 \ud3ec\ud568\ub418\uc5b4\ub3c4 \ub7f0-\ub81d\uc2a4 \uc555\ucd95\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc22b\uc790 \ub370\uc774\ud130 \uc790\uccb4\ub97c \uc0ad\uc81c\ud558\uace0 \ubb38\uc790\uc758 \uc5f0\uc18d \ubc18\ubcf5 \ud69f\uc218\ub9cc \uc801\ub294 \ubc29\uc2dd\uc73c\ub85c \ub370\uc774\ud130 \uc6a9\ub7c9\uc744 \uc904\uc778\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc6d0\ubcf8 \ub370\uc774\ud130\uc758 \uc22b\uc790\ub97c \uc0ad\uc81c\ud558\uba74 \ub370\uc774\ud130 \uc720\uc2e4\uc774 \ubc1c\uc0dd\ud558\ub294 \uc190\uc2e4 \uc555\ucd95\uc774 \ub418\uc5b4 \ubc84\ub9ac\ubbc0\ub85c \ube44\uc190\uc2e4 \ubb38\uc790\uc5f4 \uc555\ucd95\uc5d0 \uc5b4\uae0b\ub0a9\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc22b\uc790\uc640 \ubc18\ubcf5 \uac1c\uc218\uac00 \uc11e\uc774\uc9c0 \uc54a\ub3c4\ub85d \uad6c\ubd84\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \ud2b9\ubcc4\ud55c \ubb38\uc790\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ube44\ud2b8\ub9f5 \uc774\ubbf8\uc9c0\uc758 \uc0c9\uc0c1 \ud45c\ud604 \ube44\ud2b8 \uc218 \ubc0f \ud30c\uc77c \ud615\uc2dd\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "24\ube44\ud2b8 \ud2b8\ub8e8 \uceec\ub7ec(True Color)\ub294 RGB \uac01\uac01\uc758 \uc0c9\uc0c1 \uc870\ud569\uc744 \ud1b5\ud574 \ucd1d $2^{24}$\uac00\uc9c0(\uc57d 1,677\ub9cc \uac00\uc9c0)\uc758 \uc0c9\uc744 \ud45c\ud604\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud654\uc18c\ub2f9 24\ube44\ud2b8\ub97c \ud560\ub2f9\ud558\uba74 $2^{24} = 16,777,216$\uac00\uc9c0\uc758 \ud2b8\ub8e8 \uceec\ub7ec \uc0c9\uc0c1\uc744 \uc138\ubc00\ud558\uac8c \ud45c\ud604\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "8\ube44\ud2b8 \uc0c9\uc0c1 \ud45c\ud604 \ubc29\uc2dd\uc740 \ucd1d $2^8 = 512$\uac00\uc9c0\uc758 \uc0c9\uc0c1\uc744 \uc9c0\uc6d0\ud558\uc5ec \uace0\ud488\uc9c8 \uc0ac\uc9c4 \uc800\uc7a5\uc5d0 \uc801\ud569\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "$2^8$\uc740 256\uac00\uc9c0\uc758 \uc0c9\uc0c1\uc744 \uc758\ubbf8\ud558\uba70, 512\uac00\uc9c0\uac00 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "BMP \ud30c\uc77c\uc740 \ud654\uc18c \uc815\ubcf4\ub97c \uace0\uc728\ub85c \uc190\uc2e4 \uc555\ucd95\ud558\uc5ec \uc778\ud130\ub137 \uc804\uc1a1 \ubc0f \uacf5\uc720\uac00 \ub9e4\uc6b0 \ube60\ub978 \uac83\uc774 \uc7a5\uc810\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "BMP \ud30c\uc77c\uc740 \uac01 \ud654\uc18c\uc758 \uc0c9 \uc815\ubcf4\ub97c \ucc28\ub840\ub300\ub85c \uae30\ub85d\ud558\ub294 \ubb34\uc555\ucd95 \ud30c\uc77c \ud615\uc2dd\uc73c\ub85c \uc6a9\ub7c9\uc774 \ub9e4\uc6b0 \ucee4\uc11c \uc778\ud130\ub137 \uacf5\uc720\uc5d0 \ubd88\ub9ac\ud569\ub2c8\ub2e4."
        },
        {
          "text": "1\ube44\ud2b8 \uc0c9\uc0c1 \ud45c\ud604 \ubc29\uc2dd\uc740 \ud751, \ubc31, \uc801, \ub85d\uc758 4\uac00\uc9c0 \uae30\ubcf8 \uc0c9\uc0c1\uc744 \ud45c\ud604\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "1\ube44\ud2b8\ub294 $2^1 = 2$\uac00\uc9c0 \uc0c9\uc0c1(\ub2e8\uc0c9, \uc608: \ud751\ubc31)\ub9cc \ud45c\ud604\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ube44\ud2b8 \uc218\uc5d0 \ub530\ub978 \ud45c\ud604 \uac00\ub2a5 \uc0c9\uc0c1 \uc218 \uacc4\uc0b0 \uacf5\uc2dd($2^n$)\uacfc \ubb34\uc555\ucd95 \ud30c\uc77c \ud615\uc2dd\uc758 \ud2b9\uc9d5\uc744 \uc810\uac80\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc774\ubbf8\uc9c0 \uc555\ucd95 \ud30c\uc77c \ud615\uc2dd(PNG, GIF, JPEG)\uc758 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "GIF\ub294 256\uc0c9 \uc774\ud558\uc758 \uc774\ubbf8\uc9c0\ub97c \uc555\ucd95\ud560 \ub54c\ub294 \uc190\uc2e4\uc774 \uc5c6\uc9c0\ub9cc, 256\uc0c9\uc744 \ucd08\uacfc\ud558\ub294 \uc774\ubbf8\uc9c0\ub294 \uc9c0\uc6d0 \uac00\ub2a5\ud55c \uc0c9\uc73c\ub85c \ubcc0\ud658\ub418\ubbc0\ub85c \uc774\ubbf8\uc9c0 \uc190\uc2e4\uc774 \ubc1c\uc0dd\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "GIF\ub294 8\ube44\ud2b8(256\uc0c9) \uae30\ubc18\uc774\ubbc0\ub85c 256\uc0c9 \uc774\ud558\uc758 \uc774\ubbf8\uc9c0\ub294 \ube44\uc190\uc2e4 \uc555\ucd95\ub418\uc9c0\ub9cc, 256\uc0c9\uc744 \ub118\ub294 \uc6d0\ubcf8\uc740 \uc0c9\uc0c1\uc774 \ubcc0\ud658\u00b7\uac10\uc18c\ud558\uba74\uc11c \uc774\ubbf8\uc9c0 \uc190\uc2e4\uc774 \uc77c\uc5b4\ub0a9\ub2c8\ub2e4."
