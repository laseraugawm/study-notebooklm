          "isCorrect": false
        }
      ],
      "hint": "\uc9c0\ub3c4\ud559\uc2b5\uc758 '\ud68c\uadc0/\ubd84\ub958'\uc640 \uad6c\ubd84\ub418\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5\uc758 \ub450 \uae30\ubc95\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ud3fc\ud398\uc774 \ud654\uc0b0 \ud3ed\ubc1c\ub85c \uac80\uac8c \ud0c4 \ud30c\ud53c\ub8e8\uc2a4 \ub450\ub8e8\ub9c8\ub9ac\uc758 \uc228\uaca8\uc9c4 \uae00\uc528\ub97c \uc778\uacf5\uc9c0\ub2a5\uc73c\ub85c \uc77d\uc5b4\ub0b8 \uc0ac\ub840\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc54c\ub9de\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5d1\uc2a4\ub808\uc774 \ucd2c\uc601 \uc2dc \uc885\uc774\uac00 \uacb9\uacb9\uc774 \ub9d0\ub824 \uc788\uc5b4 \ub2e8\uc21c \ucd2c\uc601\ub9cc\uc73c\ub85c\ub294 \ud310\ub3c5\uc774 \uc5b4\ub824\uc6e0\ub2e4.",
          "rationale": "\ubcf8\ubb38\uc5d0 \ub530\ub974\uba74 \uacfc\ud559\uc790\ub4e4\uc774 \uc5d1\uc2a4\ub808\uc774\ub85c \ud310\ub3c5\ud558\ub824 \ud588\uc73c\ub098 \uacb9\uacb9\uc774 \ub9d0\ub824 \uc788\uc5b4 \uc5b4\ub824\uc6c0\uc744 \uacaa\uc5c8\ub2e4\uace0 \ub098\uc640 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uae30\uacc4\ud559\uc2b5 \uc54c\uace0\ub9ac\uc998\uc740 \uc789\ud06c\uac00 \ud30c\ud53c\ub8e8\uc2a4 \ud45c\uba74\uc5d0 \uc77c\uc73c\ud0a4\ub294 \ubbf8\uc138\ud55c \ubcc0\ud654\ub97c \uc54c\uc544\ub0b4\ub3c4\ub85d \ud559\uc2b5\ub418\uc5c8\ub2e4.",
          "rationale": "\uae30\uacc4\ud559\uc2b5 \ubaa8\ub378\uc774 \uc789\ud06c\uac00 \ub9cc\ub4e0 \ud45c\uba74\uc758 \ubcc0\ud654\ub97c \uc778\uc2dd\ud568\uc73c\ub85c\uc368 \ub36e\uc778 \ubb38\uc790\ub97c \ucc3e\uc544\ub0bc \uc218 \uc788\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub300\ud68c \ucc38\uac00\uc790\ub4e4\uc740 \uc6d0\ubcf8 \ub370\uc774\ud130\uc640 \ud574\ub3c5 \uae30\uc220\uc758 \uc720\ucd9c\uc744 \ub9c9\uae30 \uc704\ud574 \uac1c\ubc1c\ud55c \ucf54\ub4dc\ub97c \ube44\uacf5\uac1c\ub85c \uc720\uc9c0\ud588\ub2e4.",
          "rationale": "\ucc38\uac00\uc790\ub4e4\uc740 \uae30\uc220 \ub3c5\uc810\uc774 \uc544\ub2c8\ub77c \uac01\uc790\uc758 \ucf54\ub4dc\ub97c \uc624\ud508 \uc18c\uc2a4\ub85c \uacf5\uac1c\ud558\uba70 \uae30\uc220\uc744 \uc11c\ub85c \uacf5\uc720\ud558\uace0 \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "AI \uae30\uc220\uc758 \ub3c4\uc6c0\uc73c\ub85c \ud3fc\ud398\uc774 \ud30c\ud53c\ub8e8\uc2a4\uc5d0\uc11c '\ubcf4\ub77c\uc0c9'\uc744 \ub73b\ud558\ub294 \uadf8\ub9ac\uc2a4 \ubb38\uc790\ub97c \uc77d\uc5b4 \ub0b4\ub294 \ub370 \uc131\uacf5\ud588\ub2e4.",
          "rationale": "\uae30\uacc4\ud559\uc2b5\uc73c\ub85c \uc789\ud06c\ub97c \uc2dd\ubcc4\ud558\uc5ec '\ubcf4\ub77c\uc0c9($\n\n\u03c0\u03bf\u03c1\u03c6\u03cd\u03c1\u03b1c\u03ba$)'\uc774\ub77c\ub294 \ub2e8\uc5b4\ub97c \ud574\ub3c5\ud574 \ub0c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ud574\ub3c5 \ub300\ud68c \ucc38\uac00\uc790\ub4e4\uc774 \uae30\uc220 \uac1c\ubc1c \ubc0f \ucf54\ub4dc \uacf5\uc720\ub97c \uc5b4\ub5a4 \ubc29\uc2dd\uc73c\ub85c \uc9c4\ud589\ud588\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uad50\uacfc\uc11c 183\ucabd\uc758 '\ud559\uc2b5 \uc2dc\uac04\uc5d0 \ub530\ub978 \uc131\uc801 \uc608\uce21 \uc120\ud615 \ud68c\uadc0 \ubaa8\ub378' \uadf8\ub798\ud504 \ud574\uc11d\uc73c\ub85c \uac00\uc7a5 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc785\ub825\uac12\uc778 \ud559\uc2b5 \uc2dc\uac04\uacfc \uacb0\uad0f\uac12\uc778 \uc131\uc801 \uc0ac\uc774\uc758 \uad00\uacc4\ub97c \ub098\ud0c0\ub0b4\ub294 \uc9c1\uc120(\uc120\ud615 \ud68c\uadc0 \ubaa8\ub378)\uc744 \ud45c\uc2dc\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\ub450 \uc218\uce58 \uc18d\uc131\uc758 \uacbd\ud5a5\uc131\uc744 \uc798 \ud45c\ud604\ud558\ub294 \uc9c1\uc120 \ud615\ud0dc\uc758 \uc120\ud615 \ud68c\uadc0 \ud568\uc218 \ubaa8\ub378\uc744 \uc88c\ud45c \uc704\uc5d0 \ub3c4\ucd9c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3c4\ucd9c\ub41c \ud68c\uadc0 \uc9c1\uc120 \ud568\uc218\ub97c \uc0ac\uc6a9\ud558\uba74 \uc2e4\uc81c \ub370\uc774\ud130\uc5d0 \uc5c6\ub294 \ud559\uc2b5 \uc2dc\uac04($30$\uc2dc\uac04)\uc5d0 \ub300\ud55c \uc131\uc801\uc744 \uc608\uce21\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\ud68c\uadc0 \ubaa8\ub378\uc744 \uc774\uc6a9\ud558\uba74 \uae30\uc874 \ub370\uc774\ud130 \ubc94\uc704 \uc678\uc758 \uc0c8\ub85c\uc6b4 \uc785\ub825\uac12($30$\uc2dc\uac04)\uc5d0 \ub300\ud55c \uc131\uc801 \uc218\uce58\ub97c \ucd94\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud559\uc2b5 \uc2dc\uac04 \ub370\uc774\ud130\uc640 \uc131\uc801 \ub370\uc774\ud130\ub294 \ubaa8\ub450 \uc5f0\uc18d\uc801\uc778 \uac12\uc744 \uac00\uc9c0\ub294 \uc218\uce58\ud615 \ub370\uc774\ud130\uc774\ub2e4.",
          "rationale": "\uc2dc\uac04 \ubc0f \uc810\uc218\ub294 \uc5f0\uc18d\uc801\uc73c\ub85c \ubcc0\ud654\ud558\ub294 \uc22b\uc790 \ub370\uc774\ud130\uc774\ubbc0\ub85c \ud68c\uadc0 \ubaa8\ub378 \uc801\uc6a9 \uc870\uac74\uc5d0 \ub9de\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc774 \ubaa8\ub378\uc740 \ud559\uc2b5 \uc2dc\uac04\uc5d0 \ub530\ub77c \ud559\uc0dd\ub4e4\uc744 \uba87 \uac1c\uc758 \ub3c5\ub9bd\ub41c \ubd88\uc5f0\uc18d \uadf8\ub8f9\uc73c\ub85c \ubd84\ub958\ud558\ub294 \uac83\uc744 \ubaa9\ud45c\ub85c \ud55c\ub2e4.",
          "rationale": "\ub370\uc774\ud130\ub97c \uba87 \uac1c\uc758 \uadf8\ub8f9\uc774\ub098 \uce74\ud14c\uace0\ub9ac\ub85c \ub098\ub204\ub294 \uac83\uc740 \ubd84\ub958\ub098 \uad70\uc9d1\ud654\uc758 \ubaa9\uc801\uc774\uba70, \ud68c\uadc0 \ubaa8\ub378\uc758 \ubaa9\uc801\uc740 \uc5f0\uc18d\uc801\uc778 \uac12\uc758 \uc608\uce21\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\ud68c\uadc0 \ubaa8\ub378\uc774 \uc218\ud589\ud558\ub294 \ud575\uc2ec \uae30\ub2a5\uc778 '\uc5f0\uc18d\uc801 \uc218\uce58 \uc608\uce21'\uacfc '\uce74\ud14c\uace0\ub9ac \ubd84\ub958'\uc758 \ucc28\uc774\uc810\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
