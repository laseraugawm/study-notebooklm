{
  "title": "\uae30\uacc4\ud559\uc2b5 \ud034\uc988",
  "questions": [
    {
      "question": "\uc9c0\ub3c4\ud559\uc2b5\uc5d0\uc11c \uc778\uacf5\uc9c0\ub2a5 \ubaa8\ub378\uc744 \ud559\uc2b5\uc2dc\ud0ac \ub54c \uc0ac\uc6a9\ud558\ub294 '\uc785\ub825 \ub370\uc774\ud130\uc758 \uc18d\uc131'\uacfc '\uc815\ub2f5 \ub370\uc774\ud130'\ub97c \uac00\ub9ac\ud0a4\ub294 \uc6a9\uc5b4\ub85c \uc633\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud2b9\uc9d5 - \ub808\uc774\ube14",
          "rationale": "\uc9c0\ub3c4\ud559\uc2b5\uc5d0\uc11c\ub294 \uc785\ub825\ud558\ub294 \ub370\uc774\ud130\uc758 \uc18d\uc131\uc744 '\ud2b9\uc9d5(Feature)'\uc774\ub77c\uace0 \ud558\uace0, \uc774\uc5d0 \ub300\ud55c \uc815\ub2f5 \ub370\uc774\ud130\ub97c '\ub808\uc774\ube14(Label)'\uc774\ub77c\uace0 \uc815\uc758\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub808\uc774\ube14 - \ud2b9\uc9d5",
          "rationale": "\uc785\ub825 \ub370\uc774\ud130\uc758 \uc18d\uc131\uc774 \ud2b9\uc9d5\uc774\uace0 \uc815\ub2f5\uc774 \ub808\uc774\ube14\uc774\ubbc0\ub85c \ub450 \uc6a9\uc5b4\uc758 \uc21c\uc11c\uac00 \ubc18\ub300\ub85c \uc124\uba85\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac00\uc911\uce58 - \ubcf4\uc0c1",
          "rationale": "\uac00\uc911\uce58\ub294 \ubaa8\ub378 \ub0b4\ubd80 \ud30c\ub77c\ubbf8\ud130\uc774\uba70 \ubcf4\uc0c1\uc740 \uac15\ud654 \ud559\uc2b5\uc5d0\uc11c \ud589\ub3d9\uc5d0 \ub300\ud574 \uc8fc\uc5b4\uc9c0\ub294 \uc2e0\ud638\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubc94\uc8fc - \ud68c\uadc0",
          "rationale": "\ubc94\uc8fc\uc640 \ud68c\uadc0\ub294 \ub370\uc774\ud130 \uc608\uce21 \ubc0f \ubd84\ub958 \ubc29\uc2dd\uc5d0 \ub530\ub978 \ud559\uc2b5 \ubaa8\ub378 \uc720\ud615\uacfc \uad00\ub828\ub41c \uac1c\ub150\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ud559\uc2b5 \ub370\uc774\ud130\uc5d0 \uc785\ub825\ub418\ub294 \uad6c\uccb4\uc801\uc778 \uc18d\uc131 \uba85\uce6d\uacfc \uc815\ub2f5\uc744 \uac00\ub9ac\ud0a4\ub294 \uace0\uc720 \uc6a9\uc5b4\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 \ube44\uc9c0\ub3c4\ud559\uc2b5(Unsupervised Learning)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc785\ub825 \ub370\uc774\ud130\uc640 \ud568\uaed8 \uba85\ud655\ud55c \uc815\ub2f5(\ub808\uc774\ube14)\uc744 \uc81c\uacf5\ud558\uc5ec \uc778\uacf5\uc9c0\ub2a5\uc744 \ud559\uc2b5\uc2dc\ud0a8\ub2e4.",
          "rationale": "\uc815\ub2f5 \ub370\uc774\ud130(\ub808\uc774\ube14)\ub97c \uc81c\uacf5\ud558\uc5ec \uc608\uce21 \ubc0f \ubd84\ub958 \ud328\ud134\uc744 \ud559\uc2b5\uc2dc\ud0a4\ub294 \uac83\uc740 \uc9c0\ub3c4\ud559\uc2b5\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc815\ub2f5\uc774 \uc5c6\ub294 \ub370\uc774\ud130\uc5d0\uc11c \uad6c\uc870\ub098 \ud328\ud134\uc744 \uc2a4\uc2a4\ub85c \ucc3e\uc544\ub0b4\uc5b4 \ube44\uc2b7\ud55c \uac83\ub07c\ub9ac \uadf8\ub8f9\uc73c\ub85c \ubb36\ub294\ub2e4.",
          "rationale": "\ube44\uc9c0\ub3c4\ud559\uc2b5\uc740 \uba85\ud655\ud55c \uc815\ub2f5 \uc815\ubcf4 \uc5c6\uc774 \ub370\uc774\ud130 \uc790\uccb4\uc758 \ud2b9\uc131\uacfc \uc5f0\uad00 \ud328\ud134\uc744 \ubc1c\uacac\ud574 \uadf8\ub8f9\ud654\ud558\uac70\ub098 \uc8fc\uc694 \ud2b9\uc9d5\uc744 \ucd94\ucd9c\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud658\uacbd\uacfc\uc758 \uc0c1\ud638\uc791\uc6a9\uc5d0\uc11c \uc5bb\uc5b4\uc9c0\ub294 \ubcf4\uc0c1\uc744 \ucd5c\ub300\ud654\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \ud589\ub3d9\uc744 \ud559\uc2b5\ud55c\ub2e4.",
          "rationale": "\ubcf4\uc0c1\uc744 \ucd5c\uc801\ud654\ud558\uba70 \uc2dc\ud589\ucc29\uc624\ub97c \ud1b5\ud574 \ud589\ub3d9 \ubc29\uc2dd\uc744 \uc775\ud788\ub294 \uac83\uc740 \uac15\ud654 \ud559\uc2b5\uc758 \uac1c\ub150\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud559\uc2b5 \uc2dc\uac04\uc5d0 \ub530\ub978 \uc2dc\ud5d8 \uc810\uc218\uc640 \uac19\uc740 \uc5f0\uc18d\uc801\uc778 \uc218\uce58\ud615 \ub370\uc774\ud130\ub9cc\uc744 \uc608\uce21\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud55c\ub2e4.",
          "rationale": "\uc5f0\uc18d\uc801\uc778 \uc218\uce58 \ub370\uc774\ud130\ub97c \uc608\uce21\ud558\ub294 \uc791\uc5c5\uc740 \uc9c0\ub3c4\ud559\uc2b5\uc758 \ud68c\uadc0(Regression) \ubaa8\ub378\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub370\uc774\ud130\uc5d0 \uc815\ub2f5 \ub808\uc774\ube14\uc774 \uc8fc\uc5b4\uc9c0\uc9c0 \uc54a\uc558\uc744 \ub54c \ubaa8\ub378\uc774 \uc2a4\uc2a4\ub85c \uc218\ud589\ud558\ub294 \uc5ed\ud560\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uac15\ud654 \ud559\uc2b5(Reinforcement Learning)\uc758 \ud2b9\uc9d5\uacfc \uc6d0\ub9ac\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ub78c\uc774 \uc2dc\ud589\ucc29\uc624\ub97c \uacaa\uc73c\uba70 \uc810\ucc28 \ub098\uc740 \ud589\ub3d9\uc744 \uc775\ud600 \uac00\ub294 \uacfc\uc815\uacfc \uc720\uc0ac\ud558\ub2e4.",
          "rationale": "\uac15\ud654 \ud559\uc2b5\uc740 \uc2dc\ud589\ucc29\uc624\ub97c \ud1b5\ud574 \ub098\uc740 \ud589\ub3d9 \ud328\ud134\uc744 \ucc3e\uc544\uac00\ub294 \uc0ac\ub78c\uc758 \ud559\uc2b5 \ubc29\uc2dd\uacfc \uc720\uc0ac\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc5b4\ub5a4 \ud589\ub3d9\uc5d0 \ub300\ud574 \uc8fc\uc5b4\uc9c0\ub294 '\ubcf4\uc0c1'\uc744 \ucd5c\ub300\ud654\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \ud559\uc2b5\uc774 \uc9c4\ud589\ub41c\ub2e4.",
          "rationale": "\uc2dc\ud589\ucc29\uc624 \uacfc\uc815\uc5d0\uc11c \uc5bb\ub294 \ubcf4\uc0c1\uc744 \ucd5c\ub300\ud654\ud558\uc5ec \ucd5c\uc801\uc758 \ud589\ub3d9 \ubc29\uce68\uc744 \uc138\uc6b0\ub3c4\ub85d \ud559\uc2b5\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc8fc\uc5b4\uc9c4 \ub370\uc774\ud130\ub098 \ud658\uacbd\uc5d0 \ub300\ud55c \uc0ac\uc804 \uc9c0\uc2dd\uc774 \uc5c6\uc5b4\ub3c4 \uc2a4\uc2a4\ub85c \ud559\uc2b5\ud558\uace0 \uc801\uc751\ud55c\ub2e4.",
          "rationale": "\uac15\ud654 \ud559\uc2b5\uc740 \uc0ac\uc804 \uc815\ubcf4 \uc5c6\uc774 \ud658\uacbd\uacfc\uc758 \uc9c1\uc811\uc801\uc778 \uc0c1\ud638\uc791\uc6a9\uc744 \ud1b5\ud574 \uc801\uc751\ud574 \ub098\uac00\ub294 \ud2b9\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud559\uc2b5\uc744 \uc2dc\uc791\ud558\uae30 \uc804 \uc218\ub9ce\uc740 \uc785\ub825 \ub370\uc774\ud130\ub9c8\ub2e4 \uc815\ud655\ud55c \uc815\ub2f5 \ub808\uc774\ube14\uc744 \uc0ac\uc804\uc5d0 \ubd80\uc5ec\ud574\uc57c \ud55c\ub2e4.",
          "rationale": "\ub370\uc774\ud130\uc5d0 \ubbf8\ub9ac \uc815\ub2f5 \ub808\uc774\ube14\uc744 \ubd80\uc5ec\ud558\uc5ec \ud559\uc2b5\uc2dc\ud0a4\ub294 \ubc29\uc2dd\uc740 \uc9c0\ub3c4\ud559\uc2b5\uc774\uba70, \uac15\ud654 \ud559\uc2b5\uc740 \ub808\uc774\ube14 \ub300\uc2e0 \ubcf4\uc0c1 \uc2e0\ud638\ub97c \uc774\uc6a9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\uac15\ud654 \ud559\uc2b5\uc774 \ubbf8\ub9ac \uc791\uc131\ub41c \uc815\ub2f5 \ub370\uc774\ud130(\ub808\uc774\ube14)\ub97c \uae30\ubc18\uc73c\ub85c \uc791\ub3d9\ud558\ub294\uc9c0 \uc5ec\ubd80\ub97c \uac80\ud1a0\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 \uad50\uacfc\uc11c\uc5d0 \uc18c\uac1c\ub41c \uc9c0\ub3c4\ud559\uc2b5\uc758 \uc2e4\uc0dd\ud65c \uc801\uc6a9 \uc0ac\ub840\uc5d0 \ud574\ub2f9\ud558\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uce74\uba54\ub77c \uc774\ubbf8\uc9c0\ub85c \uac10\uade4\uc758 \uc678\ubd80 \uacb0\ud568\uc744 \ud30c\uc545\ud558\uc5ec \uc815\uc0c1 \uc0c1\ud488\uacfc \ubd88\ub7c9 \uc0c1\ud488\uc744 \uc120\ubcc4\ud558\ub294 \uc2dc\uc2a4\ud15c",
          "rationale": "\uac10\uade4 \uc774\ubbf8\uc9c0\ub97c \ubd84\uc11d\ud574 '\uc815\uc0c1' \ubc0f '\ubd88\ub7c9'\uc774\ub77c\ub294 \uc815\ub2f5 \ub808\uc774\ube14 \ubc94\uc8fc\ub85c \uad6c\ubd84\ud558\ubbc0\ub85c \uc9c0\ub3c4\ud559\uc2b5\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud3b8\uc758\uc810 \ub9e4\ucd9c \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uc5ec \uc544\uce68 \uc2dc\uac04\uc5d0 \uc2a4\ub0b5\ub958\uc640 \uc74c\ub8cc\uc758 \ud568\uaed8 \uad6c\ub9e4 \ud328\ud134\uc744 \ubc1c\uacac\ud558\ub294 \uc2dc\uc2a4\ud15c",
          "rationale": "\uc815\ub2f5 \uc5c6\uc774 \uad6c\ub9e4 \ub370\uc774\ud130 \uac04\uc758 \uc228\uaca8\uc9c4 \uad00\ub828\uc131\uc744 \ucc3e\uc544\ub0b4\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5(\uc5f0\uad00 \uaddc\uce59) \uc0ac\ub840\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubc14\ub451, \uccb4\uc2a4 \ub4f1 \uc5ec\ub7ec \uac8c\uc784\uc758 \uaddc\uce59\uc744 \uc2dc\ud589\ucc29\uc624\ub97c \ud1b5\ud574 \uc2a4\uc2a4\ub85c \ud130\ub4dd\ud558\ub294 \uac8c\uc784 AI",
          "rationale": "\ubcf4\uc0c1\uc744 \ucd5c\ub300\ud654\ud558\ub294 \ubc29\uc2dd\uc744 \ub2e4\uc218 \uc2dc\ud589\ucc29\uc624\ub85c \uc775\ud788\ub294 \uac15\ud654 \ud559\uc2b5 \uc0ac\ub840\uc5d0 \uc18d\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2e0\uc6a9 \uce74\ub4dc \uc0ac\uc6a9 \ub0b4\uc5ed \uc911 \uc774\uc0c1 \uac70\ub798 \ud328\ud134\uc744 \uc2a4\uc2a4\ub85c \ud0d0\uc9c0\ud558\uac70\ub098 \uace0\uac1d\uc744 \uc138\ubd84\ud654\ud558\ub294 \uc2dc\uc2a4\ud15c",
          "rationale": "\uba85\ud655\ud55c \uc815\ub2f5 \uc5c6\uc774 \ube44\uc2b7\ud55c \ud2b9\uc131\uc744 \uc9c0\ub2cc \ud328\ud134\uc774\ub098 \uadf8\ub8f9\uc744 \ubd84\ub958\ud558\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5 \ud65c\uc6a9 \uc608\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc785\ub825 \ub370\uc774\ud130\uc640 \ube44\uad50\ud560 \uc218 \uc788\ub294 \uad6c\uccb4\uc801\uc778 \uc815\ub2f5(\uc815\uc0c1/\ubd88\ub7c9 \ub4f1)\uc774 \uc0ac\uc804\uc5d0 \ubd80\uc5ec\ub41c \uc0ac\ub840\ub97c \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "\uad50\uacfc\uc11c 182\ucabd\uc758 '\uc0ac\ub840 3(\ud3b8\uc758\uc810 \uc74c\ub8cc/\uc2a4\ub0b5 \uc5f0\uad00 \uad6c\ub9e4 \ubd84\uc11d)'\uc5d0 \uc801\uc6a9\ub41c \uae30\uacc4\ud559\uc2b5 \uc720\ud615\uacfc \uc774\uc720\ub85c \uac00\uc7a5 \uc54c\ub9de\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\ub3c4\ud559\uc2b5 - \uc74c\ub8cc \uad6c\ub9e4 \uc5ec\ubd80\ub77c\ub294 \uba85\ud655\ud55c \uc815\ub2f5 \ub808\uc774\ube14\uc774 \ub370\uc774\ud130\ub9c8\ub2e4 \ubbf8\ub9ac \ubd80\uc5ec\ub418\uc5b4 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc0ac\ub840 3\uc740 \ubbf8\ub9ac \uc9c0\uc815\ub41c \uc815\ub2f5\uc744 \ud559\uc2b5\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ud310\ub9e4 \ub370\uc774\ud130 \ub0b4 \uc5f0\uad00\uc131\uc744 \ubd84\uc11d\ud55c \uac83\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ube44\uc9c0\ub3c4\ud559\uc2b5 - \uc815\ub2f5 \uc815\ubcf4 \uc5c6\uc774 \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uc5ec \ud568\uaed8 \uad6c\ub9e4\ud558\ub294 \uc2a4\ub0b5\uacfc \uc74c\ub8cc\uc758 \uad00\ub828\uc131\uc744 \ucc3e\uc544\ub0c8\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ubcc4\ub3c4\uc758 \uc815\ub2f5 \uc815\ubcf4 \uc5c6\uc774 \ub370\uc774\ud130 \uc18d \uc228\uaca8\uc9c4 \ud328\ud134 \ubc0f \uc0c1\ud488 \uac04 \uc5f0\uad00 \uaddc\uce59\uc744 \ubc1c\uacac\ud588\uc73c\ubbc0\ub85c \ube44\uc9c0\ub3c4\ud559\uc2b5\uc774 \ub9de\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uac15\ud654 \ud559\uc2b5 - \uace0\uac1d\uc774 \uc2a4\ub0b5\uc744 \uad6c\ub9e4\ud560 \ub54c\ub9c8\ub2e4 \uc810\uc218(\ubcf4\uc0c1)\ub97c \ubd80\uc5ec\ud558\uc5ec \ub9e4\uc7a5 \uad6c\uc131\uc744 \ucd5c\uc801\ud654\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ud658\uacbd \uc18d\uc5d0\uc11c\uc758 \uc2dc\ud589\ucc29\uc624\ub098 \ubcf4\uc0c1 \uc810\uc218\ub97c \uad50\ud658\ud558\uc5ec \ucd5c\uc801 \ud589\ub3d9\uc744 \ubc30\uc6b0\ub294 \uac15\ud654 \ud559\uc2b5\uacfc\ub294 \uad00\ub828\uc774 \uc801\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc9c0\ub3c4\ud559\uc2b5 - \uc2dc\uac04\ub300\ubcc4 \ub9e4\ucd9c \uc218\uce58\ub97c \uc608\uce21\ud558\uae30 \uc704\ud574 \uc120\ud615 \ud68c\uadc0 \ud568\uc218\ub97c \uc774\uc6a9\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc218\uce58 \uc608\uce21 \ud568\uc218\ub97c \ub3c4\ucd9c\ud55c \uac83\uc774 \uc544\ub2c8\ub77c \uad6c\ub9e4 \ud56d\ubaa9 \uac04\uc758 \uad00\uacc4 \uaddc\uce59\uc744 \ub3c4\ucd9c\ud55c \ubd84\uc11d \uc0ac\ub840\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uad6c\ub9e4 \ub0b4\uc5ed \ub370\uc774\ud130\uc5d0\uc11c \uba85\ud655\ud55c \ub2f5\uc774 \uc5c6\ub294 \uc0c1\ud0dc\ub85c \uc0c1\ud488 \uac04 \uad00\ub828\uc131 \ubc0f \ub3d9\uc2dc \uad6c\ub9e4 \ud328\ud134\uc744 \ucc3e\uc740 \uc810\uc5d0 \uc8fc\ubaa9\ud558\uc138\uc694."
    },
    {
      "question": "\uc9c0\ub3c4\ud559\uc2b5\uc758 \uc138\ubd80 \ubaa8\ub378 \uc911 \ud558\ub098\uc778 '\ud68c\uadc0(Regression)' \ubaa8\ub378\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5f0\uc18d\uc801\uc778 \uc218\uce58\ud615 \ub370\uc774\ud130\ub97c \uc608\uce21\ud558\ub294 \uc9c0\ub3c4\ud559\uc2b5 \ubaa8\ub378\uc774\ub2e4.",
          "rationale": "\ud68c\uadc0 \ubaa8\ub378\uc740 \uc628\ub3c4, \uac00\uaca9, \uc131\uc801 \ub4f1 \uc5f0\uc18d\ub41c \uc22b\uc790\ub97c \uc608\uce21\ud558\ub294 \ub370 \ud65c\uc6a9\ub418\ub294 \uc9c0\ub3c4\ud559\uc2b5 \uae30\ubc95\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc785\ub825\uac12\uacfc \uacb0\uad0f\uac12\uc758 \uad00\uacc4\ub97c \uac00\uc7a5 \uc798 \ub098\ud0c0\ub0b4\ub294 \ud568\uc218\ub97c \ub9cc\ub4e4\uc5b4 \uc608\uce21\uc5d0 \ud65c\uc6a9\ud55c\ub2e4.",
          "rationale": "\uc785\ub825 \ub370\uc774\ud130\uc640 \uacb0\uad0f\uac12 \uac04\uc758 \uc218\ud559\uc801 \ud568\uc218 \uad00\uacc4\ub97c \uc815\ub9bd\ud558\uc5ec \ubbf8\ub798 \uc785\ub825\uac12\uc5d0 \ub300\ud55c \uacb0\uacfc\ub97c \uc608\uce21\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc120\ud615 \ud615\ud0dc\uc758 \ud568\uc218 \ubaa8\ub378\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0\ub97c '\uc120\ud615 \ud68c\uadc0'\ub77c\uace0 \ubd80\ub978\ub2e4.",
          "rationale": "\uc785\ucd9c\ub825 \uac04\uc758 \uad00\uacc4\ub97c \uc9c1\uc120(\uc120\ud615) \ubaa8\uc591\uc758 \ud568\uc218\ub85c \ud45c\ud604\ud558\ub294 \ubaa8\ub378\uc744 \uc120\ud615 \ud68c\uadc0\ub77c\uace0 \ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc785\ub825\ub41c \ub370\uc774\ud130\ub97c \uba87 \uac1c\uc758 \uc815\ud574\uc9c4 \ubc94\uc8fc(\uce74\ud14c\uace0\ub9ac)\ub85c \uad6c\ubd84\ud558\uae30 \uc704\ud574 \uc8fc\ub85c \uc0ac\uc6a9\ub41c\ub2e4.",
          "rationale": "\ub370\uc774\ud130\ub97c \uba87 \uac00\uc9c0 \ubc94\uc8fc\ub85c \uad6c\ubd84\ud558\ub294 \ubaa8\ub378\uc740 \ud68c\uadc0\uac00 \uc544\ub2c8\ub77c \uc9c0\ub3c4\ud559\uc2b5\uc758 '\ubd84\ub958(Classification)' \ubaa8\ub378\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\uc5f0\uc18d\uc801\uc778 \uc218\uce58 \uc608\uce21\uacfc \ubc94\uc8fc(\uce74\ud14c\uace0\ub9ac) \uad6c\ubd84\uc758 \ucc28\uc774\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc81c\uc2dc\ub41c \uc608\uc2dc \uc911 \ud68c\uadc0(Regression) \ubaa8\ub378\uc744 \uc801\uc6a9\ud558\uae30\uc5d0 \uac00\uc7a5 \uc801\uc808\ud55c \uac83\ub9cc\uc744 \ubaa8\ub450 \uace0\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubbf8\ub798\uc758 \uac15\uc6b0\ub7c9 \uc608\uce21, \uc6b4\ud589 \uac70\ub9ac\uc5d0 \ub530\ub978 \uc911\uace0\ucc28 \ud310\ub9e4 \uac00\uaca9 \uc608\uce21, \uc2dc\uac04\ubcc4 \uc9c0\ud558\ucca0 \uc774\uc6a9 \uc2b9\uac1d \uc608\uce21",
          "rationale": "\uac15\uc6b0\ub7c9, \ud310\ub9e4 \uac00\uaca9, \uc2b9\uac1d \uc218\ub294 \ubaa8\ub450 \uc5f0\uc18d\uc801\uc778 \uc218\uce58 \ub370\uc774\ud130\uc774\ubbc0\ub85c \ud68c\uadc0 \ubaa8\ub378\uc744 \uc801\uc6a9\ud558\uae30\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc2a4\ud338 \uba54\uc77c \ubd84\ub958, \uc9c8\ubcd1 \uc720\ubb34 \ud310\ub2e8, \uc2a4\ud338 \uba54\uc77c \uc5ec\ubd80 \ud655\uc778",
          "rationale": "\uc2a4\ud338/\uc815\uc0c1, \uc9c8\ubcd1 \uc591\uc131/\uc74c\uc131 \ub4f1 \uba87 \uac1c\uc758 \uce74\ud14c\uace0\ub9ac\ub85c \ub098\ub204\ub294 \uac83\uc740 \ud68c\uadc0\uac00 \uc544\ub2cc \ubd84\ub958 \ubaa8\ub378\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2e0\uc6a9 \uce74\ub4dc \uc774\uc0c1 \uc0ac\uc6a9 \ud0d0\uc9c0, \uace0\uac1d \uc138\ubd84\ud654 \ub9c8\ucf00\ud305, \ub3c4\uc11c \ucd94\ucc9c \uc2dc\uc2a4\ud15c",
          "rationale": "\uc81c\uc2dc\ub41c \uc608\uc2dc\ub4e4\uc740 \ub808\uc774\ube14 \uc5c6\uc774 \ud2b9\uc131\uc744 \ud30c\uc545\ud558\uc5ec \uadf8\ub8f9\ud654\ud558\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5 \ud65c\uc6a9 \uc608\uc2dc\ub4e4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "2\uc871 \ubcf4\ud589 \ub85c\ubd07\uc758 \uc790\uc728 \uc81c\uc5b4, \uc54c\ud30c\uace0\uc758 \ubc14\ub451 \uacbd\uae30 \uc9c4\ud589, \uac8c\uc784 AI \uce90\ub9ad\ud130\uc758 \ub3d9\uc791 \uc81c\uc5b4",
          "rationale": "\uc2dc\ud589\ucc29\uc624\uc640 \ubcf4\uc0c1 \uc2dc\uc2a4\ud15c\uc744 \uae30\ubc18\uc73c\ub85c \ucd5c\uc801\ud654\ud558\ub294 \uac15\ud654 \ud559\uc2b5 \ud65c\uc6a9 \uc0ac\ub840\ub4e4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc608\uce21 \ub300\uc0c1\uc774 \ubc94\uc8fc\ub098 \uadf8\ub8f9\uc774 \uc544\ub2cc '\uc5f0\uc18d\uc801\uc778 \uc218\uce58(\uc591, \uae08\uc561, \uc778\uc6d0\uc218 \ub4f1)'\uc5d0 \ud574\ub2f9\ud558\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uad50\uacfc\uc11c\uc5d0 \uc81c\uc2dc\ub41c \uae30\uacc4\ud559\uc2b5 \ubaa8\ub378 \ubd84\ub958 \uc911, \ube44\uc9c0\ub3c4\ud559\uc2b5\uc5d0 \uc18d\ud558\ub294 \ub450 \uac00\uc9c0 \ub300\ud45c\uc801\uc778 \uae30\ubc95\uc73c\ub85c \ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud68c\uadc0, \ubd84\ub958",
          "rationale": "\ud68c\uadc0\uc640 \ubd84\ub958\ub294 \uc815\ub2f5\uc774 \uc788\ub294 \ub370\uc774\ud130\ub97c \ud65c\uc6a9\ud558\ub294 \uc9c0\ub3c4\ud559\uc2b5\uc758 \uc8fc\uc694 \ubaa8\ub378\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad70\uc9d1\ud654, \uc5f0\uad00 \uaddc\uce59",
          "rationale": "\ube44\uc9c0\ub3c4\ud559\uc2b5\uc740 \ube44\uc2b7\ud55c \ud2b9\uc9d5\ub07c\ub9ac \ubaa8\uc73c\ub294 '\uad70\uc9d1\ud654'\uc640 \ub370\uc774\ud130 \uac04 \uc0c1\uad00\uad00\uacc4\ub97c \ucc3e\ub294 '\uc5f0\uad00 \uaddc\uce59' \ub4f1\uc73c\ub85c \uad6c\ubd84\ub429\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubd84\ub958, \uad70\uc9d1\ud654",
          "rationale": "\ubd84\ub958\ub294 \uc9c0\ub3c4\ud559\uc2b5, \uad70\uc9d1\ud654\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5 \ubaa8\ub378\ub85c \uc11c\ub85c \ub2e4\ub978 \ud559\uc2b5 \uc720\ud615\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud68c\uadc0, \uc5f0\uad00 \uaddc\uce59",
