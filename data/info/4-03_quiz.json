{
  "title": "\uae30\uacc4\ud559\uc2b5 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uae30\uacc4\ud559\uc2b5 \ubaa8\ub378 \uc911 '\ub85c\uc9c0\uc2a4\ud2f1 \ud68c\uadc0(Logistic Regression)'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc774\ub984\uc5d0 '\ud68c\uadc0'\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc9c0\ub9cc, \uc2e4\uc81c\ub85c\ub294 \ub370\uc774\ud130\uac00 \ud2b9\uc815 \ud074\ub798\uc2a4\uc5d0 \uc18d\ud560 \ud655\ub960\uc744 \uc608\uce21\ud558\uc5ec \ubd84\ub958\ud558\ub294 \uc120\ud615 \ubd84\ub958 \ubaa8\ub378\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub85c\uc9c0\uc2a4\ud2f1 \ud68c\uadc0\ub294 \ub85c\uc9c0\uc2a4\ud2f1 \ud568\uc218\ub97c \uc0ac\uc6a9\ud574 \ub370\uc774\ud130\uac00 \ud2b9\uc815 \ud074\ub798\uc2a4\uc5d0 \uc18d\ud560 \ud655\ub960(0~1)\uc744 \uc608\uce21\ud558\uace0 \uc8fc\ub85c 0.5\ub97c \uae30\uc900\uc73c\ub85c \ubd84\ub958\ub97c \uc218\ud589\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc120\ud615 \ubd84\ub958 \ubaa8\ub378\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ub2f5(\ub808\uc774\ube14)\uc774 \uc5c6\ub294 \ub370\uc774\ud130\uc758 \ud2b9\uc9d5\uc744 \ubd84\uc11d\ud558\uc5ec \uc11c\ub85c \uc720\uc0ac\ud55c \ub370\uc774\ud130\ub07c\ub9ac \uadf8\ub8f9\ud654\ud558\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5 \uc54c\uace0\ub9ac\uc998\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ub2f5\uc774 \uc5c6\ub294 \ub370\uc774\ud130\ub97c \uc720\uc0ac\uc131\uc5d0 \ub530\ub77c \uadf8\ub8f9\ud654\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc740 \ube44\uc9c0\ub3c4\ud559\uc2b5\uc758 '\uad70\uc9d1\ud654(Clustering)'\uc5d0 \ub300\ud55c \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud2b8\ub9ac \uad6c\uc870\ub97c \uae30\ubc18\uc73c\ub85c \ud558\uba70, \ubd84\ub958 \uae30\uc900\uc774 \ub9ce\uc544\uc9c0\uace0 \ud2b8\ub9ac\uac00 \uae4a\uc5b4\uc9c8\uc218\ub85d \ud56d\uc0c1 \uc608\uce21 \uc131\ub2a5\uc774 \ud5a5\uc0c1\ub418\ub294 \ubaa8\ub378\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud2b8\ub9ac\uac00 \uae4a\uc5b4\uc9c0\uace0 \ubd84\ub958 \uae30\uc900\uc774 \ub108\ubb34 \ub9ce\uc544\uc9c0\uba74 \uc624\ud788\ub824 \uc608\uce21 \uc131\ub2a5\uc774 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\ub294 \uc54c\uace0\ub9ac\uc998\uc740 '\uacb0\uc815\ud2b8\ub9ac'\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0c8\ub85c\uc6b4 \ub370\uc774\ud130\uac00 \ub4e4\uc5b4\uc654\uc744 \ub54c \uac00\uc7a5 \uac00\uae4c\uc6b4 k\uac1c\uc758 \uc774\uc6c3 \ub370\uc774\ud130 \ub2e4\uc218\uacb0\ub85c \ud074\ub798\uc2a4\ub97c \uc815\ud558\ub294 \uac70\ub9ac \uae30\ubc18 \ubd84\ub958 \ubaa8\ub378\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac00\uc7a5 \uac00\uae4c\uc6b4 k\uac1c\uc758 \uc774\uc6c3 \ub370\uc774\ud130\ub97c \ud655\uc778\ud558\uc5ec \ub2e4\uc218\uacb0\ub85c \ubd84\ub958\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc740 'k-\ucd5c\uadfc\uc811 \uc774\uc6c3(kNN)'\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc774 \ubaa8\ub378\uc740 \uc774\ub984\uc5d0 '\ud68c\uadc0'\ub77c\ub294 \ub2e8\uc5b4\uac00 \ub4e4\uc5b4\uc788\uc9c0\ub9cc, \uc2e4\uc81c \uc0ac\uc6a9 \ubaa9\uc801\uc740 \uc5f0\uc18d \uc218\uce58 \uc608\uce21\uc774 \uc544\ub2d9\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "k-\ucd5c\uadfc\uc811 \uc774\uc6c3(kNN) \uc54c\uace0\ub9ac\uc998 \ubc0f \uac70\ub9ac \uae30\ubc18 \ud559\uc2b5 \ubaa8\ub378\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "kNN \uc54c\uace0\ub9ac\uc998\uc740 \uc608\uce21\ud558\ub824\ub294 \ub370\uc774\ud130\uc640 \uae30\uc874 \ub370\uc774\ud130 \uc0ac\uc774\uc758 \uac70\ub9ac\ub97c \uacc4\uc0b0\ud558\uc5ec \uac00\uae4c\uc6b4 \uc774\uc6c3\uc744 \ud0d0\uc0c9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "kNN\uc740 \uae30\uc874 \ub370\uc774\ud130\uc640 \uc608\uce21 \ub300\uc0c1 \ub370\uc774\ud130 \uac04\uc758 \uac70\ub9ac(\uc720\ud074\ub9ac\ub514\uc548 \uac70\ub9ac \ub4f1)\ub97c \uac01\uac01 \uacc4\uc0b0\ud558\uc5ec \uac00\uae4c\uc6b4 k\uac1c\uc758 \uc774\uc6c3\uc744 \uc815\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ub3d9\uc77c\ud55c \uc0c8\ub85c\uc6b4 \ub370\uc774\ud130\uac00 \uc785\ub825\ub418\ub354\ub77c\ub3c4 \uc124\uc815\ud55c k\uc758 \uac12(\uc608: k=1, k=5)\uc5d0 \ub530\ub77c \uc608\uce21\ub418\ub294 \ud074\ub798\uc2a4 \uacb0\uacfc\uac00 \ub2ec\ub77c\uc9c8 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "k=1\uc77c \ub54c\ub294 \uac00\uc7a5 \uac00\uae4c\uc6b4 1\uac1c\uc758 \uc774\uc6c3 \ud074\ub798\uc2a4\ub85c \uc9c0\uc815\ub418\uace0, k=5\uc77c \ub54c\ub294 \uac00\uae4c\uc6b4 5\uac1c \uc774\uc6c3 \uc911 \ub2e4\uc218\ud30c \ud074\ub798\uc2a4\ub85c \uc9c0\uc815\ub418\ubbc0\ub85c \uacb0\uacfc\uac00 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uac70\ub9ac \uae30\ubc18 \uc54c\uace0\ub9ac\uc998\uc778 kNN\uacfc \ub85c\uc9c0\uc2a4\ud2f1 \ud68c\uadc0\ub294 \ubaa8\ub378 \uc0dd\uc131 \uc804\uc5d0 \ub370\uc774\ud130 \uc815\uaddc\ud654(Normalization) \uc804\ucc98\ub9ac\ub97c \uc218\ud589\ud558\ub294 \uac83\uc774 \uc88b\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud2b9\uc9d5\uac12\ub4e4\uc758 \ub2e8\uc704\ub098 \ud3b8\ucc28\uac00 \ud06c\uba74 \uac70\ub9ac\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc774 \uc65c\uace1\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uac70\ub9ac \uae30\ubc18 \uc54c\uace0\ub9ac\uc998 \uc801\uc6a9 \uc804 \uc815\uaddc\ud654 \uacfc\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
        },
        {
          "text": "kNN\uc740 \ube44\uc9c0\ub3c4\ud559\uc2b5 \ubaa8\ub378\uc774\ubbc0\ub85c \uc815\ub2f5 \ub808\uc774\ube14 \uc5c6\uc774 \ub370\uc774\ud130 \uac04\uc758 \uac70\ub9ac \uacc4\uc0b0\ub9cc\uc73c\ub85c \uc2a4\uc2a4\ub85c \ud074\ub798\uc2a4 \uacbd\uacc4\ub97c \uc0dd\uc131\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "kNN\uc740 \uc785\ub825 \ub370\uc774\ud130\uc640 \ud574\ub2f9 \ub370\uc774\ud130\uc758 \uc815\ub2f5(\ub808\uc774\ube14)\uc744 \ud568\uaed8 \ud559\uc2b5\uc2dc\ucf1c \uc0c8\ub85c\uc6b4 \ub370\uc774\ud130\ub97c \ubd84\ub958\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc9c0\ub3c4\ud559\uc2b5 \ubaa8\ub378\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "kNN\uc774 \uc9c0\ub3c4\ud559\uc2b5\uc778\uc9c0 \ube44\uc9c0\ub3c4\ud559\uc2b5\uc778\uc9c0 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uacb0\uc815\ud2b8\ub9ac(Decision Tree) \ubaa8\ub378\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "2\ucc28\uc6d0 \ud2b9\uc131 \uacf5\uac04\uc5d0\uc11c \uacb0\uc815\ud2b8\ub9ac\ub85c \ub370\uc774\ud130\ub97c \ubd84\ub958\ud560 \ub54c x\ucd95\uacfc y\ucd95\uc5d0 \uc218\ud3c9\ud55c \uc9c1\uc120\uc744 \uadf8\uc5b4\uac00\uba70 \ud074\ub798\uc2a4 \uacbd\uacc4\ub97c \ud615\uc131\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uacb0\uc815\ud2b8\ub9ac\ub294 \ud2b9\uc9d5\uac12\uc758 \ud06c\uace0 \uc791\uc74c\uc744 \ube44\uad50\ud558\uba70 \ud55c \uac00\uc9c0 \ud074\ub798\uc2a4\ub9cc \ub0a8\ub3c4\ub85d x\ucd95\uacfc y\ucd95\uc5d0 \uc218\ud3c9\ud55c \uc9c1\uc120\uc744 \uadf8\uc5b4\uac00\uba70 \ubd84\uae30 \uae30\uc900\uc744 \ub9cc\ub4ed\ub2c8\ub2e4."
        },
        {
          "text": "\ubd84\ub958 \ubb38\uc81c\uc5d0\ub9cc \uc804\uc6a9\uc73c\ub85c \uc0ac\uc6a9\ub418\uba70, \uc5f0\uc18d\uc801\uc778 \uc218\uce58\uac12\uc744 \uc608\uce21\ud558\ub294 \ud68c\uadc0 \ubb38\uc81c\uc5d0\ub294 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacb0\uc815\ud2b8\ub9ac\ub294 \ubc94\uc8fc\ub97c \ub098\ub204\ub294 \ubd84\ub958 \ubb38\uc81c\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc218\uce58\uac12\uc744 \uc608\uce21\ud558\ub294 \ud68c\uadc0 \ubb38\uc81c\uc5d0\ub3c4 \ubaa8\ub450 \uc801\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubd84\ub958 \uae30\uc900\uc774 \ub9ce\uc544\uc838 \ud2b8\ub9ac\uc758 \uae4a\uc774\uac00 \uae4a\uc5b4\uc9c8\uc218\ub85d \ud14c\uc2a4\ud2b8 \ub370\uc774\ud130\uc5d0 \ub300\ud55c \uc608\uce21 \uc131\ub2a5\uc774 \ud56d\uc0c1 \ub192\uc544\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd84\ub958 \uae30\uc900\uc774 \uc9c0\ub098\uce58\uac8c \ub9ce\uc544\uc838 \ud2b8\ub9ac\uac00 \ub108\ubb34 \uae4a\uc5b4\uc9c0\uba74 \uc624\ud788\ub824 \uc608\uce21 \uc131\ub2a5\uc774 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ub78c\uc758 \ub450\ub1cc \ub274\ub7f0 \uc5f0\uacb0 \ubc29\uc2dd\uc744 \ubaa8\ubc29\ud558\uc5ec complex\ud55c \ube44\uc120\ud615 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub294 \ubaa8\ub378\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ub78c\uc758 \ub1cc \uc2e0\uacbd\uacc4\uac00 \uc815\ubcf4\ub97c \ucc98\ub9ac\ud558\ub294 \ubc29\uc2dd\uc744 \ubaa8\ubc29\ud558\uc5ec \ub178\ub4dc \uac04 \uc2e0\ud638\ub97c \uc8fc\uace0\ubc1b\ub3c4\ub85d \ud55c \ubaa8\ub378\uc740 '\uc778\uacf5 \uc2e0\uacbd\ub9dd'\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uacb0\uc815\ud2b8\ub9ac\uac00 \ucc28\uc6d0\uc5d0\uc11c \uacbd\uacc4\ub97c \ud615\uc131\ud560 \ub54c \ucd95\uacfc \uc5b4\ub5a4 \uad00\uacc4\ub97c \uac00\uc9c0\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uae30\uacc4\ud559\uc2b5 \ud68c\uadc0 \ubaa8\ub378\uc758 \uc131\ub2a5\uc744 \ud3c9\uac00\ud558\ub294 \uc9c0\ud45c\ub4e4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "MSE(\ud3c9\uade0 \uc81c\uacf1 \uc624\ucc28)\ub294 \uc2e4\uc82f\uac12\uacfc \uc608\uce21\uac12\uc758 \ucc28\uc774\ub97c \uc81c\uacf1\ud558\uc5ec \ud3c9\uade0\ud55c \uac12\uc73c\ub85c, \uc791\uc744\uc218\ub85d \ubaa8\ub378\uc774 \uc6b0\uc218\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "MSE\ub294 \uc608\uce21 \uc624\ucc28\uc758 \uc81c\uacf1 \ud3c9\uade0\uc774\ubbc0\ub85c \uc624\ucc28 \uac12\uc774 0\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d(\uc791\uc744\uc218\ub85d) \uc815\ud655\ud55c \uc608\uce21\uc744 \uc218\ud589\ud55c \uc6b0\uc218\ud55c \ubaa8\ub378\uc785\ub2c8\ub2e4."
        },
        {
          "text": "MAE(\ud3c9\uade0 \uc808\ub300 \uc624\ucc28)\ub294 \uc2e4\uc82f\uac12\uacfc \uc608\uce21\uac12 \ucc28\uc774\uc5d0 \uc808\ub300\uac12\uc744 \ucde8\ud574 \ud3c9\uade0\ud55c \uac83\uc73c\ub85c, \uc791\uc744\uc218\ub85d \uc131\ub2a5\uc774 \uc88b\ub2e4.",
          "isCorrect": false,
          "rationale": "MAE \uc5ed\uc2dc \uc608\uce21 \uc624\ucc28\uc758 \uc808\ub300\uac12 \ud3c9\uade0\uc744 \ub098\ud0c0\ub0b4\ub294 \uc9c0\ud45c\uc774\ubbc0\ub85c \uac12\uc774 \uc791\uc744\uc218\ub85d \uc608\uce21 \uc624\ucc28\uac00 \uc801\uc74c\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "$R^2$(\uacb0\uc815\uacc4\uc218)\ub294 \ubaa8\ub378\uc774 \ub370\uc774\ud130\ub97c \uc801\ud569\ud558\ub294 \uc815\ub3c4\ub97c \ub098\ud0c0\ub0b4\uba70, 1\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \uc131\ub2a5\uc774 \uc6b0\uc218\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacb0\uc815\uacc4\uc218 $R^2$\ub294 \ubaa8\ub378\uc758 \uc124\uba85\ub825\uc744 \ub098\ud0c0\ub0b4\ub294 \uc9c0\ud45c\ub85c 1\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \uc218\uce58 \uc608\uce21\uc774 \uc798 \ub4e4\uc5b4\ub9de\ub294 \uc6b0\uc218\ud55c \ubaa8\ub378\uc785\ub2c8\ub2e4."
        },
        {
          "text": "RMSE(\uadfc\ud3c9\uade0 \uc81c\uacf1 \uc624\ucc28)\ub294 \uc624\ucc28 \uc9c0\ud45c \uc911 \ud558\ub098\ub85c, \uac12\uc774 1\uc5d0 \uac00\uae4c\uc6cc\uc9c8\uc218\ub85d \ubaa8\ub378\uc758 \uc624\ucc28\uac00 \uc904\uc5b4\ub4e4\uc5b4 \uc644\ubcbd\ud55c \uc131\ub2a5\uc744 \ub73b\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "RMSE\ub294 \uc624\ucc28(Error) \uc9c0\ud45c\uc774\ubbc0\ub85c 1\uc774 \uc544\ub2cc 0\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \uc624\ucc28\uac00 \uc801\uace0 \uc6b0\uc218\ud55c \ubaa8\ub378\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc624\ucc28(Error) \uc9c0\ud45c\ub4e4\uc774 \uc774\uc0c1\uc801\uc73c\ub85c \uac00\ub9ac\ucf1c\uc57c \ud558\ub294 \uc22b\uc790\uac00 0\uc778\uc9c0 1\uc778\uc9c0 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \uae30\uacc4\ud559\uc2b5\uc758 '\ubd84\ub958(Classification)'\uc640 '\uad70\uc9d1\ud654(Clustering)'\ub97c \ube44\uad50\ud55c \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubd84\ub958\ub294 \ubbf8\ub9ac \uc815\ud574\uc9c4 \ubc94\uc8fc(\ud074\ub798\uc2a4)\ub85c \ub370\uc774\ud130\ub97c \ub098\ub204\ub294 \uac83\uc774\uace0, \uad70\uc9d1\ud654\ub294 \uc815\ub2f5\uc774 \uc5c6\ub294 \ub370\uc774\ud130\uc758 \uc720\uc0ac\uc131\uc744 \ubd84\uc11d\ud558\uc5ec \uadf8\ub8f9\ud654\ud558\ub294 \uac83\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubd84\ub958\ub294 \uc9c0\ub3c4\ud559\uc2b5\uc73c\ub85c\uc11c \ubbf8\ub9ac \uc815\uc758\ub41c \ud074\ub798\uc2a4\ub85c \ub098\ub204\ub294 \uac83\uc774 \ubaa9\uc801\uc774\uba70, \uad70\uc9d1\ud654\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5\uc73c\ub85c\uc11c \uc815\ub2f5 \uc5c6\uc774 \uc720\uc0ac\ud55c \ud2b9\uc131\ub07c\ub9ac \uadf8\ub8f9\ud654\ud558\ub294 \uac83\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubd84\ub958\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5\uc5d0 \ud574\ub2f9\ud558\uba70, \uad70\uc9d1\ud654\ub294 \uc9c0\ub3c4\ud559\uc2b5\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd84\ub958\ub294 \uc815\ub2f5(\ub808\uc774\ube14)\uc774 \uc81c\uacf5\ub418\ub294 \uc9c0\ub3c4\ud559\uc2b5\uc774\uace0, \uad70\uc9d1\ud654\ub294 \uc815\ub2f5\uc774 \uc5c6\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uad70\uc9d1\ud654 \uacb0\uacfc \ud615\uc131\ub41c \ub370\uc774\ud130 \uadf8\ub8f9\uc740 \uc131\ub2a5 \ud3c9\uac00\ub97c \ud1b5\ud574 \ub3c4\ucd9c\ub41c \uad70\uc9d1\uc774 \uba85\ud655\ud558\uac8c '\ub9de\ub2e4' \ub610\ub294 '\ud2c0\ub838\ub2e4'\ub85c \ud310\uc815\ub41c\ub2e4.",
