    {
      "question": "\uc54c\uace0\ub9ac\uc998\uc758 \ud6a8\uc728\uc131\uc5d0 \uad00\ud55c \uc124\uba85 \uc911 \uad50\uacfc\uc11c \ub0b4\uc6a9\uacfc \uac00\uc7a5 \ubd80\ud569\ud558\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "1\ubd80\ud130 100\uae4c\uc9c0 \uc21c\ucc28\uc801\uc73c\ub85c \ub354\ud558\ub294 \ubc29\ubc95(\ubc29\ubc95 1)\uc740 \ub354\ud558\ub294 \uc22b\uc790\uac00 \ub298\uc5b4\ub098\ub3c4 \uc218\ud589 \uc2dc\uac04\uc774 \uc77c\uc815\ud558\ub2e4.",
