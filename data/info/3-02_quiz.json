        },
        {
          "text": "\uc591 \ub05d\uc758 \uc218\ub97c \ub354\ud558\uc5ec \uac1c\uc218\ub97c \uacf1\ud55c \ub4a4 \ub098\ub204\ub294 \ubc29\ubc95(\ubc29\ubc95 2)\uc740 \uc5f0\uc0b0 \ud69f\uc218\uac00 \uc77c\uc815\ud558\uc5ec \ud6a8\uc728\uc801\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub367\uc148, \uacf1\uc148, \ub098\ub217\uc148\uc744 \ud55c \ubc88\uc529\ub9cc \uc218\ud589\ud558\ubbc0\ub85c \ub370\uc774\ud130\uc758 \uc591\uc774 \ub298\uc5b4\ub098\ub3c4 \uc77c\uc815\ud55c \uc218\ud589 \uc2dc\uac04\uc744 \uac00\uc9c4\ub2e4."
        },
        {
          "text": "\uae30\uc5b5 \uc7a5\uc18c \uc0ac\uc6a9\ub7c9\uc774 \uc801\uc740 \uc54c\uace0\ub9ac\uc998\uc774\ub77c\uba74 \uc218\ud589 \uc2dc\uac04\uc774 \uc544\ubb34\ub9ac \uae38\uc5b4\ub3c4 \ud56d\uc0c1 \ucd5c\uace0\ub85c \ud6a8\uc728\uc801\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud6a8\uc728\uc801\uc778 \uc54c\uace0\ub9ac\uc998\uc740 \uae30\uc5b5 \uc7a5\uc18c \uc0ac\uc6a9\ub7c9\uc774 \uc801\uc744 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc218\ud589 \uc2dc\uac04\ub3c4 \uc9e7\uc544\uc57c \ud55c\ub2e4."
        },
        {
          "text": "\ub3d9\uc77c\ud55c \uc785\ub825\uacfc \ucd9c\ub825\uc744 \uac16\ub294 \uc54c\uace0\ub9ac\uc998\ub4e4\uc740 \uc124\uacc4 \ubc29\uc2dd\uc5d0 \uc0c1\uad00\uc5c6\uc774 \ud56d\uc0c1 \ub3d9\uc77c\ud55c \uc218\ud589 \uc2dc\uac04\uc744 \uac16\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac19\uc740 \ubaa9\uc801\uc758 \uc54c\uace0\ub9ac\uc998\uc774\ub77c\ub3c4 \uc0ac\uc6a9\ud55c \ucc98\ub9ac \ubc29\ubc95\uc5d0 \ub530\ub77c \uc218\ud589 \uc2dc\uac04\uacfc \ud6a8\uc728\uc131\uc5d0 \ucc28\uc774\uac00 \ubc1c\uc0dd\ud55c\ub2e4."
