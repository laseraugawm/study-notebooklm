        }
      ],
      "hint": "\ub370\uc774\ud130\uac00 \uc774\ub3d9\ud560 \uc62c\ubc14\ub978 \uae38(\uacbd\ub85c)\uc744 \ucc3e\uc544 \uc548\ub0b4\ud574 \uc8fc\ub294 \uc7a5\ube44\uc758 \uc774\ub984\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc678\ubd80\ub85c\ubd80\ud130\uc758 \ubd88\ubc95 \uc811\uadfc\uc774\ub098 \uc545\uc758\uc801\uc778 \uacf5\uaca9\uc744 \ucc28\ub2e8\ud558\uc5ec \ub124\ud2b8\uc6cc\ud06c \ubcf4\uc548\uc744 \uc720\uc9c0\ud558\ub294 \uc7a5\uce58 \ub610\ub294 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
