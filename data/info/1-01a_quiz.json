        {
          "text": "\uc774\ub3d9 \ud1b5\uc2e0 \ub124\ud2b8\uc6cc\ud06c\ubcf4\ub2e4 \ub113\uc740 \ubc94\uc704\uc758 \ub79c\uc744 \ubb34\uc120\ud654\ud558\uc5ec \ub192\uc740 \uc18d\ub3c4\ub97c \uc81c\uacf5\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc77c\uc815 \uacf5\uac04 \ubc94\uc704 \ub0b4\uc5d0\uc11c \ub79c\uc744 \ubb34\uc120\ud654\ud558\uc5ec \uc774\uc6a9\ud558\ub294 \uac83\uc740 \uc640\uc774\ud30c\uc774\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4."
