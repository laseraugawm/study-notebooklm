    {
      "question": "\ube14\ub8e8\ud22c\uc2a4(Bluetooth) \uae30\uc220\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc62c\ubc14\ub974\uc9c0 \uc54a\uc740 \uac83\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
