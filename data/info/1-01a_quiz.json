        },
        {
          "text": "\ubb34\uc120 \uc774\uc5b4\ud3f0\uc774\ub098 \uc778\uacf5\uc9c0\ub2a5 \uc2a4\ud53c\ucee4 \uc5f0\uacb0 \ub4f1\uc5d0 \ub110\ub9ac \uc4f0\uc778\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc8fc\ubcc0 \ucef4\ud4e8\ud305 \uae30\uae30 \ubc0f \uc18c\ud615 \uc74c\ud5a5 \uae30\uae30\ub97c \uc5f0\uacb0\ud558\ub294 \ube14\ub8e8\ud22c\uc2a4\uc758 \uc804\ud615\uc801\uc778 \uc801\uc6a9 \uc0ac\ub840\uc774\ub2e4."
