    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2\ucc28\uc6d0 \ub9ac\uc2a4\ud2b8 `a`\uc5d0\uc11c $2$\ud589 $3$\uc5f4(0\ubd80\ud130 \uc2dc\uc791\ud558\ub294 \uc778\ub371\uc2a4 \uae30\uc900)\uc5d0 \uc704\uce58\ud55c \uc694\uc18c\uc5d0 \uc811\uadfc\ud558\ub294 \ud45c\uae30\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
