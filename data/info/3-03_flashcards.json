    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9ac\uc2a4\ud2b8 \ud615\ud0dc\uc758 \uc774\ubbf8\uc9c0 \ub370\uc774\ud130(2\ucc28\uc6d0 \ub610\ub294 3\ucc28\uc6d0)\ub97c \ud654\uba74\uc5d0 \uc2dc\uac01\uc801\uc73c\ub85c \ud45c\uc2dc\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \ud30c\uc774\uc36c \ub77c\uc774\ube0c\ub7ec\ub9ac\uc640 \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
