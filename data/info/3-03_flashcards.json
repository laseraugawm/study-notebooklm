{
  "title": "\ud30c\uc774\uc36c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uae00 \ucf54\ub7a9(Google Colab)\uc758 \uc8fc\uc694 \ud2b9\uc9d5\uacfc \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc628\ub77c\uc778\uc0c1\uc5d0\uc11c \ubcc4\ub3c4\uc758 \ud658\uacbd \uc124\uc815 \uc5c6\uc774 \ud30c\uc774\uc36c \ucf54\ub4dc\ub97c \uc791\uc131\ud558\uace0 \uacb0\uacfc\ub97c \ubc14\ub85c \ud655\uc778\ud560 \uc218 \uc788\ub294 \ud1b5\ud569 \uac1c\ubc1c \ud658\uacbd(IDE)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uae00 \ucf54\ub7a9\uc758 \uc791\uc5c5 \ucc3d\uc744 \uad6c\uc131\ud558\ub294 \ub450 \uac00\uc9c0 \uc140\uc758 \uc885\ub958\uc640 \uac01\uac01\uc758 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucf54\ub4dc\ub97c \uc791\uc131\ud558\uace0 \uc2e4\ud589\ud558\ub294 '\ucf54\ub4dc \uc140'\uacfc \uae00 \ubc0f \uc774\ubbf8\uc9c0\ub97c \uc791\uc131\ud558\ub294 '\ud14d\uc2a4\ud2b8 \uc140'\ub85c \uad6c\uc131\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub85c\uadf8\ub798\ubc0d\uc5d0\uc11c \ubcc0\uc218(variable)\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud504\ub85c\uadf8\ub7a8\uc774 \uc2e4\ud589\ub418\ub294 \ub3d9\uc548 \uc911\uc694\ud55c \ub370\uc774\ud130\ub97c \uc78a\uc9c0 \uc54a\uace0 \uc800\uc7a5\ud574 \ub450\ub294 \uae30\uc5b5 \uacf5\uac04\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \ubcc0\uc218\uc5d0 \uac12\uc744 \uc800\uc7a5\ud558\uac70\ub098 \uae30\uc874\uc5d0 \uc800\uc7a5\ub41c \uac12\uc744 \ubcc0\uacbd\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \uc5f0\uc0b0 \uae30\ud638\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4f1\ud638(`=`) \uc5f0\uc0b0\uc790\ub97c \uc0ac\uc6a9\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \ubcc0\uc218\uba85\uc744 \uc9c0\uc815\ud560 \ub54c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ubb38\uc790\uc758 \uc885\ub958 4\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc54c\ud30c\ubcb3 \ub300\uc18c\ubb38\uc790, \ud55c\uae00, \uc5b8\ub354 \ubc14(`_`), \uc22b\uc790\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ubcc0\uc218\uba85 \uc9c0\uc815 \uaddc\uce59 \uc911 \uccab \uae00\uc790 \ubc0f \ub300\uc18c\ubb38\uc790 \uad6c\ubd84 \uaddc\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc0\uc218\uba85\uc758 \uccab \uae00\uc790\uc5d0\ub294 \uc22b\uc790\uac00 \uc62c \uc218 \uc5c6\uc73c\uba70, \uc54c\ud30c\ubcb3 \ub300\uc18c\ubb38\uc790\ub294 \uc11c\ub85c \uad6c\ubcc4\ud558\uc5ec \uc0ac\uc6a9\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c `if`, `for`, `True` \ub4f1\uacfc \uac19\uc774 \uc774\ubbf8 \ubb38\ubc95\uc801 \uc758\ubbf8\uac00 \uc815\ud574\uc838 \uc788\uc5b4 \ubcc0\uc218\uba85\uc73c\ub85c \uc4f8 \uc218 \uc5c6\ub294 \ub2e8\uc5b4\ub4e4\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \uc608\uc57d\uc5b4(reserved words)\ub77c\uace0 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ucf54\ub4dc `b, c = 2.5, \"A\"` \uac00 \uc2e4\ud589\ub420 \ub54c \ubcc0\uc218 `b`\uc640 `c`\uc5d0 \uc800\uc7a5\ub418\ub294 \uac12\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc0\uc218 `b`\uc5d0\ub294 \uc2e4\uc218 `2.5`, \ubcc0\uc218 `c`\uc5d0\ub294 \ubb38\uc790 `'A'`\uac00 \uc21c\uc11c\ub300\ub85c \uc800\uc7a5\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ub8cc\ud615(data type)\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc0\uc218\uc5d0 \uc800\uc7a5\ub420 \ub370\uc774\ud130\uac00 \uc5b4\ub5a4 \uc720\ud615(\uc218\uce58\ud615, \ubd88\ud615, \ubb38\uc790\uc5f4 \ub4f1)\uc778\uc9c0 \uad6c\ubd84\ud558\ub294 \uac83\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \uc218\uce58\ud615 \uc790\ub8cc\ud615\uc5d0\uc11c \uc815\uc218\ud615\uacfc \uc2e4\uc218\ud615\uc758 \ub370\uc774\ud130 \ud0c0\uc785 \uba85\uce6d\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc218\ud615\uc740 `int`, \uc2e4\uc218\ud615\uc740 `float`\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc38(`True`)\uacfc \uac70\uc9d3(`False`)\uc758 \ub17c\ub9ac \uc815\ubcf4\ub97c \ub098\ud0c0\ub0b4\ub294 \ud30c\uc774\uc36c \uc790\ub8cc\ud615\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\ud615(`bool`)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \ubb38\uc790\uc5f4(`str`) \ub370\uc774\ud130\ub97c \ub098\ud0c0\ub0bc \ub54c \uc591\ub05d\uc744 \uac10\uc2f8\ub294 \uae30\ud638\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud070\ub530\uc634\ud45c(`\"\"`) \ub610\ub294 \uc791\uc740\ub530\uc634\ud45c(`''`)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \ud2b9\uc815 \ubcc0\uc218\ub098 \uac12\uc758 \uc790\ub8cc\ud615\uc744 \ud655\uc778\ud558\uace0\uc790 \ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`type()` \ud568\uc218\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uc5f4\uc774\ub098 \ub9ac\uc2a4\ud2b8\uc5d0 \uc800\uc7a5\ub41c \uc694\uc18c\uc758 \uc704\uce58\ub97c \ub098\ud0c0\ub0b4\ub294 \uc22b\uc790\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\uba70, \uadf8 \uc2dc\uc791 \uac12\uc740 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ub371\uc2a4(index)\ub77c\uace0 \ud558\uba70, $0$\ubd80\ud130 \uc21c\uc11c\ub300\ub85c $1$\uc529 \uc99d\uac00\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uc5f4 `a = \"HAPPY BIRTHDAY!\"`\uac00 \uc788\uc744 \ub54c, `a[1]`\uc758 \ucd9c\ub825 \uacb0\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`'A'` (\uc778\ub371\uc2a4 $0$\uc740 `'H'`, \uc778\ub371\uc2a4 $1$\uc740 `'A'`\uc774\ub2e4)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uc5f4 `a = \"HAPPY BIRTHDAY!\"`\uc5d0\uc11c `a[6:11]`\uc744 \uc2e4\ud589\ud558\uba74 \uc5b4\ub5a4 \ubb38\uc790\uac00 \ucd94\ucd9c\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`'BIRTH'` (\uc778\ub371\uc2a4 $6$\ubc88\ubd80\ud130 $10$\ubc88\uae4c\uc9c0\uc758 \ubb38\uc790\uac00 \ucd94\ucd9c\ub41c\ub2e4)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uc5f4 \uc2ac\ub77c\uc774\uc2f1 `a[:5]`\uc640 `a[11:]`\uc758 \ub3d9\uc791 \uacb0\uacfc\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`a[:5]`\ub294 \uc778\ub371\uc2a4 $0$\ubd80\ud130 $4$\uae4c\uc9c0 \ucd94\ucd9c\ud558\uba70, `a[11:]`\uc740 \uc778\ub371\uc2a4 $11$\ubd80\ud130 \ubb38\uc790\uc5f4 \ub05d\uae4c\uc9c0 \ucd94\ucd9c\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \ubb38\uc790\uc5f4\ub07c\ub9ac\uc758 `+` \uc5f0\uc0b0\uacfc `*` \uc5f0\uc0b0\uc740 \uac01\uac01 \uc5b4\ub5bb\uac8c \ub3d9\uc791\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`+` \uc5f0\uc0b0\uc740 \ub450 \ubb38\uc790\uc5f4\uc744 \uacb0\ud569\ud558\uace0, `*` \uc5f0\uc0b0\uc740 \ubb38\uc790\uc5f4\uc744 \uc815\uc218 \ud69f\uc218\ub9cc\ud07c \ubc18\ubcf5\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc220, \ube44\uad50, \ub17c\ub9ac \uc5f0\uc0b0\uc790\uc758 \uc5f0\uc0b0 \uc6b0\uc120\uc21c\uc704 \uad00\uacc4\ub294 \uc5b4\ub5bb\uac8c \ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc220 \uc5f0\uc0b0\uc790 $>$ \ube44\uad50 \uc5f0\uc0b0\uc790 $>$ \ub17c\ub9ac \uc5f0\uc0b0\uc790 \uc21c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \uc0b0\uc220 \uc5f0\uc0b0\uc790 \uc911 \ub098\ub217\uc148\uc758 \ubaab\uc744 \uad6c\ud558\ub294 \uae30\ud638\uc640 \ub098\uba38\uc9c0\ub97c \uad6c\ud558\ub294 \uae30\ud638\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaab\uc744 \uad6c\ud558\ub294 \uc5f0\uc0b0\uc790\ub294 `//`, \ub098\uba38\uc9c0\ub97c \uad6c\ud558\ub294 \uc5f0\uc0b0\uc790\ub294 `%`\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \uc5f0\uc0b0\uc2dd `2 ** 10`\uc758 \uc5f0\uc0b0\uc790 \uc758\ubbf8\uc640 \uc2e4\ud589 \uacb0\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`**`\ub294 \uac70\ub4ed\uc81c\uacf1 \uc5f0\uc0b0\uc790\uc774\uba70, \uc2e4\ud589 \uacb0\uacfc\ub294 $2^{10} = 1024$\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \uc218\ub098 \ubcc0\uc218\uc758 \uac12 \uad00\uacc4\ub97c \ube44\uad50\ud558\uc5ec `True` \ub610\ub294 `False`\ub97c \ud310\ub2e8\ud558\ub294 \uc5f0\uc0b0\uc790\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uad50 \uc5f0\uc0b0\uc790\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c '\uac19\ub2e4'\uc640 '\uac19\uc9c0 \uc54a\ub2e4'\ub97c \ub098\ud0c0\ub0b4\ub294 \ube44\uad50 \uc5f0\uc0b0\uc790 \uae30\ud638\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\uac19\ub2e4'\ub294 `==`, '\uac19\uc9c0 \uc54a\ub2e4'\ub294 `!=` \uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcc0\uc218 $n$\uc774 $5$ \uc774\uc0c1 $10$ \ubbf8\ub9cc\uc778\uc9c0 \ube44\uad50\ud558\ub294 \ud30c\uc774\uc36c \ud45c\uae30\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`5 <= n < 10` \uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\ub9ac\uacf1(`and`)\uacfc \ub17c\ub9ac\ud569(`or`) \uc5f0\uc0b0\uc790\uac00 \ucc38(`True`)\uc774 \ub418\uae30 \uc704\ud55c \uc870\uac74\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`and`\ub294 \ubaa8\ub4e0 \uc870\uac74\uc774 \ucc38\uc77c \ub54c \ucc38, `or`\ub294 \ud558\ub098 \uc774\uc0c1\uc758 \uc870\uac74\uc774 \ucc38\uc77c \ub54c \ucc38\uc774 \ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uac74\uc2dd\uc758 \uacb0\uacfc\uac00 \ucc38\uc774\uba74 \uac70\uc9d3, \uac70\uc9d3\uc774\uba74 \ucc38\uc73c\ub85c \ubc14\uafb8\ub294 \ub17c\ub9ac \uc5f0\uc0b0\uc790\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub17c\ub9ac \ubd80\uc815(`not`) \uc5f0\uc0b0\uc790\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0a4\ubcf4\ub4dc\ub85c \ub370\uc774\ud130\ub97c \uc785\ub825\ubc1b\ub294 \ud30c\uc774\uc36c \uba85\ub839\uc5b4\uc640 \uc785\ub825\ub41c \ub370\uc774\ud130\uc758 \uae30\ubcf8 \uc790\ub8cc\ud615\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba85\ub839\uc5b4\ub294 `input()` \uc774\uba70, \uc785\ub825\ubc1b\uc740 \uac12\uc740 \ubaa8\ub450 \ubb38\uc790\uc5f4(`str`) \ub370\uc774\ud130\ub85c \ucc98\ub9ac\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`input()`\uc73c\ub85c \uc785\ub825\ubc1b\uc740 \uc22b\uc790 \ubb38\uc790\uc5f4\uc744 \ub367\uc148\uc774\ub098 \uacf1\uc148 \ub4f1\uc758 \uc218\uce58 \uc5f0\uc0b0\uc5d0 \uc0ac\uc6a9\ud558\uae30 \uc704\ud574 \uac70\uccd0\uc57c \ud558\ub294 \uc791\uc5c5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`int()` \ub610\ub294 `float()` \ud568\uc218\ub97c \uc774\uc6a9\ud55c '\ud615 \ubcc0\ud658(type conversion)'\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uc5f4 `\"3.8\"`\uc744 `int(\"3.8\")`\ub85c \ud615 \ubcc0\ud658\ud558\ub824\uace0 \ud560 \ub54c \uc5b4\ub5a4 \ud604\uc0c1\uc774 \ubc1c\uc0dd\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\uc218\uc810\uc744 \ud3ec\ud568\ud55c \ubb38\uc790\uc5f4\uc740 \uc815\uc218\ud615\uc73c\ub85c \uc9c1\uc811 \ubcc0\ud658\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uc624\ub958(Error)\uac00 \ubc1c\uc0dd\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \ubaa8\ub2c8\ud130 \ud654\uba74\uc5d0 \ub370\uc774\ud130\ub97c \ucd9c\ub825\ud558\ub294 \ub300\ud45c\uc801\uc778 \ud45c\uc900 \ucd9c\ub825 \uba85\ub839\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`print()` \uba85\ub839\uc5b4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`print()` \ud568\uc218 \uc0ac\uc6a9 \uc2dc \uc5ec\ub7ec \uac1c\uc758 \uac12\uc744 \ud55c \uc904\uc5d0 \ub744\uc5b4\uc4f0\uae30\ub85c \ucd9c\ub825\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \uad6c\ubcc4\ud558\uc5ec \uc785\ub825\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad04\ud638 \uc548\uc5d0 \uac01 \uac12\ub4e4\uc744 \uc27c\ud45c(`,`)\ub85c \uad6c\ubd84\ud558\uc5ec \ub098\uc5f4\ud55c\ub2e4 (\uc608: `print(a, b, c)`)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc785\ub825 \ub370\uc774\ud130\ub97c \uc0ac\uc6a9\uc790\ub85c\ubd80\ud130 \uc989\uc2dc \uc815\uc218 \ud615\ud0dc\ub85c \ubc1b\uace0\uc790 \ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \uacb0\ud569 \ud45c\ud604\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`int(input())` \uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc77c\uc785\ucd9c\ub825(File I/O)\uc774 \ud45c\uc900\uc785\ucd9c\ub825\uacfc \uad6c\ubcc4\ub418\ub294 \uc8fc\uc694 \uc7a5\uc810 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ub9ce\uc740 \uc591\uc758 \ub370\uc774\ud130\ub97c \ube60\ub974\uac8c \ucc98\ub9ac\ud560 \uc218 \uc788\ub2e4. 2. \ud504\ub85c\uadf8\ub7a8\uc774 \uc885\ub8cc\ub418\uc5b4\ub3c4 \ub370\uc774\ud130\uac00 \ud30c\uc77c\ub85c \uacc4\uc18d \uc800\uc7a5\u00b7\ubcf4\uc874\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc77c\uc5d0 \ub300\ud55c \uacbd\ub85c\ub97c \uac00\ub9ac\ud0a4\uba70 \uc77d\uae30 \ubc0f \uc4f0\uae30 \uc791\uc5c5\uc744 \uc218\ud589\ud560 \uc218 \uc788\ub3c4\ub85d \ud574\uc8fc\ub294 \ub300\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc77c \uac1d\uccb4(file object)\ub77c\uace0 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc77c \uc5f4\uae30 \ud568\uc218 `open('\ud30c\uc77c\uba85', '\uc811\uadfc \ubc29\uc2dd')`\uc5d0\uc11c \uc77d\uae30, \uc4f0\uae30, \ucd94\uac00 \ubaa8\ub4dc\ub97c \ub73b\ud558\ub294 \uae30\ud638\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77d\uae30\ub294 `'r'`, \uc4f0\uae30\ub294 `'w'`, \ucd94\uac00\ud558\uae30\ub294 `'a'` \uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc77c \uc811\uadfc \ubaa8\ub4dc \uc911 `'w'`(\uc4f0\uae30)\uc640 `'a'`(\ucd94\uac00)\uc758 \uacf5\ud1b5\uc810\uacfc \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ud1b5\uc810: \ud30c\uc77c\uc774 \uc5c6\uc73c\uba74 \uc0c8 \ud30c\uc77c\uc744 \uc0dd\uc131\ud55c\ub2e4. \ucc28\uc774\uc810: `'w'`\ub294 \uae30\uc874 \ub0b4\uc6a9\uc744 \uc9c0\uc6b0\uace0 \uc0c8\ub85c \uc4f0\uba70, `'a'`\ub294 \uae30\uc874 \ub0b4\uc6a9 \ub4a4\uc5d0 \ucd94\uac00\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f4\ub9b0 \ud30c\uc77c\uc758 \ub0b4\uc6a9 \uc804\uccb4\ub97c \ubb38\uc790\uc5f4\ub85c \uc77d\uc5b4\uc624\ub294 \uba54\uc11c\ub4dc\uc640 \ud30c\uc77c \uc0ac\uc6a9\uc744 \ub05d\ub9c8\uce60 \ub54c \uc4f0\ub294 \uba54\uc11c\ub4dc\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uccb4 \ub0b4\uc6a9\uc744 \uc77d\ub294 \uba54\uc11c\ub4dc\ub294 `.read()`, \ud30c\uc77c\uc744 \ub2eb\ub294 \uba54\uc11c\ub4dc\ub294 `.close()` \uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc77c \uac1d\uccb4 `f`\uc5d0\uc11c \ud14d\uc2a4\ud2b8 \ud30c\uc77c\uc758 \ub0b4\uc6a9\uc744 \ud55c \uc904\uc529 \uc21c\ucc28\uc801\uc73c\ub85c \uc77d\uc5b4\uc624\uae30 \uc704\ud55c \ubc18\ubcf5\ubb38 \uad6c\uc870\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`for row in f:` \uad6c\ubb38\uc744 \uc0ac\uc6a9\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "CSV(Comma Separated Values) \ud30c\uc77c\uc758 \ud615\uc2dd\uc801 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\uc758 \uac01 \ud56d\ubaa9\ub4e4\uc774 \uc27c\ud45c(`,`)\ub85c \uad6c\ubd84\ub418\uc5b4 \uc800\uc7a5\ub418\ub294 \ubc94\uc6a9 \ud14d\uc2a4\ud2b8 \ud30c\uc77c \ud615\uc2dd\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uae00 \ucf54\ub7a9 \ud658\uacbd\uc5d0\uc11c \uc0ac\uc6a9\uc790\uc758 \ucef4\ud4e8\ud130\uc5d0 \uc874\uc7ac\ud558\ub294 \ud30c\uc77c(\uc608: CSV)\uc744 \uc5c5\ub85c\ub4dc\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \ud328\ud0a4\uc9c0 \uba85\ub839 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`from google.colab import files` \ubaa8\ub4c8\uc758 `files.upload()` \ud568\uc218\ub97c \ud638\ucd9c\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c CSV \uc804\uc6a9 \ub77c\uc774\ube0c\ub7ec\ub9ac\ub97c \uc784\ud3ec\ud2b8\ud558\uace0 \ud30c\uc77c\uc744 \ud55c \ud589\uc529 \uc77d\uc5b4\uc624\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`import csv` \ud6c4 `csv.reader(\ud30c\uc77c\uac1d\uccb4)` \ud568\uc218\ub97c \uc0ac\uc6a9\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ud30c\uc77c \uc785\ucd9c\ub825 \uc2dc \ud55c\uae00\uc774 \uae68\uc9c0\ub294 \ud604\uc0c1\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 `open()` \ud568\uc218\uc5d0 \uc9c0\uc815\ud558\ub294 \uc778\ucf54\ub529 \uc635\uc158\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`encoding = \"utf8\"` \uc635\uc158\uc744 \uc9c0\uc815\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778\uc815\ubcf4 \ubcf4\ud638\ub97c \uc704\ud574 \ub2f9\ucca8\uc790 \uba85\ub2e8 \ub4f1\uc5d0\uc11c \uac1c\uc778\uc744 \uc2dd\ubcc4\ud560 \uc218 \uc788\ub294 \uc815\ubcf4 \uc77c\ubd80\ub098 \uc804\ubd80\ub97c \uc0ad\uc81c/\ub300\uccb4\ud558\ub294 \uc791\uc5c5\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc2dd\ubcc4\ud654 \uc791\uc5c5\uc774\ub77c\uace0 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ubb38\uc790\uc5f4 `s`\uc5d0\uc11c \uc9c0\uc815\ud55c \ud2b9\uc815 \ubb38\uc790\ub97c \ub2e4\ub978 \ubb38\uc790\ub85c \ubc14\uafb8\ub294 \uba54\uc11c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`s.replace(\uae30\uc874\ubb38\uc790, \ubc14\uafc0\ubb38\uc790)` \uba54\uc11c\ub4dc\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\ucc28\uc6d0 \ub370\uc774\ud130 \uad6c\uc870\uc758 \uc815\uc758\uc640 \uc8fc\uc694 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ub97c \ud589\uacfc \uc5f4 \ub610\ub294 \uadf8 \uc774\uc0c1\uc758 \ucc28\uc6d0\uc73c\ub85c \uad6c\uc131\ud558\uc5ec \uc800\uc7a5\ud558\ub294 \ubc29\uc2dd\uc73c\ub85c, \ub9ce\uc740 \uc591\uc758 \ub370\uc774\ud130\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uace0 \ucc98\ub9ac\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucef4\ud4e8\ud130\uc5d0\uc11c \ud751\ubc31 \uc774\ubbf8\uc9c0\ub97c \ud45c\ud604\ud560 \ub54c 2\ucc28\uc6d0 \ub370\uc774\ud130 \uad6c\uc870\ub97c \uc0ac\uc6a9\ud558\ub294 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud751\ubc31 \uc774\ubbf8\uc9c0\ub294 \uc0c9\uc0c1 \uc5c6\uc774 \uac01 \ud53d\uc140\uc758 \ubc1d\uae30\ub9cc\uc744 \ud544\uc694\ub85c \ud558\ubbc0\ub85c, $0 \\sim 255$ \uc0ac\uc774\uc758 \uc815\uc22b\uac12\uc73c\ub85c \uad6c\uc131\ub41c 2\ucc28\uc6d0 \ub370\uc774\ud130 \uad6c\uc870\ub85c \ud45c\ud604\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud751\ubc31 \uc774\ubbf8\uc9c0\uc758 \ud53d\uc140 \ubc1d\uae30\uac12\uc5d0\uc11c $0$\uacfc $255$\ub294 \uac01\uac01 \uc5b4\ub5a4 \uba85\uc554 \uc0c1\ud0dc\ub97c \ub098\ud0c0\ub0b4\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$0$\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \uc5b4\ub450\uc6b4 \uc0c9(\uac80\uc815)\uc744 \ub098\ud0c0\ub0b4\uace0, $255$\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \ubc1d\uc740 \uc0c9(\ud558\uc591)\uc744 \ub098\ud0c0\ub0b8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uceec\ub7ec \uc774\ubbf8\uc9c0\ub97c \ud45c\ud604\ud560 \ub54c \ud751\ubc31 \uc774\ubbf8\uc9c0\uc640 \ub2ec\ub9ac 3\ucc28\uc6d0 \ub370\uc774\ud130 \uad6c\uc870\uac00 \ud544\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud53d\uc140\uc758 \ubc1d\uae30 \uc815\ubcf4 \uc678\uc5d0 \ube68\uac15(R), \ucd08\ub85d(G), \ud30c\ub791(B) 3\uac00\uc9c0 \uc0c9\uc0c1 \uc815\ubcf4 \ucc28\uc6d0\uc774 \ucd94\uac00\ub418\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ub7ec \uac1c\uc758 \ub370\uc774\ud130 \uac12\uc744 \ubb36\uc5b4\uc11c \ud558\ub098\uc758 \ubcc0\uc218 \uc774\ub984\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ud30c\uc774\uc36c\uc758 \ub300\ud45c\uc801 1\ucc28\uc6d0 \ub370\uc774\ud130 \uad6c\uc870\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\ucc28\uc6d0 \ub9ac\uc2a4\ud2b8(list)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9ac\uc2a4\ud2b8 \ub0b4\ubd80\uc5d0 \uc800\uc7a5\ub41c \uac01\uac01\uc758 \uac12\ub4e4\uc744 \ub73b\ud558\ub294 \uc6a9\uc5b4\uc640, \uc774\ub4e4\uc758 \uc790\ub8cc\ud615\uc5d0 \ub300\ud55c \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01\uac01\uc758 \uac12\uc744 '\uc694\uc18c(\uc6d0\uc18c)'\ub77c\uace0 \ud558\uba70, \ud558\ub098\uc758 \ub9ac\uc2a4\ud2b8 \uc548\uc5d0 \uc815\uc218, \uc2e4\uc218, \ubb38\uc790\uc5f4 \ub4f1 \uc11c\ub85c \ub2e4\ub978 \uc790\ub8cc\ud615\uc774 \ud568\uaed8 \uc874\uc7ac\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c `d = [0] * 5` \ucf54\ub4dc\ub97c \uc2e4\ud589\ud588\uc744 \ub54c \uc0dd\uc131\ub418\ub294 \ub9ac\uc2a4\ud2b8\uc758 \uac12\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`[0, 0, 0, 0, 0]` (\ubaa8\ub4e0 \uc694\uc18c\uac00 $0$\uc778 \uae38\uc774 $5$\uc758 \ub9ac\uc2a4\ud2b8\uac00 \uc0dd\uc131\ub41c\ub2e4)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9ac\uc2a4\ud2b8 `n = [10, 20, 30, 40, 50]`\uc5d0\uc11c `n[0]`\uacfc `n[-1]`\uc774 \uac00\ub9ac\ud0a4\ub294 \uc694\uc18c\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`n[0]`\uc740 \uccab \ubc88\uc9f8 \uc694\uc18c\uc778 `10`, `n[-1]`\uc740 \ub9e8 \ub4a4\uc5d0 \uc704\uce58\ud55c \uc694\uc18c\uc778 `50`\uc774\ub2e4."
