    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9ac\uc2a4\ud2b8 \ub0b4\ubd80 \ub370\uc774\ud130\ub97c \uc624\ub984\ucc28\uc21c\uc73c\ub85c \uc815\ub82c\ud558\ub294 \uba85\ub839\uc5b4\uc640 \ub9e8 \ub4a4\uc758 \uc6d0\uc18c\ub97c \uc0ad\uc81c\ud558\ub294 \uba85\ub839\uc5b4\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
