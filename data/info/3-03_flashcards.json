    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`\ub9ac\uc2a4\ud2b8\uba85.remove(\uac12)` \uc2e4\ud589 \uc2dc \ub9ac\uc2a4\ud2b8 \uc548\uc5d0 \uc0ad\uc81c\ud558\ub824\ub294 \uac12\uc774 \uc5ec\ub7ec \uac1c \uc874\uc7ac\ud558\ub294 \uacbd\uc6b0 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ub418\ub294\uac00?"
