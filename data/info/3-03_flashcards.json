    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`\ub9ac\uc2a4\ud2b8\uba85.insert(\uc778\ub371\uc2a4, \uac12)` \uba85\ub839\uc5b4\uc758 \uae30\ub2a5\uacfc \uadf8 \uc774\ud6c4 \ub370\uc774\ud130\ub4e4\uc758 \ubcc0\ud654\ub294 \ubb34\uc5c7\uc778\uac00?"
