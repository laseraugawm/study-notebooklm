    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc54c\uace0\ub9ac\uc998\uc758 \uc81c\uc5b4 \uad6c\uc870 \uc911 '\uc120\ud0dd \uad6c\uc870'\uc640 '\ubc18\ubcf5 \uad6c\uc870'\uc758 \ud575\uc2ec \uac1c\ub150\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
