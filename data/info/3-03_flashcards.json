      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9ac\uc2a4\ud2b8\uc5d0\uc11c \uac00\uc7a5 \uccab \ubc88\uc9f8\ub85c \ub098\ud0c0\ub098\ub294 \uc694\uc18c\ub97c \ud558\ub098\ub9cc \uc0ad\uc81c\ud55c\ub2e4."
