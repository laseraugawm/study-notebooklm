{
  "title": "\uc0ac\ubb3c\uc778\ud130\ub137 \ud034\uc988",
  "questions": [
    {
      "question": "\ud53c\uc9c0\uceec \ucef4\ud4e8\ud305\uc744 \uad6c\uc131\ud558\ub294 \uc8fc\uc694 \uc7a5\uce58 \uc911 '\uc13c\uc11c'\uc758 \uc5ed\ud560\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc13c\uc11c\ub85c \uc5bb\uc740 \uc815\ubcf4\ub97c \ubd84\uc11d\ud558\uace0 \uc561\ucd94\uc5d0\uc774\ud130\ub97c \uc81c\uc5b4\ud558\ub294 \ucc98\ub9ac \uc7a5\uce58\uc774\ub2e4.",
          "rationale": "\uc774\ub294 \uc13c\uc11c\uac00 \uc544\ub2cc \ub9c8\uc774\ud06c\ub85c\ucee8\ud2b8\ub864\ub7ec(\ucc98\ub9ac \uc7a5\uce58)\uc758 \uc5ed\ud560\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub9c8\uc774\ud06c\ub85c\ucee8\ud2b8\ub864\ub7ec\uc758 \uc81c\uc5b4\ub97c \ubc1b\uc544 \ubb3c\ub9ac\uc801\uc73c\ub85c \uad6c\ub3d9\ud558\ub294 \ucd9c\ub825 \uc7a5\uce58\uc774\ub2e4.",
          "rationale": "\uc774\ub294 \uad6c\ub3d9\uae30\ub77c\uace0\ub3c4 \ubd88\ub9ac\ub294 \uc561\ucd94\uc5d0\uc774\ud130(\ucd9c\ub825 \uc7a5\uce58)\uc758 \uc5ed\ud560\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc628\ub3c4, \ubc1d\uae30 \ub4f1 \uc8fc\ubcc0\uc758 \ud658\uacbd\uacfc \uc0c1\ud669\uc744 \uc778\uc2dd\ud558\ub294 \uc785\ub825 \uc7a5\uce58\uc774\ub2e4.",
          "rationale": "\uc13c\uc11c\ub294 \uc8fc\ubcc0 \ud658\uacbd\uc758 \uc628\ub3c4, \ubc1d\uae30, \uac00\uc18d\ub3c4 \ub4f1\uc744 \uac10\uc9c0\ud558\uace0 \uce21\uc815\ud558\uc5ec \uc2e0\ud638\ub85c \ubcc0\ud658\ud558\ub294 \uc785\ub825 \uc7a5\uce58\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc218\uc9d1\ub41c \ub370\uc774\ud130\ub97c \uc554\ud638\ud654\ud558\uc5ec \uc678\ubd80 \uce68\uc785\uc744 \ud0d0\uc9c0\ud558\ub294 \ubcf4\uc548 \uae30\uc220\uc774\ub2e4.",
          "rationale": "\uc774\ub294 \uc0ac\ubb3c \uc778\ud130\ub137 \uae30\uc220 \uc694\uc18c \uc911 \ub370\uc774\ud130 \ubcf4\uc548 \uae30\uc220\uc5d0 \ud574\ub2f9\ud558\ub294 \uc124\uba85\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc8fc\ubcc0\uc758 \ubb3c\ub9ac\uc801 \ubcc0\ud654\ub098 \uc0c1\ud669\uc744 \ucc98\uc74c\uc73c\ub85c \ubc1b\uc544\ub4e4\uc774\ub294 '\uc785\ub825' \uae30\ub2a5\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc0ac\ubb3c \uc778\ud130\ub137(IoT) \uae30\ubc18 \uc2a4\ub9c8\ud2b8 \ud648 \ubcf4\uc548 \uc2dc\uc2a4\ud15c\uc758 \ub3d9\uc791 \ub2e8\uacc4 \uc911, '\ub3d9\uc791 \uc13c\uc11c\ub85c \ubb38 \uc5f4\ub9bc \uac10\uc9c0 \uc2e0\ud638\uac00 \ubc1c\uc0dd'\ud558\ub294 \ub2e8\uacc4\ub294 \uc5b4\ub514\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?",
      "answerOptions": [
        {
          "text": "\uc11c\ube44\uc2a4 \uc81c\uacf5 \ub2e8\uacc4",
          "rationale": "\uc11c\ube44\uc2a4 \uc81c\uacf5\uc740 \uce68\uc785\uc73c\ub85c \ud310\ub2e8\ub418\uc5c8\uc744 \ub54c \uacbd\ucc30\uc11c\uc5d0 \uc790\ub3d9 \uc5f0\uacb0\ud558\ub294 \ub4f1\uc758 \ucd5c\uc885 \uc751\ub2f5 \ub2e8\uacc4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub370\uc774\ud130 \uc218\uc9d1 \ub2e8\uacc4",
          "rationale": "\ub3d9\uc791 \uc13c\uc11c\uac00 \ubb38 \uc5f4\ub9bc\uacfc \uac19\uc740 \ubb3c\ub9ac\uc801 \ud604\uc0c1\uc774\ub098 \uc2e0\ud638\ub97c \ucc98\uc74c \uac10\uc9c0\ud558\ub294 \uacfc\uc815\uc740 \ub370\uc774\ud130 \uc218\uc9d1 \ub2e8\uacc4\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub370\uc774\ud130 \ucc98\ub9ac \ub2e8\uacc4",
          "rationale": "\ub370\uc774\ud130 \ucc98\ub9ac\ub294 \uc218\uc9d1\ub41c \uc2e0\ud638\uc640 \ubcf4\uc548 \ubaa8\ub4dc \uc0c1\ud0dc\ub97c \ubd84\uc11d\ud558\uc5ec \uce68\uc785 \uac00\ub2a5\uc131\uc744 \ud310\ub2e8\ud558\ub294 \ub2e8\uacc4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub370\uc774\ud130 \uc800\uc7a5 \ub2e8\uacc4",
          "rationale": "\ub370\uc774\ud130 \uc800\uc7a5\uc740 \uc13c\uc11c \uc2e0\ud638 \ubc0f \ub85c\uadf8\ub97c \ub370\uc774\ud130\ubca0\uc774\uc2a4\ub098 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \ubcf4\uad00\ud558\ub294 \ub2e8\uacc4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc13c\uc11c\uac00 \ud604\uc2e4 \uc138\uacc4\uc758 \ubcc0\ud654\ub97c \uc778\uc2dd\ud558\uc5ec \uccab \uc2e0\ud638\ub97c \ub9cc\ub4dc\ub294 \ub2e8\uacc4\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub178\ud6c4 \uac74\ucd95\ubb3c \uc548\uc804 \uad00\ub9ac\uc5d0 \uc0ac\ubb3c \uc778\ud130\ub137(IoT)\uacfc \ube14\ub85d\uccb4\uc778 \uae30\uc220\uc744 \uc735\ud569\ud558\uc5ec \uc801\uc6a9\ud588\uc744 \ub54c \uc5bb\uc744 \uc218 \uc788\ub294 \ud575\uc2ec \uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc2e4\uc2dc\uac04 \uc218\uc9d1\ub41c \ub370\uc774\ud130\uc758 \uc704\ubcc0\uc870\uac00 \ucc28\ub2e8\ub418\uc5b4 \ub370\uc774\ud130\uc758 \uc2e0\ub8b0\uc131\uacfc \ubcf4\uc548\uc131\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub41c\ub2e4.",
          "rationale": "IoT \uc13c\uc11c\uc758 \uc2e4\uc2dc\uac04 \uce21\uc815 \ub370\uc774\ud130\uc5d0 \ube14\ub85d\uccb4\uc778\uc758 \uc704\ubcc0\uc870 \uc6d0\ucc9c \ucc28\ub2e8 \uae30\ub2a5\uc774 \uacb0\ud569\ud558\uc5ec \ub370\uc774\ud130 \uc2e0\ub8b0\uc131\uc744 \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub2e8\uc77c \uc911\uc559 \uc11c\ubc84\uc5d0 \uc804 \ub370\uc774\ud130\uac00 \uc9d1\uc911 \ubcf4\uad00\ub418\uc5b4 \ub370\uc774\ud130 \uad00\ub9ac \ube44\uc6a9\uc774 \uc904\uc5b4\ub4e0\ub2e4.",
          "rationale": "\ube14\ub85d\uccb4\uc778\uc740 \ub370\uc774\ud130\ub97c \uc911\uc559 \uc11c\ubc84\uc5d0 \uc9d1\uc911\ud558\uc9c0 \uc54a\uace0 \ub124\ud2b8\uc6cc\ud06c \uae30\uae30 \uc804\uccb4\uc5d0 \ubd84\uc0b0 \uc800\uc7a5\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac74\ubb3c\uc758 \uc218\uba85\uc744 \uc778\uc704\uc801\uc73c\ub85c \uc5f0\uc7a5\ud558\uc5ec \uad6c\uc870\uc801 \uade0\uc5f4 \ubc1c\uc0dd \uc790\uccb4\ub97c \ubb3c\ub9ac\uc801\uc73c\ub85c \ubc29\uc9c0\ud55c\ub2e4.",
          "rationale": "\uc548\uc804 \uad00\ub9ac\ub294 \uc704\ud5d8\uc744 \uac10\uc9c0\ud558\uc5ec \uc608\ubc29 \uc870\uce58\ub97c \ucde8\ud558\ub3c4\ub85d \ub3d5\ub294 \uc2dc\uc2a4\ud15c\uc774\uc9c0 \ub178\ud6c4\ud654 \uc790\uccb4\ub97c \ubb3c\ub9ac\uc801\uc73c\ub85c \ub9c9\ub294 \uae30\uc220\uc740 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0ac\ub78c\uc774 \ud604\uc7a5\uc5d0\uc11c \uc77c\uc77c\uc774 \uc810\uac80\ud55c \uc11c\uba74 \ubcf4\uace0\uc11c\uc758 \uc791\uc131 \uacfc\uc815\uc744 \uc790\ub3d9\ud654\ud55c\ub2e4.",
          "rationale": "\ud604\uc7a5\u00b7\uc778\ub825 \uc911\uc2ec \uad00\ub9ac\ub97c \ub514\uc9c0\ud138 \ub370\uc774\ud130 \uae30\ubc18\uc758 \uc790\ub3d9\ud654 \uce21\uc815 \ubc0f \uac80\uc99d \ubc29\uc2dd\uc73c\ub85c \uc804\ud658\ud558\ub294 \uac83\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uae30\uc874 IoT \ub370\uc774\ud130\uc758 \ud55c\uacc4\uc600\ub358 '\ubcf4\uc548 \uc704\ud5d8'\uacfc '\ub370\uc774\ud130 \uc704\ubcc0\uc870 \uac80\uc99d \ubd88\uac00'\ub97c \ud574\uacb0\ud558\ub294 \ube14\ub85d\uccb4\uc778\uc758 \ud2b9\uc131\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uad50\uacfc\uc11c\uc5d0\uc11c \uc124\uba85\ud558\ub294 '\ube14\ub85d\uccb4\uc778(Blockchain)' \uae30\uc220\uc758 \ud2b9\uc131\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub370\uc774\ud130\ub97c '\ube14\ub85d'\uc774\ub77c\ub294 \uc791\uc740 \ub2e8\uc704\ub85c \ub098\ub204\uc5b4 \uccb4\uc778 \ud615\ud0dc\ub85c \uc5f0\uacb0\ud558\uc5ec \uc800\uc7a5\ud55c\ub2e4.",
          "rationale": "\uc774\ub294 \ube14\ub85d\uccb4\uc778\uc758 \uae30\ubcf8\uc801\uc778 \ub370\uc774\ud130 \uad6c\uc870 \ubc29\uc2dd\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub124\ud2b8\uc6cc\ud06c \uc911\uc2ec\uc5d0 \uc788\ub294 \ub2e8 \ud558\ub098\uc758 \ub300\ud615 \uc11c\ubc84\uac00 \ubaa8\ub4e0 \uc815\ubcf4\uac12\uc744 \uc804\ub2f4\ud558\uc5ec \uc720\uc9c0\u00b7\uac31\uc2e0\ud55c\ub2e4.",
          "rationale": "\ube14\ub85d\uccb4\uc778\uc740 \ud2b9\uc815 \uc11c\ubc84\uc5d0 \uc815\ubcf4\uac00 \uc9d1\uc911\ub418\uc9c0 \uc54a\uc73c\uba70, \uc5f0\uacb0\ub41c \ubaa8\ub4e0 \uae30\uae30\uac00 \uac19\uc740 \ubcf5\uc0ac\ubcf8\uc744 \uacf5\uc720\ud558\ub294 \ubd84\uc0b0\ud615 \uad6c\uc870\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub124\ud2b8\uc6cc\ud06c\uc5d0 \uc5f0\uacb0\ub41c \ub2e4\uc218\uc758 \ucef4\ud4e8\ud305 \uc2dc\uc2a4\ud15c\uc774 \ub3d9\uc2dc\uc5d0 \uc815\ubcf4\uac12\uc744 \uc720\uc9c0\ud558\uace0 \uac31\uc2e0\ud55c\ub2e4.",
          "rationale": "\ubd84\uc0b0 \ub124\ud2b8\uc6cc\ud06c\uc5d0 \ucc38\uc5ec\ud558\ub294 \ub2e4\uc218 \uae30\uae30\ub4e4\uc774 \uacf5\ub3d9\uc73c\ub85c \uc815\ubcf4\uc758 \uc720\ud6a8\uc131\uc744 \uac80\uc99d\ud558\uace0 \uac31\uc2e0\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc554\ud638\ud654\ub41c \uc778\uc99d\uc744 \uc0ac\uc6a9\ud558\uace0 \uacf5\uc720 \ubcf5\uc0ac\ubcf8\uc744 \ubcf4\uc720\ud558\uc5ec \ubcf4\uc548\uc131\uacfc \uc2e0\ub8b0\uc131\uc774 \ub6f0\uc5b4\ub098\ub2e4.",
          "rationale": "\ub3d9\uc77c\ud55c \ubcf5\uc0ac\ubcf8 \uacf5\uc720\uc640 \uc554\ud638\ud654 \ubc29\uc2dd\uc744 \ud1b5\ud574 \ub370\uc774\ud130\uc758 \ubb34\ub2e8 \uc704\ubcc0\uc870\ub97c \uc608\ubc29\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub370\uc774\ud130\uac00 \uc911\uc559 \uad00\ub9ac \uae30\uad00 \ud55c \uacf3\uc5d0\ub9cc \uc9d1\uc911\ub418\ub294 \uad6c\uc870\uc778\uc9c0, \uc5ec\ub7ec \uae30\uae30\uc5d0 \ub098\ub204\uc5b4\uc838 \uad00\ub9ac\ub418\ub294 \uad6c\uc870\uc778\uc9c0 \ud655\uc778\ud558\uc138\uc694."
    },
    {
      "question": "\uae30\uc874\uc758 \uc804\ub825\ub9dd\uc5d0 \uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220(ICT)\uc744 \uc735\ud569\ud558\uc5ec \uc804\uae30 \uacf5\uae09\uc790\uc640 \uc18c\ube44\uc790\uac00 \uc2e4\uc2dc\uac04\uc73c\ub85c \uc804\ub825 \uc815\ubcf4\ub97c \uad50\ud658\ud568\uc73c\ub85c\uc368 \uc5d0\ub108\uc9c0\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc788\uac8c \ud558\ub294 \uc2dc\uc2a4\ud15c\uc740?",
      "answerOptions": [
        {
          "text": "\uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc",
          "rationale": "ICT\uc640 \uc804\ub825\ub9dd(grid)\uc744 \uc735\ud569\ud558\uc5ec \uc2e4\uc2dc\uac04 \uc804\ub825 \uc815\ubcf4 \uad50\ud658\uc73c\ub85c \uc5d0\ub108\uc9c0 \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\ub294 \uc804\ub825\ub9dd\uc744 \uc2a4\ub9c8\ud2b8 \uadf8\ub9ac\ub4dc\ub77c \ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc2a4\ub9c8\ud2b8 \ud5ec\uc2a4\ucf00\uc5b4",
          "rationale": "\uc2a4\ub9c8\ud2b8 \ud5ec\uc2a4\ucf00\uc5b4\ub294 \uac1c\uc778\uc758 \uc0dd\uccb4 \uc815\ubcf4 \ubaa8\ub2c8\ud130\ub9c1 \ubc0f \uc6d0\uaca9 \uc9c4\ub8cc \ub4f1\uc5d0 \uad00\ub828\ub41c \uae30\uc220 \ubd84\uc57c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2a4\ub9c8\ud2b8 \uacf5\uc7a5",
          "rationale": "\uc2a4\ub9c8\ud2b8 \uacf5\uc7a5\uc740 \uc81c\uc870 \ubc0f \uc0dd\uc0b0 \ub77c\uc778\uc744 \uc790\ub3d9\ud654\ud558\uace0 \ubaa8\ub2c8\ud130\ub9c1\ud558\ub294 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2a4\ub9c8\ud2b8 \ube4c\ub529",
          "rationale": "\uc2a4\ub9c8\ud2b8 \ube4c\ub529\uc740 \uac74\ubb3c \ub0b4 \uc8fc\ucc28, \ucd9c\uc785 \uc81c\uc5b4, \uc5d0\ub108\uc9c0 \uad00\ub9ac\ub97c \ud6a8\uc728\ud654\ud558\ub294 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "'\uc804\ub825\ub9dd(Grid)'\uc5d0 \uc815\ubcf4 \uae30\uc220\uc774 \uc811\ubaa9\ub418\uc5b4 \uc5d0\ub108\uc9c0 \ud6a8\uc728\uc131\uc744 \ub192\uc774\ub294 \uc6a9\uc5b4\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\uc0ac\ubb3c \uc778\ud130\ub137 \uad6c\ud604\uc5d0 \ud544\uc694\ud55c \uae30\uc220 \uc911 '\uc800\uc7a5 \uae30\uc220'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc628\ub3c4, \uac00\uc18d\ub3c4 \ub4f1 \uc8fc\ubcc0 \ud658\uacbd \uc2e0\ud638\ub97c \uac10\uc9c0\ud558\uace0 \uce21\uc815\ud558\ub294 \uae30\uc220\uc774\ub2e4.",
          "rationale": "\uc774\ub294 \uc678\ubd80 \ud658\uacbd \ub370\uc774\ud130\ub97c \uce21\uc815\ud558\ub294 \uc13c\uc11c \uae30\uc220\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub370\uc774\ud130\ubca0\uc774\uc2a4 \uae30\uc220\uc774\ub098 \ud074\ub77c\uc6b0\ub4dc \ucef4\ud4e8\ud305 \uae30\uc220 \ub4f1\uc744 \ud65c\uc6a9\ud558\uc5ec \ubaa8\uc778 \ub370\uc774\ud130\ub97c \uad00\ub9ac\ud55c\ub2e4.",
          "rationale": "\uc800\uc7a5 \uae30\uc220\uc740 \uac01\uc885 \uc13c\uc11c\ub85c \ubaa8\uc740 \ub300\uc6a9\ub7c9 \ub370\uc774\ud130\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \ubcf4\uad00\ud558\uace0 \uad00\ub9ac\ud558\uae30 \uc704\ud574 DB\ub098 \ud074\ub77c\uc6b0\ub4dc \uae30\uc220\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud574\ud0b9\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ub370\uc774\ud130\ub97c \uc554\ud638\ud654\ud558\uace0 \uce68\uc785 \ud0d0\uc9c0 \uc2dc\uc2a4\ud15c\uc744 \ub3c4\uc785\ud558\ub294 \uae30\uc220\uc774\ub2e4.",
          "rationale": "\uc774\ub294 \uc804\uc1a1 \ubc0f \uc800\uc7a5 \ub370\uc774\ud130\uc758 \uc548\uc815\uc131\uc744 \ud655\ubcf4\ud558\ub294 \ub370\uc774\ud130 \ubcf4\uc548 \uae30\uc220\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc18c\ud504\ud2b8\uc6e8\uc5b4\ub97c \ud1b5\ud574 \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uace0 \uc0ac\uc6a9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \ub9de\ucda4\ud615 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud55c\ub2e4.",
          "rationale": "\uc774\ub294 \ub370\uc774\ud130\ub97c \uac00\uacf5\ud558\uace0 \ucc98\ub9ac\ud558\ub294 \ubd84\uc11d \uae30\uc220 \ubc0f \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uae30\uc220\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub300\uc6a9\ub7c9\uc758 \uc0ac\ubb3c \uc778\ud130\ub137 \ub370\uc774\ud130\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\u00b7\ubcf4\uad00\ud558\ub294 \ucef4\ud4e8\ud305 \uc778\ud504\ub77c \uae30\uc220\uc744 \uc120\ud0dd\ud558\uc138\uc694."
