    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud328\uc2a4\uc6cc\ub4dc, PIN \ubc88\ud638, \ud328\ud134 \ub4f1 \uae30\uc5b5\ud558\uace0 \uc788\ub294 \uc815\ubcf4\ub85c \uc790\uaca9\uc744 \ud655\uc778\ud558\ub294 \uc778\uc99d \uae30\uc220\uc740?"
