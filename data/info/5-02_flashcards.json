    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uacf5 \ub370\uc774\ud130 \ud3ec\ud138(www.data.go.kr)\uc5d0\uc11c \uacf5\uac1c\ud558\uc5ec \uacf5\uc720\ud558\ub294 \ub370\uc774\ud130\uc758 \uc885\ub958\uc5d0\ub294 \uc5b4\ub5a4 \uac83\ub4e4\uc774 \uc788\ub294\uac00?"
