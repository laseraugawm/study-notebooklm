    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \uc911 \ubcf4\ud638\ud574\uc57c \ud560 \uac1c\uc778 \uc815\ubcf4\uc5d0 \ud574\ub2f9\ud558\ub294 \uac83\uc740?\n\u3131. \uad50\ud1b5 \uc2e0\ud638 \ub370\uc774\ud130\n\u3134. \ubcf8\uc778\uc758 \uc9c0\ubb38 \ubc0f \ud64d\ucc44 \ub370\uc774\ud130\n\u3137. \uc6b0\ub9ac \ub3d9\ub124 \uc9c0\ud558\ucca0 \uc6b4\ud589 \uc2dc\uac04\ud45c"
          }
