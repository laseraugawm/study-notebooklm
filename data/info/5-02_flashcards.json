    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub124\ud2b8\uc6cc\ud06c \ubcf4\uc548 \uc2dc\uc2a4\ud15c \uc911 \uce68\uc785 \ud0d0\uc9c0 \uc2dc\uc2a4\ud15c(IDS)\uacfc \uce68\uc785 \ubc29\uc9c0 \uc2dc\uc2a4\ud15c(IPS)\uc758 \ud575\uc2ec \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
