    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130 \ubd84\uc11d \uae30\uc5c5\uc774 \uc124\ubb38 \uc571\uc744 \ud1b5\ud574 \uc218\uc9d1\ud55c \uac1c\uc778 \uc815\ubcf4\ub85c \uc720\uad8c\uc790 \uc131\ud5a5\uc744 \ubd84\uc11d\ud574 \uc120\uac70\uc5d0 \uc545\uc6a9\ud55c \uc0ac\ub840\uc5d0\uc11c \ub4dc\ub7ec\ub09c \uac1c\uc778 \uc815\ubcf4 \ubb38\uc81c\uc810\uc740?"
