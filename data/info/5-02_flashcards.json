      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "IDS\ub294 \ubd88\ubc95 \uce68\uc785\uc744 \ud0d0\uc9c0\ud558\uace0 \uacbd\uace0/\uae30\ub85d\ud558\ub294 \ub370 \uc911\uc810\uc744 \ub450\uba70, IPS\ub294 \ud0d0\uc9c0\uc640 \ub3d9\uc2dc\uc5d0 \uc798\ubabb\ub41c \ud1b5\uc2e0\uc744 \uc9c1\uc811 \ucc28\ub2e8\ud558\uace0 \ubc29\uc5b4\ud568"
