    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ub97c P2P \uae30\ubc18 \ubd84\uc0b0 \ub370\uc774\ud130 \uc800\uc7a5 \ud658\uacbd\uc5d0 \uc800\uc7a5\ud558\uc5ec \ubcc0\uacbd \uc2dc\ub9c8\ub2e4 \ub514\uc9c0\ud138 \uc11c\uba85\uc774 \uac31\uc2e0\ub418\uc5b4 \uc704\u00b7\ubcc0\uc870\uac00 \uac70\uc758 \ubd88\uac00\ub2a5\ud55c \ubcf4\uc548 \uae30\uc220\uc740?"
