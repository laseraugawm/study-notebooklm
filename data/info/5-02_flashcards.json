    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uacf5\uc7a5\uc18c \ubb34\uc120 \uacf5\uc720\uae30(Wi-Fi)\ub97c \uc554\ud638 \uc124\uc815 \uc5c6\uc774 \uc6b4\uc601\ud558\uac70\ub098 \uc0ac\uc6a9\ud560 \ub54c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \ubcf4\uc548 \uc704\ud611\uc740?"
