      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u3134. \ubcf8\uc778\uc758 \uc9c0\ubb38 \ubc0f \ud64d\ucc44 \ub370\uc774\ud130 (\uc2e0\uccb4\uc801 \uac1c\uc778 \uc815\ubcf4)"
