        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf4\uc548 \ud1a0\ud070, \uc2a4\ub9c8\ud2b8 \uce74\ub4dc, OTP \uce74\ub4dc, \uacf5\ub3d9 \uc778\uc99d\uc11c \ub4f1 \uc0ac\uc6a9\uc790\uac00 \uac00\uc9c0\uace0 \uc788\ub294 \uc18c\uc9c0\ud488\uc73c\ub85c \ud655\uc778\ud558\ub294 \uc778\uc99d \uae30\uc220\uc740?"
