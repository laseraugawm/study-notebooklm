    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uc778 \uc815\ubcf4\ub97c \uce68\ud574\ud558\ub294 \ud589\uc704\uc5d0 \ud574\ub2f9\ud558\ub294 \uac83\uc744 \uace0\ub974\uc2dc\uc624.\n\u3131. \ub3d9\uc544\ub9ac \ubc1c\ud45c \uacb0\uacfc \uacf5\uace0\ub97c \uc704\ud574 \ud68c\uc6d0 \uc804\uc6d0\uc758 \ud559\ubc88\uacfc \uc804\ud654\ubc88\ud638\ub97c \ubcf5\ub3c4\uc5d0 \uacf5\uac1c \uac1c\uc2dc\ud568\n\u3134. \uc124\ubb38 \uc870\uc0ac \uc2dc \ud559\uc0dd\ub4e4\uc758 \uc8fc\uc18c \ubc0f \uc5f0\ub77d\ucc98\ub97c \ub3d9\uc758 \uc5c6\uc774 \uc218\uc9d1\ud568"
