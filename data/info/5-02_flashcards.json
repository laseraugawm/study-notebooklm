    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\uc5d0\uc11c \ube44\ubc00\ubc88\ud638 \ub3c4\uc6a9 \uc704\ud5d8\uc744 \uc904\uc774\uae30 \uc704\ud574 \ub85c\uadf8\uc778 \uc2dc \uc2a4\ub9c8\ud2b8\ud3f0 \ub4f1\uc73c\ub85c \ucd94\uac00 \uc2b9\uc778 \uc808\ucc28\ub97c \uac70\uce58\ub294 \uc774\uc911 \ubcf4\uc548 \uccb4\uacc4\ub294?"
