        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\ud1b5 \uc2e0\ud638, \uac10\uc5fc\ubcd1 \uc815\ubcf4, \uac74\ucd95, \uad50\uc721 \ud589\uc815 \uc815\ubcf4 \ub4f1 \uacf5\uacf5\uc758 \uc774\uc775\uc744 \uc704\ud55c \ub370\uc774\ud130"
