    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ubb38, \ud64d\ucc44, \uc815\ub9e5, \uc5bc\uad74 \uc778\uc2dd \ub4f1 \uc2e0\uccb4\uc801 \ud2b9\uc9d5\uc744 \uc0ac\uc6a9\ud558\ub294 \uc778\uc99d \uae30\uc220\uc740?"
