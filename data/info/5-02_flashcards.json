    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\uc774\ub7ec\uc2a4 \ubc31\uc2e0 \ud504\ub85c\uadf8\ub7a8\uc774 \uc0c8\ub85c\uc6b4 \uc545\uc131 \ud30c\uc77c\uc774\ub098 \ubc14\uc774\ub7ec\uc2a4\ub97c \ud0d0\uc9c0\ud558\ub294 \uae30\ubcf8 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
