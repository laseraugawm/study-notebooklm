      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc874 \ubc14\uc774\ub7ec\uc2a4 \ud30c\uc77c\uc758 \ud2b9\uc9d5(\ud328\ud134)\uc744 \uc218\uc9d1\ud574 \ub370\uc774\ud130\ubca0\uc774\uc2a4\ud654\ud558\uace0 \uac80\uc0ac \ub300\uc0c1 \ud30c\uc77c\uc758 \ud2b9\uc9d5\uacfc \ud328\ud134\uc744 \ube44\uad50 \ud0d0\uc9c0\ud568"
