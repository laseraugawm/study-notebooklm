    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud68c\uadc0 \ubaa8\ub378\uc758 \uc801\ud569\ub3c4\ub97c \ub098\ud0c0\ub0b4\ub294 $R^2$(\uacb0\uc815\uacc4\uc218) \uc9c0\ud45c\ub294 \uc218\uce58\uac00 \uc5bc\ub9c8\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \uc131\ub2a5\uc774 \uc88b\uc740\uac00?"
