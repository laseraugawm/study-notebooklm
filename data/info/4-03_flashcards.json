    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc29\uc758 \uba74\uc801 \ubc0f \uac74\ubb3c \uc5f0\uc2dd \ub370\uc774\ud130\uc640 \uc2e4\uc81c \uc8fc\ud0dd \uac00\uaca9 \ub370\uc774\ud130\ub97c \ud568\uaed8 \ud559\uc2b5\uc2dc\ucf1c \uc0c8\ub85c\uc6b4 \uc9d1\uac12\uc744 \uc608\uce21\ud558\ub294 \ubaa8\ub378\uc740 \uc9c0\ub3c4\ud559\uc2b5 \uc911 \uc5b4\ub514\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
