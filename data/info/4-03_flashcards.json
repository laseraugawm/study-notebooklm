          {
            "type": "text",
            "content": "\uc624\ub80c\uc9c03\uc5d0\uc11c \ud559\uc2b5\uc5d0 \ud544\uc694 \uc5c6\uc5b4\uc11c \uc81c\uc678\ud558\ub824\ub294 \uceec\ub7fc\uc758 Role\uc740 \ubb34\uc5c7\uc73c\ub85c \uc9c0\uc815\ud574\uc57c \ud558\ub294\uac00?"
