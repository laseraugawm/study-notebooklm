      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ub7c9\uc758 \ub370\uc774\ud130\ub85c\ubd80\ud130 \uc2a4\uc2a4\ub85c \uaddc\uce59\uc744 \ucc3e\ub294 \uae30\uacc4\ud559\uc2b5 \ubc29\uc2dd"
