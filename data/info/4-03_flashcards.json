        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ud338 \uba54\uc77c \ubd84\ub958 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc5d0\uc11c '\uba54\uc77c\ud568\uc758 \ub2e4\uc591\ud55c \uba54\uc77c'\uc740 4\uac00\uc9c0 \uad6c\uc131 \uc694\uc18c \uc911 \uc5b4\ub514\uc5d0 \uc18d\ud558\ub294\uac00?"
