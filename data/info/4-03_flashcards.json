      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc758\ub8cc \uc601\uc0c1\uc5d0\uc11c \uc9c8\ud658 \uc9c4\ub2e8\ud558\uae30\ub098 \uc774\ubbf8\uc9c0\ub85c \uac1c/\uace0\uc591\uc774\ub97c \uad6c\ubd84\ud558\ub294 \uac83\ucc98\ub7fc \uaddc\uce59\uacfc \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\ub78c\uc774 \uba85\ud655\ud788 \uc791\uc131\ud558\uae30 \uc5b4\ub824\uc6b4 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub294 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
