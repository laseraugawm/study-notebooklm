    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud68c\uadc0 \ubaa8\ub378 \ud3c9\uac00 \uc9c0\ud45c\uc778 MSE, RMSE, MAE\ub294 \uc218\uce58\uac00 \uc5b4\ub5a0\ud560\uc218\ub85d \uc608\uce21 \ubaa8\ub378\uc774 \uc6b0\uc218\ud558\ub2e4\uace0 \ud3c9\uac00\ud558\ub294\uac00?"
