      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$x$\ucd95\uacfc $y$\ucd95\uc5d0 \uc218\ud3c9 \ub610\ub294 \uc218\uc9c1\ud55c \uc9c1\uc120 \ud615\ud0dc\uc758 \ubd84\ub958 \uacbd\uacc4\ub97c \uadf8\uc73c\uba70 \uacf5\uac04\uc744 \ubd84\ud560\ud55c\ub2e4."
