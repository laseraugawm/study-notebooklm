    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ubbf8\uc9c0 \ucc98\ub9ac \ubaa8\ub378 \uc785\ub825 \ub2e8\uacc4\uc5d0\uc11c `(image / 127.5) - 1` \uc5f0\uc0b0\uc744 \uc218\ud589\ud558\ub294 \uc8fc\ub41c \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00?"
