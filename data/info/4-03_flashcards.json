        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ud338 \uba54\uc77c \ubd84\ub958 \uc5d0\uc774\uc804\ud2b8\uac00 \ud0d0\uc9c0\ub41c \uc2a4\ud338 \uba54\uc77c\uc744 '\uc2a4\ud338 \uba54\uc77c\ud568\uc73c\ub85c \uc774\ub3d9'\uc2dc\ud0a4\ub294 \uac83\uc740 4\uac00\uc9c0 \uc694\uc18c \uc911 \uc5b4\ub514\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
