      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ub958 \uc815\ud655\ub3c4\ub97c \ub73b\ud558\uba70, \ubaa8\ub378\uc774 \uc785\ub825\ub41c \ub370\uc774\ud130\ub97c \uc5bc\ub9c8\ub098 \uc815\ud655\ud788 \uc815\ub2f5 \ud074\ub798\uc2a4\ub85c \ubd84\ub958\ud558\ub294\uc9c0 \ube44\uc728\ub85c \ub098\ud0c0\ub0b8 \uac12\uc774\ub2e4."
