    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub80c\uc9c03\uc5d0\uc11c \uc804\uccb4 \ub370\uc774\ud130\ub97c \ud6c8\ub828 \ub370\uc774\ud130(\uc608: 70%)\uc640 \ud14c\uc2a4\ud2b8 \ub370\uc774\ud130(\uc608: 30%)\ub85c \ubd84\ud560\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \uc704\uc82f\uc740 \ubb34\uc5c7\uc778\uac00?"
