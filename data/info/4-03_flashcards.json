    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud14d\uc2a4\ud2b8 \ucf54\ub529 \uc5c6\uc774 \uce94\ubc84\uc2a4\uc5d0 \uc704\uc82f\uc744 \ub4dc\ub798\uadf8 \uc564 \ub4dc\ub86d\ud558\uc5ec \uae30\uacc4\ud559\uc2b5 \ubc0f \ub370\uc774\ud130 \ubd84\uc11d\uc744 \uc218\ud589\ud560 \uc218 \uc788\ub294 \uc624\ud508\uc18c\uc2a4 \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
