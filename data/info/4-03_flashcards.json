        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub80c\uc9c03\uc758 File \uc704\uc82f \uc124\uc815\uc5d0\uc11c \uc608\uce21\uc758 \uae30\uc900\uc774 \ub418\ub294 \uc785\ub825 \ub370\uc774\ud130 \uceec\ub7fc\uc758 Role\uc744 \ubb34\uc5c7\uc73c\ub85c \uc9c0\uc815\ud558\ub294\uac00?"
