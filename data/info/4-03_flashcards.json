{
  "title": "\uae30\uacc4\ud559\uc2b5 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e8\uc21c \uc120\ud615 \ud68c\uadc0\uc640 \ub2e4\uc911 \uc120\ud615 \ud68c\uadc0\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e8\uc21c \uc120\ud615 \ud68c\uadc0\ub294 \ud558\ub098\uc758 \ud2b9\uc9d5\uc5d0 \ub530\ub978 \uacb0\uacfc\ub97c \uc608\uce21\ud558\uace0, \ub2e4\uc911 \uc120\ud615 \ud68c\uadc0\ub294 \ub450 \uac1c \uc774\uc0c1\uc758 \ud2b9\uc9d5\uc5d0 \ub530\ub978 \uacb0\uacfc\ub97c \uc608\uce21\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uacc4\ud559\uc2b5 \ubaa8\ub378 \uad6c\ucd95 \uc2dc '\ud6c8\ub828 \ub370\uc774\ud130'\uc640 '\ud14c\uc2a4\ud2b8 \ub370\uc774\ud130'\uc758 \uc5ed\ud560 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud6c8\ub828 \ub370\uc774\ud130\ub294 \ubaa8\ub378\uc758 \ud559\uc2b5\uc5d0 \uc0ac\uc6a9\ub418\ub294 \ub370\uc774\ud130\uc774\uba70, \ud14c\uc2a4\ud2b8 \ub370\uc774\ud130\ub294 \ud559\uc2b5\uc744 \ub9c8\uce5c \ubaa8\ub378\uc758 \uc608\uce21 \uc131\ub2a5\uc744 \ud3c9\uac00\ud558\ub294 \ub370 \uc0ac\uc6a9\ub418\ub294 \ub370\uc774\ud130\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ub3c4\ud559\uc2b5\uc758 \ubd84\ub958 \ubb38\uc81c\uc5d0\uc11c \ud2b9\uc815 \uc785\ub825 \ub370\uc774\ud130\uac00 \uc18d\ud558\ub294 \ubc94\uc8fc(\ud074\ub798\uc2a4) \uac12\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ubd80\ub974\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub808\uc774\ube14(Label)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud68c\uadc0 \ubaa8\ub378\uacfc \ubd84\ub958 \ubaa8\ub378\uc774 \ucd9c\ub825\ud558\ub294 \uc608\uce21 \uacb0\uacfc\uc758 \ud615\ud0dc \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud68c\uadc0 \ubaa8\ub378\uc740 \uc131\uc801 \uc810\uc218\ub098 \uae30\uc628\uacfc \uac19\uc740 \uc5f0\uc18d\uc801\uc778 \uc218\uce58\ud615 \ub370\uc774\ud130\ub97c \uc608\uce21\ud558\uace0, \ubd84\ub958 \ubaa8\ub378\uc740 \ud569\uaca9/\ubd88\ud569\uaca9\uc774\ub098 \ud3ad\uadc4 \uc885\uacfc \uac19\uc740 \ubc94\uc8fc\ud615 \ub370\uc774\ud130\ub97c \uc608\uce21\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b8\ub9ac \uad6c\uc870\ub97c \uae30\ubc18\uc73c\ub85c \uac01 \ubd84\uae30\ub9c8\ub2e4 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \ubd84\ub958 \uae30\uc900\uc744 \ub9cc\ub4e4\uc5b4 \ub370\uc774\ud130\ub97c \ubd84\ub958\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacb0\uc815\ud2b8\ub9ac(Decision Tree)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacb0\uc815\ud2b8\ub9ac \uc54c\uace0\ub9ac\uc998\uc5d0\uc11c \ud2b8\ub9ac\uc758 \uae4a\uc774\uac00 \uc9c0\ub098\uce58\uac8c \uae4a\uc5b4\uc9c8 \ub54c \ubc1c\uc0dd\ud558\ub294 \ubb38\uc81c\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ub958 \uae30\uc900\uc774 \ub108\ubb34 \ub9ce\uc544\uc838 \uc0c8\ub85c\uc6b4 \ub370\uc774\ud130\uc5d0 \ub300\ud55c \uc608\uce21 \uc131\ub2a5\uc774 \uc624\ud788\ub824 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacb0\uc815\ud2b8\ub9ac \uc54c\uace0\ub9ac\uc998\uc740 \ubd84\ub958 \ubb38\uc81c\uc640 \ud68c\uadc0 \ubb38\uc81c \uc911 \uc5b4\ub290 \ubd84\uc57c\uc5d0 \uc801\uc6a9 \uac00\ub2a5\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ub958 \ubb38\uc81c\uc640 \ud68c\uadc0 \ubb38\uc81c \ubaa8\ub450\uc5d0 \uc801\uc6a9\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba85\uce6d\uc5d0 '\ud68c\uadc0'\uac00 \ub4e4\uc5b4\uac00\uc9c0\ub9cc \uc2e4\uc81c\ub85c\ub294 \ub370\uc774\ud130\ub97c $0$\uacfc $1$ \uc0ac\uc774\uc758 \ud655\ub960\uac12\uc73c\ub85c \uc608\uce21\ud558\uc5ec \ud074\ub798\uc2a4\ub97c \uad6c\ubcc4\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc120\ud615 \ubd84\ub958 \ubaa8\ub378\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\uc9c0\uc2a4\ud2f1 \ud68c\uadc0(Logistic Regression)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\uc9c0\uc2a4\ud2f1 \ud68c\uadc0 \ubaa8\ub378\uc5d0\uc11c \uc608\uce21\ub41c \ud655\ub960\uac12\uc744 \ubc14\ud0d5\uc73c\ub85c \uc774\uc9c4 \ubd84\ub958\ub97c \uc218\ud589\ud560 \ub54c \uc8fc\ub85c \uc0ac\uc6a9\ub418\ub294 \uae30\uc900\uac12\uc740 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$0.5$ (\ud655\ub960\uc774 $0.5$ \uc774\uc0c1\uc774\uba74 \uac00\ub2a5\uc131\uc774 \ub354 \ub192\uc740 \ud074\ub798\uc2a4\ub85c \ubd84\ub958)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c8\ub85c\uc6b4 \ub370\uc774\ud130\uac00 \uc785\ub825\ub418\uc5c8\uc744 \ub54c \uac00\uc7a5 \uac00\uae4c\uc6b4 $k$\uac1c\uc758 \uc774\uc6c3 \ub370\uc774\ud130 \ud074\ub798\uc2a4\ub97c \ud655\uc778\ud558\uace0 \ub2e4\uc218\uacb0\ub85c \ubd84\ub958\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "k-\ucd5c\uadfc\uc811 \uc774\uc6c3(kNN, k-Nearest Neighbor) \uc54c\uace0\ub9ac\uc998"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \uc810 $P_1(1,1)$\uacfc $P_2(5,4)$ \uc0ac\uc774\uc758 \uc720\ud074\ub9ac\ub514\uc548 \uac70\ub9ac\uc640 \ub9e8\ud558\ud2bc \uac70\ub9ac\ub294 \uac01\uac01 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\ud074\ub9ac\ub514\uc548 \uac70\ub9ac\ub294 $5$\uc774\uba70, \ub9e8\ud558\ud2bc \uac70\ub9ac\ub294 $7$\uc774\ub2e4. (\uc720\ud074\ub9ac\ub514\uc548: $\\sqrt{(5-1)^2 + (4-1)^2} = 5$, \ub9e8\ud558\ud2bc: $|5-1| + |4-1| = 7$)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "kNN\uc774\ub098 \ub85c\uc9c0\uc2a4\ud2f1 \ud68c\uadc0\uc640 \uac19\uc740 \uac70\ub9ac \uae30\ubc18 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud558\uae30 \uc804\uc5d0 \ub370\uc774\ud130 \uc18d\uc131 \uac04 \uc2a4\ucf00\uc77c\uc744 \ub9de\ucd94\uae30 \uc704\ud574 \uc218\ud589\ud574\uc57c \ud558\ub294 \uc804\ucc98\ub9ac \uc791\uc5c5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130 \uc815\uaddc\ud654(Normalization)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ub78c\uc758 \ub1cc \uc2e0\uacbd\uacc4\uc5d0\uc11c \uc218\ub9ce\uc740 \ub274\ub7f0\uc774 \uc2e0\ud638\ub97c \uc8fc\uace0\ubc1b\ub294 \ubc29\uc2dd\uc744 \ubaa8\ubc29\ud55c \uae30\uacc4\ud559\uc2b5 \ubaa8\ub378\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5 \uc2e0\uacbd\ub9dd(ANN)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5 \uc2e0\uacbd\ub9dd\uc758 \uc5f0\uacb0\uc774 \uae4a\uc5b4\uc838 \ub354\uc6b1 \ubcf5\uc7a1\ud55c \ubb38\uc81c\ub97c \ud574\uacb0\ud560 \uc218 \uc788\ub3c4\ub85d \ubc1c\uc804\ud55c \ubaa8\ub378\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2ec\uce35 \uc2e0\uacbd\ub9dd(DNN)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ub2f5(\ub808\uc774\ube14)\uc774 \uc5c6\ub294 \ub370\uc774\ud130\uc758 \ud2b9\uc9d5\uc744 \ubd84\uc11d\ud558\uc5ec \uc720\uc0ac\ud55c \ud2b9\uc131\uc744 \uac00\uc9c4 \ub370\uc774\ud130\ub07c\ub9ac \uadf8\ub8f9\ud654\ud558\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5 \uae30\ubc95\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad70\uc9d1\ud654(Clustering)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad70\uc9d1\ud654(Clustering)\ub97c \uc218\ud589\ud560 \ub54c \ubc14\ub78c\uc9c1\ud55c \uad70\uc9d1 \ubd84\ud560\uc758 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac19\uc740 \uad70\uc9d1\uc5d0 \uc18d\ud558\ub294 \ub370\uc774\ud130 \uac04 \uc720\uc0ac\uc131\uc740 \ub192\uace0, \uc11c\ub85c \ub2e4\ub978 \uad70\uc9d1\uc5d0 \uc18d\ud558\ub294 \ub370\uc774\ud130 \uac04 \ucc28\uc774\ub294 \ud06c\uac8c \ub098\ub3c4\ub85d \ubd84\ud560\ud558\ub294 \uac83\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ub3c4\ud559\uc2b5\uc758 '\ubd84\ub958'\uc640 \ube44\uc9c0\ub3c4\ud559\uc2b5\uc758 '\uad70\uc9d1\ud654'\uc758 \uc8fc\ub41c \ubaa9\uc801 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ub958\ub294 \uc785\ub825 \ub370\uc774\ud130\uc758 \ubc94\uc8fc(\uc885\ub958)\ub97c \ud310\ubcc4\ud558\ub294 \uac83\uc774 \ubaa9\uc801\uc774\uace0, \uad70\uc9d1\ud654\ub294 \ud615\uc131\ub41c \uadf8\ub8f9\uc758 \uc815\ubcf4\ub97c \ud574\uc11d\ud558\uace0 \ud65c\uc6a9\ud558\ub294 \uac83\uc774 \ubaa9\uc801\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\uc5b4\uc9c4 \ub370\uc774\ud130\ub97c $K$\uac1c\uc758 \uad70\uc9d1\uc73c\ub85c \ubb36\uace0, \uac01 \uad70\uc9d1\uc758 \uc911\uc2ec\uc810 \uc704\uce58\ub97c \uc18d\ud55c \ub370\uc774\ud130\ub4e4\uc758 \ud3c9\uade0\uc73c\ub85c \uac31\uc2e0\ud574 \ub098\uac00\ub294 \ube44\uc9c0\ub3c4\ud559\uc2b5 \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "K-\ud3c9\uade0(K-means) \uad70\uc9d1\ud654 \uc54c\uace0\ub9ac\uc998"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "K-\ud3c9\uade0 \uad70\uc9d1\ud654 \uc54c\uace0\ub9ac\uc998\uc5d0\uc11c \uad70\uc9d1\ud654\uc758 \uc131\ub2a5\uc774 \uc88b\ub2e4\uace0 \ud310\ub2e8\ud558\ub294 \uac70\ub9ac\uc758 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad70\uc9d1 \uc548\uc758 \ub370\uc774\ud130\uc640 \ud574\ub2f9 \uad70\uc9d1 \uc911\uc2ec\uc810 \uc0ac\uc774\uc758 \uac70\ub9ac\uac00 \uac00\uae4c\uc6b8\uc218\ub85d \uc6b0\uc218\ud558\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac70\ub798 \ub370\uc774\ud130 \ub4f1\uc5d0\uc11c \uad6c\ub9e4 \ud56d\ubaa9 \uc0ac\uc774\uc758 \uad00\ub828\uc131\uc744 \ubd84\uc11d\ud558\uc5ec '\uc6b0\uc720\ub97c \uad6c\ub9e4\ud558\uba74 \uc2dd\ube75\ub3c4 \uad6c\ub9e4\ud55c\ub2e4'\uc640 \uac19\uc740 \uaddc\uce59\uc744 \ubc1c\uacac\ud558\ub294 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uad00 \uaddc\uce59(Association Rules)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uacc4\ud559\uc2b5\uc744 \uc774\uc6a9\ud55c \ubb38\uc81c \ud574\uacb0 \uacfc\uc815 4\ub2e8\uacc4\ub97c \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "[\ubb38\uc81c \uc815\uc758\ud558\uae30] $\\rightarrow$ [\ub370\uc774\ud130 \uc218\uc9d1 \ubc0f \uc804\ucc98\ub9ac\ud558\uae30] $\\rightarrow$ [\ubaa8\ub378 \uc120\uc815 \ubc0f \ud559\uc2b5\ud558\uae30] $\\rightarrow$ [\ubaa8\ub378 \ud3c9\uac00\ud558\uae30]"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uacc4\ud559\uc2b5 \uad6c\ud604 \uacfc\uc815 \uc911 '\ub2e8\uacc41 \ubb38\uc81c \uc815\uc758\ud558\uae30'\uc5d0\uc11c \uc218\ud589\ud558\ub294 \uc8fc\ub41c \ud65c\ub3d9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uacb0\ud560 \ubb38\uc81c\ub97c \ubc1c\uacac\ud558\uace0 \uba85\ud655\ud788 \ud55c \ud6c4, \uae30\uacc4\ud559\uc2b5\uc73c\ub85c \ud574\uacb0\ud560 \uc218 \uc788\ub294 \ubb38\uc81c\uc778\uc9c0 \ud310\ub2e8\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uacc4\ud559\uc2b5 \uad6c\ud604 \uacfc\uc815 \uc911 '\ub2e8\uacc42 \ub370\uc774\ud130 \uc218\uc9d1 \ubc0f \uc804\ucc98\ub9ac\ud558\uae30'\uc5d0\uc11c \uc804\ucc98\ub9ac\ub97c \uc218\ud589\ud558\ub294 \ud575\uc2ec \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\uc758 \uacb0\uce21\uce58\ub098 \uc774\uc0c1\uce58\ub97c \ucc98\ub9ac\ud558\uc5ec \uae30\uacc4\ud559\uc2b5 \ubaa8\ub378 \ud559\uc2b5\uc5d0 \uc801\ud569\ud55c \ud615\ud0dc\ub85c \uac00\uacf5\ud558\uae30 \uc704\ud574\uc11c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccb4\uc9c8\ub7c9 \uc9c0\uc218(BMI) \uad6c\ud558\uae30\uc640 \uac19\uc774 \uba85\ud655\ud55c \uc218\ud559\uc801 \uc218\uc2dd\uc774\ub098 \ub2e8\uc21c \uaddc\uce59\uc774 \uc874\uc7ac\ud558\ub294 \ubb38\uc81c\ub97c \ud574\uacb0\ud560 \ub54c \ud6a8\uc728\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\ud1b5\uc801\uc778 \ud504\ub85c\uadf8\ub798\ubc0d \ubc29\ubc95"
