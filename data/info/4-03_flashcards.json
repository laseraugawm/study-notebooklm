    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacb0\uc815\ud2b8\ub9ac \ubaa8\ub378\uc774 $2$\ucc28\uc6d0 \uc18d\uc131 \uacf5\uac04\uc5d0\uc11c \ud074\ub798\uc2a4\ub97c \uad6c\ubd84\ud558\uae30 \uc704\ud574 \uacbd\uacc4\ub97c \ud615\uc131\ud560 \ub54c \ub098\ud0c0\ub098\ub294 \uae30\ud558\ud559\uc801 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
