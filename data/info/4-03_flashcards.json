    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub80c\uc9c03\uc5d0\uc11c \uacb0\uc815\ud2b8\ub9ac\ub85c \ud559\uc2b5\ub41c \ubd84\ub958 \ubaa8\ub378\uc758 \ud2b8\ub9ac \uad6c\uc870\uc640 \uae30\uc900 \uc18d\uc131\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \ud30c\uc545\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \uc704\uc82f\uc740 \ubb34\uc5c7\uc778\uac00?"
