      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\ub2f9 \ub370\uc774\ud130\ub97c \uad6c\ubd84\ud558\uace0 \ubd84\ub958\ud558\ub294 \ub370 \uac00\uc7a5 \uacb0\uc815\uc801\uc774\uace0 \uc601\ud5a5\ub825\uc774 \ud070 \ud2b9\uc9d5\uc784\uc744 \uc758\ubbf8\ud55c\ub2e4."
