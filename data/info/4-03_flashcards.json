    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ub958 \ubaa8\ub378\uc758 \ub300\ud45c\uc801\uc778 \uc131\ub2a5 \ud3c9\uac00 \uc9c0\ud45c\uc778 CA(Classification Accuracy)\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
