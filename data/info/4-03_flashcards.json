      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad70\uc9d1\ud654\ub294 \uc815\ub2f5(\ub808\uc774\ube14)\uc774 \ubd80\uc5ec\ub418\uc9c0 \uc54a\uc740 \uc0c1\ud0dc\uc5d0\uc11c \ud2b9\uc9d5\uc758 \uc720\uc0ac\uc131\ub9cc\uc73c\ub85c \ubb36\uc740 \uac83\uc774\ubbc0\ub85c \uacb0\uacfc \uc815\ubcf4\ub97c \ud574\uc11d\ud558\uace0 \ud65c\uc6a9\ud558\ub294 \uac83\uc774 \ubaa9\uc801\uc774\uae30 \ub54c\ubb38\uc774\ub2e4."
