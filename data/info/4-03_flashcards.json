    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacb0\uc815\ud2b8\ub9ac\uc758 Tree Viewer \uc2dc\uac01\ud654 \uacb0\uacfc\uc5d0\uc11c \ucd5c\uc0c1\ub2e8 \ub8e8\ud2b8 \ub178\ub4dc\uc5d0 \ub193\uc778 \ud2b9\uc9d5\uc774 \uc758\ubbf8\ud558\ub294 \ubc14\ub294 \ubb34\uc5c7\uc778\uac00?"
