    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\ub80c\uc9c03\uc758 File \uc704\uc82f\uc5d0\uc11c \ubaa8\ub378\uc774 \ucd5c\uc885 \uc608\uce21\ud574\uc57c \ud558\ub294 \ub808\uc774\ube14 \uceec\ub7fc\uc758 Role\uc744 \ubb34\uc5c7\uc73c\ub85c \uc9c0\uc815\ud558\ub294\uac00?"
