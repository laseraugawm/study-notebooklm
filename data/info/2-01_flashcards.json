{
  "title": "\ub514\uc9c0\ud138\ub370\uc774\ud130 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ub370\uc774\ud130 \uc555\ucd95(Data Compression)\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uc815\ub41c \uc800\uc7a5 \uacf5\uac04\uc5d0 \ub370\uc774\ud130\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uae30\ub85d\ud558\uae30 \uc704\ud574 \ub370\uc774\ud130\ub97c \ub354 \uc801\uc740 \uc218\uc758 \ube44\ud2b8\ub85c \ud45c\ud604\ud558\ub294 \uae30\uc220\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ub97c \uc555\ucd95\ud560 \ub54c \uc5bb\uc744 \uc218 \uc788\ub294 \ucef4\ud4e8\ud305 \uc790\uc6d0\uc758 \uc8fc\uc694 \ud6a8\uc728\uc131 \uc774\uc810 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\uc7a5 \uacf5\uac04\uc758 \uc808\uc57d\uacfc \ub124\ud2b8\uc6cc\ud06c \uc804\uc1a1 \uc2dc\uac04\uc758 \ub2e8\ucd95\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub514\uc9c0\ud138 \ub370\uc774\ud130 \uc555\ucd95 \ubc0f \ubcf5\uc6d0 \uacfc\uc815\uc5d0\uc11c \ub370\uc774\ud130\ub97c \ucd95\uc18c \ud615\ud0dc\ub85c \ubc14\uafb8\ub294 \uacfc\uc815\uacfc \uc6d0\ub798 \ud615\ud0dc\ub85c \ub418\ub3cc\ub9ac\ub294 \uacfc\uc815\uc758 \uba85\uce6d\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd95\uc18c\ud558\ub294 \uacfc\uc815\uc740 \uc778\ucf54\ub529(Encoding, \ubd80\ud638\ud654), \uc6d0\ub798 \ud615\ud0dc\ub85c \ub418\ub3cc\ub9ac\ub294 \uacfc\uc815\uc740 \ub514\ucf54\ub529(Decoding, \ubcf5\ud638\ud654)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130 \uc555\ucd95 \ubc29\uc2dd\uc740 \uc778\ucf54\ub529 \uacfc\uc815\uc5d0\uc11c \ubb34\uc5c7\uc758 \ubc1c\uc0dd \uc5ec\ubd80\uc5d0 \ub530\ub77c \uc190\uc2e4 \uc555\ucd95\uacfc \ube44\uc190\uc2e4 \uc555\ucd95\uc73c\ub85c \uad6c\ubd84\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\uc758 \uc720\uc2e4 \uc5ec\ubd80\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc190\uc2e4 \uc555\ucd95(Lossless Compression)\uacfc \uc190\uc2e4 \uc555\ucd95(Lossy Compression)\uc758 \ud575\uc2ec \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc555\ucd95 \ud6c4 \ubcf5\uc6d0\ud588\uc744 \ub54c \ube44\uc190\uc2e4 \uc555\ucd95\uc740 \uc785\ub825 \ub370\uc774\ud130\uc640 \ucd9c\ub825 \ub370\uc774\ud130\uac00 \uc644\ubcbd\ud788 \uac19\uc9c0\ub9cc, \uc190\uc2e4 \uc555\ucd95\uc740 \uc11c\ub85c \ub2e4\ub974\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uc5f4 \ub370\uc774\ud130 \uc555\ucd95\uc5d0\ub294 \uc8fc\ub85c \uc5b4\ub5a4 \uc555\ucd95 \ubc29\uc2dd \uc720\ud615\uc774 \uc0ac\uc6a9\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc190\uc2e4 \uc555\ucd95 \ubc29\uc2dd\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ub78c\uc774 \uc0ac\uc6a9\ud558\ub294 \ubb38\uc790\ub97c \ucef4\ud4e8\ud130\uac00 \uc774\ud574\ud558\ub294 \ucf54\ub4dc\ub85c \ud45c\ud604\ud55c \uac83\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790 \uc9d1\ud569(Character Set, \uc608: \uc544\uc2a4\ud0a4\ucf54\ub4dc, \uc720\ub2c8\ucf54\ub4dc)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub7f0-\ub81d\uc2a4(Run-Length) \uc778\ucf54\ub529 \uc54c\uace0\ub9ac\uc998\uc758 \uae30\ubcf8\uc801\uc778 \uc555\ucd95 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc18d\ud574\uc11c \ubc18\ubcf5\ub418\ub294 \uac19\uc740 \ubb38\uc790\ub97c '\ubc18\ubcf5 \ubb38\uc790 \uac1c\uc218'\uc640 '\ubc18\ubcf5 \ubb38\uc790'\uc758 \uc30d\uc73c\ub85c \ud45c\ud604\ud558\uc5ec \uc555\ucd95\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub7f0-\ub81d\uc2a4 \uc778\ucf54\ub529\uc774 \uac00\uc7a5 \ub192\uc740 \uc555\ucd95 \ud6a8\uc728\uc744 \ub098\ud0c0\ub0b4\ub294 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc77c\ud55c \ubb38\uc790\uac00 \uc5f0\uc18d\ud574\uc11c \uae38\uac8c \ubc18\ubcf5\ub420 \ub54c\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub7f0-\ub81d\uc2a4 \uc778\ucf54\ub529\uc5d0\uc11c \ubc18\ubcf5\ub418\uc9c0 \uc54a\ub294 \ubb38\uc790\ub97c \uc555\ucd95\ud560 \ub54c \ud6a8\uc728\uc744 \ub354 \ub192\uc774\uae30 \uc704\ud574 \uc801\uc6a9\ud558\ub294 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc18\ubcf5 \ubb38\uc790 \uac1c\uc218\uc778 1\uc744 \uc0dd\ub7b5\ud558\uc5ec \ubb38\uc790\uc758 \uac2f\uc218\ub97c \ud45c\uae30\ud558\uc9c0 \uc54a\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\ubcf8 \ubb38\uc790\uc5f4\uc5d0 \uc22b\uc790\uac00 \uc774\ubbf8 \ud3ec\ud568\ub418\uc5b4 \uc788\ub294 \uacbd\uc6b0, \ub7f0-\ub81d\uc2a4 \uc778\ucf54\ub529 \uc2dc \ubc18\ubcf5 \uac1c\uc218\uc640 \uad6c\ubd84\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ub418\ub294 \ubb38\uc790\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd9c\ud604 \ube48\ub3c4\uac00 \uc801\uc740 \ubb38\uc790\ub97c \ud0c8\ucd9c \ubb38\uc790(\uc608: '*'))\ub85c \ud65c\uc6a9\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub818\ud3a0-\uc9c0\ube0c(Lempel-Ziv) \uc778\ucf54\ub529 \uc54c\uace0\ub9ac\uc998\uc758 \uc8fc\uc694 \uc555\ucd95 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb38\uc790\uc5f4\uc5d0 \ud3ec\ud568\ub41c \uac19\uc740 \ud328\ud134\uc758 \uc0c1\ub300\uc801 \uc704\uce58\uc640 \ud328\ud134\uc758 \uae38\uc774\ub97c \uc774\uc6a9\ud558\uc5ec \uce58\ud658\ud568\uc73c\ub85c\uc368 \uc555\ucd95\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub818\ud3a0-\uc9c0\ube0c \uc778\ucf54\ub529\uc774 \ub7f0-\ub81d\uc2a4 \uc778\ucf54\ub529\uc5d0 \ube44\ud574 \uac16\ub294 \ucc28\ubcc4\ud654\ub41c \uc7a5\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\ub85c \ub5a8\uc5b4\uc838 \uc788\ub294 \uac19\uc740 \ud328\ud134\ub3c4 \ucc3e\uc544\ub0b4\uc5b4 \uc555\ucd95\ud560 \uc218 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\ud2b8\ub9f5 \uc774\ubbf8\uc9c0(Bitmap Image)\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc18c(\ud53d\uc140)\ub4e4\uc774 \ubaa8\uc5ec\uc11c \ud558\ub098\uc758 \uc774\ubbf8\uc9c0\ub97c \uad6c\uc131\ud558\ub294 \ubc29\uc2dd\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucef4\ud4e8\ud130\uc5d0\uc11c \uc774\ubbf8\uc9c0\ub97c \uad6c\uc131\ud558\ub294 \ucd5c\uc19f\uac12\uc758 \uae30\ubcf8 \ub2e8\uc704\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc18c(Pixel, \ud53d\uc140)\ub77c\uace0 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc18c \ud558\ub098\uc5d0 $n$\ube44\ud2b8\uc758 \uc0c9 \uc815\ubcf4\uac00 \ud560\ub2f9\ub420 \ub54c \ud45c\ud604\ud560 \uc218 \uc788\ub294 \ucd5c\ub300 \uc0c9\uc0c1 \uc218\ub294 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$2^n$\uac00\uc9c0 \uc0c9\uc0c1\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "8\ube44\ud2b8 \uc0c9 \uc815\ubcf4\uac00 \ud560\ub2f9\ub41c \ud654\uc18c\uac00 \ud45c\ud604 \uac00\ub2a5\ud55c \uc0c9\uc0c1 \uc218\ub294 \uba87 \uac00\uc9c0\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$2^8 = 256$\uac00\uc9c0 \uc0c9\uc0c1\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "24\ube44\ud2b8 RGB \ud2b8\ub8e8 \uceec\ub7ec\uac00 \ud45c\ud604 \uac00\ub2a5\ud55c \uc0c9\uc0c1 \uc218\ub294 \uba87 \uac00\uc9c0\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$2^{24} = 16,777,216$\uac00\uc9c0 \uc0c9\uc0c1\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "BMP \ud30c\uc77c \ud615\uc2dd\uc758 \uc8fc\uc694 \ud2b9\uc9d5\uacfc \ub2e8\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc555\ucd95 \ud30c\uc77c \ud615\uc2dd\uc73c\ub85c \ud654\uc9c8\uc740 \ub9e4\uc6b0 \uc6b0\uc218\ud558\uc9c0\ub9cc, \ud30c\uc77c \uc6a9\ub7c9\uc774 \ucee4\uc11c \uc800\uc7a5 \uacf5\uac04\uc744 \ub9ce\uc774 \ucc28\uc9c0\ud558\uace0 \uc778\ud130\ub137 \uacf5\uc720\uac00 \uc5b4\ub835\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "PNG \uc774\ubbf8\uc9c0 \ud30c\uc77c \ud615\uc2dd\uc758 \uc555\ucd95 \ubc29\uc2dd\uacfc \uc8fc\uc694 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc190\uc2e4 \uc555\ucd95 \ubc29\uc2dd\uc744 \uc0ac\uc6a9\ud558\uba70 24\ube44\ud2b8 \ud2b8\ub8e8 \uceec\ub7ec\ub97c \uc9c0\uc6d0\ud558\uc5ec \uc774\ubbf8\uc9c0 \uc190\uc2e4 \uc5c6\uc774 \uace0\ud488\uc9c8 \uc774\ubbf8\uc9c0 \ucc98\ub9ac\uac00 \uac00\ub2a5\ud558\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "GIF \uc774\ubbf8\uc9c0 \ud30c\uc77c \ud615\uc2dd\uc758 \uc0c9\uc0c1 \uc9c0\uc6d0 \ubc94\uc704\uc640 \uc81c\ud55c\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "8\ube44\ud2b8(256\uc0c9)\ub97c \uc9c0\uc6d0\ud558\uba70, 256\uc0c9 \uc774\uc0c1\uc758 \uc774\ubbf8\uc9c0\ub97c \uc555\ucd95\ud560 \ub54c\ub294 \uc9c0\uc6d0 \uac00\ub2a5 \uc0c9\uc73c\ub85c \ubcc0\ud658\ub418\uc5b4 \uc774\ubbf8\uc9c0 \uc190\uc2e4\uc774 \uc77c\uc5b4\ub09c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "JPEG \uc774\ubbf8\uc9c0 \ud30c\uc77c \ud615\uc2dd\uc740 \uc5b4\ub5a4 \uc6d0\ub9ac\ub85c \uc774\ubbf8\uc9c0 \uc6a9\ub7c9\uc744 \uc904\uc774\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc190\uc2e4 \uc555\ucd95 \ubc29\uc2dd\uc73c\ub85c, \uc0ac\ub78c\uc758 \ub208\uc774 \uc778\uc2dd\ud558\uc9c0 \ubabb\ud558\ub294 \ubc94\uc704\uc758 \uc0c9 \ucc28\uc774\uc640 \uc138\ubc00\ud55c \ubd80\ubd84\uc758 \uc815\ubcf4\ub4e4\uc744 \uc81c\uac70\ud558\uc5ec \ud06c\uae30\ub97c \uc904\uc778\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud45c\uc801\uc778 \uc774\ubbf8\uc9c0 \uc555\ucd95 \ud30c\uc77c(PNG, GIF, JPEG) \uc911 \uc6a9\ub7c9\uc774 \uac00\uc7a5 \uc791\uace0 \uc555\ucd95\ub960\uc774 \uac00\uc7a5 \ub192\uc740 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "JPEG \ud615\uc2dd\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucef4\ud4e8\ud130\uac00 \uc9c4\ub3d9\uc73c\ub85c \ub9cc\ub4e4\uc5b4\uc9c4 \uc544\ub0a0\ub85c\uadf8 \uc18c\ub9ac \uc2e0\ud638\ub97c \ub514\uc9c0\ud138\ub85c \ubcc0\ud658\ud558\ub294 \ud45c\ud604 \ubc29\uc2dd\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6e8\uc774\ube0c(Wave) \ubc29\uc2dd\uc774\ub77c\uace0 \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub0a0\ub85c\uadf8 \uc18c\ub9ac \uc2e0\ud638\uac00 \ub514\uc9c0\ud138\uac12\uc73c\ub85c \ubcc0\ud658\ub418\ub294 3\uac00\uc9c0 \ub2e8\uacc4\ub294 \uc21c\uc11c\ub300\ub85c \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud45c\ubcf8\ud654(Sampling) $\\rightarrow$ \uc591\uc790\ud654(Quantization) $\\rightarrow$ \ubd80\ud638\ud654(Encoding) \uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ub9ac \ubcc0\ud658 \uacfc\uc815 \uc911 \ud45c\ubcf8\ud654(Sampling)\uc758 \uac1c\ub150\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub0a0\ub85c\uadf8 \uc18c\ub9ac \ud30c\ud615\uc744 \uc77c\uc815 \uc2dc\uac04 \uac04\uaca9\uc73c\ub85c \ub098\ub204\uc5b4 \uc0d8\ud50c \uc2e0\ud638\uc758 \uac12\uc744 \uce21\uc815\ud558\ub294 \ub2e8\uacc4\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
