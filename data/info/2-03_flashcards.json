      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2462 CSV \ud30c\uc77c (\uace0\uc815\ub41c \ud589\uacfc \uc5f4 \uad6c\ubd84 \uad6c\uc870\ub97c \uac00\uc9d0)"
