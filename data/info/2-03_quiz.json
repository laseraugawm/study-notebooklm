        }
      ],
      "hint": "\uc778\ud130\ub137 \ud45c\uc900\uc73c\ub85c \ub110\ub9ac \uc0c1\uc6a9\ub418\uba70 \ub2e4\uad6d\uc5b4 \ubb38\uc790\ub97c \uc9c0\uc6d0\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc778\ucf54\ub529 \ud615\ud0dc\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ube45\ub370\uc774\ud130 \ubd84\uc11d\uc5d0\uc11c \ucd94\uc138\ub97c \uc608\uce21\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 '\ucd5c\uc18c \uc81c\uacf1\uc120'\uacfc \uacb0\uc815\uacc4\uc218($r^2$)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc62c\ubc14\ub974\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucd5c\uc18c \uc81c\uacf1\uc120\uc758 \uacb0\uc815\uacc4\uc218 $r^2$ \uac12\uc774 $0$\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \uc120\ud615 \ucd94\uc138\uc120\uc774 \uc2e4\uc81c \uad00\uce21 \ub370\uc774\ud130\ub97c \ub9e4\uc6b0 \uc798 \uc124\uba85\ud55c\ub2e4\ub294 \uc758\ubbf8\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uacb0\uc815\uacc4\uc218 $r^2$ \uac12\uc774 $1$\uc5d0 \uac00\uae4c\uc6b8\uc218\ub85d \ucd94\uc138\uc120\uc774 \ub370\uc774\ud130\ub97c \uc798 \ud45c\ud604\ud558\uace0 \uc124\uba85\ud558\ub294 \uac83\uc774\uba70, $0$\uc5d0 \uac00\uae4c\uc6b0\uba74 \uc5f0\uad00\uc131\uc774\ub098 \uc124\uba85\ub825\uc774 \ub0ae\ub2e4."
        },
        {
          "text": "\uc2e4\uc138\uacc4\uc5d0\uc11c \uc218\uc9d1\ud55c \uad00\uce21 \ub370\uc774\ud130\uc758 \uacbd\uc6b0 \uacb0\uc815\uacc4\uc218 $r^2$ \uac12\uc774 $0.4$ \uc774\uc0c1\uc774\uba74 \uc720\uc758\ubbf8\ud55c \uc5f0\uad00\uc131\uc774 \uc788\ub2e4\uace0 \ubcf8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e4\uc591\ud55c \ubcc0\uc218\uac00 \uc874\uc7ac\ud558\ub294 \uc2e4\uc138\uacc4 \ub370\uc774\ud130\ub294 $r^2$ \uc218\uce58\uac00 $0.4$ \uc774\uc0c1\uc77c \ub54c \uc720\uc758\ubbf8\ud55c \uad00\uacc4\uac00 \uc788\ub2e4\uace0 \ud574\uc11d\ud55c\ub2e4."
        },
        {
          "text": "\ucd5c\uc18c \uc81c\uacf1\uc120\uc740 \uac01\uac01\uc758 \ub370\uc774\ud130 \uc9c0\uc810\uacfc \uc120 \uc0ac\uc774\uc758 \uc624\ucc28 \uc81c\uacf1\uc758 \ud569\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \ubc29\uc2dd\uc73c\ub85c \uad6c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad00\uce21\uac12\uacfc \uc608\uce21\uac12\uc758 \ucc28\uc774(\uc624\ucc28)\ub97c \uc81c\uacf1\ud55c \ud569\uc744 \ucd5c\uc18c\ub85c \ub9cc\ub4dc\ub294 \uac83\uc774 \ucd5c\uc18c \uc81c\uacf1\uc120\uc758 \uc218\ud559\uc801 \uc815\uc758\uc774\ub2e4."
        },
        {
          "text": "\uc774\uc0b0\ud654\ud0c4\uc18c \ub18d\ub3c4\uc640 \ud574\uc218\uba74 \uc628\ub3c4 \ub370\uc774\ud130 \uac04\uc758 \uad00\uacc4\ucc98\ub7fc \ub450 \uc18d\uc131 \uac04 \uc5f0\uad00\uc131\uc744 \ud310\ubcc4\ud560 \ub54c \ucd5c\uc18c \uc81c\uacf1\uc120\uc744 \ud65c\uc6a9\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc810\ub3c4 \uadf8\ub798\ud504 \uc0c1\uc5d0 \ucd5c\uc18c \uc81c\uacf1\uc120\uc744 \ud45c\uc2dc\ud568\uc73c\ub85c\uc368 \ub450 \ubcc0\uc218 \uac04 \ucd94\uc138\uc640 \uc0c1\uad00\uad00\uacc4 \uc720\ubb34\ub97c \uc2dc\uac01\uc801\uc73c\ub85c \ud3c9\uac00\ud560 \uc218 \uc788\ub2e4."
        }
      ],
      "hint": "\uacb0\uc815\uacc4\uc218 $r^2$ \uc218\uce58\uac00 $1$\uacfc $0$ \uc911 \uc5b4\ub514\uc5d0 \uac00\uae4c\uc6cc\uc57c \ucd94\uc138\uc120\uc774 \ub370\uc774\ud130\ub97c \uc798 \ud45c\ud604\ud558\ub294 \uac83\uc778\uc9c0 \ud655\uc778\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \ube45\ub370\uc774\ud130 \ubd84\uc11d \ubc0f \ud574\uc11d \uc0ac\ub840\uc5d0\uc11c \ub4dc\ub7ec\ub09c \ub300\ud45c\uc801\uc778 \uc624\ub958 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?\n\n\"\ud55c \uc5f0\uad6c\uc790\uac00 \uc544\uc774\uc2a4\ud06c\ub9bc \ud310\ub9e4\ub7c9 \ub370\uc774\ud130\ub97c \ud655\uc778\ud558\ub2e4\uac00, \uc544\uc774\uc2a4\ud06c\ub9bc \ud310\ub9e4\ub7c9\uc774 \ub298\uc5b4\ub098\ub294 \uc2dc\uae30\uc5d0 \uc775\uc0ac \uc0ac\uace0 \uc0ac\ub9dd\uc790 \uc218\ub3c4 \uc99d\uac00\ud558\uace0 \ud310\ub9e4\ub7c9\uc774 \uc904\uba74 \uc0ac\ub9dd\uc790 \uc218\ub3c4 \uac10\uc18c\ud558\ub294 \ud604\uc0c1\uc744 \uad00\ucc30\ud558\uc600\ub2e4. \uc774\uc5d0 \uc5f0\uad6c\uc790\ub294 '\uc775\uc0ac \uc0ac\ub9dd\uc790 \uc99d\uac00\uc758 \uc6d0\uc778\uc740 \uc544\uc774\uc2a4\ud06c\ub9bc\uc774\ub2e4'\ub77c\uace0 \uacb0\ub860\uc744 \ub0b4\ub838\ub2e4.\"",
      "answerOptions": [
        {
          "text": "\ub2e8\uc21c\ud788 \ud568\uaed8 \ubcc0\ud654\ud558\ub294 \ub450 \ubcc0\uc218 \uac04\uc758 \uc0c1\uad00\uad00\uacc4\ub97c \uc9c1\uc811\uc801\uc778 \uc6d0\uc778\uacfc \uacb0\uacfc\uc778 \uc778\uacfc\uad00\uacc4\ub85c \ud655\ub300 \ud574\uc11d\ud55c \uc624\ub958",
          "isCorrect": true,
          "rationale": "\uc5ec\ub984\ucca0 \uae30\uc628 \uc0c1\uc2b9\uc774\ub77c\ub294 \uc81c3\uc758 \uacf5\ud1b5 \uc694\uc778\uc744 \uac04\uacfc\ud558\uace0, \ub2e8\uc21c\ud788 \uc218\uce58 \ubcc0\ud654 \ud328\ud134\uc774 \ube44\uc2b7\ud55c \uc0c1\uad00\uad00\uacc4\ub97c \uc778\uacfc\uad00\uacc4\ub85c \uc798\ubabb \ud574\uc11d\ud55c \ub300\ud45c\uc801 \uc624\ub958\uc774\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc758 \uc628\ub77c\uc778 \ud589\uc801 \ub370\uc774\ud130\ub97c \ubb34\ub2e8 \uc218\uc9d1\ud558\uc5ec \ud504\ub77c\uc774\ubc84\uc2dc \ubc0f \uac1c\uc778\uc815\ubcf4 \uc790\uae30 \uacb0\uc815\uad8c\uc744 \uce68\ud574\ud55c \ubb38\uc81c",
          "isCorrect": false,
          "rationale": "\uc81c\uc2dc\ub41c \uc0ac\ub840\ub294 \ud1b5\uacc4\uc801 \uc218\uce58 \ud574\uc11d\uc758 \uc624\ub958\uc5d0 \uad00\ud55c \uac83\uc774\uba70, \uac1c\uc778\uc815\ubcf4 \uce68\ud574 \ubb38\uc81c\uc640\ub294 \uad00\ub828\uc774 \uc5c6\ub2e4."
        },
        {
          "text": "\uad6c\ub9e4 \uc8fc\uccb4\uc640 \uacb0\uc81c \uc8fc\uccb4\uac00 \ub2ec\ub77c \ub2e8\uc77c \uc18d\uc131\uc774 \ub2e4\uc911 \uc758\ubbf8\ub97c \uac00\uc838 \ubc1c\uc0dd\ud55c \ud574\uc11d\uc0c1\uc758 \ucc29\uc624",
          "isCorrect": false,
          "rationale": "\uc2e0\uc6a9\uce74\ub4dc \uc774\uc6a9\uc790 \ubd84\uc11d \ub4f1\uc5d0\uc11c \uacb0\uc81c\uc790\uc640 \uc2e4\uc81c \uc18c\ube44\uc790\uac00 \ub2ec\ub77c \ubc1c\uc0dd\ud558\ub294 \ud574\uc11d \ucc29\uc624\ub294 \ub2e4\ub978 \uc720\ud615\uc758 \uc624\ub958 \uc0ac\ub840\uc774\ub2e4."
        },
        {
          "text": "\ub370\uc774\ud130 \uc218\uc9d1 \ub2e8\uacc4\uc5d0\uc11c \ub204\ub77d\ub41c \uacb0\uce21\uce58\ub098 \uc911\ubcf5\uac12\uc744 \uc815\uc81c\ud558\uc9c0 \uc54a\uc544 \ub300\ud45c\uac12 \uc0b0\ucd9c\uc5d0 \uc65c\uace1\uc774 \uc0dd\uae34 \uc624\ub958",
          "isCorrect": false,
          "rationale": "\ub370\uc774\ud130 \uc804\ucc98\ub9ac \ubbf8\ud761\uc73c\ub85c \ubc1c\uc0dd\ud55c \ud1b5\uacc4 \uc0b0\ucd9c \uc624\ub958\uac00 \uc544\ub2cc, \ub3c4\ucd9c\ub41c \uacb0\uacfc\uc758 \ub17c\ub9ac\uc801 \uacb0\ub860 \ub3c4\ucd9c \ubc29\uc2dd\uc774 \uc798\ubabb\ub41c \uc0ac\ub840\uc774\ub2e4."
        }
      ],
      "hint": "\ub450 \ud604\uc0c1\uc774 \ub3d9\uc2dc\uc5d0 \uc77c\uc5b4\ub09c\ub2e4\ub294 \ud1b5\uacc4\uc801 \uc0ac\uc2e4(\uc0c1\uad00\uc131)\uc774 \uace7 \ud55c \ucabd\uc774 \ub2e4\ub978 \ucabd\uc758 '\uc6d0\uc778'\uc774 \ub418\ub294 \uac83\uc740 \uc544\ub2d8\uc744 \uace0\ub824\ud558\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc2a4\ub9c8\ud2b8\ud3f0\uc758 \ub9ac\ub2c8\uc5b4 \uac00\uc18d\ub3c4 \uc13c\uc11c\ub97c \ud65c\uc6a9\ud558\uc5ec \uc6b4\ub3d9 \ud328\ud134\uc744 \ubd84\uc11d\ud560 \ub54c, \ucd1d \uac00\uc18d\ub3c4($a_{total} = \\sqrt{x^2 + y^2 + z^2}$) \ubc0f \uc13c\uc11c\uc758 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc62c\ubc14\ub974\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub9ac\ub2c8\uc5b4 \uac00\uc18d\ub3c4 \uc13c\uc11c\ub294 \uc911\ub825 \uac00\uc18d\ub3c4\ub97c \ud3ec\ud568\ud558\uc5ec \uce21\uc815\ud558\ubbc0\ub85c \uc2a4\ub9c8\ud2b8\ud3f0\uc774 \uc644\uc804 \uc815\uc9c0 \uc0c1\ud0dc\uc77c \ub54c \ucd1d \uac00\uc18d\ub3c4 \uac12\uc740 \uc57d $9.8\\text{ m/s}^2$\uc774 \ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub9ac\ub2c8\uc5b4 \uac00\uc18d\ub3c4 \uc13c\uc11c\ub294 \uc911\ub825 \uac00\uc18d\ub3c4\ub97c \uc81c\uc678\ud55c \uc120\ud615 \uac00\uc18d\ub3c4\ub9cc\uc744 \uce21\uc815\ud558\ubbc0\ub85c \uc815\uc9c0 \uc0c1\ud0dc\uc5d0\uc11c\uc758 \ucd1d \uac00\uc18d\ub3c4\ub294 $0$\uc5d0 \uac00\uae5d\ub2e4."
        },
        {
          "text": "\uc2a4\ub9c8\ud2b8\ud3f0\uc774 \uc6c0\uc9c1\uc784 \uc5c6\uc774 \uac00\ub9cc\ud788 \uace0\uc815\ub418\uc5b4 \uc788\uc744 \ub54c \ucd1d \uac00\uc18d\ub3c4($a_{total}$) \uc218\uce58\ub294 $0$\uc5d0 \uac00\uae5d\uac8c \ub098\ud0c0\ub09c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc6c0\uc9c1\uc784\uc774 \uc5c6\uc73c\uba74 $x, y, z$ \uac01 \ucd95 \ubc29\ud5a5\uc758 \uac00\uc18d\ub3c4\uac00 \uc5c6\uc5b4 \ud569\uc131\ub41c \ucd1d \uac00\uc18d\ub3c4 \uc218\uce58\uac00 $0$ \uadfc\ucc98\ub97c \uc720\uc9c0\ud55c\ub2e4."
        },
        {
          "text": "\uc2a4\ub9c8\ud2b8\ud3f0\uc744 \uc18c\uc9c0\ud558\uace0 \ub2ec\ub9ac\ub294 \uc0c1\ud0dc\uc77c \ub54c\ub294 \uc2dc\uac04\uc5d0 \ub530\ub978 \ucd1d \uac00\uc18d\ub3c4 \ud06c\uae30 \ubcc0\ud654\uac00 \ubd88\uaddc\uce59\ud558\uba70 \ub192\uac8c \ub098\ud0c0\ub09c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2ec\ub9ac\uae30 \ub4f1\uc758 \uaca9\ub82c\ud55c \uc6b4\ub3d9 \uc2dc\uc5d0\ub294 \ucd95\ubcc4 \uac00\uc18d\ub3c4 \ubcc0\ud654\ub7c9\uc774 \ud06c\ubbc0\ub85c \ucd1d \uac00\uc18d\ub3c4\uac00 \ub192\uc740 \uc218\uce58\ub85c \ud06c\uac8c \ubcc0\ub3d9\ud55c\ub2e4."
