{
  "title": "\ube45\ub370\uc774\ud130 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ube45\ub370\uc774\ud130\uc758 5\uac00\uc9c0 \ud575\uc2ec \ud2b9\uc9d5(5V) \ubc0f \ucd94\uac00\ub41c \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc815\ud655\uc131(Veracity)\uc740 \ube45\ub370\uc774\ud130 \ubd84\uc11d\uc5d0\uc11c \uc720\uc6a9\ud558\uace0 \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294 \ub370\uc774\ud130\ub97c \ub2e4\ub8e8\uc5b4\uc57c \ud568\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ube45\ub370\uc774\ud130\ub294 \ub370\uc774\ud130\uc758 \uc591\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc218\uc9d1\ub41c \ub370\uc774\ud130\uc758 \ud488\uc9c8\uacfc \uc2e0\ub8b0\uc131\uc774 \uc911\uc694\ud558\ubbc0\ub85c \uc720\uc6a9\ud558\uace0 \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294 \ub370\uc774\ud130\ub97c \ud65c\uc6a9\ud558\ub294 \uc815\ud655\uc131\uc774 \uc8fc\uc694 \ud2b9\uc9d5\uc774\ub2e4."
        },
        {
          "text": "\uac00\ubcc0\uc131(Variability)\uc740 \ub370\uc774\ud130 \uad6c\uc870\uac00 \ud56d\uc0c1 \uace0\uc815\ub41c \uc815\ud615 \ud615\ud0dc\ub85c \uc720\uc9c0\ub418\ub294 \uc131\uc9c8\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac00\ubcc0\uc131\uc740 \ub370\uc774\ud130\uc758 \ud615\ud0dc\ub098 \uc758\ubbf8\uac00 \uc720\uc5f0\ud558\uac8c \ubcc0\ud560 \uc218 \uc788\ub294 \ud2b9\uc131\uc744 \ub098\ud0c0\ub0b4\uba70 \ub370\uc774\ud130 \uad6c\uc870\uac00 \uace0\uc815\ub428\uc744 \ub73b\ud558\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\ub2e4\uc591\uc131(Variety)\uc740 \ub370\uc774\ud130\uc758 \uc0dd\uc131, \uc218\uc9d1, \ucc98\ub9ac\ub418\ub294 \uc18d\ub3c4\uac00 \uc810\ucc28 \ube68\ub77c\uc9c0\ub294 \ud2b9\uc131\uc744 \ub73b\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub370\uc774\ud130\uc758 \uc0dd\uc131 \ubc0f \uc218\uc9d1, \ucc98\ub9ac \uc18d\ub3c4\uac00 \ube60\ub984\uc744 \uc758\ubbf8\ud558\ub294 \ud2b9\uc9d5\uc740 \ub2e4\uc591\uc131\uc774 \uc544\ub2cc \uc18d\ub3c4(Velocity)\uc774\ub2e4."
        },
        {
          "text": "\uaddc\ubaa8(Volume)\ub294 \ud45c \ud615\ud0dc\uc758 \uc815\ud615 \ub370\uc774\ud130\ub9cc\uc744 \uc218\uc9d1 \ubc0f \ubd84\uc11d \ub300\uc0c1\uc73c\ub85c \ud568\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uaddc\ubaa8\ub294 \ub370\uc774\ud130\uc758 \uc591\uc774 \uc218\uc2ed \ud14c\ub77c\ubc14\uc774\ud2b8 \uc774\uc0c1\uc73c\ub85c \ub9e4\uc6b0 \ud06c\ub2e4\ub294 \uac83\uc744 \uc758\ubbf8\ud558\uba70 \uc815\ud615 \ub370\uc774\ud130\ubfd0\ub9cc \uc544\ub2c8\ub77c \ube44\uc815\ud615 \ub370\uc774\ud130\ub3c4 \ud3ec\ud568\ud55c\ub2e4."
        }
      ],
      "hint": "\ub370\uc774\ud130\uc758 \uc2e0\ub8b0\uc131\uacfc \uc720\uc6a9\uc131\uc5d0 \uc5f0\uad00\ub41c 'V' \ub2e8\uc5b4\uc758 \uc758\ubbf8\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \ub370\uc774\ud130\uc758 \uc720\ud615 \ubd84\ub958\uc778 \uc815\ud615 \ub370\uc774\ud130\uc640 \ube44\uc815\ud615 \ub370\uc774\ud130\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucf64\ub9c8(,)\ub85c \ud56d\ubaa9\uc744 \uad6c\ubcc4\ud558\ub294 CSV \ud30c\uc77c\uc774\ub098 \ud589\uacfc \uc5f4\uc774 \uad6c\ubcc4\ub418\ub294 \ud45c \ud615\uc2dd\uc740 \uc815\ud615 \ub370\uc774\ud130\uc5d0 \ud574\ub2f9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc815\ud615 \ub370\uc774\ud130\ub294 \uace0\uc815\ub41c \uad6c\uc870\uc640 \ud615\uc2dd\uc744 \uac00\uc9c0\uba70, \ud589\uacfc \uc5f4\ub85c \uad6c\ubcc4\ub418\ub294 \ud45c\ub098 CSV \ud615\uc2dd \ub4f1\uc774 \uc774\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\uc778\ud130\ub137 \uac80\uc0c9 \uae30\ub85d, \uc0ac\uc9c4, \uc74c\uc131 \ud30c\uc77c\uc740 \uace0\uc815\ub41c \ud615\ud0dc\uc640 \uad6c\uc870\ub97c \uac00\uc9c0\ubbc0\ub85c \uc815\ud615 \ub370\uc774\ud130\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\uc9c4, \uc74c\uc131, \ubb38\uc11c \ub4f1 \uace0\uc815\ub41c \uad6c\uc870\ub098 \ud615\ud0dc\uac00 \uc5c6\ub294 \ub370\uc774\ud130\ub294 \ube44\uc815\ud615 \ub370\uc774\ud130\ub85c \ubd84\ub958\ub41c\ub2e4."
        },
        {
          "text": "\ube44\uc815\ud615 \ub370\uc774\ud130\ub294 \uace0\uc815\ub41c \uad6c\uc870\ub97c \uac00\uc9c0\uace0 \uc788\uc5b4 \ub370\uc774\ud130\ubca0\uc774\uc2a4 \ud14c\uc774\ube14\uc5d0 \uadf8\ub300\ub85c \uc800\uc7a5\ud558\uae30 \uc27d\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube44\uc815\ud615 \ub370\uc774\ud130\ub294 \uace0\uc815\ub41c \uad6c\uc870\uac00 \uc5c6\uae30 \ub54c\ubb38\uc5d0 \uc804\ud1b5\uc801\uc778 \ud14c\uc774\ube14 \uad6c\uc870\ub85c \uc800\uc7a5\ud558\uae30 \uc5b4\ub835\uace0 \ubcc4\ub3c4\uc758 \uac00\uacf5\uc774\ub098 \ubd84\uc11d \uae30\uc220\uc774 \ud544\uc694\ud558\ub2e4."
        },
        {
          "text": "\uc774\uba54\uc77c \uc804\uc1a1 \ub0b4\uc5ed\uc774\ub098 \ucc57GPT \ubc29\ubb38 \uae30\ub85d \ub370\uc774\ud130\ub294 \ud56d\uc0c1 \ud45c \ud615\uc2dd\uc73c\ub85c \uc800\uc7a5\ub418\ub294 \uc815\ud615 \ub370\uc774\ud130\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\uba54\uc77c \ud14d\uc2a4\ud2b8\ub098 \uc6f9 \ubc29\ubb38 \uae30\ub85d \ub4f1\uc740 \uc815\ud574\uc9c4 \ud45c \ud615\ud0dc\uac00 \uc5c6\ub294 \ube44\uc815\ud615 \ub370\uc774\ud130\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        }
      ],
      "hint": "\uace0\uc815\ub41c \ud589\uacfc \uc5f4\uc758 \ud615\ud0dc\ub098 \uaddc\uce59\uc801\uc778 \uad6c\ubd84 \uae30\ud638\uac00 \uc874\uc7ac\ud558\ub294\uc9c0 \uc5ec\ubd80\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ube45\ub370\uc774\ud130 \ubd84\uc11d \ub2e8\uacc4 \uc911 '\ub370\uc774\ud130 \uc218\uc9d1\ud558\uae30' \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubd84\uc11d \uacb0\uacfc\uc758 \uba85\ud655\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574 \ud2b9\uc815 \uc5f0\ub839\uc774\ub098 \uc131\ubcc4 \ub4f1 \ud2b9\uc815 \uc9d1\ub2e8\uc5d0 \ud3b8\ud5a5\ub41c \ub370\uc774\ud130\ub9cc\uc744 \uc120\ud0dd \uc218\uc9d1\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub370\uc774\ud130 \uc218\uc9d1 \uc2dc \uc778\uc885, \uc131\ubcc4 \ub4f1\uc758 \ud3b8\uacac\uc774\ub098 \ud3b8\ud5a5\uc131\uc774 \ubc18\uc601\ub418\uc9c0 \uc54a\ub3c4\ub85d \ub370\uc774\ud130 \ud3b8\ud5a5\uc131 \ubb38\uc81c\uc5d0 \uc8fc\uc758\ud574\uc57c \ud55c\ub2e4."
        },
        {
          "text": "\uc800\uc791\uad8c \ubc0f \uac1c\uc778\uc815\ubcf4 \ub178\ucd9c \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\ub3c4\ub85d \uc815\ub2f9\ud558\uace0 \ud569\ubc95\uc801\uc778 \ubc29\ubc95\uc73c\ub85c \uc218\uc9d1\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub370\uc774\ud130 \uc218\uc9d1 \ub2e8\uacc4\uc5d0\uc11c\ub294 \uac1c\uc778\uc815\ubcf4 \ub178\ucd9c, \uc800\uc791\uad8c, \ub370\uc774\ud130 \ud3b8\ud5a5\uc131 \ub4f1\uc758 \ubb38\uc81c\ub97c \uc885\ud569\uc801\uc73c\ub85c \uace0\ub824\ud558\uc5ec \uc815\ub2f9\ud558\uac8c \uc218\uc9d1\ud574\uc57c \ud55c\ub2e4."
        },
        {
          "text": "\uc6f9 \ud06c\ub864\ub7ec(web crawler) \ud504\ub85c\uadf8\ub7a8\uc744 \uc0ac\uc6a9\ud558\uba74 \uc6f9 \ud398\uc774\uc9c0\ub97c \ubc29\ubb38\ud558\uc5ec \ub370\uc774\ud130\ub97c \uc790\ub3d9 \uc218\uc9d1\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc6f9 \ud06c\ub864\ub7ec\ub294 \uc778\ud130\ub137 \uc6f9 \ud398\uc774\uc9c0\uc5d0 \uc811\uc18d\ud558\uc5ec \ub370\uc774\ud130\ub97c \uc790\ub3d9\uc73c\ub85c \uc218\uc9d1\ud574 \uc8fc\ub294 \ud504\ub85c\uadf8\ub7a8\uc774\ub2e4."
        },
        {
          "text": "\uacf5\uacf5 \ub370\uc774\ud130 \ud3ec\ud138, \uad6d\uac00 \ud1b5\uacc4 \ud3ec\ud138(KOSIS), \uce90\uae00(Kaggle) \ub4f1 \uc624\ud508 \ub370\uc774\ud130 \uc0ac\uc774\ud2b8\ub97c \ud65c\uc6a9\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uacf5 \uae30\uad00\uc774\ub098 AI \uacbd\uc9c4 \ub300\ud68c \uc0ac\uc774\ud2b8 \ub4f1\uc740 \ubd84\uc11d \ubaa9\uc801\uc5d0 \ud544\uc694\ud55c \ub370\uc774\ud130\ub97c \uc218\uc9d1\ud560 \uc218 \uc788\ub294 \uc8fc\uc694 \ucd9c\ucc98\uc774\ub2e4."
        }
      ],
      "hint": "\ub370\uc774\ud130 \uc218\uc9d1 \uc2dc \uacb0\uacfc\uac00 \ud2b9\uc815 \uadf8\ub8f9\uc73c\ub85c \uce58\uc6b0\uce58\uc9c0 \uc54a\ub3c4\ub85d \uc8fc\uc758\ud574\uc57c \ud560 \uc694\uc18c\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud0d0\uc0c9\uc801 \ub370\uc774\ud130 \ubd84\uc11d(EDA)\uc5d0\uc11c \ubc15\uc2a4 \ud50c\ub86f(Box Plot)\uc744 \ud65c\uc6a9\ud558\uc5ec \uc774\uc0c1\uce58\ub97c \ud310\ubcc4\ud558\uace0 \ucc98\ub9ac\ud558\ub294 \ubc29\ubc95\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud558\uc704 $25\\%$ \uac12($Q1$)\uacfc \uc0c1\uc704 $25\\%$ \uac12($Q3$)\uc744 \uae30\uc900\uc73c\ub85c, $Q1 - 1.5 \\times IQR$ \ubbf8\ub9cc\uc774\uac70\ub098 $Q3 + 1.5 \\times IQR$ \ucd08\uacfc\uc778 \uc218\uce58\ub294 \uc774\uc0c1\uce58\ub85c \ud310\ub2e8\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubc15\uc2a4 \ud50c\ub86f\uc5d0\uc11c\ub294 \ud558\uc704 $25\\%$\uc640 \uc0c1\uc704 $25\\%$ \ubc94\uc704\ub97c \ubc97\uc5b4\ub098\ub294 \uc218\uce58\ub97c \ud1b5\uacc4\uc801 \uae30\uc900\uc5d0 \ub530\ub77c \uc774\uc0c1\uce58\ub85c \ud310\ubcc4\ud55c\ub2e4."
        },
        {
          "text": "\ubc15\uc2a4 \ud50c\ub86f\uc5d0\uc11c \uc2dd\ubcc4\ub41c \uc774\uc0c1\uce58\ub294 \uce21\uc815 \uc624\ub958\uc774\ubbc0\ub85c \ub370\uc774\ud130 \ubd84\uc11d \uc2dc \ubb34\uc870\uac74 \uc0ad\uc81c\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uacf5 \uae30\uad00 \ud488\uc9c8 \uac80\uc0ac\ub97c \uac70\uce5c \ub370\uc774\ud130\ucc98\ub7fc \uc815\ub2f9\ud558\uac8c \uad00\uce21\ub41c \uc218\uce58\ub77c\uba74 \uc774\uc0c1\uce58\uac00 \ub098\ud0c0\ub098\ub354\ub77c\ub3c4 \ud310\ub2e8\uc5d0 \ub530\ub77c \uadf8\ub300\ub85c \uc720\uc9c0\ud560 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\uc911\uc559\uac12($Q2$)\uc740 \ubaa8\ub4e0 \uc218\uce58\ub97c \ub354\ud55c \ub4a4 \uc804\uccb4 \ub370\uc774\ud130\uc758 \uac1c\uc218\ub85c \ub098\ub204\uc5b4 \uad6c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubaa8\ub4e0 \uc218\uce58\ub97c \ub354\ud574 \uac1c\uc218\ub85c \ub098\ub208 \uac83\uc740 \ud3c9\uade0\uc774\uba70, \uc911\uc559\uac12\uc740 \ub370\uc774\ud130\ub97c \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud588\uc744 \ub54c \uac00\uc7a5 \uac00\uc6b4\ub370\uc5d0 \uc704\uce58\ud55c \uac12\uc774\ub2e4."
        },
        {
          "text": "\ubc15\uc2a4 \ud50c\ub86f\uc758 $Q3$\uc740 \ub370\uc774\ud130\ub97c \uc21c\uc11c\ub300\ub85c \uc815\ub82c\ud588\uc744 \ub54c \uc804\uccb4 \ub370\uc774\ud130\uc758 \ud558\uc704 $25\\%$ \uc704\uce58\ub97c \ub098\ud0c0\ub0b8\ub2e4.",
          "isCorrect": false,
          "rationale": "$Q3$\uc740 \uc0c1\uc704 $25\\%$ \uc9c0\uc810\uc744 \uc758\ubbf8\ud558\uba70, \ud558\uc704 $25\\%$ \uc704\uce58\ub294 $Q1$\uc774\ub2e4."
        }
      ],
      "hint": "\uc0ac\ubd84\uc704\uc218 \ubc94\uc704($IQR$)\uc640 \ucd5c\uc19f\uac12/\ucd5c\ub313\uac12 \ubc94\uc704\ub97c \uacc4\uc0b0\ud558\ub294 \ubc15\uc2a4 \ud50c\ub86f\uc758 \ud1b5\uacc4\uc801 \uae30\uc900\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub370\uc774\ud130 \uc2dc\uac01\ud654\uc758 \ubaa9\uc801\ubcc4 \uc720\ud615 \uc911, \ub370\uc774\ud130 \uac04\uc758 \uc5f0\uad00\uc131\uc774\ub098 \uad00\uacc4\ub97c \ud45c\ud604\ud558\uae30\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \uc2dc\uac01\ud654 \ucc28\ud2b8\uc758 \uc870\ud569\uc740?",
      "answerOptions": [
        {
          "text": "\ubc84\ube14 \ucc28\ud2b8, \ud788\uc2a4\ud1a0\uadf8\ub7a8, \uc0b0\uc810\ub3c4",
          "isCorrect": true,
          "rationale": "\ubc84\ube14 \ucc28\ud2b8, \ud788\uc2a4\ud1a0\uadf8\ub7a8, \uc0b0\uc810\ub3c4\ub294 \ub450 \uac1c \uc774\uc0c1\uc758 \uc18d\uc131 \uac04 \uc5f0\uad00\uc131\uc774\ub098 \uad00\uacc4\ub97c \uc2dc\uac01\uc801\uc73c\ub85c \ud45c\ud604\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \ub300\ud45c\uc801\uc778 \uae30\ubc95\uc774\ub2e4."
        },
        {
          "text": "\uc120\uadf8\ub798\ud504, \ub9c9\ub300\uadf8\ub798\ud504, \uc601\uc5ed\ud615 \ucc28\ud2b8",
          "isCorrect": false,
          "rationale": "\uc120\uadf8\ub798\ud504, \ub9c9\ub300\uadf8\ub798\ud504, \uc601\uc5ed\ud615 \ucc28\ud2b8\ub294 \uc2dc\uac04\uc5d0 \ub530\ub978 \ubcc0\ud654 \ucd94\uc774\ub97c \ub098\ud0c0\ub0b4\ub294 \uc2dc\uac04 \uc2dc\uac01\ud654 \uc720\ud615\uc774\ub2e4."
        },
        {
          "text": "\ud788\ud2b8\ub9f5, \uc6cc\ub4dc \ud074\ub77c\uc6b0\ub4dc, \ubc29\uc0ac\ud615 \ucc28\ud2b8",
          "isCorrect": false,
          "rationale": "\ud788\ud2b8\ub9f5, \uc6cc\ub4dc \ud074\ub77c\uc6b0\ub4dc, \ubc29\uc0ac\ud615 \ucc28\ud2b8\ub294 \ub370\uc774\ud130 \uac04 \ucc28\uc774\uc640 \uc720\uc0ac\uc131\uc744 \ube44\uad50\ud558\ub294 \ube44\uad50 \uc2dc\uac01\ud654 \uae30\ubc95\uc774\ub2e4."
        },
        {
          "text": "\uc9c0\ub3c4 \uc2dc\uac01\ud654, \ub3c4\ud2b8 \ub9f5, \ucf54\ub85c\ud50c\ub808\uc2a4 \ub9f5",
          "isCorrect": false,
          "rationale": "\uc9c0\ub9ac\uc801 \uc704\uce58\ub098 \uacf5\uac04 \uc815\ubcf4\ub97c \uae30\ubc18\uc73c\ub85c \ub370\uc774\ud130\ub97c \ud45c\ud604\ud558\ub294 \uac83\uc740 \uacf5\uac04 \uc2dc\uac01\ud654 \uc720\ud615\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        }
      ],
      "hint": "\ubcc0\uc218\ub4e4 \uac04\uc758 \ubc00\ub3c4\ub098 \ubd84\ud3ec, \uc0c1\uad00\uc131\uc744 \uc810\uc774\ub098 \ubc29\uc6b8 \ud06c\uae30 \ub4f1\uc73c\ub85c \ubcf4\uc5ec\uc8fc\ub294 \ucc28\ud2b8\ub97c \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub370\uc774\ud130 \uc13c\ud130 \uad6c\ub3d9 \ubc0f \ub514\uc9c0\ud138 \uae30\uae30 \uc0ac\uc6a9\uc5d0 \ub530\ub978 '\ub514\uc9c0\ud138 \ud0c4\uc18c \ubc1c\uc790\uad6d'\uc744 \uc904\uc774\uae30 \uc704\ud55c \uc2e4\ucc9c \ud589\ub3d9\uc73c\ub85c \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub370\uc774\ud130 \uc804\uc1a1 \uc18d\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud574 \uc218\uc2e0\ud55c \uba54\uc77c\ud568\uc758 \uace0\uc6a9\ub7c9 \ucca8\ubd80\ud30c\uc77c\uacfc \uc2a4\ud338 \uba54\uc77c\uc744 \uc0ad\uc81c\ud558\uc9c0 \uc54a\uace0 \ubcf4\uad00\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uba54\uc77c\ud568\uc5d0 \uc313\uc778 \ubd88\ud544\uc694\ud55c \ub370\uc774\ud130\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \uc800\uc7a5 \ubc0f \ubcf4\uad00\ud558\uba74 \ub370\uc774\ud130 \uc13c\ud130 \uc11c\ubc84 \uad6c\ub3d9\uc5d0 \uc9c0\uc18d\uc801\uc778 \uc804\ub825\uc774 \uc18c\ubaa8\ub418\ubbc0\ub85c \uba54\uc77c\ud568\uc744 \uc790\uc8fc \ube44\uc6cc\uc57c \ud55c\ub2e4."
        },
        {
          "text": "\uc2a4\ub9c8\ud2b8\ud3f0\uc744 \uc790\uc8fc \ubc14\uafb8\uc9c0 \uc54a\uace0 \uc0ac\uc6a9 \uae30\uac04\uc744 \uc5f0\uc7a5\ud558\uc5ec \uae30\uae30 \uc81c\uc870/\ud3d0\uae30 \uacfc\uc815\uc758 \uc628\uc2e4\uac00\uc2a4\ub97c \uc904\uc778\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ub9c8\ud2b8\ud3f0 \uad50\uccb4 \uc8fc\uae30\ub97c \ub298\ub9ac\uba74 \uae30\uae30 \uc0dd\uc0b0\uacfc \ud3d0\uae30 \ub2e8\uacc4\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c\uc744 \uac10\uc18c\uc2dc\ud0ac \uc218 \uc788\ub2e4."
        },
        {
          "text": "\uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \ub178\ud2b8\ubd81 \ubc0f \ucef4\ud4e8\ud130\uc758 \uc804\uc6d0\uc744 \uc644\uc804\ud788 \uaebc\uc11c \ubd88\ud544\uc694\ud55c \uc804\ub825 \uc18c\ubaa8\ub97c \ubc29\uc9c0\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \uae30\uae30\uc758 \uc804\uc6d0\uc744 \ucc28\ub2e8\ud558\ub294 \uac83\uc740 \ub514\uc9c0\ud138 \ud0c4\uc18c \ubc1c\uc790\uad6d\uc744 \uc904\uc774\ub294 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc774\ub2e4."
        },
        {
          "text": "\ub3d9\uc601\uc0c1 \uc2a4\ud2b8\ub9ac\ubc0d \uc11c\ube44\uc2a4 \uc774\uc6a9 \uc2dc\uac04\uc744 \uc904\uc774\uace0 \uc2a4\ub9c8\ud2b8\ud3f0 \uc808\uc804 \ubaa8\ub4dc\ub97c \ud65c\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ud2b8\ub9ac\ubc0d \uac10\uc18c\uc640 \ub514\uc2a4\ud50c\ub808\uc774 \uc804\ub825 \uac10\uc18c\ub294 \uc804\ub825 \uc18c\ube44 \ubc0f \uad00\ub828 \uc628\uc2e4\uac00\uc2a4 \ubc30\ucd9c\uc744 \uc9c1\uc811\uc801\uc73c\ub85c \uc904\uc5ec\uc900\ub2e4."
        }
      ],
      "hint": "\ub370\uc774\ud130 \uc13c\ud130\uc758 \uc11c\ubc84 \uc790\uc6d0\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \ucc28\uc9c0\ud558\uace0 \uc804\ub825\uc744 \uc18c\ubaa8\ud558\uac8c \ub9cc\ub4dc\ub294 \ud589\ub3d9\uc774 \ubb34\uc5c7\uc77c\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc6f9 \uae30\ubc18 \ubd84\uc11d \ud50c\ub7ab\ud3fc(CODAP \ub4f1)\uc5d0\uc11c \ud14d\uc2a4\ud2b8 \uae30\ubc18 \uc218\uc9d1 \ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc62c \ub54c, \ubb38\uc790 \uc815\ubcf4\uac00 \uae68\uc9c0\uc9c0 \uc54a\ub3c4\ub85d \ud30c\uc77c\uc744 \uc800\uc7a5\ud560 \ub54c \uc120\ud0dd\ud574\uc57c \ud558\ub294 \ud45c\uc900 \ubb38\uc790 \uc778\ucf54\ub529 \ubc29\uc2dd\uc740?",
      "answerOptions": [
        {
          "text": "UTF-8",
          "isCorrect": true,
          "rationale": "\uc6f9 \uae30\ubc18 \uac1c\ubc1c \ubc0f \ubd84\uc11d \ud658\uacbd\uc5d0\uc11c\ub294 \ub2e4\uc591\ud55c \uc5b8\uc5b4 \ubb38\uc790\ub97c \uc190\uc0c1 \uc5c6\uc774 \ucc98\ub9ac\ud558\uae30 \uc704\ud574 \ud45c\uc900 \ub514\uc9c0\ud138 \uc778\ucf54\ub529 \ubc29\uc2dd\uc778 UTF-8\uc744 \uc0ac\uc6a9\ud574\uc57c \ud55c\ub2e4."
