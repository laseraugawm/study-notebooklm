        {
          "text": "\uc0c1\uc704 \ub178\ub4dc\uc5d0\uc11c \ud558\uc704 \ub178\ub4dc \ubc29\ud5a5\uc73c\ub85c\ub9cc \uc5f0\uacb0 \uad00\uacc4\uac00 \uc874\uc7ac\ud558\ub294 \uacc4\uce35\uc801 \uad6c\uc870\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud2b8\ub9ac\ub294 \ubfcc\ub9ac\uc5d0\uc11c \uac00\uc9c0\uac00 \ubed7\uc5b4\ub098\uac00\ub4ef \uacc4\uce35\uc801\uc778 \ub2e8\ubc29\ud5a5 \uad6c\uc870\ub97c \uac16\ub294\ub2e4."
