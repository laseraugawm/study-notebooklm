{
  "title": "\ucd94\uc0c1\ud654 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ucef4\ud4e8\ud130\ub97c \uc774\uc6a9\ud55c \ubb38\uc81c \ud574\uacb0 \uacfc\uc815\uc5d0\uc11c \ubcf5\uc7a1\ud55c \ubb38\uc81c\ub97c \ub2e8\uc21c\ud654\ud558\ub294 '\ucd94\uc0c1\ud654(Abstraction)' \uacfc\uc815\uc5d0 \ud3ec\ud568\ub418\ub294 3\uac00\uc9c0 \uc8fc\uc694 \ub2e8\uacc4\uc758 \uc870\ud569\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb38\uc81c \ubd84\ud574, \ud575\uc2ec \uc694\uc18c \ucd94\ucd9c, \ubaa8\ub378\ub9c1",
          "isCorrect": true,
          "rationale": "\ucd94\uc0c1\ud654\ub294 \ubcf5\uc7a1\ud55c \ubb38\uc81c\ub97c \uc791\uac8c \ub098\ub204\uace0(\ubb38\uc81c \ubd84\ud574), \ud544\uc694\ud55c \uc694\uc18c\ub9cc \ubf51\uc544\ub0b4\uba70(\ud575\uc2ec \uc694\uc18c \ucd94\ucd9c), \uc774\ub97c \uad6c\uc870\ud654\ud558\uc5ec \ud45c\ud604\ud558\ub294(\ubaa8\ub378\ub9c1) \uc77c\ub828\uc758 \uacfc\uc815\uc744 \ub73b\ud55c\ub2e4."
        },
        {
          "text": "\ubb38\uc81c \ubd84\uc11d, \uc54c\uace0\ub9ac\uc998 \uc124\uacc4, \ud504\ub85c\uadf8\ub798\ubc0d",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \ucd94\uc0c1\ud654\uc758 \ud558\uc704 \ub2e8\uacc4\uac00 \uc544\ub2c8\ub77c \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud55c \uc804\uccb4\uc801\uc778 \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uac1c\ubc1c \uc808\ucc28\uc5d0 \uac00\uae5d\ub2e4."
        },
        {
          "text": "\ud604\uc7ac \uc0c1\ud0dc \uc815\uc758, \ubaa9\ud45c \uc0c1\ud0dc \uc815\uc758, \uc81c\uc57d \uc870\uac74 \uc124\uc815",
          "isCorrect": false,
          "rationale": "\uc774 \uc694\uc18c\ub4e4\uc740 \ucd94\uc0c1\ud654 \uc804 \ub2e8\uacc4\uc778 \ubb38\uc81c \ubd84\uc11d \uacfc\uc815\uc5d0\uc11c \ub2e4\ub8e8\ub294 \uad6c\uccb4\uc801\uc778 \ud56d\ubaa9\ub4e4\uc774\ub2e4."
        },
        {
          "text": "\ud45c \uc791\uc131, \ud2b8\ub9ac \uc0dd\uc131, \uadf8\ub798\ud504 \ud45c\ud604",
          "isCorrect": false,
          "rationale": "\uc774 \ud56d\ubaa9\ub4e4\uc740 \ucd94\uc0c1\ud654\uc758 \ub9c8\uc9c0\ub9c9 \ub2e8\uacc4\uc778 \ubaa8\ub378\ub9c1\uc5d0\uc11c \ud65c\uc6a9\ud560 \uc218 \uc788\ub294 \uad6c\uccb4\uc801\uc778 \ud45c\ud604 \uad6c\uc870\ub4e4\uc774\ub2e4."
        }
      ],
      "hint": "\ubcf5\uc7a1\ud55c \ubb38\uc81c\ub97c \uc791\uac8c \ub098\ub204\uace0, \uc911\uc694\ud55c \uc694\uc18c\ub97c \ubf51\uc544, \uc774\ub97c \ub2e8\uc21c\ud558\uac8c \ud45c\ud604\ud558\ub294 \uc5f0\uc18d\uc801 \uc808\ucc28\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \ubb38\uc81c \ud574\uacb0 \uacfc\uc815\uc5d0\uc11c '\uc81c\uc57d \uc870\uac74'\uc5d0 \ud574\ub2f9\ud558\ub294 \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc8fc\uc5b4\uc9c4 \ubb38\uc81c \ud658\uacbd\uc5d0\uc11c \ubc18\ub4dc\uc2dc \ub530\ub77c\uc57c \ud558\uac70\ub098 \ub118\uc9c0 \ub9d0\uc544\uc57c \ud560 \uc81c\ud55c \uc0ac\ud56d",
          "isCorrect": true,
          "rationale": "\uc81c\uc57d \uc870\uac74\uc740 \ubb38\uc81c \ud574\uacb0 \uacfc\uc815\uc5d0\uc11c \ubc18\ub4dc\uc2dc \uc900\uc218\ud574\uc57c \ud558\ub294 \uaddc\uaca9\uc774\ub098 \uc81c\ud55c \uaddc\uce59\uc744 \uc758\ubbf8\ud55c\ub2e4."
        },
        {
          "text": "\ubb38\uc81c \ud574\uacb0\uc774 \uc2dc\uc791\ub418\uae30 \uc804 \ubb38\uc81c\uc758 \ucd5c\ucd08 \uc0c1\ud669\uc774\ub098 \uc8fc\uc5b4\uc9c4 \ucd08\uae30 \ub370\uc774\ud130",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \uc81c\uc57d \uc870\uac74\uc774 \uc544\ub2c8\ub77c \ubb38\uc81c\uc758 '\ud604\uc7ac \uc0c1\ud0dc'\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4."
        },
        {
          "text": "\ubb38\uc81c\ub97c \uc644\uc804\ud788 \ud574\uacb0\ud588\uc744 \ub54c \ub3c4\ub2ec\ud574\uc57c \ud558\ub294 \uacb0\uacfc\ub098 \ucd5c\uc885 \ubaa9\uc801",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \uc81c\uc57d \uc870\uac74\uc774 \uc544\ub2c8\ub77c \ubb38\uc81c\uc758 '\ubaa9\ud45c \uc0c1\ud0dc'\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4."
        },
        {
          "text": "\uc0ac\uc6a9\uc790\uac00 \ubb38\uc81c \ud574\uacb0 \uacb0\uacfc\ub85c \uc694\uad6c\ud558\ub294 \uad6c\uccb4\uc801\uc778 \ucd9c\ub825 \ud615\ud0dc",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \uc81c\uc57d \uc870\uac74\uc774 \uc544\ub2c8\ub77c \ubb38\uc81c\uc758 '\uc694\uad6c \uc0ac\ud56d'\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4."
        }
      ],
      "hint": "\ubb38\uc81c \ud574\uacb0 \uacfc\uc815\uc5d0\uc11c \uc790\uc720\ub86d\uac8c \ud589\ub3d9\ud558\ub294 \uac83\uc744 \uc81c\ud55c\ud558\ub294 \uaddc\uce59\uc774\ub098 \ud55c\uacc4 \ud56d\ubaa9\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "$3 \\times 3$ \ud06c\uae30\uc758 \uaca9\uc790 \uacf5\uac04\uc5d0\uc11c \ub85c\ubd07\uc774 \uc2dc\uc791 \uc88c\ud45c $(1, 1)$\uc5d0 \uc704\uce58\ud574 \uc788\ub2e4. \ub85c\ubd07\uc5d0\uac8c 'D, R, R, U, L, D'\uc758 \uc774\ub3d9 \uba85\ub839\uc744 \uc21c\uc11c\ub300\ub85c \ub0b4\ub838\uc744 \ub54c, \ub85c\ubd07\uc758 \ucd5c\uc885 \uc88c\ud45c\ub294 \uc5b4\ub514\uc778\uac00? (\ub2e8, \ub85c\ubd07\uc740 \uc0c1(U), \ud558(D), \uc88c(L), \uc6b0(R)\ub85c 1\uce78\uc529 \uc774\ub3d9\ud558\uba70, \uaca9\uc790 \uacf5\uac04\uc744 \ubc97\uc5b4\ub098\ub294 \uc774\ub3d9\uc740 \ubb34\uc2dc\ub41c\ub2e4. \ud589 \uc88c\ud45c\ub294 \uc704\uc5d0\uc11c\ubd80\ud130 1~3, \uc5f4 \uc88c\ud45c\ub294 \uc67c\ucabd\ubd80\ud130 1~3\uc774\ub2e4.)",
      "answerOptions": [
        {
          "text": "(2, 2)",
          "isCorrect": true,
          "rationale": "(1,1)\uc5d0\uc11c \ucd9c\ubc1c\ud558\uc5ec D(2,1) -> R(2,2) -> R(2,3) -> U(1,3) -> L(1,2) -> D(2,2) \uc21c\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ucd5c\uc885 \uc704\uce58\ub294 (2,2)\uac00 \ub41c\ub2e4."
        },
        {
          "text": "(3, 2)",
          "isCorrect": false,
          "rationale": "\ud558(D) \uc774\ub3d9 \uba85\ub839 \ud69f\uc218\ub97c \uc624\uc778\ud558\uac70\ub098 \uc774\ub3d9 \uac70\ub9ac\ub97c \uc798\ubabb \uacc4\uc0b0\ud588\uc744 \ub54c \ub098\uc62c \uc218 \uc788\ub294 \uc624\ub2f5\uc774\ub2e4."
        },
        {
          "text": "(2, 3)",
          "isCorrect": false,
          "rationale": "\ub9c8\uc9c0\ub9c9 \uc88c(L)\uc640 \ud558(D) \uc774\ub3d9\uc744 \ub204\ub77d\ud588\uac70\ub098 \ud589\uacfc \uc5f4\uc758 \uc88c\ud45c \uc704\uce58\ub97c \ud63c\ub3d9\ud588\uc744 \ub54c \ubc1c\uc0dd\ud558\ub294 \uc624\ub958\uc774\ub2e4."
        },
        {
          "text": "(1, 2)",
          "isCorrect": false,
          "rationale": "\ub9c8\uc9c0\ub9c9 \ud558(D) \uc774\ub3d9 \uba85\ub839\uc744 \ubc18\uc601\ud558\uc9c0 \uc54a\uace0 \uc9c1\uc804 \uc88c\ud45c\uc5d0\uc11c \uba48\ucdc4\uc744 \ub54c \ubc1c\uc0dd\ud558\ub294 \uc624\ub2f5\uc774\ub2e4."
        }
      ],
      "hint": "\uc2dc\uc791 \uc704\uce58 (1, 1)\ubd80\ud130 \uac01 \ubc29\ud5a5 \uba85\ub839\uc5d0 \ub530\ub77c \ud589\uacfc \uc5f4\uc758 \ubcc0\ud654\ub97c \ucc28\ub840\ub300\ub85c \ucd94\uc801\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ubcf5\uc7a1\ud55c \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc27d\uac8c \uc791\uc740 \ubb38\uc81c\ub85c \ub098\ub204\ub294 '\ubb38\uc81c \ubd84\ud574' \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubd84\ud574\ub41c \uc791\uc740 \ub2e8\uc704 \ubb38\uc81c\ub4e4 \uc0ac\uc774\uc758 \uad00\uacc4\ub098 \ucc98\ub9ac \uc21c\uc11c\ub97c \uace0\ub824\ud558\uc5ec \ud574\uacb0 \uc21c\uc11c\ub97c \uc7a1\uc544\uc57c \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubb38\uc81c \ubd84\ud574 \uc2dc\uc5d0\ub294 \uac01 \uc791\uc740 \ubb38\uc81c \uac04\uc758 \uc5f0\uacb0 \uad00\uacc4\ub098 \uc120\ud6c4 \uad00\uacc4\ub97c \uc720\uc758\ud558\uc5ec \uc21c\uc11c\ub300\ub85c \ud574\uacb0\ud558\uace0 \uc885\ud569\ud574\uc57c \uc804\uccb4 \ubb38\uc81c\ub97c \ud574\uacb0\ud560 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\ubb38\uc81c \ud574\uacb0 \ub2a5\ub825\uc744 \ub192\uc774\uae30 \uc704\ud574 \ubd84\ud574\ub41c \ubb38\uc81c\ub294 \ud56d\uc0c1 \ubb34\ud55c\ud788 \uc791\uac8c \ub098\ub204\uc5b4\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb38\uc81c \ubd84\ud574\ub294 \ubb34\uc870\uac74 \uc791\uac8c \ub098\ub204\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ud574\uacb0 \uac00\ub2a5\ud55c \ud569\ub9ac\uc801\uc778 \ub2e8\uc704\ub85c \ub098\ub204\ub294 \uac83\uc774 \uc911\uc694\ud558\ub2e4."
        },
        {
          "text": "\ubb38\uc81c \ubd84\ud574\ub97c \uc644\ub8cc\ud558\uba74 \ubb38\uc81c \ud574\uacb0\uc5d0 \ubd88\ud544\uc694\ud55c \ubaa8\ub4e0 \ub370\uc774\ud130\uac00 \uc790\ub3d9\uc73c\ub85c \uc0ad\uc81c\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd88\ud544\uc694\ud55c \uc694\uc18c\ub97c \uc5c6\uc560\uace0 \ud544\uc694\ud55c \ud575\uc2ec \uc694\uc18c\ub97c \ubf51\uc544\ub0b4\ub294 \uac83\uc740 \ubd84\ud574 \uc774\ud6c4\uc758 \ud575\uc2ec \uc694\uc18c \ucd94\ucd9c \ub2e8\uacc4\uc774\ub2e4."
        },
        {
          "text": "\uc791\uc740 \ub2e8\uc704 \ubb38\uc81c\ub4e4\uc744 \ub3c5\ub9bd\uc801\uc73c\ub85c \ud574\uacb0\ud558\uba74 \uc6d0\ub798 \uc804\uccb4 \ubb38\uc81c\uc758 \ubaa9\uc801\uacfc \uc0c1\uad00\uc5c6\uc774 \ud574\uacb0\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubd84\ud574\ub41c \ubb38\uc81c\uc758 \uacb0\uacfc\ub97c \uc885\ud569\ud558\uc600\uc744 \ub54c \uc6d0\ub798 \uc804\uccb4 \ubb38\uc81c\ub97c \ud574\uacb0\ud560 \uc218 \uc788\ub3c4\ub85d \uc5f0\uacc4\uc131\uc744 \uc720\uc9c0\ud574\uc57c \ud55c\ub2e4."
        }
      ],
      "hint": "\uc791\uc740 \ubb38\uc81c\ub4e4 \uac04\uc758 \uc5f0\uad00\uc131\uacfc \uc120\ud6c4 \uad00\uacc4\ub97c \uace0\ub824\ud574\uc57c \uc804\uccb4 \ubb38\uc81c\ub97c \uc815\uc0c1\uc801\uc73c\ub85c \ud480 \uc218 \uc788\uc74c\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uce74\ud398 \ud0a4\uc624\uc2a4\ud06c \uc2dc\uc2a4\ud15c\uc744 \uad6c\ucd95\ud558\uae30 \uc704\ud574 '\uc8fc\ubb38 \ubc0f \uacb0\uc81c \uae08\uc561 \uc548\ub0b4' \uae30\ub2a5\uc744 \ucd94\uc0c1\ud654\ud558\ub824\uace0 \ud55c\ub2e4. \ub2e4\uc74c \uc911 '\uacb0\uc81c \uae08\uc561 \uacc4\uc0b0 \ubc0f \ucd9c\ub825'\uc774\ub77c\ub294 \ubaa9\uc801\uc744 \ub2ec\uc131\ud560 \ub54c \uc81c\uac70\ud574\uc57c \ud560 \ubd88\ud544\uc694\ud55c \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc190\ub2d8\uc758 \uc774\ub984 \ubc0f \uac1c\uc778 \uc5f0\ub77d\ucc98",
          "isCorrect": true,
          "rationale": "\uacb0\uc81c \uae08\uc561\uc744 \uacc4\uc0b0\ud558\uace0 \ucd9c\ub825\ud558\ub294 \ubb38\uc81c \ubaa9\uc801\uacfc \uc190\ub2d8\uc758 \uc774\ub984\uc774\ub098 \uc5f0\ub77d\ucc98\ub294 \uc9c1\uc811\uc801\uc778 \uad00\ub828\uc774 \uc5c6\uc73c\ubbc0\ub85c \uc81c\uac70 \ub300\uc0c1\uc774\ub2e4."
        },
        {
          "text": "\uc190\ub2d8\uc774 \uc120\ud0dd\ud55c \uba54\ub274\uba85",
          "isCorrect": false,
          "rationale": "\uba54\ub274\uc5d0 \ub530\ub77c \ub2e8\uac00\uac00 \ub2ec\ub77c\uc9c0\ubbc0\ub85c \uacb0\uc81c \uae08\uc561 \uacc4\uc0b0\uc5d0 \ubc18\ub4dc\uc2dc \ud544\uc694\ud55c \ud544\uc218 \ud575\uc2ec \uc694\uc18c\uc774\ub2e4."
        },
        {
          "text": "\uc120\ud0dd\ud55c \uac01 \uba54\ub274\uc758 \uc218\ub7c9",
          "isCorrect": false,
          "rationale": "\ucd1d \uae08\uc561\uc740 (\ub2e8\uac00 $\\times$ \uc218\ub7c9)\uc758 \ud569\uc73c\ub85c \uc0b0\ucd9c\ub418\ubbc0\ub85c \uc218\ub7c9\uc740 \ud575\uc2ec \uc694\uc18c\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\uac01 \uba54\ub274\ubcc4 \uc815\uac00(\uac00\uaca9)",
          "isCorrect": false,
          "rationale": "\uba54\ub274\uc758 \uac00\uaca9 \uc815\ubcf4\uac00 \uc5c6\uc73c\uba74 \uacb0\uc81c \uae08\uc561\uc744 \uacc4\uc0b0\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \ud544\uc218 \ud575\uc2ec \uc694\uc18c\uc774\ub2e4."
        }
      ],
      "hint": "\uba54\ub274 \uac00\uaca9 \uacc4\uc0b0\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\ub294 \uc815\ubcf4\ub97c \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc5ec\ub7ec \uc815\ubcf4\ub098 \ub370\uc774\ud130\uc758 \uad00\uacc4\ub97c \uc815\ub9ac\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 '\ud45c(Table)' \uad6c\uc870 \ubaa8\ub378\ub9c1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub370\uc774\ud130\ub97c \uac00\ub85c\ucd95(\ud589)\uacfc \uc138\ub85c\ucd95(\uc5f4)\uc73c\ub85c \ub098\ub204\uc5b4 \uc8fc\uc5b4\uc9c4 \uc870\uac74\uc774\ub098 \ud56d\ubaa9\uc744 \ud55c\ub208\uc5d0 \ube44\uad50\u00b7\ud3c9\uac00\ud558\uae30 \uc88b\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud45c \uad6c\uc870\ub294 \ud589\uacfc \uc5f4\uc744 \uc774\uc6a9\ud574 \uc870\uac74\uacfc \ub370\uc774\ud130\ub97c \uae54\ub054\ud558\uac8c \ubc30\uce58\ud558\uc5ec \ub2e4\uc218\uc758 \ube44\uad50 \ub300\uc0c1 \ubc0f \uae30\uc900\uc744 \ud55c\ub208\uc5d0 \ud30c\uc545\ud558\ub294 \ub370 \uc801\ud569\ud558\ub2e4."
        },
        {
          "text": "\ucd5c\uc0c1\uc704 \ub178\ub4dc\uc5d0\uc11c \uc2dc\uc791\ud574 \ud558\uc704 \ub178\ub4dc\ub85c \ubed7\uc5b4 \ub098\uac00\ub294 \uacc4\uce35\uc801 \ub370\uc774\ud130 \uad6c\uc870\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \ud45c \uad6c\uc870\uac00 \uc544\ub2c8\ub77c \ud2b8\ub9ac(Tree) \uad6c\uc870\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4."
        },
        {
          "text": "\ub178\ub4dc\uc640 \uac04\uc120\uc73c\ub85c \uad6c\uc131\ub418\uba70 \uc0ac\uc774\ud074(\uc21c\ud658 \uad6c\uc870)\uc744 \ud5c8\uc6a9\ud558\ub294 \ubcf5\ud569\uc801\uc778 \ub124\ud2b8\uc6cc\ud06c \ud615\ud0dc\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \ud45c \uad6c\uc870\uac00 \uc544\ub2c8\ub77c \uadf8\ub798\ud504(Graph) \uad6c\uc870\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4."
        },
        {
          "text": "\ub370\uc774\ud130 \uac04\uc5d0 \uc0c1\uc704-\ud558\uc704 \uad00\uacc4\uac00 \uba85\ud655\ud558\uc5ec \uc21c\ud658\uc774 \uc808\ub300\ub85c \ubd88\uac00\ub2a5\ud55c \uad6c\uc870\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774 \uc5ed\uc2dc \uacc4\uce35\uc801 \uc5f0\uacb0 \ud2b9\uc131\uc744 \uac16\ub294 \ud2b8\ub9ac(Tree) \uad6c\uc870\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4."
        }
      ],
      "hint": "\ud589(\uac00\ub85c)\uacfc \uc5f4(\uc138\ub85c)\uc744 \ud1b5\ud574 \uc5ec\ub7ec \uc870\uac74\uc744 \ub300\uc870\ud558\uace0 \uc815\ub9ac\ud558\ub294 \ud2b9\uc131\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud2b8\ub9ac(Tree) \uad6c\uc870\uc758 \ud2b9\uc9d5\uc5d0 \uad00\ud55c \uc124\uba85 \uc911 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud2b9\uc815 \ub178\ub4dc\uc5d0\uc11c \uc2dc\uc791\ud558\uc5ec \uac04\uc120\uc744 \uc9c0\ub098 \ub2e4\uc2dc \ucd9c\ubc1c\ud588\ub358 \ub178\ub4dc\ub85c \ub3cc\uc544\uc624\ub294 \uc0ac\uc774\ud074(\uc21c\ud658 \uad6c\uc870)\uc744 \ud5c8\uc6a9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud2b8\ub9ac \uad6c\uc870\ub294 \ub178\ub4dc \uac04 \uc0ac\uc774\ud074(\uc21c\ud658 \uad6c\uc870)\uc744 \uc808\ub300 \ud5c8\uc6a9\ud558\uc9c0 \uc54a\ub294 \uac83\uc774 \ud2b9\uc9d5\uc774\uba70, \uc0ac\uc774\ud074\uc744 \ud5c8\uc6a9\ud558\ub294 \uac83\uc740 \uadf8\ub798\ud504 \uad6c\uc870\uc774\ub2e4."
        },
        {
          "text": "\uc0c1\uc704 \ub178\ub4dc\uac00 \uc5c6\ub294 \ucd5c\uc0c1\uc704 \ub178\ub4dc\ub97c \ub8e8\ud2b8 \ub178\ub4dc(Root node)\ub77c\uace0 \ubd80\ub978\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud2b8\ub9ac\uc758 \ubfcc\ub9ac\uac00 \ub418\ub294 \uc81c\uc77c \uaf2d\ub300\uae30/\ucd5c\uc0c1\uc704 \ub178\ub4dc\ub294 \ub8e8\ud2b8 \ub178\ub4dc\uac00 \ub9de\ub2e4."
