      "hint": "\uacc4\uce35 \uad00\uacc4(\uc0c1\ud558), \ub124\ud2b8\uc6cc\ud06c \uc5f0\uacb0 \uad00\uacc4(\uc21c\ud658), \ud589/\uc5f4 \ube44\uad50 \ub370\uc774\ud130\uc758 \ud2b9\uc131\uc744 \ucc28\ub840\ub300\ub85c \ub9e4\uce6d\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "'\ucd94\uc0c1\ud654(Abstraction)'\uc640 '\ubaa8\ub378\ub9c1(Modeling)'\uc758 \uc0c1\ud638 \uad00\uacc4 \ubc0f \uac1c\ub150\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucd94\uc0c1\ud654\ub294 \ubcf5\uc7a1\uc131\uc744 \ub2e8\uc21c\ud654\ud558\ub294 \uc804\uccb4 \uacfc\uc815\uc774\uba70, \ubaa8\ub378\ub9c1\uc740 \ucd94\uc0c1\ud654\uc758 \ud55c \ub2e8\uacc4\ub85c\uc11c \ud575\uc2ec \uc694\uc18c \uac04\uc758 \uad00\uacc4\ub97c \ub2e8\uc21c\ud654\u00b7\uad6c\uc870\ud654\ud558\ub294 \uac83\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucd94\uc0c1\ud654\ub294 \ubb38\uc81c \ubd84\ud574, \ud575\uc2ec \uc694\uc18c \ucd94\ucd9c, \ubaa8\ub378\ub9c1 \uacfc\uc815\uc744 \ubaa8\ub450 \ud3ec\ud568\ud558\ub294 \uc885\ud569\uc801\uc778 \uac1c\ub150\uc774\ub2e4."
        },
        {
          "text": "\ubaa8\ub378\ub9c1\uc774 \uc644\ub8cc\ub41c \ud6c4 \ubb38\uc81c\uc758 \ubd88\ud544\uc694\ud55c \uc694\uc18c\ub97c \ucc3e\uc544 \uc0ad\uc81c\ud558\ub294 \uacfc\uc815\uc744 \ucd94\uc0c1\ud654\ub77c\uace0 \ubd80\ub978\ub2e4.",
