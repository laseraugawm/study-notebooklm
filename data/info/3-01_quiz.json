          "rationale": "\uc870\uc9c1 \uccb4\uacc4\ub294 \uacc4\uce35\uc801\uc774\ubbc0\ub85c \ud2b8\ub9ac\uac00 \uc801\ud569\ud558\uba70, \ud56d\uacf5 \ub178\uc120\ub9dd\uc740 \uc21c\ud658 \uac00\ub2a5\ud55c \uadf8\ub798\ud504\uac00 \uc801\ud569\ud558\ub2e4."
        },
        {
          "text": "(\u3131) \ud2b8\ub9ac, (\u3134) \ud45c, (\u3137) \uadf8\ub798\ud504",
          "isCorrect": false,
          "rationale": "\ub3c4\uc2dc \uac04 \uc5f0\uacb0\uc120\ub9dd\uc744 \ud45c\ub85c\ub9cc \ud45c\ud604\ud558\uae30\ubcf4\ub2e4 \uac04\uc120\uacfc \ub178\ub4dc\uac00 \uc788\ub294 \uadf8\ub798\ud504\ub85c \ub098\ud0c0\ub0b4\ub294 \uac83\uc774 \ub178\uc120 \ud30c\uc545\uc5d0 \ud6a8\uacfc\uc801\uc774\ub2e4."
        },
        {
          "text": "(\u3131) \ud45c, (\u3134) \uadf8\ub798\ud504, (\u3137) \ud2b8\ub9ac",
