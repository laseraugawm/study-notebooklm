        {
          "text": "\ucef4\ud4e8\ud130\uc758 \ub514\ub809\ud130\ub9ac(\ud3f4\ub354) \uad6c\uc870\ub098 \uc870\uc9c1\ub3c4, \uc0dd\ubb3c \ubd84\ub958 \uccb4\uacc4 \ub4f1\uc774 \ud2b8\ub9ac\uc758 \ub300\ud45c\uc801 \uc0ac\ub840\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud3f4\ub354 \uc0c1\uc704-\ud558\uc704 \uad6c\uc870\ub098 \uc870\uc9c1\ub3c4 \ub4f1\uc740 \uacc4\uce35\uc801 \uad6c\uc870\ub97c \ub764 \uc804\ud615\uc801\uc778 \ud2b8\ub9ac \ubaa8\ub378\ub9c1 \uc0ac\ub840\uc774\ub2e4."
        }
      ],
      "hint": "\ud2b8\ub9ac \uad6c\uc870\uc5d0\uc11c\ub294 \uc2dc\uc791\uc810\uc73c\ub85c \ub2e4\uc2dc \ub3cc\uc544\uc624\ub294 \uc21c\ud658\uc120(loop)\uc774 \uc874\uc7ac\ud558\ub294\uc9c0 \uc5ec\ubd80\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uadf8\ub798\ud504(Graph) \uad6c\uc870\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub370\uc774\ud130 \ud56d\ubaa9\uc744 \ub098\ud0c0\ub0b4\ub294 \ub178\ub4dc\uc640 \uc774\ub4e4 \uac04\uc758 \uad00\uacc4\ub97c \ub098\ud0c0\ub0b4\ub294 \uac04\uc120\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9c0\uba70, \uc0ac\uc774\ud074\uc744 \uac00\uc9c8 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uadf8\ub798\ud504\ub294 \ub178\ub4dc\uc640 \uac04\uc120\uc73c\ub85c \uc774\ub8e8\uc5b4\uc838 \ubcf5\uc7a1\ud55c \uc5f0\uacb0 \uad00\uacc4\ub97c \ub098\ud0c0\ub0b4\uba70, \ucd9c\ubc1c \ub178\ub4dc\ub85c \ub2e4\uc2dc \ub3cc\uc544\uc624\ub294 \uc21c\ud658 \uad6c\uc870(\uc0ac\uc774\ud074)\ub97c \ud5c8\uc6a9\ud55c\ub2e4."
        },
        {
          "text": "\uc0c1\uc704 \ub178\ub4dc\uc640 \ud558\uc704 \ub178\ub4dc\uac00 \uc5c4\uaca9\ud788 \uad6c\ubd84\ub418\uc5b4 \ubd80\ubaa8\uac00 \uc5c6\ub294 \ub178\ub4dc\uac00 \ubc18\ub4dc\uc2dc \ud558\ub098\ub9cc \uc874\uc7ac\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub8e8\ud2b8 \ub178\ub4dc\uac00 \uc874\uc7ac\ud558\ub294 \uacc4\uce35 \uad6c\uc870\ub294 \uadf8\ub798\ud504\uac00 \uc544\ub2c8\ub77c \ud2b8\ub9ac \uad6c\uc870\uc758 \ud2b9\uc9d5\uc774\ub2e4."
        },
        {
          "text": "\uac04\uc120\uc5d0\ub294 \uc808\ub300\ub85c \ubc29\ud5a5\uc131\uc774\ub098 \uac00\uc911\uce58(\uac70\ub9ac, \ube44\uc6a9 \ub4f1)\ub97c \ud45c\uc2dc\ud560 \uc218 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\uadf8\ub798\ud504\uc758 \uac04\uc120\uc5d0\ub294 \ud654\uc0b4\ud45c\ub85c \ubc29\ud5a5\uc744 \ud45c\uc2dc\ud558\uac70\ub098 \uac04\uc120 \uc704\uc5d0 \uac70\ub9ac/\uc2dc\uac04 \ub4f1\uc758 \ub370\uc774\ud130 \uac12\uc744 \uc9c0\uc815\ud560 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\ub370\uc774\ud130\ub97c \uac00\ub85c\ucd95\uacfc \uc138\ub85c\ucd95\uc5d0 \ub098\uc5f4\ud558\uc5ec \uc77c\ub300\uc77c\ub85c \ube44\uad50\ud558\ub294 2\ucc28\uc6d0 \uaca9\uc790 \ud615\ud0dc\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \uadf8\ub798\ud504\uac00 \uc544\ub2cc \ud45c(Table) \uad6c\uc870\uc5d0 \ub300\ud55c \uc124\uba85\uc774\ub2e4."
        }
      ],
      "hint": "\ub124\ud2b8\uc6cc\ud06c \ud615\ud0dc\ucc98\ub7fc \uc5f0\uacb0\ub418\uc5b4 \uc790\uc720\ub86d\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uace0 \ucd9c\ubc1c\uc810\uc73c\ub85c \uc7ac\ub3cc\uc544\uc62c \uc218\ub3c4 \uc788\ub294 \uad6c\uc870\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc2a4\ud0e0\ub9ac \ubc00\uadf8\ub7a8\uc758 6\ub2e8\uacc4 \ubd84\ub9ac \uc774\ub860\uc5d0 \uae30\ucd08\ud55c \uc0ac\ud68c \uad00\uacc4\ub9dd(\uc778\ub9e5) \uadf8\ub798\ud504 \ubd84\uc11d\uc5d0\uc11c '\uac00\uc7a5 \uc601\ud5a5\ub825\uc774 \uc788\ub294 \uce5c\uad6c'\ub97c \ucc3e\ub294 \uae30\uc900\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc2e0\uc744 \uc81c\uc678\ud55c \ubaa8\ub4e0 \uc0ac\ub78c\uae4c\uc9c0 \ub3c4\ub2ec\ud558\ub294 '\uce5c\uad6c \ub2e8\uacc4(\ucd5c\uc18c \uac70\uccd0 \uac00\ub294 \ub2e8\uacc4)'\uc758 \ud569\uc774 \uac00\uc7a5 \uc791\uc740 \uc0ac\ub78c",
          "isCorrect": true,
          "rationale": "\ubaa8\ub4e0 \uc778\ubb3c\uacfc\uc758 \ucd5c\uc18c \ub2e8\uacc4 \ud569(\uce5c\uad6c \uad00\uacc4\uc758 \ud569)\uc774 \uc791\uc744\uc218\ub85d \uadf8\ub798\ud504 \uc0c1\uc5d0\uc11c \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uacfc \ud3c9\uade0\uc801\uc73c\ub85c \uac00\uc7a5 \uac00\uae5d\uac8c \uc5f0\uacb0\ub41c \uc601\ud5a5\ub825 \uc788\ub294 \uc0ac\ub78c\uc774\ub2e4."
        },
        {
          "text": "\uc790\uc2e0\uacfc \uc9c1\uc811 \uc5f0\uacb0\ub41c \uac04\uc120\uc758 \uc218\uac00 \uac00\uc7a5 \uc801\uc5b4 \uad00\uacc4\uac00 \ub2e8\uc21c\ud55c \uc0ac\ub78c",
          "isCorrect": false,
          "rationale": "\uc9c1\uc811 \uc5f0\uacb0\ub41c \uac04\uc120 \uc218\uac00 \uc801\uc73c\uba74 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc5d0\uac8c \ub3c4\ub2ec\ud558\ub294 \uac70\ub9ac\uac00 \uae38\uc5b4\uc9c0\ubbc0\ub85c \uc601\ud5a5\ub825\uc774 \ub0ae\ub2e4."
        },
        {
          "text": "\uadf8\ub798\ud504\uc5d0\uc11c \ucd5c\uc0c1\uc704 \ub8e8\ud2b8 \ub178\ub4dc \uc704\uce58\ub97c \ucc28\uc9c0\ud558\uace0 \uc788\ub294 \uc0ac\ub78c",
          "isCorrect": false,
          "rationale": "\uadf8\ub798\ud504\ub294 \ud2b8\ub9ac\uac00 \uc544\ub2c8\ubbc0\ub85c \ubd80\ubaa8/\uc790\uc2dd \uad00\uacc4\ub098 \ucd5c\uc0c1\uc704 \ub8e8\ud2b8 \ub178\ub4dc\uac00 \uc874\uc7ac\ud558\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\uce5c\uad6c \ub2e8\uacc4\uc758 \ud569\uc774 \uac00\uc7a5 \ucee4\uc11c \uba40\ub9ac \ub5a8\uc5b4\uc838 \uc788\ub294 \uc0ac\ub78c\ub4e4\uacfc \ub9ce\uc774 \uc5f0\uacb0\ub41c \uc0ac\ub78c",
          "isCorrect": false,
          "rationale": "\uce5c\uad6c \ub2e8\uacc4\uc758 \ud569\uc774 \ud06c\ub2e4\ub294 \uac83\uc740 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc5d0\uac8c \ub3c4\ub2ec\ud558\uae30\uae4c\uc9c0 \ub9ce\uc740 \ub2e8\uacc4\ub97c \uac70\uccd0\uc57c \ud568\uc744 \ub73b\ud558\ubbc0\ub85c \uc601\ud5a5\ub825\uc774 \ub5a8\uc5b4\uc9c4\ub2e4."
        }
      ],
      "hint": "\ub2e4\ub978 \ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \ucd5c\uc18c\ud55c\uc758 \ub2e8\uacc4\ub97c \uac70\uccd0 \ube60\ub974\uac8c \ub2e4\uac00\uac08 \uc218 \uc788\ub294 \uc0ac\ub78c\uc758 \uc870\uac74(\ud569\uacc4 \uac12)\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c\uacfc \uac19\uc774 4\uba85(A, B, C, D)\uc758 \uce5c\uad6c \uad00\uacc4\uac00 \uac04\uc120\uc73c\ub85c \uc5f0\uacb0\ub41c \uc778\ub9e5 \uadf8\ub798\ud504\uac00 \uc788\ub2e4.\n- A\ub294 B, C\uc640 \uc9c1\uc811 \uc5f0\uacb0\ub428\n- B\ub294 A, C\uc640 \uc9c1\uc811 \uc5f0\uacb0\ub428\n- C\ub294 A, B, D\uc640 \uc9c1\uc811 \uc5f0\uacb0\ub428\n- D\ub294 C\uc640 \uc9c1\uc811 \uc5f0\uacb0\ub428\n\n\uc774 \uc778\ub9e5 \uadf8\ub798\ud504\uc5d0\uc11c \uac01 \uc778\ubb3c\ubcc4 '\uce5c\uad6c \uad00\uacc4\uc758 \ud569(\ubaa8\ub4e0 \uc0ac\ub78c\uae4c\uc9c0\uc758 \ucd5c\ub2e8 \ub2e8\uacc4 \ud569)'\uc744 \uad6c\ud588\uc744 \ub54c, \uac00\uc7a5 \uc601\ud5a5\ub825 \uc788\ub294 \uc0ac\ub78c\uacfc \uadf8 \ud569\uc758 \uac12\uc740 \uc5bc\ub9c8\uc778\uac00?",
      "answerOptions": [
        {
          "text": "C, 3",
          "isCorrect": true,
          "rationale": "C\uc5d0\uc11c A\uae4c\uc9c0 1, B\uae4c\uc9c0 1, D\uae4c\uc9c0 1\uc774\ubbc0\ub85c C\uc758 \ud569\uc740 $1+1+1=3$\uc73c\ub85c \uac00\uc7a5 \uc791\ub2e4. (A: $1+1+2=4$, B: $1+1+2=4$, D: $1+2+2=5$)"
        },
        {
          "text": "A, 4",
          "isCorrect": false,
          "rationale": "A\uc758 \ub2e8\uacc4 \ud569\uc740 B(1) + C(1) + D(2) = 4\ub85c, C\uc758 \ub2e8\uacc4 \ud569(3)\ubcf4\ub2e4 \ud06c\ubbc0\ub85c \ucd5c\uace0 \uc601\ud5a5\ub825\uc790\uac00 \uc544\ub2c8\ub2e4."
        },
        {
          "text": "B, 4",
          "isCorrect": false,
          "rationale": "B\uc758 \ub2e8\uacc4 \ud569\uc740 A(1) + C(1) + D(2) = 4\ub85c, C\ubcf4\ub2e4 \ud569\uc774 \ud06c\ub2e4."
        },
        {
          "text": "D, 5",
          "isCorrect": false,
          "rationale": "D\uc758 \ub2e8\uacc4 \ud569\uc740 C(1) + A(2) + B(2) = 5\ub85c \uac00\uc7a5 \ud06c\uae30 \ub54c\ubb38\uc5d0 \uac00\uc7a5 \uc601\ud5a5\ub825\uc774 \uc801\ub2e4."
        }
      ],
      "hint": "C\ub294 A, B, D \uc138 \uc0ac\ub78c \ubaa8\ub450\uc640 direct(1\ub2e8\uacc4)\ub85c \uc5f0\uacb0\ub418\uc5b4 \uc788\ub2e4\ub294 \uc810\uc5d0 \uc8fc\ubaa9\ud574 \uacc4\uc0b0\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc138 \uac00\uc9c0 \ub370\uc774\ud130\ub97c \uac00\uc7a5 \uc801\uc808\ud558\uac8c \ud45c\ud604\ud560 \uc218 \uc788\ub294 \ubaa8\ub378\ub9c1 \uad6c\uc870(\ud45c, \ud2b8\ub9ac, \uadf8\ub798\ud504)\ub97c \uc21c\uc11c\ub300\ub85c \ubc14\ub974\uac8c \uc9dd\uc9c0\uc740 \uac83\uc740?\n\n(\u3131) \ud68c\uc0ac\uc758 \ub300\ud45c\uc774\uc0ac - \ubcf8\ubd80\uc7a5 - \ud300\uc7a5 - \ud300\uc6d0\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \uc0c1\ud558 \uc870\uc9c1 \uad6c\uc870\n(\u3134) \uc804\uad6d \uac01 \ub3c4\uc2dc \uac04\uc758 \ud56d\uacf5 \ub178\uc120\ub9dd \ubc0f \uc6b4\ud56d \uc2dc\uac04\n(\u3137) \ub180\uc774\uacf5\uc6d0\uc758 \uc774\uc6a9\uad8c \uc885\ub958\ubcc4(\uc8fc\uac04, \uc57c\uac04) \uc5f0\ub839\ub300\ubcc4 \uc694\uae08 \ube44\uad50\ud45c",
      "answerOptions": [
