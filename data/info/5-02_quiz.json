{
  "title": "\uc815\ubcf4\ubcf4\uc548 \ud034\uc988",
  "questions": [
    {
      "question": "\uac1c\uc778 \uc815\ubcf4 \ube44\uc2dd\ubcc4 \uc870\uce58 \uae30\uc220 \uc911 '\uc775\uba85 \uc815\ubcf4'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud2b9\uc815\uc778\uc744 \uc54c\uc544\ubcfc \uc218 \uc788\ub294 \ud575\uc2ec \uc2dd\ubcc4 \uc815\ubcf4\ub97c \uc644\uc804\ud788 \uc81c\uac70\ud558\uc5ec \uc0c1\uc5c5\uc801 \ubaa9\uc801\uc73c\ub85c\ub3c4 \uc790\uc720\ub86d\uac8c \ud65c\uc6a9\uc774 \uac00\ub2a5\ud558\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2dd\ubcc4 \uc694\uc18c\ub97c \uc644\uc804\ud788 \uc81c\uac70\ud55c \uc775\uba85 \uc815\ubcf4\ub294 \ud2b9\uc815 \uac1c\uc778\uc744 \uc7ac\uc2dd\ubcc4\ud560 \uc218 \uc5c6\uc5b4 \uc0c1\uc5c5\uc801 \uc774\uc6a9\uc744 \ud3ec\ud568\ud574 \uc790\uc720\ub86d\uac8c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc774\ub984\uc774\ub098 \uc5f0\ub77d\ucc98\uc758 \uc77c\ubd80\ub97c \uac00\ub9b0 \uc815\ubcf4\ub85c, \ud559\uc220 \uc5f0\uad6c\ub098 \ud1b5\uacc4 \uc791\uc131 \ub4f1\uc758 \ubaa9\uc801\uc73c\ub85c\ub9cc \ud55c\uc815\ud558\uc5ec \uc0ac\uc6a9\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud2b9\uc815\uc778\uc744 \uc9c1\uc811 \uc54c\uc544\ubcfc \uc218 \uc5c6\ub3c4\ub85d \uc77c\ubd80\ub97c \uac00\ub824 \ud559\uc220 \ubc0f \ud1b5\uacc4 \ubaa9\uc801 \ub4f1\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \uac83\uc740 \uac00\uba85 \uc815\ubcf4\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uac1c\uc778\uc774 \uc790\uc2e0\uc758 \uc815\ubcf4 \uc18c\uc720\uad8c\uc744 \uac00\uc9c0\uba70 \uae08\uc735\uae30\uad00 \ub4f1\uc5d0 \uc9c1\uc811 \uc120\ubcc4\ud558\uc5ec \uc81c\uacf5\ud558\ub294 \ub370\uc774\ud130 \ubd84\uc11d \ubc29\uc2dd\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uc774 \uc790\uc2e0\uc758 \ub370\uc774\ud130 \uc18c\uc720\uad8c\uc744 \uac00\uc9c0\uace0 \uc9c1\uc811 \uad00\ub9ac \ubc0f \uc81c\uacf5\ud558\ub294 \uc0ac\uc5c5 \ubc29\uc2dd\uc740 \ub9c8\uc774\ub370\uc774\ud130\uc5d0 \ub300\ud55c \uc124\uba85\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubcf4 \uc8fc\uccb4\uc758 \uc0ac\uc804 \ub3d9\uc758\uac00 \uc788\uc5b4\uc57c\ub9cc \uc81c3\uc790\uc5d0\uac8c \uc720\uc0c1\uc73c\ub85c \uc81c\uacf5\ud558\uac70\ub098 \ub9e4\ub9e4\ud560 \uc218 \uc788\ub294 \uc815\ubcf4\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc775\uba85 \uc815\ubcf4\ub294 \uac1c\uc778 \uc815\ubcf4\uac00 \uc644\uc804\ud788 \ube44\uc2dd\ubcc4\ud654\ub41c \uc0c1\ud0dc\uc774\ubbc0\ub85c \uc815\ubcf4 \uc8fc\uccb4\uc758 \ub3d9\uc758 \uc5c6\uc774\ub3c4 \uc0c1\uc5c5\uc801\uc73c\ub85c \ud65c\uc6a9\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc2dd\ubcc4 \uc815\ubcf4\uc758 \uc644\uc804\ud55c \uc81c\uac70 \uc218\uc900\uacfc \ud65c\uc6a9 \uac00\ub2a5\ud55c \ubaa9\uc801 \ubc94\uc704(\uc0c1\uc5c5\uc801 \uc774\uc6a9 \ud3ec\ud568 \uc5ec\ubd80)\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc815\ubcf4 \ubcf4\uc548\uc758 3\uc694\uc18c \uc911 \ud558\ub098\uc778 '\ubb34\uacb0\uc131(Integrity)'\uc744 \uc704\ud611\ubc1b\uc740 \uc0c1\ud669\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc778\uac00\ub418\uc9c0 \uc54a\uc740 \uc0ac\uc6a9\uc790\uac00 \uc2dc\uc2a4\ud15c\uc758 \uc544\uc774\ub514\uc640 \ube44\ubc00\ubc88\ud638\ub97c \uc54c\uc544\ub0b4 \ubb34\ub2e8\uc73c\ub85c \uc811\uc18d\ud558\uc5ec \uac1c\uc778 \uc815\ubcf4\ub97c \uc5f4\ub78c\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud5c8\uac00\ub418\uc9c0 \uc54a\uc740 \uc0ac\ub78c\uc774 \uc815\ubcf4\uc5d0 \uc811\uadfc\ud558\uc5ec \ud655\uc778\ud55c \uc0c1\ud669\uc740 \uae30\ubc00\uc131\uc774 \uce68\ud574\ub41c \uc0ac\ub840\uc785\ub2c8\ub2e4."
        },
        {
          "text": "DDoS \uacf5\uaca9\uc73c\ub85c \uc778\ud574 \uc11c\ubc84\uac00 \uacfc\ubd80\ud558\ub418\uc5b4 \uc815\uc791 \ud544\uc694\ud55c \uc2dc\uc810\uc5d0 \uc815\uc0c1\uc801\uc778 \uc0ac\uc6a9\uc790\uac00 \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud558\uc9c0 \ubabb\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud5c8\uac00\ub41c \uc0ac\uc6a9\uc790\uac00 \uc6d0\ud558\ub294 \uc2dc\uc810\uc5d0 \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud560 \uc218 \uc5c6\uac8c \ubc29\ud574\ubc1b\ub294 \uc0c1\ud669\uc740 \uac00\uc6a9\uc131\uc774 \uce68\ud574\ub41c \uc0ac\ub840\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc545\uc758\uc801\uc778 \ud574\ucee4\uac00 \uc2dc\uc2a4\ud15c \ub0b4\ubd80 \uc11c\ubc84\uc5d0 \uce68\uc785\ud558\uc5ec \uc6d0\ubcf8 \ub370\uc774\ud130 \ud30c\uc77c\uc758 \uc218\uce58\uc640 \uc800\uc7a5 \ub0b4\uc6a9\uc744 \ubb34\ub2e8\uc73c\ub85c \uc218\uc815\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud5c8\uac00\ubc1b\uc9c0 \uc54a\uc740 \uc778\uc6d0\uc5d0 \uc758\ud574 \uc815\ubcf4\uc758 \ub0b4\uc6a9\uc774 \uc784\uc758\ub85c \ubcc0\uacbd\ub418\uac70\ub098 \ubcc0\uc870\ub418\ub294 \uac83\uc740 \ubb34\uacb0\uc131\uc744 \uce68\ud574\ud558\ub294 \ud589\uc704\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubc18\ub824\ub3d9\ubb3c\uc6a9 IP \uce74\uba54\ub77c\uc778 \uc0ac\ubb3c \uc778\ud130\ub137 \uae30\uae30\uac00 \ud574\ud0b9\ub418\uc5b4 \uc9d1 \ub0b4\ubd80 \uc601\uc0c1\uc774 \uc678\ubd80 \ub124\ud2b8\uc6cc\ud06c\ub85c \uc720\ucd9c\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub0b4\ubd80 \ubaa8\uc2b5\uc774 \ud5c8\uac00 \uc5c6\uc774 \uc678\ubd80\ub85c \ub178\ucd9c\ub418\uc5b4 \ud37c\uc838\ub098\uac04 \uac83\uc740 \uae30\ubc00\uc131 \uc704\ud611 \ubc0f \uc811\uadfc\u00b7\uc720\ucd9c \ubc94\uc8fc\uc5d0 \uc18d\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc815\ubcf4\uac00 \ud5c8\uac00 \uc5c6\uc774 \ubcc0\uacbd\ub418\uac70\ub098 \ubcc0\uc870\ub418\uc9c0 \uc54a\uace0 \uc815\ud655\uc131\uacfc \uc644\ubcbd\ud568\uc744 \uc720\uc9c0\ud574\uc57c \ud55c\ub2e4\ub294 \uc6d0\uce59\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc0ac\uc6a9\uc790 \uc778\uc99d \uae30\uc220\uc758 \ubd84\ub958 \uc911 '\uc18c\uc720 \uae30\ubc18 \uc778\uc99d' \uc218\ub2e8\uc5d0\ub9cc \ud574\ub2f9\ud558\ub294 \uc870\ud569\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ud328\uc2a4\uc6cc\ub4dc, PIN \ubc88\ud638, \ud328\ud134",
          "isCorrect": false,
          "rationale": "\ud328\uc2a4\uc6cc\ub4dc, PIN \ubc88\ud638, \ud328\ud134 \ub4f1 \uc0ac\uc6a9\uc790\uac00 \uba38\ub9bf\uc18d\uc5d0 \uae30\uc5b5\ud558\uace0 \uc788\ub294 \uc815\ubcf4\ub294 \uc9c0\uc2dd \uae30\ubc18 \uc778\uc99d\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\ubb38, \ud64d\ucc44, \uc815\ub9e5 \uc778\uc2dd",
          "isCorrect": false,
          "rationale": "\uc9c0\ubb38\uc774\ub098 \ud64d\ucc44, \uc815\ub9e5 \ub4f1 \uc2e0\uccb4\uc801 \ud2b9\uc9d5\uc744 \ud65c\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \uc0dd\uccb4 \uae30\ubc18 \uc778\uc99d\uc5d0 \uc18d\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uacf5\uc778 \uc778\uc99d\uc11c, \ubcf4\uc548 \ud1a0\ud070, OTP \uce74\ub4dc",
          "isCorrect": true,
          "rationale": "\ubcf4\uc548 \ud1a0\ud070, \uc2a4\ub9c8\ud2b8 \uce74\ub4dc, OTP \uce74\ub4dc \ub4f1 \uc0ac\uc6a9\uc790\uac00 \ubb3c\ub9ac\uc801\uc73c\ub85c \uc18c\uc9c0\ud558\uace0 \uc788\ub294 \ub9e4\uccb4\ub97c \ud1b5\ud55c \ubc29\uc2dd\uc774 \uc18c\uc720 \uae30\ubc18 \uc778\uc99d\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc5bc\uad74 \uc778\uc2dd, \uc2a4\ub9c8\ud2b8 \uce74\ub4dc, \ud328\uc2a4\uc6cc\ub4dc",
          "isCorrect": false,
          "rationale": "\uc0dd\uccb4 \uae30\ubc18(\uc5bc\uad74 \uc778\uc2dd), \uc18c\uc720 \uae30\ubc18(\uc2a4\ub9c8\ud2b8 \uce74\ub4dc), \uc9c0\uc2dd \uae30\ubc18(\ud328\uc2a4\uc6cc\ub4dc) \uc218\ub2e8\uc774 \uc11c\ub85c \ud63c\ud569\ub41c \uad6c\uc131\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0ac\uc6a9\uc790\uac00 \ubb3c\ub9ac\uc801 \ud615\ud0dc\ub098 \ub370\uc774\ud130 \ud615\ud0dc\ub85c \uc9c1\uc811 \uc18c\uc9c0\ud558\uace0 \uac00\uc9c0\uace0 \ub2e4\ub2c8\ub294 \uc778\uc99d \ub9e4\uccb4\ub97c \ucc3e\uc73c\uc138\uc694."
    },
    {
      "question": "\ub124\ud2b8\uc6cc\ud06c \ubcf4\uc548 \uae30\uc220 \uc911, \ud2b8\ub798\ud53d\uc744 \ubcf5\uc0ac\ud558\uc5ec \uc774\uc0c1 \uc9d5\ud6c4\ub97c \ud0d0\uc9c0\ud558\uace0 \ub85c\uadf8 \ud30c\uc77c \uc218\uc9d1 \ubc0f \ubd84\uc11d\uc744 \uc218\ud589\ud558\ub294 \uc2dc\uc2a4\ud15c\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uce68\uc785 \ud0d0\uc9c0 \uc2dc\uc2a4\ud15c (IDS)",
          "isCorrect": true,
          "rationale": "IDS\ub294 \ub124\ud2b8\uc6cc\ud06c \ud2b8\ub798\ud53d\uc744 \ubcf5\uc0ac\ud558\uc5ec \ubd88\ubc95\uc801\uc778 \uce68\uc785\uc744 \uac10\uc2dc, \ud0d0\uc9c0\ud558\uace0 \ub85c\uadf8\ub97c \uc218\uc9d1\ud558\uc5ec \uad00\ub9ac\uc790\uc5d0\uac8c \uc54c\ub9ac\ub294 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uce68\uc785 \ubc29\uc9c0 \uc2dc\uc2a4\ud15c (IPS)",
          "isCorrect": false,
          "rationale": "IPS\ub294 \ud0d0\uc9c0\uc5d0 \uadf8\uce58\uc9c0 \uc54a\uace0 \uc798\ubabb\ub41c \ud1b5\uc2e0\uc774\ub098 \uce68\uc785 \uc2dc\ub3c4\ub97c \uc2e4\uc2dc\uac04\uc73c\ub85c \uc778\ub77c\uc778\uc5d0\uc11c \ucc28\ub2e8 \ubc0f \ubc29\uc5b4\ud558\ub294 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubc29\ud654\ubcbd (Firewall)",
          "isCorrect": false,
          "rationale": "\ubc29\ud654\ubcbd\uc740 \ud5c8\uac00\ubc1b\uc9c0 \uc54a\uc740 \uc678\ubd80\uc758 \ubd88\ubc95 \uce68\uc785\uc744 \ub9c9\uace0 \uc815\uc0c1\uc801\uc778 \uc811\uadfc\ub9cc \ud328\ud0b7 \uc218\uc900\uc5d0\uc11c \ud5c8\uc6a9 \ub610\ub294 \ucc28\ub2e8\ud558\ub294 \uae30\uc220\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ube14\ub85d\uccb4\uc778 \ubcf4\uc548 (Blockchain)",
          "isCorrect": false,
          "rationale": "\ube14\ub85d\uccb4\uc778\uc740 \ub370\uc774\ud130\ub97c \ubd84\uc0b0\ud558\uc5ec \uad00\ub9ac\ud558\uace0 \ub514\uc9c0\ud138 \uc11c\uba85\uc744 \ud1b5\ud574 \ubb34\ub2e8 \ubcc0\uacbd\uc744 \ubc29\uc9c0\ud558\ub294 \ubd84\uc0b0 \uc800\uc7a5 \uae30\uc220\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc2e4\uc2dc\uac04 \uc9c1\uc811 \ucc28\ub2e8 \ub3d9\uc791\ubcf4\ub2e4\ub294 \ud328\ud0b7 \uac10\uc2dc \ubc0f \uacbd\uace0, \ub85c\uadf8 \uc218\uc9d1\uc5d0 \uc911\uc810\uc744 \ub454 \ud0d0\uc9c0 \uc804\uc6a9 \uc2dc\uc2a4\ud15c\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 \ubcf4\ud638\ud574\uc57c \ud560 '\uac1c\uc778 \uc815\ubcf4'\uc758 \uc885\ub958\uc640 \uc608\uc2dc\uac00 \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ub418\uc9c0 \uc54a\uc740 \uac83\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc778\uc801 \uc0ac\ud56d - \uc774\ub984, \uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638, \uc8fc\uc18c, \uc5f0\ub77d\ucc98",
          "isCorrect": false,
          "rationale": "\uc774\ub984, \uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638, \uc8fc\uc18c \ub4f1\uc740 \uac1c\uc778\uc774 \uac00\uc9c4 \ub300\ud45c\uc801\uc778 \uc778\uc801 \uc0ac\ud56d \uc815\ubcf4\uc5d0 \ub9de\uac8c \uc5f0\uacb0\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e0\uccb4\uc801 \uc815\ubcf4 - \uc5bc\uad74, \ud64d\ucc44, \uc9c0\ubb38, \uc758\ub8cc \uae30\ub85d",
          "isCorrect": false,
          "rationale": "\uc5bc\uad74, \uc9c0\ubb38 \ub4f1 \uc0dd\uccb4 \uc815\ubcf4\uc640 \uc9c4\ub8cc/\uc758\ub8cc \uae30\ub85d\uc740 \uc2e0\uccb4\uc801 \uc815\ubcf4\uc758 \ubc94\uc8fc\uc5d0 \ub4e4\uc5b4\uac11\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\uc2e0\uc801 \uc815\ubcf4 - \ud559\ub825, \ubcd1\uc5ed \uc815\ubcf4, \uc804\uacfc \uae30\ub85d, \uacfc\ud0dc\ub8cc \ub0a9\ubd80 \ub0b4\uc5ed",
          "isCorrect": true,
          "rationale": "\ud559\ub825, \ubcd1\uc5ed \uc815\ubcf4, \uc804\uacfc \uae30\ub85d, \uacfc\ud0dc\ub8cc \ub0a9\ubd80 \ub0b4\uc5ed\uc740 \uc815\uc2e0\uc801 \uc815\ubcf4\uac00 \uc544\ub2c8\ub77c '\uc0ac\ud68c\uc801 \uc815\ubcf4'\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc7ac\uc0b0\uc801 \uc815\ubcf4 - \uc6d4\uae09, \uc2e0\uc6a9\uce74\ub4dc \ubc88\ud638, \uacc4\uc88c \ubc88\ud638, \uc18c\uc720 \uc8fc\ud0dd",
          "isCorrect": false,
          "rationale": "\uc6d4\uae09, \uacc4\uc88c \ubc88\ud638, \uc2e0\uc6a9\uce74\ub4dc \ubc0f \uc18c\uc720 \uc790\uc0b0 \uc815\ubcf4\ub294 \uc7ac\uc0b0\uc801 \uc815\ubcf4\ub85c \uc815\ud655\ud788 \ubd84\ub958\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud559\ub825\uc774\ub098 \ubcd1\uc5ed, \uc804\uacfc \uae30\ub85d \ub4f1 \uc0ac\ud68c\uc0dd\ud65c \uacfc\uc815\uc5d0\uc11c \uc0dd\uc131\ub418\ub294 \uc815\ubcf4\uc758 \uc815\ud655\ud55c \uba85\uce6d\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uacf5\uc720\ud560 \uc218 \uc788\ub294 \uc815\ubcf4\uc778 '\uc624\ud508 \uc18c\uc2a4 \uc18c\ud504\ud2b8\uc6e8\uc5b4'\uc758 \ud2b9\uc131\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc18c\uc2a4 \ucf54\ub4dc\uac00 \uacf5\uac1c\ub418\uc5b4 \uc788\uc73c\ubbc0\ub85c \ub204\uad6c\ub098 \ubb34\ub8cc\ub85c \uc774\uc6a9\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc624\ud508 \uc18c\uc2a4\ub294 \ud504\ub85c\uadf8\ub7a8\uc758 \uc800\uc791\uad8c\uc790\uac00 \uc18c\uc2a4 \ucf54\ub4dc\ub97c \uc5f4\ub78c \uac00\ub2a5\ud558\ub3c4\ub85d \uacf5\uac1c\ud558\uc5ec \ubb34\uc0c1 \uc0ac\uc6a9\uc744 \ud5c8\uc6a9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud5c8\uac00\ub41c \uc0ac\uc6a9\uc790\uc5d0 \ud55c\ud574\uc11c\ub9cc \ucf54\ub4dc\ub97c \uc218\uc815\ud560 \uc218 \uc788\uace0 \uc7ac\ubc30\ud3ec\ub294 \uc6d0\ucc9c\uc801\uc73c\ub85c \uae08\uc9c0\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc624\ud508 \uc18c\uc2a4 \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub294 \ub204\uad6c\ub098 \ucf54\ub4dc\ub97c \uc790\uc720\ub86d\uac8c \uc218\uc815\ud558\uace0 \ub2e4\uc2dc \ubc30\ud3ec(\uc7ac\ubc30\ud3ec)\ud560 \uc218 \uc788\ub294 \uad8c\ub9ac\ub97c \ubd80\uc5ec\ud569\ub2c8\ub2e4."
        },
        {
