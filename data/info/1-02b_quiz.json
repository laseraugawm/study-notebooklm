{
  "title": "\uc0ac\ubb3c\uc778\ud130\ub137 \ud034\uc988",
  "questions": [
    {
      "question": "\uc0dd\ud65c \uc18d \uc0ac\ubb3c \uc778\ud130\ub137(IoT) \uc2dc\uc2a4\ud15c\uc744 \uad6c\uc131\ud558\uae30 \uc704\ud55c \ud544\uc218 \uc694\uc18c\ub85c \uad50\uacfc\uc11c\uc5d0 \uc81c\uc2dc\ub41c 3\uac00\uc9c0 \uad6c\uc131 \uc7a5\uce58\uc5d0 \ud574\ub2f9\ud558\uc9c0 \uc54a\ub294 \uac83\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc8fc\ubcc0 \uc0c1\ud0dc\ub098 \ubb3c\ub9ac\uc801 \ubcc0\ud654\ub97c \uc778\uc9c0\ud558\ub294 \uc13c\uc11c",
          "rationale": "\uc13c\uc11c\ub294 \uc0ac\ubb3c \uc8fc\ubcc0 \ud658\uacbd\uc774\ub098 \uc790\uadf9\uc744 \uc778\uc9c0\ud558\uae30 \uc704\ud574 \ubc18\ub4dc\uc2dc \ud544\uc694\ud55c \uae30\ubcf8 \uad6c\uc131 \uc694\uc18c\uc774\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0ac\ubb3c \uac04 \ub370\uc774\ud130\ub97c \uc8fc\uace0\ubc1b\uae30 \uc704\ud55c \ud1b5\uc2e0 \uc7a5\uce58",
          "rationale": "\uc0ac\ubb3c\ub07c\ub9ac \uc5f0\uacb0\ub418\uac70\ub098 \uc81c\uc5b4 \uc2e0\ud638\ub97c \uc8fc\uace0\ubc1b\uae30 \uc704\ud574\uc11c\ub294 \ubb34\uc120 \ub4f1\uc758 \ud1b5\uc2e0 \uc7a5\uce58\uac00 \ud544\uc694\ud558\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc13c\uc11c \uc2e0\ud638\ub97c \ubc1b\uc544 \uc0ac\ubb3c\uc758 \ub3d9\uc791\uc744 \uc81c\uc5b4\ud558\ub294 \ucc98\ub9ac \uc7a5\uce58",
          "rationale": "\uc785\ub825\ub41c \uc815\ubcf4\ub97c \ubc14\ud0d5\uc73c\ub85c \ub3d9\uc791\uc744 \uacb0\uc815\ud558\uace0 \uc81c\uc5b4\ud558\uae30 \uc704\ud574\uc11c\ub294 \ucc98\ub9ac \uc7a5\uce58\uac00 \uc694\uad6c\ub41c\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud654\uba74 \uadf8\ub798\ud53d\uc744 \uace0\uc18d\uc73c\ub85c \ucc98\ub9ac\ud558\ub294 \uc804\uc6a9 \uadf8\ub798\ud53d \uce74\ub4dc\uc758 \ucc98\ub9ac \uc7a5\uce58",
          "rationale": "\uace0\uc131\ub2a5 \uadf8\ub798\ud53d \ucc98\ub9ac\ub294 \uc77c\ubc18\uc801\uc778 \uc0ac\ubb3c \uc778\ud130\ub137 \uc2dc\uc2a4\ud15c\uc744 \uad6c\uc131\ud558\ub294 \ud544\uc218 3\ub300 \uad6c\uc131 \uc7a5\uce58(\uc13c\uc11c, \ud1b5\uc2e0 \uc7a5\uce58, \uc81c\uc5b4/\ucc98\ub9ac \uc7a5\uce58)\uc5d0 \ud3ec\ud568\ub418\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": true
        }
      ],
      "hint": "\uc0ac\ubb3c\uc774 \uc8fc\ubcc0\uc744 \uc778\uc9c0\ud558\uace0, \uc2e0\ud638\ub97c \uc804\ub2ec\ud558\uba70, \ud574\ub2f9 \ub3d9\uc791\uc744 \uacb0\uc815\ud574 \uad6c\ub3d9\ud558\ub294 \uae30\ubcf8 \ud750\ub984\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uc758 \ub0b4\uc7a5 \ub9c8\uc774\ud06c\ub97c \uc774\uc6a9\ud558\uc5ec \uc190\ubf09 \uc18c\ub9ac\ub85c LED(\uc804\ub4f1)\ub97c \ucf1c\uace0 \ub044\ub294 \uc2e4\uc2b5 \uc911, \ud070 \uc18c\ub9ac\ub97c \uac10\uc9c0\ud55c \uc9c1\ud6c4 0.5\ucd08 \ub3d9\uc548 \uc77c\uc2dc \uc911\uc9c0\ud558\ub294 \ucf54\ub4dc\ub97c \ud3ec\ud568\ud558\ub294 \uc8fc\uc694 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ub9c8\uc774\ud06c \uc13c\uc11c\uc758 \uc804\ub825 \uc18c\ube44\ub97c \uc904\uc774\uae30 \uc704\ud574",
          "rationale": "0.5\ucd08 \ub300\uae30 \ucf54\ub4dc\ub294 \uc804\ub825 \uc808\uac10 \ud6a8\uacfc\uc640 \uc9c1\uc811\uc801\uc778 \uad00\ub828\uc774 \uc5c6\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc190\ubf09\uc744 \ud55c \ubc88 \ucce4\uc744 \ub54c \uc5ec\ub7ec \ubc88 \uce5c \uac83\uc73c\ub85c \uc911\ubcf5 \uc778\uc2dd\ub418\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574",
          "rationale": "\uc190\ubf09\uc744 \uce60 \ub54c \ubc1c\uc0dd\ud55c \uc785\ub825 \uc2e0\ud638\uac00 \uc5f0\uc1c4\uc801\uc73c\ub85c \uc5ec\ub7ec \ubc88 \uc778\uc2dd\ub418\uc5b4 \uc804\ub4f1\uc774 \ub73b\ud558\uc9c0 \uc54a\uac8c \uacc4\uc18d \ucf1c\uc9c0\uace0 \uaebc\uc9c0\ub294 \ubb38\uc81c\ub97c \ub9c9\uc544\uc900\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc18c\ub9ac \uac10\uc9c0 \uae30\uc900 \uac12(100)\uc744 \uc8fc\ubcc0 \ud658\uacbd\uc5d0 \ub9de\uac8c \uc790\ub3d9 \uc7ac\uc124\uc815\ud558\uae30 \uc704\ud574",
          "rationale": "\uc18c\ub9ac \uac10\uc9c0 \uae30\uc900\uac12\uc740 \uc0ac\uc6a9\uc790\uac00 \uc9c1\uc811 \uc124\uc815\ud558\ub294 \uac12\uc774\uba70, \uc77c\uc2dc \uc911\uc9c0 \ub3d9\uc791\uc774 \uae30\uc900\uac12\uc744 \uc7ac\uc124\uc815\ud574\uc8fc\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "LED\uc758 \ubc1d\uae30\ub97c \ucd5c\ub300 \ub2e8\uacc4\ub85c \uc77c\uc815\ud558\uac8c \uc720\uc9c0\ud558\uae30 \uc704\ud574",
          "rationale": "\uc77c\uc2dc \uc911\uc9c0\ub294 \uc785\ub825 \uc2e0\ud638\uc758 \uc624\uc778\uc2dd\uc744 \ubc29\uc9c0\ud558\ub294 \ud750\ub984 \uc81c\uc5b4 \uc5ed\ud560\uc774\uba70 LED \ubc1d\uae30\uc640\ub294 \ubb34\uad00\ud558\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubc15\uc218\ub97c \ud55c \ubc88\ub9cc \ucce4\uc744 \ub54c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc785\ub825\uc758 \uc911\ubcf5 \ucc98\ub9ac \ubb38\uc81c\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc190\ubf09\uc744 \uccd0\uc11c LED\ub97c \uc81c\uc5b4\ud558\ub294 \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \ud504\ub85c\uadf8\ub7a8\uc744 \ucef4\ud4e8\ud130 \ud654\uba74\uc758 \uc2dc\ubbac\ub808\uc774\ud130\ub85c \ud14c\uc2a4\ud2b8\ud560 \ub54c \uc8fc\uc758\ud574\uc57c \ud560 \uc810\uc73c\ub85c \uc62c\ubc14\ub978 \uc124\uba85\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc18c\ub9ac \ud06c\uae30 \uac12\uc744 100 \uc774\uc0c1\uc73c\ub85c \uc7a0\uc2dc \uc62c\ub838\ub2e4\uac00 \ube60\ub974\uac8c 100 \uc774\ud558\ub85c \ub0b4\ub824\uc57c \ud55c\ub2e4.",
          "rationale": "\uc2dc\ubbac\ub808\uc774\ud130\uc5d0\uc11c 100 \uc774\uc0c1\uc758 \ud070 \uc18c\ub9ac\uac00 \uc9c0\uc18d\ud574\uc11c \uc720\uc9c0\ub418\uba74 \ud070 \uc18c\ub9ac\ub85c \uacc4\uc18d \uc778\uc2dd\ub418\uc5b4 LED\uac00 \uba48\ucd94\uc9c0 \uc54a\uace0 \ubc18\ubcf5\ud574\uc11c \uae5c\ube61\uc774\uac8c \ub41c\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc2dc\ubbac\ub808\uc774\ud130\uc5d0\uc11c\ub294 \ub9c8\uc774\ud06c \uc785\ub825\uc744 \ud14c\uc2a4\ud2b8\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \ubc18\ub4dc\uc2dc \ub77c\ub514\uc624 \uc2e0\ud638\ub85c \ub300\uccb4\ud574\uc57c \ud55c\ub2e4.",
          "rationale": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \uc6f9 \uc5d0\ub514\ud130\uc758 \uc2dc\ubbac\ub808\uc774\ud130\uc5d0\uc11c\ub294 \uc18c\ub9ac \ud06c\uae30 \uc870\uc808\uae30\ub97c \ud1b5\ud574 \ub9c8\uc774\ud06c \uc785\ub825 \ud14c\uc2a4\ud2b8\uac00 \uac00\ub2a5\ud558\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc18c\ub9ac \ud06c\uae30 \ubc94\uc704\ub97c \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \ud55c\uacc4\uce58\uc778 -1024\ubd80\ud130 +1024 \uc0ac\uc774\ub85c \uc124\uc815\ud574\uc57c \ud55c\ub2e4.",
          "rationale": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uc5d0 \uc785\ub825\ub418\ub294 \uc18c\ub9ac \ud06c\uae30\uc758 \ubc94\uc704\ub294 -1024~+1024\uac00 \uc544\ub2cc 0~255 \ubc94\uc704\uc774\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubaa8\ub2c8\ud130 \ud654\uba74 \ud14c\uc2a4\ud2b8 \uc2dc\uc5d0\ub294 \ubcc0\uc218 tag\uc758 \ucd08\uae43\uac12\uc744 \ud56d\uc0c1 1\ub85c \uc9c0\uc815\ud574\uc57c \ub3d9\uc791\ud55c\ub2e4.",
          "rationale": "\ubcc0\uc218 tag\uc758 \ucd08\uae43\uac12\uc740 \uaebc\uc9c4 \uc0c1\ud0dc\ub97c \uc758\ubbf8\ud558\ub294 0\uc73c\ub85c \uc120\uc5b8\ud558\ub294 \uac83\uc774 \uae30\ubcf8 \uc54c\uace0\ub9ac\uc998 \uc124\uacc4\uc774\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc18c\ub9ac \ud06c\uae30 \uac12\uc774 100 \uc774\uc0c1\uc778 \uc0c1\ud0dc\ub85c \uacc4\uc18d \uc720\uc9c0\ub420 \ub54c \ubc1c\uc0dd\ud558\ub294 \ub3d9\uc791\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc74c\uc2dd\uc810 \ud638\ucd9c \uc7a5\uce58 \ub9cc\ub4e4\uae30 \uc2e4\uc2b5\uc5d0\uc11c \uc5ec\ub7ec \ubaa8\ub460\uc774 \ub3d9\uc2dc\uc5d0 \uc2e4\uc2b5\uc744 \uc9c4\ud589\ud560 \ub54c, \uc790\uc2e0\uc758 \ubaa8\ub460 \uae30\uae30\ub07c\ub9ac\ub9cc \uc62c\ubc14\ub974\uac8c \ud1b5\uc2e0\ud558\uae30 \uc704\ud574 \ub9de\ucdb0\uc57c \ud558\ub294 \ud544\uc218 \uc124\uc815\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\ubaa8\ub4e0 \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uc758 \ub77c\ub514\uc624 \uadf8\ub8f9\uc744 \ub3d9\uc77c\ud55c \ubc88\ud638\ub85c \uc124\uc815\ud55c\ub2e4.",
          "rationale": "\ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \ub77c\ub514\uc624 \uc7a5\uce58\ub294 \ub3d9\uc77c\ud55c \uadf8\ub8f9\uc73c\ub85c \uc124\uc815\ub41c \uae30\uae30\ub4e4\ub07c\ub9ac\ub9cc \uc2e0\ud638\ub97c \uc804\uc1a1\ud558\uace0 \uc218\uc2e0\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \ubaa8\ub460\ubcc4\ub85c \uace0\uc720\ud55c \uadf8\ub8f9 \ubc88\ud638\ub97c \uc9c0\uc815\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubaa8\ub4e0 \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uc5d0 \ud14c\uc774\ube14 \ubc88\ud638\ub97c 1\ubc88\uc73c\ub85c \ud1b5\uc77c\ud558\uc5ec \uc124\uc815\ud55c\ub2e4.",
          "rationale": "\ud14c\uc774\ube14 \ubc88\ud638\ub294 \uc218\uc2e0\uae30\uc5d0\uc11c \uc5b4\ub290 \ud14c\uc774\ube14\uc774 \ubd88\ub800\ub294\uc9c0 \uad6c\ubd84\ud574\uc57c \ud558\ubbc0\ub85c \ud14c\uc774\ube14\ub9c8\ub2e4 \ub2e4\ub978 \uc218(1, 2, 3 \ub4f1)\ub97c \uc1a1\ucd9c\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac00\uc18d\ub3c4 \uc13c\uc11c\uc758 x\ucd95 \uce21\uc815 \ubc94\uc704\ub97c \uc11c\ub85c \ub2e4\ub974\uac8c \ucf54\ub529\ud55c\ub2e4.",
          "rationale": "\uc74c\uc2dd\uc810 \ud638\ucd9c \uc7a5\uce58\ub294 \uac00\uc18d\ub3c4 \uc13c\uc11c\uac00 \uc544\ub2cc \ubc84\ud2bc \uc785\ub825\uacfc \ub77c\ub514\uc624 \ubb34\uc120 \ud1b5\uc2e0\uc744 \ud65c\uc6a9\ud55c\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubaa8\ub460\uc6d0 \uc804\uccb4\uc758 \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8 \uc218\uc2e0 \uae30\ub2a5\uc744 \uaebc\ub450\uace0 \uc1a1\uc2e0 \uc804\uc6a9\uc73c\ub85c \uc9c0\uc815\ud55c\ub2e4.",
          "rationale": "\ud45c\uc2dc\uc6a9 \uc7a5\uce58 \uc5ed\ud560\uc744 \ub9e1\uc740 \ubaa8\ub460\uc6d0\uc740 \ud14c\uc774\ube14\uc6a9 \uc7a5\uce58\uac00 \ubcf4\ub0b8 \uc2e0\ud638\ub97c \ubc1b\uc544\uc57c \ud558\ubbc0\ub85c \uc218\uc2e0 \uae30\ub2a5\uc774 \uc791\ub3d9\ud574\uc57c \ud55c\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc11c\ub85c \ub2e4\ub978 \ubb34\uc120 \ucc44\ub110\uc774\ub098 \uad6c\uc5ed\uc744 \ub098\ub204\uc5b4 \ud63c\uc120\uc744 \ubc29\uc9c0\ud558\ub294 \ud1b5\uc2e0 \uc124\uc815 \ud56d\ubaa9\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\uc74c\uc2dd\uc810 \ud638\ucd9c \uc7a5\uce58 \uc2e4\uc2b5\uc5d0\uc11c \ud14c\uc774\ube14\uc6a9 \ub9c8\uc774\ud06c\ub85c\ube44\ud2b8\uc758 A \ubc84\ud2bc\uc744 \ub20c\ub800\uc744 \ub54c, \ud638\ucd9c\uc744 \ud655\uc778\ud558\uae30 \uc704\ud574 \ud14c\uc774\ube14\uc6a9 \uc7a5\uce58 \uc790\uccb4\uc5d0 \ud45c\uc2dc\ub418\ub294 \ud654\uba74 \ub3d9\uc791\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "LED \ud654\uba74\uc5d0 1\ucd08 \ub3d9\uc548 'V'\uac00 \ud45c\uc2dc\ub41c \ud6c4 \uc0ac\ub77c\uc9c4\ub2e4.",
          "rationale": "\ubc84\ud2bc \ub204\ub984\uc744 \ud655\uc778\ud558\uae30 \uc704\ud574 \ud14c\uc774\ube14\uc6a9 LED\uc5d0 'V' \ud45c\uc2dc\uac00 \ub098\ud0c0\ub098\uace0 1\ucd08 \ud6c4\uc5d0 \uc9c0\uc6cc\uc9c4\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "LED \ud654\uba74\uc5d0 \uc124\uc815\ub41c \ub77c\ub514\uc624 \uadf8\ub8f9 \ubc88\ud638\uac00 5\ucd08\uac04 \uc2a4\ud06c\ub864\ub41c\ub2e4.",
          "rationale": "\ubc84\ud2bc\uc744 \ub20c\ub800\uc744 \ub54c \ub098\ud0c0\ub098\ub294 \ud45c\uc2dc\ub294 \ub77c\ub514\uc624 \uadf8\ub8f9 \ubc88\ud638\uac00 \uc544\ub2cc \uccb4\ud06c \ubaa8\uc591\uc778 'V' \ud45c\uc2dc\uc774\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2a4\ud53c\ucee4\uc5d0\uc11c '\uc194'\uacfc '\ubbf8' \uc74c\uc774 0.5\ucd08\uc529 \ucd9c\ub825\ub41c\ub2e4.",
          "rationale": "'\uc194'\uacfc '\ubbf8' \uc18c\ub9ac\ub97c \uc54c\ub9ac\ub294 \uae30\ub2a5\uc740 \uc2e0\ud638\ub97c \ubc1b\uc740 '\ud45c\uc2dc\uc6a9 \uc7a5\uce58(\uc218\uc2e0\uae30)'\uc758 \ub3d9\uc791\uc774\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "LED \ud654\uba74 \uc804\uccb4\uac00 0.5\ucd08 \uac04\uaca9\uc73c\ub85c 3\ubc88 \uae5c\ube61\uc778 \ud6c4 \uaebc\uc9c4\ub2e4.",
          "rationale": "\ud14c\uc774\ube14\uc6a9 \uc7a5\uce58\ub294 \uc804\uccb4 LED\ub97c \uae5c\ube61\uc774\uc9c0 \uc54a\uace0 'V' \ubaa8\uc591 \ucd9c\ub825\uc744 1\ucd08\uac04 \uc720\uc9c0\ud55c\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ud14c\uc774\ube14\uc744 \uc774\uc6a9\ud558\ub294 \uc190\ub2d8\uc774 \ubc84\ud2bc\uc774 \uc81c\ub300\ub85c \ub20c\ub838\ub294\uc9c0 \ub208\uc73c\ub85c \ud655\uc778\ud560 \uc218 \uc788\ub294 \uc54c\ud30c\ubcb3 \ud615\ud0dc\uc758 \uccb4\ud06c \ud45c\uc2dc\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\ubcf4\ud589 \uc2e0\ud638\ub4f1 \uc54c\ub9bc \uc2e4\uc2b5\uc5d0\uc11c \ucd08\ub85d\uc0c9 \uc2e0\ud638\uac00 \ucf1c\uc9c4 \ub4a4 10\ucd08 \ud6c4\uc5d0 \ud734\ub300 \uc804\ud654 \uc7a5\uce58\ub85c \ub77c\ub514\uc624 \uce74\uc6b4\ud2b8\ub2e4\uc6b4 \uc2e0\ud638(10~1)\ub97c \ubcf4\ub0b8\ub2e4. \ud734\ub300 \uc804\ud654 \uc7a5\uce58\uac00 10\ubd80\ud130 6\uae4c\uc9c0\uc758 \uc2e0\ud638\ub97c \ubc1b\uc744 \ub54c\uc640 5\ubd80\ud130 1\uae4c\uc9c0\uc758 \uc2e0\ud638\ub97c \ubc1b\uc744 \ub54c \ub0b4\ub294 \uc18c\ub9ac\uc758 \ucc28\uc774\ub85c \uc62c\ubc14\ub978 \uac83\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "10~6\uc744 \ubc1b\uc744 \ub54c\ub294 \ub192\uc740 '\uc194'\uc74c, 5~1\uc744 \ubc1b\uc744 \ub54c\ub294 \ub0ae\uc740 '\ubbf8'\uc74c\uc744 500ms \ub3d9\uc548 \ucd9c\ub825\ud55c\ub2e4.",
          "rationale": "10~6 \uad6c\uac04\uc774 \uc0c1\ub300\uc801\uc73c\ub85c \ub0ae\uc740 '\ubbf8'\uc74c\uc774\uace0, \ube68\uac04\ubd88\uc774 \uc784\ubc15\ud55c 5~1 \uad6c\uac04\uc774 \ub354 \ub192\uc740 '\uc194'\uc74c\uc774\ub2e4.",
          "isCorrect": false
        },
