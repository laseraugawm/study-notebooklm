{
  "title": "\ud30c\uc774\uc36c \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \ud0a4(key)\uc640 \uac12(value)\uc774 \uc30d\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9c4 \ub370\uc774\ud130 \uc9d1\ud569\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub515\uc154\ub108\ub9ac(dictionary)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c\uc5d0\uc11c \ub515\uc154\ub108\ub9ac\ub97c \uc0dd\uc131\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \uad04\ud638 \uae30\ud638\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uad04\ud638 (`{ }`)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ub515\uc154\ub108\ub9ac \ub0b4\ubd80\uc5d0\uc11c \ud0a4(key)\uc640 \uac12(value)\uc744 \uad6c\ubd84\ud558\ub294 \uae30\ud638\uc640 \uac01\uac01\uc758 \uc30d\uc744 \uad6c\ubd84\ud558\ub294 \uae30\ud638\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \ud0a4\uc640 \uac12 \uad6c\ubd84: \ucf5c\ub860 (`:`)\n\u2022 \uac01 \uc30d \uad6c\ubd84: \uc27c\ud45c (`,`)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud30c\uc774\uc36c \ub515\uc154\ub108\ub9ac `atom = {'H':1, 'C':12, 'O':16}`\uc5d0\uc11c \uc6d0\uc790 \uae30\ud638 `'H'`\uc758 \uc6d0\uc790\ub7c9\uc744 \ucd9c\ub825\ud558\ub294 \uba85\ub839\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`print(atom['H'])`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ud559\uc2dd \ubcf4\uace0 \ud654\ud559\uc2dd \uc591\uc744 \uacc4\uc0b0\ud560 \ub54c, '\ud654\ud559\uc2dd \uc591'\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uadf8 \ud654\ud559\uc2dd\uc5d0 \ud3ec\ud568\ub418\uc5b4 \uc788\ub294 \ubaa8\ub4e0 \uc6d0\uc790\uc758 \uc9c8\ub7c9\uc758 \ud569"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc18c(H), \ud0c4\uc18c(C), \uc0b0\uc18c(O) \uc6d0\uc790 \ud558\ub098\uc758 \uc9c8\ub7c9(\uc6d0\uc790\ub7c9)\uc740 \uac01\uac01 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \uc218\uc18c(H): 1\n\u2022 \ud0c4\uc18c(C): 12\n\u2022 \uc0b0\uc18c(O): 16"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c($H_2O$)\uc758 \ud654\ud559\uc2dd \uc591\uc740 \uc5bc\ub9c8\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "18 (\uc218\uc18c \uc6d0\uc790 2\uac1c $\\times 1$ + \uc0b0\uc18c \uc6d0\uc790 1\uac1c $\\times 16$)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ud559\uc2dd \uc591 \uacc4\uc0b0 \ud504\ub85c\uadf8\ub7a8\uc5d0\uc11c \uc6d0\uc790 \uae30\ud638 \ub4a4\uc5d0 \uc22b\uc790\uac00 \ub098\uc62c \ub54c, \uc9c1\uc804\uc5d0 \uc2a4\ud0dd\uc5d0 \ub123\uc740 \uc6d0\uc790\ub7c9\uc744 \uaebc\ub0b4\uc5b4 \uacf1\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \uc2a4\ud0dd \uba54\uc11c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`pop()` \uba54\uc11c\ub4dc (`stack.pop()`)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ud559\uc2dd \uc591 \uacc4\uc0b0 \ucf54\ub4dc `stack.append(stack.pop()*int(c))`\uc758 \ub3d9\uc791 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ud0dd \ucd5c\uc0c1\ub2e8\uc5d0 \uc800\uc7a5\ub41c \uc6d0\uc790\ub7c9\uc744 \uaebc\ub0b4\uc5b4 \ub4a4\ub530\ub77c \ub098\uc628 \uc22b\uc790(`c`)\ub9cc\ud07c \uacf1\ud55c \ud6c4, \uadf8 \uacb0\uacfc\ub97c \ub2e4\uc2dc \uc2a4\ud0dd\uc5d0 \ucd94\uac00\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd, \uacbd\uc81c, \uc0ac\ud68c \ub4f1 \uc778\ub958\uac00 \uc548\uace0 \uc788\ub294 \ubb38\uc81c\ub97c \uc804 \uc138\uacc4\uac00 \ud568\uaed8 \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc218\ub9bd\ud55c \uad6d\uc81c\uc801 \uacf5\ub3d9 \ubaa9\ud45c\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc18d\uac00\ub2a5\ubc1c\uc804\ubaa9\ud45c (SDGs)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0d0\uc0c9\uc801 \ub370\uc774\ud130 \ubd84\uc11d(EDA)\uc5d0 \ub530\ub978 \ubb38\uc81c \ud574\uacb0 \uacfc\uc815\uc758 4\ub2e8\uacc4\ub97c \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\ub2e8\uacc4: \ubb38\uc81c \uc815\uc758\ud558\uae30 $\\rightarrow$ 2\ub2e8\uacc4: \ub370\uc774\ud130 \uc218\uc9d1\ud558\uae30 $\\rightarrow$ 3\ub2e8\uacc4: \ub370\uc774\ud130 \ubd84\uc11d\ud558\uae30 $\\rightarrow$ 4\ub2e8\uacc4: \ubb38\uc81c \ud574\uacb0\ud558\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0d0\uc0c9\uc801 \ub370\uc774\ud130 \ubd84\uc11d 4\ub2e8\uacc4 \uacfc\uc815 \uc911 \ubaa8\ub460\uc6d0\ub4e4\uacfc \ud568\uaed8 \uc218\ud589\ud558\ub294 '\ud611\ub825 \ud65c\ub3d9' \ub2e8\uacc4 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\ub2e8\uacc4 (\ubb38\uc81c \uc815\uc758\ud558\uae30) \ubc0f 4\ub2e8\uacc4 (\ubb38\uc81c \ud574\uacb0\ud558\uae30)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0d0\uc0c9\uc801 \ub370\uc774\ud130 \ubd84\uc11d 4\ub2e8\uacc4 \uacfc\uc815 \uc911 \ud559\uc0dd \uac1c\ubcc4\uc801\uc73c\ub85c \uc218\ud589\ud558\ub294 '\uac1c\ubcc4 \ud65c\ub3d9' \ub2e8\uacc4 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2\ub2e8\uacc4 (\ub370\uc774\ud130 \uc218\uc9d1\ud558\uae30) \ubc0f 3\ub2e8\uacc4 (\ub370\uc774\ud130 \ubd84\uc11d\ud558\uae30)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\uae00 \ucf54\ub7a9 \ud658\uacbd\uc5d0\uc11c \uc0ac\uc6a9\uc790\uc758 \ub85c\uceec \ud30c\uc77c(\uc608: \uc5d1\uc140 \ud30c\uc77c)\uc744 \uc5c5\ub85c\ub4dc\ud558\uae30 \uc704\ud574 \ubd88\ub7ec\uc624\ub294 \ubaa8\ub4c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`google.colab` \ubaa8\ub4c8\uc758 `files` (`from google.colab import files`)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud310\ub2e4\uc2a4(Pandas) \ub77c\uc774\ube0c\ub7ec\ub9ac\ub97c \uc784\ud3ec\ud2b8\ud558\uace0 \uc5d1\uc140 \ud30c\uc77c `'AG_FOOD_WST_PC.xlsx'`\ub97c \uc77d\uc5b4 \ub370\uc774\ud130\ud504\ub808\uc784 `df`\ub97c \uc0dd\uc131\ud558\ub294 \ucf54\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`import pandas as pd`\n`df = pd.read_excel('AG_FOOD_WST_PC.xlsx')`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc74c\uc2dd\ubb3c \uc4f0\ub808\uae30 \ub370\uc774\ud130\uc14b\uc758 'Food Waste Sector' \uceec\ub7fc\uc5d0\uc11c \uc804\uccb4 \ubd84\uc57c\ub97c \ub098\ud0c0\ub0b4\ub294 \ucf54\ub4dc\uac12\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`ALL`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc74c\uc2dd\ubb3c \uc4f0\ub808\uae30 \ub370\uc774\ud130\uc14b\uc758 \ubd84\uc57c\ubcc4 \ucf54\ub4dc `HHS`, `OOHC`, `RTL`\uc774 \ub098\ud0c0\ub0b4\ub294 \uc601\uc5ed\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 `HHS`: \uac00\uc815(HouseHold)\n\u2022 `OOHC`: \uc678\uc2dd \uc0b0\uc5c5(Out-Of-Home Catering)\n\u2022 `RTL`: \uc18c\ub9e4\uc5c5(Retail)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud310\ub2e4\uc2a4 \ub370\uc774\ud130\ud504\ub808\uc784 `df` \uc804\uccb4\uc758 \ud589\u00b7\uc5f4 \uac1c\uc218, \uceec\ub7fc\uba85, \ube44\uc5b4 \uc788\uc9c0 \uc54a\uc740 \uac12\uc758 \uac1c\uc218(Non-Null), \ub370\uc774\ud130 \ud0c0\uc785\uc744 \ud655\uc778\ud558\ub294 \uc694\uc57d \uc815\ubcf4 \ucd9c\ub825 \uba54\uc11c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`df.info()`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud310\ub2e4\uc2a4 \ub370\uc774\ud130\ud504\ub808\uc784 `df`\uc5d0\uc11c \uceec\ub7fc\uba85 `'2019'`\ub97c `'PC2019'`\ub85c \ubcc0\uacbd\ud558\ub294 \ucf54\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`df = df.rename(columns = {'2019':'PC2019'})`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ud504\ub808\uc784 `df`\uc5d0\uc11c 'Food Waste Sector' \uceec\ub7fc \uac12\uc774 'ALL'\uc778 \ud589\ub4e4\ub9cc \uc120\ud0dd\ud558\uc5ec \uc0c8\ub85c\uc6b4 \ub370\uc774\ud130\ud504\ub808\uc784 `df1`\uc744 \uc0dd\uc131\ud558\ub294 \ucf54\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`df1 = df[df['Food Waste Sector'] == 'ALL']`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \uc870\uac74\uc758 \ucd94\ucd9c \uacb0\uacfc\ub97c \uc0c8 \ubcc0\uc218(`df1`)\uc5d0 \uc800\uc7a5\ud558\uc9c0 \uc54a\uace0 \ub9e4\ubc88 \uc870\uac74\ubb38\uc73c\ub85c \uc791\uc5c5\ud560 \ub54c \ubc1c\uc0dd\ud558\ub294 \ub2e8\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd94\ucd9c\ud55c \uacb0\uacfc\ub97c \uc7ac\uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc5b4 \ub3d9\uc77c\ud55c \uc870\uac74\uc774 \ud544\uc694\ud560 \ub54c\ub9c8\ub2e4 \uc870\uac74\uc2dd\uc744 \ub2e4\uc2dc \uc791\uc131\ud574\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud310\ub2e4\uc2a4 \ub370\uc774\ud130\ud504\ub808\uc784 `df1`\uc744 `'PC2019'` \uceec\ub7fc \uae30\uc900\uc73c\ub85c \ub0b4\ub9bc\ucc28\uc21c \uc815\ub82c\ud558\ub294 \ucf54\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`df1 = df1.sort_values(\"PC2019\", ascending = False)`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud310\ub2e4\uc2a4 `sort_values()` \uba54\uc11c\ub4dc\uc5d0\uc11c \ub0b4\ub9bc\ucc28\uc21c \uc815\ub82c\uc744 \uc218\ud589\ud558\uae30 \uc704\ud574 \uc124\uc815\ud574\uc57c \ud558\ub294 \uc635\uc158\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`ascending = False`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\uc778\ub2f9 \uc804\uccb4 \uc74c\uc2dd\ubb3c \uc4f0\ub808\uae30\uc591\uc774 \uac00\uc7a5 \ub9ce\uc740 \uc0c1\uc704 5\uac1c \uad6d\uac00\ub294 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9d0\ub808\uc774\uc2dc\uc544, \ub098\uc774\uc9c0\ub9ac\uc544, \ub974\uc644\ub2e4, \uc774\uc2a4\ub77c\uc5d8, \uadf8\ub9ac\uc2a4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ud504\ub808\uc784 `df`\uc5d0\uc11c 'Food Waste Sector' \uceec\ub7fc \uac12\uc774 \ub9ac\uc2a4\ud2b8 `[\"HHS\", \"OOHC\", \"RTL\"]` \uc911 \ud558\ub098\ub77c\ub3c4 \ud3ec\ud568\ub41c \ud589\uc744 \uc120\ud0dd\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \ud310\ub2e4\uc2a4 \uba54\uc11c\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`isin()` \uba54\uc11c\ub4dc (`df2 = df[df[\"Food Waste Sector\"].isin([\"HHS\", \"OOHC\", \"RTL\"])]`)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "Matplotlib \ub77c\uc774\ube0c\ub7ec\ub9ac\ub97c \ud65c\uc6a9\ud558\uc5ec \uc218\ud3c9 \ub9c9\ub300\uadf8\ub798\ud504\ub97c \uc0dd\uc131\ud558\ub294 \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`plt.barh()`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "Matplotlib \uadf8\ub798\ud504\uc5d0\uc11c x\ucd95 \ubc0f y\ucd95 \ub77c\ubca8\uc744 \uc124\uc815\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \ub300\ud45c\uc801\uc778 \ub450 \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`plt.xlabel()` \ubc0f `plt.ylabel()`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "Matplotlib\uc5d0\uc11c \uc6d0\ud615 \uadf8\ub798\ud504(\ud30c\uc774 \ucc28\ud2b8)\ub97c \uadf8\ub9b4 \ub54c \uc0ac\uc6a9\ud558\ub294 \ud568\uc218\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "`plt.pie()`"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
