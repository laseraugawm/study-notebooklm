        {
          "text": "\ub300\uce6d\ud0a4 \uc554\ud638\ud654\ub294 \uacf5\uac1c\ub41c \ud0a4\ub85c \ub370\uc774\ud130\ub97c \uc554\ud638\ud654\ud558\uace0 \uac1c\uc778\ub9cc \uac00\uc9c4 \ud0a4\ub85c \ubcf5\ud638\ud654\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uacf5\uac1c\ud0a4\uc640 \uac1c\uc778\ud0a4\ub85c \uad6c\ubd84\ud558\uc5ec \uc11c\ub85c \ub2e4\ub978 \ud0a4\ub97c \ud65c\uc6a9\ud558\ub294 \uac83\uc740 \uacf5\uac1c\ud0a4 \uc554\ud638\ud654 \ubc29\uc2dd\uc5d0 \ub300\ud55c \uc124\uba85\uc785\ub2c8\ub2e4."
