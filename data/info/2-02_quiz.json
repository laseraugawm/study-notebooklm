    {
      "type": "multiple_choice",
      "question": "\ub124\ud2b8\uc6cc\ud06c \ud658\uacbd\uc5d0\uc11c \uc1a1\uc2e0\uc790\uc758 \uc2e0\uc6d0\uc744 \uc99d\uba85\ud558\uae30 \uc704\ud574 \ud65c\uc6a9\ub418\ub294 '\ub514\uc9c0\ud138 \uc11c\uba85'\uc758 \uacfc\uc815\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc1a1\uc2e0\uc790\ub294 \uc218\uc2e0\uc790\uc758 \uacf5\uac1c\ud0a4\ub85c \ud574\uc2dc\uac12\uc744 \uc554\ud638\ud654\ud558\uace0, \uc218\uc2e0\uc790\ub294 \uc790\uc2e0\uc758 \uac1c\uc778\ud0a4\ub85c \ubcf5\ud638\ud654\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc2e0\uc790\uc758 \uacf5\uac1c\ud0a4\ub85c \uc554\ud638\ud654\ud558\ub294 \ubc29\uc2dd\uc740 \uc218\uc2e0\uc790\ub9cc \uc77d\uc744 \uc218 \uc788\ub3c4\ub85d \ud558\ub294 \uc77c\ubc18\uc801\uc778 \uacf5\uac1c\ud0a4 \uc554\ud638\ud654 \ud1b5\uc2e0 \ubc29\uc2dd\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc1a1\uc2e0\uc790\ub294 \uc1a1\uc2e0\uc790\uc758 \uac1c\uc778\ud0a4\ub85c \ud574\uc2dc\uac12\uc744 \uc554\ud638\ud654\ud558\uace0, \uc218\uc2e0\uc790\ub294 \uc1a1\uc2e0\uc790\uc758 \uacf5\uac1c\ud0a4\ub85c \uc774\ub97c \ubcf5\uc6d0\ud574 \uac80\uc99d\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub514\uc9c0\ud138 \uc11c\uba85\uc740 \uc1a1\uc2e0\uc790\uc758 \uac1c\uc778\ud0a4\ub85c \uc11c\uba85\uc744 \uc0dd\uc131(\uc554\ud638\ud654)\ud558\uace0, \ub204\uad6c\uc5d0\uac8c\ub098 \uacf5\uac1c\ub41c \uc1a1\uc2e0\uc790\uc758 \uacf5\uac1c\ud0a4\ub85c \uc774\ub97c \ubcf5\uc6d0(\ubcf5\ud638\ud654)\ud558\uc5ec \uc1a1\uc2e0\uc790\uc758 \uc2e0\uc6d0\uc744 \uac80\uc99d\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc1a1\uc2e0\uc790\uc640 \uc218\uc2e0\uc790\uac00 \uacf5\uc720\ud55c \ub300\uce6d\ud0a4\ub97c \uc774\uc6a9\ud558\uc5ec \uc11c\uba85\uc744 \uc554\ud638\ud654\ud558\uace0 \ubcf5\ud638\ud654\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub514\uc9c0\ud138 \uc11c\uba85\uc740 \ub300\uce6d\ud0a4 \uc54c\uace0\ub9ac\uc998\uc774 \uc544\ub2cc \uacf5\uac1c\ud0a4 \uc54c\uace0\ub9ac\uc998 \ubc0f \ud0a4 \uad6c\uc870\ub97c \ud65c\uc6a9\ud558\uc5ec \uc2e0\uc6d0\uc744 \uc99d\uba85\ud558\ub294 \uae30\uc220\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc218\uc2e0\uc790\ub294 \uc1a1\uc2e0\uc790\uc758 \uac1c\uc778\ud0a4\ub97c \uc9c1\uc811 \uc804\ub2ec\ubc1b\uc544 \uc1a1\uc2e0\uc790\uac00 \ubcf4\ub0b8 \uc11c\uba85 \ubb38\uc11c\ub97c \ubcf5\uad6c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\ud0a4\ub294 \uc790\uc2e0\ub9cc \uc54c\uace0 \uc788\uc5b4\uc57c \ud558\ub294 \ube44\ubc00 \ud0a4\uc774\ubbc0\ub85c \uc218\uc2e0\uc790\uc5d0\uac8c \uc804\ub2ec\ud558\uac70\ub098 \uacf5\uac1c\ud574\uc11c\ub294 \uc548 \ub429\ub2c8\ub2e4."
