    {
      "type": "multiple_choice",
      "question": "\uc0ac\uc6a9\uc790 \ud328\uc2a4\uc6cc\ub4dc\ub97c \uc11c\ubc84\uc5d0 \uc800\uc7a5\ud560 \ub54c \uc0ac\uc6a9\ub418\ub294 '\ud574\uc2dc \ud568\uc218(Hash function)'\uc758 \ud2b9\uc131\uc73c\ub85c \uc62c\ubc14\ub974\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc785\ub825\ub418\ub294 \ud328\uc2a4\uc6cc\ub4dc\uc758 \uae38\uc774\uc5d0 \uad00\uacc4\uc5c6\uc774 \uace0\uc815\ub41c \uae38\uc774\uc758 \ud574\uc2dc\uac12\uc744 \ucd9c\ub825\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud574\uc2dc \ud568\uc218\ub294 \uc785\ub825\uac12\uc758 \uae38\uc774\uc640 \uc0c1\uad00\uc5c6\uc774 \ud56d\uc0c1 \uc77c\uc815\ud55c \uae38\uc774\uc758 \ucd9c\ub825\uac12(\ud574\uc2dc\uac12)\uc744 \uc0dd\uc131\ud558\ub294 \ud2b9\uc9d5\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc554\ud638\ud654\ub41c \ud574\uc2dc\uac12\uc774 \uc720\ucd9c\ub418\ub354\ub77c\ub3c4 \uc774\ub97c \ub2e4\uc2dc \uc6d0\ub798\uc758 \ud3c9\ubb38 \ud328\uc2a4\uc6cc\ub4dc\ub85c \ubcf5\uc6d0\ud560 \uc218 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud574\uc2dc \ud568\uc218\ub294 \uc554\ud638\ud654\ub9cc \uac00\ub2a5\ud558\uace0 \uc5ed\ubc29\ud5a5 \uacc4\uc0b0(\ubcf5\ud638\ud654)\uc774 \ubd88\uac00\ub2a5\ud55c \ub2e8\ubc29\ud5a5 \uc554\ud638\ud654 \uae30\uc220\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub3d9\uc77c\ud55c \ud328\uc2a4\uc6cc\ub4dc\ub97c \uc785\ub825\ud560 \uacbd\uc6b0 \uc801\uc6a9\ub41c \uaddc\uce59\uc5d0 \ub530\ub77c \ud56d\uc0c1 \ub3d9\uc77c\ud55c \ud574\uc2dc\uac12\uc774 \ucd9c\ub825\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud574\uc2dc \ud568\uc218\ub294 \uaddc\uce59\uc5d0 \ub530\ub77c \uc77c\uad00\ub418\uac8c \ub3d9\uc791\ud558\ubbc0\ub85c \ub3d9\uc77c\ud55c \uc785\ub825\uac12\uc5d0 \ub300\ud574 \ub9e4\ubc88 \uac19\uc740 \ud574\uc2dc\uac12\uc744 \ucd9c\ub825\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ube44\ubc00\ubc88\ud638\ub97c \uc548\uc804\ud558\uac8c \uad00\ub9ac\ud558\uae30 \uc704\ud574 \uc554\ud638\ud654 \ubc0f \ubcf5\ud638\ud654 \uacfc\uc815\uc5d0\uc11c \uc0ac\uc6a9\uc790 \ubcf8\uc778\uc758 \uac1c\uc778\ud0a4\ub97c \ud544\uc218\uc801\uc73c\ub85c \ud65c\uc6a9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud574\uc2dc \ud568\uc218\ub294 \ubcc4\ub3c4\uc758 \uc554\ud638\ud654 \ud0a4\ub098 \ubcf5\ud638\ud654 \ud0a4 \uc5c6\uc774 \uc785\ub825\uac12\uc5d0 \uc77c\uc815\ud55c \uaddc\uce59\ub9cc\uc744 \uc801\uc6a9\ud558\uc5ec \ud574\uc2dc\uac12\uc744 \uad6c\ud558\ub294 \uae30\uc220\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud574\uc2dc \ud568\uc218\ub294 \ub300\uce6d\ud0a4\ub098 \uacf5\uac1c\ud0a4 \uc554\ud638\ud654\uc640 \ub2ec\ub9ac '\ud0a4(key)'\uc758 \uc874\uc7ac \uc5ec\ubd80\uc640 '\ubcf5\ud638\ud654 \uac00\ub2a5 \uc5ec\ubd80'\uc5d0\uc11c \ud070 \ucc28\uc774\uac00 \uc788\uc2b5\ub2c8\ub2e4."
