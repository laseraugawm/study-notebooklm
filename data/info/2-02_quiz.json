        },
        {
          "text": "\uacf5\uac1c\ud0a4 \uc554\ud638\ud654\ub294 \ud1b5\uc2e0\ud558\ub294 \ub450 \uc0ac\ub78c\uc774 \uc11c\ub85c \ub3d9\uc77c\ud55c \ube44\ubc00 \ud0a4\ub97c \ubbf8\ub9ac \uacf5\uc720\ud574\uc11c \uc0ac\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud1b5\uc2e0 \ub2f9\uc0ac\uc790\uac00 \ub3d9\uc77c\ud55c \ud0a4\ub97c \uacf5\uc720\ud558\uc5ec \uc554\ud638\ud654\uc640 \ubcf5\ud638\ud654\ub97c \uc218\ud589\ud558\ub294 \ubc29\uc2dd\uc740 \ub300\uce6d\ud0a4 \uc554\ud638\ud654\uc785\ub2c8\ub2e4."
