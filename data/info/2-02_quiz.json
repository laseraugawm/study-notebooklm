    {
      "type": "multiple_choice",
      "question": "\uace0\ub300 \uc554\ud638 \uae30\ubc95\uc778 \uc2a4\ud0a4\ud14c\uc77c \uc554\ud638\uc640 \uce74\uc774\uc0ac\ub974 \uc554\ud638\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2a4\ud0a4\ud14c\uc77c \uc554\ud638\ub294 \ud3c9\ubb38\uc758 \uc54c\ud30c\ubcb3\uc744 \ub2e4\ub978 \uc54c\ud30c\ubcb3\uc73c\ub85c \uad50\uccb4\ud558\uc5ec \uc554\ud638\ubb38\uc73c\ub85c \ub9cc\ub4dc\ub294 \uce58\ud658 \uc554\ud638\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ud0a4\ud14c\uc77c \uc554\ud638\ub294 \uc591\ud53c\uc9c0 \ub9ac\ubcf8\uc744 \ub098\ubb34 \ub9c9\ub300\uc5d0 \uac10\uc544 \uae00\uc790\uc758 \ubc30\uce58 \uc704\uce58\ub97c \ubc14\uafb8\ub294 \uc804\uce58 \uc554\ud638\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uce74\uc774\uc0ac\ub974 \uc554\ud638\ub294 \ud3c9\ubb38 \ubb38\uc790\uc758 \uc704\uce58\ub97c \ubb34\uc791\uc704\ub85c \uc11e\uc5b4\uc11c \uc554\ud638\ubb38\uc73c\ub85c \ub9cc\ub4dc\ub294 \uc804\uce58 \uc554\ud638\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uce74\uc774\uc0ac\ub974 \uc554\ud638\ub294 \uc54c\ud30c\ubcb3\uc744 \ud0a4\uac12\ub9cc\ud07c \uc77c\uc815\ud55c \uac04\uaca9\uc73c\ub85c \uc774\ub3d9\uc2dc\ucf1c \ub2e4\ub978 \ubb38\uc790\ub85c \ub300\uccb4\ud558\ub294 \uce58\ud658 \uc554\ud638\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc2a4\ud0a4\ud14c\uc77c \uc554\ud638\ub294 \uad75\uae30\uc640 \uae38\uc774\uac00 \uac19\uc740 \ub098\ubb34 \ub9c9\ub300\ub97c \uc774\uc6a9\ud574 \uae00\uc790\uc758 \uc21c\uc11c\ub97c \ubc14\uafb8\ub294 \uc804\uce58 \uc554\ud638\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2a4\ud0a4\ud14c\uc77c \uc554\ud638\ub294 \ub3d9\uc77c\ud55c \uaddc\uaca9\uc758 \ub098\ubb34 \ub9c9\ub300\uc5d0 \ub9ac\ubcf8\uc744 \uac10\uc544 \uc606\uc73c\ub85c \uc791\uc131\ud568\uc73c\ub85c\uc368 \ubb38\uc790\uc758 \uc704\uce58\ub97c \ubcc0\ud658\ud558\ub294 \uc804\uce58 \uc554\ud638\uc758 \ub300\ud45c\uc801\uc778 \uc0ac\ub840\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uce74\uc774\uc0ac\ub974 \uc554\ud638\uc640 \uc2a4\ud0a4\ud14c\uc77c \uc554\ud638\ub294 \ubaa8\ub450 \uc554\ud638\ud654 \ud0a4\uc640 \ubcf5\ud638\ud654 \ud0a4\uac00 \uc11c\ub85c \ub2e4\ub978 \uacf5\uac1c\ud0a4 \uc554\ud638 \uc54c\uace0\ub9ac\uc998\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub450 \uc554\ud638 \ubc29\uc2dd \ubaa8\ub450 \ud604\ub300\uc758 \uacf5\uac1c\ud0a4 \uc54c\uace0\ub9ac\uc998\uc774 \uc544\ub2cc \uace0\ub300\uc758 \uc804\uce58 \ubc0f \uce58\ud658 \uc6d0\ub9ac\ub97c \uae30\ubc18\uc73c\ub85c \ud55c \uc554\ud638 \uae30\uc220\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubb38\uc790\uc758 \uc6d0\ub798 \uc704\uce58(\uc21c\uc11c)\ub97c \ubc14\uafb8\ub294 \ubc29\uc2dd\uc778\uc9c0, \uae00\uc790 \uc790\uccb4\ub97c \ub2e4\ub978 \uae00\uc790\ub85c \ubc14\uafd4\uce58\uae30\ud558\ub294 \ubc29\uc2dd\uc778\uc9c0\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
