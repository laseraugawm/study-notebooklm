    {
      "type": "multiple_choice",
      "question": "\uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 \uc2dc\uae30 \ub3c5\uc77c\uc5d0 \uc758\ud574 \uc0ac\uc6a9\ub41c \uadfc\ub300 \uae30\uacc4\uc2dd \uc554\ud638\uae30\uc778 '\uc5d0\ub2c8\uadf8\ub9c8(Enigma)'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud0a4\ubcf4\ub4dc\ub85c \ubb38\uc790\ub97c \uc785\ub825\ud558\uba74 \uac00\uc7a5 \uba3c\uc800 \ubc30\uc804\ubc18\uc5d0 \uc5f0\uacb0\ub41c \ubb38\uc790\ub85c 1\ucc28 \uce58\ud658\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5d0\ub2c8\uadf8\ub9c8\ub294 \ubb38\uc790\ub97c \ud0a4\ubcf4\ub4dc\ub85c \uc785\ub825\ud558\uba74 \ubc30\uc804\ubc18\uc744 \uac70\uce58\uba70 1\ucc28\ub85c \uc54c\ud30c\ubcb3 \uce58\ud658\uc774 \uc77c\uc5b4\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "1\ucc28 \uce58\ud658\ub41c \ubb38\uc790\ub294 \ud68c\uc804\uc790\ub4e4\uc744 \ud1b5\uacfc\ud558\uba74\uc11c 2\ucc28\ub85c \uc54c\ud30c\ubcb3\uc774 \uce58\ud658\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc30\uc804\ubc18\uc744 \uac70\uccd0 1\ucc28 \uce58\ud658\ub41c \uc2e0\ud638\ub294 \ub0b4\ubd80 \ud68c\uc804\uc790 \uad6c\uc870\ub97c \uac70\uce58\uba74\uc11c 2\ucc28 \uce58\ud658 \uacfc\uc815\uc744 \uac70\uce58\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc5d0\ub2c8\uadf8\ub9c8\uc758 \ud68c\uc804\uc790 1\uac1c\ub2f9 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uacbd\uc6b0\uc758 \uc218\ub294 \ucd1d $676$\uac1c($26 \\times 26$)\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud68c\uc804\uc790 1\uac1c\ub294 \uc785\ub825 \uc54c\ud30c\ubcb3 26\uac1c\uc640 \ucd9c\ub825 \uc54c\ud30c\ubcb3 26\uac1c\ub97c \uc5f0\uacb0\ud558\ubbc0\ub85c $26 \\times 26 = 676$\uac00\uc9c0\uc758 \uacbd\uc6b0\uc758 \uc218\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc804\uce58 \uc554\ud638 \ubc29\uc2dd\ub9cc\uc744 \ub2e8\ub3c5\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc785\ub825\ub41c \uae00\uc790\uc758 \uc21c\uc11c\ub9cc \uc815\uad50\ud558\uac8c \uc7ac\ubc30\uc5f4\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uadfc\ub300 \uc554\ud638\uc778 \uc5d0\ub2c8\uadf8\ub9c8\ub294 \uc804\uce58 \uc554\ud638\uc640 \uce58\ud658 \uc554\ud638\ub97c \ubcf5\ud569\uc801\uc73c\ub85c \ud63c\ud569\ud558\uc5ec \ubb38\uc790\ub97c \uce58\ud658\ud558\uace0 \uc7ac\ubc30\uc5f4\ud558\ub294 \ubc29\uc2dd\uc73c\ub85c \ubc1c\uc804\ud588\uc2b5\ub2c8\ub2e4."
        }
