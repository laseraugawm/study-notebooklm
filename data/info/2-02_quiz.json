  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub514\uc9c0\ud138 \ub370\uc774\ud130 \uc554\ud638\ud654 \uae30\uc220\uc5d0\uc11c \uc554\ud638\ud654 \ud0a4\uc640 \ubcf5\ud638\ud654 \ud0a4\uc758 \uad00\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub300\uce6d\ud0a4 \uc554\ud638\ud654\ub294 \uc554\ud638\ud654 \ud0a4\uc640 \ubcf5\ud638\ud654 \ud0a4\uac00 \uc11c\ub85c \ub2e4\ub974\ub2e4.",
