        {
          "text": "\uacf5\uac1c\ud0a4 \uc554\ud638\ud654\ub294 \uc554\ud638\ud654\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \ud0a4\uc640 \ubcf5\ud638\ud654\ud560 \ub54c \uc0ac\uc6a9\ud558\ub294 \ud0a4\uac00 \uc11c\ub85c \ub2e4\ub974\ub2e4.",
          "isCorrect": true,
          "rationale": "\uacf5\uac1c\ud0a4 \uc554\ud638\ud654\ub294 \uc554\ud638\ud654\uc5d0 \uc0ac\uc6a9\ub418\ub294 \uacf5\uac1c\ud0a4\uc640 \ubcf5\ud638\ud654\uc5d0 \uc0ac\uc6a9\ub418\ub294 \uac1c\uc778\ud0a4\uac00 \uc11c\ub85c \ub2e4\ub974\uac8c \uc30d\uc744 \uc774\ub8e8\uc5b4 \ub3d9\uc791\ud569\ub2c8\ub2e4."
