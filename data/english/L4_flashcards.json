    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc2dc\uc758 \uc5b4\uba38\ub2c8 \ud06c\ub9ac\uc2dc\uac00 \ud074\ub77c\ub77c\uc5d0\uac8c \uc870\uc2dc\ub97c 'learn about'\uc774 \uc544\ub2c8\ub77c 'learn'\ud558\ub77c\uace0 \uc694\uad6c\ud588\ub358 \uc774\uc720\ub294?"
