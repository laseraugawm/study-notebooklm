    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce74\ud314\ub514 \uc528\uc758 \uc9c4\uc9dc \uc9c1\uc5c5\uacfc, \uadf8 \uadf8\uac00 \uc2a4\ud29c\ub514\uc624\uc5d0\uc11c \ud074\ub77c\ub77c\uc5d0\uac8c \uc2e4\uc2dc\ud55c \uc124\ubb38\uc9c0(questionnaire)\uc758 \uc9c4\uc9dc \ubaa9\uc801\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \uc9c4\uc9dc \uc9c1\uc5c5: \uacfc\ud559\uc790\n\u2022 \uc124\ubb38\uc758 \ubaa9\uc801: \ud074\ub77c\ub77c\uac00 \uc870\uc2dc\ub97c \uc5bc\ub9c8\ub098 \uc798 \uc54c\uace0 \uc788\uc73c\uba70, \uc870\uc2dc\uc758 \uac10\uc815\uacfc \uacb0\uc815\uc744 \uc5bc\ub9c8\ub098 \uae4a\uc774 \uc774\ud574\ud558\uace0 \uc788\ub294\uc9c0 \ud14c\uc2a4\ud2b8\ud558\uae30 \uc704\ud568"
