      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u2022 \ub9d0: \"\uc5b4\ub835\uac70\ub098 \ubb34\uc11c\uc6b4 \uc77c\uc774 \uc788\ub2e4\uba74 \ud568\uaed8 \ub9de\uc11c \ub098\uac08 \uac70\uc57c.\"\n\u2022 \ubab8\uc9d3: \ub450 \uc190\uc744 \ubaa8\uc544 \uac00\ubccd\uac8c \ud754\ub4e6 (\uc6b0\uc815\uc758 \ud45c\ud604)"
