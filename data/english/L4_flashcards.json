    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\uba38\ub2c8 \ud06c\ub9ac\uc2dc\uac00 \uc870\uc2dc\uc640 \ud074\ub77c\ub77c\ub97c \ub3c4\uc2dc\uc758 \uce74\ud314\ub514 \uc528 \uc2a4\ud29c\ub514\uc624\ub85c \ub370\ub824\uac04 \uac89\ubcf4\uae30 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
