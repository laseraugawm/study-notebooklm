    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "<\ud074\ub77c\ub77c\uc640 \ud574> \ud50c\ub86f \uad6c\uc131\uc5d0\uc11c '\uc704\uae30(Crisis)' \ub2e8\uacc4\uc5d0 \ud574\ub2f9\ud558\ub294 \uc0ac\uac74\uc740?"
