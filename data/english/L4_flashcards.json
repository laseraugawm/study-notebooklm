    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc2dc\uac00 \ud074\ub77c\ub77c\ub97c \uc9d1\uc73c\ub85c \ub370\ub824\uac00\uae30 \uc804, \ud074\ub77c\ub77c\uc5d0\uac8c \uc194\uc9c1\ud558\uac8c \ud138\uc5b4\ub193\uc740 \uc0ac\uc2e4\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
