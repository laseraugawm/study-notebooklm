    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc11c\ud3c9(Book Review)\uc744 \uc791\uc131\ud560 \ub54c \uc778\uc6a9\uad6c(Quote)\ub97c \ud3ec\ud568\ud558\ub294 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
