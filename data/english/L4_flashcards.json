    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\ub77c\uac00 \uce74\ud314\ub514 \uc528\uc758 \uc0ac\ubb34\uc2e4\uc5d0\uc11c \ubc1c\uacac\ud55c \uacf5\uc911\uc5d0 \ub5a0 \uc788\ub294 \uc870\uc2dc \ubaa8\uc2b5\uc758 \uc815\uccb4\ub294 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
