    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\ub77c\uac00 \ub85c\ubd07 \uc0c1\uc810 \ucc3d\ubc16 \uc138\uc0c1\uc744 \uc138\uc2ec\ud558\uac8c \uad00\ucc30\ud588\ub358 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
