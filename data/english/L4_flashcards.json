    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ub2e8\uc5b4 'learn'\uacfc 'learn about'\uc758 \uc758\ubbf8\uc801 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
