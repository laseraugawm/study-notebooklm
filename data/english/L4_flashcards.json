      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc2e0\uc774 \uc5b4\ub5a4 \ub0a0\uc5d0\ub294 \uadf8\ub2e4\uc9c0 \uac74\uac15\ud558\uc9c0 \uc54a\uac70\ub098 \ud589\ubcf5\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\ub2e4\ub294 \uc810"
