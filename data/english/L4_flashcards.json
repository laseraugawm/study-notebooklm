          {
            "type": "text",
            "content": "1. \uc608\uae30\uce58 \ubabb\ud55c \uce58\uba85\uc801 \ubd80\uc791\uc6a9 \ubc1c\uc0dd \uc704\ud5d8\n2. \uc0ac\ud68c\uc801 \ubd88\ud3c9\ub4f1 \uc2ec\ud654 \ubc0f \uc724\ub9ac\uc801 \ubb38\uc81c (\uc608: \uc720\uc804\uc790 \uc2dc\uc220\uc744 \ubc1b\uc740 \uc0ac\ub78c\uacfc \ubc1b\uc9c0 \ubabb\ud55c \uc0ac\ub78c \uac04\uc758 \uaca9\ucc28)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud1a0\ub860 \uc911 \uc0c1\ub300\ubc29\uc758 \ubc1c\uc5b8\uc744 \ub4e4\uc73c\uba70 '\uace0\uac1c\ub97c \ub044\ub355\uc774\ub294(nodding)' \ube44\uc5b8\uc5b4\uc801 \ud589\ub3d9\uc774 \uac16\ub294 \uae30\ub2a5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uccad\ud558\uace0 \uc788\uc74c\uc744 \ubcf4\uc5ec\uc8fc\uace0, \uc0c1\ub300\uc758 \uc758\uacac\uc744 \uc774\ud574\ud558\uac70\ub098 \uc77c\ubd80 \ub3d9\uc758\ud568\uc744 \ub098\ud0c0\ub0c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud1a0\ub860 \uc2dc \uc874\uc911\ud558\ub294 \ud0dc\ub3c4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc9c0\ucf1c\uc57c \ud560 \uc8fc\uc758\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
