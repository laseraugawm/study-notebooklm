    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc2dc\uac00 \ud559\uad50\uc5d0 \uac00\uc9c0 \uc54a\uace0 \ub300\ubd80\ubd84\uc758 \uc2dc\uac04\uc744 \uc9d1\uc5d0\uc11c \ubcf4\ub0b4\uba70 \uad50\uc721\ubc1b\uc740 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
