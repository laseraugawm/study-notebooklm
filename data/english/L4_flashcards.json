      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc791\ud488: <\ud504\ub791\ucf04\uc288\ud0c0\uc778 (Frankenstein)>\n\uc791\uac00: \uba54\ub9ac \uc178\ub9ac (Mary Shelley, 1818)"
