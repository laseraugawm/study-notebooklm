      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\ub77c\uac00 \uc870\uc2dc\uc5d0 \ub300\ud574 \uad00\ucc30\ud55c \ub0b4\uc6a9\uc744 \uc9c8\ubb38\ud558\uc5ec \uad00\ucc30\ub825\uc744 \ud655\uc778\ud55c \ud6c4, \uacc4\uc18d\ud574\uc11c \uc870\uc2dc\ub97c \uc544\ub07c\uace0 \ubcf4\uc0b4\ud3b4 \uc904 \uac83\uc744 \uc694\uccad\ud588\uc2b5\ub2c8\ub2e4."
