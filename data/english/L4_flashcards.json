    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ub9ac\ud504\ud305' \uc2dc\uc220\uc774 \uc870\uc2dc\uc5d0\uac8c \uac00\uc838\uc628 \uc2ec\uac01\ud55c \ubd80\uc791\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
