    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud06c\ub9ac\uc2dc(\uc870\uc2dc\uc758 \uc5b4\uba38\ub2c8)\uac00 \ud074\ub77c\ub77c\ub97c \uad6c\ub9e4\ud558\uae30 \uc804\uc5d0 \ud655\uc778\ud55c \uc870\uac74\uacfc \ubd80\ud0c1\ud55c \ub0b4\uc6a9\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
