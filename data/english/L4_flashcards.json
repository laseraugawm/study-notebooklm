      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'\ub9ac\ud504\ud305' \ubd80\uc791\uc6a9\uc73c\ub85c \uc778\ud55c \ub9cc\uc131 \uc9c8\ud658\uc73c\ub85c \uc778\ud574 \uc790\uc8fc \uce68\ub300\uc5d0 \ub204\uc6cc \uc9c0\ub0b4\uc57c \ud588\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
