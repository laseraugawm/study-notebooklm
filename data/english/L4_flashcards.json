      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\ub77c\ub294 \ud0dc\uc591\uc5f4\ub85c \uc791\ub3d9\ud569\ub2c8\ub2e4. \ud587\ube5b\uc758 \uc601\uc591(Sun's nourishment)\uc744 \ubc1b\uc73c\uba74 \uac74\uac15\uc744 \uc720\uc9c0\ud558\uc9c0\ub9cc, \ud587\ube5b\uc774 \uc5c6\uc73c\uba74 \uae30\ub825\uc774 \uc5c6\uace0 \uc0dd\uae30\uac00 \uc5c6\uc5b4\uc9d1\ub2c8\ub2e4."
