      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc45\uc5d0 \ub300\ud55c \uc790\uc2e0\uc758 \uc0dd\uac01\uc774\ub098 \uc8fc\uc81c\uc758\uc2dd\uc744 \ub4b7\ubc1b\uce68\ud558\ub294 \uad6c\uccb4\uc801\uc778 \uc99d\uac70/\uc608\uc2dc\ub85c \ud65c\uc6a9\ud558\uae30 \uc704\ud568"
