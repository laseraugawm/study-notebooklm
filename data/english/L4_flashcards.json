    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud074\ub77c\ub77c(Klara)\uc758 \uc5d0\ub108\uc9c0\uc6d0\uacfc, \ud587\ube5b\uc774 \uc5c6\uc744 \ub54c \ud074\ub77c\ub77c\uac00 \ubcf4\uc774\ub294 \uc0c1\ud0dc \ubcc0\ud654\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
