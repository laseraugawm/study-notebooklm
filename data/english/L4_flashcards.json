    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc2dc\uac00 \ubc1b\uc740 '\ub9ac\ud504\ud305(lifting)' \uc2dc\uc220\uc774\ub780 \ubb34\uc5c7\uc774\uba70, \uadf8 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
