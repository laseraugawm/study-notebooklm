          {
            "type": "text",
            "content": "\uce74\ud314\ub514 \uc528\uc640 \ud06c\ub9ac\uc2dc\uac00 \uc870\uc2dc \ubaa8\ubab0\ub798 \uc900\ube44\ud558\uace0 \uc788\ub358 \ube44\ubc00 \uacc4\ud68d\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
