      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba70\uce60 \ub3d9\uc548 \uaf3c\uc9dd\uc5c6\uc774 \uce68\ub300\uc5d0 \ub204\uc6cc\uc788\uac8c \ub9cc\ub4dc\ub294 \uc6d0\uc778 \ubd88\uba85\uc758 \ub9cc\uc131 \uc9c8\ud658 (\uc5b8\ub2c8 \uc0b4\uc758 \ubaa9\uc228\uc744 \uc557\uc544\uac04 \uac83\uacfc \uc720\uc0ac\ud55c \ubd80\uc791\uc6a9)"
