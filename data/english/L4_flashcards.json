      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\ub824\uc2ec \uae4a\uace0 \ub3c4\uc6c0\uc774 \ub418\ub294 AF(Artificial Friend)\uac00 \ub418\uae30 \uc704\ud574 \ud544\uc694\ud55c \ubaa8\ub4e0 \uac83\uc744 \ubc30\uc6b0\uace0\uc790 \ud588\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
