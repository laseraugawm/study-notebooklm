      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ub300\ubc29 \uc778\uc2e0\uacf5\uaca9\uc744 \ud558\uc9c0 \uc54a\uace0, \ub17c\uc758\ub418\uace0 \uc788\ub294 \uc774\uc288\uc640 \uc544\uc774\ub514\uc5b4 \uc790\uccb4\uc5d0 \uc9d1\uc911\ud558\uc5ec \ubc1c\uc5b8\ud574\uc57c \ud568"
          }
        ]
