      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc2dc\uc758 \ucd08\uc0c1\ud654(portrait)\ub97c \uadf8\ub9ac\uae30 \uc704\ud568"
