    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc2dc\uc758 \uc0c1\ud0dc \uace0\ubc31\uc5d0 \ub300\ud574 \ud074\ub77c\ub77c\ub294 \uc5b4\ub5a4 \ub9d0\uacfc \ubab8\uc9d3\uc73c\ub85c \uc870\uc2dc\uc758 \uce5c\uad6c\uac00 \ub418\uaca0\ub2e4\ub294 \uc758\uc9c0\ub97c \ud45c\ud604\ud588\ub098\uc694?"
