      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae38\uac70\ub9ac\uc5d0 \uc6c0\uc9c1\uc774\uc9c0 \uc54a\uace0 \ub204\uc6cc \uc788\uc5b4 \uc8fd\uc5c8\ub2e4\uace0 \uc0dd\uac01\ud588\ub358 \ub178\uc219\uc790\uac00, \ub2e4\uc74c \ub0a0 \uc544\uce68 \ud587\uc0b4\uc774 \ube44\ucd94\uc790 \uc77c\uc5b4\ub098 \uac1c\ub97c \uc4f0\ub2e4\ub4ec\ub294 \ubaa8\uc2b5\uc744 \ubcf4\uace0 \ud574\uac00 \uadf8\ub97c \uc0b4\ub838\ub2e4\uace0 \ubbff\uc5c8\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
