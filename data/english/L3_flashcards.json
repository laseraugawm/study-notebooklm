        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uad6c \uc218\ud559\uc790(research mathematician)\uac00 \ub420 \uc218 \uc788\ub3c4\ub85d \uc900\ube44\uc2dc\ucf1c \uc8fc\uaca0\ub2e4\uace0 \ud588\uc73c\ub098, \uc77c\uc790\ub9ac\ub97c \ucc3e\ub294 \uac83\uc740 \uc2a4\uc2a4\ub85c\uc758 \uacfc\uc81c\ub77c\uace0 \ub9d0\ud588\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1935\ub144 \ucd5c\uace0 \uc601\uc608\ub85c \ub300\ud559\uc744 \uc878\uc5c5\ud55c 18\uc138\uc758 \uce90\uc11c\ub9b0 \uc874\uc2a8\uc774 \uc2dc\uc791\ud55c \uccab \uc9c1\uc5c5\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud751\uc778 \uacf5\ub9bd\ud559\uad50\uc758 \uad50\uc0ac(teacher)\uc600\uc2b5\ub2c8\ub2e4. \ub2f9\uc2dc \uadf8\ub140\uac00 \uc120\ud0dd\ud560 \uc218 \uc788\uc5c8\ub358 \uc720\uc77c\ud55c \uc9c1\uc5c5\uc774\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce90\uc11c\ub9b0 \uc874\uc2a8\uc774 \ubc84\uc9c0\ub2c8\uc544\uc5d0 \uc704\uce58\ud55c NASA \ud544\ub4dc \uc13c\ud130\uc5d0 \ucde8\uc5c5\ud55c \uc5f0\ub3c4\uc640 \ucd08\uae30 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1953\ub144\uc5d0 \uc785\uc0ac\ud558\uc5ec \ubc31\uc778 \ub0a8\uc131 \uc5d4\uc9c0\ub2c8\uc5b4\ub4e4\uc744 \uc9c0\uc6d0\ud558\uae30 \uc704\ud574 \uc218\ub3d9\uc73c\ub85c \ubcf5\uc7a1\ud55c \uacc4\uc0b0\uc744 \uc218\ud589\ud558\ub294 'Black computer(\ud751\uc778 \uacc4\uc0b0\uc6d0)'\ub85c \uc77c\ud588\uc2b5\ub2c8\ub2e4."
          }
        ]
