    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce90\uc11c\ub9b0 \uc874\uc2a8\uc774 \ud751\uc778 \ub300\ud559\uc5d0 \uc785\ud559\ud55c \ub098\uc774\uc640 \ub300\ud559 3\ud559\ub144 \ub54c\uc758 \uc218\ud559 \uc218\uac15 \uc0c1\ud669\uc740 \uc5b4\ub5a0\ud588\ub098\uc694?"
          }
        ]
