    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ud559 \uba58\ud1a0\uac00 \uce90\uc11c\ub9b0 \uc874\uc2a8\uc5d0\uac8c \uc81c\uc548\ud55c \uc9c4\ub85c\uc640 \uad6c\uc9c1\uc5d0 \ub300\ud574 \ud55c \ub9d0\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
