      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ud5a5 \ud559\uad50\uc5d0 \uc778\uc885 \uaca9\ub9ac \uad50\uc721 \uc81c\ub3c4\uac00 \uc788\uc5b4 \ud751\uc778 \ud559\uc0dd\uc774 \uace0\ub4f1\ud559\uad50\uc5d0 \uc9c4\ud559\ud560 \uc218 \uc5c6\uc5c8\uae30 \ub54c\ubb38\uc5d0, \uace0\ub4f1\ud559\uad50 \uc9c4\ud559\uc744 \uc704\ud574 \uc774\uc0ac\ud588\uc2b5\ub2c8\ub2e4."
