      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb34\uc2e4 \ub0b4 \uc778\uc885 \uaca9\ub9ac(segregation in the office)\uc640 \uc804\ubb38\uc9c1 \uc5ec\uc131\uc784\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 'girl(\uc544\uc774)'\ub85c \ubd88\ub9ac\ub294 \ube44\ud558\uc801 \ub300\uc6b0\ub97c \ubc1b\uc558\uc2b5\ub2c8\ub2e4."
