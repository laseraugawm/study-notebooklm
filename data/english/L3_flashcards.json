    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1960\ub144 \uce90\uc11c\ub9b0 \uc874\uc2a8\uc774 \uc791\uc131\ud55c \uc5f0\uad6c \ub17c\ubb38\uc758 \uc5ed\uc0ac\uc801 \uc758\uc758\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
