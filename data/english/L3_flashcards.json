    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "NASA \uc785\uc0ac \ucd08\uae30 'Black computers' \uc5ec\uc131\ub4e4\uc774 \uacaa\uc5b4\uc57c \ud588\ub358 \ucc28\ubcc4 \uc694\uc18c \ub450 \uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
