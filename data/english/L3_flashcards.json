    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc874 \uae00\ub80c\uc758 \uc6b0\uc8fc\uc120 \uada4\ub3c4 \uc218\uce58\ub97c \uc7ac\uac80\uc99d\ud560 \ub54c \uce90\uc11c\ub9b0 \uc874\uc2a8\uc774 \uc0ac\uc6a9\ud55c \ub3c4\uad6c\uc640 \uac78\ub9b0 \uc2dc\uac04\uc740 \uc5bc\ub9c8\uc778\uac00\uc694?"
