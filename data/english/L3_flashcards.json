{
  "title": "\uce90\uc11c\ub9b0\uc874\uc2a8 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce90\uc11c\ub9b0 \uc874\uc2a8(Katherine Johnson)\uc740 \uba87 \ub144\ub3c4\uc5d0 \uc5b4\ub514\uc5d0\uc11c \ud0dc\uc5b4\ub0ac\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1918\ub144 8\uc6d4 26\uc77c \ubbf8\uad6d \uc6e8\uc2a4\ud2b8\ubc84\uc9c0\ub2c8\uc544(West Virginia)\uc5d0\uc11c \ud0dc\uc5b4\ub0ac\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub9b0 \uc2dc\uc808 \uce90\uc11c\ub9b0 \uc874\uc2a8\uc758 \ud2b9\uae30\uc774\uc790 \uc2b5\uad00\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
