      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "15\uc138\uc758 \ub098\uc774\uc5d0 \ub300\ud559\uc5d0 \uc785\ud559\ud588\uc73c\uba70, 3\ud559\ub144\uc774 \ub418\uc5c8\uc744 \ub54c\ub294 \ub300\ud559\uc5d0\uc11c \uc81c\uacf5\ud558\ub294 \ubaa8\ub4e0 \uc218\ud559 \uacfc\uc815\uc744 \uc774\ubbf8 \uc218\uac15 \ub9c8\ucce4\uc2b5\ub2c8\ub2e4."
