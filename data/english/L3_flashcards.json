    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc874 \uae00\ub80c\uc774 \uce90\uc11c\ub9b0 \uc874\uc2a8\uc758 \uc218\uae30 \uacc4\uc0b0 \ub2a5\ub825\uc744 \uc2e0\ub8b0\ud558\uba70 \ub0a8\uae34 \uc720\uba85\ud55c \ubc1c\uc5b8\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
