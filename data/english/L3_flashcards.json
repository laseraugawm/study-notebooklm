    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1962\ub144 \ucd08 \ubbf8\uad6d \ucd5c\ucd08\uc758 \uc9c0\uad6c \uada4\ub3c4 \ube44\ud589\uc744 \uc900\ube44\ud558\ub358 \uc6b0\uc8fc\ube44\ud589\uc0ac \uc874 \uae00\ub80c(John Glenn)\uc774 \uce90\uc11c\ub9b0 \uc874\uc2a8\uc5d0\uac8c \uc694\uccad\ud55c \uc77c\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
