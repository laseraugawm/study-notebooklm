        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\ud559 \uc2e0\ub3d9\uc774\uc5c8\uc73c\uba70, \ub3c4\ub85c\uae4c\uc9c0\uc758 \uac78\uc74c \uc218, \uad50\ud68c \uacc4\ub2e8 \uc218, \uc124\uac70\uc9c0\ud558\ub294 \uc811\uc2dc\uc640 \uc218\uc800 \uac1c\uc218 \ub4f1 \ub208\uc5d0 \ubcf4\uc774\ub294 \ubaa8\ub4e0 \uac83\uc744 \uc138\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uce90\uc11c\ub9b0 \uc874\uc2a8\uc758 \uc544\ubc84\uc9c0\uac00 \uac00\uc871\uc744 $200\\text{ km}$ \ub5a8\uc5b4\uc9c4 \uacf3\uc73c\ub85c \uc774\uc8fc\uc2dc\ud0a8 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
