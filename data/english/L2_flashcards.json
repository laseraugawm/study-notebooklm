{
  "title": "\ubc30\ub2ec\ubb38\ud654 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'specialize'\uc758 \ubcf8\ubb38\uc0c1 \uc815\uc758\uc640 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \ubd84\uc57c\uc5d0 \uc9d1\uc911\ud558\ub2e4 (to focus on doing something more than other things) / ~\uc744 \uc804\ubb38\uc73c\ub85c \ud558\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'transportation'\uc758 \ubcf8\ubb38\uc0c1 \uc815\uc758\uc640 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uc7a5\uc18c\uc5d0\uc11c \ub2e4\ub978 \uc7a5\uc18c\ub85c \ubb3c\ud488\uc744 \uc774\ub3d9\uc2dc\ud0a4\ub294 \ud589\uc704 (movement of goods from one place to another) / \uc6b4\uc1a1, \uc218\uc1a1."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'express'\uc758 \ubcf8\ubb38\uc0c1 \uc815\uc758\uc640 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc18d\ud558\uace0 \ud6a8\uc728\uc801\uc778 (being rapid and efficient) / \uace0\uc18d\uc758, \uc2e0\uc18d\ud55c."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "'deliver'\uc758 \ubcf8\ubb38\uc0c1 \uc815\uc758\uc640 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud2b9\uc815 \uc0ac\ub78c\uc774\ub098 \uc7a5\uc18c\ub85c \ubb3c\ud488\uc744 \uc6b4\ubc18\ud558\ub2e4 (to carry items to a specific person or space) / \ubc30\ub2ec\ud558\ub2e4, \uc804\ub2ec\ud558\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcf8\ubb38\uc5d0 \ub4f1\uc7a5\ud558\ub294 \uad00\uc6a9\uad6c 'rule of thumb'\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\ud5d8\uc5d0 \ubc14\ud0d5\uc744 \ub454 \uc77c\ubc18\uc801\uc778 \uc9c0\uce68(\uacbd\ud5d8\uce59). \ubcf8\ubb38\uc5d0\uc11c\ub294 \ud0dd\ubc30\uc758 \uae30\ubcf8 \ubc30\uc1a1 \uae30\uc900\uc778 '\uc775\uc77c \ubc30\uc1a1(next-day delivery)'\uc744 \uac00\ub9ac\ud0b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\ub2ec \uc5b4\ud50c\ub9ac\ucf00\uc774\uc158\uc774 \ub9e4\uc7a5 \uc21c\uc704\ub97c \ucd94\ucc9c\ud560 \ub54c \uae30\uc900\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uc694\uc18c\uc5d0\ub294 \uc5b4\ub5a4 \uac83\ub4e4\uc774 \uc788\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9ac\ubdf0 \uc810\uc218, \uc778\uae30\ub3c4, \uac00\uaca9, \ubc30\ub2ec\ube44, \uac70\ub9ac \ub4f1."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d\uc758 \uc74c\uc2dd \ubc30\ub2ec \uc5ed\uc0ac\uac00 \ucd5c\uc18c 250\ub144 \uc774\uc0c1 \ub418\uc5c8\uc74c\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc5ed\uc0ac\uc801 \ubb38\ud5cc\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1768\ub144 \ud559\uc790 \ud669\uc724\uc11d\uc774 \uacfc\uac70 \uc2dc\ud5d8(gwageo)\uc744 \uce58\ub978 \ud6c4 \uce5c\uad6c\ub4e4\uacfc \ub0c9\uba74(naengmyeon)\uc744 \uc8fc\ubb38\ud574 \uba39\uc5c8\ub2e4\uace0 \uae30\ub85d\ud55c \uc77c\uae30."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc120 \uc2dc\ub300 \ub3c4\ub85c\uba85 \uc8fc\uc18c\uac00 \uc5c6\ub358 \uc2dc\uc808, \uc11c\uc2e0 \ubc30\ub2ec \uc778\ub825\uc778 '\uc804\uc778(jeonin)'\uc740 \uc5b4\ub5bb\uac8c \ud3b8\uc9c0\ub97c \ubc30\ub2ec\ud588\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc2e0\uc778\uc758 \uc774\ub984\uacfc \uac70\uc8fc\uc9c0 \uc815\ubcf4\ub97c \ubc14\ud0d5\uc73c\ub85c \ubc30\ub2ec\ud588\uc73c\uba70, \uc774\ub97c \uc704\ud574 \uc9c0\uc5ed \uc9c0\ub9ac\ub97c \uc644\ubcbd\ud788 \uc219\uc9c0\ud574\uc57c \ud588\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\uc120 \uc2dc\ub300 \uc11c\uc2e0 \ubc30\ub2ec \uc11c\ube44\uc2a4 '\uc804\uc778'\uc758 \uc694\uae08 \uacb0\uc815 \uae30\uc900 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\ub2ec \uc77c\uc815(\uc2dc\uac04)\uacfc \ubc30\ub2ec \uac70\ub9ac."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1930\ub144\ub300 \uc77c\uc81c\uac15\uc810\uae30 \ubc30\ub2ec \ud68c\uc0ac '\uc6a9\ub2ec\uc0ac'\uc758 \ubc30\ub2ec\uc6d0(\"\uba54\uc2e0\uc800\")\ub4e4\uc774 \uc0ac\uc6a9\ud55c \uc2e0\uc18d \ubc30\ub2ec \uad50\ud1b5\uc218\ub2e8\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc804\uac70 (bikes)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc81c\uac15\uc810\uae30 \ubc30\ub2ec\uc6d0(\"\uba54\uc2e0\uc800\")\ub4e4\uc774 \uac70\uc561\uc758 \ud604\uae08\uc744 \uc6b4\ubc18\ud560 \ub54c\ub3c4 \uace0\uac1d\uc758 \uae4a\uc740 \uc2e0\ub8b0\ub97c \uc5bb\uc740 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\ub2ec \uc624\ub958\uac00 \uac70\uc758 \uc5c6\uc5c8\uc73c\uba70, \ubcc0\ud568\uc5c6\uc774 \uc815\uc9c1\ud558\uace0 \uc815\ud655\ud588\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc81c\uac15\uc810\uae30 \uc6a9\ub2ec\uc0ac '\uba54\uc2e0\uc800' \ubc30\ub2ec\uc6d0\ub4e4\uc758 \uc5c5\ubb34 \uc6d0\uce59 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1) \uc790\uc804\uac70\ub85c \uc6b4\ubc18 \uac00\ub2a5\ud55c \uc18c\ud615 \ubb3c\ud488(\ud3b8\uc9c0, \uc0c1\uc790)\ub9cc \ubc30\ub2ec\ud568\n2) \uc2e0\uc18d \ubc30\uc1a1 \uc57d\uc18d\uc744 \uc9c0\ud0a4\uae30 \uc704\ud574 \uc11c\uc6b8 \uc911\uc2ec\ubd80 \ub0b4\uc5d0\uc11c\ub9cc \ud65c\ub3d9\ud568"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6a9\ub2ec\uc0ac\uc758 \uba54\uc2e0\uc800 \ubc30\ub2ec \uc11c\ube44\uc2a4\uac00 \ud604\ub300 \ubc30\ub2ec \ubb38\ud654\uc5d0 \ubbf8\uce5c \uc5ed\uc0ac\uc801 \uc758\uc758\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0c1\ud638 \uc2e0\ub8b0\uc640 \uc18d\ub3c4\uc5d0 \ub300\ud55c \uc5f4\ub9dd\uc744 \ubc14\ud0d5\uc73c\ub85c \ud604\ub300 \uc624\ud1a0\ubc14\uc774 \ubc30\ub2ec \uc11c\ube44\uc2a4\uc758 \uae38\uc744 \ud130\uc8fc\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\ubcf5\uacfc \ud55c\uad6d\uc804\uc7c1 \uc774\ud6c4 \ubb34\ub108\uc9c4 \ud55c\uad6d\uc758 \ubc30\ub2ec \uc2dc\uc2a4\ud15c\uc774 1960\ub144\ub300\uc5d0 \ub2e4\uc2dc \ubd80\ud65c\ud558\uac8c \ub41c \uacc4\uae30\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae09\uaca9\ud55c \ub3c4\uc2dc\ud654(urbanization)\uc640 \uacbd\uc81c \uc131\uc7a5\uc73c\ub85c \uc778\ud574 \ub3c4\uc2ec \uc9c0\uc5ed\uc73c\ub85c \ub178\ub3d9\ub825\uc774 \uc9d1\uc911\ub418\uc5c8\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1960\ub144\ub300 \ub3c4\uc2dc\ud654 \uc9c4\ud589\uacfc \ud568\uaed8 \ube60\ub974\uac8c \ub300\uc911\ud654\ub41c \ub300\ud45c\uc801\uc778 \uc218\uc1a1 \ubb3c\ud488 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\ubb38(newspapers)\uacfc \uc6b0\uc720(milk)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1970\ub144\ub300 \ud55c\uad6d \ub3c4\uc2dc \uc911\uc2ec\uc9c0\uc758 \uc810\uc2ec\uc2dc\uac04 \ubc30\ub2ec \ud48d\uacbd\uc758 \ub3c5\ud2b9\ud55c \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc774\uc5c8\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ub2f9 \uc9c1\uc6d0\ub4e4\uc774 \uc74c\uc2dd\uc774 \ub2f4\uae34 \uc7c1\ubc18\uc744 \uacb9\uacb9\uc774 \uc313\uc544 \uc62c\ub824 \uba38\ub9ac\ub098 \uc5b4\uae68\uc5d0 \ub4e4\uace0 \ubc30\ub2ec\ud558\ub294 \ubaa8\uc2b5."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1980\ub144\ub300 \ud6c4\ubc18~1990\ub144\ub300 \ucd9c\uc7a5 \uc74c\uc2dd \uc5c5\uccb4(caterers)\uc758 \uc0ac\ubb34\uc2e4 \ub3c4\uc2dc\ub77d \ubc30\ub2ec \ubc0f \ud68c\uc218 \ubc29\uc2dd\uc740 \uc5b4\ub5a0\ud588\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucc9c \uac00\ubc29\uc5d0 \uc218\uc81c \ub3c4\uc2dc\ub77d\uc744 \ub2f4\uc544 \ubc30\ub2ec\ud558\uace0, \uc2dd\uc0ac \ud6c4 \uc794\ubc18\uc774 \ub0a8\uc740 \ube48 \uadf8\ub987\uc744 \ud68c\uc218\ud558\ub7ec \ub2e4\uc2dc \ubc29\ubb38\ud588\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1992\ub144\uc5d0 \ucc98\uc74c \ub3c4\uc785\ub41c \ud55c\uad6d\uc758 '\ud0dd\ubc30(taekbae)' \uc11c\ube44\uc2a4\uc758 \uccab\ub0a0 \uc2e4\uc801\uacfc \ud604\uc7ac \ud3c9\uade0 \uc774\uc6a9 \ud69f\uc218\ub294 \uc5b4\ub5a0\ud55c\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccab\ub0a0\uc740 \ub2e8 2\uac74\uc5d0 \ubd88\uacfc\ud588\uc73c\ub098, \ud604\uc7ac\ub294 \ud55c\uad6d\uc778 1\uc778\ub2f9 \uc5f0\ud3c9\uade0 \uc57d 65\ud68c \uc774\uc6a9\ud560 \uc815\ub3c4\ub85c \uae09\uc131\uc7a5\ud588\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dd\ubc30 \uc11c\ube44\uc2a4\uc758 \ube44\uc57d\uc801\uc778 \uc131\uc7a5\uc744 \uac00\ub2a5\ud558\uac8c \ud55c \uae30\uc220\uc801\u00b7\uc0b0\uc5c5\uc801 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c\ub958 \uc790\ub3d9\ud654, GPS \uc9c0\ub3c4, \ubaa8\ubc14\uc77c \uc571 \ub4f1 \ub514\uc9c0\ud138 IT \uae30\uc220\uc758 \ubc1c\uc804\uacfc \uc804\uc790\uc0c1\uac70\ub798(e-commerce)\uc758 \ud3ed\ubc1c\uc801 \uc131\uc7a5."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd5c\uadfc \ud0dd\ubc30 \uc11c\ube44\uc2a4\uc758 \uae09\uaca9\ud55c \ubcc0\ud654\ub85c \uac00\ub2a5\ud574\uc9c4 \uc0c8\ub85c\uc6b4 \uc11c\ube44\uc2a4 \ud615\ud0dc 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2f9\uc77c \ubc30\uc1a1(same-day delivery)\uacfc \ubc30\uc1a1 \ud76c\ub9dd \ub0a0\uc9dc/\uc2dc\uac04 \uc9c0\uc815 \uc11c\ube44\uc2a4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d\uc758 \ubb3c\ub958 \ud68c\uc0ac\ub4e4\uc774 \ubbf8\ub798 \ubc30\uc1a1\uc744 \uc704\ud574 \uc2dc\ud5d8 \uc911\uc778 \ucca8\ub2e8 \uc7a5\ube44 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc728\uc8fc\ud589 \ucc28\ub7c9(autonomous vehicles), \ubc30\ub2ec \ub85c\ubd07(delivery robots), \ub4dc\ub860(drones)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c\uad6d \ubc30\ub2ec \uc0b0\uc5c5\uc774 \uace0\uac1d \uc2e0\ub8b0\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uac00\uc7a5 \uc6b0\uc120\uc2dc\ud558\ub294 3\uac00\uc9c0 \ud575\uc2ec \uac00\uce58\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc18d\ud568(rapid), \uc548\uc804\ud568(safe), \ubd80\ub2f4 \uc5c6\ub294 \ube44\uc6a9(affordable)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ub3c4\uc758 '\ub2e4\ubc14\uc640\ub77c(dabbawala)'\uac00 \uc81c\uacf5\ud558\ub294 \uc8fc\uc694 \uc11c\ube44\uc2a4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb44\ubc14\uc774 \uc9c0\uc5ed\uc5d0\uc11c \uac00\uc815\uc5d0\uc11c \ub9cc\ub4e0 \uc810\uc2ec \ub3c4\uc2dc\ub77d\uc744 \uac01 \uc9c1\uc7a5\uc758 \uc0ac\uc6a9\uc790\uc5d0\uac8c \ubc30\ub2ec\ud574 \uc8fc\ub294 \uc11c\ube44\uc2a4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ub3c4 \ub2e4\ubc14\uc640\ub77c \uc11c\ube44\uc2a4\uc758 \ub3c4\uc2dc\ub77d \ubc30\ub2ec \uacfc\uc815 \uc911 \uc624\uc804 9\uc2dc\ubd80\ud130 12\uc2dc 30\ubd84\uae4c\uc9c0\uc758 \uc8fc\uc694 \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc624\uc804 9\uc2dc\uae4c\uc9c0 \uac01 \uac00\uc815\uc5d0\uc11c \ub3c4\uc2dc\ub77d \uc218\uac70 -> \uae30\ucc28\uc5ed \uc774\ub3d9 \ud6c4 \uc815\ud574\uc9c4 \uae30\ucc28 \ud0d1\uc2b9 -> 12\uc2dc 30\ubd84\uae4c\uc9c0 \ubb44\ubc14\uc774\uc758 \uc9c1\uc7a5 \ubaa9\uc801\uc9c0\uc5d0 \ubc30\ub2ec \uc644\ub8cc."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
