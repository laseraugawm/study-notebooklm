{
  "title": "\ubc30\ub2ec\ubb38\ud654 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc870\uc120 \uc2dc\ub300\uc758 \ud3b8\uc9c0 \ubc30\ub2ec \uc778\ub825\uc778 '\uc804\uc778(jeonin)'\uc5d0 \ub300\ud55c \uc124\uba85 \uc911, \ubcf8\ubb38\uc758 \ub0b4\uc6a9\uacfc \uc77c\uce58\ud558\uc9c0 \uc54a\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud604\ub300\uc801\uc778 \uc8fc\uc18c \uccb4\uacc4\ub97c \ud65c\uc6a9\ud558\uc5ec \ubc30\ub2ec\ud560 \uc7a5\uc18c\ub97c \uc815\ud655\ud558\uac8c \ucc3e\uc544\uac14\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc804\uc778\uc774 \ud65c\ub3d9\ud558\ub358 \uc2dc\uae30\ub294 \ub3c4\ub85c\uba85 \uc8fc\uc18c \ub4f1 \ud604\ub300\uc801 \uc8fc\uc18c \uccb4\uacc4\uac00 \ub3c4\uc785\ub418\uae30 \uc804\uc774\uc5c8\uc73c\ubbc0\ub85c, \uc218\uc2e0\uc790\uc758 \uc774\ub984\uacfc \uac70\uc8fc \uc9c0\uc5ed \uc815\ubcf4\ub97c \ubc14\ud0d5\uc73c\ub85c \uc9c0\ub9ac\ub97c \uc219\uc9c0\ud558\uc5ec \ubc30\ub2ec\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc77c\uc815\ud55c \uc218\uc218\ub8cc(fee)\ub97c \ubc1b\uace0 \ud3b8\uc9c0\ub97c \uc804\ub2ec\ud558\ub294 \uc804\ubb38 \uc778\ub825\uc774\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf8\ubb38\uc5d0\uc11c \uc804\uc778\uc740 \uc815\ud574\uc9c4 \uc694\uae08\uc744 \ubc1b\uace0 \ud3b8\uc9c0\ub97c \uc804\ub2ec\ud574 \uc8fc\ub294 \uc804\ubb38 \ubc30\ub2ec \uc778\ub825\uc73c\ub85c \uae30\uc220\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubc30\ub2ec \uc11c\ube44\uc2a4\uc758 \uac00\uaca9\uc740 \ubc30\ub2ec \uc77c\uc815\uacfc \uac70\ub9ac\uc5d0 \ub530\ub77c \uacb0\uc815\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804\uc778\uc758 \uc11c\ube44\uc2a4 \uac00\uaca9 \uae30\uc900\uc740 \ubc30\ub2ec\uc5d0 \uc18c\uc694\ub418\ub294 \uc77c\uc815\uacfc \uc774\ub3d9 \uac70\ub9ac\uc5d0 \ub530\ub77c \ub2e4\ub974\uac8c \ucc45\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub2f4\ub2f9 \uc9c0\uc5ed\uc758 \uc9c0\ub9ac\ub97c \ub9e4\uc6b0 \uc790\uc138\ud788 \uc54c\uace0 \uc788\uc5b4\uc57c \ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc8fc\uc18c \uccb4\uacc4\uac00 \uc5c6\ub358 \uc2dc\uc808\uc774\uc5c8\uae30 \ub54c\ubb38\uc5d0 \uc804\uc778\uc740 \ud574\ub2f9 \uc9c0\uc5ed\uc758 \uad6c\uc11d\uad6c\uc11d\uc744 \uc798 \uc54c\uace0 \uc788\uc5b4\uc57c\ub9cc \ubc30\ub2ec\uc774 \uac00\ub2a5\ud588\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud604\ub300\uc801\uc778 \uc8fc\uc18c \uc2dc\uc2a4\ud15c\uc774 \uad6c\ucd95\ub418\uae30 \uc804\uc774\ub77c\ub294 \uc2dc\ub300\uc801 \uc0c1\ud669\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc77c\uc81c\uac15\uc810\uae30 '\uc6a9\ub2ec\uc0ac' \uc18c\uc18d \ubc30\ub2ec\uc6d0(messengers)\uc758 \uc601\uc5c5 \ubc29\uc2dd \ubc0f \ud2b9\uc9d5\uc5d0 \ub300\ud55c \ubcf8\ubb38 \ub0b4\uc6a9\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2e0\uc18d\ud55c \ubc30\ub2ec \uc57d\uc18d\uc744 \uc9c0\ud0a4\uae30 \uc704\ud574 \uc11c\uc6b8 \uc911\uc2ec\ubd80\ubfd0\ub9cc \uc544\ub2c8\ub77c \uba3c \uc678\uacfd \uc9c0\uc5ed\uae4c\uc9c0 \ubc30\ub2ec \uad6c\uc5ed\uc744 \ub113\ud614\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubc30\ub2ec\uc6d0\ub4e4\uc740 \uba3c \uac70\ub9ac\ub97c \uc774\ub3d9\ud560 \uacbd\uc6b0 \uc18d\ub3c4\uac00 \ub290\ub824\uc838 \uc2e0\uc18d \ubc30\ub2ec \uc57d\uc18d\uc744 \uc9c0\ud0a4\uae30 \uc5b4\ub824\uc6e0\uae30 \ub54c\ubb38\uc5d0 \uc11c\uc6b8 \uc911\uc2ec\ubd80\ub85c \ud65c\ub3d9 \ubc94\uc704\ub97c \uc81c\ud55c\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubc30\ub2ec \uc18d\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud574 \uc790\uc804\uac70\ub97c \uc8fc\uc694 \uc774\ub3d9 \uc218\ub2e8\uc73c\ub85c \ud65c\uc6a9\ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2f9\uc2dc \ubc30\ub2ec\uc6d0\ub4e4\uc740 \uc2e0\uc18d\ud55c \ubb3c\ud488 \uc804\ub2ec\uc744 \uc704\ud574 \uc790\uc804\uac70\ub97c \uc801\uadf9\uc801\uc73c\ub85c \uc774\uc6a9\ud588\uc2b5\ub2c8\ub2e4."
