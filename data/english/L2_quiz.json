        {
          "text": "\uace0\uac1d\ub4e4\uc740 \ubc30\ub2ec\uc6d0\uc744 \uae4a\uc774 \uc2e0\ub8b0\ud558\uc5ec \ubb3c\ud488\uc744 \uc804\ub2ec\ubc1b\uc740 \ud6c4 \uc81c\ub300\ub85c \uc654\ub294\uc9c0 \ud655\uc778\uc870\ucc28 \ud558\uc9c0 \uc54a\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0c1\ud638 \uc2e0\ub8b0 \ubb38\ud654\uac00 \ubc14\ud0d5\uc774 \ub418\uc5b4 \ubc30\ub2ec \uc624\ucc28\uac00 \uac70\uc758 \uc5c6\uc5c8\uc73c\ubbc0\ub85c \uace0\uac1d\ub4e4\uc774 \ubb3c\ud488\uc744 \uc77c\uc77c\uc774 \ud655\uc778\ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
        }
