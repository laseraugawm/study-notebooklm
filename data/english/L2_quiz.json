        {
          "text": "\uace0\uac1d\uacfc\uc758 \ub450\ud130\uc6b4 \uc2e0\ub8b0 \ub355\ubd84\uc5d0 \ud070 \ub3c8\ubb49\uce58\ub97c \uc6b4\ubc18\ud558\ub294 \uc5c5\ubb34\ub97c \ub9e1\uae30\ub3c4 \ud588\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc30\ub2ec\uc6d0\ub4e4\uc758 \uc815\uc9c1\ud568\uacfc \uc815\ud655\uc131 \ub355\ubd84\uc5d0 \ub9ce\uc740 \uc561\uc218\uc758 \ud604\uae08 \ubb49\uce58\ub97c \uc6b4\ubc18\ud558\ub294 \uc2e0\ub8b0 \uae30\ubc18\uc758 \uc5c5\ubb34\ub3c4 \ub2f4\ub2f9\ud588\uc2b5\ub2c8\ub2e4."
