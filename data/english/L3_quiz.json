{
  "title": "\uce90\uc11c\ub9b0 \uc874\uc2a8 \ud034\uc988",
  "questions": [
    {
      "question": "Katherine Johnson\uc758 \ud559\ucc3d \uc2dc\uc808 \ubc0f \ucd08\uae30 \uacbd\ub825\uc5d0 \ub300\ud55c \uc124\uba85 \uc911 \uae00\uc758 \ub0b4\uc6a9\uacfc \uc77c\uce58\ud558\uc9c0 \uc54a\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "4\ub0a8\ub9e4 \uc911 \ub9c9\ub0b4\ub85c \ud0dc\uc5b4\ub0ac\uc73c\uba70 \uc5b4\ub9b4 \ub54c\ubd80\ud130 \uc0ac\ubb3c\uc758 \uac1c\uc218\ub97c \uc138\ub294 \uc2b5\uad00\uc774 \uc788\uc5c8\ub2e4.",
          "rationale": "\ubcf8\ubb38\uc5d0\uc11c \uadf8\ub140\ub294 4\ub0a8\ub9e4 \uc911 \ub9c9\ub0b4\uc600\uace0 \uacc4\ub2e8, \uc811\uc2dc, \ud3ec\ud06c \ub4f1\uc758 \uac1c\uc218\ub97c \uc14c\ub2e4\uace0 \uba85\uc2dc\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uace0\ud5a5\uc758 \uc778\uc885 \ucc28\ubcc4\uc801 \uad50\uc721 \uc2dc\uc2a4\ud15c \ub54c\ubb38\uc5d0 \uc544\ubc84\uc9c0\uac00 \uac00\uc871\uc744 200km \ub5a8\uc5b4\uc9c4 \uacf3\uc73c\ub85c \uc774\uc8fc\uc2dc\ucf30\ub2e4.",
          "rationale": "\uace0\ud5a5\uc5d0 \ud751\uc778 \ud559\uc0dd\uc774 \uc9c4\ud559\ud560 \uc218 \uc788\ub294 \uace0\ub4f1\ud559\uad50\uac00 \uc5c6\uc5b4 \uc544\ubc84\uc9c0\uac00 \uc774\uc0ac\ub97c \uacb0\uc2ec\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub300\ud559\uad50 \uc878\uc5c5 \ud6c4 \ub6f0\uc5b4\ub09c \uc218\ud559 \uc2e4\ub825\uc744 \ubc14\ud0d5\uc73c\ub85c \uace7\ubc14\ub85c \uc5f0\uad6c \uc218\ud559\uc790\ub85c \ucc44\uc6a9\ub418\uc5c8\ub2e4.",
          "rationale": "\ub300\ud559 \uc878\uc5c5 \uc9c1\ud6c4 \ub2f9\uc2dc \uadf8\ub140\uc5d0\uac8c \uc5f4\ub824 \uc788\ub358 \uc720\uc77c\ud55c \uc9c1\uc5c5\uc801 \uc120\ud0dd\uc9c0\ub294 \uacf5\ub9bd\ud559\uad50 \uad50\uc0ac\uc600\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "15\uc138\uc5d0 \ub300\ud559\uc5d0 \uc785\ud559\ud558\uc600\uace0 3\ud559\ub144 \ub54c \ub300\ud559\uc5d0\uc11c \uc81c\uacf5\ud558\ub294 \ubaa8\ub4e0 \uc218\ud559 \uacfc\uc815\uc744 \uc774\uc218\ud588\ub2e4.",
          "rationale": "1932\ub144 15\uc138\uc758 \ub098\uc774\ub85c \ub300\ud559\uc5d0 \ub4e4\uc5b4\uac04 \ud6c4 3\ud559\ub144 \ub54c \uac1c\uc124\ub41c \ubaa8\ub4e0 \uc218\ud559 \uacfc\ubaa9\uc744 \ub9c8\ucce4\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub300\ud559 \uc878\uc5c5 \uc9c1\ud6c4 \ub2f9\uc2dc \uc2dc\ub300 \uc0c1\ud669\uc5d0\uc11c \uadf8\ub140\uac00 \uc2e4\uc81c\ub85c \uc5bb\uc744 \uc218 \uc788\uc5c8\ub358 \uc720\uc77c\ud55c \uc9c1\uc5c5\uc774 \ubb34\uc5c7\uc774\uc5c8\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "Katherine Johnson\uc758 \ub300\ud559 \uc2dc\uc808 \uba58\ud1a0\uac00 \ud55c \ub9d0(\"That will be your problem.\")\uc774 \uc554\uc2dc\ud558\ub294 \ub2f9\uc2dc\uc758 \uc0ac\ud68c\uc801 \uc0c1\ud669\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc778\uc885\uacfc \uc131\ubcc4\ub85c \uc778\ud574 \ub6f0\uc5b4\ub09c \uc7ac\ub2a5\uc744 \uac00\uc838\ub3c4 \uc9c1\uc5c5\uc801 \uae30\ud68c\uac00 \uadf9\ud788 \uc81c\ud55c\uc801\uc774\uc5c8\ub2e4.",
          "rationale": "\ub2f9\uc2dc \uc0ac\ud68c\ub294 \ud751\uc778\uc774\uc790 \uc5ec\uc131 \uc5f0\uad6c\uc790\uac00 \uc124 \uc790\ub9ac\uac00 \ub9e4\uc6b0 \ubd80\uc871\ud588\uc74c\uc744 \uba58\ud1a0\uc758 \ubc1c\uc5b8\uc744 \ud1b5\ud574 \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub300\ud559 \uacfc\uc815\uc758 \ud559\uc5c5 \uc131\uc801\uc774 \ub0ae\uc73c\uba74 \uc5f0\uad6c \uc218\ud559\uc790\uac00 \ub420 \uc218 \uc5c6\ub2e4\ub294 \ub73b\uc774\uc5c8\ub2e4.",
          "rationale": "\uadf8\ub140\ub294 \ucd5c\uc6b0\uc218 \uc131\uc801\uc73c\ub85c \uc878\uc5c5\ud55c \ub6f0\uc5b4\ub09c \ud559\uc0dd\uc774\uc5c8\uc73c\ubbc0\ub85c \uc131\uc801 \ubb38\uc81c\uac00 \uc544\ub2c8\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "NASA\uc5d0\uc11c \uc778\uc7ac\ub97c \ucc44\uc6a9\ud560 \ub54c \ub300\ud559 \uba58\ud1a0\uc758 \ucd94\ucc9c\uc11c\ub97c \ud544\uc218 \ud56d\ubaa9\uc73c\ub85c \uc694\uad6c\ud588\ub2e4.",
          "rationale": "\uba58\ud1a0\ub294 \uadf8\ub140\uc758 \uc9c1\uc5c5 \ud0d0\uc0c9\uc5d0 \uc874\uc7ac\ud558\ub294 \uc2dc\ub300\uc801 \uc7a5\ubcbd\uc744 \ub9d0\ud55c \uac83\uc774\uc9c0 \ucd94\ucc9c\uc11c \uc81c\ub3c4\ub97c \ub9d0\ud55c \uac83\uc774 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uad50\uc9c1\uc5d0 \uc885\uc0ac\ud558\ub294 \uac83\uc774 \uc5f0\uad6c \uc218\ud559\uc790\uac00 \ub418\ub294 \uac83\ubcf4\ub2e4 \ud6e8\uc52c \ub354 \ud070 \uba85\uc608\ub97c \uac00\uc838\ub2e4\uc8fc\uc5c8\ub2e4.",
          "rationale": "\uad50\uc9c1\uc740 \uadf8\ub140\uac00 \uc5f0\uad6c \uc218\ud559\uc790\ub85c \uc77c\ud560 \uae30\ud68c\uac00 \uc5c6\uc5c8\uae30 \ub54c\ubb38\uc5d0 \uc120\ud0dd\ud55c \ub300\uc548\uc774\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uba58\ud1a0\uac00 \ub6f0\uc5b4\ub09c \uc81c\uc790\uc5d0\uac8c \uc77c\uc790\ub9ac\ub97c \uc9c1\uc811 \ucc3e\uc544\uc904 \uc218 \uc5c6\uc5b4 \uc548\ud0c0\uae4c\uc6cc\ud588\ub358 \uc6d0\uc778\uc744 \uc0dd\uac01\ud574\ubcf4\uc138\uc694."
    },
    {
      "question": "1953\ub144 NASA \ud544\ub4dc \uc13c\ud130\uc5d0 \uc785\uc0ac\ud55c Katherine Johnson\uc774 \uacaa\uc740 \uc5c5\ubb34 \ud658\uacbd\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubc31\uc778 \ub0a8\uc131 \uc5d4\uc9c0\ub2c8\uc5b4\ub4e4\uc744 \uc9c0\uc6d0\ud558\uba70 \uc218\ub3d9\uc73c\ub85c \ubcf5\uc7a1\ud55c \uacc4\uc0b0\uc744 \uc218\ud589\ud558\ub294 \"Black computer\"\ub85c \uc77c\ud588\ub2e4.",
          "rationale": "\uadf8\ub140\ub294 \uc218\ub3d9 \uacc4\uc0b0\uc73c\ub85c \uc6b0\uc8fc \ud504\ub85c\uc81d\ud2b8\ub97c \uc9c0\uc6d0\ud558\ub294 \uc5ed\ud560\uc744 \ub9e1\uc73c\uba70 \ucc28\ubcc4\uc801\uc778 \ud658\uacbd\uc5d0 \uc9c1\uba74\ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc785\uc0ac\ud558\uc790\ub9c8\uc790 \uc6b0\uc218\ud55c \ub2a5\ub825\uc744 \uc778\uc815\ubc1b\uc544 \uc5d8\ub9ac\ud2b8 \uc5f0\uad6c \ubd80\uc11c\uc758 \uc218\uc7a5\uc73c\ub85c \uc784\uba85\ub418\uc5c8\ub2e4.",
          "rationale": "\uc785\uc0ac 2\uc8fc \ud6c4 \uc5d8\ub9ac\ud2b8 \ubd80\uc11c\ub85c \uc7ac\ubc30\uce58\ub418\uc5c8\uc73c\ub098 \ud300\uc758 \uc720\uc77c\ud55c \ud751\uc778 \uc5ec\uc131 \uc5f0\uad6c\uc6d0\uc774\uc5c8\uc744 \ubfd0 \uc218\uc7a5\uc740 \uc544\ub2c8\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub2f9\uc2dc NASA \uc0ac\ubb34\uc2e4 \ub0b4\uc5d0\uc11c\ub294 \uc778\uc885\uc774\ub098 \uc131\ubcc4\uc5d0 \ub530\ub978 \uc5b4\ub5a0\ud55c \ucc28\ubcc4\ub3c4 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc558\ub2e4.",
          "rationale": "\uc0ac\ubb34\uc2e4 \ub0b4 \ubd84\ub9ac \uc870\uce58\uac00 \uc788\uc5c8\uc73c\uba70 \uc804\ubb38\uc9c1 \uc5ec\uc131\uc784\uc5d0\ub3c4 'girl'\ub85c \ubd88\ub9ac\ub294 \ub4f1 \ucc28\ubcc4\uc744 \uacaa\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc911\uc694 \uc5f0\uad6c \ud68c\uc758\ub294 \ubaa8\ub4e0 \uc9c1\uc6d0\uc5d0\uac8c \ud3c9\ub4f1\ud558\uac8c \uc5f4\ub824 \uc788\uc5b4 \uc790\uc720\ub86d\uac8c \ucc38\uc11d\ud560 \uc218 \uc788\uc5c8\ub2e4.",
          "rationale": "\uc8fc\uc694 \uc5f0\uad6c \ud68c\uc758\ub294 \ubc31\uc778 \ub0a8\uc131 \uc9c1\uc6d0\ub4e4\ub9cc\uc744 \ub300\uc0c1\uc73c\ub85c \uc5f4\ub838\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub2f9\uc2dc NASA\uc5d0\uc11c \ud751\uc778 \uc5ec\uc131 \uacc4\uc0b0\uc6d0\ub4e4\uc5d0\uac8c \ubd80\uc5ec\ub418\uc5c8\ub358 \uba85\uce6d\uacfc \uc8fc\uc694 \uc5ed\ud560\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "Katherine Johnson\uc774 NASA\uc758 \ucc28\ubcc4\uc801\uc778 \uad00\uc2b5\uc744 \uae68\uace0 \uc911\uc694 \uc5f0\uad6c \ud68c\uc758\uc5d0 \ucc38\uc11d\ud560 \uc218 \uc788\uc5c8\ub358 \uc9c1\uc811\uc801\uc778 \uacc4\uae30\ub294?",
      "answerOptions": [
        {
          "text": "\"\uc81c\uac00 \ucc38\uc11d\ud558\uba74 \uc548 \ub41c\ub2e4\ub294 \ubc95\uc774\ub77c\ub3c4 \uc788\ub098\uc694?\"\ub77c\ub294 \uc9c8\ubb38\uc73c\ub85c \uad00\uc2b5\uc758 \uadfc\uac70\uc5d0 \uc758\ubb38\uc744 \uc81c\uae30\ud574\uc11c",
          "rationale": "\ub2f9\uc5f0\ud558\uac8c \uc5ec\uaca8\uc9c0\ub358 \uad00\ud589\uc5d0 \uba85\ud655\ud55c \ubc95\uc801/\uc81c\ub3c4\uc801 \uadfc\uac70\ub97c \ubb3b\ub294 \uc9c8\ubb38\uc744 \ub358\uc9d0\uc73c\ub85c\uc368 \ud68c\uc758 \ucc38\uc11d \ud5c8\uac00\ub97c \ubc1b\uc544\ub0c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubc31\uc778 \ub3d9\ub8cc\ub4e4\uc774 \uadf8\ub140\uc758 \ucc38\uc11d\uc744 \uc694\uccad\ud558\ub294 \ud0c4\uc6d0\uc11c\ub97c \uc0c1\ubd80\uc5d0 \uc81c\ucd9c\ud574\uc11c",
          "rationale": "\ub3d9\ub8cc\ub4e4\uc740 \uad00\uc2b5\uc744 \uc774\uc720\ub85c \uadf8\ub140\uc758 \ucc38\uc11d\uc744 \uac70\ubd80\ud558\ub824 \ud588\uc73c\uba70 \ud0c4\uc6d0\uc11c\ub97c \ub0b4\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uae30\uacc4 \uacc4\uc0b0\uae30\uc758 \uc624\ub958\ub97c \ub2e8\uc2dc\uac04 \ub0b4\uc5d0 \uc218\ub3d9\uc73c\ub85c \ubc14\ub85c\uc7a1\uc544 \uc2e4\ub825\uc744 \uc99d\uba85\ud574\uc11c",
          "rationale": "\uacc4\uc0b0 \ub2a5\ub825\uc774 \ub6f0\uc5b4\ub09c \uac83\uc740 \uc0ac\uc2e4\uc774\uc5c8\uc73c\ub098 \ud68c\uc758 \ucc38\uc11d\uc758 \uc9c1\uc811\uc801 \uacc4\uae30\ub294 \ub17c\ub9ac\uc801\uc778 \uc9c8\ubb38\uc774\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "Presidential Medal of Freedom(\ub300\ud1b5\ub839 \uc790\uc720 \ud6c8\uc7a5)\uc744 \uc218\uc5ec\ubc1b\uc544 \uc790\uaca9\uc744 \uc785\uc99d\ud574\uc11c",
          "rationale": "\ub300\ud1b5\ub839 \uc790\uc720 \ud6c8\uc7a5\uc740 \uadf8\ub140\uc758 \uc5c5\uc801\uc744 \uae30\ub9ac\uae30 \uc704\ud574 \ud6e8\uc52c \ud6c4\uc778 2015\ub144\uc5d0 \uc218\uc5ec\ub41c \uac83\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub0a8\uc131 \ub3d9\ub8cc\ub4e4\uc774 \"\uc5ec\uc131\ub4e4\uc740 \ubcf4\ud1b5 \uac00\uc9c0 \uc54a\ub294\ub2e4\"\ub77c\uace0 \ud588\uc744 \ub54c \uadf8\ub140\uac00 \ub418\ubb3c\uc5c8\ub358 \ub9d0\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "Katherine Johnson\uc774 1960\ub144\uc5d0 \uc774\ub904\ub0b8 \uc5ed\uc0ac\uc801 \uc131\uacfc\ub85c \ubcf8\ubb38\uc5d0 \uc5b8\uae09\ub41c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc6b0\uc8fc\uc120\uc744 \uada4\ub3c4\uc5d0 \uc9c4\uc785\uc2dc\ud0a4\ub294 \ubc29\ubc95\uc5d0 \ub300\ud55c \uc5f0\uad6c \ubcf4\uace0\uc11c\uc758 \uacf5\ub3d9 \uc800\uc790\ub85c \uc774\ub984\uc744 \uc62c\ub838\ub2e4.",
          "rationale": "\ud574\ub2f9 \ubd80\uc11c\uc5d0\uc11c \uc5ec\uc131\uc774 \uc5f0\uad6c \ubcf4\uace0\uc11c\uc758 \uc800\uc790\ub85c \uacf5\uc2dd\uc801\uc778 \uc778\uc815\uc744 \ubc1b\uc740 \uac83\uc740 \uc774\ubc88\uc774 \ucc98\uc74c\uc774\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc544\ud3f4\ub85c 11\ud638 \ube44\ud589\uc0ac\ub85c \uc9c1\uc811 \uc6b0\uc8fc \ube44\ud589\uc5d0 \ucc38\uac00\ud558\uc600\ub2e4.",
          "rationale": "\uadf8\ub140\ub294 \uacc4\uc0b0\uc744 \ub2f4\ub2f9\ud55c \uc218\ud559\uc790\uc600\uc73c\uba70 \uc9c1\uc811 \uc6b0\uc8fc \ube44\ud589\uc0ac\ub85c \ucc38\uc5ec\ud55c \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "NASA \ucd5c\ucd08\ub85c \ud751\uc778 \uc5ec\uc131\ub4e4\ub85c\ub9cc \uad6c\uc131\ub41c \uc5f0\uad6c \ubd80\uc11c\ub97c \ucc3d\uc124\ud588\ub2e4.",
          "rationale": "\uadf8\ub140\uac00 \uc18d\ud588\ub358 \uacf3\uc740 \uae30\uc874\uc758 \uc5d8\ub9ac\ud2b8 \uc6b0\uc8fc \uc5f0\uad6c \ubd80\uc11c\uc600\uc73c\uba70 \uc0c8 \ubd80\uc11c\ub97c \ucc3d\uc124\ud55c \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ucef4\ud4e8\ud130 \uae30\uacc4\uc758 \uacc4\uc0b0\uc744 \uc644\uc804\ud788 \ub300\uccb4\ud558\ub294 \uc778\uacf5\uc9c0\ub2a5 \ud504\ub85c\uadf8\ub7a8\uc744 \uac1c\ubc1c\ud588\ub2e4.",
          "rationale": "\ubcf8\ubb38\uc740 \uadf8\ub140\uac00 \uc218\ub3d9 \uacc4\uc0b0\uacfc \uc218\ud559\uc801 \uc774\ub860\uc744 \ubc14\ud0d5\uc73c\ub85c \uada4\ub3c4 \uacc4\uc0b0 \ubcf4\uace0\uc11c\ub97c \uc37c\ub2e4\uace0 \uae30\uc220\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc5ec\uc131\uc73c\ub85c\uc11c \uadf8\ub140\uac00 \uc18d\ud55c \ubd80\uc11c\uc5d0\uc11c \ucc98\uc74c\uc73c\ub85c \uacf5\uc2dd\uc801\uc778 \uc800\uc791\uad8c\uc744 \uc778\uc815\ubc1b\uc740 \ubd84\uc57c\uac00 \ubb34\uc5c7\uc778\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \ubcf8\ubb38 \uc5b4\ud718\uc758 \ub73b\uacfc \uc601\ubb38 \uc815\uc758\uc758 \uc5f0\uacb0\uc774 \uc62c\ubc14\ub974\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "prodigy - a young person who is unusually talented in some way",
          "rationale": "\uc601\uc7ac\ub098 \uc2e0\ub3d9\uc744 \uc758\ubbf8\ud558\uba70 \ud2b9\ucd9c\ub09c \uc7ac\ub2a5\uc744 \uac00\uc9c4 \uc80a\uc740 \uc0ac\ub78c\uc744 \ub73b\ud558\ubbc0\ub85c \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "barrier - something that prevents something from happening or makes it more difficult",
          "rationale": "\uc7a5\uc560\ubb3c\uc774\ub098 \uc7a5\ubcbd\uc744 \uc758\ubbf8\ud558\ubbc0\ub85c \ubb34\uc5b8\uac00\ub97c \ub9c9\uac70\ub098 \uc5b4\ub835\uac8c \ud558\ub294 \uac83\uc744 \ub73b\ud558\ub294 \uc815\uc758\uc640 \uc77c\uce58\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "segregate - to keep different groups of people together in the same place",
          "rationale": "'segregate'\ub294 \ud568\uaed8 \ubaa8\uc73c\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ubd84\ub9ac\ud558\uac70\ub098 \ub5bc\uc5b4 \ub193\ub294 \uac83(set apart)\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "orbit - the curved path that an object in space follows around a planet, moon, or star",
          "rationale": "\ucc9c\uccb4\uac00 \ud589\uc131\uc774\ub098 \ubcc4 \uc8fc\uc704\ub97c \ub3c4\ub294 \uada4\ub3c4\ub97c \uc758\ubbf8\ud558\ub294 \uc62c\ubc14\ub978 \uc815\uc758\uc785\ub2c8\ub2e4.",
          "isCorrect": false
