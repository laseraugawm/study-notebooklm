          "rationale": "\ubc00\ubb3c\uacfc \uc370\ubb3c\uc744 \uc774\uc6a9\ud558\ub294 \uac83\uc740 \uc870\ub825 \ubc1c\uc804\uc758 \ud2b9\uc9d5\uc774\ub2e4."
        },
        {
          "text": "\uc7a5\uc810: \uc218\uc18c\uc640 \uc0b0\uc18c\uc758 \ubc18\uc751\uc73c\ub85c \ud6a8\uc728\uc774 \ub9e4\uc6b0 \ub192\ub2e4. / \ub2e8\uc810: \uc218\uc18c \uc800\uc7a5 \uae30\uc220\uc774 \ud544\uc694\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc18c\uc640 \uc0b0\uc18c\uc758 \ubc18\uc751\uc744 \uc774\uc6a9\ud558\ub294 \uac83\uc740 \uc5f0\ub8cc \uc804\uc9c0\uc758 \ud2b9\uc9d5\uc774\ub2e4."
        },
        {
          "text": "\uc7a5\uc810: \ub113\uc740 \uc124\uce58 \uba74\uc801\uc774 \ud544\uc694 \uc5c6\ub2e4. / \ub2e8\uc810: \uace0\uccb4 \ubc0f \uc561\uccb4 \uc5f0\ub8cc\ub85c\ub9cc \ubcc0\ud658\uc774 \uac00\ub2a5\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud48d\ub825 \ubc1c\uc804\uae30\ub294 \ubc14\ub78c\uc774 \uc798 \ubd80\ub294 \uc81c\ud55c\ub41c \uc9c0\uc5ed\uc5d0 \uc124\uce58\ub418\uba70, \ubc14\uc774\uc624 \uc5d0\ub108\uc9c0 \uc124\uba85\uacfc \ud63c\ub3d9\ub41c \ub0b4\uc6a9\uc774\ub2e4."
        }
      ],
      "hint": "\ubc14\ub78c\uc774\ub77c\ub294 \uc790\uc5f0 \ud604\uc0c1\uc758 \ud2b9\uc131\uacfc \ubc14\ub78c\uac1c\ube44 \ud615\ud0dc \uad6c\uc870\ubb3c\uc774 \uc8fc\ubcc0 \ud658\uacbd\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
