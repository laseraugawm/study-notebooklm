        {
          "text": "\ucd08\uae30 \ubc29\ud30c\uc81c \ubc0f \uc2dc\uc124 \uac74\uc124 \ube44\uc6a9\uc774 \ub9e4\uc6b0 \uc801\uac8c \ub4e0\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub300\uaddc\ubaa8 \uc870\ub825 \ubc1c\uc804\uc18c \uac74\uc124\uc5d0\ub294 \ub192\uc740 \ucd08\uae30 \uc124\uce58 \ube44\uc6a9\uc774 \uc18c\uc694\ub418\ub294 \ub2e8\uc810\uc774 \uc788\ub2e4."
