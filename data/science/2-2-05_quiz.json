        {
          "text": "\uc124\uce58 \uc7a5\uc18c\uc758 \uc81c\uc57d\uc774 \uac70\uc758 \uc5c6\uc5b4 \uc804\uad6d \uc5b4\ub514\uc11c\ub098 \uc27d\uac8c \uac74\uc124\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud574\uc218\uba74 \ub192\uc774 \ucc28\uac00 \ud070 \uc785\uc9c0 \uc870\uac74\uc744 \ub9cc\uc871\ud558\ub294 \ud2b9\uc815 \ud574\uc548 \uc9c0\uc5ed\uc5d0\ub9cc \uc124\uce58\uac00 \uac00\ub2a5\ud558\ub2e4."
        },
        {
          "text": "\ub0a0\uc528 \ubcc0\ud654\uc5d0 \ub530\ub978 \ubc1c\uc804\ub7c9 \ubcc0\ub3d9\uc774 \ucee4\uc11c \ubc1c\uc804\ub7c9\uc744 \uc608\uce21\ud558\uae30 \ub9e4\uc6b0 \uc5b4\ub835\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc870\uc11d \ud604\uc0c1\uc740 \uc8fc\uae30\uc801\uc774\ubbc0\ub85c \ud0dc\uc591\uad11\uc774\ub098 \ud48d\ub825\uc5d0 \ube44\ud574 \ubc1c\uc804\ub7c9 \uc608\uce21\uc774 \uc27d\ub2e4."
