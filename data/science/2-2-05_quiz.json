{
  "title": "\uc2e0\uc7ac\uc0dd\uc5d0\ub108\uc9c0 \ud034\uc988",
  "questions": [
    {
      "question": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud0dc\uc591, \ubc14\ub78c \ub4f1\uc758 \uc790\uc5f0 \uc5d0\ub108\uc9c0\ub97c \ubcc0\ud658\ud558\uac70\ub098 \uc218\uc18c \ub4f1\uc758 \ud654\ud559 \ubc18\uc751\uc744 \ud1b5\ud574 \uc5bb\ub294 \uc9c0\uc18d \uac00\ub2a5\ud55c \uc5d0\ub108\uc9c0\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub294 \uace0\uac08\ub418\uc9c0 \uc54a\uace0 \uacc4\uc18d \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\uba70 \ud658\uacbd \ubb38\uc81c\ub97c \ucd5c\uc18c\ud654\ud558\ub294 \ub300\uccb4 \uc5d0\ub108\uc9c0\uc6d0\uc744 \ud3ec\ud568\ud55c\ub2e4."
        },
        {
          "text": "\ud654\uc11d \uc5f0\ub8cc\uc640 \ub9c8\ucc2c\uac00\uc9c0\ub85c \ub9e4\uc7a5\ub7c9\uc774 \ud55c\uc815\ub418\uc5b4 \uc788\uc5b4 \uc5b8\uc820\uac00\ub294 \uc644\uc804\ud788 \uace0\uac08\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub294 \ud654\uc11d \uc5f0\ub8cc\uc640 \ub2ec\ub9ac \uace0\uac08\ub420 \uc5fc\ub824\uac00 \uc5c6\uc774 \uacc4\uc18d \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ud2b9\uc9d5\uc744 \uac16\ub294\ub2e4."
        },
        {
          "text": "\uc5d0\ub108\uc9c0 \uc0dd\uc131 \uacfc\uc815\uc5d0\uc11c \ud654\uc11d \uc5f0\ub8cc\ubcf4\ub2e4 \uc774\uc0b0\ud654 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \ud6e8\uc52c \ub9ce\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub294 \uc628\uc2e4 \uae30\uccb4 \ubc0f \uacf5\ud574 \ubb3c\uc9c8 \ubc30\ucd9c\uc774 \uc801\uac70\ub098 \uc5c6\uc5b4 \uc9c0\uad6c \ud658\uacbd \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub294 \ub300\uc548\uc774\ub2e4."
        },
        {
          "text": "\uc11d\ud0c4\uc744 \uc9c1\uc811 \uc5f0\uc18c\uc2dc\ucf1c \uc804\uae30\ub97c \uc5bb\ub294 \uc804\ud1b5\uc801\uc778 \ud654\ub825 \ubc1c\uc804 \ubc29\uc2dd\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc11d\ud0c4\uc744 \uc9c1\uc811 \uc5f0\uc18c\ud558\ub294 \ubc29\uc2dd\uc740 \uc804\ud1b5\uc801\uc778 \ud654\uc11d \uc5f0\ub8cc \uc774\uc6a9 \ubc29\uc2dd\uc774\uba70, \uc11d\ud0c4\uc744 \uc561\uccb4\ub098 \uac00\uc2a4\ub85c \ubcc0\ud658\ud558\uc5ec \uc774\uc6a9\ud558\ub294 \uae30\uc220\uc774 \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        }
      ],
      "hint": "\ud654\uc11d \uc5f0\ub8cc\ub97c \ub300\uccb4\ud558\uc5ec \uace0\uac08\ub418\uc9c0 \uc54a\uace0 \uce5c\ud658\uacbd\uc801\uc73c\ub85c \uc774\uc6a9\ud560 \uc218 \uc788\ub294 \uc5d0\ub108\uc9c0\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ud0dc\uc591\uad11 \ubc1c\uc804\uc758 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc77c\uc0ac\ub7c9 \ubcc0\ub3d9\uc5d0 \uc601\ud5a5\ubc1b\uc9c0 \uc54a\uace0 24\uc2dc\uac04 \uc77c\uc815\ud558\uac8c \uc804\ub825\uc744 \uc0dd\uc0b0\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud0dc\uc591\uad11 \ubc1c\uc804\uc740 \ud587\ube5b\uc5d0 \uc758\uc874\ud558\ubbc0\ub85c \uc77c\uc0ac\ub7c9 \ubcc0\ub3d9\uacfc \ub0a0\uc528, \ubc24\ub0ae\uc5d0 \ub530\ub77c \ubc1c\uc804\ub7c9\uc774 \ud06c\uac8c \ub2ec\ub77c\uc9c0\ub294 \ub2e8\uc810\uc774 \uc788\ub2e4."
        },
        {
          "text": "\ud0dc\uc591 \uc804\uc9c0\ub97c \uc774\uc6a9\ud558\uc5ec \ube5b\uc5d0\ub108\uc9c0\ub97c \uc9c1\uc811 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud0dc\uc591 \uc804\uc9c0\uc5d0 \ube5b\uc744 \ube44\ucd94\uba74 \uc804\uc790\uac00 \uc774\ub3d9\ud558\uba74\uc11c \uc804\ub958\uac00 \ud750\ub974\ub294 \uc6d0\ub9ac\ub97c \uc774\uc6a9\ud55c\ub2e4."
        },
        {
          "text": "\ub300\uaddc\ubaa8\ub85c \ubc1c\uc804\ud558\uae30 \uc704\ud574\uc11c\ub294 \ub113\uc740 \uc124\uce58 \uba74\uc801\uc774 \ud544\uc694\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud587\ube5b\uc744 \ubaa8\uc73c\uae30 \uc704\ud55c \ud0dc\uc591 \uc804\uc9c0\ud310\uc744 \ub113\uac8c \uc124\uce58\ud574\uc57c \ud558\ubbc0\ub85c \ud1a0\uc9c0 \uba74\uc801\uc774 \ub9ce\uc774 \ud544\uc694\ud558\ub2e4."
        },
        {
          "text": "\ubc1c\uc804 \uacfc\uc815\uc5d0\uc11c \uc628\uc2e4\uac00\uc2a4\ub098 \ud658\uacbd\uc624\uc5fc \ubb3c\uc9c8\uc744 \ubc30\ucd9c\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\ub8cc\uc758 \uc5f0\uc18c \uacfc\uc815\uc774 \uc5c6\uc73c\ubbc0\ub85c \uc790\uc6d0\uc774 \uccad\uc815\ud558\uace0 \ub300\uae30 \uc624\uc5fc \ubb3c\uc9c8\uc744 \ubc30\ucd9c\ud558\uc9c0 \uc54a\ub294\ub2e4."
        }
      ],
      "hint": "\ud0dc\uc591 \ube5b\uc758 \uae30\uc0c1 \uc870\uac74 \uc758\uc874\uc131\uacfc \uad00\ub828\ub41c \uc81c\uc57d \uc0ac\ud56d\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc81c\uc2dc\ub41c \ubc1c\uc804 \ubc29\uc2dd \uc911 \ud130\ube48\uc744 \ub3cc\ub824 \uc804\uc790\uae30 \uc720\ub3c4 \ud604\uc0c1\uc73c\ub85c \uc804\uae30\ub97c \uc0dd\uc0b0\ud558\uc9c0 \uc54a\ub294 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud0dc\uc591\uad11 \ubc1c\uc804",
          "isCorrect": true,
          "rationale": "\ud0dc\uc591\uad11 \ubc1c\uc804\uc740 \ud0dc\uc591 \uc804\uc9c0\ub97c \uc774\uc6a9\ud574 \ube5b\uc5d0\ub108\uc9c0\ub97c \uc9c1\uc811 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud558\ubbc0\ub85c \uc804\uc790\uae30 \uc720\ub3c4\ub97c \uc77c\uc73c\ud0a4\ub294 \ubc1c\uc804\uae30\uac00 \ud544\uc694 \uc5c6\ub2e4."
        },
        {
          "text": "\ud48d\ub825 \ubc1c\uc804",
          "isCorrect": false,
          "rationale": "\ubc14\ub78c\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \ub0a0\uac1c\uc5d0 \uc5f0\uacb0\ub41c \ubc1c\uc804\uae30\ub97c \ub3cc\ub824 \uc804\uc790\uae30 \uc720\ub3c4\ub85c \uc804\uae30\ub97c \uc0dd\uc0b0\ud55c\ub2e4."
        },
        {
          "text": "\uc870\ub825 \ubc1c\uc804",
          "isCorrect": false,
          "rationale": "\ubc00\ubb3c\uacfc \uc370\ubb3c\ub85c \uc0dd\uae30\ub294 \ubc14\ub2f7\ubb3c\uc758 \ud750\ub984\uc744 \uc774\uc6a9\ud558\uc5ec \ubc1c\uc804\uae30\ub97c \ub3cc\ub9bc\uc73c\ub85c\uc368 \uc804\uae30\ub97c \uc0dd\uc0b0\ud55c\ub2e4."
        },
        {
          "text": "\uc218\ub825 \ubc1c\uc804",
          "isCorrect": false,
          "rationale": "\ubb3c\uc774 \ub5a8\uc5b4\uc9c0\ub294 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \ud130\ube48\uacfc \ubc1c\uc804\uae30\ub97c \ub3cc\ub824 \uc804\uae30\ub97c \uc0dd\uc131\ud55c\ub2e4."
        }
      ],
      "hint": "\ube5b\uc5d0\ub108\uc9c0\ub97c \uc9c1\uc811 \uc804\ub958\ub85c \ubc14\uafb8\ub294\uc9c0, \ud68c\uc804\uccb4\ub97c \ub3cc\ub824 \ubc1c\uc804\uae30\ub97c \uc791\ub3d9\uc2dc\ud0a4\ub294\uc9c0 \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc5f0\ub8cc \uc804\uc9c0\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc218\uc18c\uac00 \ud658\uc6d0\ub418\uba74\uc11c \ub0b4\ub193\uc740 \uc804\uc790\uac00 \uc774\ub3d9\ud558\uc5ec \uc804\ub958\uac00 \ud750\ub978\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc5f0\ub8cc \uc804\uc9c0\uc5d0\uc11c\ub294 \uc218\uc18c\uac00 '\uc0b0\ud654'\ub418\uba74\uc11c \uc804\uc790\ub97c \ub0b4\ub193\uace0, \uc774 \uc804\uc790\uc758 \uc774\ub3d9\uc73c\ub85c \uc804\ub958\uac00 \ud750\ub978\ub2e4."
        },
        {
          "text": "\uc218\uc18c\uc640 \uc0b0\uc18c\uc758 \ud654\ud559 \ubc18\uc751\uc744 \uc774\uc6a9\ud558\uc5ec \uc9c1\uc811 \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc0dd\uc131\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud654\ud559 \uc5d0\ub108\uc9c0\ub97c \uc9c1\uc811 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud558\ub294 \ud6a8\uc728\uc801\uc778 \uc7a5\uce58\uc774\ub2e4."
        },
        {
          "text": "\uc5d0\ub108\uc9c0 \ud6a8\uc728\uc774 \ub192\uace0 \ubc18\uc751 \uacb0\uacfc \uc8fc\ub85c \ubb3c\uc774 \ud615\uc131\ub418\uc5b4 \ud658\uacbd\uc624\uc5fc\uc774 \uac70\uc758 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f0\uc18c \ubc18\uc751\uc774 \uc544\ub2cc \ud654\ud559 \ubc18\uc751\uc744 \uc774\uc6a9\ud558\ubbc0\ub85c \uc624\uc5fc \ubb3c\uc9c8\uc744 \ubc30\ucd9c\ud558\uc9c0 \uc54a\ub294 \uce5c\ud658\uacbd \uae30\uc220\uc774\ub2e4."
        },
        {
          "text": "\ud6a8\uc728\uc801\uc778 \uc218\uc18c \uc800\uc7a5 \uae30\uc220\uacfc \uc548\uc804\uc131 \ud655\ubcf4\ub97c \uc704\ud55c \uae30\uc220 \uac1c\ubc1c\uc774 \ud544\uc218\uc801\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc18c \uac00\uc2a4\uc758 \ud3ed\ubc1c \uc704\ud5d8\uc131\uacfc \uc800\uc7a5 \ubc0f \uc6b4\ubc18 \uae30\uc220 \ud655\ubcf4\uac00 \uc8fc\uc694 \uacfc\uc81c\ub85c \ub0a8\uc544 \uc788\ub2e4."
        }
      ],
      "hint": "\uc218\uc18c\uac00 \uc804\uc790\ub97c \uc783\ub294 \ubc18\uc751\uc774 \uc0b0\ud654\uc778\uc9c0 \ud658\uc6d0\uc778\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ud48d\ub825 \ubc1c\uc804\uc758 \uc7a5\uc810\uacfc \ub2e8\uc810\uc744 \ubc14\ub974\uac8c \uc9dd\uc9c0\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc7a5\uc810: \uc790\uc6d0\uc774 \ud48d\ubd80\ud558\uace0 \uacf5\ud574 \ubb3c\uc9c8 \ubc30\ucd9c\uc774 \uc5c6\ub2e4. / \ub2e8\uc810: \ub0a0\uac1c \uc18c\uc74c \ubc0f \ubc1c\uc804\ub7c9 \uc608\uce21\uc758 \uc5b4\ub824\uc6c0\uc774 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubc14\ub78c\uc740 \ud48d\ubd80\ud55c \uccad\uc815 \uc790\uc6d0\uc774\uc9c0\ub9cc, \ubc14\ub78c\uc758 \uc138\uae30 \ubcc0\ud654\uc5d0 \ub530\ub77c \ubc1c\uc804\ub7c9\uc774 \ubd88\uc548\uc815\ud558\uace0 \ud68c\uc804 \ub0a0\uac1c\uc5d0\uc11c \uc18c\uc74c\uc774 \ubc1c\uc0dd\ud55c\ub2e4."
        },
        {
          "text": "\uc7a5\uc810: \ubc00\ubb3c\uacfc \uc370\ubb3c\uc744 \uc774\uc6a9\ud558\uc5ec \ubc1c\uc804\ub7c9\uc744 \uc815\ud655\ud788 \uc608\uce21\ud55c\ub2e4. / \ub2e8\uc810: \uc124\uce58 \ube44\uc6a9\uc774 \ub9ce\uc774 \ub4e0\ub2e4.",
