    {
      "type": "multiple_choice",
      "question": "\uc778\uac04 \ud65c\ub3d9\uc5d0 \uc758\ud55c \ud658\uacbd \ubcc0\ud654\uc640 \uc0dd\ud0dc\uacc4\ubcf4\uc804\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5f4\ub300\uc6b0\ub9bc \ud30c\uad34\ub85c \uc0dd\ubb3c\ub2e4\uc591\uc131\uc774 \uc190\uc0c1\ub418\ub354\ub77c\ub3c4 \uc778\ub958\uac00 \uc0b4\uc544\uac00\ub294 \ud658\uacbd\uc5d0\ub294 \uc9c1\uc811\uc801\uc778 \ud53c\ud574\ub97c \uc8fc\uc9c0 \uc54a\ub294\ub2e4.",
          "rationale": "\uc0dd\ubb3c\ub2e4\uc591\uc131\uc774 \ud30c\uad34\ub41c \ud658\uacbd\uc740 \uc778\ub958\ub3c4 \uc0b4 \uc218 \uc5c6\ub294 \ud658\uacbd\uc774 \ub418\ubbc0\ub85c, \uc0dd\ud0dc\uacc4 \ubcf4\uc804\uc740 \uc778\ub958\uc758 \uc0dd\uc874\uacfc \uc9c1\uc811 \uc5f0\uad00\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.",
