    {
      "type": "multiple_choice",
      "question": "1991\ub144 \ud544\ub9ac\ud540 \ud53c\ub098\ud22c\ubcf4 \ud654\uc0b0 \ud3ed\ubc1c\uc774 \uc9c0\uad6c \ud658\uacbd \ubc0f \uc0dd\ud0dc\uacc4\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc131\uce35\uad8c\uc5d0 \ub3c4\ub2ec\ud55c \ud654\uc0b0\uc7ac\uc640 \uc774\uc0b0\ud654 \ud669\uc774 \uc5f4\uc744 \ud761\uc218\ud558\uc5ec \uc9c0\uad6c \ud3c9\uade0 \uae30\uc628\uc774 \uc57d $0.5\\,^\\circ\\text{C}$ \uc0c1\uc2b9\ud558\uc600\ub2e4.",
          "rationale": "\uc131\uce35\uad8c\uc758 \uc774\uc0b0\ud654 \ud669\uacfc \ud654\uc0b0\uc7ac\ub294 \ud0dc\uc591 \ubcf5\uc0ac\ub97c \ubc18\uc0ac\ud558\uc5ec \uc2dd\ubb3c\uc758 \uad11\ud569\uc131\ub7c9\uc744 \uac10\uc18c\uc2dc\ucf30\uace0, 2\ub144 \ub3d9\uc548 \uc9c0\uad6c \ud3c9\uade0 \uae30\uc628\uc744 \uc57d $0.5\\,^\\circ\\text{C}$ \ub0ae\uc544\uc9c0\uac8c \ud588\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud654\uc0b0 \ubd84\ucd9c \uc2dc \ubc1c\uc0dd\ud55c \uc6a9\uc554\uacfc \ud654\uc0b0\uc7ac\ub85c \uc778\ud574 \uc8fc\ubcc0 \ubc18\uacbd 20 km \uc774\ub0b4 \uc0dd\ud0dc\uacc4\uac00 \ud669\ud3d0\ud654\ub418\uc5c8\ub2e4.",
          "rationale": "\ud654\uc0b0 \ubd84\ucd9c\ub85c \uc6a9\uc554\uc774 10 km \uc774\uc0c1 \ud750\ub974\uace0 \ud654\uc0b0\uc7ac\uac00 \ubc18\uacbd 20 km\ub97c \ub36e\uc5b4 \uc8fc\ubcc0 \uc0dd\ud0dc\uacc4\uac00 \ud30c\uad34\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc57d 2000\ub9cc \ud1a4\uc758 \uc774\uc0b0\ud654 \ud669\uacfc \ud654\uc0b0\uc7ac\uac00 \uc131\uce35\uad8c\uae4c\uc9c0 \ub3c4\ub2ec\ud558\uc600\ub2e4.",
          "rationale": "\ud53c\ub098\ud22c\ubcf4 \ud654\uc0b0 \ud3ed\ubc1c\ub85c \uac70\ub300\ud55c \uc591\uc758 \uc774\uc0b0\ud654 \ud669\uacfc \ud654\uc0b0\uc7ac\uac00 \uc131\uce35\uad8c\uae4c\uc9c0 \ub2e4\ub2e4\ub790\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc131\uce35\uad8c\uc758 \ud654\uc0b0\uc7ac\uac00 \ud0dc\uc591 \ubcf5\uc0ac\ub97c \ubc18\uc0ac\ud558\uc5ec \uc2dd\ubb3c\uc758 \uad11\ud569\uc131\ub7c9\uc774 \uac10\uc18c\ud558\ub294 \uacb0\uacfc\ub97c \ucd08\ub798\ud588\ub2e4.",
          "rationale": "\ud0dc\uc591\ube5b\uc774 \ud654\uc0b0\uc7ac \ucc28\ud3d0\uce35\uc5d0 \uc758\ud574 \ubc18\uc0ac\ub418\uba74\uc11c \uc9c0\ud45c\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ube5b\uc758 \uc591\uc774 \uc904\uc5b4 \uad11\ud569\uc131\ub7c9\uc774 \uac10\uc18c\ud588\uc2b5\ub2c8\ub2e4.",
