{
  "title": "\uc0dd\ud0dc\uacc4 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc0dd\ud0dc\uacc4 \ub0b4 \uc0dd\ubb3c\ub4e4\uc758 \uba39\uace0 \uba39\ud788\ub294 \uad00\uacc4\uc778 \uba39\uc774\uc0ac\uc2ac\uacfc \uba39\uc774\uadf8\ubb3c\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5ec\ub7ec \uac1c\uccb4\uad70\uc774 \ud568\uaed8 \uc11c\uc2dd\ud558\ub294 \uad70\uc9d1\uc5d0\uc11c\ub294 \uba39\uc774 \uad00\uacc4\uac00 \uc5ec\ub7ec \uba39\uc774\uc0ac\uc2ac\uc774 \uc5bd\ud78c \uba39\uc774\uadf8\ubb3c \ud615\ud0dc\ub85c \ub098\ud0c0\ub09c\ub2e4.",
          "rationale": "\uc2e4\uc81c \uc0dd\ud0dc\uacc4\uc5d0\uc11c\ub294 \ud55c \uc0dd\ubb3c\uc774 \uc5ec\ub7ec \uc0dd\ubb3c\uc758 \uba39\uc774\uac00 \ub418\uac70\ub098 \uc5ec\ub7ec \uc0dd\ubb3c\uc744 \uc7a1\uc544\uba39\uc73c\ubbc0\ub85c \uba39\uc774\uc0ac\uc2ac\ub4e4\uc774 \ubcf5\uc7a1\ud558\uac8c \uc5bd\ud78c \uba39\uc774\uadf8\ubb3c \ud615\ud0dc\ub97c \uc774\ub8f9\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uba39\uc774\uc0ac\uc2ac\uc740 \uc0dd\ud0dc\uacc4 \ub0b4\uc5d0\uc11c \uba39\uace0 \uba39\ud788\ub294 \uad00\uacc4\uac00 \ubcf5\uc7a1\ud55c \uadf8\ubb3c\ucc98\ub7fc \uc5bc\ud0a4\uc124\ud0a4 \uc5bd\ud600 \uc788\ub294 \uad6c\uc870 \uc804\uccb4\ub97c \uc758\ubbf8\ud55c\ub2e4.",
          "rationale": "\uc0dd\uc0b0\uc790\uc5d0\uc11c \ucd5c\uc885\uc18c\ube44\uc790\uae4c\uc9c0 \ub2e8\uc21c\ud55c \uc0ac\uc2ac \ud615\ud0dc\ub85c \uc5f0\uacb0\ub41c \uac83\uc740 \uba39\uc774\uc0ac\uc2ac\uc774\uba70, \ubcf5\uc7a1\ud558\uac8c \uc5bd\ud78c \uad6c\uc870\ub294 \uba39\uc774\uadf8\ubb3c\uc774\ub77c\uace0 \ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uba39\uc774\uadf8\ubb3c\uc774 \ubcf5\uc7a1\ud560\uc218\ub85d \uc0dd\ud0dc\uacc4\uc5d0\uc11c \ud2b9\uc815 \uc0dd\ubb3c\uc885\uc774 \uc0ac\ub77c\uc84c\uc744 \ub54c \uc804\uccb4 \uc0dd\ud0dc\uacc4\ud3c9\ud615\uc774 \uc27d\uac8c \ubb34\ub108\uc9c4\ub2e4.",
          "rationale": "\uba39\uc774\uadf8\ubb3c\uc774 \ubcf5\uc7a1\ud558\uba74 \ud55c \uc0dd\ubb3c\uc885\uc774 \uc0ac\ub77c\uc838\ub3c4 \ub300\uccb4\ud560 \uc218 \uc788\ub294 \ub2e4\ub978 \uba39\uc774\uac00 \uc874\uc7ac\ud558\ubbc0\ub85c \ud3c9\ud615\uc774 \ub354 \uc548\uc815\uc801\uc73c\ub85c \uc720\uc9c0\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0dd\ud0dc\uacc4 \ub0b4\uc5d0\uc11c \uc5d0\ub108\uc9c0 \uc804\ub2ec\uc740 \uc0c1\uc704 \uc601\uc591\ub2e8\uacc4\uc5d0\uc11c \ud558\uc704 \uc601\uc591\ub2e8\uacc4 \ubc29\ud5a5\uc73c\ub85c \uc9c4\ud589\ub41c\ub2e4.",
          "rationale": "\uc5d0\ub108\uc9c0 \uc804\ub2ec\uc740 \uba39\uace0 \uba39\ud788\ub294 \uad00\uacc4\ub97c \ud1b5\ud574 \ud558\uc704 \uc601\uc591\ub2e8\uacc4\uc5d0\uc11c \uc0c1\uc704 \uc601\uc591\ub2e8\uacc4\ub85c \uc804\ub2ec\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub2e8\uc21c\ud55c \uc0ac\uc2ac \ud615\ud0dc \uc5f0\uacb0\uacfc \uc5ec\ub7ec \uc0ac\uc2ac\uc774 \uc5bd\ud78c \uadf8\ubb3c \ud615\ud0dc\uc758 \ucc28\uc774\uc810\uc5d0 \uc720\uc758\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc0dd\uc0b0\uc790(\uc2dd\ubb3c)\uac00 \uad11\ud569\uc131\uc744 \ud1b5\ud574 \ud569\uc131\ud55c \uc591\ubd84\uc758 \uc4f0\uc784\uacfc \uac01 \uc601\uc591\ub2e8\uacc4\ub85c\uc758 \uc5d0\ub108\uc9c0 \uc804\ub2ec\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0dd\uc0b0\uc790\uac00 \uad11\ud569\uc131\uc73c\ub85c \ud569\uc131\ud55c \uc591\ubd84 \uc911 \uac00\uc7a5 \ub9ce\uc740 \ube44\uc728\uc740 \uc138\ud3ec\ud638\ud761\uc744 \ud1b5\ud574 \uc0dd\uba85\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \uc0ac\uc6a9\ub41c\ub2e4.",
          "rationale": "\uc2dd\ubb3c\uc740 \uc790\uc2e0\uc774 \ud569\uc131\ud55c \uc591\ubd84 \uc911 \uc138\ud3ec\ud638\ud761\uc73c\ub85c \uc0dd\uba85\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \uac00\uc7a5 \ub9ce\uc740 \uc5d0\ub108\uc9c0\ub97c \uc18c\ubaa8\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc0dd\uc0b0\uc790\uac00 \uc0dd\uc131\ud55c \uc804\uccb4 \uc591\ubd84 \uc911 \uc138\ud3ec\ud638\ud761\uc744 \uc81c\uc678\ud55c \ub0a8\uc740 \uc5d0\ub108\uc9c0\ub294 \ubaa8\ub450 1\ucc28 \uc18c\ube44\uc790\uc5d0\uac8c \uc804\ub2ec\ub41c\ub2e4.",
          "rationale": "\ub0a8\uc740 \uc591\ubd84 \uc911 \uc77c\ubd80\ub294 \uc0dd\uc7a5\ub7c9, \uc77c\ubd80\ub294 \ub099\uc5fd \ub4f1\uc73c\ub85c \uc18c\ubaa8\ub418\uace0 \uadf9\ud788 \uc77c\ubd80\ub9cc 1\ucc28 \uc18c\ube44\uc790\uc5d0\uac8c \uc804\ub2ec\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0c1\uc704 \uc601\uc591\ub2e8\uacc4\ub85c \uc62c\ub77c\uac08\uc218\ub85d \uac01 \uc601\uc591\ub2e8\uacc4\uac00 \ubcf4\uc720\ud55c \uc804\uccb4 \uc5d0\ub108\uc9c0\uc591\uc740 \uc810\ucc28 \uc99d\uac00\ud55c\ub2e4.",
          "rationale": "\uac01 \ub2e8\uacc4\uc5d0\uc11c \ud638\ud761 \ubc0f \uc0dd\uba85\ud65c\ub3d9\uc73c\ub85c \uc5d0\ub108\uc9c0\uac00 \uc18c\ubaa8\ub418\ubbc0\ub85c \uc0c1\uc704 \uc601\uc591\ub2e8\uacc4\ub85c \uac08\uc218\ub85d \uc804\uccb4 \uc5d0\ub108\uc9c0\uc591\uc740 \ud06c\uac8c \uc904\uc5b4\ub4ed\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "1\ucc28 \uc18c\ube44\uc790\uac00 \ud761\uc218\ud55c \uc5d0\ub108\uc9c0\ub294 \uc190\uc2e4 \uc5c6\uc774 \uadf8\ub300\ub85c 2\ucc28 \uc18c\ube44\uc790\uc5d0\uac8c 100% \uc804\ub2ec\ub41c\ub2e4.",
          "rationale": "1\ucc28 \uc18c\ube44\uc790 \uc5ed\uc2dc \uc790\uc2e0\uc758 \uc138\ud3ec\ud638\ud761 \ub4f1\uc5d0 \uc5d0\ub108\uc9c0\ub97c \uc0ac\uc6a9\ud558\ubbc0\ub85c \uc77c\ubd80\ub9cc 2\ucc28 \uc18c\ube44\uc790\uc5d0\uac8c \uc804\ub2ec\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc2dd\ubb3c\uc774 \uc0dd\uba85\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uae30\ubcf8\uc801\uc73c\ub85c \uac00\uc7a5 \ub9ce\uc774 \uc218\ud589\ud558\ub294 \uc0dd\uba85 \ud65c\ub3d9 \uacfc\uc815\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc548\uc815\ub41c \uc0dd\ud0dc\uacc4\uc5d0\uc11c \ub098\ud0c0\ub098\ub294 \uc0dd\ud0dc\ud53c\ub77c\ubbf8\ub4dc \ubc0f \uc601\uc591\ub2e8\uacc4\ubcc4 \uc0c1\ub300\uc801 \uc591\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0dd\ud0dc\ud53c\ub77c\ubbf8\ub4dc\uc758 \ucd5c\uc0c1\uc704 \uc601\uc591\ub2e8\uacc4\ub294 \ud558\uc704 \uc601\uc591\ub2e8\uacc4\ubcf4\ub2e4 \ud56d\uc0c1 \ub354 \ub9ce\uc740 \uc0dd\ubb3c\ub7c9\uc744 \ubcf4\uc720\ud55c\ub2e4.",
          "rationale": "\uc0c1\uc704 \uc601\uc591\ub2e8\uacc4\ub85c \uac08\uc218\ub85d \uc804\ub2ec\ub418\ub294 \uc5d0\ub108\uc9c0\uc591\uc774 \uc904\uc5b4\ub4e4\uae30 \ub54c\ubb38\uc5d0 \uac1c\uccb4\uc218, \uc5d0\ub108\uc9c0\uc591, \uc0dd\ubb3c\ub7c9\uc740 \ubaa8\ub450 \uc904\uc5b4\ub4dc\ub294 \ud53c\ub77c\ubbf8\ub4dc \ud615\ud0dc\ub97c \ub771\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "'\uc0dd\ubb3c\ub7c9'\uc774\ub780 \uc77c\uc815\ud55c \ud06c\uae30\uc758 \uc9c0\uc5ed\uc5d0 \uc11c\uc2dd\ud558\ub294 \uc0dd\ubb3c\uc758 \ucd1d\uc911\ub7c9\uc744 \ub73b\ud55c\ub2e4.",
          "rationale": "\uc0dd\ubb3c\ub7c9\uc758 \uc815\uc758\ub294 \ud2b9\uc815 \uc9c0\uc5ed \ub0b4 \uc11c\uc2dd\ud558\ub294 \uc0dd\ubb3c \uc804\uccb4\uc758 \ucd1d\uc911\ub7c9\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac01 \uc601\uc591\ub2e8\uacc4\uc5d0\uc11c \uc0dd\uba85\uccb4\uac00 \uac00\uc9c4 \uc5d0\ub108\uc9c0\uc591 \uc911 \uc801\uc740 \uc591\ub9cc\uc774 \ub2e4\uc74c \uc601\uc591\ub2e8\uacc4\ub85c \uc804\ub2ec\ub41c\ub2e4.",
          "rationale": "\ub300\ubd80\ubd84\uc758 \uc5d0\ub108\uc9c0\ub294 \uc0dd\uba85 \ud65c\ub3d9 \ubc0f \ud638\ud761\uc73c\ub85c \uc18c\ubaa8\ub418\uace0 \uc77c\ubd80\ub9cc \ub2e4\uc74c \ub2e8\uacc4\ub85c \uc804\ub2ec\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc548\uc815\ub41c \uc0dd\ud0dc\uacc4\uc5d0\uc11c\ub294 \uc0dd\uc0b0\uc790\uc5d0\uc11c \uc0c1\uc704 \uc18c\ube44\uc790\ub85c \uac08\uc218\ub85d \uac1c\uccb4\uc218\uac00 \uc904\uc5b4\ub4dc\ub294 \ud615\ud0dc\ub97c \ubcf4\uc778\ub2e4.",
          "rationale": "\uc548\uc815\ub41c \uc0dd\ud0dc\ud53c\ub77c\ubbf8\ub4dc\uc5d0\uc11c\ub294 \ud558\uc704 \uc601\uc591\ub2e8\uacc4\uc5d0\uc11c \uc0c1\uc704 \uc601\uc591\ub2e8\uacc4\ub85c \uac08\uc218\ub85d \uac1c\uccb4\uc218\uac00 \uc801\uc5b4\uc9d1\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ud53c\ub77c\ubbf8\ub4dc \uad6c\uc870\uc5d0\uc11c \uc704\ub85c \uc62c\ub77c\uac08\uc218\ub85d \uc591(\uac1c\uccb4\uc218, \uc5d0\ub108\uc9c0\uc591, \uc0dd\ubb3c\ub7c9)\uc774 \uc5b4\ub5bb\uac8c \ubcc0\ud654\ud558\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc548\uc815\ub41c \uc0dd\ud0dc\uacc4\uc5d0\uc11c \uc77c\uc2dc\uc801 \ud658\uacbd \ubcc0\ud654\ub85c 1\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \uae09\uc99d\ud558\uc600\uc744 \ub54c, \uadf8 \uc9c1\ud6c4 \uc5f0\uc1c4\uc801\uc73c\ub85c \uc77c\uc5b4\ub098\ub294 \ub2e4\ub978 \uac1c\uccb4\uad70\ub4e4\uc758 \ucd08\uae30 \ubcc0\ud654 \uc0c1\ud0dc\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0dd\uc0b0\uc790\uc758 \uac1c\uccb4\uc218\ub294 \uac10\uc18c\ud558\uace0, 2\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\ub294 \uc99d\uac00\ud55c\ub2e4.",
          "rationale": "1\ucc28 \uc18c\ube44\uc790\uac00 \ub298\uc5b4\ub098\uba74 \uba39\uc774\uac00 \ub418\ub294 \uc0dd\uc0b0\uc790\ub294 \ub9ce\uc774 \uba39\ud600 \uac10\uc18c\ud558\uace0, 1\ucc28 \uc18c\ube44\uc790\ub97c \uba39\uc774\ub85c \ud558\ub294 2\ucc28 \uc18c\ube44\uc790\ub294 \uba39\uc774\uac00 \ud48d\ubd80\ud574\uc838 \uc99d\uac00\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc0dd\uc0b0\uc790\uc758 \uac1c\uccb4\uc218\ub294 \uc99d\uac00\ud558\uace0, 2\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\ub294 \uac10\uc18c\ud55c\ub2e4.",
          "rationale": "1\ucc28 \uc18c\ube44\uc790\uac00 \uae09\uc99d\ud558\uba74 \uc0dd\uc0b0\uc790\uc758 \ud53c\uc2dd \uc555\ub825\uc774 \uc99d\uac00\ud558\uc5ec \uc0dd\uc0b0\uc790\ub294 \uac10\uc18c\ud558\uac8c \ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0dd\uc0b0\uc790\uc640 2\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \ubaa8\ub450 \uc99d\uac00\ud55c\ub2e4.",
          "rationale": "1\ucc28 \uc18c\ube44\uc790\uac00 \ub298\uc5b4\ub098\uba74 \ucd08\uc2dd\ub7c9\uc774 \uc99d\uac00\ud558\ubbc0\ub85c \uc0dd\uc0b0\uc790\ub294 \uc99d\uac00\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0dd\uc0b0\uc790\uc640 2\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \ubaa8\ub450 \uac10\uc18c\ud55c\ub2e4.",
          "rationale": "1\ucc28 \uc18c\ube44\uc790\uac00 \ub298\uc5b4\ub098\uba74 \uba39\uc774\uac00 \ub9ce\uc544\uc9c4 2\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\ub294 \ucd08\uae30 \uc99d\uac00 \uacbd\ud5a5\uc744 \ubcf4\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "1\ucc28 \uc18c\ube44\uc790\uac00 \uae09\uc99d\ud588\uc744 \ub54c 1\ucc28 \uc18c\ube44\uc790\uc758 \uba39\uc774(\ud558\uc704 \ub2e8\uacc4)\uc640 1\ucc28 \uc18c\ube44\uc790\ub97c \uba39\ub294 \ud3ec\uc2dd\uc790(\uc0c1\uc704 \ub2e8\uacc4)\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \uac01\uac01 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "1\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \uc77c\uc2dc\uc801\uc73c\ub85c \uae09\uc99d\ud55c \ud6c4, \uc5f0\uc1c4 \ubc18\uc751\uc744 \uac70\uccd0 \uc0dd\ud0dc\uacc4\uac00 \ub2e4\uc2dc \uc6d0\ub798\uc758 \uc548\uc815\ub41c \uc0dd\ud0dc\uacc4\ud3c9\ud615 \uc0c1\ud0dc\ub85c \ud68c\ubcf5\ub418\ub294 \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0dd\uc0b0\uc790 \uac10\uc18c\uc640 2\ucc28 \uc18c\ube44\uc790 \uc99d\uac00\ub85c \uc778\ud574 1\ucc28 \uc18c\ube44\uc790\ub294 \uba39\uc774 \ubd80\uc871\uacfc \ud3ec\uc2dd \uc99d\uac00\ub97c \uacaa\uc5b4 \uac1c\uccb4\uc218\uac00 \ub2e4\uc2dc \uac10\uc18c\ud55c\ub2e4.",
          "rationale": "1\ucc28 \uc18c\ube44\uc790\uc758 \uba39\uc774\uc778 \uc0dd\uc0b0\uc790\uac00 \uc904\uc5b4\ub4e4\uace0 \ud3ec\uc2dd\uc790\uc778 2\ucc28 \uc18c\ube44\uc790\uac00 \ub298\uc5b4\ub098\uba74\uc11c 1\ucc28 \uc18c\ube44\uc790\uc758 \uc218\uac00 \ub2e4\uc2dc \uc904\uc5b4\ub4e4\uc5b4 \ud3c9\ud615\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "1\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \uc9c0\uc18d\ud574\uc11c \uc99d\uac00\ud558\uc5ec 2\ucc28 \uc18c\ube44\uc790\uc640 \uc0dd\uc0b0\uc790\uac00 \ubaa8\ub450 \uba78\uc885\ud558\ub294 \uc0c1\ud0dc\uc5d0 \ub3c4\ub2ec\ud55c\ub2e4.",
          "rationale": "\uc548\uc815\ub41c \uc0dd\ud0dc\uacc4\uc5d0\uc11c\ub294 \uac01 \uc601\uc591\ub2e8\uacc4\uc758 \uc218 \uc870\uc808\uc744 \ud1b5\ud574 \uc6d0\ub798 \uc0c1\ud0dc\ub85c \ub418\ub3cc\uc544\uac11\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "2\ucc28 \uc18c\ube44\uc790\uac00 1\ucc28 \uc18c\ube44\uc790\ub97c \ubaa8\ub450 \uc7a1\uc544\uba39\uc740 \ud6c4 \uc0dd\uc0b0\uc790\uc758 \uac1c\uccb4\uc218\ub9cc \ubb34\ud55c\ud788 \uc99d\uac00\ud55c\ub2e4.",
          "rationale": "1\ucc28 \uc18c\ube44\uc790\uac00 \uac10\uc18c\ud558\uba74 2\ucc28 \uc18c\ube44\uc790\uc758 \uba39\uc774\ub3c4 \uc904\uc5b4\ub4e4\uc5b4 2\ucc28 \uc18c\ube44\uc790 \uc218 \uc5ed\uc2dc \ub2e4\uc2dc \uac10\uc18c\ud558\uba70 \uade0\ud615\uc744 \uc774\ub8f9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0dd\uc0b0\uc790 \uac1c\uccb4\uc218\uac00 \uac10\uc18c\ud568\uc5d0 \ub530\ub77c 1\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\ub294 \ub354\uc6b1 \uae09\uc99d\ud558\ub294 \uc591\uc0c1\uc744 \ubcf4\uc778\ub2e4.",
          "rationale": "\uba39\uc774\uc778 \uc0dd\uc0b0\uc790\uac00 \uac10\uc18c\ud558\uba74 1\ucc28 \uc18c\ube44\uc790\ub294 \uc601\uc591 \uacf5\uae09\uc774 \ubd80\uc871\ud574\uc838 \uac1c\uccb4\uc218\uac00 \uc904\uc5b4\ub4ed\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uba39\uc774 \ubd80\uc871\uacfc \ud3ec\uc2dd\uc790 \uc99d\uac00\ub77c\ub294 \ub450 \uac00\uc9c0 \uc694\uc778\uc774 1\ucc28 \uc18c\ube44\uc790 \uac1c\uccb4\uad70\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \uc904\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
