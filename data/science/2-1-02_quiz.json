        {
          "text": "\ud50c\ub77c\uc2a4\ud2f1\uc740 \ud574\uc218\uc5d0 \ub4e4\uc5b4\uac00\uba74 \uc218\uac1c\uc6d4 \uc774\ub0b4\uc5d0 \uc644\uc804\ud788 \ubd84\ud574\ub418\uc5b4 \uba39\uc774\uc0ac\uc2ac\uc5d0 \uccb4\uc801 \ucd95\uc801\ub418\uc9c0 \uc54a\ub294\ub2e4.",
          "rationale": "\ud50c\ub77c\uc2a4\ud2f1\uc740 \uc5ec\ub7ec \ud574 \ub3d9\uc548 \ubc14\ub2e4\uc5d0 \uc4f0\ub808\uae30\ub85c \ub0a8\uc544 \ubd84\ud574\ub418\uc9c0 \uc54a\uace0 \uc0dd\ubb3c\uccb4 \ub0b4\ub85c \uc720\uc785\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud574\uc591 \ub3d9\ubb3c\uc758 \ud50c\ub77c\uc2a4\ud2f1 \uc12d\ucde8\ub294 \uccb4\ub0b4 \uc601\uc591 \uacf5\uae09\uc6d0\uc73c\ub85c \uc791\uc6a9\ud558\uc5ec 1\ucc28 \uc18c\ube44\uc790\uc758 \uc0dd\uc7a5\uc744 \ucd09\uc9c4\ud55c\ub2e4.",
          "rationale": "\ud50c\ub77c\uc2a4\ud2f1\uc740 \uc0dd\uc7a5\uc758 \uc800\ud574, \ubc88\uc2dd \uc5b5\uc81c, \uc0ac\ub9dd \ub4f1 \ud574\ub85c\uc6b4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4.",
          "isCorrect": false
