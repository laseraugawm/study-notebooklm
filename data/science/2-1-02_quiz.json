    {
      "type": "multiple_choice",
      "question": "\uace0\ub871\uace0\uc0ac \uad6d\ub9bd\uacf5\uc6d0\uc5d0\uc11c 1\ucc28 \uc18c\ube44\uc790\uc778 \ucd08\uc2dd\ub3d9\ubb3c\uc774 \uae09\uc99d\ud558\uc5ec \uc0dd\ud0dc\uacc4\ud3c9\ud615\uc774 \ubb34\ub108\uc84c\uc744 \ub54c, 2\ucc28 \uc18c\ube44\uc790\uc778 \uc544\ud504\ub9ac\uce74\ub4e4\uac1c\ub97c \ub3c4\uc785\ud568\uc73c\ub85c\uc368 \uc0dd\ud0dc\uacc4\uac00 \ud68c\ubcf5\ub41c \uc6d0\ub9ac\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
