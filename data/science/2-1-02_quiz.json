    {
      "type": "multiple_choice",
      "question": "\uad50\uacfc\uc11c\uc5d0\uc11c \uc124\uba85\ud558\ub294 '\uc0dd\ud0dc\uacc4\ud3c9\ud615'\uc758 \uc815\uc758\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
