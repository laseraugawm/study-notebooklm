        {
          "text": "\ud50c\ub77c\uc2a4\ud2f1 \uc4f0\ub808\uae30\ub294 \ucd5c\uc0c1\uc704 \ud3ec\uc2dd\uc790\uc5d0\uac8c\ub9cc \ucd95\uc801\ub418\uace0 \ud558\uc704 \uc601\uc591\ub2e8\uacc4\uc778 \ud50c\ub791\ud06c\ud1a4\uc5d0\ub294 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\ub294\ub2e4.",
          "rationale": "\uba39\uc774\uc0ac\uc2ac \ucd5c\ud558\uc704 \ub2e8\uacc4\uc778 \ud50c\ub791\ud06c\ud1a4\ubd80\ud130 \ud50c\ub77c\uc2a4\ud2f1\uc744 \uc12d\ucde8\ud558\ubbc0\ub85c \ud558\uc704 \ub2e8\uacc4\uc5d0\ub3c4 \uc2ec\uac01\ud55c \uc601\ud5a5\uc744 \uc90d\ub2c8\ub2e4.",
          "isCorrect": false
