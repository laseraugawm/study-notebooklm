  "questions": [
    {
      "question": "\uc2dd\ubb3c\uc758 \uc5fd\ub85d\uccb4\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \uad11\ud569\uc131 \ubc18\uc751($6CO_2 + 6H_2O \\rightarrow C_6H_{12}O_6 + 6O_2$)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
