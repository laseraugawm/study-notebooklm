{
  "title": "\ubbf8\ub798\uae30\uc220 \ud034\uc988",
  "questions": [
    {
      "question": "\uc0ac\ubb3c \uc778\ud130\ub137(IoT)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\uac01\uc885 \ubb3c\uac74\uc5d0 \uc13c\uc11c\uc640 \ud1b5\uc2e0 \uae30\ub2a5\uc744 \ub0b4\uc7a5\ud558\uc5ec \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ud558\ub294 \uae30\uc220\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\ubb3c \uc778\ud130\ub137\uc740 \uc0ac\ubb3c\uc5d0 \uc13c\uc11c\uc640 \ud1b5\uc2e0 \uae30\ub2a5\uc744 \ubd80\uc5ec\ud558\uc5ec \uc2a4\uc2a4\ub85c \uc815\ubcf4\ub97c \uc218\uc9d1\ud558\uace0 \uad50\ud658\ud558\uba70 \uc6d0\uaca9 \uc870\uc808 \ub4f1\uc774 \uac00\ub2a5\ud558\ub3c4\ub85d \ub9cc\ub4dc\ub294 \uae30\uc220\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc678\ubd80 \ub124\ud2b8\uc6cc\ud06c \uc5f0\uacb0 \uc5c6\uc774 \ub2e8\ub9d0\uae30 \ub0b4\ubd80\uc5d0\uc11c\ub9cc \ub3c5\ub9bd\uc801\uc73c\ub85c \uc791\ub3d9\ud558\ub294 \uae30\uc220\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ubb3c \uc778\ud130\ub137\uc758 \ud575\uc2ec\uc740 \uc0ac\ubb3c\uc774 \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc0c1\ud638 \uc815\ubcf4\ub97c \uacf5\uc720\ud558\uace0 \uc6d0\uaca9\uc73c\ub85c \uc870\uc808\ub418\ub294 \ub370 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc624\uc9c1 \uc0ac\ub78c\uc774 \uc9c1\uc811 \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc870\uc791\ud560 \ub54c\ub9cc \uc815\ud574\uc9c4 \ub3d9\uc791\uc744 \uc218\ud589\ud558\ub294 \uae30\uc220\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ubb3c \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ub41c \ubb3c\uac74\ub4e4\uc740 \uc2a4\uc2a4\ub85c \uc815\ubcf4\ub97c \uc218\uc9d1\u00b7\uad50\ud658\ud558\uc5ec \uc2a4\uc2a4\ub85c \uc791\ub3d9\ud558\uac70\ub098 \uc6d0\uaca9 \uc870\uc808\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uacf5\uc9c0\ub2a5\uacfc \uacb0\ud569\ud560 \uc218 \uc5c6\ub3c4\ub85d \ub3c5\ub9bd\ub41c \ubcf4\uc548\ub9dd\uc5d0\uc11c\ub9cc \uad6c\ub3d9\ub418\ub294 \ub2e8\uc21c \uc7a5\uce58\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ubb3c \uc778\ud130\ub137\uc740 \uc778\uacf5\uc9c0\ub2a5 \uae30\uc220\uacfc \uacb0\ud569\ud558\uc5ec \uc218\uc9d1\ub41c \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uace0 \ub354\uc6b1 \uace0\ub3c4\ud654\ub41c \ubb38\uc81c\ub97c \ud574\uacb0\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubb3c\ud488 \uc790\uccb4\uc5d0 \uc815\ubcf4 \uc218\uc9d1\uacfc \ud1b5\uc2e0 \uae30\ub2a5\uc774 \ub0b4\uc7a5\ub418\uc5b4 \uc678\ubd80\uc640 \uc5f0\ub3d9\ub418\ub294 \uae30\uc220\uc801 \ud2b9\uc9d5\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 '\ubbf8\ub798 \uc2a4\ub9c8\ud2b8 \ud648'\uc5d0\uc11c \ud65c\uc6a9\ub418\ub294 \uc0ac\ubb3c \uc778\ud130\ub137 \uae30\uae30\uc640 \uadf8 \uae30\ub2a5\uc758 \uc5f0\uacb0\uc774 \uc62c\ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\ub0c9\uc7a5\uace0 - \uc2dd\ud488\uc758 \uc2e0\uc120\ub3c4\ub97c \ud30c\uc545\ud558\uc5ec \ub9de\ucda4\ud615 \uc694\ub9ac\ubc95 \uc548\ub0b4",
          "isCorrect": true,
          "rationale": "\uc2a4\ub9c8\ud2b8 \ud648\uc758 \ub0c9\uc7a5\uace0\ub294 \ubcf4\uad00\ub41c \uc2dd\ud488\uc758 \uc2e0\uc120\ub3c4\ub97c \uc2a4\uc2a4\ub85c \ud30c\uc545\ud558\uace0 \uc774\uc5d0 \ub9de\ub294 \ub9de\ucda4\ud615 \ub808\uc2dc\ud53c\ub97c \uc548\ub0b4\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc870\uba85 - \uae30\uc628\uacfc \uc2b5\ub3c4\ub97c \uce21\uc815\ud558\uc5ec \ucf8c\uc801\ud55c \uc2e4\ub0b4 \ud658\uacbd \uc790\ub3d9 \uad00\ub9ac",
          "isCorrect": false,
          "rationale": "\uae30\uc628\uacfc \uc2b5\ub3c4\ub97c \uce21\uc815\ud558\uc5ec \ucf8c\uc801\ud55c \ud658\uacbd\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc740 \uc870\uba85\uc774 \uc544\ub2cc \ub0c9\ub09c\ubc29 \uc7a5\uce58\uc758 \uc5ed\ud560\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uccad\uc18c \ub85c\ubd07 - \uc0ac\ub78c\uc758 \uc218\uba74 \ud328\ud134\uc744 \ud559\uc2b5\ud558\uc5ec \uc790\ub3d9 \uad00\ub9ac",
          "isCorrect": false,
          "rationale": "\uc218\uba74 \ud328\ud134\uc744 \ud559\uc2b5\ud558\uc5ec \uc790\ub3d9\uc73c\ub85c \uad00\ub9ac\ub418\ub294 \uac83\uc740 \uc870\uba85\uc758 \uc5ed\ud560\uc774\uba70, \uccad\uc18c \ub85c\ubd07\uc740 \uacf5\uac04\uc758 \ud615\ud0dc\ub97c \uc778\uc9c0\ud558\uc5ec \uccad\uc18c\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uacf5\uc9c0\ub2a5 \ube44\uc11c - \uc2e4\uc2dc\uac04 \uc5d0\ub108\uc9c0 \uc0ac\uc6a9\ub7c9\uc744 \ubd84\uc11d\ud558\uc5ec \uc804\uae30 \uc694\uae08 \uc790\ub3d9 \ub0a9\ubd80",
          "isCorrect": false,
          "rationale": "\uc5d0\ub108\uc9c0 \uc0ac\uc6a9\ub7c9\uc744 \ubd84\uc11d\ud574 \uc808\uc57d\uc744 \ub3d5\ub294 \uac83\uc740 \uc5d0\ub108\uc9c0 \uad00\ub9ac \uc2dc\uc2a4\ud15c\uc774\uba70, \uc778\uacf5\uc9c0\ub2a5 \ube44\uc11c\ub294 \uc0ac\ub78c\uc758 \ubaa9\uc18c\ub9ac\ub97c \uc778\uc2dd\ud574 \uc791\uc5c5\uc744 \uc218\ud589\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uac01 \uc2a4\ub9c8\ud2b8 \uac00\uc804\uc774 \uc218\uc9d1\ud558\ub294 \uc815\ubcf4\uc758 \uc885\ub958\uc640 \uc774\ub97c \ud1b5\ud574 \uc2e4\ud589\ud558\ub294 \uad6c\uccb4\uc801\uc778 \ub3d9\uc791\uc744 \ub300\uc870\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc774 \uc815\ud574\uc9c4 \ub3d9\uc791\ub9cc \uc218\ud589\ud558\ub358 \uacfc\uac70\uc758 \uc77c\ubc18 \ub85c\ubd07\uacfc \ucc28\ubcc4\ud654\ub418\ub294 \uac00\uc7a5 \ud070 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\uc8fc\ubcc0 \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0 \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uc5ec \uc6c0\uc9c1\uc77c \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc740 \uacfc\uac70 \ub85c\ubd07\uacfc \ub2ec\ub9ac \uc8fc\ubcc0 \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0 \uc2a4\uc2a4\ub85c \uc0c1\ud669\uc744 \ud310\ub2e8\ud558\uc5ec \ub2a5\ub3d9\uc801\uc73c\ub85c \ub3d9\uc791\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubb3c\ub9ac\uc801\uc778 \ud615\ud0dc \uc5c6\uc774 \ucef4\ud4e8\ud130 \ud504\ub85c\uadf8\ub7a8 \ub0b4\ubd80\uc5d0\uc11c\ub9cc \uc791\ub3d9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc740 \ub85c\ubd07 \uae30\uc220\uacfc \uc811\ubaa9\ub418\uc5b4 \uc2e4\uc81c \ubb3c\ub9ac\uc801\uc778 \ud589\ub3d9\uc744 \uc218\ud589\ud558\ub294 \uae30\uacc4\uc801 \ud615\ud0dc\ub97c \uac16\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc785\ub825\ub41c \uc21c\uc11c\uc640 \uba85\ub839\ub9cc\uc744 \uc624\ub958 \uc5c6\uc774 \ubc18\ubcf5 \uc218\ud589\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ud574\uc9c4 \ub3d9\uc791\ub9cc\uc744 \ub2e8\uc21c\ud788 \ubc18\ubcf5\ud558\ub294 \uac83\uc740 \uc778\uacf5\uc9c0\ub2a5 \uae30\uc220\uc774 \uc801\uc6a9\ub418\uae30 \uc804 \uae30\uc874 \ub85c\ubd07\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc678\ubd80 \uc13c\uc11c\uc758 \ub3c4\uc6c0 \uc5c6\uc774 \uc644\uc804\ud788 \uace0\ub9bd\ub41c \uc0c1\ud0dc\ub85c \ub3c5\ub9bd \uad6c\ub3d9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc740 \uc0ac\ubb3c \uc778\ud130\ub137 \ubc0f \ub2e4\uc591\ud55c \uc13c\uc11c\ub97c \ud65c\uc6a9\ud574 \uc8fc\ubcc0 \ud658\uacbd \uc815\ubcf4\ub97c \uc218\uc9d1\ud558\uace0 \ud310\ub2e8\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uace0\uc815\ub41c \ud504\ub85c\uadf8\ub7a8\uc5d0 \ub530\ub77c \uc6c0\uc9c1\uc774\ub358 \uae30\uc874 \ub85c\ubd07\uacfc \ub2ec\ub9ac, \uc0c1\ud669 \ubcc0\ud654\uc5d0 \uc2a4\uc2a4\ub85c \ub300\ucc98\ud558\ub294 \ub2a5\ub825\uc5d0 \uc8fc\ubaa9\ud558\uc138\uc694."
    },
    {
      "question": "\ubbf8\ub798 \uacfc\ud559 \ub3c4\uc2dc\uc758 \uc758\ub8cc \ubc0f \ubcd1\uc6d0 \uccb4\uacc4\uc5d0\uc11c \uacfc\ud559\uae30\uc220\uc774 \ud65c\uc6a9\ub418\ub294 \ubaa8\uc2b5\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\ud658\uc790\uc758 \uc9c4\ub8cc\uc640 \uce58\ub8cc\ub294 \ub85c\ubd07\uc774 \uc804\ub2f4\ud558\uba70 \uc758\uc0ac\ub294 \uc644\uc804\ud788 \ubc30\uc81c\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2a4\ub9c8\ud2b8 \ubcd1\uc6d0\uacfc \uc218\uc220\uc6a9 \ub85c\ubd07\uc740 \ud658\uc790 \ubaa8\ub2c8\ud130\ub9c1, \uc6d0\uaca9 \uc9c4\ub8cc, \uc815\ubc00\ud55c \uc758\ub8cc \uc11c\ube44\uc2a4 \uc81c\uacf5 \ub4f1 \uc758\uc0ac\uc758 \uc9c4\ub8cc\uc640 \uc218\uc220\uc744 \ubcf4\uc870\ud558\uace0 \uc9c0\uc6d0\ud558\ub294 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud658\uc790\uc758 \uc0c1\ud0dc\ub97c \uc2e4\uc2dc\uac04\uc73c\ub85c \ubaa8\ub2c8\ud130\ub9c1\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ub9c8\ud2b8 \ubcd1\uc6d0\uc5d0\uc11c\ub294 \uc13c\uc11c\uc640 \ub124\ud2b8\uc6cc\ud06c\ub97c \ud1b5\ud574 \ud658\uc790\uc758 \uac74\uac15 \uc0c1\ud0dc\ub97c \ubaa8\ub2c8\ud130\ub9c1\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc6d0\uac70\ub9ac\uc5d0\uc11c\ub3c4 \ud658\uc790\ub97c \uc6d0\uaca9 \uc9c4\ub8cc\ud558\ub294 \uc2a4\ub9c8\ud2b8 \ubcd1\uc6d0\uc774 \uc6b4\uc601\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc6d0\uaca9 \uc9c4\ub8cc \uae30\uc220\uc740 \uc2a4\ub9c8\ud2b8 \ubcd1\uc6d0\uc758 \uc8fc\uc694 \ud65c\uc6a9 \uc0ac\ub840 \uc911 \ud558\ub098\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc218\uc220\uc6a9 \ub85c\ubd07\uc744 \ud65c\uc6a9\ud558\uc5ec \uc815\ubc00\ud55c \uc758\ub8cc \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc220\uc6a9 \ub85c\ubd07\uc740 \uc758\uc0ac\uc758 \uc815\ubc00\ud55c \uc218\uc220 \uc218\ud589\uc744 \ub3c4\uc640 \uc758\ub8cc \uc11c\ube44\uc2a4\uc758 \uc815\ud655\uc131\uc744 \ub192\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uae30\uc220\uc774 \uc0ac\ub78c(\uc758\ub8cc\uc9c4)\uc758 \uc5ed\ud560\uc744 \ub300\uccb4\ud558\ub294 \uc218\uc900\uacfc \ubcf4\uc870\u00b7\ud611\ub825\ud558\ub294 \uc5ed\ud560\uc758 \ubc94\uc704\ub97c \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubbf8\ub798 \uacfc\ud559 \ub3c4\uc2dc\uc758 \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\uac00 \uc548\uc804\ud558\uace0 \ucd5c\uc801\ud654\ub41c \uc6b4\ud589\uc744 \ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \ud575\uc2ec \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\ud658\uacbd \uc815\ubcf4\ub97c \uc2e4\uc2dc\uac04\uc73c\ub85c \ubd84\uc11d\ud558\uc5ec \ucd5c\uc801\uc758 \uacbd\ub85c\ub97c \uc120\ud0dd\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\ub294 \uc678\ubd80 \ud658\uacbd \uc815\ubcf4\uc640 \uad50\ud1b5 \uc815\ubcf4\ub97c \uc2e4\uc2dc\uac04\uc73c\ub85c \uc218\uc9d1\u00b7\ubd84\uc11d\ud558\uc5ec \ucd5c\uc801\uc758 \uc6b4\ud589 \uacbd\ub85c\ub97c \ud310\ub2e8\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc6b4\uc804\uc790\uc758 \uc218\ub3d9 \uc870\uc791\uc5d0\ub9cc \uc758\uc874\ud558\uc5ec \uc815\ud574\uc9c4 \uc9c1\uc120 \ub3c4\ub85c\ub97c \ub2ec\ub9b0\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\ub294 \uc6b4\uc804\uc790\uc758 \uc9c0\uc18d\uc801\uc778 \uc9c1\uc811 \uc870\uc791 \uc5c6\uc774 \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uc5ec \uc6b4\ud589\ud558\ub294 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc678\ubd80\uc640\uc758 \ud1b5\uc2e0\uc744 \uc804\uba74 \ucc28\ub2e8\ud558\uc5ec \ub0b4\ubd80 \uc800\uc7a5 \ub370\uc774\ud130\ub85c\ub9cc \uc774\ub3d9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc728\uc8fc\ud589\uc744 \uc704\ud574\uc11c\ub294 \uc2e4\uc2dc\uac04 \uad50\ud1b5 \uc815\ubcf4 \ubc0f \ub3c4\ub85c \ud658\uacbd \ub370\uc774\ud130\ub97c \uc1a1\uc218\uc2e0\ud558\ub294 \uac83\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc18d\ub3c4\ub97c \uc81c\ud55c\ud558\uc9c0 \uc54a\uace0 \ud56d\uc0c1 \ucd5c\ub300 \uc18d\ub825\uc73c\ub85c\ub9cc \uc8fc\ud589\ud558\ub3c4\ub85d \uace0\uc815\ub418\uc5b4 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e4\uc2dc\uac04 \ud658\uacbd \ubd84\uc11d\uc744 \ud1b5\ud574 \uc548\uc804\ud558\uace0 \ud3b8\uc548\ud55c \uc6b4\uc804\uc774 \uac00\ub2a5\ud558\ub3c4\ub85d \uc18d\ub3c4\uc640 \uacbd\ub85c\ub97c \uc801\uc808\ud788 \uc870\uc808\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc8fc\ud589 \uc2dc \ub3c4\ub85c \uc0c1\ud669\uacfc \uc8fc\ubcc0 \ud658\uacbd \uc815\ubcf4\ub97c \uc218\uc9d1\ud558\uc5ec \ud6a8\uc728\uc801\uc778 \uc6b4\ud589 \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ub2a5\ub825\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubbf8\ub798 \ub18d\uc5c5\uc5d0 \uc801\uc6a9\ub418\ub294 '\uc2a4\ub9c8\ud2b8\ud31c \ub85c\ubd07'\uc758 \uc8fc\uc694 \uc5ed\ud560\ub85c \uc81c\uc2dc\ub41c \uac83\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\uc791\ubb3c\uc758 \uc0c1\ud0dc\ub97c \ud310\ub2e8\ud558\uc5ec \uc218\ud655\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2a4\ub9c8\ud2b8\ud31c \ub85c\ubd07\uc740 \uc791\ubb3c\uc758 \uc0dd\uc721 \uc0c1\ud0dc\ub098 \uc775\uc740 \uc815\ub3c4\ub97c \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uc5ec \uc801\uc808\ud55c \uc2dc\uae30\uc5d0 \uc218\ud655\ud558\ub294 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e4\ub0b4 \uc628\uc2b5\ub3c4 \uc13c\uc11c \uae30\ub2a5\ub9cc \uc81c\uacf5\ud558\uace0 \uc678\ubd80 \uc218\ud655 \uc791\uc5c5\uc740 \ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ub9c8\ud2b8\ud31c \ub85c\ubd07\uc740 \ub2e8\uc21c\ud788 \ud658\uacbd \uc815\ubcf4\ub9cc \uce21\uc815\ud558\ub294 \uac83\uc744 \ub118\uc5b4 \uc791\ubb3c \uc0c1\ud0dc \ud310\ub2e8 \ubc0f \uc218\ud655\uc774\ub77c\ub294 \ubb3c\ub9ac\uc801 \ud589\ub3d9\uc744 \uc218\ud589\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud1a0\uc591\uc758 \uc9c8\uc744 \uac80\uc0ac\ud558\uc5ec \uae30\uc0c1\uccad\uc5d0 \uc77c\uae30\uc608\ubcf4\ub97c \uc804\uc1a1\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ub9c8\ud2b8\ud31c \ub85c\ubd07\uc758 \uc8fc\ub41c \uc6a9\ub3c4\ub294 \uc791\ubb3c \uc0c1\ud0dc \ud310\ub2e8 \ubc0f \uc218\ud655 \ub4f1 \ub18d\uc791\ubb3c \uc9c1\uc811 \uad00\ub9ac\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uacf5\uc704\uc131\uc744 \uc81c\uc5b4\ud558\uc5ec \ub18d\uacbd\uc9c0\uc758 \uae30\ud6c4\ub97c \uc9c1\uc811 \ubcc0\uacbd\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ub9c8\ud2b8\ud31c \uae30\uc220\uc740 \uc8fc\uc5b4\uc9c4 \ud658\uacbd\uc5d0\uc11c \uc791\ubb3c\uc758 \uc0c1\ud0dc\ub97c \ubaa8\ub2c8\ud130\ub9c1\ud558\uace0 \ub18d\uc791\uc5c5\uc744 \uc790\ub3d9\ud654\ud558\ub294 \uae30\uc220\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub18d\uc791\ubb3c\uc758 \uc0dd\uc721 \uc870\uac74\uc744 \uad00\ucc30\ud558\uace0 \uc54c\ub9de\uc740 \ud0c0\uc774\ubc0d\uc5d0 \uc9c1\uc811\uc801\uc778 \ubb3c\ub9ac \ud65c\ub3d9\uc744 \uc9c4\ud589\ud558\ub294 \uae30\ub2a5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694."
    },
    {
      "question": "\ubbf8\ub798 \uacfc\ud559 \ub3c4\uc2dc \uad00\ub9ac \uc2dc\uc2a4\ud15c\uc5d0\uc11c \ub3c4\uc2dc \ub370\uc774\ud130\ub85c \uc218\uc9d1\u00b7\ud65c\uc6a9\ub418\ub294 \ud56d\ubaa9\uc73c\ub85c \uc5b8\uae09\ub418\uc9c0 \uc54a\uc740 \uac83\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\uac1c\uc778 \uac04 \ub098\ub204\ub294 \uc0ac\uc801\uc778 \ud1b5\ud654 \ub0b4\uc5ed",
          "isCorrect": true,
          "rationale": "\ub3c4\uc2dc \uad00\ub9ac \uc2dc\uc2a4\ud15c\uc740 \ub3c4\uc2dc \uc804\uccb4\uc758 \uc0ac\ubb3c \ubc0f \uc2dc\ubbfc\uc758 \uacf5\uacf5 \uc0c1\ud638\uc791\uc6a9\uc744 \ub3d5\uae30 \uc704\ud574 \ud658\uacbd, \uad50\ud1b5 \ub4f1\uc758 \ub3c4\uc2dc \ub370\uc774\ud130\ub97c \uc218\uc9d1\ud558\uba70 \uac1c\uc778 \uc0ac\uc0dd\ud65c \ub370\uc774\ud130\ub294 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub3c4\uc2dc\uc758 \ub300\uae30 \uc0c1\ud0dc \ubc0f \uacf5\uae30\uc9c8 \uc815\ubcf4",
          "isCorrect": false,
          "rationale": "\ub3c4\uc2dc\uc758 \ub300\uae30 \uc0c1\ud0dc\ub294 \uc2dc\ubbfc\ub4e4\uc758 \uac74\uac15\uacfc \ud658\uacbd \uad00\ub9ac\ub97c \uc704\ud574 \uc218\uc9d1\ub418\ub294 \uc8fc\uc694 \ub3c4\uc2dc \ub370\uc774\ud130\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc4f0\ub808\uae30\ud1b5\uc758 \ud3ec\ud654 \uc815\ub3c4",
          "isCorrect": false,
          "rationale": "\uc4f0\ub808\uae30\ud1b5 \ud3ec\ud654 \uc815\ub3c4 \ub370\uc774\ud130\ub97c \ud1b5\ud574 \ud6a8\uc728\uc801\uc778 \uc4f0\ub808\uae30 \uc218\uac70 \ubc0f \ub3c4\uc2dc \uc704\uc0dd \uad00\ub9ac\uac00 \uac00\ub2a5\ud574\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e4\uc2dc\uac04 \uad50\ud1b5\ub7c9 \ubc0f \uc8fc\ucc28 \uacf5\uac04 \uc815\ubcf4",
          "isCorrect": false,
          "rationale": "\uad50\ud1b5\ub7c9\uacfc \uc8fc\ucc28 \uacf5\uac04 \ub370\uc774\ud130\ub294 \uc6d0\ud65c\ud55c \ub3c4\ub85c \uad50\ud1b5 \ud750\ub984 \uad00\ub9ac\ub97c \uc704\ud574 \ud65c\uc6a9\ub418\ub294 \ub370\uc774\ud130\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub3c4\uc2dc \uc804\uccb4\uc758 \ud658\uacbd, \uad50\ud1b5, \uc790\uc6d0 \ub4f1 \uacf5\uacf5\uc801\uc778 \ubaa8\ub2c8\ud130\ub9c1 \ub370\uc774\ud130\uac00 \uc544\ub2cc \ud56d\ubaa9\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38\uc5d0\uc11c \uc5b8\uae09\ud55c \uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc758 \uad11\ubc94\uc704\ud55c \uc0ac\uc6a9\uc73c\ub85c \uc778\ud574 \uc6b0\ub824\ub418\ub294 \ubd80\uc815\uc801 \uc601\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\uc77c\uc790\ub9ac \uac10\uc18c \ubc0f \ub85c\ubd07\uc758 \ud1b5\uc81c \ubd88\ub2a5 \ubb38\uc81c",
          "isCorrect": true,
          "rationale": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc758 \ud655\uc0b0\uc740 \uc0b0\uc5c5 \uc0dd\uc0b0\uc131\uc744 \ub192\uc774\uc9c0\ub9cc, \uc778\uac04\uc758 \uc77c\uc790\ub9ac \uac10\uc18c\uc640 \ub85c\ubd07\uc774 \ud1b5\uc81c\uc5d0\uc11c \ubc97\uc5b4\ub0a0 \uc218 \uc788\ub2e4\ub294 \uc6b0\ub824\ub97c \uc720\ubc1c\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0b0\uc5c5 \uc804\uccb4\uc758 \uc0dd\uc0b0\uc131 \uac10\uc18c \ubc0f \ud6a8\uc728\uc131 \uc815\uccb4",
          "isCorrect": false,
          "rationale": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07 \ub3c4\uc785\uc740 \uc0b0\uc5c5 \uc0dd\uc0b0\uc131\uc744 \ub192\uc774\ub294 \uae0d\uc815\uc801 \ud6a8\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4."
        },
        {
          "text": "\uc5d0\ub108\uc9c0 \uc0ac\uc6a9\ub7c9\uc758 \uae09\uaca9\ud55c \uac10\uc18c\ub85c \uc778\ud55c \uc2dc\uc2a4\ud15c \uc815\uc9c0",
          "isCorrect": false,
          "rationale": "\uc5d0\ub108\uc9c0 \ud6a8\uc728\uc801 \uc0ac\uc6a9\uc740 \uae0d\uc815\uc801 \ud6a8\uacfc\uc774\uba70, \uc774\uac83\uc774 \ubd80\uc815\uc801 \uc6b0\ub824\ub85c \uc81c\uc2dc\ub418\uc9c0\ub294 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ubb3c \uac04 \uc815\ubcf4 \uacf5\uc720 \ucc28\ub2e8\uc73c\ub85c \uc778\ud55c \ud1b5\uc2e0 \ub9c8\ube44",
          "isCorrect": false,
          "rationale": "\uc778\uacf5\uc9c0\ub2a5\uacfc \uc0ac\ubb3c \uc778\ud130\ub137\uc758 \ubc1c\ub2ec\uc740 \uc0ac\ubb3c \uac04 \uc815\ubcf4 \uacf5\uc720\ub97c \ub354\uc6b1 \ud65c\uc131\ud654\uc2dc\ud0b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0ac\ub78c\uc758 \ub178\ub3d9\ub825\uc744 \ub300\uccb4\ud558\uac70\ub098 \uae30\uc220\uc801 \uc624\ub958\ub85c \uc778\ud574 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc0ac\ud68c\uc801 \uc5ed\uae30\ub2a5\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc778\uacf5\uc9c0\ub2a5 \uae30\uc220\uc774 \uac00\uc838\uc62c \ubd80\uc815\uc801 \ud6a8\uacfc\ub97c \uc608\ubc29\ud558\uace0 \uae0d\uc815\uc801 \ud6a8\uacfc\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \ubc29\uc548\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\uae30\uc220\uc774 \uc0ac\ud68c \uc804\ubc18\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \uc608\uce21\ud558\uace0 \uae30\uc220\uc801\u00b7\uc81c\ub3c4\uc801\uc73c\ub85c \ub300\ube44\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubd80\uc791\uc6a9\uc744 \uc608\ubc29\ud558\uace0 \uae0d\uc815\uc801 \ud6a8\uacfc\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uae30\uc220\uc774 \ubbf8\uce60 \uc0ac\ud68c\uc801 \ud30c\uae09\ub825\uc744 \uc608\uce21\ud558\uace0 \uc774\uc5d0 \ub300\ud55c \uae30\uc220\uc801\u00b7\uc81c\ub3c4\uc801 \uc7a5\uce58\ub97c \ub9c8\ub828\ud574\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0c8\ub85c\uc6b4 \uacfc\ud559\uae30\uc220 \uc5f0\uad6c \ubc0f \uc778\uacf5\uc9c0\ub2a5 \uac1c\ubc1c\uc744 \uc804\uba74 \uc911\ub2e8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\uc220 \uac1c\ubc1c\uc758 \uc644\uc804 \uc911\ub2e8\uc740 \uc0ac\ud68c \ubc1c\uc804\uc758 \uae30\ud68c\ub97c \ud3ec\uae30\ud558\ub294 \uac83\uc774\ubbc0\ub85c \uc62c\ubc14\ub978 \ub300\ube44\ucc45\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\uc220\uc5d0 \ub300\ud55c \ubc95\uc801 \uaddc\uc81c\ub098 \uc81c\ub3c4\ub97c \ubaa8\ub450 \uc5c6\uc560\uace0 \uc790\uc728\uc5d0\ub9cc \ub9e1\uae34\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc81c\ub3c4\uc801 \ub300\ube44\uac00 \uc5c6\uc744 \uacbd\uc6b0 \uc77c\uc790\ub9ac \ubb38\uc81c\ub098 \ud1b5\uc81c \ubd88\ub2a5 \ubb38\uc81c \ub4f1\uc758 \ubd80\uc791\uc6a9\uc774 \ub354\uc6b1 \uc2ec\ud654\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc758 \ud65c\uc6a9 \ubc94\uc704\ub97c \uc624\uc9c1 \uac00\uc815 \ub0b4\ubd80\ub85c\ub9cc \uc81c\ud55c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc740 \uc0b0\uc5c5, \uc758\ub8cc, \uad50\ud1b5, \ud658\uacbd \ub4f1 \uc0ac\ud68c \uc804\ubc18\uc5d0\uc11c \ud65c\uc6a9\ub418\uba70 \uc801\uc808\ud55c \uc81c\ub3c4\uc801 \ub300\ube44\uac00 \uc218\ubc18\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uae30\uc220\uc801 \ubc1c\uc804\uacfc \uc0ac\ud68c\uc801 \uaddc\ubc94 \ub610\ub294 \uc81c\ub3c4\uac00 \ud568\uaed8 \ubc1c\ub9de\ucd94\uc5b4 \ub098\uc544\uac00\uc57c \ud55c\ub2e4\ub294 \uc810\uc744 \uace0\ub824\ud558\uc138\uc694."
    },
    {
      "question": "\ubcf8\ubb38\uc758 \ud0d0\uad6c \ud65c\ub3d9 \uc911 '\uc74c\uc2dd\uc744 \ub098\ub974\ub294 \ub85c\ubd07(\uc11c\ube59 \ub85c\ubd07)'\uc758 \ubd88\ud3b8\ud55c \uc810\uc778 '\ub2e4\ub978 \uce35\uc73c\ub85c \ubc30\ub2ec\ud558\uae30 \uc5b4\ub835\ub2e4'\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc81c\uc2dc\ub41c \uac1c\uc120 \ubc29\uc548\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "answerOptions": [
        {
          "text": "\ubc14\ud034 \ub300\uc2e0 \ub2e4\ub9ac\ub97c \ub2ec\uc544 \uc8fc\ub294 \ud615\ud0dc \uad6c\uc870 \ubcc0\uacbd",
          "isCorrect": true,
          "rationale": "\ud0d0\uad6c \ud65c\ub3d9 \uc608\uc2dc\uc5d0\uc11c \ud3c9\uba74 \uc774\ub3d9\uc6a9 \ubc14\ud034 \ub300\uc2e0 \ub2e4\ub9ac\ub97c \ub2ec\uc544 \uacc4\ub2e8\uc774\ub098 \uce35\uac04 \uc774\ub3d9\uc744 \uac00\ub2a5\ud558\uac8c \ud558\ub294 \uac1c\uc120 \ubc29\ubc95\uc774 \uc81c\uc2dc\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc74c\uc2dd \uc628\ub3c4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud55c \uac00\uc5f4 \uc7a5\uce58 \ucd94\uac00",
          "isCorrect": false,
          "rationale": "\uac00\uc5f4 \uc7a5\uce58\ub294 \uc628\ub3c4 \uc720\uc9c0 \ubc29\uc548\uc774\uba70, \uce35\uac04 \uc774\ub3d9 \ubb38\uc81c \ud574\uacb0\uacfc\ub294 \uc9c1\uc811\uc801 \uc5f0\uad00\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc2dd\uc7ac\ub8cc\ub97c \uc218\ud655\ud560 \uc218 \uc788\ub294 \ub300\ud615 \uc9d1\uac8c\ud314 \uc7a5\ucc29",
          "isCorrect": false,
          "rationale": "\uc218\ud655\uc6a9 \uc7a5\ube44\ub294 \uc2a4\ub9c8\ud2b8\ud31c \ub85c\ubd07\uc758 \uc5ed\ud560\uc5d0 \uac00\uae5d\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc74c\uc131\uc744 \uc778\uc2dd\ud558\uc5ec \uc190\ub2d8\uc758 \uc8fc\ubb38\uc744 \ubc1b\ub294 \uc2a4\ud53c\ucee4 \uc124\uce58",
          "isCorrect": false,
          "rationale": "\uc74c\uc131 \uc778\uc2dd \uc2a4\ud53c\ucee4\ub294 \uc8fc\ubb38 \ucc98\ub9ac\uc6a9 \uae30\ub2a5\uc73c\ub85c \uc774\ub3d9\uc131 \uac1c\uc120\ucc45\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\uacc4\ub2e8\uc774\ub098 \ud131\uc774 \uc788\ub294 \uc0c1\uc774\ud55c \uce35 \uac04 \uc774\ub3d9 \uc81c\ud55c\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud55c \ubb3c\ub9ac\uc801 \uad6c\uc870 \ubcc0\uacbd \uc544\uc774\ub514\uc5b4\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
