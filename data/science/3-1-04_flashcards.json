            "type": "text",
            "content": "\ud658\uacbd \ubd84\uc57c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ud654 \u300e\uc544\uc774, \ub85c\ubd07\u300f\uc5d0\uc11c \uc8fc\uc694 \uc18c\uc7ac\ub85c \ub2e4\ub8e8\ub294 \uacfc\ud559 \uad00\ub828 \uc0ac\ud68c\uc801 \uc7c1\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc758 \ubc94\uc8c4 \uac00\ub2a5\uc131 \ubc0f \uc790\uc728 \uc778\uacf5\uc9c0\ub2a5 \uc724\ub9ac\uc640 \ud1b5\uc81c \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ud654 \u300e\ub9c8\uc774 \uc2dc\uc2a4\ud130\uc988 \ud0a4\ud37c\u300f\uc5d0\uc11c \ub2e4\ub8e8\ub294 \uc8fc\uc694 \uc0dd\uba85\uc724\ub9ac\uc801 \uc7c1\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud615\uc81c\uc790\ub9e4 \uce58\ub8cc\ub97c\ubaa9\uc801\uc73c\ub85c \ud0dc\uc5b4\ub09c '\ub9de\ucda4\ud615 \uc544\uae30'\uc758 \uc0dd\uba85 \uc874\uc5c4\uc131\uacfc \uc724\ub9ac\uc801 \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ud654 \u300e2001 \uc2a4\ud398\uc774\uc2a4 \uc624\ub514\uc138\uc774\u300f\uc5d0\uc11c \uc778\uacf5\uc9c0\ub2a5\uacfc \uad00\ub828\ud558\uc5ec \ub2e4\ub8e8\ub294 \uc7c1\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\uc2a4\ub85c \uc0dd\uac01\ud558\uac8c \ub41c \uc6b0\uc8fc\uc120 \uad00\ub9ac \uc778\uacf5\uc9c0\ub2a5\uacfc \uc778\uac04 \uc0ac\uc774\uc758 \uac08\ub4f1 \ubc0f \ud1b5\uc81c\uad8c \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ud654 \u300e\uc625\uc790\u300f\ub97c \ud1b5\ud574 \uc81c\uae30\ub418\ub294 \uc0dd\uba85\uacf5\ud559\uae30\uc220 \uad00\ub828 \uc8fc\uc694 \uc0ac\ud68c\uc801 \uc7c1\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559 \ubc1c\uc804\uacfc \uc0c1\uc5c5\uc801 \ubaa9\uc801\uc744 \uba85\ubd84\uc73c\ub85c \uc9c4\ud589\ub418\ub294 \uc720\uc804\uc790 \uac1c\ub7c9 \ub3d9\ubb3c\uc758 \uad8c\ub9ac\uc640 \uc0dd\uba85\uc724\ub9ac \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ud654 \u300e\ube44\ud3ec \ub354 \ud50c\ub7ec\ub4dc\u300f\uc5d0\uc11c \ud575\uc2ec \uc8fc\uc81c\ub85c \ub2e4\ub8e8\ub294 \uacfc\ud559 \uad00\ub828 \uc0ac\ud68c\uc801 \uc7c1\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804 \uc138\uacc4\uac00 \uc9c1\uba74\ud55c \uae30\ud6c4 \ubcc0\ud654 \ubc0f \uc774\uc5d0 \ub300\ud55c \uad6d\uac00\uc801\u00b7\uc778\ub958\uc801 \ub300\ucc98 \ubc29\uc548"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc601\ud654 \u300e\uc2b9\ub9ac\ud638\u300f\uc5d0\uc11c \uc9c0\uad6c \ud658\uacbd \ud30c\uad34\uc640 \ub354\ubd88\uc5b4 \uc6b0\uc8fc \uacf5\uac04\uacfc \uad00\ub828\ud574 \uc81c\uc2dc\ub41c \uc7c1\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uad6c \ud658\uacbd \ud669\ud3d0\ud654 \ubc0f \uc6b0\uc8fc \uc4f0\ub808\uae30 \uad00\ub9ac \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559 \uad00\ub828 \uc0ac\ud68c\uc801 \uc7c1\uc810(SSI)\uc744 \ub2e4\uac01\ub3c4\ub85c \ud1a0\uc758\ud560 \ub54c \uace0\ub824\ud574\uc57c \ud558\ub294 \ub300\ud45c\uc801\uc778 4\uac00\uc9c0 \uce21\uba74\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uacfc\ud559\uae30\uc220\uc801 \uce21\uba74\n2. \uc0ac\ud68c\uc801 \uce21\uba74\n3. \uacbd\uc81c\uc801 \uce21\uba74\n4. \ud658\uacbd\uc801 \uce21\uba74"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07 \ud65c\uc6a9 \uc815\ucc45 \uc81c\uc548\uc11c\ub97c \uc791\uc131\ud560 \ub54c \ud3ec\ud568\ub418\ub294 \uc8fc\uc694 \uad6c\uc131 \ud56d\ubaa9 4\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc758 \uc724\ub9ac \uaddc\uc815\n2. \ub85c\ubd07 \uac1c\ubc1c\uc790 \uc900\uc218 \uc9c0\uce68\n3. \ub85c\ubd07 \uc0ac\uc6a9\uc790 \uc900\uc218 \uc9c0\uce68\n4. \uc815\ubd80 \uae30\uad00\uc758 \uad00\ub9ac \uccb4\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\ubd07\uc774 \uc9c0\ucf1c\uc57c \ud560 \uc6d0\uce59 \uc911 \"\uccab\uc9f8 \uc6d0\uce59\uc5d0 \uc5b4\uae0b\ub098\uc9c0 \uc54a\ub294 \ud55c, \ub85c\ubd07\uc740 \uc0ac\ub78c\uc758 \uba85\ub839\uc744 \ub530\ub978\ub2e4.\"\ub294 \uba87 \uc6d0\uce59\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c2\uc6d0\uce59"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\ubd07\uc774 \uc9c0\ucf1c\uc57c \ud560 \uc6d0\uce59 \uc911 \"\ub85c\ubd07\uc740 \uc0ac\ub78c\uc744 \ud574\uccd0\uc11c\ub294 \uc548 \ub41c\ub2e4.\"\ub294 \uba87 \uc6d0\uce59\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c1\uc6d0\uce59"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uba85\uacf5\ud559\uae30\uc220 \ubc1c\uc804\uc5d0 \ub530\ub978 \uc720\uc804\uc790\uc870\uc791\uc758 \uc704\ud5d8\uc131\uc740 \uc5b4\ub5a0\ud55c \uc6a9\uc5b4\ub85c \ubd84\ub958\ub418\ub294 \uc0ac\ud68c\uc801 \uc7c1\uc810\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559 \uad00\ub828 \uc0ac\ud68c\uc801 \uc7c1\uc810(SSI)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559\uae30\uc220\uc758 \uc774\uc6a9 \uacfc\uc815\uc5d0\uc11c \uacfc\ud559 \uc724\ub9ac\uac00 \uc900\uc218\ub418\uc9c0 \uc54a\uc744 \uacbd\uc6b0 \uc0ac\ud68c\uc801\uc73c\ub85c \uc5b4\ub5a4 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\ud574\uad00\uacc4 \ucda9\ub3cc\ub85c \uc778\ud55c \uc0ac\ud68c\uc801 \uac08\ub4f1 \uc720\ubc1c \ubc0f \uc778\ub958\uc758 \uc548\uc804\uacfc \ud658\uacbd \ud6fc\uc190 \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\ubd07 \uc724\ub9ac\uc5d0\uc11c \uac1c\ubc1c\uc790\uac00 \uc900\uc218\ud574\uc57c \ud560 \uc9c0\uce68\uc774 \uc815\ucc45 \uc81c\uc548\uc11c\uc5d0 \ud544\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubc1c \ub2e8\uacc4\ubd80\ud130 \ucc28\ubcc4\uc801 \ud559\uc2b5\uc774\ub098 \uc778\uac04 \uc704\ud574 \uac00\ub2a5\uc131\uc744 \ubc29\uc9c0\ud558\ub294 \uc548\uc815\uc801 \uc54c\uace0\ub9ac\uc998\uc744 \uc124\uacc4\ud558\uae30 \uc704\ud568\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559 \uc724\ub9ac\uc758 \uae30\ubcf8 \uc694\uc18c \uc911 \uc5f0\uad6c \ub300\uc0c1 \ub3d9\ubb3c\uc774\ub098 \uc778\uac04 \uc0dd\uba85\uccb4\ub97c \ub2e4\ub8f0 \ub54c \uac00\uc7a5 \uc6b0\uc120\uc2dc\ub418\ub294 \uc6d0\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uba85 \uc874\uc911"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uad6c \uc628\ub09c\ud654 \uc2ec\ud654\uc640 \uc0b0\ub9bc \ud30c\uad34\uac00 \ucd08\ub798\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc0dd\ud0dc\uacc4 \uc704\ud5d8 \uc7c1\uc810\uc740 \uc5b4\ub514\uc5d0 \ud574\ub2f9\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd \ubd84\uc57c SSI"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac00\uc2b5\uae30 \uc0b4\uade0\uc81c \uc0ac\uac74\uc774\ub098 \ud654\ud559 \ubb3c\uc9c8 \uc720\ucd9c \uc0ac\uace0\uac00 \uc2dc\uc0ac\ud558\ub294 \uacfc\ud559 \uc724\ub9ac\uc758 \ud575\uc2ec \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc548\uc804 \ubc0f \ud658\uacbd\uc801 \ucc45\uc784 (\uc778\uccb4 \uc601\ud5a5 \uac80\uc99d\uacfc \uc548\uc804\uc131 \ud655\ubcf4)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\uc2dc\ubaa8\ud504\uc758 \ub85c\ubd07 3\uc6d0\uce59\uc774 \ub9cc\ub4e4\uc5b4\uc9c4 \uc5f0\ub3c4\ub294 \uc5b8\uc81c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1950\ub144"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\ubd07 \uc724\ub9ac \uc7c1\uc810 \uc911 \uc790\uc728\uc8fc\ud589\ucc28 \uc0ac\uace0\uc758 \ucc45\uc784 \uc18c\uc7ac \ud310\ubcc4\uc774 \ubcf5\uc7a1\ud55c \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b4\uc804\uc790, \uc81c\uc870\uc0ac, \uc778\uacf5\uc9c0\ub2a5 \uc54c\uace0\ub9ac\uc998 \uac1c\ubc1c\uc790 \uac04\uc5d0 \ucc45\uc784 \ubd84\ub2f4 \uae30\uc900\uc774 \uba85\ud655\ud558\uc9c0 \uc54a\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uba85\uacf5\ud559 \ubd84\uc57c\uc5d0\uc11c \uc778\uac04 \ubc30\uc544 \uc5f0\uad6c\uac00 \uc724\ub9ac \ub17c\uc7c1\uc744 \uc77c\uc73c\ud0a4\ub294 \ud575\uc2ec \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc30\uc544\ub97c \ub3c5\ub9bd\ub41c \uc0dd\uba85\uccb4\ub85c \ubcfc \uac83\uc778\uac00, \uc5f0\uad6c \uc7ac\ub8cc\ub85c \ud65c\uc6a9\ud560 \uc218 \uc788\ub294\uac00\uc5d0 \ub300\ud55c \uc0dd\uba85 \uc874\uc5c4\uc131 \uae30\uc900\uc758 \ucc28\uc774 \ub54c\ubb38"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc591 \uc790\uc6d0 \uc774\uc6a9 \ubc0f \uac04\ucc99 \uc0ac\uc5c5\uc774 \uc720\ubc1c\ud558\ub294 \uc8fc\uc694 \uc0ac\ud68c\uc801 \uc7c1\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacbd\uc81c\uc801 \uac1c\ubc1c \ud6a8\uacfc\uc640 \ud574\uc591 \uc0dd\ud0dc\uacc4 \ubc0f \uc790\uc5f0 \ud658\uacbd \ud30c\uad34 \uc0ac\uc774\uc758 \uac08\ub4f1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud56d\uc0dd\uc81c \ub0a8\uc6a9\uc774 \uac00\uc838\uc624\ub294 \ubcf4\uac74 \ubd84\uc57c\uc758 \uc2ec\uac01\ud55c \uc7c1\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc288\ud37c\ubc84\uadf8(\ud56d\uc0dd\uc81c \ub0b4\uc131\uade0) \ucd9c\ud604\uc5d0 \ub530\ub978 \uc778\ub958 \uac74\uac15 \uc704\ud611"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559\uae30\uc220\uc758 \ubc1c\uc804\uc774 \uae0d\uc815\uc801 \uc601\ud5a5\ub9cc \uc8fc\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ubd80\uc815\uc801 \ubb38\uc81c\ub97c \uc77c\uc73c\ud0ac \ub54c \uc774\ub97c \ud574\uacb0\ud558\ub294 \uae30\uc900\uc774 \ub418\ub294 \uc6d0\uce59\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559 \uc724\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub85c\ubd07 \uc724\ub9ac 3\uc6d0\uce59 \uc911 \ub85c\ubd07\uc758 '\uc790\uc2e0 \ubcf4\ud638' \uad8c\ub9ac\ub294 \uba87 \uc6d0\uce59\uc5d0 \uba85\uc2dc\ub418\uc5b4 \uc788\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c3\uc6d0\uce59"
          }
        ]
      }
    }
  ]
