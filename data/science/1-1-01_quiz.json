{
  "title": "\uc9c0\uc9c8\uc2dc\ub300 \ud034\uc988",
  "questions": [
    {
      "question": "\uc9c0\uc9c8 \uc2dc\ub300\ub97c \uad6c\ubd84\ud558\ub294 \uac00\uc7a5 \ud575\uc2ec\uc801\uc778 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc9c0\uce35\uc5d0 \ub0a8\uc544 \uc788\ub294 \ud654\uc11d\uc758 \uae09\uaca9\ud55c \ubcc0\ud654\uc640 \uc804 \uc9c0\uad6c\uc801\uc778 \ud658\uacbd \ubcc0\ud654",
          "isCorrect": true,
          "rationale": "\uc9c0\uad6c \ud658\uacbd\uc774 \ud06c\uac8c \ubcc0\ud558\uba74 \uc0dd\ubb3c\uc758 \uc11c\uc2dd \ud658\uacbd\uacfc \ucd9c\ud604\u00b7\uba78\uc885 \uc591\uc0c1\uc774 \ub2ec\ub77c\uc838 \uc9c0\uce35 \uc18d \ud654\uc11d \uc885\ub958\uc640 \uc218\uc5d0 \uae09\uaca9\ud55c \ubcc0\ud654\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uad6c\uc758 \uc790\uc804 \uc8fc\uae30 \ubcc0\ud654 \ubc0f \uacf5\uc804 \uada4\ub3c4\uc758 \uacbd\uc0ac\uac01 \ubcc0\ud654",
          "isCorrect": false,
          "rationale": "\ucc9c\ubb38\ud559\uc801\uc778 \uc790\uc804 \ubc0f \uacf5\uc804 \uada4\ub3c4 \ubcc0\ud654\ub294 \uc9c0\uc9c8 \uc2dc\ub300\ub97c \uad6c\ud68d\ud558\ub294 \uc9c1\uc811\uc801\uc778 \ud45c\uc900 \uae30\uc900\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\ub300\ub959 \ube59\ud558\uc758 \ub2e8\uc21c \uc99d\uac10\uacfc \ud574\uc218\uba74 \ub192\uc774\uc758 \uc77c\uc2dc\uc801 \ubcc0\ub3d9",
          "isCorrect": false,
          "rationale": "\ud574\uc218\uba74\uc758 \uad6d\uc18c\uc801\uc774\uace0 \uc77c\uc2dc\uc801\uc778 \ubcc0\ud654\ubcf4\ub2e4\ub294 \uc0dd\ubb3c\uacc4 \uc804\uccb4\uc758 \ub300\ub300\uc801\uc778 \uc1c4\uc2e0\uc774\ub098 \uad11\ubc94\uc704\ud55c \ud658\uacbd \ubcc0\ud654\uac00 \uae30\uc900\uc774 \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ucd5c\ucd08 \ub2e8\uc138\ud3ec \uc0dd\ubb3c\uc758 \ucd9c\ud604 \uc2dc\uae30\uc640 \ud1f4\uc801\uc554 \ud615\uc131 \uc18d\ub3c4",
          "isCorrect": false,
          "rationale": "\ub2e8\uc138\ud3ec \uc0dd\ubb3c\uc758 \ucd9c\ud604\uc740 \uc120\uce84\ube0c\ub9ac\uc544\uc2dc\ub300 \ub0b4\ubd80\uc758 \uc0ac\uac74\uc774\uba70, \uc9c0\uc9c8 \uc2dc\ub300\ub97c \uace0\uc0dd\ub300, \uc911\uc0dd\ub300, \uc2e0\uc0dd\ub300\ub85c \ub098\ub204\ub294 \uad6c\ubd84 \uae30\uc900\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc9c0\uce35\uc5d0 \uae30\ub85d\ub41c \uc0dd\uba85\uccb4\uc758 \uc720\ud574\ub098 \ud754\uc801\uc758 \ubcc0\ud654 \uc591\uc0c1\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc120\uce84\ube0c\ub9ac\uc544\uc2dc\ub300\uc758 \uc9c0\uad6c \ud658\uacbd\uacfc \uc0dd\ubb3c\uacc4 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub0a8\uc138\uade0\uc758 \uad11\ud569\uc131 \ud65c\ub3d9\uc73c\ub85c \ub300\uae30 \uc911\uc5d0 \uc0b0\uc18c\uac00 \uc810\ucc28 \ucd95\uc801\ub418\uae30 \uc2dc\uc791\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc120\uce84\ube0c\ub9ac\uc544\uc2dc\ub300\uc5d0\ub294 \ub0a8\uc138\uade0\uacfc \uac19\uc740 \uad11\ud569\uc131 \uc0dd\ubb3c\uc774 \ub4f1\uc7a5\ud558\uc5ec \ub300\uae30 \uc911\uc5d0 \uc0b0\uc18c\ub97c \uacf5\uae09\ud558\uae30 \uc2dc\uc791\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uac70\ub300\ud55c \uc591\uce58\uc2dd\ubb3c \uc232\uc774 \uad11\ubc94\uc704\ud558\uac8c \ud615\uc131\ub418\uc5b4 \ud604\uc7ac\uc758 \uc11d\ud0c4\uce35\uc774 \ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc2ed $m$ \ud06c\uae30\uc758 \uac70\ub300 \uc591\uce58\uc2dd\ubb3c \uad70\ub77d\uacfc \uc2b5\uc9c0 \uc232\uc774 \uc11d\ud0c4\uce35\uc744 \ud615\uc131\ud55c \uc2dc\uae30\ub294 \uace0\uc0dd\ub300\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub300\uae30 \uc911 \uc624\uc874\uce35\uc774 \ucda9\ubd84\ud788 \ud615\uc131\ub418\uc5b4 \uc0dd\ubb3c\uc774 \uc721\uc0c1\uc73c\ub85c \uc9c4\ucd9c\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc624\uc874\uce35\uc774 \ud615\uc131\ub418\uc5b4 \uc790\uc678\uc120\uc774 \ucc28\ub2e8\ub418\uace0 \uc0dd\ubb3c\uc774 \uc721\uc9c0\ub85c \uc9c4\ucd9c\ud55c \uc2dc\uae30\ub294 \uace0\uc0dd\ub300\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub2e8\ub2e8\ud55c \ubf08\uc640 \uaecd\ub370\uae30\ub97c \uac00\uc9c4 \uc0dd\ubb3c\uc774 \ud3ed\ubc1c\uc801\uc73c\ub85c \uc99d\uac00\ud558\uc5ec \ud654\uc11d\uc774 \ub9ce\uc774 \ub0a8\uc544 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc120\uce84\ube0c\ub9ac\uc544\uc2dc\ub300 \uc0dd\ubb3c\uc740 \uc8fc\ub85c \ub2e8\ub2e8\ud55c \uaecd\ub370\uae30\ub098 \uace8\uaca9\uc774 \uc5c6\uc5b4 \ud654\uc11d\uc73c\ub85c \ub0a8\uae30 \uc5b4\ub824\uc6e0\uc73c\uba70, \ud654\uc11d\uc774 \ud48d\ubd80\ud574\uc9c4 \uac83\uc740 \uace0\uc0dd\ub300\ubd80\ud130\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ucd08\uae30 \ubc14\ub2e4\uc5d0\uc11c \ube5b\uc744 \uc774\uc6a9\ud558\uc5ec \uae30\uccb4\ub97c \ubc30\ucd9c\ud558\ub358 \ubbf8\uc0dd\ubb3c\uc758 \uc5ed\ud560\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uac15\uc6d0\ub3c4 \ud0dc\ubc31 \uad6c\ubb38\uc18c \uc9c0\uc5ed \uc9c0\uce35\uc5d0\uc11c \uc0bc\uc5fd\ucda9\uacfc \ubc14\ub2e4 \uc0dd\ubb3c \ud654\uc11d\uc774 \ubc1c\uacac\ub418\ub294 \uac83\uc744 \ud1b5\ud574 \ucd94\ub860\ud560 \uc218 \uc788\ub294 \uc0ac\uc2e4\uc740?",
      "answerOptions": [
        {
          "text": "\uacfc\uac70 \ud0dc\ubc31 \uc9c0\uc5ed\uc740 \ubc14\ub2e4 \ud658\uacbd\uc774\uc5c8\uc73c\ub098 \uc774\ud6c4 \uc9c0\uac01 \ubcc0\ub3d9 \ub4f1\uc73c\ub85c \uc721\uc9c0\ud654\ub418\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud574\uc591 \uc0dd\ubb3c\uc778 \uc0bc\uc5fd\ucda9 \ud654\uc11d\uc774 \ud604\uc7ac\uc758 \ub0b4\ub959 \uc0b0\uac04 \uc9c0\uc5ed\uc5d0\uc11c \ubc1c\uacac\ub41c\ub2e4\ub294 \uac83\uc740 \uacfc\uac70 \uadf8\uacf3\uc774 \ubc14\ub2e4\uc600\uc74c\uc744 \uc99d\uba85\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0bc\uc5fd\ucda9\uc740 \uacfc\uac70 \uc721\uc0c1\uc758 \uc2b5\uc9c0 \uc232\uc5d0 \uc11c\uc2dd\ud588\ub358 \uc591\uc11c\ub958\uc758 \uc77c\uc885\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0bc\uc5fd\ucda9\uc740 \uc721\uc0c1 \uc591\uc11c\ub958\uac00 \uc544\ub2c8\ub77c \uace0\uc0dd\ub300 \ubc14\ub2e4\uc5d0\uc11c \ubc88\uc131\ud588\ub358 \ub300\ud45c\uc801\uc778 \ud574\uc591 \uc808\uc9c0\ub3d9\ubb3c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud0dc\ubc31 \uc9c0\uc5ed\uc740 \uc9c0\uc9c8 \uc2dc\ub300 \uc804\uccb4\uc5d0 \uac78\uccd0 \uc628\ub09c\ud55c \uc721\uc9c0 \ud658\uacbd\uc744 \uc720\uc9c0\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc14\ub2e4 \uc0dd\ubb3c \ud654\uc11d\uc758 \uc874\uc7ac\ub294 \ud574\ub2f9 \uc9c0\uc5ed\uc774 \uacfc\uac70\uc5d0 \ubb3c\uc18d(\ubc14\ub2e4)\uc774\uc5c8\uc74c\uc744 \ub098\ud0c0\ub0b4\ubbc0\ub85c \uc5f0\uc18d\uc801\uc778 \uc721\uc9c0 \ud658\uacbd \uc8fc\uc7a5\uc740 \uc633\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e0\uc0dd\ub300 \ub300\uaddc\ubaa8 \ud654\uc0b0 \ud3ed\ubc1c\ub85c \ubc14\ub2e4 \ubc11 \uc9c0\uce35\uc774 \uc628\uc804\ud788 \uc721\uc9c0\ub85c \uc774\uc1a1\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0bc\uc5fd\ucda9 \ud654\uc11d\uc740 \uace0\uc0dd\ub300 \ubc14\ub2e4 \ud1f4\uc801\uce35\uc774 \uc624\ub79c \uc9c0\uac01 \ubcc0\ub3d9\uc744 \uac70\uccd0 \uc735\uae30\ud55c \uacb0\uacfc\uc774\uc9c0 \uc2e0\uc0dd\ub300\uc758 \ub2e8\ubc1c\uc131 \ud654\uc0b0 \ud3ed\ubc1c \ub54c\ubb38\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud654\uc11d\uc774 \ub41c \uc0dd\ubb3c\uc774 \uc0b4\uc544\uc788\uc744 \ub54c \uc8fc\ub85c \uc11c\uc2dd\ud588\ub358 \uc7a5\uc18c\uc640 \ud604\uc7ac \uc9c0\ud615\uc758 \ucc28\uc774\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uace0\uc0dd\ub300 \ub3d9\uc548 \uc77c\uc5b4\ub09c \uc8fc\uc694 \ubcc0\ud654\ub85c \uc633\uc740 \uc124\uba85\ub9cc\uc744 \uace0\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc624\uc874\uce35 \ud615\uc131\uc73c\ub85c \uc0dd\ubb3c\uc758 \uc721\uc0c1 \uc9c4\ucd9c\uc774 \uac00\ub2a5\ud574\uc84c\uace0, \ubc14\ub2e4\uc5d0\ub294 \uc0bc\uc5fd\ucda9\uacfc \uc5b4\ub958\uac00 \ubc88\uc131\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uace0\uc0dd\ub300\uc5d0\ub294 \uc0b0\uc18c \ub18d\ub3c4 \uc99d\uac00\ub85c \uc624\uc874\uce35\uc774 \ub9cc\ub4e4\uc5b4\uc838 \uc790\uc678\uc120\uc774 \ucc28\ub2e8\ub418\uc5c8\uc73c\uba70, \ubc14\ub2e4\uc5d0\uc11c\ub294 \uc0bc\uc5fd\ucda9\uacfc \uc5b4\ub958, \uc721\uc0c1\uc5d0\uc11c\ub294 \uc591\uce58\uc2dd\ubb3c\uacfc \uc591\uc11c\ub958 \ub4f1\uc774 \ubc88\uc131\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc18d\uc528\uc2dd\ubb3c\uc774 \uc9c0\ubc30\uc801\uc778 \uc2dd\ubb3c\uc774 \ub418\uc5c8\uc73c\uba70 \ub9e4\uba38\ub4dc \ub4f1 \ub300\ud615 \ud3ec\uc720\ub958\uac00 \ubc88\uc131\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18d\uc528\uc2dd\ubb3c\uacfc \ub9e4\uba38\ub4dc \ub4f1 \ub300\ud615 \ud3ec\uc720\ub958\uc758 \ubc88\uc131\uc740 \uc2e0\uc0dd\ub300\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud310\uac8c\uc544\uac00 \ubd84\ub9ac\ub418\uba74\uc11c \ud574\uc591 \ubd84\ud3ec\uac00 \ub2e4\uc591\ud574\uc9c0\uace0 \uacf5\ub8e1\uc774 \uc721\uc0c1\uc744 \uc810\ub839\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud310\uac8c\uc544\uac00 \ubd84\ub9ac\ub418\uace0 \uacf5\ub8e1\uc774 \ubc88\uc131\ud55c \uc2dc\uae30\ub294 \uc911\uc0dd\ub300\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ucd5c\ucd08\uc758 \ub2e8\uc138\ud3ec \uc0dd\ubb3c\uacfc \uc5d0\ub514\uc544\uce74\ub77c \uc0dd\ubb3c\uad70\uc774 \ucd9c\ud604\ud558\uc5ec \ubc14\ub2e4\uc5d0 \uc11c\uc2dd\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucd5c\ucd08\uc758 \ub2e8\uc138\ud3ec \uc0dd\ubb3c \ubc0f \uc5d0\ub514\uc544\uce74\ub77c \uc0dd\ubb3c\uad70\uc758 \ucd9c\ud604\uc740 \uc120\uce84\ube0c\ub9ac\uc544\uc2dc\ub300\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc720\ud574 \uc790\uc678\uc120\uc744 \ub9c9\uc544\uc8fc\ub294 \uae30\uccb4\uce35\uc758 \ub4f1\uc7a5\uacfc \uc721\uc0c1 \uc0dd\ud0dc\uacc4\uc758 \uc2dc\uc791 \uc2dc\uae30\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc911\uc0dd\ub300\uc758 \uc0dd\ubb3c\uc0c1 \ubc0f \uc9c0\uad6c \ud658\uacbd\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc721\uc9c0\uc5d0\uc11c\ub294 \uacf5\ub8e1\uc744 \ube44\ub86f\ud55c \ub300\ud615 \ud30c\ucda9\ub958\uc640 \uac89\uc528\uc2dd\ubb3c\uc774 \ud06c\uac8c \ubc88\uc131\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc911\uc0dd\ub300\uc5d0\ub294 \ud30c\ucda9\ub958\uc778 \uacf5\ub8e1\uacfc \uc740\ud589\ub958\u00b7\uc18c\ucca0\ub958 \uac19\uc740 \uac89\uc528\uc2dd\ubb3c\uc774 \uc721\uc0c1 \uc0dd\ud0dc\uacc4\ub97c \uc9c0\ubc30\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ubc14\ub2e4\uc5d0\uc11c\ub294 \ud654\ud3d0\uc11d\uc774 \ud06c\uac8c \ubc88\uc131\ud558\uc5ec \ub300\ud45c\uc801\uc778 \uc9c0\ud45c \ud654\uc11d\uc774 \ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud654\ud3d0\uc11d\uc740 \uc2e0\uc0dd\ub300 \ubc14\ub2e4\uc5d0\uc11c \ubc88\uc131\ud588\ub358 \ub300\ud45c\uc801\uc778 \uc9c0\ud45c \ud654\uc11d\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud769\uc5b4\uc838 \uc788\ub358 \ub300\ub959\ub4e4\uc774 \ud558\ub098\ub85c \ud569\uccd0\uc838 \ucd08\ub300\ub959 \ud310\uac8c\uc544\ub97c \ud615\uc131\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub300\ub959\ub4e4\uc774 \ud569\uccd0\uc838 \ud310\uac8c\uc544\ub97c \uc774\ub8ec \uac83\uc740 \uace0\uc0dd\ub300 \ub9d0\uc774\uba70, \uc911\uc0dd\ub300\uc5d0\ub294 \uc774 \ud310\uac8c\uc544\uac00 \ub2e4\uc2dc \ubd84\ub9ac\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\ud6c4\uac00 \ub9e4\uc6b0 \uae09\ubcc0\ud558\uc5ec \uc8fc\uae30\uc801\uc778 \ube59\ud558\uae30\uc640 \uac04\ube59\uae30\uac00 \ubc18\ubcf5\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube59\ud558\uae30\uc640 \uac04\ube59\uae30\uac00 \ubc18\ubcf5\uc801\uc73c\ub85c \ucc3e\uc544\uc628 \uc2dc\uae30\ub294 \uc2e0\uc0dd\ub300 \ub9d0\uae30\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud30c\ucda9\ub958\uc758 \uc2dc\ub300\ub77c\uace0\ub3c4 \ubd88\ub9ac\ub294 \uc774 \uc2dc\uae30\uc758 \ub300\ud45c \uc0dd\ubb3c\uacfc \uc2dd\ubb3c \uad70\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc2e0\uc0dd\ub300\uc5d0 \uc77c\uc5b4\ub09c \uc0dd\ubb3c\uacc4\uc758 \ubcc0\ud654\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uacf5\ub8e1 \uba78\uc885 \uc774\ud6c4 \ud3ec\uc720\ub958\uac00 \ubc88\uc131\ud558\uc600\uace0, \uaf43\uc744 \ud53c\uc6b0\ub294 \uc18d\uc528\uc2dd\ubb3c\uc774 \uc9c0\ubc30\uc801\uc73c\ub85c \ubcc0\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2e0\uc0dd\ub300\uc5d0\ub294 \uacf5\ub8e1\uc758 \ube48\uc790\ub9ac\ub97c \uccb4\uc628 \uc720\uc9c0 \ub2a5\ub825\uc774 \ub6f0\uc5b4\ub09c \ud3ec\uc720\ub958\uac00 \ucc44\uc6e0\uc73c\uba70, \uc870\ub958\uc640 \ud3ec\uc720\ub958\uc758 \ucd9c\ud604\uacfc \ud568\uaed8 \uc18d\uc528\uc2dd\ubb3c\uc774 \ubc88\uc131\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc591\uce58\uc2dd\ubb3c\uc774 \uc218\uc2ed $m$ \ud06c\uae30\ub85c \uc790\ub77c \uc2b5\uc9c0 \uc8fc\ubcc0\uc5d0 \uac70\ub300\ud55c \uc232\uc744 \uc774\ub8e8\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac70\ub300\ud55c \uc591\uce58\uc2dd\ubb3c \uc232\uc758 \ud615\uc131\uc740 \uace0\uc0dd\ub300\uc758 \ub300\ud45c\uc801\uc778 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc2a4\ud2b8\ub85c\ub9c8\ud1a8\ub77c\uc774\ud2b8\uc640 \uc5d0\ub514\uc544\uce74\ub77c \uc0dd\ubb3c\uad70 \ud654\uc11d\uc774 \uc8fc\ub85c \ubc1c\uacac\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ud2b8\ub85c\ub9c8\ud1a8\ub77c\uc774\ud2b8\uc640 \uc5d0\ub514\uc544\uce74\ub77c \uc0dd\ubb3c\uad70\uc740 \uc120\uce84\ube0c\ub9ac\uc544\uc2dc\ub300\uc758 \ud654\uc11d\uc785\ub2c8\ub2e4."
