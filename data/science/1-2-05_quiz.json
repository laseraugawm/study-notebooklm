    {
      "question": "\uc9c0\uad6c \uc2dc\uc2a4\ud15c\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \ubb3c\uc758 \uc21c\ud658 \uacfc\uc815\uacfc \uc5d0\ub108\uc9c0 \ucd9c\uc785\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb3c\uc774 \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uc5ec \uc218\uc99d\uae30\ub85c \ubcc0\ud55c\ub2e4.",
