        {
          "text": "\ub0c9\uc7a5\uace0 \ub0b4\ubd80\uc640 \ubc29\uc5f4\ud310 \ubaa8\ub450\uc5d0\uc11c \ub0c9\ub9e4\uac00 \uc2b9\ud654\ud558\uc5ec \uc5d0\ub108\uc9c0\ub97c \uc5f0\uc18d \ud761\uc218\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub0b4\ubd80\uc5d0\uc11c\ub294 \uc5f4 \ud761\uc218(\uae30\ud654), \uc678\ubd80 \ubc29\uc5f4\ud310\uc5d0\uc11c\ub294 \uc5f4 \ubc29\ucd9c(\uc561\ud654)\uc774 \uc77c\uc5b4\ub0a9\ub2c8\ub2e4."
        }
