        {
          "text": "\ub0c9\uc7a5\uace0 \ub0b4\ubd80\uc5d0\uc11c \ub0c9\ub9e4\uac00 \uc561\ud654\ud558\uba70 \uc5f4\uc744 \ud761\uc218\ud558\uace0, \ubc29\uc5f4\ud310\uc5d0\uc11c \uae30\ud654\ud558\uba70 \uc5f4\uc744 \ubc29\ucd9c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc561\ud654\ud560 \ub54c\ub294 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uace0 \uae30\ud654\ud560 \ub54c \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud569\ub2c8\ub2e4."
