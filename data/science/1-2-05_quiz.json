{
  "title": "\ud654\ud559 \uc5d0\ub108\uc9c0 \ud034\uc988",
  "questions": [
    {
      "question": "\ubc1c\uc5f4 \uc6a9\uae30\uc5d0 \uc0ac\uc6a9\ub418\ub294 \ubc1c\uc5f4 \ud329\uc758 \uc8fc\uc131\ubd84\uc778 \uc0b0\ud654 \uce7c\uc298($\\text{CaO}$)\uc774 \ubb3c\uacfc \ubc18\uc751\ud560 \ub54c \uc77c\uc5b4\ub098\ub294 \ud604\uc0c1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc8fc\ubcc0\uc5d0\uc11c \uc5f4\uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc5ec \ube44\ucee4 \uc548\uc758 \uc628\ub3c4\uac00 \ub0b4\ub824\uac04\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5f4\uc744 \ud761\uc218\ud558\ub294 \ud604\uc0c1\uc740 \uc8fc\ubcc0 \uc628\ub3c4\ub97c \ub0ae\ucd94\uc9c0\ub9cc, \uc0b0\ud654 \uce7c\uc298\uacfc \ubb3c\uc758 \ubc18\uc751\uc740 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\ub294 \ubc18\uc751\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ud654\ud559 \ubc18\uc751\uc774 \uc77c\uc5b4\ub098\uba74\uc11c \uc5f4\uc744 \ubc29\ucd9c\ud558\uc5ec \uc8fc\ubcc0 \uc628\ub3c4\uac00 \ub192\uc544\uc9c4\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0b0\ud654 \uce7c\uc298\uacfc \ubb3c\uc774 \ubc18\uc751\ud558\uba74 \ud654\ud559 \ubcc0\ud654\uac00 \uc77c\uc5b4\ub098\uba74\uc11c \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uc5ec \uc8fc\ubcc0 \uc628\ub3c4\uac00 \uc0c1\uc2b9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0c1\ud0dc \ubcc0\ud654\uac00 \uc77c\uc5b4\ub098\uba74\uc11c \uc5d0\ub108\uc9c0\uc758 \ucd9c\uc785\uc774 \uc804\ud600 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0c8\ub85c\uc6b4 \ubb3c\uc9c8\uc774 \uc0dd\uc131\ub418\ub294 \ud654\ud559 \ubcc0\ud654\uc774\uba70, \uc5d0\ub108\uc9c0 \ucd9c\uc785\uc774 \ud65c\ubc1c\ud558\uac8c \uc77c\uc5b4\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\uccb4\uac00 \ub2e4\ub7c9 \ubc1c\uc0dd\ud558\uba74\uc11c \uc8fc\ubcc0\uc758 \uc5d0\ub108\uc9c0\ub97c \ube7c\uc557\uc544 \ucc28\uac00\uc6cc\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\ud654 \uce7c\uc298\uacfc \ubb3c\uc758 \ubc18\uc751\uc740 \uc5f4\uc744 \ubc29\ucd9c\ud558\uc5ec \ub530\ub73b\ud558\uac8c \ub9cc\ub4dc\ub294 \ubc18\uc751\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubc1c\uc5f4 \ud329\uc740 \uac00\uc5f4 \uc7a5\uce58 \uc5c6\uc774 \uc74c\uc2dd\uc744 \ub370\uc6b0\uac70\ub098 \uc775\ud790 \ub54c \uc0ac\uc6a9\ub418\ub294 \ub3c4\uad6c\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\ubb3c\uacfc \uc0b0\ud654 \uce7c\uc298\uc744 \uc774\uc6a9\ud574 \uac00\uc5f4 \uc7a5\uce58 \uc5c6\uc774 \uc74c\uc2dd\uc744 \uc870\ub9ac\ud558\ub294 \uc7a5\uce58\ub97c \uc124\uacc4\ud560 \ub54c \uc8fc\uc758\ud574\uc57c \ud560 \uc0ac\ud56d\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0b0\ud654 \uce7c\uc298 \uac00\ub8e8\uac00 \ub9ce\uc774 \ub0a0\ub9b4 \uc218 \uc788\uc73c\ubbc0\ub85c \ub9c8\uc2a4\ud06c\ub97c \ucc29\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\ud654 \uce7c\uc298 \ubd84\ub9d0 \ud761\uc785\uc744 \ub9c9\uae30 \uc704\ud574 \ub9c8\uc2a4\ud06c \ucc29\uc6a9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubc18\uc751 \uc2dc \uc5f4\uc774 \ubc1c\uc0dd\ud558\ubbc0\ub85c \uc548\uc804\uc744 \uc704\ud574 \ubcf4\ud638 \uc7a5\uac11\uc744 \ucc29\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc18\uc751 \uacfc\uc815\uc5d0\uc11c \ub192\uc740 \uc5f4\uc774 \ubc1c\uc0dd\ud558\ubbc0\ub85c \ud654\uc0c1 \uc608\ubc29\uc744 \uc704\ud574 \ubcf4\ud638 \uc7a5\uac11\uc744 \ucc29\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc870\ub9ac \uc6a9\uae30\ub85c \uc54c\ub8e8\ubbf8\ub284\ubc15\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5f4\uc804\ub2ec \ud6a8\uc728\uc744 \ucd5c\ub300\ub85c \ub192\uc778\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc54c\ub8e8\ubbf8\ub284\ubc15\uc740 \ubc18\uc751 \ud6c4 \uc0dd\uc131\ub418\ub294 \uc0b0\ud654 \uce7c\uc298 \uc218\uc6a9\uc561\uacfc \ubc18\uc751\ud558\uc5ec \uc190\uc0c1\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc544\uc57c \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e4\ud5d8 \ud6c4 \ub0a8\uc740 \uc218\uc6a9\uc561\uc740 \uc9c0\uc815\ub41c \ud3d0\uc218 \ud1b5\uc5d0 \ubc84\ub9b0\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e4\ud5d8 \ud3d0\uae30\ubb3c\uc740 \ud658\uacbd \uc548\uc804\uc744 \uc704\ud574 \uc801\uc808\ud55c \ud3d0\uc218 \ud1b5\uc5d0 \ubc84\ub824\uc57c \ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud2b9\uc815 \uae08\uc18d \uc7ac\uc9c8\uc740 \uc0b0\ud654 \uce7c\uc298 \uc218\uc6a9\uc561\uacfc \ubc18\uc751\ud558\uc5ec \ubd80\uc2dd\ub418\uac70\ub098 \uc190\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
    },
    {
      "question": "\ub2e4\uc74c \uc911 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uc5ec \uc8fc\ubcc0\uc758 \uc628\ub3c4\ub97c \ub192\uc774\ub294 \ud604\uc0c1\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucca0 \uac00\ub8e8\uac00 \uc0b0\uc18c\uc640 \ubc18\uc751\ud558\uc5ec \ub530\ub73b\ud574\uc9c0\ub294 \uc190\ub09c\ub85c",
          "isCorrect": false,
          "rationale": "\ucca0\uc758 \uc0b0\ud654 \ubc18\uc751\uc740 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uc5ec \uc8fc\ubcc0 \uc628\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0b0\uacfc \uc5fc\uae30\uac00 \ubc18\uc751\ud558\ub294 \uc911\ud654 \ubc18\uc751",
          "isCorrect": false,
          "rationale": "\uc0b0\uacfc \uc5fc\uae30\uc758 \uc911\ud654 \ubc18\uc751\uc740 \uc5f4(\uc911\ud654\uc5f4)\uc744 \ubc29\ucd9c\ud558\ub294 \ub300\ud45c\uc801\uc778 \ubc1c\uc5f4 \ubc18\uc751\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub0c9\uac01 \ud329 \uc18d\uc758 \ubb3c\uc9c8\uc774 \ubc18\uc751\ud558\uc5ec \uc2dc\uc6d0\ud574\uc9c0\ub294 \ud604\uc0c1",
          "isCorrect": true,
          "rationale": "\ub0c9\uac01 \ud329 \ub0b4\ubd80\uc758 \ubc18\uc751\uc740 \uc8fc\ubcc0\uc5d0\uc11c \uc5f4\uc744 \ud761\uc218\ud558\uc5ec \uc628\ub3c4\ub97c \ub0ae\ucd94\ub294 \ud761\uc5f4 \ubc18\uc751\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ub3c4\uc2dc\uac00\uc2a4 \ub4f1\uc758 \uc5f0\ub8cc\ub97c \uc5f0\uc18c\uc2dc\ucf1c \uc694\ub9ac\uc5d0 \uc774\uc6a9\ud558\ub294 \ud604\uc0c1",
          "isCorrect": false,
          "rationale": "\uc5f0\ub8cc\uc758 \uc5f0\uc18c \ubc18\uc751\uc740 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uc5ec \uc8fc\ubcc0 \uc628\ub3c4\ub97c \uc62c\ub9bd\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc81c\ud488\uc758 \uc0ac\uc6a9 \ubaa9\uc801\uc774 \uc8fc\ubcc0 \uc628\ub3c4\ub97c \ucc28\uac11\uac8c \ub0b4\ub9ac\ub294 \uac83\uc778\uc9c0 \uc0dd\uac01\ud574\ubcf4\uc138\uc694."
    },
    {
      "question": "\uc0dd\ubb3c\uccb4 \ub0b4\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \uc138\ud3ec\ud638\ud761\uacfc \uad11\ud569\uc131\uc5d0\uc11c\uc758 \uc5d0\ub108\uc9c0 \ucd9c\uc785\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc138\ud3ec\ud638\ud761\uc740 \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\ub294 \ubc18\uc751\uc774\uace0, \uad11\ud569\uc131\uc740 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\ub294 \ubc18\uc751\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc138\ud3ec\ud638\ud761\uc740 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uace0 \uad11\ud569\uc131\uc740 \ube5b\uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\ud3ec\ud638\ud761\uacfc \uad11\ud569\uc131 \ubaa8\ub450 \uc8fc\ubcc0\uc73c\ub85c \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uc5ec \uccb4\uc628\uc744 \uc720\uc9c0\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad11\ud569\uc131\uc740 \ud0dc\uc591\uc758 \ube5b\uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc5ec \uc591\ubd84\uc744 \ud569\uc131\ud558\ub294 \uacfc\uc815\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc138\ud3ec\ud638\ud761\uc740 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\ub294 \ubc18\uc751\uc774\uace0, \uad11\ud569\uc131\uc740 \ube5b\uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\ub294 \ubc18\uc751\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub9c8\uc774\ud1a0\ucf58\ub4dc\ub9ac\uc544\uc758 \uc138\ud3ec\ud638\ud761\uc740 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uc5ec \uc0dd\uba85 \ud65c\ub3d9\uc5d0 \uc0ac\uc6a9\ub418\uba70, \uc5fd\ub85d\uccb4\uc758 \uad11\ud569\uc131\uc740 \ube5b\uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc5ec \uc591\ubd84\uc744 \ub9cc\ub4ed\ub2c8\ub2e4."
        },
        {
          "text": "\uad11\ud569\uc131 \uc2dc \ubc29\ucd9c\ub41c \uc5d0\ub108\uc9c0\ub97c \uc774\uc6a9\ud574 \ub3d9\ubb3c\uc774 \uccb4\uc628\uc744 \uc720\uc9c0\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uccb4\uc628 \uc720\uc9c0\uc5d0 \uc0ac\uc6a9\ub418\ub294 \uc5d0\ub108\uc9c0\ub294 \uc138\ud3ec\ud638\ud761\uc744 \ud1b5\ud574 \ubc29\ucd9c\ub418\ub294 \uc5d0\ub108\uc9c0\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc2dd\ubb3c\uc774 \uc591\ubd84\uc744 \ub9cc\ub4e4\uae30 \uc704\ud574 \ud0dc\uc591\uc73c\ub85c\ubd80\ud130 \uc5b4\ub5a4 \uc5d0\ub108\uc9c0\ub97c \uc774\uc6a9\ud558\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub0c9\uc7a5\uace0\uac00 \ub0b4\ubd80\ub97c \ucc28\uac11\uac8c \uc720\uc9c0\ud558\uace0 \ub4a4\ucabd \ubc29\uc5f4\ud310\uc5d0\uc11c \uc5f4\uc744 \ub0b4\ubcf4\ub0b4\ub294 \uc6d0\ub9ac\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub0c9\uc7a5\uace0 \ub0b4\ubd80\uc5d0\uc11c \ub0c9\ub9e4\uac00 \uae30\ud654\ud558\uba70 \uc5f4\uc744 \ud761\uc218\ud558\uace0, \ubc29\uc5f4\ud310\uc5d0\uc11c \uc561\ud654\ud558\uba70 \uc5f4\uc744 \ubc29\ucd9c\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc561\uccb4 \ub0c9\ub9e4\uac00 \uae30\ud654\ud560 \ub54c \uc8fc\ubcc0 \uc5f4\uc744 \ud761\uc218\ud574 \ub0b4\ubd80 \uc628\ub3c4\ub97c \ub0ae\ucd94\uace0, \uae30\uccb4 \ub0c9\ub9e4\uac00 \ubc29\uc5f4\ud310\uc5d0\uc11c \uc561\ud654\ud560 \ub54c \uc5f4\uc744 \ubc29\ucd9c\ud569\ub2c8\ub2e4."
