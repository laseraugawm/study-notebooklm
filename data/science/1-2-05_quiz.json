        {
          "text": "\ub0c9\uc7a5\uace0 \ub0b4\ubd80\uc5d0\uc11c \ub0c9\ub9e4\uac00 \uc735\ud574\ub418\uba70 \uc5f4\uc744 \ubc29\ucd9c\ud558\uace0, \ubc29\uc5f4\ud310\uc5d0\uc11c \uc751\uace0\ub418\uba70 \uc5f4\uc744 \ud761\uc218\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub0c9\uc7a5\uace0 \ub0c9\ub9e4\uc758 \uc8fc\ub41c \uc0c1\ud0dc \ubcc0\ud654 \uc21c\ud658\uc740 \uae30\ud654\uc640 \uc561\ud654 \ud604\uc0c1\uc785\ub2c8\ub2e4."
