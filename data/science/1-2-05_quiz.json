        {
          "text": "\ubb3c\uc740 \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc5ec \uae30\ud654\ud558\uace0, \uc218\uc99d\uae30\ub294 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uba70 \uc561\ud654\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc9c0\ud45c\uba74\uc758 \ubb3c\uc740 \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc5ec \uc218\uc99d\uae30\ub85c \uae30\ud654\ud558\uace0, \ub300\uae30 \uc911 \uc218\uc99d\uae30\ub294 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uba70 \uc561\ud654\ud574 \uad6c\ub984\uc744 \ud615\uc131\ud569\ub2c8\ub2e4."
