{
  "title": "\uc9c0\uad6c\uacfc\ud559 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc9c0\uad6c\ub85c \ub4e4\uc5b4\uc624\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc758 \uc591\uc744 100\uc774\ub77c\uace0 \ud560 \ub54c, \uc9c0\uad6c\uc758 \uc5f4\uc218\uc9c0\uc640 \ubcf5\uc0ac \ud3c9\ud615\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\uad6c\uc5d0 \ud761\uc218\ub41c \uc57d 70\uc758 \uc5d0\ub108\uc9c0\ub294 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc758 \ud615\ud0dc\ub85c \uc6b0\uc8fc \uacf5\uac04\uc73c\ub85c \ubc29\ucd9c\ub418\uc5b4 \ubcf5\uc0ac \ud3c9\ud615\uc744 \uc774\ub8ec\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc9c0\uad6c\ub294 \ubcf5\uc0ac \ud3c9\ud615\uc744 \uc774\ub8e8\uace0 \uc788\uc73c\ubbc0\ub85c \uc9c0\ud45c\uc640 \ub300\uae30\uc5d0 \ud761\uc218\ub41c \uc5d0\ub108\uc9c0\ub9cc\ud07c(\uc57d 70)\uc744 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0 \ud615\ud0dc\ub85c \uc6b0\uc8fc\ub85c \ubc29\ucd9c\ud558\uc5ec \ud3c9\uade0 \uae30\uc628\uc744 \uc77c\uc815\ud558\uac8c \uc720\uc9c0\ud55c\ub2e4."
        },
        {
          "text": "\ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0 100 \uc911 \uc57d 70\uc740 \ub300\uae30\uc640 \uc9c0\ud45c\uc5d0\uc11c \ubc18\uc0ac\ub418\uc5b4 \uc6b0\uc8fc\ub85c \uace7\ubc14\ub85c \ub418\ub3cc\uc544\uac04\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc18\uc0ac\ub418\uc5b4 \uc6b0\uc8fc\ub85c \ub418\ub3cc\uc544\uac00\ub294 \uc5d0\ub108\uc9c0\ub294 \uc57d 30\uc774\uba70, \uc9c0\ud45c\uc640 \ub300\uae30\uc5d0 \ud761\uc218\ub418\ub294 \uc5d0\ub108\uc9c0\uac00 \uc57d 70\uc774\ub2e4."
        },
        {
          "text": "\ubcf5\uc0ac \ud3c9\ud615 \uc0c1\ud0dc\uc5d0\uc11c\ub294 \uc9c0\ud45c\uac00 \ubc29\ucd9c\ud558\ub294 \uc5d0\ub108\uc9c0\uc591\uacfc \ub300\uae30\uac00 \ud761\uc218\ud558\ub294 \uc5d0\ub108\uc9c0\uc591\uc774 \uc644\uc804\ud788 0\uc774 \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcf5\uc0ac \ud3c9\ud615\uc740 \ud761\uc218\ud55c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc591\uacfc \ubc29\ucd9c\ud55c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc591\uc774 \uac19\uc544 \uc5f4\uc218\uc9c0 \ucc28\uc774\uac00 0\uc778 \uc0c1\ud0dc\ub97c \uc758\ubbf8\ud558\uba70, \uc5d0\ub108\uc9c0 \uad50\ud658 \uc591 \uc790\uccb4\uac00 0\uc784\uc744 \ub73b\ud558\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\uc9c0\uad6c\ub294 \ub9c9\ub300\ud55c \uc591\uc758 \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub97c \ub9e4\uc77c \uc0c8\ub85c \ubc1b\uae30 \ub54c\ubb38\uc5d0 \uc624\ub79c \uc2dc\uac04\uc5d0 \uac78\uccd0 \ud3c9\uade0 \uae30\uc628\uc774 \uacc4\uc18d \uc0c1\uc2b9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uad6c\ub294 \ubc29\ucd9c\ud558\ub294 \uc5d0\ub108\uc9c0\uc591\uacfc \ud761\uc218\ud558\ub294 \uc5d0\ub108\uc9c0\uc591\uc774 \uac19\uc740 \ubcf5\uc0ac \ud3c9\ud615 \uc0c1\ud0dc\ub97c \uc624\ub79c \uae30\uac04 \uc720\uc9c0\ud574 \uc654\uae30 \ub54c\ubb38\uc5d0 \ud3c9\uade0 \uae30\uc628\uc774 \uc77c\uc815\ud558\uac8c \uc720\uc9c0\ub41c\ub2e4."
        }
      ],
      "hint": "\uc9c0\uad6c\ub85c \ub4e4\uc5b4\uc624\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0 \uc911 \ubc18\uc0ac\ub418\ub294 \ube44\uc728\uacfc \ud761\uc218\ub418\uc5b4 \uc6b0\uc8fc\ub85c \uc7ac\ubc29\ucd9c\ub418\ub294 \ube44\uc728\uc758 \uad00\uacc4\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc9c0\uad6c\uc640 \ub2ec\uc740 \ud0dc\uc591\uc73c\ub85c\ubd80\ud130\uc758 \uac70\ub9ac\uac00 \uac70\uc758 \ube44\uc2b7\ud568\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0, \uc9c0\uad6c\uc758 \ud3c9\uade0 \uae30\uc628\uc774 \ub2ec\ubcf4\ub2e4 \ud6e8\uc52c \ub192\uac8c \uc720\uc9c0\ub418\ub294 \uc9c1\uc811\uc801\uc778 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc9c0\uad6c\uc758 \ub300\uae30\uac00 \uc9c0\ud45c\uc5d0\uc11c \ubc29\ucd9c\ub41c \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud55c \ud6c4 \uc9c0\ud45c\ub85c \ub2e4\uc2dc \ubc29\ucd9c\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub2ec\uc740 \ub300\uae30\uac00 \uc5c6\uc5b4 \uc628\uc2e4 \ud6a8\uacfc\uac00 \uc77c\uc5b4\ub098\uc9c0 \uc54a\uc9c0\ub9cc, \uc9c0\uad6c\ub294 \ub300\uae30\uac00 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc5ec \uc9c0\ud45c\ub85c \uc7ac\ubc29\ucd9c\ud568\uc73c\ub85c\uc368 \ud3c9\uade0 \uae30\uc628\uc744 \ub192\uac8c \uc720\uc9c0\ud55c\ub2e4."
        },
        {
          "text": "\uc9c0\uad6c\uac00 \ub2ec\uc5d0 \ube44\ud574 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ub2e8\uc704 \uba74\uc801\ub2f9 \ud6e8\uc52c \ub354 \ub9ce\uc774 \ud761\uc218\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uad6c\uc640 \ub2ec\uc740 \ud0dc\uc591\uacfc\uc758 \uac70\ub9ac\uac00 \uac70\uc758 \uac19\uc544 \ub2e8\uc704 \uba74\uc801\ub2f9 \ubc1b\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc758 \uc591\uc740 \ube44\uc2b7\ud558\ub2e4."
        },
        {
          "text": "\uc9c0\uad6c\uc758 \ub300\uae30\uac00 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ub300\ubd80\ubd84 \ubc18\uc0ac\uc2dc\ucf1c \uc9c0\ud45c\uc5d0 \uac07\ud788\uac8c \ub9cc\ub4e4\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub300\uae30\uac00 \ud0dc\uc591 \ubcf5\uc0ac\ub97c \ubc18\uc0ac\ud558\ub294 \uac83\uc740 \uae30\uc628\uc744 \ub0ae\ucd94\ub294 \uc694\uc778\uc774\uba70, \uc9c0\uad6c\uac00 \ub2ec\ubcf4\ub2e4 \ub192\uc740 \uae30\uc628\uc744 \uc720\uc9c0\ud558\ub294 \uac83\uc740 \ub300\uae30\uc758 \uc628\uc2e4 \ud6a8\uacfc \ub54c\ubb38\uc774\ub2e4."
        },
        {
          "text": "\ub2ec\uc740 \ud45c\uba74\uc5d0\uc11c \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uc9c0 \uc54a\uace0 \ubaa8\ub450 \ub0b4\ubd80\ub85c \ud761\uc218\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2ec\ub3c4 \ud45c\uba74\uc5d0\uc11c \ud761\uc218\ud55c \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0 \ud615\ud0dc\ub85c \uc6b0\uc8fc\ub85c \ubc29\ucd9c\ud558\uba70 \ubcf5\uc0ac \ud3c9\ud615\uc744 \uc774\ub8ec\ub2e4."
        }
      ],
      "hint": "\ub300\uae30\uac00 \uc9c0\ud45c\uc5d0\uc11c \ubc29\ucd9c\ub418\ub294 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud558\uc5ec \ubcf4\uc628 \uc791\uc6a9\uc744 \ud558\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub300\uae30 \uc911 \uc628\uc2e4 \uae30\uccb4\uc640 \uc628\uc2e4 \ud6a8\uacfc\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\ub9cc\uc744 \ubcf4\uae30\uc5d0\uc11c \uace0\ub978 \uac83\uc740?\n\n\u3131. \uc628\uc2e4 \uae30\uccb4\ub294 \uc8fc\ub85c \ud30c\uc7a5\uc774 \uc9e7\uc740 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \uc798 \ud761\uc218\ud55c\ub2e4.\n\u3134. \uc218\uc99d\uae30, \uc774\uc0b0\ud654 \ud0c4\uc18c, \uba54\ud14c\uc778 \ub4f1\uc774 \ub300\ud45c\uc801\uc778 \uc628\uc2e4 \uae30\uccb4\uc5d0 \ud574\ub2f9\ud55c\ub2e4.\n\u3137. \uc628\uc2e4 \ud6a8\uacfc \ub355\ubd84\uc5d0 \uc9c0\uad6c\ub294 \ub300\uae30\uac00 \uc5c6\uc744 \ub54c\ubcf4\ub2e4 \ub354 \ub192\uc740 \uc628\ub3c4\uc5d0\uc11c \ubcf5\uc0ac \ud3c9\ud615\uc5d0 \ub3c4\ub2ec\ud55c\ub2e4.",
      "answerOptions": [
        {
          "text": "\u3134, \u3137",
          "isCorrect": true,
          "rationale": "\uc218\uc99d\uae30, \uc774\uc0b0\ud654 \ud0c4\uc18c, \uba54\ud14c\uc778 \ub4f1\uc740 \ub300\ud45c\uc801\uc778 \uc628\uc2e4 \uae30\uccb4\uc774\uba70, \uc774\ub4e4 \ub355\ubd84\uc5d0 \uc9c0\uad6c\ub294 \ub300\uae30\uac00 \uc5c6\uc744 \ub54c\ubcf4\ub2e4 \ub192\uc740 \uc628\ub3c4\uc5d0\uc11c \ubcf5\uc0ac \ud3c9\ud615\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\ub2e4."
        },
        {
          "text": "\u3131, \u3134",
          "isCorrect": false,
          "rationale": "\uc628\uc2e4 \uae30\uccb4\ub294 \ud30c\uc7a5\uc774 \uc9e7\uc740 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uac00 \uc544\ub2c8\ub77c \ud30c\uc7a5\uc774 \uae34 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \uc798 \ud761\uc218\ud55c\ub2e4."
        },
        {
          "text": "\u3131, \u3137",
          "isCorrect": false,
          "rationale": "\uc628\uc2e4 \uae30\uccb4\ub294 \ud30c\uc7a5\uc774 \uc9e7\uc740 \ud0dc\uc591 \ubcf5\uc0ac\ub97c \ud1b5\uacfc\uc2dc\ud0a4\uace0, \ud30c\uc7a5\uc774 \uae34 \uc9c0\uad6c \ubcf5\uc0ac\ub97c \uc8fc\ub85c \ud761\uc218\ud55c\ub2e4."
        },
        {
          "text": "\u3131, \u3134, \u3137",
          "isCorrect": false,
          "rationale": "\u3131 \ud56d\ubaa9\uc740 \uc628\uc2e4 \uae30\uccb4\uc758 \ud30c\uc7a5\ubcc4 \ud761\uc218 \ud2b9\uc131\uc744 \uc798\ubabb \uc124\uba85\ud558\uace0 \uc788\ub2e4."
        }
      ],
      "hint": "\uc628\uc2e4 \uae30\uccb4\uac00 \uc798 \ud761\uc218\ud558\ub294 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uac00 \ud0dc\uc591 \ubcf5\uc0ac\uc778\uc9c0 \uc9c0\uad6c \ubcf5\uc0ac\uc778\uc9c0 \uadf8 \ud30c\uc7a5 \ud2b9\uc131\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc0b0\uc5c5\ud601\uba85 \uc774\ud6c4 \ud654\uc11d \uc5f0\ub8cc\uc758 \uc0ac\uc6a9\ub7c9\uc774 \ub298\uc5b4 \ub300\uae30 \uc911 \uc628\uc2e4 \uae30\uccb4\uac00 \uc99d\uac00\ud588\uc744 \ub54c, \ucd08\uae30 \uc9c0\uad6c\uc758 \uc5f4\uc218\uc9c0 \ubcc0\ud654\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc6b0\uc8fc\ub85c \ube60\uc838\ub098\uac00\ub294 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc758 \uc591\uc774 \uac10\uc18c\ud558\uc5ec \uc5d0\ub108\uc9c0\uac00 \ucd95\uc801\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc628\uc2e4 \uae30\uccb4\uac00 \ub298\uc5b4\ub098\uba74 \ub300\uae30\uac00 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ub354 \ub9ce\uc774 \ud761\uc218\ud558\uc5ec \uc9c0\ud45c\ub85c \uc7ac\ubc29\ucd9c\ud558\ubbc0\ub85c, \ucd08\uae30\uc5d0 \uc6b0\uc8fc\ub85c \ube60\uc838\ub098\uac00\ub294 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc591\uc774 \uc904\uc5b4\ub4e0\ub2e4."
        },
        {
          "text": "\ud0dc\uc591\uc5d0\uc11c \uc9c0\uad6c\ub85c \ub4e4\uc5b4\uc624\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc758 \uc808\ub300\ub7c9\uc774 \uae09\uaca9\ud788 \uc99d\uac00\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub300\uae30 \uc911 \uc628\uc2e4 \uae30\uccb4 \ub18d\ub3c4 \uc99d\uac00\ub294 \ud0dc\uc591 \uc790\uccb4\uc5d0\uc11c \ubc29\ucd9c\ub418\uc5b4 \uc9c0\uad6c\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc758 \uc591\uc744 \uc9c1\uc811 \ub298\ub9ac\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\ub300\uae30\uc640 \uc9c0\ud45c\uba74\uc5d0\uc11c \ubc18\uc0ac\ub418\uc5b4 \uc6b0\uc8fc\ub85c \ub418\ub3cc\uc544\uac00\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc591\uc774 \uc99d\uac00\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc628\uc2e4 \uae30\uccb4 \uc99d\uac00\ub294 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uace0 \uc9c0\ud45c\ub85c \uc7ac\ubc29\ucd9c\ud558\ub294 \ud6a8\uacfc\ub97c \uac15\ud654\ud558\uba70, \ud0dc\uc591 \ubcf5\uc0ac\uc758 \ubc18\uc0ac\uc728\uc744 \uc9c1\uc811 \ub192\uc774\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\ub300\uae30\uac00 \ud761\uc218\ud588\ub358 \uc5d0\ub108\uc9c0\ub97c \uc9c0\ud45c\ub85c \ub2e4\uc2dc \ubc29\ucd9c\ud558\ub294 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc591\uc774 \uc904\uc5b4\ub4e0\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc628\uc2e4 \uae30\uccb4\uac00 \uc99d\uac00\ud558\uba74 \ub300\uae30\uac00 \uc9c0\ud45c\ub85c \uc7ac\ubc29\ucd9c\ud558\ub294 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc591\uc774 \ub298\uc5b4\ub098 \uc9c0\ud45c \uc628\ub3c4\uac00 \uc0c1\uc2b9\ud55c\ub2e4."
        }
      ],
      "hint": "\uc628\uc2e4 \uae30\uccb4\uac00 \ub300\uae30 \uc911\uc5d0 \ub9ce\uc544\uc9c0\uba74 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uac00 \uc6b0\uc8fc\ub85c \ube60\uc838\ub098\uac00\ub294 \uacfc\uc815\uc5d0 \uc5b4\ub5a4 \ubcc0\ud654\uac00 \uc0dd\uae38\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc9c0\uad6c \uc628\ub09c\ud654\uac00 \uc9c4\ud589\ub418\uba74\uc11c \uc77c\uc5b4\ub098\ub294 \ub2e4\uc591\ud55c \uc0c1\ud638\uc791\uc6a9\uacfc \ubcc0\ud654\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ube59\ud558\uac00 \ub179\uc73c\uba74 \uc9c0\ud45c\uc5d0\uc11c \ubc18\uc0ac\ub418\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc591\uc774 \uac10\uc18c\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ube59\ud558\ub294 \ud0dc\uc591 \ube5b\uc744 \uc798 \ubc18\uc0ac\ud558\ub294\ub370, \uc628\ub09c\ud654\ub85c \ube59\ud558\uac00 \ub179\uc73c\uba74 \ubc18\uc0ac\uc728\uc774 \uc904\uc5b4\ub4e4\uc5b4 \uc9c0\ud45c\uac00 \ud761\uc218\ud558\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uac00 \uc99d\uac00\ud55c\ub2e4."
        },
        {
          "text": "\uc9c0\ud45c\uc758 \uc628\ub3c4\uac00 \uc0c1\uc2b9\ud558\uba74 \uc9c0\ud45c\uac00 \ubc29\ucd9c\ud558\ub294 \uc9c0\uad6c \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc591\uc740 \uac10\uc18c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubb3c\uccb4\ub294 \uc628\ub3c4\uac00 \ub192\uc544\uc9c8\uc218\ub85d \ubc29\ucd9c\ud558\ub294 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uc758 \uc591\uc774 \uc99d\uac00\ud558\ubbc0\ub85c \uc9c0\ud45c\uc758 \ubc29\ucd9c \uc5d0\ub108\uc9c0\ub7c9\uc740 \ub298\uc5b4\ub09c\ub2e4."
        },
        {
          "text": "\uc9c0\uad6c \uc628\ub09c\ud654\uac00 \uac00\uc5f4\ub418\uba74 \uc9c0\uad6c\ub294 \ub2e4\uc2dc\ub294 \ubcf5\uc0ac \ud3c9\ud615\uc744 \uc774\ub8e8\uc9c0 \ubabb\ud558\uace0 \uc628\ub3c4\uac00 \ubb34\ud55c\ud788 \uc62c\ub77c\uac04\ub2e4.",
          "isCorrect": false,
