      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub9c8\uc874 \uc5f4\ub300\uc6b0\ub9bc \ud30c\uad34\uac00 \uc9c0\uad6c \uc804\uccb4 \ud658\uacbd \ubc0f \uae30\ud6c4\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5 \uc870\uc0ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub2e4\ub85c \uc720\uc785\ub41c \ud50c\ub77c\uc2a4\ud2f1 \uc4f0\ub808\uae30\uac00 \ud574\uc591 \ub3d9\ubb3c\uc5d0\uac8c \ubbf8\uce58\ub294 \ub300\ud45c\uc801\uc778 \uc0dd\uccb4\uc801 \ud53c\ud574 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
