{
  "title": "\uc0dd\ud0dc\uacc4 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\uc790\uc5d0\uc11c\ubd80\ud130 \ucd5c\uc885\uc18c\ube44\uc790\uae4c\uc9c0 \uba39\uace0 \uba39\ud788\ub294 \uc0ac\uc2ac \ud615\ud0dc\uc758 \uba39\uc774 \uad00\uacc4\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba39\uc774\uc0ac\uc2ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ec\ub7ec \uac1c\uccb4\uad70\uc774 \ud568\uaed8 \uc11c\uc2dd\ud558\ub294 \uad70\uc9d1\uc5d0\uc11c \uc5ec\ub7ec \uba39\uc774\uc0ac\uc2ac\uc774 \ubcf5\uc7a1\ud558\uac8c \uc5bd\ud600 \uc788\ub294 \uba39\uc774 \uad00\uacc4 \ud615\ud0dc\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba39\uc774\uadf8\ubb3c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\uc790\uac00 \uad11\ud569\uc131\uc744 \ud1b5\ud574 \ud569\uc131\ud55c \uc591\ubd84\uc774 \uc4f0\uc774\ub294 \uc8fc\uc694 \uacfc\uc815 4\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\ud3ec\ud638\ud761, \uc0dd\uc7a5\ub7c9, \ub099\uc5fd\ub7c9, \uc18c\ube44\uc790\uc5d0\uac8c \uba39\ud798"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\uc790\uac00 \uad11\ud569\uc131\uc73c\ub85c \ub9cc\ub4e0 \uc591\ubd84 \uc911 \uac00\uc7a5 \ub192\uc740 \ube44\uc728\ub85c \uc0ac\uc6a9\ub418\ub294 \uacf3\uc740 \uc5b4\ub514\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\ud3ec\ud638\ud761 (\uc0dd\uba85\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \uc4f0\uc784)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\ud559\uc5d0\uc11c '\uc0dd\ubb3c\ub7c9(Biomass)'\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc815\ud55c \ud06c\uae30\uc758 \uc9c0\uc5ed\uc5d0 \uc11c\uc2dd\ud558\ub294 \uc0dd\ubb3c\uc758 \ucd1d\uc911\ub7c9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc548\uc815\ub41c \uc0dd\ud0dc\uacc4\uc5d0\uc11c \ud558\uc704 \uc601\uc591\ub2e8\uacc4\uc5d0\uc11c \uc0c1\uc704 \uc601\uc591\ub2e8\uacc4\ub85c \uac08\uc218\ub85d \uc904\uc5b4\ub4dc\ub294 \uc0c1\ub300\uc801 \uc218\uce58 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uccb4\uc218, \uc5d0\ub108\uc9c0\uc591, \uc0dd\ubb3c\ub7c9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uc601\uc591\ub2e8\uacc4\uc758 \uac1c\uccb4\uc218, \uc5d0\ub108\uc9c0\uc591, \uc0dd\ubb3c\ub7c9\uc758 \uc0c1\ub300\uc801\uc778 \uc591\uc744 \ud558\uc704 \uc601\uc591\ub2e8\uacc4\ubd80\ud130 \ucc28\ub840\ub85c \uc313\uc544 \uc62c\ub9b0 \ud615\ud0dc\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud0dc\ud53c\ub77c\ubbf8\ub4dc"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud0dc\uacc4\ub97c \uc774\ub8e8\ub294 \uc0dd\ubb3c\uc758 \uc885\ub958, \uac1c\uccb4\uc218, \ubb3c\uc9c8\uc758 \uc591 \ub4f1\uc774 \uc548\uc815\uc801\uc73c\ub85c \uc720\uc9c0\ub418\uc5b4 \uade0\ud615\uc744 \uc774\ub8e8\ub294 \uc0c1\ud0dc\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud0dc\uacc4\ud3c9\ud615"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc548\uc815\ub41c \uc0dd\ud0dc\uacc4\uc5d0\uc11c \uc77c\uc2dc\uc801\uc73c\ub85c 1\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \uc99d\uac00\ud558\uba74 \uc0dd\uc0b0\uc790\uc758 \uac1c\uccb4\uc218\ub294 \uc5b4\ub5bb\uac8c \ubcc0\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\ucc28 \uc18c\ube44\uc790\uc758 \ud3ec\uc2dd\ub7c9\uc774 \ub298\uc5b4\ub098 \uc0dd\uc0b0\uc790\uc758 \uac1c\uccb4\uc218\uac00 \uac10\uc18c\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc548\uc815\ub41c \uc0dd\ud0dc\uacc4\uc5d0\uc11c \uc77c\uc2dc\uc801\uc73c\ub85c 1\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \uc99d\uac00\ud558\uba74 2\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\ub294 \uc5b4\ub5bb\uac8c \ubcc0\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba39\uc774(1\ucc28 \uc18c\ube44\uc790)\uac00 \ud48d\ubd80\ud574\uc838 2\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \uc99d\uac00\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\ucc28 \uc18c\ube44\uc790\uac00 \uc99d\uac00\ud55c \ud6c4, \uc0dd\uc0b0\uc790\uac00 \uac10\uc18c\ud558\uace0 2\ucc28 \uc18c\ube44\uc790\uac00 \uc99d\uac00\ud558\uba74 \uadf8 \ub2e4\uc74c 1\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\ub294 \uc5b4\ub5bb\uac8c \uc870\uc808\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba39\uc774(\uc0dd\uc0b0\uc790) \ubd80\uc871\uacfc \ud53c\uc2dd\ub7c9(2\ucc28 \uc18c\ube44\uc790\uc758 \ud3ec\uc2dd) \uc99d\uac00\ub85c \uc778\ud574 1\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \uac10\uc18c\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218\uac00 \ub2e4\uc2dc \uac10\uc18c\ud558\uba74, \uc774\uc5d0 \ub530\ub978 \uc0dd\uc0b0\uc790\uc640 2\ucc28 \uc18c\ube44\uc790\uc758 \uac1c\uccb4\uc218 \ubcc0\ud654\ub294 \uac01\uac01 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\uc790\ub294 \uac1c\uccb4\uc218\uac00 \uc99d\uac00\ud558\uace0, 2\ucc28 \uc18c\ube44\uc790\ub294 \uba39\uc774 \uac10\uc18c\ub85c \uac1c\uccb4\uc218\uac00 \uac10\uc18c\ud558\uc5ec \uc0dd\ud0dc\uacc4\ud3c9\ud615\uc744 \ud68c\ubcf5\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1\ucc28 \uc18c\ube44\uc790\uc778 \ucd08\uc2dd\ub3d9\ubb3c\uc774 \uae09\uc99d\ud55c \uace0\ub871\uace0\uc0ac \uad6d\ub9bd\uacf5\uc6d0\uc758 \uc0dd\ud0dc\uacc4\ub97c \ud68c\ubcf5\uc2dc\ud0a4\uae30 \uc704\ud574 \ub3c4\uc785\ud55c 2\ucc28 \uc18c\ube44\uc790\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ud504\ub9ac\uce74\ub4e4\uac1c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\ub871\uace0\uc0ac \uad6d\ub9bd\uacf5\uc6d0\uc5d0 \uc544\ud504\ub9ac\uce74\ub4e4\uac1c\ub97c \ub3c4\uc785\ud55c \uc9c1\ud6c4 \uc0dd\ud0dc\uacc4 \uac1c\uccb4\uad70 \ud06c\uae30 \ubcc0\ud654 \uc21c\uc11c\ub294 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ud504\ub9ac\uce74\ub4e4\uac1c\uac00 \ucd08\uc2dd\ub3d9\ubb3c(1\ucc28 \uc18c\ube44\uc790)\uc744 \ud3ec\uc2dd\ud558\uc5ec 1\ucc28 \uc18c\ube44\uc790\uac00 \uc904\uc5b4\ub4e4\uace0, \uc774\uc5b4\uc11c \uc0dd\uc0b0\uc790\uc758 \uac1c\uccb4\uc218\uac00 \ub298\uc5b4\ub098 \uc548\uc815 \uc0c1\ud0dc\uac00 \ub418\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud0dc\uacc4\uac00 \uc77c\uc2dc\uc801 \ud658\uacbd \ubcc0\ud654\ub97c \uacaa\uc740 \ud6c4 \uc2a4\uc2a4\ub85c \uc6d0\ub798\uc758 \uc548\uc815\ub41c \uc0c1\ud0dc\ub97c \ud68c\ubcf5\ud558\ub294 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uba39\uace0 \uba39\ud788\ub294 \uc601\uc591\ub2e8\uacc4\uc758 \uad00\uacc4\uc5d0 \ub530\ub77c \uc5f0\uacb0\ub41c \uac1c\uccb4\uad70\ub4e4\uc758 \uc218\uac00 \uc5f0\uc1c4\uc801\uc73c\ub85c \uc870\uc808\ub418\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud0dc\uacc4\ud3c9\ud615\uc744 \uae68\ub728\ub9b4 \uc218 \uc788\ub294 '\uc790\uc5f0\uc801 \ud658\uacbd \ubcc0\ud654'\uc758 \uc6d0\uc778 \uc608\uc2dc 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc9c4, \ud654\uc0b0 \ubd84\ucd9c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub9c8\uc874 \uc5f4\ub300\uc6b0\ub9bc\uc774 \ube60\ub978 \uc18d\ub3c4\ub85c \ud30c\uad34\ub418\ub294 \ub300\ud45c\uc801\uc778 \uc778\uc704\uc801 \ud65c\ub3d9 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc7a5\uc2dd \ucd95\uc0b0\uc5c5\uc73c\ub85c \uc778\ud55c \ub300\uaddc\ubaa8 \ubc8c\ubaa9 \ubc0f \ubc29\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub9c8\uc874 \uc5f4\ub300\uc6b0\ub9bc \ud30c\uad34 \uc601\ud5a5 \uc870\uc0ac \uc2dc '\uc0dd\ud0dc\ud559\uc790'\uc758 \ud575\uc2ec \uc870\uc0ac \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uaddc\ubaa8 \ubc8c\ubaa9\uc774 \uc0dd\ubb3c\ub2e4\uc591\uc131\uc5d0 \uc601\ud5a5\uc744 \uc8fc\ub294 \uad6c\uccb4\uc801\uc778 \uc0ac\ub840 \uc870\uc0ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub9c8\uc874 \uc5f4\ub300\uc6b0\ub9bc \ud30c\uad34 \uc601\ud5a5 \uc870\uc0ac \uc2dc '\ud658\uacbd\uacf5\ud559\uc790'\uc758 \ud575\uc2ec \uc870\uc0ac \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uc7a5\uc2dd \ucd95\uc0b0\uc5c5\uc774 \uc8fc\ubcc0 \ud658\uacbd\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5 \uc870\uc0ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub9c8\uc874 \uc5f4\ub300\uc6b0\ub9bc \ud30c\uad34 \uc601\ud5a5 \uc870\uc0ac \uc2dc '\uc9c0\uad6c\uacfc\ud559\uc790'\uc758 \ud575\uc2ec \uc870\uc0ac \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
