      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\ud3ec\uc758 \uae30\ub2a5 \ubcc0\ud654, \ubc88\uc2dd \uc5b5\uc81c, \uc0ac\ub9dd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc591 \uc0dd\ud0dc\uacc4\uc5d0\uc11c \ud50c\ub77c\uc2a4\ud2f1\uc744 \uc12d\ucde8\ud558\ub294 \uc0dd\ubb3c\uc758 \ubc94\uc704\ub294 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud50c\ub791\ud06c\ud1a4\ubd80\ud130 \uba39\uc774\uc0ac\uc2ac\uc758 \ucd5c\uc0c1\uc704 \ud3ec\uc2dd\uc790\uae4c\uc9c0 \uc804 \uc601\uc591\ub2e8\uacc4 \uc0dd\ubb3c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1991\ub144 \ud544\ub9ac\ud540 \ud53c\ub098\ud22c\ubcf4 \ud654\uc0b0 \ud3ed\ubc1c \ub2f9\uc2dc \uc131\uce35\uad8c\uae4c\uc9c0 \ub3c4\ub2ec\ud558\uc5ec \ud0dc\uc591 \ubcf5\uc0ac\ub97c \ubc18\uc0ac\ud55c \uc8fc\uc694 \ubb3c\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc0b0\ud654 \ud669(\uc57d 2000\ub9cc \ud1a4)\uacfc \ud654\uc0b0\uc7ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1991\ub144 \ud53c\ub098\ud22c\ubcf4 \ud654\uc0b0 \ubd84\ucd9c\ub85c \uc778\ud574 \uc131\uce35\uad8c\uc5d0 \ub3c4\ub2ec\ud55c \ud654\uc0b0\uc7ac\uc640 \uc774\uc0b0\ud654 \ud669\uc774 \uc2dd\ubb3c\uacfc \uc9c0\uad6c \ud3c9\uade0 \uae30\uc628\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591 \ubcf5\uc0ac \ubc18\uc0ac\ub85c \uc2dd\ubb3c\uc758 \uad11\ud569\uc131\ub7c9\uc774 \uac10\uc18c\ud558\uace0, 2\ub144 \ub3d9\uc548 \uc9c0\uad6c \ud3c9\uade0 \uae30\uc628\uc774 \uc57d $0.5\\ ^{\\circ}\\text{C}$ \ub0ae\uc544\uc84c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud0dc\uacc4\uc758 \ubcf5\uc6d0 \ud55c\uacc4\ub97c \ub118\uc5b4\uc11c\ub294 \ud658\uacbd \ubcc0\ud654\uac00 \uc77c\uc5b4\ub098 \uc0dd\ud0dc\uacc4\ud3c9\ud615\uc774 \ud30c\uad34\ub418\uba74 \uc5b4\ub5a4 \uacb0\uacfc\uac00 \ubc1c\uc0dd\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
