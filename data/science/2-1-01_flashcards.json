    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uaf43\uacfc \uac19\uc740 \uc218\uc0dd\uc2dd\ubb3c\uc5d0\uc11c \ubc1c\ub2ec\ud55c \ud1b5\uae30\uc870\uc9c1\uc758 \uae30\ub2a5 \ub450 \uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \uc0b0\uc18c\uc640 \uc774\uc0b0\ud654 \ud0c4\uc18c\ub97c \uc6a9\uc774\ud558\uac8c \uad50\ud658\ud55c\ub2e4. 2. \uc2dd\ubb3c\uc774 \ubb3c \uc704\uc5d0 \uc798 \ub730 \uc218 \uc788\uac8c \ub3c4\uc640\uc900\ub2e4."
