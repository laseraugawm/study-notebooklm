    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uae30\ub294 \uc0dd\ubb3c\uc758 \ud638\ud761\uc5d0 \ud544\uc694\ud55c _____\uc640 \uad11\ud569\uc131\uc758 \uc6d0\ub8cc\uc778 _____\ub97c \ud3ec\ud568\ud558\uace0 \uc788\ub2e4. \ube48\uce78\uc5d0 \ub4e4\uc5b4\uac08 \uae30\uccb4\ub294?"
