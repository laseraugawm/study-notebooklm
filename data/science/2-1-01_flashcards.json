      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubcfc \uc218 \uc788\ub2e4. \ub113\uc740 \uc9c0\uc5ed\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc5f0\ubabb\uc774\ub098 \uc815\uc6d0\ub3c4 \uc0dd\ubb3c\uc694\uc18c\uc640 \ube44\uc0dd\ubb3c\uc694\uc18c\uac00 \uc601\ud5a5\ub825\uc744 \uc8fc\uace0\ubc1b\ub294 \uc791\uc740 \uaddc\ubaa8\uc758 \uc0dd\ud0dc\uacc4\uc774\ub2e4."
          }
        ]
