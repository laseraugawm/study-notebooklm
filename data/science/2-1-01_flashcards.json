        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud0dc\uacc4 \ub0b4\uc758 \ubaa8\ub4e0 \uc0dd\ubb3c\uc744 \ub73b\ud558\ub294 \uc694\uc18c\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\uc694\uc18c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\uc694\uc18c\ub294 \uc5ed\ud560\uc5d0 \ub530\ub77c \uc5b4\ub5bb\uac8c \uc138 \uac00\uc9c0\ub85c \uad6c\ubd84\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\uc790, \uc18c\ube44\uc790, \ubd84\ud574\uc790"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\uc694\uc18c \uc911 \uc81c\uc8fc\ubc31\uc11c\ud5a5\uc774\ub098 \uc18c\ub098\ubb34\uc640 \uac19\uc774 \uad11\ud569\uc131\uc744 \ud1b5\ud574 \uc720\uae30\ubb3c\uc744 \ud569\uc131\ud558\ub294 \uc0dd\ubb3c\uc740 \uc5b4\ub290 \uadf8\ub8f9\uc5d0 \uc18d\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc0b0\uc790"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\uc694\uc18c \uc911 \uc12c\ud718\ud30c\ub78c\uc0c8\uc640 \uac19\uc774 \ub2e4\ub978 \uc0dd\ubb3c\uc744 \uba39\uc774\ub85c \uc0bc\uc544 \uc601\uc591\ubd84\uc744 \uc5bb\ub294 \uc0dd\ubb3c\uc740 \uc5b4\ub290 \uadf8\ub8f9\uc5d0 \uc18d\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ube44\uc790"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\uc694\uc18c \uc911 \uc8fc\ud669\ub9d0\ubbf8\uc798\ubc84\uc12f\uc774\ub098 \ud1a0\uc591 \uc138\uade0\ucc98\ub7fc \uc0ac\uccb4\ub098 \ubc30\uc124\ubb3c\uc744 \ubd84\ud574\ud558\uc5ec \uc5d0\ub108\uc9c0\ub97c \uc5bb\ub294 \uc0dd\ubb3c\uc740 \uc5b4\ub290 \uadf8\ub8f9\uc5d0 \uc18d\ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ud574\uc790"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube5b, \ubb3c, \uc628\ub3c4, \ud1a0\uc591, \uacf5\uae30\uc640 \uac19\uc740 \uc0dd\ud0dc\uacc4 \ub0b4\uc758 \ubaa8\ub4e0 \ud658\uacbd\uc801 \uc694\uc18c\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc0dd\ubb3c\uc694\uc18c"
