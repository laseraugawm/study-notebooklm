    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad50\uacfc\uc11c\uc5d0 \uc81c\uc2dc\ub41c \ube44\uc0dd\ubb3c\uc694\uc18c\uc758 \uc608\uc2dc 5\uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube5b, \ubb3c, \uc628\ub3c4, \ud1a0\uc591, \uacf5\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf6\uc790\uc648\uc758 \ub098\ubb34\ub4e4\uc774 \ubfcc\ub9ac\ub97c \ub545\uc18d \uae4a\uc774 \ub0b4\ub9ac\uc9c0 \ubabb\ud558\uace0 \ub545 \uc704\ub85c \ub4dc\ub7ec\ub0b4\uba70 \uc790\ub77c\ub294 \uc774\uc720\ub294 \uc5b4\ub5a0\ud55c \ube44\uc0dd\ubb3c\uc694\uc18c \ub54c\ubb38\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud1a0\uc591\uc774 \ucda9\ubd84\ud788 \ubc1c\ub2ec\ud558\uc9c0 \uc54a\uace0 \ub3cc\uacfc \uc554\uc11d\uc774 \ub9ce\uc740 \ud658\uacbd\uc774\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube44\uc0dd\ubb3c\uc694\uc18c\uac00 \uc0dd\ubb3c\uc694\uc18c\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc5b4 \ubab8\uc758 \ud615\ud0dc\ub098 \uc0dd\ud65c \ubc29\uc2dd\uc774 \ubcc0\ud558\ub294 \ud604\uc0c1\uc758 \ub300\ud45c\uc801\uc778 \uc608\uc2dc\ub85c \uacf6\uc790\uc648 \ub098\ubb34\uc758 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubfcc\ub9ac\uac00 \ub545 \uc704\ub85c \ub4dc\ub7ec\ub098 \ub3cc\uc774\ub098 \ubc14\uc704\ub97c \ubd99\uc7a1\uc73c\uba74\uc11c \uc790\ub780\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\ud3ec\uc758 \uc0dd\uba85\ud65c\ub3d9\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \uc8fc\ub294 \ube44\uc0dd\ubb3c\uc694\uc18c\ub85c, \uc0dd\ubb3c\uc758 \uccb4\uc628 \uc720\uc9c0 \ubc0f \uc801\uc751\uacfc \uad00\ub828 \uae4a\uc740 \uc694\uc778\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc628\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc628\uc774 \ub0ae\uc740 \uacf3\uc5d0 \uc0ac\ub294 \ud55c\ub77c\uc1a1\uc774\ud480\uc740 \uccb4\uc628\uc774 \ub0ae\uc544\uc9c0\ub294 \uac83\uc744 \ub9c9\uae30 \uc704\ud574 \uc5b4\ub5a0\ud55c \ud615\ud0dc\uc801 \ud2b9\uc9d5\uc744 \uac00\uc9c0\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc78e\uacfc \uc904\uae30\uc5d0 \ud138\uc774 \ub098 \uc788\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd94\uc6b4 \uc9c0\uc5ed\uc5d0 \uc11c\uc2dd\ud558\ub294 \ud3ec\uc720\ub958\uc77c\uc218\ub85d \ub098\ud0c0\ub098\ub294 \ubab8\uc758 \ud615\ud0dc\uc801 \uc801\uc751 \ud2b9\uc9d5 3\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "1. \ud53c\ud558 \uc9c0\ubc29\uc774 \ubc1c\ub2ec\ud55c\ub2e4. 2. \ubab8 \ud06c\uae30\uac00 \ucee4\uc9c4\ub2e4. 3. \uadc0\uc640 \uac19\uc740 \ub9d0\ub2e8\ubd80\ub294 \uc791\uc544\uc9c4\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd81\uadf9\uc5ec\uc6b0\uc640 \uc0ac\ub9c9\uc5ec\uc6b0 \uc911 \uadc0\uc758 \ud06c\uae30\uac00 \ub354 \uc791\uac8c \uc801\uc751\ud55c \uc0dd\ubb3c\uc740 \ub204\uad6c\uc774\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd81\uadf9\uc5ec\uc6b0 (\ucd94\uc6b4 \ud658\uacbd\uc5d0\uc11c \uc5f4 \ubc29\ucd9c\uc744 \uc904\uc774\uae30 \uc704\ud574 \ub9d0\ub2e8\ubd80\uc778 \uadc0\uac00 \uc791\ub2e4.)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub2e4\ucf54\ub07c\ub9ac\uac00 \ucd94\uc6b4 \ud658\uacbd\uc5d0\uc11c \uc0b4\uc544\ub0a8\uae30 \uc704\ud574 \ubab8\uc5d0 \ub9ce\uc774 \ucd95\uc801\ud558\uace0 \uc788\ub294 \uc131\ubd84\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\ubc29 (\ud53c\ud558 \uc9c0\ubc29)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ubb3c\uc774 \uad11\ud569\uc131\uc744 \ud560 \uc218 \uc788\uac8c \ub9cc\ub4dc\ub294 \uc5d0\ub108\uc9c0\uc6d0\uc774 \ub418\ub294 \ube44\uc0dd\ubb3c\uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube5b(\ube5b\uc758 \uc138\uae30)"
