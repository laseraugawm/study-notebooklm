    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube5b\uc758 \uc138\uae30\uac00 \uac15\ud55c \ud658\uacbd\uc5d0\uc11c \uc8fc\ub85c \uc798 \uc790\ub77c\ub294 \uc2dd\ubb3c\uc758 \uc608\uc2dc \ub450 \uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ub098\ubb34, \uc790\uc791\ub098\ubb34"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube5b\uc758 \uc138\uae30\uac00 \uc57d\ud55c \ud658\uacbd\uc5d0\uc11c\ub3c4 \uc798 \uc790\ub77c\ub294 \uc2dd\ubb3c\uc758 \uc608\uc2dc \ub450 \uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc138\ube44\uc5d0\ub9ac\uc544, \ubcf4\uc2a4\ud134\uace0\uc0ac\ub9ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uba85\uccb4\uc758 \uad6c\uc131 \uc131\ubd84 \uc911 \uac00\uc7a5 \ub9ce\uc740 \uc591\uc744 \ucc28\uc9c0\ud558\uba70 \uc0dd\uba85 \uc720\uc9c0\uc5d0 \ud544\uc218\uc801\uc778 \ube44\uc0dd\ubb3c\uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac74\uc870\ud55c \uc0ac\ub9c9\uc5d0 \uc0ac\ub294 \ub3c4\ub9c8\ubc40 \ub4f1 \ud30c\ucda9\ub958\uc758 \ubab8 \ud45c\uba74 \ud2b9\uc9d5\uacfc \uadf8 \uae30\ub2a5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubab8 \ud45c\uba74\uc774 \ube44\ub298\ub85c \ub36e\uc5ec \uc788\uc5b4 \uccb4\ub0b4 \uc218\ubd84 \uc190\uc2e4\uc744 \uc904\uc5ec\uc900\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc0dd\uc2dd\ubb3c\uc758 \uc78e\uc774\ub098 \uc904\uae30\uc5d0\uc11c \ud761\uc218\ud55c \uacf5\uae30\ub97c \ubfcc\ub9ac \ucabd\uc73c\ub85c \ubcf4\ub0b4 \uc8fc\ub294 \uae34 \ud1b5\ub85c\uc640 \uac19\uc740 \uc870\uc9c1\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud1b5\uae30\uc870\uc9c1"
