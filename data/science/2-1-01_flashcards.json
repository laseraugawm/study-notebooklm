    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \uc911 \uc0dd\ubb3c\uc694\uc18c\uac00 \ube44\uc0dd\ubb3c\uc694\uc18c\uc5d0 \uc601\ud5a5\uc744 \uc900 \uc608\uc2dc\ub9cc\uc744 \ubaa8\ub450 \uace0\ub974\uc2dc\uc624:\n\u3131. \uacf6\uc790\uc648 \ub098\ubb34 \ubfcc\ub9ac\uac00 \ub545 \uc704\ub85c \ub4dc\ub7ec\ub0a8\n\u3134. \uc9c0\ub801\uc774\uac00 \uad74\uc744 \ud30c\uc11c \ud1a0\uc591 \ud1b5\uae30\uc131\uc774 \uc88b\uc544\uc9d0\n\u3137. \uc0bc\ub098\ubb34\uac00 \ud53c\ud1a4\uce58\ub4dc\ub97c \ubd84\ube44\ud574 \uacf5\uae30 \uc131\ubd84\uc774 \ubcc0\ud568\n\u3139. \ud55c\ub77c\uc1a1\uc774\ud480 \uc904\uae30\uc5d0 \ud138\uc774 \ub098 \uccb4\uc628\uc744 \uc720\uc9c0\ud568"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\u3134, \u3137 (\u3131, \u3139\uc740 \ube44\uc0dd\ubb3c\uc694\uc18c\uac00 \uc0dd\ubb3c\uc694\uc18c\uc5d0 \uc601\ud5a5\uc744 \uc900 \uc608\uc784)"
