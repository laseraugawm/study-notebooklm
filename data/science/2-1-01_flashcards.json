{
  "title": "\uc0dd\ud0dc\uacc4 \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc81c\uc8fc\uc5b4\ub85c, \ud654\uc0b0 \ud65c\ub3d9\uc73c\ub85c \ubd84\ucd9c\ub41c \uc6a9\uc554\uc774 \ubd88\uaddc\uce59\ud558\uac8c \uad73\uc5b4 \uc0dd\uae34 \uc554\uc11d \uc9c0\ub300\uc5d0 \ub098\ubb34\uc640 \ub364\ubd88\uc774 \uc790\ub77c \uc774\ub8e8\uc5b4\uc9c4 \uc232\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf6\uc790\uc648"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf6\uc790\uc648\uc5d0 \uc790\uc0dd\ud558\ub294 \uc81c\uc8fc \uace0\uc720 \uc2dd\ubb3c\uc758 \uc608\uc2dc \ub450 \uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc24\uc77c\uc5fd, \uc81c\uc8fc\ubc31\uc11c\ud5a5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf6\uc790\uc648 \uc0dd\ud0dc\uacc4\uc5d0\uc11c \uc0ac\uccb4\ub97c \ubd84\ud574\ud558\uc5ec \uc601\uc591\ubd84\uc744 \uc5bb\uc5b4 \uc0b4\uc544\uac00\ub294 \uc0dd\ubb3c\uc758 \uc608\uc2dc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ud669\ub9d0\ubbf8\uc798\ubc84\uc12f"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc815\ud55c \uc9c0\uc5ed\uc5d0 \uc11c\uc2dd\ud558\ub294 '\uac19\uc740 \uc885\uc758 \uc0dd\ubb3c \ubb34\ub9ac'\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uccb4\uad70"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uc11c\uc2dd\uc9c0 \ub0b4\uc5d0\uc11c \uc5ec\ub7ec \uc885\uc758 \uac1c\uccb4\uad70\uc774 \ubaa8\uc5ec \uc774\ub8e8\ub294 \ubb34\ub9ac\ub97c \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad70\uc9d1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c \uad6c\uc131 \ub2e8\uacc4 \uc911 '\uac1c\uccb4\uad70'\uacfc '\uad70\uc9d1'\uc758 \uac00\uc7a5 \uacb0\uc815\uc801\uc778 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uccb4\uad70\uc740 \ub2e8\uc77c \uc885\uc73c\ub85c \uad6c\uc131\ub418\uace0, \uad70\uc9d1\uc740 \uc5ec\ub7ec \uc885\uc758 \uac1c\uccb4\uad70\uc774 \ubaa8\uc5ec \uad6c\uc131\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uccb4, \uac1c\uccb4\uad70, \uad70\uc9d1\uc744 \ud06c\uae30(\ud3ec\ud568 \uad00\uacc4) \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\uccb4 \u2192 \uac1c\uccb4\uad70 \u2192 \uad70\uc9d1"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc815\ud55c \uacf5\uac04\uc5d0\uc11c \uc790\uc5f0\ud658\uacbd\uacfc \uc0dd\ubb3c\uc774 \ubc00\uc811\ud55c \uad00\uacc4\ub97c \ub9fa\uc73c\uba70 \uc11c\ub85c \uc601\ud5a5\uc744 \uc8fc\uace0\ubc1b\ub294 \uc2dc\uc2a4\ud15c\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud0dc\uacc4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ud0dc\uacc4\ub97c \uad6c\uc131\ud558\ub294 \ub450 \uac00\uc9c0 \ud070 \uc694\uc18c\ub97c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\uc694\uc18c, \ube44\uc0dd\ubb3c\uc694\uc18c"
