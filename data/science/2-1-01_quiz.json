{
  "title": "\uc0dd\ud0dc\uacc4 \ud034\uc988",
  "questions": [
    {
      "question": "\uc0dd\ud0dc\uacc4 \uad6c\uc131 \ub2e8\uc704 \uc911 '\uc77c\uc815\ud55c \uc9c0\uc5ed\uc5d0 \uc11c\uc2dd\ud558\uba70 \uac19\uc740 \uc885\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9c4 \uc0dd\ubb3c \ubb34\ub9ac'\ub97c \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?",
      "answerOptions": [
        {
          "text": "\uac1c\uccb4\uad70",
          "isCorrect": true,
          "rationale": "\uac1c\uccb4\uad70\uc740 \ub3d9\uc77c\ud55c \uc11c\uc2dd\uc9c0\uc5d0 \uc0b4\uace0 \uc788\ub294 \uac19\uc740 \uc885\uc758 \uac1c\uccb4\ub4e4\uc774 \ubaa8\uc5ec \ub9cc\ub4e0 \ubb34\ub9ac\ub97c \ub73b\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uad70\uc9d1",
          "isCorrect": false,
          "rationale": "\uad70\uc9d1\uc740 \ub3d9\uc77c\ud55c \uc11c\uc2dd\uc9c0 \ub0b4\uc5d0 \uc874\uc7ac\ud558\ub294 \uc11c\ub85c \ub2e4\ub978 \uc5ec\ub7ec \uac1c\uccb4\uad70\uc774 \ubaa8\uc5ec \ud615\uc131\ub41c \uc9d1\ub2e8\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\ud0dc\uacc4",
          "isCorrect": false,
          "rationale": "\uc0dd\ud0dc\uacc4\ub294 \uad70\uc9d1\uc744 \uc774\ub8e8\ub294 \uc0dd\ubb3c\uc694\uc18c\uc640 \uadf8\ub97c \ub458\ub7ec\uc2fc \ube44\uc0dd\ubb3c\uc694\uc18c\uac00 \uc11c\ub85c \ubc00\uc811\ud55c \uad00\uacc4\ub97c \ub9fa\uace0 \uc601\ud5a5\uc744 \uc8fc\uace0\ubc1b\ub294 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0\uc790",
          "isCorrect": false,
          "rationale": "\uc0dd\uc0b0\uc790\ub294 \ube5b\uc774\ub098 \ud654\ud559 \uc5d0\ub108\uc9c0\ub97c \uc774\uc6a9\ud574 \uc2a4\uc2a4\ub85c \uc720\uae30\ubb3c\uc744 \ud569\uc131\ud558\ub294 \uc0dd\ubb3c\uc694\uc18c\uc758 \uc601\uc591\uc801 \uc5ed\ud560 \uad6c\ubd84\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ub2e8\uc77c\ud55c \ud55c \uc885(\u7a2e)\uc758 \uac1c\uccb4\ub4e4\ub9cc \ubaa8\uc778 \ubb34\ub9ac \ub2e8\uc704\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uacf6\uc790\uc648 \uc232\uc5d0\uc11c \uc6a9\uc554 \uc9c0\ub300\uc758 \ud2b9\uc131\uc0c1 \ud1a0\uc591\uc774 \ubc1c\ub2ec\ud558\uc9c0 \ubabb\ud55c \ud658\uacbd\uc5d0 \uc801\uc751\ud558\uc5ec \ub098\ud0c0\ub09c \uc2dd\ubb3c\uc758 \uad6c\uc870\uc801 \ud2b9\uc9d5\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub098\ubb34 \ubfcc\ub9ac\uac00 \ub545\uc18d \uae4a\uc774 \ub4e4\uc5b4\uac00\uc9c0 \ubabb\ud558\uace0 \ub545 \uc704\ub85c \ub4dc\ub7ec\ub098 \ub3cc\uc744 \ubd99\uc7a1\uace0 \uc790\ub780\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud1a0\uc591\uc774 \uc595\uac8c \ubc1c\ub2ec\ud55c \uacf6\uc790\uc648 \ud658\uacbd\uc5d0 \uc801\uc751\ud558\uc5ec \ubfcc\ub9ac\uac00 \uc9c0\ud45c\uba74 \uc704\ub85c \ub178\ucd9c\ub418\uace0 \ubc14\uc704\ub098 \ub3cc\uc744 \uac10\uc2f8\uba70 \uc790\ub77c\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc78e\uacfc \uc904\uae30\uc5d0 \ud138\uc774 \ub9ce\uc774 \ubc1c\ub2ec\ud558\uc5ec \uccb4\uc628\uc774 \ub0ae\uc544\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc78e\uacfc \uc904\uae30\uc758 \ud138\uc740 \ud1a0\uc591\uc774 \uc544\ub2cc \uae30\uc628\uc774 \ub0ae\uc740 \uc800\uc628 \ud658\uacbd\uc5d0 \uc801\uc751\ud55c \uc0dd\ubb3c(\ud55c\ub77c\uc1a1\uc774\ud480 \ub4f1)\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc904\uae30\uc640 \ubfcc\ub9ac\uc5d0 \ud1b5\uae30\uc870\uc9c1\uc774 \ud06c\uac8c \ubc1c\ub2ec\ud558\uc5ec \ubb3c \uc704\uc5d0 \uc798 \ub728\ub3c4\ub85d \ub3d5\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud1b5\uae30\uc870\uc9c1\uc758 \ubc1c\ub2ec\uc740 \ubb3c\uc18d\uc5d0 \uc11c\uc2dd\ud558\ub294 \uc218\uc0dd\uc2dd\ubb3c\uc774 \uc9c0\ub2cc \ud658\uacbd \uc801\uc751 \ud615\uc9c8\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc8fc\ubcc0\uc73c\ub85c \ud53c\ud1a4\uce58\ub4dc\ub97c \ub0b4\ubfdc\uc5b4 \ubbf8\uc0dd\ubb3c\uc758 \ud65c\uc131\uc744 \uc5b5\uc81c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud53c\ud1a4\uce58\ub4dc \ubd84\ucd9c\uc740 \ub098\ubb34\uc758 \uc0dd\uba85\ud65c\ub3d9\uc774 \uc8fc\ubcc0 \uacf5\uae30 \ud658\uacbd\uc5d0 \uc601\ud5a5\uc744 \uc8fc\ub294 \uc0dd\ubb3c\uc694\uc18c\uc758 \ubc18\uc791\uc6a9 \uc608\uc2dc\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud1a0\uc591\uc774 \uc595\uace0 \ub2e8\ub2e8\ud55c \uc554\uc11d\uc774 \ub9ce\uc740 \uc9c0\ud615\uc801 \uc694\uc778\uc774 \uc2dd\ubb3c \ubfcc\ub9ac \ud615\uc0c1\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc744 \uace0\ub824\ud558\uc138\uc694."
    },
    {
      "question": "\ucd94\uc6b4 \uc9c0\uc5ed\uc5d0 \uc11c\uc2dd\ud558\ub294 \ud3ec\uc720\ub958\uac00 \ub354\uc6b4 \uc9c0\uc5ed\uc5d0 \uc11c\uc2dd\ud558\ub294 \ud3ec\uc720\ub958\uc640 \ube44\uad50\ud558\uc5ec \uac00\uc9c0\ub294 \uc0dd\ubb3c\ud559\uc801 \ud2b9\uc9d5\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubab8 \ud06c\uae30\uac00 \ucee4\uc9c0\uace0 \ud53c\ud558\uc9c0\ubc29\uc774 \ubc1c\ub2ec\ud558\uba70 \uadc0\uc640 \uac19\uc740 \ub9d0\ub2e8\ubd80\ub294 \uc791\uc544\uc9c4\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucd94\uc6b4 \ud658\uacbd\uc5d0\uc11c\ub294 \uc5f4 \ubc29\ucd9c\uc744 \uc904\uc774\uae30 \uc704\ud574 \ubd80\ud53c \ub300\ube44 \ud45c\uba74\uc801\uc744 \ub0ae\ucd94\ub3c4\ub85d \ubab8\uc9d1\uc744 \ud0a4\uc6b0\uace0 \ub9d0\ub2e8 \ubd80\uc704\ub97c \uc904\uc774\uba70 \uc9c0\ubc29\uce35\uc744 \ub450\uaecd\uac8c \ud615\uc131\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud53c\ud558\uc9c0\ubc29\uce35\uc774 \uc587\uc544\uc9c0\uace0 \ubab8 \uc804\uccb4 \ud06c\uae30\uac00 \uc791\uc544\uc9c0\uba70 \uadc0\uac00 \ub9e4\uc6b0 \ucee4\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \uc5f4 \ubc29\ucd9c\uc744 \uc6d0\ud65c\ud558\uac8c \ud574\uc57c \ud558\ub294 \uc0ac\ub9c9 \ub4f1 \ub354\uc6b4 \ud658\uacbd\uc5d0 \uc801\uc751\ud55c \uc0dd\ubb3c(\uc0ac\ub9c9\uc5ec\uc6b0 \ub4f1)\uc758 \uc2e0\uccb4 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uccb4\uc628 \uc720\uc9c0\ub97c \uc704\ud574 \ubcc0\uc628 \ub3d9\ubb3c\ucc98\ub7fc \uc8fc\ubcc0 \uc628\ub3c4\uc5d0 \ub530\ub77c \ud53c\ud558\uc9c0\ubc29\uc744 \uc2a4\uc2a4\ub85c \ubd84\ud574\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud3ec\uc720\ub958\ub294 \ud56d\uc628\ub3d9\ubb3c\uc774\uba70 \ucd94\uc6b4 \uc9c0\uc5ed\uc77c\uc218\ub85d \ud53c\ud558\uc9c0\ubc29\uc744 \ubc1c\ub2ec\uc2dc\ucf1c \uccb4\uc628\uc744 \ubcf4\uc874\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubab8 \ud45c\uba74\uc744 \ub531\ub531\ud55c \ube44\ub298\ub85c \ub36e\uc5b4 \uccb4\ub0b4 \uc5f4\uacfc \uc218\ubd84 \uc190\uc2e4\uc744 \ub9c9\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube44\ub298 \ub36e\uac1c\ub294 \ud3ec\uc720\ub958\uac00 \uc544\ub2cc \uac74\uc870\ud55c \uc0ac\ub9c9 \ud658\uacbd\uc5d0 \uc801\uc751\ud55c \ud30c\ucda9\ub958(\ub3c4\ub9c8\ubc40 \ub4f1)\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\uccb4\uc628 \ubc29\ucd9c\uc744 \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud55c \ubab8\uc758 \ud06c\uae30, \ub9d0\ub2e8\ubd80(\uadc0)\uc758 \ubaa8\uc591, \uc9c0\ubc29\uce35\uc758 \ubcc0\ud654\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 \uc0dd\ubb3c\uc694\uc18c\uc758 \uc0dd\uba85\ud65c\ub3d9\uc774 \ube44\uc0dd\ubb3c\uc694\uc18c\uc5d0 \uc601\ud5a5\uc744 \uc900 \uc0ac\ub840(\uc0dd\ubb3c -> \ube44\uc0dd\ubb3c)\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\ub801\uc774\uc640 \uac1c\ubbf8 \ub4f1\uc774 \ub545\uc18d\uc5d0\uc11c \uad74\uc744 \ud30c\uc11c \ud1a0\uc591\uc758 \ud1b5\uae30\uc131\uc744 \ub192\uc778\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub545\uc18d \uc0dd\ubb3c\uc758 \uc0dd\uba85\ud65c\ub3d9\uacfc \uad74 \ud30c\uae30 \ud589\ub3d9\uc774 \ud1a0\uc591\uc758 \ud1b5\uae30\uc131 \ubc0f \uc131\ubd84\uc774\ub77c\ub294 \ube44\uc0dd\ubb3c\uc694\uc18c\ub97c \ubcc0\ud654\uc2dc\ud0b5\ub2c8\ub2e4."
        },
        {
          "text": "\ube5b\uc758 \uc138\uae30\uac00 \uac15\ud55c \ud658\uacbd\uc5d0\uc11c \uc18c\ub098\ubb34\uc640 \uc790\uc791\ub098\ubb34\uac00 \uc798 \uc790\ub780\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\ub294 \ube5b\uc774\ub77c\ub294 \ube44\uc0dd\ubb3c \uc694\uc778\uc774 \uc2dd\ubb3c(\uc0dd\ubb3c\uc694\uc18c)\uc758 \uc11c\uc2dd\uacfc \uc131\uc7a5\uc5d0 \uc601\ud5a5\uc744 \uc900 \uc608\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc0ac\ub9c9\uc5d0 \uc11c\uc2dd\ud558\ub294 \ub3c4\ub9c8\ubc40\uc758 \ubab8 \ud45c\uba74\uc774 \ube44\ub298\ub85c \ub36e\uc5ec \uc218\ubd84 \uc190\uc2e4\uc744 \uac10\uc18c\uc2dc\ud0a8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac74\uc870\ud55c \uc218\ubd84 \uc0c1\ud0dc(\ube44\uc0dd\ubb3c\uc694\uc18c)\uc5d0 \uc801\uc751\ud558\uc5ec \ub3c4\ub9c8\ubc40(\uc0dd\ubb3c\uc694\uc18c)\uc758 \uc2e0\uccb4 \ud615\ud0dc\uac00 \ubcc0\ud55c \uc608\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\uc628\uc774 \ub0ae\uc740 \uacf3\uc5d0 \uc0ac\ub294 \ud55c\ub77c\uc1a1\uc774\ud480\uc758 \uc78e\uacfc \uc904\uae30\uc5d0 \ud138\uc774 \ub098 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub0ae\uc740 \uae30\uc628(\ube44\uc0dd\ubb3c\uc694\uc18c)\uc774 \uc0dd\ubb3c\uccb4(\ud55c\ub77c\uc1a1\uc774\ud480)\uc758 \uc2e0\uccb4 \uad6c\uc870\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0dd\ubb3c\uc758 \ud589\ub3d9\uc774\ub098 \ubb3c\uc9c8 \ubc30\ucd9c\ub85c \uc778\ud574 \uc8fc\ubcc0 \ube44\uc0dd\ubb3c \ud658\uacbd(\ud1a0\uc591, \uacf5\uae30 \ub4f1)\uc758 \uc131\uc9c8\uc774 \ubc14\ub00c\ub294 \ud604\uc0c1\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "\uc0dd\ud0dc\uacc4 \uc0dd\ubb3c\uc694\uc18c\uc758 \uc5ed\ud560\uc5d0 \ub530\ub978 \ubd84\ub958\uc640 \ud574\ub2f9 \uc0dd\ubb3c \uc885\uc758 \uc5f0\uacb0\uc774 \uc62c\ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubd84\ud574\uc790 - \uc8fc\ud669\ub9d0\ubbf8\uc798\ubc84\uc12f",
          "isCorrect": true,
          "rationale": "\uc8fc\ud669\ub9d0\ubbf8\uc798\ubc84\uc12f\uc740 \ub2e4\ub978 \uc0dd\ubb3c\uc758 \uc0ac\uccb4\ub098 \ubc30\uc124\ubb3c\uc744 \ubd84\ud574\ud558\uc5ec \uc720\uae30\ubb3c\uc744 \uc5bb\ub294 \ubd84\ud574\uc790\uc5d0 \uc18d\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc0dd\uc0b0\uc790 - \uc12c\ud718\ud30c\ub78c\uc0c8",
          "isCorrect": false,
          "rationale": "\uc12c\ud718\ud30c\ub78c\uc0c8\ub294 \ub2e4\ub978 \uc0dd\ubb3c\uc744 \uba39\uc774\ub85c \uc0bc\uc544 \uc601\uc591\ubd84\uc744 \uc5bb\ub294 \uc18c\ube44\uc790\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\ube44\uc790 - \uc81c\uc8fc\ubc31\uc11c\ud5a5",
          "isCorrect": false,
          "rationale": "\uc81c\uc8fc\ubc31\uc11c\ud5a5\uc740 \uad11\ud569\uc131\uc744 \ud1b5\ud574 \uc2a4\uc2a4\ub85c \uc720\uae30\ubb3c\uc744 \ud569\uc131\ud558\ub294 \uc0dd\uc0b0\uc790\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ubd84\ud574\uc790 - \uc18c\ub098\ubb34",
          "isCorrect": false,
          "rationale": "\uc18c\ub098\ubb34\ub294 \ube5b\uc5d0\ub108\uc9c0\ub97c \uc774\uc6a9\ud574 \uad11\ud569\uc131\uc744 \uc218\ud589\ud558\ub294 \uc0dd\uc0b0\uc790\ub85c \ubd84\ub958\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc0ac\uccb4\ub098 \ubc30\uc124\ubb3c \ub4f1 \uc720\uae30 \ubb3c\uc9c8\uc744 \ubd84\ud574\ud558\uc5ec \uc5d0\ub108\uc9c0\ub97c \ud68d\ub4dd\ud558\ub294 \uc5ed\ud560\uc744 \ub9e1\uc740 \uade0\ub958 \uc0dd\ubb3c\uc744 \uace0\ub974\uc138\uc694."
    },
    {
      "question": "\ube44\uc0dd\ubb3c\uc694\uc18c\uc778 '\ube5b\uc758 \uc138\uae30'\uc5d0 \ub530\ub978 \uc2dd\ubb3c\uc758 \uc801\uc751 \ubc29\uc2dd\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubcf4\uc2a4\ud134\uace0\uc0ac\ub9ac\uc640 \uc0b0\uc138\ube44\uc5d0\ub9ac\uc544\ub294 \ube5b\uc774 \uc57d\ud55c \ud658\uacbd\uc5d0\uc11c\ub3c4 \uc798 \uc11c\uc2dd\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubcf4\uc2a4\ud134\uace0\uc0ac\ub9ac\uc640 \uc0b0\uc138\ube44\uc5d0\ub9ac\uc544\ub294 \uc801\uc740 \uc591\uc758 \ube5b \uc870\uac74\uc5d0\uc11c\ub3c4 \uc0dd\uc874\ud560 \uc218 \uc788\uc5b4 \uc57d\ud55c \ube5b \ud658\uacbd\uc5d0 \uc720\ub9ac\ud558\uac8c \uc801\uc751\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc18c\ub098\ubb34\uc640 \uc790\uc791\ub098\ubb34\ub294 \ud587\ube5b\uc774 \uac70\uc758 \ub4e4\uc9c0 \uc54a\ub294 \uadf8\ub298\uc9c4 \uc232 \ubc11\ubc14\ub2e5\uc5d0\uc11c \uc8fc\ub85c \uc798 \uc790\ub780\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc18c\ub098\ubb34\uc640 \uc790\uc791\ub098\ubb34\ub294 \ube5b\uc758 \uc138\uae30\uac00 \uac15\ud55c \uc591\uc9c0 \ud658\uacbd\uc5d0\uc11c \uc798 \uc790\ub77c\ub294 \ud2b9\uc131\uc744 \uac00\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc2dd\ubb3c\uc740 \uac15\ud55c \ube5b\uc744 \ucb18\uc218\ub85d \uae30\uccb4 \uad50\ud658\uc744 \uc911\ub2e8\ud558\uace0 \ud1b5\uae30\uc870\uc9c1\uc744 \ud615\uc131\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud1b5\uae30\uc870\uc9c1 \ud615\uc131\uc740 \ube5b\uc758 \uc138\uae30\uac00 \uc544\ub2cc \ubb3c\uc18d \ud658\uacbd \uc801\uc751\uacfc \uad00\ub828\ub41c \ud2b9\uc131\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc57d\ud55c \ube5b \ud658\uacbd\uc5d0 \uc801\uc751\ud55c \uc2dd\ubb3c\uc77c\uc218\ub85d \ud53c\ud1a4\uce58\ub4dc\ub97c \ub2e4\ub7c9 \ucd95\uc801\ud558\uc5ec \ubbf8\uc0dd\ubb3c\uc744 \uc81c\uac70\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud53c\ud1a4\uce58\ub4dc\ub294 \ub178\uc1a1\ub098\ubb34 \ub4f1\uc774 \uc8fc\ubcc0 \uacf5\uae30 \uc131\ubd84\uc744 \ubcc0\ud654\uc2dc\ud0a4\ub294 \ubb3c\uc9c8\uc774\uba70 \ube5b \uc138\uae30 \uc801\uc751\uacfc\ub294 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uadf8\ub298\uc9c0\uac70\ub098 \uc57d\ud55c \ube5b \uc870\uac74\uc5d0\uc11c\ub3c4 \uc815\uc0c1\uc801\uc73c\ub85c \uc0dd\uc7a5\ud560 \uc218 \uc788\ub294 \uc2dd\ubb3c \uc885\ub958\ub97c \uae30\uc5b5\ud574 \ubcf4\uc138\uc694."
    },
    {
