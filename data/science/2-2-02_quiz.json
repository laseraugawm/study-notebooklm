{
  "title": "\uc804\uc790\uae30\uc720\ub3c4 \ud034\uc988",
  "questions": [
    {
      "question": "\ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc774 \ubcc0\ud560 \ub54c \ucf54\uc77c\uc5d0 \uc804\ub958\uac00 \ud750\ub974\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?",
      "answerOptions": [
        {
          "text": "\uc804\uc790\uae30 \uc720\ub3c4",
          "isCorrect": true,
          "rationale": "\ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc758 \ubcc0\ud654\uc5d0 \uc758\ud574 \ucf54\uc77c\uc5d0 \uc804\ub958\uac00 \uc720\ub3c4\ub418\ub294 \ud604\uc0c1\uc744 \uc804\uc790\uae30 \uc720\ub3c4\ub77c\uace0 \ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\uc804\uae30 \uc720\ub3c4",
          "isCorrect": false,
          "rationale": "\ub300\uc804\uccb4\ub97c \ub300\uc804\ub418\uc9c0 \uc54a\uc740 \ubb3c\uccb4\uc5d0 \uac00\uae4c\uc774 \ud560 \ub54c \uc804\ud654\uac00 \ubd84\ub9ac\ub418\ub294 \ud604\uc0c1\uc73c\ub85c, \uc790\uae30\uc7a5\uc758 \ubcc0\ud654\uc640\ub294 \uc9c1\uc811\uc801\uc778 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc804\ub958\uc758 \uc790\uae30 \uc791\uc6a9",
          "isCorrect": false,
          "rationale": "\ub3c4\uc120\uc5d0 \uc804\ub958\uac00 \ud750\ub97c \ub54c \uadf8 \uc8fc\ubcc0\uc5d0 \uc790\uae30\uc7a5\uc774 \ud615\uc131\ub418\ub294 \ud604\uc0c1\uc73c\ub85c, \uc804\uc790\uae30 \uc720\ub3c4\uc640\ub294 \ubc18\ub300 \ubc29\ud5a5\uc758 \uc778\uacfc\uad00\uacc4\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\ud654 \ud604\uc0c1",
          "isCorrect": false,
          "rationale": "\uc790\uc11d\uc774 \uc544\ub2cc \ubb3c\uccb4\uac00 \uc790\uc11d\uc758 \uc601\ud5a5\uc744 \ubc1b\uc544 \uc790\uc131\uc744 \ub760\uac8c \ub418\ub294 \ud604\uc0c1\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc790\uc11d\uc758 \uc6b4\ub3d9\uc5d0 \uc758\ud574 \uc790\uae30\uc7a5\uc774 \ubcc0\ud558\uba74\uc11c \uc804\uae30\uac00 \ub9cc\ub4e4\uc5b4\uc9c0\ub294 \ud604\uc0c1\uc785\ub2c8\ub2e4."
    },
    {
      "question": "\ucf54\uc77c\uacfc \ub9c9\ub300\uc790\uc11d\uc744 \uc774\uc6a9\ud574 \uc720\ub3c4 \uc804\ub958\ub97c \ubc1c\uc0dd\uc2dc\ud0a4\ub294 \uc2e4\ud5d8\uc5d0\uc11c, \ucf54\uc77c\uc5d0 \ud750\ub974\ub294 \uc720\ub3c4 \uc804\ub958\uc758 \uc138\uae30\ub97c \ud06c\uac8c \ub9cc\ub4dc\ub294 \ubc29\ubc95\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub9c9\ub300\uc790\uc11d\uacfc \ucf54\uc77c\uc744 \uac19\uc740 \uc18d\ub3c4\uc640 \uac19\uc740 \ubc29\ud5a5\uc73c\ub85c \uc774\ub3d9\uc2dc\ud0a8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc790\uc11d\uacfc \ucf54\uc77c\uc774 \ub3d9\uc77c\ud55c \uc18d\ub3c4\uc640 \ubc29\ud5a5\uc73c\ub85c \uc6c0\uc9c1\uc774\uba74 \uc0c1\ub300\uc801 \uc6b4\ub3d9\uc774 \uc5c6\uc5b4 \ucf54\uc77c \ub0b4\ubd80 \uc790\uae30\uc7a5\uc774 \ubcc0\ud558\uc9c0 \uc54a\uc73c\ubbc0\ub85c \uc720\ub3c4 \uc804\ub958\uac00 \ud750\ub974\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ub9c9\ub300\uc790\uc11d\uc744 \ub354 \ube60\ub974\uac8c \uc6c0\uc9c1\uc778\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc11d\uc744 \ube60\ub974\uac8c \uc6c0\uc9c1\uc77c\uc218\ub85d \ub2e8\uc704 \uc2dc\uac04\ub2f9 \uc790\uae30\uc7a5\uc758 \ubcc0\ud654\uc728\uc774 \ucee4\uc838 \uc720\ub3c4 \uc804\ub958\uac00 \uc138\uc5b4\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uae30\uc7a5\uc774 \ub354 \uc13c \uc790\uc11d\uc744 \uc0ac\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uae30\uc7a5\uc774 \uc13c \uc790\uc11d\uc77c\uc218\ub85d \uc6c0\uc9c1\uc77c \ub54c \ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc758 \ubcc0\ud654\ub7c9\uc774 \uc99d\uac00\ud558\ubbc0\ub85c \uc720\ub3c4 \uc804\ub958\uc758 \uc138\uae30\uac00 \ucee4\uc9d1\ub2c8\ub2e4."
        },
        {
          "text": "\ucf54\uc77c\uc758 \uac10\uc740 \uc218\ub97c \ub298\ub9b0\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucf54\uc77c\uc744 \ub9ce\uc774 \uac10\uc744\uc218\ub85d \uc720\ub3c4\ub418\ub294 \uc804\uc555\uacfc \uc804\ub958\uc758 \uc138\uae30\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ucf54\uc77c \ub0b4\ubd80\ub97c \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc758 \ubcc0\ud654\uc728\uc744 \ub192\uc774\ub294 \uc870\uac74\uc778\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub9c9\ub300\uc790\uc11d\uacfc \ucf54\uc77c\uc744 \ubc30\uce58\ud558\uace0 \uac80\ub958\uacc4\ub97c \uc5f0\uacb0\ud558\uc600\uc744 \ub54c, \uac80\ub958\uacc4\uc758 \ubc14\ub298\uc774 \uc6c0\uc9c1\uc774\uc9c0 \uc54a\ub294(\uc720\ub3c4 \uc804\ub958\uac00 \ud750\ub974\uc9c0 \uc54a\ub294) \uacbd\uc6b0\ub294 \uc5b8\uc81c\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc790\uc11d\uc744 \ucf54\uc77c \uc911\uc2ec\uc5d0 \ub123\uc740 \uc0c1\ud0dc\ub85c \uc815\uc9c0\ud574 \uc788\uc744 \ub54c",
          "isCorrect": true,
          "rationale": "\uc544\ubb34\ub9ac \uc13c \uc790\uc11d\uc774\ub77c\ub3c4 \ucf54\uc77c\uc5d0 \ub300\ud574 \uc815\uc9c0\ud574 \uc788\uc73c\uba74 \ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc5d0 \ubcc0\ud654\uac00 \uc5c6\uc73c\ubbc0\ub85c \uc720\ub3c4 \uc804\ub958\uac00 \ud750\ub974\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc11d\uc744 \uac00\ub9cc\ud788 \ub450\uace0 \ucf54\uc77c\uc744 \uc790\uc11d\uc744 \ud5a5\ud574 \uac00\uae4c\uc774 \uac00\uc838\uac08 \ub54c",
          "isCorrect": false,
          "rationale": "\ucf54\uc77c\uc774 \uc774\ub3d9\ud558\uc5ec \uc790\uc11d\uacfc\uc758 \uc0c1\ub300\uc801 \uc704\uce58\uac00 \ubcc0\ud558\ubbc0\ub85c \uc790\uae30\uc7a5\uc774 \ubcc0\ud558\uc5ec \uc720\ub3c4 \uc804\ub958\uac00 \ud750\ub985\ub2c8\ub2e4."
        },
        {
          "text": "\ucf54\uc77c\uc744 \uac00\ub9cc\ud788 \ub450\uace0 \uc790\uc11d\uc744 \ucf54\uc77c\uc5d0\uc11c \uba40\ub9ac \ub5a8\uc5b4\ub728\ub9b4 \ub54c",
          "isCorrect": false,
          "rationale": "\uc790\uc11d\uc774 \uba40\uc5b4\uc9c0\uba74\uc11c \ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc758 \uc138\uae30\uac00 \uac10\uc18c\ud558\ubbc0\ub85c \uc720\ub3c4 \uc804\ub958\uac00 \ud750\ub985\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc11d\uc758 S\uadf9\uc744 \ucf54\uc77c\uc5d0 \ube60\ub974\uac8c \uac00\uae4c\uc774 \uac00\uc838\uac08 \ub54c",
          "isCorrect": false,
          "rationale": "\uc790\uc11d\uc758 \uadf9 \uc885\ub958\uc5d0 \uc0c1\uad00\uc5c6\uc774 \uc790\uc11d\uc774 \uc6c0\uc9c1\uc5ec \uc790\uae30\uc7a5\uc774 \ubcc0\ud558\uba74 \uc720\ub3c4 \uc804\ub958\uac00 \ud615\uc131\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\ucf54\uc77c \ub0b4\ubd80\ub97c \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc758 \ubcc0\ud654\uac00 \ubc1c\uc0dd\ud558\ub294\uc9c0 \uc5ec\ubd80\ub97c \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc790\uc11d\uc758 N\uadf9\uc744 \ucf54\uc77c\uc5d0 \uac00\uae4c\uc774 \uac00\uc838\uac08 \ub54c\uc640 \uba40\ub9ac \ub5a8\uc5b4\ub728\ub9b4 \ub54c \ub098\ud0c0\ub098\ub294 \ud604\uc0c1\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub450 \uacbd\uc6b0 \uc720\ub3c4 \uc804\ub958\uc758 \ubc29\ud5a5\uc774 \uc11c\ub85c \ubc18\ub300\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "N\uadf9\uc744 \uac00\uae4c\uc774 \ud560 \ub54c \ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc758 \uc138\uae30\ub294 \uc99d\uac00\ud558\uace0, \uba40\ub9ac \ud560 \ub54c\ub294 \uac10\uc18c\ud558\ubbc0\ub85c \uc720\ub3c4 \uc804\ub958\uc758 \ubc29\ud5a5\uc774 \uc11c\ub85c \ubc18\ub300\ub85c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ub450 \uacbd\uc6b0 \ubaa8\ub450 \uc720\ub3c4 \uc804\ub958\uac00 \ud750\ub974\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc11d\uacfc \ucf54\uc77c \uc0ac\uc774\uc5d0 \uc0c1\ub300 \uc6b4\ub3d9\uc774 \uc788\uc73c\ubbc0\ub85c \ub450 \uacbd\uc6b0 \ubaa8\ub450 \uc720\ub3c4 \uc804\ub958\uac00 \uc815\uc0c1\uc801\uc73c\ub85c \ud750\ub985\ub2c8\ub2e4."
        },
        {
          "text": "\ub450 \uacbd\uc6b0 \uc720\ub3c4 \uc804\ub958\uc758 \ubc29\ud5a5\uc774 \ub3d9\uc77c\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc11d\uc758 \uc6b4\ub3d9 \ubc29\ud5a5\uc5d0 \ub530\ub77c \ucf54\uc77c \ub0b4\ubd80 \uc790\uae30\uc7a5\uc758 \ubcc0\ud654 \ubc29\ud5a5\uc774 \ub2ec\ub77c\uc838 \uc720\ub3c4 \uc804\ub958\uc758 \ubc29\ud5a5\ub3c4 \ubc18\ub300\uac00 \ub429\ub2c8\ub2e4."
        },
        {
          "text": "N\uadf9\uc744 \uac00\uae4c\uc774 \ud560 \ub54c\ub9cc \uc804\ub958\uac00 \ud750\ub974\uace0 \uba40\ub9ac \ud560 \ub54c\ub294 \ud750\ub974\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uae30\uc7a5\uc758 \uc138\uae30\uac00 \uc99d\uac00\ud560 \ub54c\ubfd0\ub9cc \uc544\ub2c8\ub77c \uac10\uc18c\ud560 \ub54c\ub3c4 \uc790\uae30\uc7a5\uc758 \ubcc0\ud654\uac00 \uc874\uc7ac\ud558\ub294 \ud55c \uc720\ub3c4 \uc804\ub958\uac00 \ud750\ub985\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc790\uc11d\uc758 \uc774\ub3d9 \ubc29\ud5a5\uc5d0 \ub530\ub978 \ucf54\uc77c \ub0b4\ubd80 \uc790\uae30\uc7a5\uc758 \uc138\uae30 \ubcc0\ud654\ub97c \uace0\ub824\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubc1c\uc804\uae30\uc5d0\uc11c \uc804\uae30\ub97c \uc0dd\uc0b0\ud560 \ub54c \uc77c\uc5b4\ub098\ub294 \uc8fc\uc694 \uc5d0\ub108\uc9c0 \uc804\ud658 \uacfc\uc815\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc6b4\ub3d9 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc804\uae30 \uc5d0\ub108\uc9c0",
          "isCorrect": true,
          "rationale": "\ubc1c\uc804\uae30\ub294 \ud68c\uc804\ucd95\uc744 \ub3cc\ub9ac\ub294 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub97c \uc804\uc790\uae30 \uc720\ub3c4 \ud604\uc0c1\uc744 \ud1b5\ud574 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud654\ud559 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc804\uae30 \uc5d0\ub108\uc9c0",
          "isCorrect": false,
          "rationale": "\ud654\ud559 \ubb3c\uc9c8\uc758 \ubc18\uc751\uc744 \uc774\uc6a9\ud574 \uc804\uae30\ub97c \uc0dd\uc0b0\ud558\ub294 \uac83\uc740 \ud654\ud559 \uc804\uc9c0(\ubc30\ud130\ub9ac)\uc758 \uc791\ub3d9 \uc6d0\ub9ac\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ube5b \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc804\uae30 \uc5d0\ub108\uc9c0",
          "isCorrect": false,
          "rationale": "\ube5b\uc744 \ubc1b\uc544 \uc804\uae30\ub97c \uc0dd\uc0b0\ud558\ub294 \uac83\uc740 \ud0dc\uc591 \uc804\uc9c0(\uad11\uc804 \ud6a8\uacfc)\uc758 \uc6d0\ub9ac\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc804\uae30 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc6b4\ub3d9 \uc5d0\ub108\uc9c0",
          "isCorrect": false,
          "rationale": "\uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc0ac\uc6a9\ud574 \ud68c\uc804\ub825\uc744 \uc5bb\ub294 \uac83\uc740 \ubc1c\uc804\uae30\uac00 \uc544\ub2c8\ub77c \uc804\ub3d9\uae30(\ubaa8\ud130)\uc758 \uc6d0\ub9ac\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud130\ube48\uc774\ub098 \uc790\uc11d\uc758 \ud68c\uc804 \uc6c0\uc9c1\uc784\uc774 \ubb34\uc5c7\uc73c\ub85c \ubc14\ub00c\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubc1c\uc804\uc18c\uc758 \ubc1c\uc804\uae30 \uad6c\uc870\uc640 \uc804\uae30 \uc0dd\uc0b0 \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ucf54\uc77c \ub0b4\ubd80\uc5d0\uc11c \uc790\uc11d\uc774 \ud68c\uc804\ud558\uba74 \uc790\uc11d\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \uc99d\uac00\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\ubbc0\ub85c, \ud68c\uc804\ud558\ub294 \uc790\uc11d\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub294 \uac10\uc18c\ud558\uac8c \ub429\ub2c8\ub2e4."
        },
        {
          "text": "\ubc1c\uc804\uae30\uc758 \ubc14\uae65\ucabd\uc5d0\ub294 \ucf54\uc77c\uc774 \uace0\uc815\ub418\uc5b4 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc77c\ubc18\uc801\uc778 \ubc1c\uc804\uc18c \ubc1c\uc804\uae30\ub294 \uace0\uc815\ub41c \ucf54\uc77c\uacfc \uadf8 \ub0b4\ubd80\uc5d0\uc11c \ud68c\uc804\ud558\ub294 \uc790\uc11d\uc73c\ub85c \uad6c\uc131\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud130\ube48\uc774 \ud68c\uc804\ud558\uba74 \ud130\ube48\uacfc \uc5f0\uacb0\ub41c \uc790\uc11d\uc774 \ud568\uaed8 \ud68c\uc804\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud130\ube48\uc758 \ud68c\uc804\ucd95\uc774 \ubc1c\uc804\uae30 \ub0b4\ubd80 \uc790\uc11d\uacfc \uc5f0\uacb0\ub418\uc5b4 \uc788\uc73c\ubbc0\ub85c \ud130\ube48\uc774 \ub3cc\uba74 \uc790\uc11d\ub3c4 \ud568\uaed8 \ud68c\uc804\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ubb3c\uc774\ub098 \uc99d\uae30\uc758 \ud750\ub984\uc744 \uc774\uc6a9\ud574 \ud130\ube48\uc744 \ud68c\uc804\uc2dc\ud0a8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\ub825\uc774\ub098 \ud654\ub825 \ubc1c\uc804 \ub4f1\uc5d0\uc11c\ub294 \uc720\uccb4\uc758 \uc5d0\ub108\uc9c0\ub97c \uc774\uc6a9\ud574 \ud130\ube48\uc744 \ud68c\uc804\uc2dc\ucf1c \uc5ed\ud559\uc801 \uc5d0\ub108\uc9c0\ub97c \uc5bb\uc2b5\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc5d0\ub108\uc9c0 \uc804\ud658\uc774 \uc77c\uc5b4\ub0a0 \ub54c \uae30\uc874 \uc5d0\ub108\uc9c0\uc758 \uc591\uc774 \uc5b4\ub5bb\uac8c \ub418\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ubc1c\uc804\uc18c\uc5d0\uc11c \uc9c0\uc18d\uc801\uc73c\ub85c \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc0dd\uc0b0\ud558\uae30 \uc704\ud574 \uc790\uc11d\uc744 \uacc4\uc18d \ub3cc\ub824\uc8fc\uc5b4\uc57c \ud558\ub294 \uc774\uc720\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc11d\uc774 \ud68c\uc804\ud558\uba74\uc11c \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\uc5b4 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \uac10\uc18c\ud558\uae30 \ub54c\ubb38\uc5d0",
          "isCorrect": true,
          "rationale": "\uc5d0\ub108\uc9c0 \ubcf4\uc874 \ubc95\uce59\uc5d0 \uc758\ud574 \uc790\uc11d\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\uba74\uc11c \uac10\uc18c\ud558\ubbc0\ub85c \uc678\ubd80\uc5d0\uc11c \uc9c0\uc18d\ud574\uc11c \ud68c\uc804\ub825\uc744 \uacf5\uae09\ud574\uc57c \ud569\ub2c8\ub2e4."
