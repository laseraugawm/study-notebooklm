      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\ub9ac\uc904 \ud45c\uba74\uc758 \uc0b0\ud654\ubb3c\uc774\ub098 \ubd88\uc21c\ubb3c\uc744 \uc81c\uac70\ud558\uae30 \uc704\ud558\uc5ec"
