        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc790\uc758 \uc774\ub3d9 \uad00\uc810\uc5d0\uc11c \ud658\uc6d0\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
