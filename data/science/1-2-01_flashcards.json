    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\ub9ac\uc904\uc744 \uc9c8\uc0b0 \uc740 \uc218\uc6a9\uc561\uc5d0 \ub123\uc5c8\uc744 \ub54c \uad6c\ub9ac\uc904 \ud45c\uba74\uc5d0 \uc5b4\ub5a4 \ubcc0\ud654\uac00 \uad00\ucc30\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc740 \uc774\uc628($Ag^+$)\uc774 \uc804\uc790\ub97c \uc5bb\uc5b4 \uae08\uc18d \uc740($Ag$)\uc73c\ub85c \uc11d\ucd9c\ub418\uc5b4 \uad6c\ub9ac\uc904 \ud45c\uba74\uc5d0 \ub2ec\ub77c\ubd99\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\ub9ac($Cu$)\uc640 \uc740 \uc774\uc628($Ag^+$)\uc758 \uc0b0\ud654\u00b7\ud658\uc6d0 \ubc18\uc751\uc744 \ub098\ud0c0\ub0b8 \uc804\uccb4 \uc54c\uc9dc \uc774\uc628 \ubc18\uc751\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$Cu + 2Ag^+ \\rightarrow Cu^{2+} + 2Ag$"
