    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\ub9ac \uc6d0\uc790 1\uac1c\uac00 \ubc18\uc751\ud560 \ub54c \uc11d\ucd9c\ub418\ub294 \uc740 \uc6d0\uc790\uc758 \uc218\ub294 \uba87 \uac1c\uc778\uac00?"
