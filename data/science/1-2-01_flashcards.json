        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\ub9ac($Cu$)\uac00 \uc804\uc790\ub97c \uc783\uace0 \uad6c\ub9ac \uc774\uc628($Cu^{2+}$)\uc774 \ub418\uc5b4 \uc218\uc6a9\uc561\uc5d0 \ub179\uc544\ub4e4\uc5b4\uac00\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
