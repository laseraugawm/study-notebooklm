    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\ub9ac\uc904\uc744 \uc9c8\uc0b0 \uc740 \uc218\uc6a9\uc561\uc5d0 \ub123\uc5c8\uc744 \ub54c \uc6a9\uc561 \uc18d \uc804\uccb4 \uc591\uc774\uc628 \uc218\uc758 \ubcc0\ud654\ub294 \uc5b4\ub5a0\ud55c\uac00?"
