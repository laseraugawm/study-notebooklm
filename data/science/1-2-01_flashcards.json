    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucca0($Fe$)\uc774 \uacf5\uae30 \uc911\uc5d0\uc11c \ub179\uc2ac\uc5b4 \uc0b0\ud654 \ucca0(III)($Fe_2O_3$)\uc774 \ub418\ub294 \ud654\ud559 \ubc18\uc751\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
