      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\uc0c9\uc5d0\uc11c \uc810\uc810 \ud478\ub978\uc0c9\uc73c\ub85c \ubcc0\ud55c\ub2e4."
