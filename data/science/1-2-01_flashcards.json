    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uae30 \uc911 \uc0b0\uc18c \ub18d\ub3c4\uac00 \uc99d\uac00\ud558\uba74\uc11c \ud615\uc131\ub418\uc5b4, \ud0dc\uc591\uc758 \uc790\uc678\uc120\uc744 \ucc28\ub2e8\ud568\uc73c\ub85c\uc368 \uc0dd\ubb3c\uc758 \uc721\uc0c1 \uc9c4\ucd9c\uc744 \uac00\ub2a5\ud558\uac8c \ud55c \uae30\uccb4\uce35\uc740 \ubb34\uc5c7\uc778\uac00?"
