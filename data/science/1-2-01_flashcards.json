    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \ubc18\uc751\uacfc \ud658\uc6d0 \ubc18\uc751\uc774 \ud654\ud559 \ubc18\uc751 \uacfc\uc815\uc5d0\uc11c \ud56d\uc0c1 \ud568\uaed8 \uc77c\uc5b4\ub098\ub294 \uc131\uc9c8\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654\u00b7\ud658\uc6d0 \ubc18\uc751\uc758 \ub3d9\uc2dc\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac80\uc740\uc0c9\uc758 \uc0b0\ud654 \uad6c\ub9ac(II)($CuO$) \uac00\ub8e8\ub97c \uc22f\uac00\ub8e8(\ud0c4\uc18c, $C$)\uc640 \ud568\uaed8 \uac00\uc5f4\ud560 \ub54c \uc77c\uc5b4\ub098\ub294 \ud654\ud559 \ubc18\uc751\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$2CuO + C \\rightarrow 2Cu + CO_2$"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \uad6c\ub9ac(II)\uc640 \ud0c4\uc18c\uc758 \ubc18\uc751($2CuO + C \\rightarrow 2Cu + CO_2$)\uc5d0\uc11c \uc0b0\ud654\ub418\ub294 \ubb3c\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
