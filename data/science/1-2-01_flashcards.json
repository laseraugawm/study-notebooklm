    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucca0\uc774 \ub179\uc2ac \ub54c \uc0dd\uc131\ub418\ub294 \uc0b0\ud654 \ucca0(III)($Fe_2O_3$)\uc744 \uad6c\uc131\ud558\ub294 \ub450 \uc774\uc628\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
