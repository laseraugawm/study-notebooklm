    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc5f0 \uc0c1\ud0dc\uc5d0\uc11c \ucca0\uc740 \uc8fc\ub85c \uc5b4\ub5a4 \ud654\ud559\uc801 \ud615\ud0dc\ub85c \uc874\uc7ac\ud558\ub294\uac00?"
