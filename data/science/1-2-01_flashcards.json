      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc0b0\ud654 \ud0c4\uc18c($CO_2$)\uac00 \ubc1c\uc0dd\ud558\uc5ec \uc11d\ud68c\uc218\uac00 \ubfcc\uc607\uac8c \ud750\ub824\uc9c4\ub2e4."
