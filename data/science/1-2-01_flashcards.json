    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\ud569\uc131 \uc0dd\ubb3c\uc758 \ub4f1\uc7a5, \ucca0\uc758 \uc81c\ub828, \ud654\uc11d \uc5f0\ub8cc\uc758 \uc0ac\uc6a9 \ubc18\uc751\uc5d0\uc11c \uacf5\ud1b5\uc73c\ub85c \uad00\uc5ec\ud558\ub294 \uc6d0\uc18c\ub294 \ubb34\uc5c7\uc778\uac00?"
