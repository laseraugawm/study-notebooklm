    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad6c\ub9ac\uc640 \uc9c8\uc0b0 \uc740 \uc218\uc6a9\uc561\uc758 \ubc18\uc751\uc5d0\uc11c \uc0b0\ud654\ub418\ub294 \ubb3c\uc9c8\uacfc \ud658\uc6d0\ub418\ub294 \ubb3c\uc9c8\uc744 \uac01\uac01 \uc4f0\uc2dc\uc624."
