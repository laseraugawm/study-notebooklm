    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \uad6c\ub9ac(II)\uc640 \ud0c4\uc18c\uc758 \ubc18\uc751($2CuO + C \\rightarrow 2Cu + CO_2$)\uc5d0\uc11c \ud658\uc6d0\ub418\ub294 \ubb3c\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
