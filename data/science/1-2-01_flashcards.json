      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654\ub418\ub294 \ubb3c\uc9c8: \uad6c\ub9ac ($Cu$), \ud658\uc6d0\ub418\ub294 \ubb3c\uc9c8: \uc740 \uc774\uc628 ($Ag^+$)"
