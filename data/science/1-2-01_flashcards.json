        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5f0\ub8cc\uc778 \uc11d\ud0c4, \uc11d\uc720, \ucc9c\uc5f0\uac00\uc2a4\uac00 \uc0b0\uc18c\uc640 \ubc18\uc751\ud558\uc5ec \uc5f4\uc5d0\ub108\uc9c0\ub97c \ubc1c\uc0dd\ud558\ub294 \ud604\uc0c1\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
