    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc18c\uc758 \uc774\ub3d9 \uad00\uc810\uc5d0\uc11c, \ubb3c\uc9c8\uc774 \uc0b0\uc18c\uc640 \ubd84\ub9ac\ub418\uc5b4 \uc0b0\uc18c\ub97c \uc783\ub294 \ubc18\uc751\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
