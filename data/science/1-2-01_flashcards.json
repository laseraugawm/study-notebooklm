    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc21c\uc218\ud55c \ucca0($Fe$)\uacfc \uc0b0\ud654 \ucca0(III)($Fe_2O_3$)\uc758 \uac89\ubcf4\uae30 \uc0c9\uae54 \ubc0f \uad11\ud0dd\uc758 \ucc28\uc774\ub294 \ubb34\uc5c7\uc778\uac00?"
