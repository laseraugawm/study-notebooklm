        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac80\uc740\uc0c9(\uc0b0\ud654 \uad6c\ub9ac(II))\uc5d0\uc11c \ubd89\uc740\uc0c9(\uad6c\ub9ac)\uc73c\ub85c \ubcc0\ud55c\ub2e4."
