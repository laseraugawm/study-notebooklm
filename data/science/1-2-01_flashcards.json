    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \ucca0\uc5d0\uc11c \uc0b0\uc18c\ub97c \ub5bc\uc5b4 \ub0b4\uc5b4 \uc21c\uc218\ud55c \ucca0\uc744 \uc5bb\ub294 \uae30\uc220 \uacfc\uc815\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
