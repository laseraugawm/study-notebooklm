          {
            "type": "text",
            "content": "\ud398\ub8e8 \ubb34\uc9c0\uac1c \uc0b0\uc758 \uc77c\ubd80 \uc554\uc11d\uc774\ub098 \ud759\uc774 \ubd89\uac8c \ubcf4\uc774\ub294 \uc8fc\ub41c \uc6d0\uc778 \ubb3c\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
