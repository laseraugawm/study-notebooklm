      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc21c\uc218\ud55c \ucca0\uc740 \uc740\ud68c\uc0c9\uc774\uba70 \uad11\ud0dd\uc774 \uc788\uace0, \uc0b0\ud654 \ucca0(III)\uc740 \ubd89\uc740\uc0c9\uc774\uba70 \uad11\ud0dd\uc774 \uc5c6\ub2e4."
