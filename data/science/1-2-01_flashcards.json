    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucca0\uc774 \uc0b0\ud654\ub418\uc5b4 \ub179\uc2ac \ub54c \uc804\uc790\uc758 \uc774\ub3d9\uc744 \ucca0\uacfc \uc0b0\uc18c\uc758 \uad00\uc810\uc5d0\uc11c \uc124\uba85\ud558\uc2dc\uc624."
