      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucca0($Fe$)\uc740 \uc804\uc790\ub97c \uc783\uc5b4 $Fe^{3+}$\uc774 \ub418\uace0, \uc0b0\uc18c($O_2$)\ub294 \uc804\uc790\ub97c \uc5bb\uc5b4 $O^{2-}$\uc774 \ub41c\ub2e4."
