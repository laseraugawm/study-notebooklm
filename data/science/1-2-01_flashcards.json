    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \uad6c\ub9ac(II) \uac00\ub8e8\ub97c \uc22f\uac00\ub8e8\uc640 \ubc18\uc751\uc2dc\ud0ac \ub54c, \ubc18\uc751 \ud6c4 \uc2dc\ud5d8\uad00\uc5d0 \ub0a8\ub294 \uace0\uccb4 \ubb3c\uc9c8\uc758 \uc0c9 \ubcc0\ud654\ub294 \uc5b4\ub5a0\ud55c\uac00?"
