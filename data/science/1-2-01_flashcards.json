    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \uad6c\ub9ac(II)\uc640 \uc22f\uac00\ub8e8\uc758 \ubc18\uc751 \uc2dc \ubc1c\uc0dd\ud55c \uae30\uccb4\ub97c \uc11d\ud68c\uc218\uc5d0 \ud1b5\uacfc\uc2dc\ud0a4\uba74 \uc5b4\ub5a4 \ubcc0\ud654\uac00 \ub098\ud0c0\ub098\ub294\uac00?"
