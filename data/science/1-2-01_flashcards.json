    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c8\uc0b0 \uc740 \uc218\uc6a9\uc561\uc5d0 \uad6c\ub9ac\uc904\uc744 \ub123\uc5c8\uc744 \ub54c \uc218\uc6a9\uc561\uc774 \ud478\ub978\uc0c9\uc73c\ub85c \ubcc0\ud558\ub294 \uae4c\ub2ed\uc740 \ubb34\uc5c7\uc778\uac00?"
