      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "2\uac1c (\uad6c\ub9ac 1\uac1c\uac00 \uc804\uc790 2\uac1c\ub97c \ub0b4\ub193\uace0, \uc740 \uc774\uc628 2\uac1c\uac00 \uc804\uc790 1\uac1c\uc529 \ubc1b\uc544 \uc740 \uc6d0\uc790 2\uac1c\uac00 \ub428)"
