{
  "title": "\uc911\ud654\ubc18\uc751 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ubb3d\uc740 \uc5fc\uc0b0($HCl$) \uc218\uc6a9\uc561\uacfc \uc218\uc0b0\ud654 \ub098\ud2b8\ub968($NaOH$) \uc218\uc6a9\uc561\uc774 \ubc18\uc751\ud558\ub294 \uc911\ud654 \ubc18\uc751\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc218\uc18c \uc774\uc628($H^+$)\uacfc \uc218\uc0b0\ud654 \uc774\uc628($OH^-$)\uc740 $2 : 1$\uc758 \uac1c\uc218 \ube44\ub85c \ubc18\uc751\ud558\uc5ec \ubb3c\uc744 \ub9cc\ub4e0\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc758 \uc218\uc18c \uc774\uc628\uacfc \uc5fc\uae30\uc758 \uc218\uc0b0\ud654 \uc774\uc628\uc740 $1 : 1$ \uac1c\uc218 \ube44\ub85c \ubc18\uc751\ud558\uc5ec \ubb3c \ubd84\uc790\ub97c \uc0dd\uc131\ud55c\ub2e4."
        },
        {
          "text": "\ud63c\ud569 \uc804 \uc218\uc6a9\uc561\uc758 \uc218\uc18c \uc774\uc628 \uc591\uc774 \uc218\uc0b0\ud654 \uc774\uc628 \uc591\ubcf4\ub2e4 \ub9ce\uc73c\uba74 \ud63c\ud569 \uc6a9\uc561\uc740 \uc0b0\uc131\uc774 \ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubc18\uc751 \uc804 \uc218\uc18c \uc774\uc628\uc758 \uc218\uac00 \uc218\uc0b0\ud654 \uc774\uc628\uc758 \uc218\ubcf4\ub2e4 \ub9ce\uc73c\uba74 \uc911\ud654 \ubc18\uc751 \ud6c4 \uc218\uc18c \uc774\uc628\uc774 \ub0a8\uc544 \ud63c\ud569 \uc6a9\uc561\uc758 \uc561\uc131\uc774 \uc0b0\uc131\uc774 \ub41c\ub2e4."
        },
        {
          "text": "\uc911\ud654 \ubc18\uc751\uc774 \uc9c4\ud589\ub418\ub294 \ub3d9\uc548 \uc5fc\ud654 \uc774\uc628($Cl^-$)\uc758 \ucd1d \uac1c\uc218\ub294 \uc9c0\uc18d\uc801\uc73c\ub85c \uac10\uc18c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5fc\ud654 \uc774\uc628\uc740 \uc911\ud654 \ubc18\uc751\uc5d0 \uc9c1\uc811 \ucc38\uc5ec\ud558\uc9c0 \uc54a\ub294 \uad6c\uacbd\uafbc \uc774\uc628\uc774\ubbc0\ub85c \ubc18\uc751 \uc9c4\ud589 \uc911\uc5d0\ub3c4 \uc774\uc628 \uc218\uac00 \ubcc0\ud558\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\uc218\uc18c \uc774\uc628\uc774 \ubaa8\ub450 \ubc18\uc751\ud558\uc5ec \uc911\uc131\uc774 \ub41c \ud6c4 \uc218\uc0b0\ud654 \ub098\ud2b8\ub968 \uc218\uc6a9\uc561\uc744 \ub354 \ub123\uc5b4\ub3c4 \uc561\uc131\uc740 \ubcc0\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc911\uc131 \uc0c1\ud0dc\uc5d0\uc11c \uc218\uc0b0\ud654 \ub098\ud2b8\ub968 \uc218\uc6a9\uc561\uc744 \ucd94\uac00\ud558\uba74 \ubc18\uc751\ud558\uc9c0 \uc54a\ub294 \uc218\uc0b0\ud654 \uc774\uc628\uc774 \uc313\uc774\ubbc0\ub85c \uc6a9\uc561\uc740 \uc5fc\uae30\uc131\uc73c\ub85c \ubcc0\ud55c\ub2e4."
        }
      ],
      "hint": "\uc911\ud654 \ubc18\uc751 \uc2dc \uc774\uc628\uc774 \uacb0\ud569\ud558\ub294 \ube44\uc640 \uc54c\uc9dc \uc774\uc628 \ubc18\uc751 \ud6c4 \ub0a8\uc544 \uc788\ub294 \uc774\uc628\uc5d0 \ub530\ub978 \uc561\uc131\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub18d\ub3c4\uc640 \uc628\ub3c4\uac00 \uac19\uc740 \ubb3d\uc740 \uc5fc\uc0b0($HCl$) $10\\text{ mL}$\uc640 \uc218\uc0b0\ud654 \ub098\ud2b8\ub968($NaOH$) \uc218\uc6a9\uc561 $2\\text{ mL}$\ub97c \ud63c\ud569\ud55c \uc6a9\uc561\uc5d0 BTB \uc6a9\uc561\uc744 $2\\sim3$\ubc29\uc6b8 \ub5a8\uc5b4\ub728\ub838\uc744 \ub54c \uad00\ucc30\ub418\ub294 \uc0c9\uc73c\ub85c \uc54c\ub9de\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub178\ub780\uc0c9",
          "isCorrect": true,
          "rationale": "\ubb3d\uc740 \uc5fc\uc0b0\uc758 \ubd80\ud53c\uac00 \ub354 \ucee4\uc11c \uc218\uc18c \uc774\uc628\uc774 \ub0a8\uc73c\ubbc0\ub85c \ud63c\ud569 \uc6a9\uc561\uc740 \uc0b0\uc131\uc774 \ub418\uba70, \uc0b0\uc131 \uc6a9\uc561\uc5d0\uc11c BTB \uc6a9\uc561\uc740 \ub178\ub780\uc0c9\uc744 \ub764\ub2e4."
        },
        {
          "text": "\ucd08\ub85d\uc0c9",
          "isCorrect": false,
          "rationale": "\ucd08\ub85d\uc0c9\uc740 \uc911\uc131 \uc6a9\uc561\uc5d0\uc11c \ub098\ud0c0\ub098\ub294 \uc0c9\uc778\ub370, \ubb3d\uc740 \uc5fc\uc0b0\uc758 \ubd80\ud53c\uac00 \uc218\uc0b0\ud654 \ub098\ud2b8\ub968 \uc218\uc6a9\uc561\ubcf4\ub2e4 \ucee4\uc11c \uc6a9\uc561\uc740 \uc0b0\uc131\uc744 \ub764\ub2e4."
        },
        {
          "text": "\ud30c\ub780\uc0c9",
          "isCorrect": false,
          "rationale": "\ud30c\ub780\uc0c9\uc740 \uc5fc\uae30\uc131 \uc6a9\uc561\uc5d0\uc11c \ub098\ud0c0\ub098\ub294 \uc0c9\uc73c\ub85c, \uc218\uc0b0\ud654 \ub098\ud2b8\ub968 \uc218\uc6a9\uc561\uc758 \ubd80\ud53c\uac00 \ub354 \ud074 \ub54c \uad00\ucc30\ub41c\ub2e4."
        },
        {
          "text": "\ubb34\uc0c9",
          "isCorrect": false,
          "rationale": "BTB \uc6a9\uc561\uc740 \uc0b0\uc131\uc5d0\uc11c \ub178\ub780\uc0c9, \uc911\uc131\uc5d0\uc11c \ucd08\ub85d\uc0c9, \uc5fc\uae30\uc131\uc5d0\uc11c \ud30c\ub780\uc0c9\uc744 \ub760\uba70 \ubb34\uc0c9\uc744 \ub098\ud0c0\ub0b4\uc9c0 \uc54a\ub294\ub2e4."
        }
      ],
      "hint": "\ub450 \uc218\uc6a9\uc561\uc758 \ubd80\ud53c \ube44\ub97c \ud1b5\ud574 \ub0a8\uc544 \uc788\ub294 \uc774\uc628\uc744 \ud655\uc778\ud558\uace0, \uc561\uc131\uc5d0 \ub530\ub978 BTB \uc9c0\uc2dc\uc57d\uc758 \uc0c9 \ubcc0\ud654\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc911\ud654 \ubc18\uc751\uc774 \uc77c\uc5b4\ub0a0 \ub54c \ud63c\ud569 \uc6a9\uc561\uc758 \uc628\ub3c4 \ubcc0\ud654 \ubc0f \uc911\ud654\uc5f4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc911\ud654 \ubc18\uc751\uc740 \uc5f4\uc744 \ud761\uc218\ud558\ub294 \ubc18\uc751\uc774\ubbc0\ub85c \ubc18\uc751\uc774 \uc9c4\ud589\ub420\uc218\ub85d \ud63c\ud569 \uc6a9\uc561\uc758 \uc628\ub3c4\uac00 \ub0ae\uc544\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc911\ud654 \ubc18\uc751\uc774 \uc77c\uc5b4\ub0a0 \ub54c \ub3d9\uc2dc\uc5d0 \uc5f4(\uc911\ud654\uc5f4)\uc774 \ubc1c\uc0dd\ud558\ubbc0\ub85c \ud63c\ud569 \uc6a9\uc561\uc758 \uc628\ub3c4\ub294 \ub192\uc544\uc9c4\ub2e4."
        },
        {
          "text": "\ubc1c\uc0dd\ud558\ub294 \uc911\ud654\uc5f4\uc758 \ud06c\uae30\ub294 \uc911\ud654 \ubc18\uc751\uc5d0\uc11c \uc0dd\uc131\ub41c \ubb3c \ubd84\uc790\uc758 \uc591\uc5d0 \ube44\ub840\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc911\ud654 \ubc18\uc751\uc774 \ub9ce\uc774 \uc77c\uc5b4\ub098 \ubb3c \ubd84\uc790\uac00 \ub9ce\uc774 \uc0dd\uc131\ub420\uc218\ub85d \ubc1c\uc0dd\ud558\ub294 \uc911\ud654\uc5f4\uc758 \uc591\uc774 \uc99d\uac00\ud55c\ub2e4."
        },
        {
          "text": "\ub18d\ub3c4\uc640 \uc628\ub3c4\uac00 \uac19\uc740 \ubb3d\uc740 \uc5fc\uc0b0\uacfc \uc218\uc0b0\ud654 \ub098\ud2b8\ub968 \uc218\uc6a9\uc561\uc744 \ud63c\ud569\ud560 \ub54c, \ubd80\ud53c \ube44\uc640 \uc0c1\uad00\uc5c6\uc774 \ud56d\uc0c1 \ucd5c\uace0 \uc628\ub3c4\ub294 \uc77c\uc815\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub450 \uc218\uc6a9\uc561\uc758 \ud63c\ud569 \ubd80\ud53c \ube44\uc728\uc5d0 \ub530\ub77c \ubc18\uc751\ud558\uc5ec \uc0dd\uc131\ub418\ub294 \ubb3c\uc758 \uc591\uc774 \ub2ec\ub77c\uc9c0\ubbc0\ub85c \ucd5c\uace0 \uc628\ub3c4\uac00 \ub2ec\ub77c\uc9c4\ub2e4."
        },
        {
          "text": "\uc0b0\uc131 \uc218\uc6a9\uc561\uc758 \ubd80\ud53c\uac00 \uc5fc\uae30\uc131 \uc218\uc6a9\uc561\uc758 \ubd80\ud53c\ubcf4\ub2e4 \ud074 \ub54c \ud56d\uc0c1 \ucd5c\uace0 \uc628\ub3c4\uac00 \uac00\uc7a5 \ub192\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub18d\ub3c4\uc640 \uc628\ub3c4\uac00 \uac19\uc740 \ub450 \uc218\uc6a9\uc561\uc758 \ubd80\ud53c\uac00 \uac19\uc544\uc11c \uc911\ud654 \ubc18\uc751\uc774 \uac00\uc7a5 \ub9ce\uc774 \uc77c\uc5b4\ub0a0 \ub54c \ucd5c\uace0 \uc628\ub3c4\uac00 \uac00\uc7a5 \ub192\uc544\uc9c4\ub2e4."
        }
      ],
      "hint": "\uc911\ud654 \ubc18\uc751 \uc2dc \ubc1c\uc0dd\ud558\ub294 \uc5d0\ub108\uc9c0\ub97c \uc911\ud654\uc5f4\uc774\ub77c \ubd80\ub974\uba70, \uc774\uac83\uc774 \ubc18\uc751\ub7c9\uacfc \uc5b4\ub5a4 \uad00\uacc4\uac00 \uc788\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc77c\uc815\ub7c9\uc758 \ubb3d\uc740 \uc5fc\uc0b0 \uc218\uc6a9\uc561\uc5d0 \uc218\uc0b0\ud654 \ub098\ud2b8\ub968 \uc218\uc6a9\uc561\uc744 \uc870\uae08\uc529 \ucca8\uac00\ud560 \ub54c, \ube44\ucee4 \uc18d \uc774\uc628 \uc218\uc758 \ubcc0\ud654\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc218\uc0b0\ud654 \uc774\uc628($OH^-$)\uc758 \uc218\ub294 \ucc98\uc74c\ubd80\ud130 \uc911\ud654\uc810\uc5d0 \ub3c4\ub2ec\ud560 \ub54c\uae4c\uc9c0 \uacc4\uc18d \uc99d\uac00\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc218\uc0b0\ud654 \uc774\uc628\uc740 \ub4e4\uc5b4\uc624\ub294 \uc871\uc871 \uc218\uc18c \uc774\uc628\uacfc \ubc18\uc751\ud558\uc5ec \ubb3c\uc774 \ub418\ubbc0\ub85c, \uc218\uc18c \uc774\uc628\uc774 \ubaa8\ub450 \uc18c\ubaa8\ub418\uae30 \uc804\uae4c\uc9c0\ub294 \uc218\uc6a9\uc561 \uc18d\uc5d0 \uc874\uc7ac\ud558\uc9c0 \ubabb\ud55c\ub2e4."
        },
        {
          "text": "\uc5fc\ud654 \uc774\uc628($Cl^-$)\uc758 \uc218\ub294 \uc218\uc0b0\ud654 \ub098\ud2b8\ub968 \uc218\uc6a9\uc561\uc744 \ub123\uc5b4\ub3c4 \ubcc0\ud558\uc9c0 \uc54a\uace0 \uc77c\uc815\ud558\uac8c \uc720\uc9c0\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5fc\ud654 \uc774\uc628\uc740 \ubc18\uc751\uc5d0 \ucc38\uc5ec\ud558\uc9c0 \uc54a\ub294 \uad6c\uacbd\uafbc \uc774\uc628\uc774\ubbc0\ub85c \ucc98\uc74c\uc5d0 \ub4e4\uc5b4 \uc788\ub358 \uac1c\uc218\uac00 \uadf8\ub300\ub85c \uc720\uc9c0\ub41c\ub2e4."
        },
        {
          "text": "\uc218\uc18c \uc774\uc628($H^+$)\uc758 \uc218\ub294 \uc218\uc0b0\ud654 \ub098\ud2b8\ub968 \uc218\uc6a9\uc561\uc744 \ucca8\uac00\ud568\uc5d0 \ub530\ub77c \uc810\ucc28 \uac10\uc18c\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucca8\uac00\ub41c \uc218\uc0b0\ud654 \uc774\uc628\uacfc \ubc18\uc751\ud558\uc5ec \ubb3c\uc744 \ud615\uc131\ud558\ubbc0\ub85c \uc218\uc18c \uc774\uc628\uc758 \uc218\ub294 \uc810\uc810 \uc904\uc5b4\ub4e0\ub2e4."
        },
        {
          "text": "\ub098\ud2b8\ub968 \uc774\uc628($Na^+$)\uc758 \uc218\ub294 \uc218\uc0b0\ud654 \ub098\ud2b8\ub968 \uc218\uc6a9\uc561\uc744 \ub123\ub294 \uc591\uc5d0 \ube44\ub840\ud558\uc5ec \uacc4\uc18d \uc99d\uac00\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub098\ud2b8\ub968 \uc774\uc628\uc740 \uad6c\uacbd\uafbc \uc774\uc628\uc73c\ub85c \ubc18\uc751\ud558\uc9c0 \uc54a\uace0 \uc6a9\uc561 \uc18d\uc5d0 \uacc4\uc18d \uc313\uc774\ubbc0\ub85c \uc218\uac00 \uacc4\uc18d \ub298\uc5b4\ub09c\ub2e4."
        }
      ],
      "hint": "\ubc18\uc751\uc5d0 \uc9c1\uc811 \ucc38\uc5ec\ud558\ub294 \uc54c\uc9dc \uc774\uc628($H^+$, $OH^-$)\uacfc \ucc38\uc5ec\ud558\uc9c0 \uc54a\ub294 \uad6c\uacbd\uafbc \uc774\uc628($Na^+$, $Cl^-$)\uc758 \ucc28\uc774\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \uc2e4\uc0dd\ud65c\uc5d0\uc11c \uc911\ud654 \ubc18\uc751\uc744 \uc774\uc6a9\ud55c \uc608\uc2dc\uc640 \uadf8 \uc6d0\ub9ac\uc758 \uc5f0\uacb0\uc774 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc218\uc601\uc7a5\uc744 \uc5fc\uc18c\ub85c \uc18c\ub3c5\ud558\uba74 \uc0b0\uc131\uc774 \ub418\ubbc0\ub85c \uc5fc\uae30\uc131 \ubb3c\uc9c8\uc744 \ub123\uc5b4 \uc911\ud654\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5fc\uc18c \uc18c\ub3c5\uc73c\ub85c \uc778\ud574 \uc218\uc601\uc7a5 \ubb3c\uc774 \uc0b0\uc131\ud654\ub418\ub294 \uac83\uc744 \uc5fc\uae30\uc131 \ubb3c\uc9c8\uc744 \ud1b5\ud574 \uc911\ud654\ud558\ub294 \uc62c\ubc14\ub978 \uc608\uc2dc\uc774\ub2e4."
        },
        {
          "text": "\uc704\uc561\uc758 \uc5fc\uc0b0 \ub54c\ubb38\uc5d0 \uc18d\uc774 \uc4f0\ub9b4 \ub54c \uc5fc\uae30\uc131 \uc81c\uc0b0\uc81c\ub97c \ubcf5\uc6a9\ud558\uc5ec \ud1b5\uc99d\uc744 \uc644\ud654\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc704\uc561 \uc18d \uc0b0\uc131 \ubb3c\uc9c8\uc778 \uc5fc\uc0b0\uc744 \uc5fc\uae30\uc131 \uc81c\uc0b0\uc81c\ub85c \uc911\ud654\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc911\ud654 \ubc18\uc751 \uc774\uc6a9 \uc0ac\ub840\uc774\ub2e4."
        },
        {
          "text": "\uc0dd\uc120 \ube44\ub9b0\ub0b4\ub97c \uc81c\uac70\ud558\uae30 \uc704\ud574 \uc5fc\uae30\uc131\uc778 \ub808\ubaac\uc999\uc744 \uc0dd\uc120\uc5d0 \ubfcc\ub9b0\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0dd\uc120 \ube44\ub9b0\ub0b4\uc758 \uc6d0\uc778 \ubb3c\uc9c8\uc740 \uc5fc\uae30\uc131\uc774\uba70, \uc774\ub97c \uc911\ud654\ud558\uae30 \uc704\ud574 \ubfcc\ub9ac\ub294 \ub808\ubaac\uc999\uc740 \uc0b0\uc131 \ubb3c\uc9c8\uc774\ub2e4."
        },
        {
          "text": "\uc0b0\uc131\ud654\ub41c \ud1a0\uc591\uc774\ub098 \ud638\uc218\uc5d0 \uc5fc\uae30\uc131\uc778 \uc11d\ud68c \uac00\ub8e8\ub97c \ubfcc\ub824 \uc911\ud654\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc131\uc73c\ub85c \ubcc0\ud55c \ud1a0\uc591\uc774\ub098 \ud638\uc218\ub97c \uc5fc\uae30\uc131 \ubb3c\uc9c8\uc778 \uc11d\ud68c \uac00\ub8e8\ub85c \uc911\ud654\uc2dc\ud0a4\ub294 \uc62c\ubc14\ub978 \uc0ac\ub840\uc774\ub2e4."
        }
      ],
      "hint": "\ub808\ubaac\uc999\uc758 \uc561\uc131\uc774 \uc0b0\uc131\uc778\uc9c0 \uc5fc\uae30\uc131\uc778\uc9c0 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub300\uae30 \uc911 \uc774\uc0b0\ud654 \ud0c4\uc18c($CO_2$)\uc758 \uc591\uc744 \uc904\uc774\uae30 \uc704\ud55c '\uc774\uc0b0\ud654 \ud0c4\uc18c\ub97c \uc800\uc7a5\ud558\ub294 \uc911\ud654 \ubc18\uc751' \uae30\uc220\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc774\uc0b0\ud654 \ud0c4\uc18c \uae30\uccb4\ub294 \ubb3c\uc5d0 \ub179\uc73c\uba74 \uc5fc\uae30\uc131 \ubb3c\uc9c8\uc778 \ud0c4\uc0b0\uc774 \ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc774\uc0b0\ud654 \ud0c4\uc18c\uac00 \ubb3c\uc5d0 \ub179\uc544 \ud615\uc131\ub418\ub294 \ud0c4\uc0b0\uc740 \uc0b0\uc131 \ubb3c\uc9c8\uc774\ub2e4."
        },
        {
          "text": "\uc774\uc0b0\ud654 \ud0c4\uc18c\ub97c \ud3ec\uc9d1\ud558\uc5ec \uc218\uc0b0\ud654 \uce7c\uc298 \uc218\uc6a9\uc561\uacfc \ubc18\uc751\uc2dc\ud0a4\uba74 \uace0\uccb4 \ud0c4\uc0b0 \uce7c\uc298\uc774 \uc0dd\uc131\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0b0\uc131\uc744 \ub760\ub294 \ud0c4\uc0b0(\uc774\uc0b0\ud654 \ud0c4\uc18c \uc218\uc6a9\uc561)\uacfc \uc5fc\uae30\uc131\uc778 \uc218\uc0b0\ud654 \uce7c\uc298 \uc218\uc6a9\uc561\uc774 \uc911\ud654 \ubc18\uc751\ud558\uc5ec \uace0\uccb4 \uc0c1\ud0dc\uc758 \ud0c4\uc0b0 \uce7c\uc298($CaCO_3$)\uc744 \ub9cc\ub4e0\ub2e4."
