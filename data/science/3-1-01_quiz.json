{
  "title": "\uac10\uc5fc\ubcd1 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "1970\ub144 \ub178\ubca8 \ud3c9\ud654\uc0c1\uc744 \uc218\uc0c1\ud55c \uacfc\ud559\uc790 \ubcfc\ub85c\uadf8(N. Borlaug)\uc758 \uc5c5\uc801\uacfc \uacfc\ud559\uc758 \uc5ed\ud560\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubc00 \uc5f0\uad6c\ub97c \ud1b5\ud574 \uc218\ud655\ub7c9\uc774 \ub9ce\uace0 \ubcd1\ucda9\ud574\uc5d0 \uac15\ud55c \uc885\uc790\ub97c \uac1c\ubc1c\ud558\uc5ec \uc778\ub958\uc758 \uad76\uc8fc\ub9bc \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub294 \ub370 \uae30\uc5ec\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\ubcfc\ub85c\uadf8\ub294 \ud488\uc885 \uac1c\ub7c9\uc744 \ud1b5\ud574 \uc2dd\ub7c9 \uc0dd\uc0b0\ub7c9\uc744 \ud68d\uae30\uc801\uc73c\ub85c \ub298\ub9bc\uc73c\ub85c\uc368 \uc778\ub958\uc758 \uc624\ub79c \uc219\uc81c\uc778 \uae30\uc544 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uc5ec \ub178\ubca8 \ud3c9\ud654\uc0c1\uc744 \uc218\uc0c1\ud588\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ucf54\ub85c\ub09819 \ubc14\uc774\ub7ec\uc2a4\ub97c \ucd5c\ucd08\ub85c \ubc1c\uacac\ud558\uace0 \uc774\uc5d0 \ub300\uc751\ud558\ub294 \uc2e0\uc18d \ud56d\uc6d0 \uc9c4\ub2e8 \ud0a4\ud2b8\ub97c \uc0c1\uc6a9\ud654\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucf54\ub85c\ub09819 \uc9c4\ub2e8 \uae30\uc220\uc740 \ucd5c\uadfc\uc5d0 \uac1c\ubc1c\ub41c \ubc14\uc774\ub7ec\uc2a4 \ub300\uc751 \uacfc\ud559\uae30\uc220\uc774\uba70 \ubcfc\ub85c\uadf8\uc758 \uc5c5\uc801\uacfc\ub294 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc720\uc804\uc790 \uc99d\ud3ed \uae30\uc220(PCR)\uc744 \ubc1c\uba85\ud558\uc5ec \uac10\uc5fc\ubcd1\uc758 \uc804\ud30c \uacbd\ub85c\ub97c \ucc28\ub2e8\ud558\ub294 \ub370 \uacb0\uc815\uc801\uc778 \uc5ed\ud560\uc744 \ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "PCR \uae30\uc220\uc740 \ud575\uc0b0\uc744 \uc99d\ud3ed\ud558\uc5ec \uac10\uc5fc\ubcd1\uc744 \uc9c4\ub2e8\ud558\ub294 \ud604\ub300 \uacfc\ud559\uae30\uc220\ub85c, \ub18d\uc5c5 \ubd84\uc57c\uc5d0\uc11c \uc2dd\ub7c9 \uc99d\uc0b0\uc744 \uc774\ub8ec \ubcfc\ub85c\uadf8\uc758 \uc5f0\uad6c \ub0b4\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\uae30\ud6c4 \uc704\uae30\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud574 \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub97c \uac1c\ubc1c\ud558\uc5ec \uc9c0\uad6c \uc628\ub09c\ud654 \uc18d\ub3c4\ub97c \ub0ae\ucd94\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uac1c\ubc1c\uc740 \uae30\ud6c4 \uc704\uae30 \uadf9\ubcf5\uc744 \uc704\ud55c \ucd5c\uadfc\uc758 \uacfc\ud559\uae30\uc220\uc801 \ub300\uc751 \uc0ac\ub840\uc774\uba70 \ubcfc\ub85c\uadf8\uc758 \ubc00 \uc885\uc790 \uac1c\ubc1c \uc5c5\uc801\uc774 \uc544\ub2d9\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud488\uc885 \uac1c\ub7c9\uc744 \ud1b5\ud574 \uc804 \uc138\uacc4 \uc2dd\ub7c9 \uc0dd\uc0b0\ub7c9\uc744 \ud06c\uac8c \ub298\ub9b0 \uc778\ubb3c\uc785\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uac10\uc5fc\ubcd1 \uc9c4\ub2e8 \ubc29\ubc95\uc778 PCR \uac80\uc0ac, \ud56d\uc6d0 \uac80\uc0ac, \ud56d\uccb4 \uac80\uc0ac\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "PCR \uac80\uc0ac\ub294 \ubcd1\uc6d0\uccb4 \ub0b4\ubd80\uc758 \ud575\uc0b0\uc744 \uc99d\ud3ed\ud558\uc5ec \uc9c4\ub2e8\ud558\uba70, \uc9c4\ub2e8 \ubc29\ubc95 \uc911 \uc815\ud655\ub3c4\uac00 \uac00\uc7a5 \ub192\ub2e4.",
          "isCorrect": true,
          "rationale": "PCR \uac80\uc0ac\ub294 \ubcd1\uc6d0\uccb4\uc758 \uc720\uc804\ubb3c\uc9c8\uc778 \ud575\uc0b0\uc744 \uc99d\ud3ed\ud558\uc5ec \uac80\ucd9c\ud558\ubbc0\ub85c \uc2dc\uac04\uc774 \ub354 \uac78\ub9b4 \uc218 \uc788\uc9c0\ub9cc \uc9c4\ub2e8 \uc815\ud655\ub3c4\uac00 \uac00\uc7a5 \ub6f0\uc5b4\ub0a9\ub2c8\ub2e4."
        },
        {
          "text": "\ud56d\uccb4 \uac80\uc0ac\ub294 \ubcd1\uc6d0\uccb4\uc758 \ud45c\uba74 \ub2e8\ubc31\uc9c8\uc744 \uc9c1\uc811 \uac80\ucd9c\ud558\ubbc0\ub85c \uac10\uc5fc \ucd08\uae30\uc758 \uc2e0\uc18d \uc9c4\ub2e8\uc5d0 \uac00\uc7a5 \uc801\ud569\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcd1\uc6d0\uccb4 \ud45c\uba74\uc758 \ub2e8\ubc31\uc9c8\uc744 \uac80\ucd9c\ud558\ub294 \uac83\uc740 \ud56d\uc6d0 \uac80\uc0ac\uc774\uba70, \ud56d\uccb4 \uac80\uc0ac\ub294 \uccb4\ub0b4\uc5d0\uc11c \ud615\uc131\ub41c \ud56d\uccb4\ub97c \uac80\ucd9c\ud558\ubbc0\ub85c \uc2e0\uc18d \uc9c4\ub2e8\uc5d0 \uc801\ud569\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc2e0\uc18d \ud56d\uc6d0 \uac80\uc0ac\ub294 \ud608\uc561 \uc18d\uc5d0 \ud615\uc131\ub41c \uba74\uc5ed \ub2e8\ubc31\uc9c8\uc744 \uce21\uc815\ud558\uc5ec 10\ubd84 \uc774\ub0b4\uc5d0 \uacb0\uacfc\ub97c \ud655\uc778\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e0\uc18d \ud56d\uc6d0 \uac80\uc0ac\ub294 \ud608\uc561 \uc18d \uba74\uc5ed \ub2e8\ubc31\uc9c8\uc774 \uc544\ub2c8\ub77c \ucf67\uc18d \ub4f1\uc5d0\uc11c \ucc44\ucde8\ud55c \ubc14\uc774\ub7ec\uc2a4\uc758 \ub2e8\ubc31\uc9c8(\ud56d\uc6d0)\uc744 \uc9c4\ub2e8 \ud0a4\ud2b8\uc758 \ud56d\uccb4\uc640 \uacb0\ud569\uc2dc\ucf1c \ud655\uc778\ud558\ub294 \ubc29\uc2dd\uc785\ub2c8\ub2e4."
        },
        {
          "text": "PCR \uac80\uc0ac\ub294 \ud56d\uc6d0 \uac80\uc0ac\uc5d0 \ube44\ud574 \uac80\uc0ac \uc2dc\uac04\uc774 \ub9e4\uc6b0 \uc9e7\uc544 \uac10\uc5fc \uc5ec\ubd80\ub97c \uac00\uc7a5 \ube60\ub974\uac8c \uc9c4\ub2e8\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "PCR \uac80\uc0ac\ub294 \ud575\uc0b0 \uc99d\ud3ed \uacfc\uc815\uc774 \ud544\uc694\ud558\uc5ec \ud56d\uc6d0 \uc9c4\ub2e8 \ud0a4\ud2b8(10\ubd84 \uc774\ub0b4)\ubcf4\ub2e4 \uac80\uc0ac \uc2dc\uac04\uc774 \uae38\uac8c \uc18c\uc694\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud575\uc0b0\uc744 \uc99d\ud3ed\ud558\ub294 \uae30\uc220\uc758 \ud2b9\uc9d5\uacfc \uac01 \uc9c4\ub2e8 \ubc29\uc2dd\uc758 \uc815\ud655\ub3c4\ub97c \ube44\uad50\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc2e0\uc18d \ud56d\uc6d0 \uac80\uc0ac \ud0a4\ud2b8\uc758 \uc9c4\ub2e8 \uc6d0\ub9ac\uc640 \ubc18\uc751 \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac80\uc0ac \ud0a4\ud2b8 \ub0b4\ubd80\uc758 \ud56d\uccb4\uac00 \uac80\uccb4 \uc18d \ubc14\uc774\ub7ec\uc2a4 \ub2e8\ubc31\uc9c8\uacfc \ud2b9\uc774\uc801\uc73c\ub85c \uacb0\ud569\ud558\uc5ec \ubc18\uc751\uc744 \ub098\ud0c0\ub0b8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc2e0\uc18d \ud56d\uc6d0 \uac80\uc0ac\ub294 \ud0a4\ud2b8\uc5d0 \ub4e4\uc5b4 \uc788\ub294 \ud56d\uccb4\uac00 \uc6a9\uc561 \uc18d\uc5d0 \ubd84\ub9ac\ub418\uc5b4 \ub098\uc628 \ubc14\uc774\ub7ec\uc2a4 \ub2e8\ubc31\uc9c8(\ud56d\uc6d0)\uacfc \uacb0\ud569\ud558\ub294 \uc6d0\ub9ac\ub97c \uc774\uc6a9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ucc44\ucde8\ud55c \uac80\uccb4 \uc18d \ubc14\uc774\ub7ec\uc2a4\uc758 \uc720\uc804\ubb3c\uc9c8(\ud575\uc0b0)\uc744 \ud06c\uac8c \uc99d\ud3ed\uc2dc\ucf1c \ud0a4\ud2b8\uc758 \uc2e4\ud5d8\uc120\uc744 \ubcc0\ud654\uc2dc\ud0a8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc720\uc804\ubb3c\uc9c8\uc778 \ud575\uc0b0\uc744 \uc99d\ud3ed\uc2dc\ud0a4\ub294 \uc6d0\ub9ac\ub294 \uc2e0\uc18d \ud56d\uc6d0 \uac80\uc0ac\uac00 \uc544\ub2cc PCR \uac80\uc0ac\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud658\uc790\uc758 \ud608\uc561\uc744 \ucc44\ucde8\ud558\uc5ec \ud608\uc561 \uc18d\uc5d0 \uc874\uc7ac\ud558\ub294 \ubc29\uc5b4 \ubb3c\uc9c8\uc758 \uc591\uc744 \uc9c1\uc811 \ubd84\uc11d\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud608\uc561\uc744 \ucc44\ucde8\ud558\uc5ec \uccb4\ub0b4 \ubc29\uc5b4 \ubb3c\uc9c8\uc744 \ud655\uc778\ud558\ub294 \uc9c4\ub2e8 \ubc29\uc2dd\uc740 \ud56d\uccb4 \uac80\uc0ac\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c4\ub2e8 \ud0a4\ud2b8\uc758 \uc2e4\ud5d8\uc120\uc740 \ubc14\uc774\ub7ec\uc2a4\uac00 \uc874\uc7ac\ud558\uc9c0 \uc54a\ub294 \uc74c\uc131 \uac80\uccb4\uc5d0\uc11c\ub9cc \ubc1c\uc0c9 \ubc18\uc751\uc774 \uc77c\uc5b4\ub09c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e4\ud5d8\uc120\uc740 \ubc14\uc774\ub7ec\uc2a4 \ud56d\uc6d0\uacfc \ud56d\uccb4\uac00 \uacb0\ud569\ud55c \ubb3c\uc9c8\uc774 \ub9cc\ub0ac\uc744 \ub54c \uc0c9\uc744 \ub0b4\ubbc0\ub85c \uc591\uc131 \uac80\uccb4\uc5d0\uc11c \ubc18\uc751\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud56d\uccb4\uac00 \ud2b9\uc815\ud55c \ud56d\uc6d0 \ubb3c\uc9c8\uc5d0\ub9cc \ubc18\uc751\ud558\uc5ec \uacb0\ud569\ud55c\ub2e4\ub294 \ud2b9\uc131\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uac10\uc5fc\ubcd1 \uc9c4\ub2e8 \ubc29\ubc95 \uc911 '\ud56d\uccb4 \uac80\uc0ac'\uac00 \uac10\uc5fc \ucd08\uae30\uc758 \uc2e0\uc18d\ud55c \uc9c4\ub2e8\uc5d0 \uc801\ud569\ud558\uc9c0 \uc54a\uc740 \uc774\uc720\ub85c \uac00\uc7a5 \ud0c0\ub2f9\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubcd1\uc6d0\uccb4\uc5d0 \uac10\uc5fc\ub41c \ud6c4 \uc6b0\ub9ac \ubab8\uc5d0\uc11c \uc774\ub97c \ubc29\uc5b4\ud558\uae30 \uc704\ud55c \ud56d\uccb4\uac00 \uc0dd\uc131\ub418\uae30\uae4c\uc9c0 \uc2dc\uac04\uc774 \uac78\ub9ac\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud56d\uccb4\ub294 \ubc14\uc774\ub7ec\uc2a4 \uce68\uc785 \ud6c4 \uc778\uccb4 \uba74\uc5ed \ubc18\uc751\uc744 \uac70\uccd0 \ud615\uc131\ub418\uae30\uae4c\uc9c0 \uc77c\uc815 \uc2dc\uac04\uc774 \uc18c\uc694\ub418\ubbc0\ub85c \uac10\uc5fc \ucd08\uae30 \uc2e0\uc18d \uc9c4\ub2e8\uc5d0\ub294 \ubd88\ub9ac\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\ud56d\uccb4\ub294 \ubaa8\ub4e0 \uc885\ub958\uc758 \ubc14\uc774\ub7ec\uc2a4\uc640 \ubb34\uc791\uc704\ub85c \uacb0\ud569\ud558\uc5ec \uc9c4\ub2e8 \uc815\ud655\ub3c4\uac00 \ud604\uc800\ud788 \ub5a8\uc5b4\uc9c0\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud56d\uccb4\ub294 \ud2b9\uc815 \ud56d\uc6d0\uc5d0\ub9cc \ubc18\uc751\ud558\ub294 \ub192\uc740 \ud2b9\uc774\uc131\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\ubbc0\ub85c \ubb34\uc791\uc704\ub85c \uacb0\ud569\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud608\uc561 \uc18d \ud56d\uccb4\uc758 \ud575\uc0b0\uc744 \uc99d\ud3ed\ud558\ub294 \uacfc\uc815\uc5d0\uc11c \uc815\ubc00 \uc7a5\ube44\uc640 \ub9ce\uc740 \uc2dc\uac04\uc774 \uc18c\uc694\ub418\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud56d\uccb4\ub294 \ub2e8\ubc31\uc9c8\uc774\uba70, \ud575\uc0b0\uc744 \uc99d\ud3ed\ud558\ub294 \uacfc\uc815\uc740 PCR \uac80\uc0ac\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\ucf67\uc18d \uac80\uccb4 \ucc44\ucde8 \uacfc\uc815\uc5d0\uc11c \ud56d\uccb4 \uad6c\uc870\uac00 \uc27d\uac8c \ud30c\uad34\ub418\ub294 \ud55c\uacc4\uac00 \uc788\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud56d\uccb4 \uac80\uc0ac\ub294 \ucf67\uc18d \uac80\uccb4\uac00 \uc544\ub2c8\ub77c \uccb4\uc561\uc778 \ud608\uc561\uc744 \ucc44\ucde8\ud558\uc5ec \ud655\uc778\ud558\ub294 \ubc29\uc2dd\uc785\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubc14\uc774\ub7ec\uc2a4\uac00 \ubab8\uc5d0 \ub4e4\uc5b4\uc628 \uc9c1\ud6c4 \uba74\uc5ed\uacc4\uac00 \ubc18\uc751\ud558\uc5ec \uba74\uc5ed \ub2e8\ubc31\uc9c8\uc744 \ub9cc\ub4e4\uc5b4\ub0b4\uae30\uae4c\uc9c0 \uac78\ub9ac\ub294 \uc2dc\uac04\uc744 \uace0\ub824\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud604\ub300 \uc0ac\ud68c\uc5d0\uc11c \uac10\uc5fc\ubcd1\uc758 \uac10\uc5fc \uacbd\ub85c\ub97c \ucd94\uc801\ud558\uace0 \uc5ed\ud559 \uc870\uc0ac\ub97c \uc218\ud589\ud558\ub294 \ub370 \uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220(ICT)\uacfc \uc778\uacf5\uc9c0\ub2a5(AI)\uc774 \uae30\uc5ec\ud55c \uc5ed\ud560\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5ed\ud559 \uc870\uc0ac\uad00\uc758 \uc9c1\uc811 \uc870\uc0ac \uacfc\uc815\uc744 \uc644\uc804\ud788 \ub300\uccb4\ud558\uc5ec \uc0ac\ub78c\uc758 \uac1c\uc785 \uc5c6\uc774 100% \uc790\ub3d9\uc73c\ub85c \ubc29\uc5ed\uc744 \uc644\uacb0\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uacfc\ud559\uae30\uc220\uc740 \ubc29\ub300\ud55c \ub370\uc774\ud130\ub97c \ube60\ub974\uac8c \uc218\uc9d1\u00b7\ubd84\uc11d\ud558\uc5ec \uc5ed\ud559 \uc870\uc0ac\ub97c \ub3c4\uc6b0\ub098, \uc5ed\ud559 \uc870\uc0ac\uad00\uc758 \uc5ed\ud560\uc744 \uc804\uba74 \ub300\uccb4\ud558\uc5ec \uc0ac\ub78c \uc5c6\uc774 \uc644\uacb0\ud558\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4."
        },
        {
          "text": "\uc2a4\ub9c8\ud2b8 \uae30\uae30\ub97c \ud65c\uc6a9\ud558\uc5ec \uac10\uc5fc\uc790\uc758 \uc774\ub3d9 \uacbd\ub85c, \uc778\uad6c\uc218, \uccb4\uc628 \ub4f1 \ub2e4\uc591\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \uc218\uc9d1\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2a4\ub9c8\ud2b8 \uae30\uae30\uc640 ICT\ub294 \uc774\ub3d9 \ub3d9\uc120 \ubc0f \uccb4\uc628 \uc815\ubcf4 \ub4f1 \ubc29\ub300\ud55c \uc5ed\ud559 \ub370\uc774\ud130\ub97c \uc2e0\uc18d\ud558\uac8c \uc9d1\uacc4\ud558\ub3c4\ub85d \ub3d5\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220\uc744 \uc774\uc6a9\ud558\uc5ec \uc218\uc9d1\ub41c \uac10\uc5fc\uc790 \ubd84\ud3ec \ubc0f \ud604\ud669 \uc815\ubcf4\ub97c \uc2dc\ubbfc\ub4e4\uc5d0\uac8c \uc2e4\uc2dc\uac04\uc73c\ub85c \uc804\ub2ec\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2e4\uc2dc\uac04 \ud604\ud669\ud310 \ubc0f \uc548\ub0b4 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \uac10\uc5fc\ubcd1 \uc815\ubcf4\ub97c \uc2dc\ubbfc\ub4e4\uc5d0\uac8c \uc2e0\uc18d\ud788 \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        {
