{
  "title": "\ud654\ud559 \uc0b0\ud654\ud658\uc6d0\ud034\uc988",
  "questions": [
    {
      "question": "\uc9c0\uad6c \uc5ed\uc0ac\uc5d0\uc11c \uad11\ud569\uc131 \uc0dd\ubb3c(\ub0a8\uc138\uade0)\uc774 \ub4f1\uc7a5\ud55c \uc774\ud6c4 \ub098\ud0c0\ub09c \uc9c0\uad6c \ud658\uacbd \ubc0f \uc0dd\ubb3c\uacc4\uc758 \ubcc0\ud654\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub300\uae30 \uc911 \uc774\uc0b0\ud654 \ud0c4\uc18c\uc758 \ub18d\ub3c4\uac00 \uae09\uaca9\ud788 \uc99d\uac00\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad11\ud569\uc131\uc740 \uc774\uc0b0\ud654 \ud0c4\uc18c\ub97c \uc18c\ube44\ud558\uace0 \uc0b0\uc18c\ub97c \uc0dd\uc131\ud558\ubbc0\ub85c \ub300\uae30 \uc911 \uc0b0\uc18c \ub18d\ub3c4\uac00 \uc99d\uac00\ud558\uace0 \uc774\uc0b0\ud654 \ud0c4\uc18c \ub18d\ub3c4\ub294 \uac10\uc18c\ud55c\ub2e4."
        },
        {
          "text": "\ub300\uae30 \uc911 \uc0b0\uc18c\ub85c\ubd80\ud130 \uc624\uc874\uce35\uc774 \ud615\uc131\ub418\uc5b4 \uc0dd\ubb3c\uc774 \uc721\uc9c0\ub85c \uc9c4\ucd9c\ud560 \uc218 \uc788\uac8c \ub418\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uad11\ud569\uc131\uc73c\ub85c \ub204\uc801\ub41c \ub300\uae30 \uc911 \uc0b0\uc18c\ub85c\ubd80\ud130 \uc624\uc874\uce35\uc774 \ud615\uc131\ub418\uc5b4 \uc720\ud574 \uc790\uc678\uc120\uc744 \ucc28\ub2e8\ud568\uc73c\ub85c\uc368 \uc0dd\ubb3c\uc758 \uc721\uc0c1 \uc9c4\ucd9c\uc774 \uac00\ub2a5\ud574\uc84c\ub2e4."
        },
        {
          "text": "\uc0b0\uc18c \ud638\ud761\uc744 \ud558\ub294 \uc0dd\ubb3c\uc774 \uc0ac\ub77c\uc9c0\uace0 \ubb34\uc0b0\uc18c \ud638\ud761 \uc0dd\ubb3c\uc774 \uae09\uc99d\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub300\uae30 \uc911 \uc0b0\uc18c\uac00 \ud48d\ubd80\ud574\uc9d0\uc5d0 \ub530\ub77c \uc0b0\uc18c\ub97c \uc774\uc6a9\ud558\uc5ec \uc601\uc591\uc18c\ub97c \ubd84\ud574\ud558\uace0 \uc5d0\ub108\uc9c0\ub97c \uc5bb\ub294 \uc0b0\uc18c \ud638\ud761 \uc0dd\ubb3c\uc774 \ub4f1\uc7a5\ud558\uc600\ub2e4."
        },
        {
          "text": "\ub300\uae30 \uc911\uc758 \uc0b0\uc18c\uac00 \uc9c0\uac01\uc758 \uad11\ubb3c\uacfc \ubc18\uc751\ud558\uc5ec \uc778\ub958\uc758 \ucca0\uae30 \ubb38\uba85\uc774 \uc790\uc5f0\uc801\uc73c\ub85c \uc2dc\uc791\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucca0\uae30 \ubb38\uba85\uc740 \uc778\ub958\uac00 \uc0b0\ud654 \ucca0\uc5d0\uc11c \uc0b0\uc18c\ub97c \ubd84\ub9ac\ud574 \ub0b4\ub294 \uc81c\ub828 \uae30\uc220\uc744 \uac1c\ubc1c\ud558\uba74\uc11c \uc2dc\uc791\ub41c \uac83\uc774\ub2e4."
        }
      ],
      "hint": "\uad11\ud569\uc131 \uacb0\uacfc \ucd95\uc801\ub41c \uc0b0\uc18c\uac00 \ub300\uae30 \uc0c1\uce35\uc5d0\uc11c \ud615\uc131\ud55c \ubcf4\ud638\ub9c9\uc758 \uc5ed\ud560\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uac80\uc740\uc0c9 \uc0b0\ud654 \uad6c\ub9ac(II) \uac00\ub8e8($CuO$)\uc640 \uc22f\uac00\ub8e8($C$)\ub97c \ud568\uaed8 \uc2dc\ud5d8\uad00\uc5d0 \ub123\uace0 \uac00\uc5f4\ud560 \ub54c \uc77c\uc5b4\ub098\ub294 \ubcc0\ud654\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0b0\ud654 \uad6c\ub9ac(II)\ub294 \uc0b0\uc18c\ub97c \uc5bb\uc5b4 \uc0b0\ud654\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\ud654 \uad6c\ub9ac(II)\ub294 \uacb0\ud569\ud574 \uc788\ub358 \uc0b0\uc18c\ub97c \uc783\uace0 \ubd89\uc740\uc0c9 \uad6c\ub9ac\ub85c \ubcc0\ud654\ud558\ubbc0\ub85c \ud658\uc6d0\ub41c\ub2e4."
        },
        {
          "text": "\ud0c4\uc18c($C$)\ub294 \uc0b0\uc18c\ub97c \uc783\uc5b4 \ud658\uc6d0\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc22f\uac00\ub8e8\uc758 \ud0c4\uc18c\ub294 \uc0b0\ud654 \uad6c\ub9ac(II)\uc5d0\uc11c \ubd84\ub9ac\ub41c \uc0b0\uc18c\uc640 \uacb0\ud569\ud558\uc5ec \uc774\uc0b0\ud654 \ud0c4\uc18c\uac00 \ub418\ubbc0\ub85c \uc0b0\ud654\ub41c\ub2e4."
        },
        {
          "text": "\uac80\uc740\uc0c9\uc758 \uc0b0\ud654 \uad6c\ub9ac(II)\uac00 \ubd89\uc740\uc0c9\uc758 \uad6c\ub9ac($Cu$)\ub85c \ubcc0\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0b0\ud654 \uad6c\ub9ac(II)\uc5d0\uc11c \uc0b0\uc18c\uac00 \ubd84\ub9ac\ub418\uc5b4 \ubd89\uc740\uc0c9\uc758 \uae08\uc18d \uad6c\ub9ac\uac00 \uc0dd\uc131\ub41c\ub2e4."
        },
        {
          "text": "\ubc18\uc751 \uacb0\uacfc \ubc1c\uc0dd\ud55c \uae30\uccb4\ub294 \uc11d\ud68c\uc218\ub97c \ubcc0\ud654\uc2dc\ud0a4\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc18\uc751 \uacb0\uacfc \uc774\uc0b0\ud654 \ud0c4\uc18c($CO_2$) \uae30\uccb4\uac00 \ubc1c\uc0dd\ud558\ubbc0\ub85c \uc11d\ud68c\uc218\ub97c \ubfcc\uc607\uac8c \ud750\ub9ac\uac8c \ub9cc\ub4e0\ub2e4."
        }
      ],
      "hint": "\uc0b0\uc18c\ub97c \uc783\uc740 \ubb3c\uc9c8\uc758 \uc0c9\uae54 \ubcc0\ud654\uc640 \ubc1c\uc0dd\ud558\ub294 \uae30\uccb4\uc758 \uc885\ub958\ub97c \uace0\ub824\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ucca0\uc758 \uc81c\ub828 \ubc18\uc751\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc5f0 \uc0c1\ud0dc\uc5d0 \uc874\uc7ac\ud558\ub294 \uc21c\uc218\ud55c \ucca0\uc744 \ub2e8\uc21c\ud788 \uc5f4\ub85c \uc6a9\ud574\ud558\uc5ec \uc5bb\ub294 \uacfc\uc815\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc5f0 \uc0c1\ud0dc\uc758 \ucca0\uc740 \uc8fc\ub85c \uc0b0\uc18c\uc640 \uacb0\ud569\ub41c \uc0b0\ud654 \ucca0 \uc0c1\ud0dc\ub85c \uc874\uc7ac\ud55c\ub2e4."
        },
        {
          "text": "\uc0b0\ud654 \ucca0\uc5d0\uc11c \uc0b0\uc18c\ub97c \ub5bc\uc5b4 \ub0b4\uc5b4 \uc21c\uc218\ud55c \ucca0\uc744 \uc5bb\ub294 \ud658\uc6d0 \uacfc\uc815\uc774 \ud3ec\ud568\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ucca0\uad11\uc11d\uc758 \uc0b0\ud654 \ucca0\uc5d0\uc11c \uc0b0\uc18c\ub97c \ubd84\ub9ac(\ud658\uc6d0)\uc2dc\ucf1c \uae08\uc18d \ucca0\uc744 \uc5bb\ub294 \ubc18\uc751\uc774\ub2e4."
        },
        {
          "text": "\ucca0\uc774 \uacf5\uae30 \uc911\uc758 \uc0b0\uc18c\uc640 \ubc18\uc751\ud558\uc5ec \uc0b0\ud654 \ucca0(III)\uc774 \ub418\ub294 \uc0b0\ud654 \uacfc\uc815\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucca0\uc774 \uc0b0\uc18c\uc640 \uacb0\ud569\ud558\uc5ec \uc0b0\ud654 \ucca0(III)\uc774 \ub418\ub294 \uac83\uc740 \ucca0\uc774 \ub179\uc2a4\ub294 \ud604\uc0c1\uc774\ub2e4."
        },
        {
          "text": "\uc0b0\uc18c\uc758 \uc774\ub3d9\uc774 \uc804\ud600 \uad00\uc5ec\ud558\uc9c0 \uc54a\ub294 \ubc18\uc751\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucca0\uc758 \uc81c\ub828\uc740 \uc0b0\uc18c\uc758 \uc774\ub3d9\uc5d0 \uc758\ud55c \ub300\ud45c\uc801\uc778 \uc0b0\ud654 \ud658\uc6d0 \ubc18\uc751\uc774\ub2e4."
        }
      ],
      "hint": "\uc790\uc5f0 \uc0c1\ud0dc\uc758 \ucca0\uad11\uc11d \ud615\ud0dc\uc640 \uc21c\uc218\ud55c \ucca0\uc744 \uc5bb\uae30 \uc704\ud574 \uc0b0\uc18c\ub97c \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud574\uc57c \ud558\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc0b0\ud654\u00b7\ud658\uc6d0 \ubc18\uc751\uc758 \uc911\uc694\ud55c \ud2b9\uc131\uc778 '\ub3d9\uc2dc\uc131'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud55c \ubb3c\uc9c8\uc774 \uc0b0\uc18c\ub97c \uc5bb\uac70\ub098 \uc804\uc790\ub97c \uc783\uc73c\uba74, \ub2e4\ub978 \ubb3c\uc9c8\uc740 \uc0b0\uc18c\ub97c \uc783\uac70\ub098 \uc804\uc790\ub97c \uc5bb\ub294\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0b0\ud654 \ubc18\uc751\uc774 \uc77c\uc5b4\ub0a0 \ub54c \uc5b4\ub5a4 \ubb3c\uc9c8\uc774 \uc783\uc5b4\ubc84\ub9b0 \uc0b0\uc18c\ub098 \uc804\uc790\ub294 \ub2e4\ub978 \ubb3c\uc9c8\ub85c \uc774\ub3d9\ud558\ubbc0\ub85c \uc0b0\ud654\uc640 \ud658\uc6d0\uc740 \ud56d\uc0c1 \ub3d9\uc2dc\uc5d0 \uc77c\uc5b4\ub09c\ub2e4."
        },
        {
          "text": "\ud654\ud559 \ubc18\uc751\uc5d0\uc11c \uc0b0\ud654 \ubc18\uc751\uc774 \ubaa8\ub450 \ub05d\ub09c \ud6c4\uc5d0 \ud658\uc6d0 \ubc18\uc751\uc774 \uc9c4\ud589\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\ud654\uc640 \ud658\uc6d0\uc740 \uc21c\ucc28\uc801\uc73c\ub85c \uc77c\uc5b4\ub098\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \ud558\ub098\uc758 \ud654\ud559 \ubc18\uc751 \uc548\uc5d0\uc11c \ub3d9\uc2dc\uc5d0 \uc9c4\ud589\ub41c\ub2e4."
        },
        {
          "text": "\uc870\uac74\uc5d0 \ub530\ub77c \uc0b0\ud654 \ubc18\uc751\ub9cc \ub2e8\ub3c5\uc73c\ub85c \uc9c4\ud589\ub420 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804\uc790\uac00 \uc774\ub3d9\ud558\uac70\ub098 \uc0b0\uc18c\uac00 \uc774\ub3d9\ud560 \ub54c \uc8fc\ub294 \ubb3c\uc9c8\uacfc \ubc1b\ub294 \ubb3c\uc9c8\uc774 \ud568\uaed8 \uc874\uc7ac\ud574\uc57c \ud558\ubbc0\ub85c \uc0b0\ud654\ub9cc \ub2e8\ub3c5\uc73c\ub85c \uc77c\uc5b4\ub0a0 \uc218\ub294 \uc5c6\ub2e4."
        },
        {
          "text": "\uc804\uc790\uc758 \uc774\ub3d9\uc5d0 \uc758\ud55c \ubc18\uc751\uc5d0\uc11c\ub294 \ub3d9\uc2dc\uc131\uc774 \uc131\ub9bd\ud558\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804\uc790\uc758 \uc774\ub3d9\uc73c\ub85c \uc124\uba85\ud560 \ub54c\ub3c4 \ud55c \ubb3c\uc9c8\uc774 \uc804\uc790\ub97c \uc783\ub294 \uc989\uc2dc \ub2e4\ub978 \ubb3c\uc9c8\uc774 \uc804\uc790\ub97c \uc5bb\uc73c\ubbc0\ub85c \ub3d9\uc2dc\uc131\uc774 \uc131\ub9bd\ud55c\ub2e4."
        }
      ],
      "hint": "\uc0b0\uc18c\ub098 \uc804\uc790\ub97c \uc8fc\uace0\ubc1b\ub294 \uacfc\uc815\uc774 \uc11c\ub85c \uc5f0\uacb0\ub418\uc5b4 \uc788\uc74c\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc804\uc790\uc758 \uc774\ub3d9 \uad00\uc810\uc5d0\uc11c \uc0b0\ud654\uc640 \ud658\uc6d0\uc744 \uc62c\ubc14\ub974\uac8c \uc815\uc758\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb3c\uc9c8\uc774 \uc804\uc790\ub97c \uc783\ub294 \ubc18\uc751\uc744 \uc0b0\ud654, \uc804\uc790\ub97c \uc5bb\ub294 \ubc18\uc751\uc744 \ud658\uc6d0\uc774\ub77c\uace0 \ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc804\uc790\uc758 \uc774\ub3d9\uc5d0 \uc758\ud55c \uc815\uc758\uc5d0\uc11c \uc0b0\ud654\ub294 \uc804\uc790\ub97c \uc783\ub294 \ubc18\uc751\uc774\uba70, \ud658\uc6d0\uc740 \uc804\uc790\ub97c \uc5bb\ub294 \ubc18\uc751\uc774\ub2e4."
        },
        {
          "text": "\ubb3c\uc9c8\uc774 \uc804\uc790\ub97c \uc5bb\ub294 \ubc18\uc751\uc744 \uc0b0\ud654, \uc804\uc790\ub97c \uc783\ub294 \ubc18\uc751\uc744 \ud658\uc6d0\uc774\ub77c\uace0 \ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc804\uc790\ub97c \uc5bb\ub294 \uac83\uc740 \ud658\uc6d0\uc774\uace0 \uc783\ub294 \uac83\uc774 \uc0b0\ud654\uc774\ubbc0\ub85c \ubc18\ub300\ub85c \uc124\uba85\ub418\uc5c8\ub2e4."
        },
        {
          "text": "\uc804\uc790\uc758 \uc774\ub3d9\uc5d0 \ub530\ub978 \uc815\uc758\ub294 \uc0b0\uc18c\uac00 \uacb0\ud569\ud558\ub294 \ubc18\uc751\uc5d0\ub294 \uc801\uc6a9\ud560 \uc218 \uc5c6\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc18c\uac00 \uacb0\ud569\ud558\uac70\ub098 \ubd84\ub9ac\ub418\ub294 \ubc18\uc751\ub3c4 \uc6d0\uc18c \uac04 \uc804\uc790\uc758 \uc774\ub3d9 \uad00\uc810\uc5d0\uc11c \ubaa8\ub450 \uc124\uba85\uc774 \uac00\ub2a5\ud558\ub2e4."
        },
        {
          "text": "\uae08\uc18d \uc774\uc628\uc774 \uc804\uc790\ub97c \uc5bb\uc5b4 \uae08\uc18d \uc6d0\uc790\ub85c \uc11d\ucd9c\ub418\ub294 \uac83\uc740 \uc0b0\ud654 \ubc18\uc751\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae08\uc18d \uc591\uc774\uc628\uc774 \uc804\uc790\ub97c \uc5bb\uc73c\uba74 \uc804\uc790\ub97c \uc5bb\ub294 \ubc18\uc751\uc774\ubbc0\ub85c \ud658\uc6d0\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        }
      ],
      "hint": "\uad6c\ub9ac\uac00 \uad6c\ub9ac \uc774\uc628($Cu^{2+}$)\uc774 \ub420 \ub54c \uc804\uc790\ub97c \uc5b4\ub5bb\uac8c \ud558\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uad6c\ub9ac\uc904\uc744 \uc9c8\uc0b0 \uc740($AgNO_3$) \uc218\uc6a9\uc561\uc5d0 \ub123\uc5c8\uc744 \ub54c \uc77c\uc5b4\ub098\ub294 \ubcc0\ud654\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc218\uc6a9\uc561 \uc18d\uc5d0 \uad6c\ub9ac \uc774\uc628($Cu^{2+}$)\uc774 \ub298\uc5b4\ub098\uba74\uc11c \uc218\uc6a9\uc561\uc774 \uc810\uc810 \ud478\ub978\uc0c9\uc73c\ub85c \ubcc0\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uad6c\ub9ac \uc6d0\uc790\uac00 \uc804\uc790\ub97c \uc783\uace0 $Cu^{2+}$ \uc774\uc628\uc774 \ub418\uc5b4 \uc6a9\uc561 \uc18d\uc73c\ub85c \ub179\uc544\ub4e4\uc5b4\uac00\ubbc0\ub85c \uc218\uc6a9\uc561\uc774 \ud478\ub978\uc0c9\uc744 \ub760\uac8c \ub41c\ub2e4."
        },
        {
          "text": "\uc740 \uc774\uc628($Ag^+$)\uc740 \uc804\uc790\ub97c \uc783\uace0 \uc0b0\ud654\ub418\uc5b4 \uad6c\ub9ac\uc904 \ud45c\uba74\uc5d0 \ub179\uc544\ub4e0\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc740 \uc774\uc628\uc740 \uc804\uc790\ub97c \uc5bb\uc5b4 \ud658\uc6d0\ub418\uc5b4 \uae08\uc18d \uc740($Ag$) \ud615\ud0dc\ub85c \uad6c\ub9ac\uc904 \ud45c\uba74\uc5d0 \uc11d\ucd9c\ub41c\ub2e4."
        },
        {
          "text": "\uad6c\ub9ac\uc904 \ud45c\uba74\uc5d0\ub294 \uc544\ubb34\ub7f0 \ubb3c\uc9c8\ub3c4 \uc11d\ucd9c\ub418\uc9c0 \uc54a\uace0 \uc218\uc6a9\uc561\uc758 \uc0c9\ub9cc \ubcc0\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc740 \uc774\uc628\uc774 \ud658\uc6d0\ub418\uc5b4 \uae08\uc18d \uc740\uc774 \uad6c\ub9ac\uc904 \ud45c\uba74\uc5d0 \ub2ec\ub77c\ubd99\uc5b4 \ubd99\uc5b4\uc788\ub294 \ubaa8\uc2b5\uc774 \uad00\ucc30\ub41c\ub2e4."
        },
        {
          "text": "\uad6c\ub9ac \uc6d0\uc790\ub294 \uc804\uc790\ub97c \uc5bb\uc5b4 \ud658\uc6d0\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6c\ub9ac \uc6d0\uc790\ub294 \uc804\uc790\ub97c \uc783\uace0 \uad6c\ub9ac \uc774\uc628\uc73c\ub85c \uc0b0\ud654\ub41c\ub2e4."
        }
      ],
      "hint": "\uc218\uc6a9\uc561\uc758 \uc0c9\uc744 \ud478\ub978\uc0c9\uc73c\ub85c \ubcc0\ud654\uc2dc\ud0a4\ub294 \uc774\uc628\uc774 \uc0dd\uc131\ub418\ub294 \uacfc\uc815\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uad6c\ub9ac\uc640 \uc9c8\uc0b0 \uc740 \uc218\uc6a9\uc561\uc758 \ubc18\uc751 \ud654\ud559 \uc2dd $Cu + 2Ag^+ \\rightarrow Cu^{2+} + 2Ag$\uc5d0\uc11c \uac01 \ud654\ud559\uc885\uc758 \uc5ed\ud560 \ubc0f \ubcc0\ud654\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
