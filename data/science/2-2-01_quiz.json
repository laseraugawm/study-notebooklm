        {
          "text": "\uc9c0\uad6c \ub0b4\ubd80\uc758 \ud575\ubd84\uc5f4 \ubc18\uc751\uc5d0 \uc758\ud574 \uc0dd\uc131\ub41c \uc704\uce58 \uc5d0\ub108\uc9c0\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud654\uc11d \uc5f0\ub8cc\ub294 \uc9c0\uad6c \ub0b4\ubd80 \ud575\ubd84\uc5f4\uc774 \uc544\ub2cc \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub97c \uadfc\uc6d0\uc73c\ub85c \ud558\ub294 \uc720\uae30\ubb3c\uc758 \ud654\ud559 \uc5d0\ub108\uc9c0\uc785\ub2c8\ub2e4."
