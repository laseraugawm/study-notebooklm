      "question": "\ud0dc\uc591 \uc5d0\ub108\uc9c0\uac00 \uc0dd\ubb3c\uacc4\ub85c \ub4e4\uc5b4\uc640 \uc804\ud658\ub418\uace0 \uc774\ub3d9\ud558\ub294 \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc2dd\ubb3c\uc758 \uad11\ud569\uc131\uc5d0 \uc758\ud574 \ud654\ud559 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub41c \ud6c4 \uba39\uc774\uadf8\ubb3c\uc744 \ub530\ub77c \uc774\ub3d9\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0dd\ubb3c\uacc4\uc5d0\uc11c\ub294 \uc2dd\ubb3c\uc774 \ube5b\uc5d0\ub108\uc9c0\ub97c \ud654\ud559 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud558\uc5ec \uc720\uae30\ubb3c\uc5d0 \uc800\uc7a5\ud558\uace0, \uc774 \uc5d0\ub108\uc9c0\uac00 \uba39\uc774\uadf8\ubb3c\uc744 \ud1b5\ud574 \ub3d9\ubb3c\ub85c \uc804\ub2ec\ub429\ub2c8\ub2e4."
        },
        {
          "text": "\uc2dd\ubb3c\uc774 \ud761\uc218\ud55c \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub294 \uc989\uc2dc \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \ubcc0\ud558\uc5ec \uc138\ud3ec\ud638\ud761 \uc5c6\uc774 \ubc29\ucd9c\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc2dd\ubb3c\uc774 \ud761\uc218\ud55c \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub294 \uc6b0\uc120 \uad11\ud569\uc131\uc744 \ud1b5\ud574 \ud654\ud559 \uc5d0\ub108\uc9c0\ub85c \uc800\uc7a5\ub41c \ub4a4 \uc0dd\uba85 \ud65c\ub3d9\uacfc \uba39\uc774\uadf8\ubb3c \uc774\ub3d9\uc5d0 \uc4f0\uc785\ub2c8\ub2e4."
