        {
          "text": "\ub300\uae30 \ub300\uc21c\ud658\uacfc \ud574\ub958\uc5d0 \uc758\ud55c \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \ub545\uc18d\uc5d0 \ub204\uc801\ub41c \uac83\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc14\ub78c\uacfc \ud574\ub958\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub294 \uae30\uc0c1 \ud604\uc0c1\uc744 \uc77c\uc73c\ud0a4\uc9c0\ub9cc \ud654\uc11d \uc5f0\ub8cc\uc758 \ud615\uc131\uacfc\ub294 \uc9c1\uc811\uc801\uc778 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
