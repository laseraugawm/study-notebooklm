{
  "title": "\ud0dc\uc591\uc5d0\ub108\uc9c0 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ud0dc\uc591 \uc911\uc2ec\ubd80\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \uc218\uc18c \ud575\uc735\ud569 \ubc18\uc751\uacfc \uc5d0\ub108\uc9c0 \uc0dd\uc131 \uc6d0\ub9ac\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "4\uac1c\uc758 \uc218\uc18c \uc6d0\uc790\ud575\uc774 \uc735\ud569\ud558\uc5ec 1\uac1c\uc758 \ud5ec\ub968 \uc6d0\uc790\ud575\uc774 \ub418\uba70, \uc904\uc5b4\ub4e0 \uc9c8\ub7c9\ub9cc\ud07c \uc5d0\ub108\uc9c0\uac00 \ubc29\ucd9c\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud0dc\uc591 \uc911\uc2ec\ubd80\uc5d0\uc11c\ub294 4\uac1c\uc758 \uc218\uc18c \uc6d0\uc790\ud575\uc774 \uc735\ud569\ud558\uc5ec 1\uac1c\uc758 \ud5ec\ub968 \uc6d0\uc790\ud575\uc744 \ud615\uc131\ud560 \ub54c \uac10\uc18c\ud55c \uc9c8\ub7c9(\uc9c8\ub7c9 \uacb0\uc190)\uc774 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\uc2dc\ud0a4\ub294 \uadfc\uc6d0\uc774 \ub429\ub2c8\ub2e4."
        },
        {
          "text": "4\uac1c\uc758 \ud5ec\ub968 \uc6d0\uc790\ud575\uc774 \uc735\ud569\ud558\uc5ec 1\uac1c\uc758 \uc218\uc18c \uc6d0\uc790\ud575\uc774 \ub420 \ub54c \ubc29\ucd9c\ub418\ub294 \uc5d0\ub108\uc9c0\ub97c \ud65c\uc6a9\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubc18\uc751\uc758 \ucd9c\ubc1c \ubb3c\uc9c8\uc740 \ud5ec\ub968\uc774 \uc544\ub2cc 4\uac1c\uc758 \uc218\uc18c \uc6d0\uc790\ud575\uc774\uba70, \uc0dd\uc131\ub418\ub294 \ubb3c\uc9c8\uc774 1\uac1c\uc758 \ud5ec\ub968 \uc6d0\uc790\ud575\uc785\ub2c8\ub2e4."
        },
        {
          "text": "\uc218\uc18c \uc6d0\uc790\ud575\uc774 \ubd84\uc5f4\ud558\uba74\uc11c \ubc18\uc751 \uc804\ubcf4\ub2e4 \uc9c8\ub7c9\uc774 \uc99d\uac00\ud560 \ub54c \uc5d0\ub108\uc9c0\uac00 \ubc29\ucd9c\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud0dc\uc591 \uc911\uc2ec\ubd80\uc758 \ubc18\uc751\uc740 \ud575\ubd84\uc5f4\uc774 \uc544\ub2cc \ud575\uc735\ud569 \ubc18\uc751\uc774\uba70, \uc9c8\ub7c9\uc774 \uc99d\uac00\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc904\uc5b4\ub4e4\uba74\uc11c \uc5d0\ub108\uc9c0\uac00 \ubc29\ucd9c\ub429\ub2c8\ub2e4."
        },
        {
          "text": "1\uac1c\uc758 \ud5ec\ub968 \uc6d0\uc790\ud575 \uc9c8\ub7c9\uc740 \uc735\ud569\ud558\uae30 \uc804 4\uac1c\uc758 \uc218\uc18c \uc6d0\uc790\ud575 \uc9c8\ub7c9 \ud569\ubcf4\ub2e4 \uc57d\uac04 \ud06c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\uc131\ub41c \ud5ec\ub968 \uc6d0\uc790\ud575 1\uac1c\uc758 \uc9c8\ub7c9\uc740 \ubc18\uc751 \uc804 4\uac1c\uc758 \uc218\uc18c \uc6d0\uc790\ud575 \uc9c8\ub7c9\uc758 \ud569\ubcf4\ub2e4 \uc57d\uac04 \uc791\uae30 \ub54c\ubb38\uc5d0 \uadf8 \ucc28\uc774\ub9cc\ud07c\uc758 \uc5d0\ub108\uc9c0\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4."
        }
      ],
      "hint": "\ubc18\uc751\uc5d0 \ucc38\uc5ec\ud558\ub294 \uc6d0\uc790\ud575\uc758 \uc885\ub958\uc640 \ubc18\uc751 \uc804\ud6c4\uc758 \uc9c8\ub7c9 \ubcc0\ud654 \ubc29\ud5a5\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc9c0\uad6c\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ud0dc\uc591 \uc5d0\ub108\uc9c0\uc758 \uc591\uc801 \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\uad6c \uc804 \uc9c0\uc5ed\uc5d0 \ud55c \uc2dc\uac04 \ub3d9\uc548 \ub3c4\ub2ec\ud558\ub294 \ud0dc\uc591 \uc5d0\ub108\uc9c0\uc591\uc740 \uc778\ub958\uac00 \uc77c \ub144 \ub3d9\uc548 \uc0ac\uc6a9\ud558\ub294 \uc5d0\ub108\uc9c0\uc591\uacfc \ube44\uc2b7\ud558\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc9c0\uad6c\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub294 \ub9e4 \uc21c\uac04 \ub9c9\ub300\ud55c \uc591\uc5d0 \ub2ec\ud558\uc5ec \ub2e8 1\uc2dc\uac04 \ubd84\ub7c9\ub9cc\uc73c\ub85c\ub3c4 \uc778\ub958 \uc804\uccb4\uc758 1\ub144 \uc0ac\uc6a9\ub7c9\uacfc \ub9de\uba39\uc2b5\ub2c8\ub2e4."
        },
        {
          "text": "\ud0dc\uc591\uc5d0\uc11c \ubc29\ucd9c\ub418\ub294 \ub9c9\ub300\ud55c \uc591\uc758 \uc5d0\ub108\uc9c0 \uc911 \ub300\ubd80\ubd84\uc774 \uc9c0\uad6c\uc5d0 \ub3c4\ub2ec\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud0dc\uc591\uc5d0\uc11c \ubc29\ucd9c\ub41c \uc5d0\ub108\uc9c0\ub294 \uc0ac\ubc29\uc73c\ub85c \ud37c\uc838 \ub098\uac00\ubbc0\ub85c \uadf8\uc911 \ub9e4\uc6b0 \uc77c\ubd80\ub9cc\uc774 \uc9c0\uad6c\uc5d0 \ub3c4\ub2ec\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uad6c \uc804 \uc9c0\uc5ed\uc5d0 \uc77c \ub144 \ub3d9\uc548 \ub3c4\ub2ec\ud558\ub294 \ud0dc\uc591 \uc5d0\ub108\uc9c0\uc591\uc740 \uc778\ub958\uac00 \uc77c \ub144 \ub3d9\uc548 \uc0ac\uc6a9\ud558\ub294 \uc591\uc758 \uc77c\ubd80\ubd84\uc5d0 \ubd88\uacfc\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud55c \uc2dc\uac04 \ub3d9\uc548 \ub3c4\ub2ec\ud558\ub294 \uc591\ub9cc\uc73c\ub85c\ub3c4 \uc778\ub958\uc758 1\ub144 \uc0ac\uc6a9\ub7c9\uacfc \ube44\uc2b7\ud560 \uc815\ub3c4\ub85c \uc9c0\uad6c\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub294 \ub9e4\uc6b0 \ub9c9\ub300\ud569\ub2c8\ub2e4."
        },
        {
          "text": "\uc9c0\uad6c\uc5d0 \ub3c4\ub2ec\ud55c \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub294 \ub354 \uc774\uc0c1 \ub2e4\ub978 \ud615\ud0dc\uc758 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\uc9c0 \uc54a\uace0 \uc18c\uba78\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uad6c\uc5d0 \ub4e4\uc5b4\uc628 \ud0dc\uc591 \uc5d0\ub108\uc9c0\ub294 \uc9c0\uad6c\uc2dc\uc2a4\ud15c\uc758 \uac01 \uad8c\uc744 \uc774\ub3d9\ud558\uba70 \uc704\uce58, \uc6b4\ub3d9, \ud654\ud559 \uc5d0\ub108\uc9c0 \ub4f1 \ub2e4\uc591\ud558\uac8c \uc804\ud658\ub429\ub2c8\ub2e4."
        }
      ],
      "hint": "\ud0dc\uc591 \uc5d0\ub108\uc9c0\uac00 \uc9c0\uad6c\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ube44\uc728\uacfc \ub2e8 \ud55c \uc2dc\uac04 \ub3d9\uc548 \ub3c4\ub2ec\ud558\ub294 \uc5d0\ub108\uc9c0\uc758 \uac00\uce58\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
