    {
      "type": "multiple_choice",
      "question": "\uc778\ub958\uac00 \uc8fc\uc694 \uc5d0\ub108\uc9c0\uc6d0\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ud654\uc11d \uc5f0\ub8cc\uc758 \uadfc\uc6d0\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
