        {
          "text": "\ube57\ubc29\uc6b8\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \uc9c0\uac01 \ubcc0\ub3d9\uc744 \ubc1b\uc544 \uc5f4\uc5d0\ub108\uc9c0\ub85c \uace0\ucc29\ub41c \uac83\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube57\ubc29\uc6b8\uc758 \ub099\ud558\ub294 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uc758 \uc608\uc2dc\uc774\uba70, \ud654\uc11d \uc5f0\ub8cc\ub294 \uc0dd\ubb3c\uccb4 \ub0b4\uc5d0 \uc800\uc7a5\ub41c \ud654\ud559 \uc5d0\ub108\uc9c0\uc5d0\uc11c \ube44\ub86f\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
