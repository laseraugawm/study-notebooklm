    {
      "type": "multiple_choice",
      "question": "\ud0dc\uc591 \uc5d0\ub108\uc9c0\uac00 \uc9c0\uad6c\uc5d0\uc11c \ubb3c\uc758 \uc21c\ud658\uc744 \uc77c\uc73c\ud0ac \ub54c, \ub300\uae30\uc640 \uc9c0\ud45c\uc5d0 \ud761\uc218\ub41c \ud0dc\uc591 \uc5d0\ub108\uc9c0\uac00 \ubb3c\uc744 \uc99d\ubc1c\uc2dc\ucf1c \uad6c\ub984\uc744 \ub9cc\ub4e4\uba70 \uc804\ud658\ub418\ub294 \uc8fc\uc694 \uc5d0\ub108\uc9c0 \ud615\ud0dc\ub294?",
      "answerOptions": [
        {
          "text": "\uad6c\ub984\uc758 \uc704\uce58 \uc5d0\ub108\uc9c0",
          "isCorrect": true,
          "rationale": "\uc218\uc99d\uae30\uac00 \uc99d\ubc1c\ud558\uc5ec \ub192\uc740 \uacf3\uc73c\ub85c \uc62c\ub77c\uac00 \uad6c\ub984\uc744 \ud615\uc131\ud558\uba74 \ub192\uc774\uc5d0 \uc758\ud55c \uc704\uce58 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub429\ub2c8\ub2e4."
