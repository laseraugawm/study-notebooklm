        {
          "text": "\ud0dc\uc591\uc758 \ud575\uc5d0\ub108\uc9c0",
          "isCorrect": false,
          "rationale": "\ud575\uc5d0\ub108\uc9c0\ub294 \ud0dc\uc591 \ub0b4\ubd80 \uc218\uc18c \ud575\uc735\ud569 \ubc18\uc751 \uc2dc \ubc29\ucd9c\ub418\ub294 \uadfc\uc6d0 \uc5d0\ub108\uc9c0\uc774\uba70, \uc9c0\uad6c \uc218\uad8c \ubc0f \uae30\uad8c\uc5d0\uc11c\uc758 \uc5d0\ub108\uc9c0 \uc804\ud658 \ud615\ud0dc\uac00 \uc544\ub2d9\ub2c8\ub2e4."
        }
