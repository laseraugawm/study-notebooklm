        {
          "text": "\uacf5\uae30\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0",
          "isCorrect": false,
          "rationale": "\uacf5\uae30\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub294 \ubc14\ub78c\uc774\ub098 \ub300\uae30 \ub300\uc21c\ud658\uc744 \ubc1c\uc0dd\uc2dc\ud0a4\ub294 \uacfc\uc815\uc5d0 \uc8fc\ub85c \uad00\ub828\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
