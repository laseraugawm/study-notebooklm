        {
          "text": "\ud0dc\uc591 \uc5d0\ub108\uc9c0\ub294 \ub3d9\ubb3c\uc758 \uc138\ud3ec\ud638\ud761\uc744 \ud1b5\ud574\uc11c\ub9cc \ucd5c\ucd08\ub85c \ud654\ud559 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub41c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud0dc\uc591 \uc5d0\ub108\uc9c0\ub97c \ucd5c\ucd08\ub85c \ud654\ud559 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud558\ub294 \uc8fc\uccb4\ub294 \ub3d9\ubb3c\uc758 \uc138\ud3ec\ud638\ud761\uc774 \uc544\ub2c8\ub77c \uc2dd\ubb3c\uc758 \uad11\ud569\uc131\uc785\ub2c8\ub2e4."
