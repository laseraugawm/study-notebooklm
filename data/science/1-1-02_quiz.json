    {
      "type": "multiple_choice",
      "question": "\ud604\uc7ac \uc9c0\uad6c\uc0c1\uc5d0 \ub2e4\uc591\ud55c \uc0dd\ubb3c\uc885\uc774 \uc874\uc7ac\ud558\uac8c \ub41c \uc6d0\uc778\uc744 \uc790\uc5f0\uc120\ud0dd\uc124\uacfc \uad00\ub828\uc9c0\uc5b4 \uac00\uc7a5 \uc62c\ubc14\ub974\uac8c \uc124\uba85\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud558\ub098\uc758 \uc870\uc0c1 \uc0dd\ubb3c\uc774 \ub2e4\uc591\ud55c \ud658\uacbd\uc73c\ub85c \ud37c\uc9c4 \ud6c4 \uac01 \ud658\uacbd\uc5d0 \uc801\uc751\ud55c \ubcc0\uc774\ub97c \uc9c0\ub2cc \uac1c\uccb4\ub4e4\uc774 \ub3c5\ub9bd\uc801\uc73c\ub85c \uc790\uc5f0\uc120\ud0dd\ub418\uc5c8\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc870\uc0c1 \uc0dd\ubb3c\uc774 \ub2e4\uc591\ud55c \ud658\uacbd\uc73c\ub85c \ud37c\uc9c0\uba74\uc11c \uac01\uac01\uc758 \ud658\uacbd\uc801 \uc120\ud0dd \uc555\ub825\uc5d0 \uc54c\ub9de\uc740 \ubcc0\uc774\uac00 \ub204\uc801 \uc120\ud0dd\ub418\uc5b4 \uc0dd\ubb3c\ub2e4\uc591\uc131\uc774 \ud615\uc131\ub418\uc5c8\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \uc0dd\ubb3c\uc774 \ud558\ub098\uc758 \uace0\uc815\ub41c \ud658\uacbd\uc5d0\uc11c \ub3d9\uc77c\ud55c \uc120\ud0dd \uc555\ub825\uc744 \ubc1b\uc544 \uc77c\uc9c1\uc120 \ubc29\ud5a5\uc73c\ub85c\ub9cc \ubcc0\ud654\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\uad6c\uc0c1\uc758 \ud658\uacbd\uc740 \ub9e4\uc6b0 \ub2e4\uc591\ud558\uba70 \uac01 \uc11c\uc2dd\uc9c0\ub9c8\ub2e4 \ub2e4\ub978 \uc120\ud0dd \uc555\ub825\uc774 \uc791\uc6a9\ud558\uc600\uae30 \ub54c\ubb38\uc5d0 \uc5ec\ub7ec \ubc29\ud5a5\uc73c\ub85c \ub2e4\uc591\ud558\uac8c \uc9c4\ud654\ud558\uc600\ub2e4."
        },
        {
