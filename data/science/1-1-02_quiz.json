      "hint": "\ud540\uc14b\uc5d0 \uc758\ud574 \uc81c\uac70\ub418\uc5b4 \uc2e4\ud5d8\ud310\uc5d0\uc11c \uc5c6\uc5b4\uc9c0\ub294 \uc774\uc464\uc2dc\uac1c\uac00 \ud3ec\uc2dd \uad00\uacc4\uc5d0\uc11c \uc758\ubbf8\ud558\ub294 \ubc14\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc0ac\ub791\uc575\ubb34\ub294 \uac1c\uccb4\ub9c8\ub2e4 \uae43\ud138\uc758 \uc0c9\uae54\uc774 \ub9e4\uc6b0 \ub2e4\uc591\ud558\uac8c \ub098\ud0c0\ub09c\ub2e4. \uc774\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ub791\uc575\ubb34 \uac1c\uccb4\ub294 \uc0b4\uc544\uac00\ub294 \ub3d9\uc548 \ud658\uacbd \ubcc0\ud654\uc5d0 \uc801\uc751\ud558\uae30 \uc704\ud574 \uc0c9\uc18c \ub2e8\ubc31\uc9c8 \uc720\uc804\uc815\ubcf4\ub97c \uc2a4\uc2a4\ub85c \ubc14\uafc0 \uc218 \uc788\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\uccb4 \uc0dd\uc560 \ub3d9\uc548 \ud658\uacbd\uc5d0 \ub9de\ucd94\uc5b4 \uc720\uc804\uc815\ubcf4\ub97c \uc790\ubc1c\uc801\uc73c\ub85c \ubc14\uafb8\ub294 \uac83\uc740 \ubd88\uac00\ub2a5\ud558\uba70, \ubcc0\uc774\ub294 \ud0dc\uc5b4\ub0a0 \ub54c\ubd80\ud130 \uac00\uc9c0\uace0 \uc788\ub294 \uc720\uc804\uc815\ubcf4 \ucc28\uc774\uc5d0 \ub530\ub978\ub2e4."
        },
        {
          "text": "\uac1c\uccb4\ub9c8\ub2e4 \uac00\uc9c0\uace0 \uc788\ub294 \uc720\uc804\uc815\ubcf4\uc758 \ucc28\uc774\uc5d0 \uc758\ud574 \uc0dd\uc131\ub418\ub294 \uc0c9\uc18c \ub2e8\ubc31\uc9c8\uc758 \uc885\ub958\uc640 \uc591\uc774 \ub2e4\ub974\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0ac\ub791\uc575\ubb34 \uac1c\uccb4\ubcc4 \uc720\uc804\uc815\ubcf4 \ucc28\uc774\uac00 \uc0c9\uc18c \ub2e8\ubc31\uc9c8 \ud569\uc131\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc5b4 \uae43\ud138 \uc0c9\uc774 \ub2ec\ub77c\uc9c4\ub2e4."
