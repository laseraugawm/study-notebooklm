    {
      "type": "multiple_choice",
      "question": "\uadf8\ub79c\ub4dc\uce90\ub2c8\uc5b8\uc758 \ud770\uaf2c\ub9ac\uc601\uc591\ub2e4\ub78c\uc950\uc640 \ud574\ub9ac\uc2a4\uc601\uc591\ub2e4\ub78c\uc950\uc758 \uc885 \ubd84\ud654 \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub450 \uc885\ub958\uc758 \uc601\uc591\ub2e4\ub78c\uc950\ub294 \uc720\uc804\uc801 \uae30\uc6d0\uc774 \uc804\ud600 \ub2e4\ub978 \ubcc4\uac1c\uc758 \uc870\uc0c1 \ubb34\ub9ac\ub85c\ubd80\ud130 \uac01\uac01 \uc720\ub798\ud558\uc600\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub450 \ub2e4\ub78c\uc950\ub294 \uc804\ud600 \ub2e4\ub978 \uc870\uc0c1\uc774 \uc544\ub2cc, \uac19\uc740 \uacf5\ud1b5 \uc870\uc0c1 \ub2e4\ub78c\uc950 \ubb34\ub9ac\uac00 \ud611\uace1\uc5d0 \uc758\ud574 \ubd84\ub9ac\ub418\uba74\uc11c \uc11c\ub85c \ub2e4\ub978 \uc885\uc73c\ub85c \uac08\ub77c\uc9c4 \uac83\uc774\ub2e4."
