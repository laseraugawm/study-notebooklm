        {
          "text": "\ub098\ubb34 \uc774\uc464\uc2dc\uac1c\uc640 \ub179\ub9d0 \uc774\uc464\uc2dc\uac1c\uc758 \ucc28\uc774 $\rightarrow$ \uc0dd\ubb3c \ubb34\ub9ac \ub0b4 \uac1c\uccb4\ub4e4\uc758 \ubcc0\uc774",
          "isCorrect": false,
          "rationale": "\uc7ac\uc9c8\uacfc \ubaa8\uc591\uc758 \ucc28\uc774\ub294 \ud3ec\uc2dd\uc790\uc5d0\uac8c \ubc1c\uacac\ub420 \ud655\ub960\uc774 \ub2e4\ub978 \uc0dd\ubb3c\uc758 \ud615\uc9c8 \ucc28\uc774(\ubcc0\uc774)\ub97c \ubaa8\uc758\ud55c \uac83\uc774\ub2e4."
        },
        {
          "text": "\uc774\uc464\uc2dc\uac1c\ub97c \ucc3e\uc544 \uc9d1\uc5b4\ub0b4\ub294 \ud540\uc14b $\rightarrow$ \ud3ec\uc2dd\uc790 \ub610\ub294 \ud658\uacbd \uc120\ud0dd \uc555\ub825",
          "isCorrect": false,
          "rationale": "\ud540\uc14b\uc740 \uc0dd\ubb3c\uc744 \ud3ec\uc2dd\ud558\uac70\ub098 \uc81c\uc5b4\ud558\ub294 \ud658\uacbd \uc694\uc778(\ud3ec\uc2dd\uc790)\uc744 \ub098\ud0c0\ub0b8\ub2e4."
