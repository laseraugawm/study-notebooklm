    {
      "type": "multiple_choice",
      "question": "\uc790\uc5f0\uc120\ud0dd\uc744 \uc774\ud574\ud558\uae30 \uc704\ud574 \uc2e4\uc2dc\ud55c '\uc774\uc464\uc2dc\uac1c \ubaa8\uc758\uc2e4\ud5d8'\uc758 \uad6c\uc131 \uc694\uc18c\uc640 \uc2e4\uc81c \uc790\uc5f0 \ud604\uc0c1\uc758 \ube44\uc720\uac00 \uc798\ubabb \uc5f0\uacb0\ub41c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud540\uc14b\uc73c\ub85c \uc774\uc464\uc2dc\uac1c\ub97c \uc9d1\uc5b4 \uc81c\uac70\ud558\ub294 \uacfc\uc815 $\\rightarrow$ \uc0dd\ubb3c \uac1c\uccb4\uc758 \uc790\uc190 \uc0dd\uc0b0 \ud65c\ub3d9",
          "isCorrect": true,
          "rationale": "\ud540\uc14b\uc73c\ub85c \uc774\uc464\uc2dc\uac1c\ub97c \uc9d1\uc5b4 \uc81c\uac70\ud558\ub294 \ud589\uc704\ub294 \ud3ec\uc2dd\uc790\uc5d0 \uc758\ud574 \uc0dd\ubb3c\uc774 \ud53c\uc2dd\ub418\uc5b4 \ub3c4\ud0dc\ub418\ub294 \uacfc\uc815\uc744 \uc758\ubbf8\ud558\uc9c0 \uc790\uc190 \uc0dd\uc0b0\uc774 \uc544\ub2c8\ub2e4."
        },
        {
          "text": "\ubc14\ub2e5\uc5d0 \uae54\ub9b0 \uc885\uc774\uc758 \uc0c9\uae54 $\rightarrow$ \uc0dd\ubb3c\uc774 \uc11c\uc2dd\ud558\ub294 \uc790\uc5f0 \ud658\uacbd",
          "isCorrect": false,
          "rationale": "\ud669\uac08\uc0c9 \ub610\ub294 \ub179\uc0c9 \uc885\uc774\ub294 \uac1c\uccb4\uc758 \ub208\uc5d0 \ub744\ub294 \uc815\ub3c4\ub97c \uacb0\uc815\ud558\ub294 \uc11c\uc2dd\uc9c0 \ubc14\ud0d5 \ud658\uacbd\uc744 \uc758\ubbf8\ud55c\ub2e4."
