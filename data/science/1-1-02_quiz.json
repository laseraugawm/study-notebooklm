        {
          "text": "\ub3d9\uc77c\ud55c \uc885 \ub0b4\uc5d0\uc11c \uac1c\uccb4\ub9c8\ub2e4 \uae43\ud138 \uc0c9\uc774 \ub2e4\ub974\uac8c \ub098\ud0c0\ub098\ub294 \ud604\uc0c1\uc740 '\ubcc0\uc774'\uc758 \ub300\ud45c\uc801\uc778 \uc0ac\ub840\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc885 \ub0b4\uc5d0\uc11c \ub098\ud0c0\ub098\ub294 \uc0dd\uae40\uc0c8\ub098 \uc0c9\uc758 \uac1c\uccb4 \ucc28\uc774\ub294 \ubcc0\uc774\uc758 \uc815\uc758\uc5d0 \uc815\ud655\ud788 \ubd80\ud569\ud55c\ub2e4."
        },
        {
          "text": "\uc0dd\uc874\uc5d0 \uc720\ub9ac\ud55c \uae43\ud138 \uc0c9\uc744 \uac00\uc9c4 \uac1c\uccb4\uac00 \ub354 \ub9ce\uc774 \uc0b4\uc544\ub0a8\uc544 \ub354 \ub9ce\uc740 \uc790\uc190\uc744 \ub0a8\uae38 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc5f0\uc120\ud0dd\uc758 \uc6d0\ub9ac\uc5d0 \ub530\ub77c \uc11c\uc2dd \ud658\uacbd\uc5d0\uc11c \ub208\uc5d0 \ub744\uc9c0 \uc54a\uac70\ub098 \uc0dd\uc874\uc5d0 \uc720\ub9ac\ud55c \uc0c9\uc744 \uac00\uc9c4 \uac1c\uccb4\uac00 \ub354 \ub192\uc740 \ubc88\uc2dd \uc131\uacf5\ub960\uc744 \ubcf4\uc778\ub2e4."
        }
