        {
          "text": "\uaca9\ub9ac\ub41c \ub450 \ub2e4\ub78c\uc950 \ubb34\ub9ac\ub294 \ub0a8\ucabd\uacfc \ubd81\ucabd\uc758 \uc11c\ub85c \ub2e4\ub978 \ud658\uacbd \uc870\uac74\uc5d0 \ub9de\ucd94\uc5b4 \ub3c5\ub9bd\uc801\uc73c\ub85c \uc790\uc5f0\uc120\ud0dd\ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c0\ud615\uc801\uc73c\ub85c \ucc28\ub2e8\ub41c \ub450 \ubb34\ub9ac\ub294 \uac01 \uc9c0\uc5ed\uc758 \uc790\uc5f0 \ud658\uacbd\uc5d0 \uc720\ub9ac\ud55c \ud615\uc9c8\uc744 \uc704\uc8fc\ub85c \uc790\uc5f0\uc120\ud0dd\uc774 \uc9c4\ud589\ub418\uc5c8\ub2e4."
