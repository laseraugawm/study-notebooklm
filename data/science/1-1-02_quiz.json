        {
          "text": "\ucf5c\ub85c\ub77c\ub3c4\uac15\uc5d0 \uc758\ud55c \uac70\ub300\ud55c \ud611\uace1 \ud615\uc131\uc774 \ub2e4\ub78c\uc950 \ubb34\ub9ac\ub97c \ub458\ub85c \ub098\ub204\ub294 \uc9c0\ud615\uc801 \uc7a5\ubcbd \uc5ed\ud560\uc744 \ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud611\uace1\uc774 \ud615\uc131\ub418\uba74\uc11c \uc870\uc0c1 \ub2e4\ub78c\uc950 \ubb34\ub9ac\uac00 \ub0a8\ubd81\uc73c\ub85c \uaca9\ub9ac\ub418\uc5b4 \uad50\ub958\uac00 \ucc28\ub2e8\ub418\uc5c8\ub2e4."
