{
  "title": "\uc9c4\ud654\ub860 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uac19\uc740 \uc885\uc758 \uc0dd\ubb3c \ubb34\ub9ac \ub0b4\uc5d0\uc11c \uac1c\uccb4\ub9c8\ub2e4 \ub098\ud0c0\ub098\ub294 \ud615\uc9c8\uc758 \ucc28\uc774\ub97c '\ubcc0\uc774'\ub77c\uace0 \ud55c\ub2e4. \uc774\ub7ec\ud55c \ubcc0\uc774\uac00 \ubc1c\uc0dd\ud558\ub294 \uadfc\ubcf8\uc801\uc778 \uc6d0\uc778\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac1c\uccb4\ub9c8\ub2e4 \uac00\uc9c0\uace0 \uc788\ub294 \uc720\uc804\uc815\ubcf4\uac00 \ub2ec\ub77c \ub9cc\ub4e4\uc5b4\uc9c0\ub294 \ub2e8\ubc31\uc9c8\uc758 \uc885\ub958\uc640 \uc591\uc774 \ub2e4\ub974\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud615\uc9c8\uc740 \uc720\uc804\uc815\ubcf4\uc5d0 \uc758\ud574 \ud569\uc131\ub418\ub294 \ub2e8\ubc31\uc9c8\uc758 \uc885\ub958\uc640 \uc591\uc5d0 \ub530\ub77c \uacb0\uc815\ub418\ubbc0\ub85c \uc720\uc804\uc815\ubcf4\uc758 \ucc28\uc774\uac00 \ubcc0\uc774\uc758 \uadfc\ubcf8\uc801\uc778 \uc6d0\uc778\uc774 \ub41c\ub2e4."
        },
        {
          "text": "\uac1c\uccb4\uac00 \uc0b4\uc544\uc788\ub294 \ub3d9\uc548 \ud658\uacbd\uc5d0 \uc801\uc751\ud558\uba70 \ud68d\ub4dd\ud55c \ud615\uc9c8\uc774 \uc790\uc190\uc5d0\uac8c \uadf8\ub300\ub85c \uc804\ub2ec\ub418\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud68d\ub4dd \ud615\uc9c8\uc740 \uc720\uc804\uc815\ubcf4\uc758 \ubcc0\ud654\uc5d0 \uc758\ud55c \uac83\uc774 \uc544\ub2c8\ubbc0\ub85c \uc790\uc190\uc5d0\uac8c \uc720\uc804\ub418\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \uac1c\uccb4\uac00 \uc644\uc804\ud788 \ub3d9\uc77c\ud55c \ub2e8\ubc31\uc9c8\uc744 \ub9cc\ub4e4\uc5b4\ub0b4\uc9c0\ub9cc \ud658\uacbd\uc5d0 \ub530\ub77c \uae30\ub2a5\uc774 \ubcc0\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uccb4 \uac04 \ubcc0\uc774\ub294 \ub3d9\uc77c\ud55c \ub2e8\ubc31\uc9c8\uc758 \uae30\ub2a5 \ubcc0\ud654 \ub54c\ubb38\uc774 \uc544\ub2c8\ub77c \ud569\uc131\ub418\ub294 \ub2e8\ubc31\uc9c8 \uc885\ub958\uc640 \uc591\uc758 \ucc28\uc774 \ub54c\ubb38\uc5d0 \ubc1c\uc0dd\ud55c\ub2e4."
        },
        {
          "text": "\ud3ec\uc2dd\uc790\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc0dd\ubb3c \uac1c\uccb4\uac00 \uc720\uc804\uc815\ubcf4\ub97c \uc2a4\uc2a4\ub85c \ubcc0\ud654\uc2dc\ud0a4\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ubcc0\uc774\ub294 \ud658\uacbd\uc774\ub098 \ud3ec\uc2dd\uc790\uc5d0 \ub9de\ucd94\uc5b4 \uc0dd\ubb3c\uc774 \uc758\ub3c4\uc801\uc73c\ub85c \uc720\uc804\uc815\ubcf4\ub97c \ubcc0\uacbd\ud558\uc5ec \ub9cc\ub4dc\ub294 \uac83\uc774 \uc544\ub2c8\ub2e4."
        }
      ],
      "hint": "\uc720\uc804\uc815\ubcf4\uac00 \uc5b4\ub5a4 \ubb3c\uc9c8\ub85c \ubc1c\ud604\ub418\uc5b4 \ud615\uc9c8\uc774 \ub098\ud0c0\ub098\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud574\ubc1c $3700\\text{ m}$ \uc774\uc0c1\uc758 \uace0\uc9c0\ub300\uc5d0 \uc11c\uc2dd\ud558\ub294 \uc0ac\uc0ac\ud328\ubaa8 \ubb34\ub9ac\uc5d0\uc11c \ucc44\uc9d1 \ud658\uacbd\uc5d0 \ub530\ub77c \uac1c\uccb4 \uc0c9\uae54 \ube44\uc728\uc774 \ub2e4\ub974\uac8c \ub098\ud0c0\ub098\ub294 \ud604\uc0c1\uc5d0 \ub300\ud55c \ud574\uc11d\uc73c\ub85c \uac00\uc7a5 \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ub78c\uc774 \uc811\uadfc\ud558\uae30 \uc26c\uc6b4 \uacf3\uc5d0\uc11c\ub294 \uc8fc\ubcc0 \ub3cc\uacfc \ube44\uc2b7\ud55c \ud68c\uc0c9\uc774\ub098 \uac08\uc0c9 \uac1c\uccb4\uac00 \uc790\uc5f0\uc120\ud0dd\ub418\uc5b4 \uc0b4\uc544\ub0a8\uc740 \ube44\uc728\uc774 \ub192\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0ac\ub78c\uc758 \ucc44\uc9d1\uc774 \ud65c\ubc1c\ud55c \uacf3\uc5d0\uc11c\ub294 \ub208\uc5d0 \uc798 \ub744\ub294 \ub179\uc0c9 \uac1c\uccb4\uac00 \uc8fc\ub85c \ucc44\uc9d1\ub418\uc5b4 \ub3c4\ud0dc\ub418\uace0, \ub3cc\uacfc \uc0c9\uc774 \ube44\uc2b7\ud55c \uac1c\uccb4\ub4e4\uc774 \uc0b4\uc544\ub0a8\uc544 \uc790\uc190\uc744 \ub0a8\uacbc\ub2e4."
        },
        {
          "text": "\uc0ac\ub78c\uc774 \uc811\uadfc\ud558\uae30 \uc5b4\ub824\uc6b4 \uacf3\uc5d0\uc11c\ub294 \ub179\uc0c9 \uac1c\uccb4\uac00 \ucc44\uc9d1\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc790\ubc1c\uc801\uc73c\ub85c \uac08\uc0c9\uc73c\ub85c \uc0c9\uc744 \ubc14\uafb8\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uccb4\uac00 \uc2a4\uc2a4\ub85c \ud658\uacbd\uc5d0 \ub9de\ucd94\uc5b4 \uc0c9\uc18c \ub2e8\ubc31\uc9c8 \ud615\uc9c8\uc744 \uc758\ub3c4\uc801\uc73c\ub85c \ubc14\uafb8\ub294 \uac83\uc740 \ubd88\uac00\ub2a5\ud558\ub2e4."
        },
        {
          "text": "\ucc44\uc9d1 \ud65c\ub3d9\uc774 \ud65c\ubc1c\ud55c \uc9c0\uc5ed\uc77c\uc218\ub85d \ud3ec\uc2dd\uc790\uc758 \ub208\uc5d0 \uc798 \ub744\ub294 \ub179\uc0c9 \uac1c\uccb4\uc758 \ube44\uc728\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uc99d\uac00\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc44\uc9d1\uc774 \ud65c\ubc1c\ud55c \uacf3\uc5d0\uc11c\ub294 \ub208\uc5d0 \uc798 \ub744\ub294 \ub179\uc0c9 \uac1c\uccb4\uac00 \uba3c\uc800 \ucc44\uc9d1\ub418\ubbc0\ub85c \ube44\uc728\uc774 \uac10\uc18c\ud55c\ub2e4."
        },
        {
          "text": "\uc0ac\ub78c\uc758 \ucc44\uc9d1 \ud65c\ub3d9\uc740 \uc0ac\uc0ac\ud328\ubaa8 \ubb34\ub9ac\uc5d0 \uc0c8\ub85c\uc6b4 \ub3cc\uc5f0\ubcc0\uc774\ub97c \uc9c1\uc811 \uc720\ubc1c\ud558\ub294 \uc6d0\uc778\uc73c\ub85c \uc791\uc6a9\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucc44\uc9d1 \ud65c\ub3d9\uc740 \uae30\uc874\uc758 \ubcc0\uc774 \uc911 \uc11c\uc2dd\uc5d0 \uc720\ub9ac\ud55c \ud615\uc9c8\uc744 \uc120\ud0dd\ud558\ub294 \ud658\uacbd \uc555\ub825(\uc120\ud0dd \uc555\ub825)\uc73c\ub85c \uc791\uc6a9\ud560 \ubfd0 \ubcc0\uc774 \uc790\uccb4\ub97c \uc9c1\uc811 \ub9cc\ub4e4\uc5b4\ub0b4\uc9c0 \uc54a\ub294\ub2e4."
        }
      ],
      "hint": "\ud3ec\uc2dd\uc790(\uc778\uac04)\uc758 \ub208\uc5d0 \ub744\uc9c0 \uc54a\ub294 \uc0c9\uc744 \ub764 \uac1c\uccb4\uac00 \uc0dd\uc874\ud558\uace0 \ubc88\uc2dd\ud560 \ud655\ub960\uc744 \uace0\ub824\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc708\uc774 \uc81c\uc548\ud55c \uc790\uc5f0\uc120\ud0dd\uc124\uc5d0 \ub530\ub978 \uc0dd\ubb3c\uc758 \uc9c4\ud654 \uacfc\uc815\uc73c\ub85c \uac00\uc7a5 \uc62c\ubc14\ub978 \uc21c\uc11c\ub294?",
      "answerOptions": [
        {
          "text": "\uacfc\uc789 \uc0dd\uc0b0\uacfc \ubcc0\uc774 $\\rightarrow$ \uc0dd\uc874 \uacbd\uc7c1 $\rightarrow$ \uc0dd\uc874\uc5d0 \uc720\ub9ac\ud55c \uac1c\uccb4\uc758 \uc790\uc5f0\uc120\ud0dd $\rightarrow$ \ud615\uc9c8 \uc804\ub2ec \ubc0f \uc0dd\ubb3c \ubb34\ub9ac \uad6c\uc131 \ubcc0\ud654",
          "isCorrect": true,
          "rationale": "\ub2e4\uc591\ud55c \ubcc0\uc774\ub97c \uac00\uc9c4 \uc790\uc190\ub4e4\uc774 \uacfc\uc789 \uc0dd\uc0b0\ub41c \ud6c4 \uc0dd\uc874 \uacbd\uc7c1\uc744 \uac70\uccd0 \uc720\ub9ac\ud55c \ud615\uc9c8\uc744 \uac00\uc9c4 \uac1c\uccb4\uac00 \uc120\ud0dd\ub418\uc5b4 \uc218\uc138\ub300\uc5d0 \uac78\uccd0 \uc9d1\ub2e8 \uad6c\uc131\uc774 \ubcc0\ud55c\ub2e4."
        },
        {
          "text": "\uc0dd\uc874 \uacbd\uc7c1 $\rightarrow$ \ud658\uacbd \uc801\uc751\uc744 \uc704\ud55c \ubcc0\uc774 \ubc1c\uc0dd $\rightarrow$ \uacfc\uc789 \uc0dd\uc0b0 $\rightarrow$ \ub2e8\uc77c \uac1c\uccb4 \uc218\uc900\uc758 \uc9c4\ud654",
          "isCorrect": false,
          "rationale": "\ubcc0\uc774\ub294 \uc0dd\uc874 \uacbd\uc7c1 \uacb0\uacfc \ud658\uacbd \uc801\uc751\uc744 \uc704\ud574 \uc0dd\uaca8\ub098\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uacbd\uc7c1 \uc774\uc804\ubd80\ud130 \ubb34\ub9ac \ub0b4\uc5d0 \ub2e4\uc591\ud558\uac8c \uc874\uc7ac\ud55c\ub2e4."
        },
        {
          "text": "\ubcc0\uc774\uc758 \uc758\ub3c4\uc801 \ubc1c\uc0dd $\rightarrow$ \uacfc\uc789 \uc0dd\uc0b0 $\rightarrow$ \ud658\uacbd\uc5d0 \ubd80\ud569\ud558\ub294 \uc120\ud0dd $\rightarrow$ \uac1c\uccb4\uc758 \uc720\uc804\uc815\ubcf4 \ubcc0\ud654",
          "isCorrect": false,
          "rationale": "\uc0dd\ubb3c\uc774 \ud658\uacbd\uc5d0 \uc801\uc751\ud558\uae30 \uc704\ud574 \ubcc0\uc774\ub97c \uc758\ub3c4\uc801\uc73c\ub85c \uc720\ub3c4\ud558\uac70\ub098 \ubc1c\uc0dd\uc2dc\ud0a4\ub294 \uac83\uc740 \uc544\ub2c8\ub2e4."
        },
        {
          "text": "\uc790\uc5f0\uc120\ud0dd $\rightarrow$ \uc0dd\uc874 \uacbd\uc7c1 \ubc1c\uc0dd $\rightarrow$ \uc0c8\ub85c\uc6b4 \uc720\uc804\uc815\ubcf4\uc758 \ud615\uc131 $\rightarrow$ \uacfc\uc789 \uc0dd\uc0b0",
          "isCorrect": false,
          "rationale": "\uc790\uc5f0\uc120\ud0dd\uc740 \uc0dd\uc874 \uacbd\uc7c1\uc758 \uacb0\uacfc\ub85c \uc77c\uc5b4\ub098\ub294 \ub2e8\uacc4\uc774\uba70 \uacbd\uc7c1 \uc774\uc804\uc5d0 \uc77c\uc5b4\ub0a0 \uc218 \uc5c6\ub2e4."
        }
      ],
      "hint": "\ubcc0\uc774\uac00 \uc774\ubbf8 \uc874\uc7ac\ud558\ub294 \uc0c1\ud0dc\uc5d0\uc11c \ubb34\ub9ac\uac00 \uc790\uc190\uc744 \ub9ce\uc774 \ub0b3\uc740 \ub4a4 \uacbd\uc7c1\uacfc \uc120\ud0dd\uc774 \uc77c\uc5b4\ub098\ub294 \uacfc\uc815\uc744 \uc21c\uc11c\ub300\ub85c \uc815\ub9ac\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc708\uc774 \ucc98\uc74c \uc790\uc5f0\uc120\ud0dd\uc124\uc744 \ubc1c\ud45c\ud588\uc744 \ub2f9\uc2dc, \uadf8\uc758 \uc774\ub860\uc774 \uac00\uc84c\ub358 \uc8fc\uc694 \ud55c\uacc4\uc810\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uac1c\uccb4\ub9c8\ub2e4 \ubcc0\uc774\uac00 \ub098\ud0c0\ub098\ub294 \uacfc\ud559\uc801\uc778 \uc6d0\uc778\uacfc \uc720\uc804 \uba54\ucee4\ub2c8\uc998\uc744 \uba85\ud655\ud788 \uc124\uba85\ud558\uc9c0 \ubabb\ud588\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub2e4\uc708 \uc2dc\ub300\uc5d0\ub294 \uc720\uc804\ubb3c\uc9c8(DNA)\uc774\ub098 \uc720\uc804 \ubc95\uce59\uc5d0 \ub300\ud55c \uc9c0\uc2dd\uc774 \uc815\ub9bd\ub418\uc9c0 \uc54a\uc544 \ubcc0\uc774\uac00 \uc77c\uc5b4\ub098\ub294 \uc6d0\uc778\uc744 \uc124\uba85\ud558\uc9c0 \ubabb\ud558\ub294 \ud55c\uacc4\uac00 \uc788\uc5c8\ub2e4."
        },
        {
          "text": "\uac08\ub77c\ud30c\uace0\uc2a4 \uc81c\ub3c4 \ud540\uce58\uc0c8\uc758 \ubd80\ub9ac \ubaa8\uc591 \ucc28\uc774\ub97c \uad00\ucc30\ud558\ub294 \ub370 \uc2e4\ud328\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e4\uc708\uc740 \ube44\uae00\ud638 \ud56d\ud574 \uc911 \uac08\ub77c\ud30c\uace0\uc2a4 \uc81c\ub3c4\uc5d0\uc11c \uba39\uc774\uc5d0 \ub530\ub978 \ud540\uce58\uc0c8 \ubd80\ub9ac\uc758 \ucc28\uc774\ub97c \uba85\ud655\ud788 \uad00\ucc30\ud558\uc600\ub2e4."
        },
        {
          "text": "\uc790\uc5f0\uc120\ud0dd\uc774 \uc0dd\ubb3c \ubb34\ub9ac\uc758 \uad6c\uc131 \ubcc0\ud654\ub97c \uc77c\uc73c\ud0a8\ub2e4\ub294 \ud575\uc2ec \uc8fc\uc7a5\uc744 \uc2a4\uc2a4\ub85c \ucca0\ud68c\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e4\uc708\uc740 \ud0d0\uad6c \uacb0\uacfc\ub97c \ubc14\ud0d5\uc73c\ub85c \uc790\uc5f0\uc120\ud0dd\uc124\uc744 \uccb4\uacc4\ud654\ud558\uc5ec \uc9c4\ud654\uc758 \uc6d0\ub9ac\ub85c \ub05d\uae4c\uc9c0 \uc8fc\uc7a5\ud558\uc600\ub2e4."
        },
        {
          "text": "\ube44\uae00\ud638 \ud56d\ud574 \uc870\uc0ac \uacfc\uc815\uc744 \uac70\uce58\uc9c0 \uc54a\uace0 \ubb38\ud5cc \ub370\uc774\ud130\uc5d0\ub9cc \uc758\uc874\ud558\uc5ec \uc774\ub860\uc744 \uc138\uc6e0\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e4\uc708\uc740 \uc57d 5\ub144\uac04 \ube44\uae00\ud638\ub97c \ud0c0\uace0 \uc138\uacc4\ub97c \uc9c1\uc811 \ud56d\ud574\ud558\uba70 \ud604\uc7a5 \uad00\ucc30\uacfc \ucc44\uc9d1\uc744 \uc218\ud589\ud558\uc600\ub2e4."
        }
      ],
      "hint": "\uba58\ub378\uc758 \uc720\uc804 \ubc95\uce59\uc774\ub098 DNA \uad6c\uc870\uac00 \ubc1d\ud600\uc9c0\uae30 \uc774\uc804 \uc2dc\ub300\uc758 \ud559\ubb38\uc801 \ud55c\uacc4\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uac08\ub77c\ud30c\uace0\uc2a4 \uc81c\ub3c4\uc758 \uc5ec\ub7ec \uc12c\uc5d0 \uc11c\uc2dd\ud558\ub294 \ud540\uce58\uc0c8\uc758 \ubd80\ub9ac \ubaa8\uc591\uc774 \uc12c\ub9c8\ub2e4 \ub2e4\ub974\uac8c \uc9c4\ud654\ud55c \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub0a8\uc544\uba54\ub9ac\uce74 \ub300\ub959\uc5d0\uc11c \uac74\ub108\uc628 \uc870\uc0c1 \ud540\uce58\uac00 \uc5ec\ub7ec \uc12c\uc73c\ub85c \ud37c\uc9c4 \ud6c4 \uac01 \uc12c\uc758 \uba39\uc774 \ud658\uacbd\uc5d0 \uc801\uc751\ud55c \ubd80\ub9ac\ub97c \uc9c0\ub2cc \uac1c\uccb4\ub4e4\uc774 \uc790\uc5f0\uc120\ud0dd\ub418\uc5c8\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud558\ub098\uc758 \uc870\uc0c1 \ud540\uce58 \ubb34\ub9ac\uac00 \uac01 \uc12c\uc758 \uba39\uc774(\uc120\uc778\uc7a5, \uc528\uc557, \uace4\ucda9 \ub4f1)\ub97c \uba39\uae30\uc5d0 \uc720\ub9ac\ud55c \ubd80\ub9ac \ud615\uc9c8\uc744 \uc9c0\ub2cc \uac1c\uccb4 \uc704\uc8fc\ub85c \uc790\uc5f0\uc120\ud0dd\ub418\uc5b4 \ub2e4\uc591\ud55c \uc885\uc73c\ub85c \ubd84\ud654\ud588\ub2e4."
        },
        {
          "text": "\uac01 \uc12c\uc5d0 \uc6d0\ub798 \uc0b4\ub358 \uc11c\ub85c \ub2e4\ub978 \uc870\uc0c1 \uc0c8\ub4e4\uc774 \uad50\ubc30\ub97c \uac70\uce58\uba74\uc11c \ubd80\ub9ac \ubaa8\uc591\uc774 \uc720\uc0ac\ud558\uac8c \ubcc0\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud540\uce58\uc0c8\ub4e4\uc740 \uc11c\ub85c \ub2e4\ub978 \uae30\uc6d0\uc758 \uc870\uc0c1\ub4e4\uc774 \uc11e\uc778 \uac83\uc774 \uc544\ub2c8\ub77c \ub0a8\uc544\uba54\ub9ac\uce74 \ub300\ub959\uc5d0\uc11c \uac74\ub108\uc628 \ud558\ub098\uc758 \uacf5\ud1b5 \uc870\uc0c1\uc5d0\uc11c \ubd84\ud654\ub41c \uac83\uc774\ub2e4."
        },
        {
          "text": "\ud540\uce58\uc0c8 \uac1c\uccb4\ub4e4\uc774 \ub2e8\ub2e8\ud55c \uc528\uc557\uc744 \uae68\ub728\ub9ac\uae30 \uc704\ud574 \ubd80\ub9ac\ub97c \uc790\uc8fc \uc0ac\uc6a9\ud558\uc5ec \ubd80\ub9ac\uac00 \uc810\ucc28 \ud06c\uace0 \ud2bc\ud2bc\ud574\uc84c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc8fc \uc0ac\uc6a9\ud558\uc5ec \ud615\uc9c8\uc774 \ubcc0\ud588\ub2e4\ub294 \uc124\uba85\uc740 \uc6a9\ubd88\uc6a9\uc124\uc5d0 \ud574\ub2f9\ud558\ub294 \uc624\uac1c\ub150\uc73c\ub85c \uc790\uc5f0\uc120\ud0dd\uc5d0 \uc758\ud55c \uc9c4\ud654 \ubc29\uc2dd\uc774 \uc544\ub2c8\ub2e4."
        },
        {
