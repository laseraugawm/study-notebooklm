        {
          "text": "\uc5ec\ub7ec \uc138\ub300\ub97c \uac70\uce58\uba74\uc11c \uc0b4\uc544\ub0a8\uc740 \uac1c\uccb4\ub4e4\uc758 \ud615\uc9c8 \ucc28\uc774\uac00 \ub204\uc801\ub418\uc5b4 \uacb0\uad6d \uc11c\ub85c \ub2e4\ub978 \uc885\uc774 \ub418\uc5c8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc790\uc5f0\uc120\ud0dd\uc774 \uc7a5\uae30\uac04 \ub3c5\ub9bd\uc801\uc73c\ub85c \ub204\uc801\ub418\uc5b4 \uc6d0\ub798 \uc870\uc0c1 \uc0dd\ubb3c\uacfc \uad50\ubc30\ud560 \uc218 \uc5c6\ub294 \ub3c5\ub9bd\ub41c \uc885\uc73c\ub85c \uc9c4\ud654\ud558\uc600\ub2e4."
        }
