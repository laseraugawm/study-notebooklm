        {
          "text": "\u3131, \u3134, \u3137",
          "isCorrect": true,
          "rationale": "\uc0dd\ubb3c\ub2e4\uc591\uc131\ud611\uc57d(CBD)\uc740 \uc0dd\ubb3c\ub2e4\uc591\uc131 \ubcf4\uc804, \uad6c\uc131 \uc694\uc18c\uc758 \uc9c0\uc18d\uac00\ub2a5\ud55c \uc774\uc6a9, \uc720\uc804\uc790\uc6d0 \uc774\uc6a9 \uc774\uc775\uc758 \uacf5\uc815\u00b7\uacf5\ud3c9\ud55c \uacf5\uc720\ub97c 3\ub300 \ubaa9\uc801\uc73c\ub85c \uc0bc\ub294\ub2e4."
        }
      ],
      "hint": "\uc0dd\ubb3c\ub2e4\uc591\uc131\ud611\uc57d\uc740 \ubcf4\uc804\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc774\uc6a9\uacfc \uc774\uc775 \uacf5\uc720\uae4c\uc9c0 \ub2e4\ub8e8\uace0 \uc788\uc2b5\ub2c8\ub2e4."
    },
