{
  "title": "\uc0dd\ubb3c\ub2e4\uc591\uc131 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc0dd\ubb3c\ub2e4\uc591\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc9c0\uad6c\uc5d0 \uc11c\uc2dd\ud558\ub294 \uc0dd\ubb3c\uc758 \ub2e4\uc591\ud55c \uc815\ub3c4\ub97c \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\ubb3c\ub2e4\uc591\uc131\uc740 \uc9c0\uad6c\uc0c1\uc5d0 \uc11c\uc2dd\ud558\ub294 \uc0dd\ubb3c\uc758 \ub2e4\uc591\ud55c \uc815\ub3c4\ub97c \ub73b\ud558\ub294 \uae30\ubcf8 \uc815\uc758\uc774\ub2e4."
        },
        {
          "text": "\ud604\uc7ac\uae4c\uc9c0 \uc9c0\uad6c\uc0c1\uc5d0\uc11c \uacf5\uc2dd\uc801\uc73c\ub85c \ud655\uc778\ub41c \uc0dd\ubb3c\uc885 \uc218\ub294 \ucc9c\ub9cc \uc885 \uc774\uc0c1\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud604\uc7ac\uae4c\uc9c0 \ud655\uc778\ub41c \uc0dd\ubb3c\uc885 \uc218\ub294 190\uc5ec\ub9cc \uc885\uc774\uba70, \ubbf8\ud655\uc778 \uc885\uae4c\uc9c0 \ud569\ucce4\uc744 \ub54c \uc2e4\uc81c \uc9c0\uad6c\uc5d0 \ucc9c\ub9cc \uc885 \uc774\uc0c1 \uc874\uc7ac\ud560 \uac83\uc73c\ub85c \ucd94\uc815\ub41c\ub2e4."
        },
        {
          "text": "\uc885\ub2e4\uc591\uc131, \uc720\uc804\uc801 \ub2e4\uc591\uc131, \uc0dd\ud0dc\uacc4\ub2e4\uc591\uc131\uc744 \ubaa8\ub450 \ud3ec\ud568\ud558\ub294 \ub113\uc740 \uac1c\ub150\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\ubb3c\ub2e4\uc591\uc131\uc740 \uc885\uc758 \ub2e4\uc591\ud568\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc720\uc804\uc790 \ub2e4\uc591\uc131 \ubc0f \uc11c\uc2dd \ud658\uacbd\uc758 \ub2e4\uc591\uc131\uc744 \ubaa8\ub450 \ud3ec\ud568\ud55c\ub2e4."
        },
        {
          "text": "\uc0dd\ubb3c\uc740 \ubcc0\ud654\ud558\ub294 \ud658\uacbd \uc870\uac74\uc5d0 \uc801\uc751\ud558\uba74\uc11c \uc810\uc810 \ub2e4\uc591\ud574\uc9c0\uace0 \ubcf5\uc7a1\ud574\uc838 \uc654\ub2e4.",
          "isCorrect": false,
          "rationale": "\ucd5c\ucd08\uc758 \uc0dd\uba85 \ud0c4\uc0dd \uc774\ud6c4 \uc0dd\ubb3c\uc740 \ud658\uacbd \ubcc0\ud654\uc5d0 \uc801\uc751\ud558\uba70 \uc9c4\ud654\ud574 \uc654\ub2e4."
        }
      ],
      "hint": "\ud655\uc778\ub41c \uc0dd\ubb3c\uc885 \uc218\uc640 \ubbf8\ud655\uc778 \uc885\uc744 \ud3ec\ud568\ud55c \ucd94\uc815 \uc0dd\ubb3c\uc885 \uc218\ub97c \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 '\uc720\uc804\uc801 \ub2e4\uc591\uc131'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud55c \uc9c0\uc5ed\uc5d0 \uc11c\uc2dd\ud558\ub294 \uc0dd\ubb3c\uc885\uc758 \uc885\ub958\uac00 \uc5bc\ub9c8\ub098 \ud48d\ubd80\ud55c\uc9c0\ub97c \ub098\ud0c0\ub0b8\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud55c \uc9c0\uc5ed \ub0b4 \uc11c\uc2dd\ud558\ub294 \uc0dd\ubb3c\uc885\uc758 \ub2e4\uc591\ud55c \uc815\ub3c4\ub294 \uc885\ub2e4\uc591\uc131\uc5d0 \ud574\ub2f9\ud558\ub294 \uc124\uba85\uc774\ub2e4."
        },
        {
          "text": "\uac19\uc740 \uc885\uc758 \uc0dd\ubb3c \ubb34\ub9ac \ub0b4\uc5d0\uc11c \uac1c\uccb4\ub9c8\ub2e4 \uc720\uc804\uc815\ubcf4\uac00 \ub2ec\ub77c \ub2e4\uc591\ud55c \ubcc0\uc774\uac00 \ub098\ud0c0\ub098\ub294 \uc815\ub3c4\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc720\uc804\uc801 \ub2e4\uc591\uc131\uc740 \ub3d9\uc77c \uc0dd\ubb3c\uc885 \ub0b4\uc5d0\uc11c \uac1c\uccb4\ub9c8\ub2e4 \uac00\uc9c0\uace0 \uc788\ub294 \uc720\uc804\uc815\ubcf4\uc758 \ucc28\uc774\ub85c \uc778\ud574 \ud615\uc9c8 \ubcc0\uc774\uac00 \uc77c\uc5b4\ub098\ub294 \uc815\ub3c4\ub97c \ub9d0\ud55c\ub2e4."
        },
        {
          "text": "\uc720\uc804\uc801 \ub2e4\uc591\uc131\uc774 \ub192\uc744\uc218\ub85d \uae09\uaca9\ud55c \ud658\uacbd \ubcc0\ud654\uac00 \uc77c\uc5b4\ub0ac\uc744 \ub54c \ubb34\ub9ac \uc804\uccb4\uac00 \uba78\uc885\ud560 \ud655\ub960\uc774 \ub192\uc544\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc720\uc804\uc801 \ub2e4\uc591\uc131\uc774 \ub192\uc744\uc218\ub85d \ubcc0\ud654\ub41c \ud658\uacbd\uc5d0 \uc0b4\uc544\ub0a8\uc744 \uc218 \uc788\ub294 \uc801\uc751 \uac1c\uccb4\uac00 \uc874\uc7ac\ud560 \uac00\ub2a5\uc131\uc774 \ub192\uc544 \uba78\uc885 \ud655\ub960\uc774 \ub0ae\uc544\uc9c4\ub2e4."
        },
        {
          "text": "\uc0ac\ub9c9, \uc2b5\uc9c0, \uc5f4\ub300\uc6b0\ub9bc, \ubc14\ub2e4 \ub4f1 \ub2e4\uc591\ud55c \uc11c\uc2dd \ud658\uacbd\uc774 \uc874\uc7ac\ud558\ub294 \uac83\uc744 \uc758\ubbf8\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0dd\ubb3c\uc774 \uc11c\uc2dd\ud560 \uc218 \uc788\ub294 \ud658\uacbd \uc870\uac74\uc758 \ub2e4\uc591\ud568\uc740 \uc0dd\ud0dc\uacc4\ub2e4\uc591\uc131\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        }
      ],
      "hint": "\uac1c\uccb4 \uac04\uc758 \ubb34\ub2ac, \uc0dd\uae40\uc0c8 \ub4f1 \ubcc0\uc774\uac00 \ub098\ud0c0\ub098\ub294 \uc6d0\uc778\uacfc \uad00\ub828\uc774 \uc788\uc2b5\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc0dd\ud0dc\uacc4\uc758 \uc885\ub2e4\uc591\uc131\uacfc \uc548\uc815\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc11c\uc2dd\ud558\ub294 \uc0dd\ubb3c\uc885\uc758 \uc218\uac00 \ub9ce\uc744\uc218\ub85d \uc885\ub2e4\uc591\uc131\uc774 \ub192\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc11c\uc2dd\ud558\ub294 \uc0dd\ubb3c\uc885\uc758 \uc218\uac00 \ub2e4\uc591\ud558\uace0 \ud48d\ubd80\ud560\uc218\ub85d \uc885\ub2e4\uc591\uc131\uc774 \ub192\ub2e4."
        },
        {
          "text": "\uc5ec\ub7ec \uc0dd\ubb3c\uc885\uc774 \ud2b9\uc815 \uc885\uc5d0 \uce58\uc6b0\uce58\uc9c0 \uc54a\uace0 \uace0\ub974\uac8c \ubd84\ud3ec\ud560\uc218\ub85d \uc885\ub2e4\uc591\uc131\uc774 \ub192\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc885\ub2e4\uc591\uc131\uc740 \uc885\uc758 \uac1c\uc218\ubfd0\ub9cc \uc544\ub2c8\ub77c \uac01 \uc885\uc758 \ubd84\ud3ec \uade0\ub4f1\ub3c4\uc5d0 \ub530\ub77c \uacb0\uc815\ub41c\ub2e4."
        },
        {
          "text": "\uc885\ub2e4\uc591\uc131\uc774 \ub192\uc740 \uc0dd\ud0dc\uacc4\uc77c\uc218\ub85d \ud55c\ub450 \uc885\uc774 \uc0ac\ub77c\uc84c\uc744 \ub54c \uc0dd\ud0dc\uacc4 \uc804\uccb4\uac00 \uc27d\uac8c \ud30c\uad34\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc885\ub2e4\uc591\uc131\uc774 \ub192\uc73c\uba74 \ud55c\ub450 \uc0dd\ubb3c\uc885\uc774 \uc0ac\ub77c\uc9c0\ub354\ub77c\ub3c4 \uc774\ub97c \ub300\uccb4\ud560 \ub2e4\ub978 \uc0dd\ubb3c\uc885\uc774 \uc874\uc7ac\ud558\ubbc0\ub85c \uc0dd\ud0dc\uacc4\uac00 \uc548\uc815\uc801\uc73c\ub85c \uc720\uc9c0\ub420 \ud655\ub960\uc774 \ub192\uc544\uc9c4\ub2e4."
        },
        {
          "text": "\ucd08\uc6d0 \uc0dd\ud0dc\uacc4\uc5d0 \uc801\uc751\ud558\uc5ec \ub2e4\uc591\ud55c \uc0dd\ubb3c\uc885\uc774 \uc11c\uc2dd\ud558\ub294 \ud604\uc0c1\uc740 \uc885\ub2e4\uc591\uc131\uc758 \uc0ac\ub840\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\ud2b9\uc815 \uc0dd\ud0dc\uacc4 \ub0b4\uc5d0 \ub2e4\uc591\ud55c \uc0dd\ubb3c\uc885\uc774 \uc801\uc751\ud558\uc5ec \uc0b4\uc544\uac00\ub294 \uac83\uc740 \uc885\ub2e4\uc591\uc131\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc608\uc2dc\uc774\ub2e4."
        }
      ],
      "hint": "\uc885\ub2e4\uc591\uc131\uc774 \ub192\uc744 \ub54c \uc0dd\ubb3c \uac04 \uba39\uc774\uc0ac\uc2ac\uc758 \ub300\uccb4 \uac00\ub2a5\uc131\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uad6d\uc81c \uc0ac\ud68c\uac00 \uccb4\uacb0\ud55c '\uc0dd\ubb3c\ub2e4\uc591\uc131\ud611\uc57d(CBD)'\uc758 \uc8fc\uc694 \ubaa9\uc801\uc73c\ub85c \uba85\uc2dc\ub41c \ud56d\ubaa9\ub9cc\uc744 \ubcf4\uae30\uc5d0\uc11c \uc788\ub294 \ub300\ub85c \uace0\ub978 \uac83\uc740?\n\n[\ubcf4\uae30]\n\u3131. \uc0dd\ubb3c\ub2e4\uc591\uc131 \ubcf4\uc804\n\u3134. \uadf8 \uad6c\uc131 \uc694\uc18c\uc758 \uc9c0\uc18d\uac00\ub2a5\ud55c \uc774\uc6a9\n\u3137. \uc0dd\ubb3c \uc720\uc804\uc790\uc6d0\uc758 \uc774\uc6a9\uc73c\ub85c\ubd80\ud130 \ubc1c\uc0dd\ub418\ub294 \uc774\uc775\uc758 \uacf5\uc815\ud558\uace0 \uacf5\ud3c9\ud55c \uacf5\uc720",
      "answerOptions": [
        {
          "text": "\u3131",
          "isCorrect": false,
          "rationale": "\ubcf4\uc804 \uc678\uc5d0\ub3c4 \uc9c0\uc18d\uac00\ub2a5\ud55c \uc774\uc6a9\uacfc \uc774\uc775 \uacf5\uc720\uac00 \uc8fc\uc694 \ubaa9\uc801\uc5d0 \ud3ec\ud568\ub418\uc5b4 \uc788\ub2e4."
