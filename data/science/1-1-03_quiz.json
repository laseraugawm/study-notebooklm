        {
          "text": "2040\ub144\uae4c\uc9c0 \uc9c0\uad6c\uc0c1\uc758 \ubaa8\ub4e0 \ubbf8\ud655\uc778 \uc0dd\ubb3c\uc885 \uc720\uc804\uccb4 \uc870\uc0ac\ub97c \uc644\ub8cc\ud55c\ub2e4.",
          "isCorrect": false,
