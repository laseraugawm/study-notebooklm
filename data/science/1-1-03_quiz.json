    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 '\uc720\uc804\uc801 \ub2e4\uc591\uc131'\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc608\uc2dc\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0ac\ub9c9, \uc2b5\uc9c0, \uc628\ub300\ucd08\uc6d0 \ub4f1 \uc9c0\uad6c\uc0c1\uc5d0 \uc5ec\ub7ec \ud615\ud0dc\uc758 \ud658\uacbd\uc774 \uc874\uc7ac\ud558\ub294 \uac83",
          "isCorrect": false,
          "rationale": "\ub2e4\uc591\ud55c \uc11c\uc2dd \ud658\uacbd\uc774 \uc874\uc7ac\ud558\ub294 \uac83\uc740 \uc0dd\ud0dc\uacc4\ub2e4\uc591\uc131\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\ucd08\uc6d0 \uc0dd\ud0dc\uacc4\uc5d0\uc11c \ud480, \uc5bc\ub8e9\ub9d0, \uc0ac\uc790 \ub4f1 \ub2e4\uc591\ud55c \uc0dd\ubb3c\uc885\uc774 \uc874\uc7ac\ud558\ub294 \uac83",
