{
  "title": "\uae30\ud6c4\ubcc0\ud654 \ud034\uc988",
  "questions": [
    {
      "question": "\uc9c0\uad6c \uc804\uccb4 \uaddc\ubaa8\uc758 \ub300\uae30 \ub300\uc21c\ud658\uc774 \ubc1c\uc0dd\ud558\ub294 \uadfc\ubcf8\uc801\uc778 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc9c0\uad6c \ud615\ud0dc\uac00 \uad6c\ud615\uc774\uc5b4\uc11c \uc704\ub3c4\uc5d0 \ub530\ub77c \uc9c0\ud45c\uac00 \ud761\uc218\ud558\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0 \uc591\uc758 \ucc28\uc774\uac00 \ubc1c\uc0dd\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc9c0\uad6c\uac00 \uad6c\ud615\uc774\uae30 \ub54c\ubb38\uc5d0 \uc800\uc704\ub3c4\uac00 \uace0\uc704\ub3c4\ubcf4\ub2e4 \ub2e8\uc704 \uba74\uc801\ub2f9 \ub354 \ub9ce\uc740 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc5ec \uc774\ub97c \ud574\uc18c\ud558\uae30 \uc704\ud55c \ub300\uae30 \ub300\uc21c\ud658\uc774 \uc77c\uc5b4\ub0a9\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uace0\uc704\ub3c4 \uc9c0\uc5ed\uc774 \uc800\uc704\ub3c4 \uc9c0\uc5ed\ubcf4\ub2e4 \ub2e8\uc704 \uba74\uc801\ub2f9 \ub354 \ub9ce\uc740 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ub2e8\uc704 \uba74\uc801\ub2f9 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub294 \uace0\uc704\ub3c4\uac00 \uc544\ub2c8\ub77c \uc800\uc704\ub3c4 \uc9c0\uc5ed\uc5d0\uc11c \ub354 \ub9ce\uc774 \ud761\uc218\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud574\uc218\uc758 \ud45c\uce35 \uc21c\ud658\uc774 \ub300\uae30 \ud750\ub984\uc744 \uc77c\ubc29\uc801\uc73c\ub85c \uac15\uc81c\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ub300\uae30\uc640 \ud574\uc591\uc740 \uc0c1\ud638\uc791\uc6a9\ud558\uc9c0\ub9cc, \ub300\uae30 \ub300\uc21c\ud658\uc758 \uadfc\ubcf8\uc801\uc778 \uc6d0\uc778\uc740 \uc704\ub3c4\ubcc4 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0 \ud761\uc218\ub7c9\uc758 \ucc28\uc774\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc9c0\uad6c \uae30\uc628 \uc0c1\uc2b9\uc73c\ub85c \uc778\ud574 \uc99d\ubc1c\ub7c9\uc774 \uae09\uaca9\ud788 \uc99d\uac00\ud588\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uae30\uc628 \uc0c1\uc2b9\uc5d0 \ub530\ub978 \uc99d\ubc1c\ub7c9 \uc99d\uac00 \ud6a8\uacfc\ub294 \uc0ac\ub9c9\ud654 \ub4f1\uc5d0 \uc601\ud5a5\uc744 \uc8fc\ub294 \uc694\uc778\uc774\uba70 \ub300\uae30 \ub300\uc21c\ud658\uc758 \uadfc\ubcf8 \ubc1c\uc0dd \uc6d0\uc778\uc740 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc9c0\uad6c\uac00 \ud3c9\ud3c9\ud558\uc9c0 \uc54a\uace0 \ub465\uadfc \ubaa8\uc591\uc744 \ub760\uace0 \uc788\ub2e4\ub294 \uc0ac\uc2e4\uc5d0 \ucc29\uc548\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc704\ub3c4 $20^\\circ \\sim 30^\\circ$ \ubd80\uadfc \uc9c0\uc5ed\uc5d0 \ub300\uaddc\ubaa8 \uc0ac\ub9c9 \uc9c0\ud615\uc774 \ud615\uc131\ub418\uae30 \uc26c\uc6b4 \uc774\uc720\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub300\uae30 \ub300\uc21c\ud658\uc5d0 \uc758\ud574 \ud558\uac15 \uae30\ub958\uac00 \ud615\uc131\ub418\uc5b4 \uad6c\ub984\uc774 \uc798 \uc0dd\uae30\uc9c0 \uc54a\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ud558\uac15 \uae30\ub958\uac00 \ud615\uc131\ub418\ub294 \uc704\ub3c4 $20^\\circ \\sim 30^\\circ$ \ubd80\uadfc\uc740 \uad6c\ub984\uc774 \uc27d\uac8c \uc0dd\uc131\ub418\uc9c0 \uc54a\uc544 \uac74\uc870\ud55c \ub0a0\uc528\uac00 \uc9c0\uc18d\ub418\uc5b4 \uc0ac\ub9c9\uc774 \ud615\uc131\ub429\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub300\uae30 \ub300\uc21c\ud658\uc5d0 \uc758\ud55c \uac15\ud55c \uc0c1\uc2b9 \uae30\ub958\ub85c \uc0c1\uacf5\uc5d0\uc11c \ube44\uad6c\ub984\uc774 \uc9c0\uc18d\ud574\uc11c \ud615\uc131\ub418\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc0c1\uc2b9 \uae30\ub958\uac00 \ubc1c\ub2ec\ud558\uba74 \uad6c\ub984\uc774 \uc0dd\uaca8 \uac15\uc218\ub7c9\uc774 \ub298\uc5b4\ub098\ubbc0\ub85c \uac74\uc870\ud55c \uc9c0\uc5ed\uc774 \ud615\uc131\ub418\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc801\ub3c4 \ubb34\uc5ed\ud48d\uc774 \uac15\ud574\uc9c0\uba74\uc11c \ucc28\uac00\uc6b4 \uc2ec\uce35\uc218\uac00 \ud45c\uce35\uc73c\ub85c \uac15\ud558\uac8c \uc6a9\uc2b9\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc2ec\uce35\uc218\uc758 \uc6a9\uc2b9\uc740 \uc5d8\ub2c8\ub1e8 \ud604\uc0c1 \ubc0f \ud2b9\uc815 \ud574\uc5ed\uc758 \ud45c\uce35 \uc218\uc628 \ubcc0\ud654\uc640 \uad00\ub828\ub41c \ud574\uc591 \ud604\uc0c1\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc800\uc704\ub3c4\uc5d0 \ube44\ud574 \uc9c0\ud45c\uac00 \ud761\uc218\ud558\ub294 \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\uac00 \uac70\uc758 \uc5c6\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc704\ub3c4 $20^\\circ \\sim 30^\\circ$ \uc9c0\uc5ed\uc740 \uc800\uc704\ub3c4 \ubd80\uadfc\uc5d0 \ud574\ub2f9\ud558\uc5ec \ud0dc\uc591 \ubcf5\uc0ac \uc5d0\ub108\uc9c0\ub97c \ube44\uad50\uc801 \ub9ce\uc774 \ud761\uc218\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub300\uae30 \ub300\uc21c\ud658\uc5d0\uc11c \uae30\ub958\uc758 \uc0c1\ud558 \uc774\ub3d9\uc774 \uad6c\ub984 \uc0dd\uc131\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ub2e4\uc74c \uc911 \ud1a0\uc9c0\ub97c \ud669\ud3d0\ud654\ud558\uace0 \uc0ac\ub9c9\ud654\ub97c \uc77c\uc73c\ud0a4\ub294 \uc778\uc704\uc801 \uc694\uc778\uc73c\ub85c \ubcf8\ubb38\uc5d0\uc11c \uc5b8\uae09\ub41c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac74\uc870\ud55c \ucd08\uc6d0 \uc9c0\ub300\uc5d0\uc11c\uc758 \uacfc\uc789 \ubc29\ubaa9\uacfc \ubb34\ubd84\ubcc4\ud55c \ub18d\uacbd\uc9c0 \ud655\uc7a5",
          "rationale": "\uac74\uc870 \ucd08\uc6d0 \uc9c0\ub300\uc758 \uacfc\uc789 \ubc29\ubaa9, \ub18d\uacbd\uc9c0 \ud655\uc7a5, \uc0b0\ub9bc \ubc8c\ucc44 \ub4f1\uc740 \ud1a0\uc9c0\ub97c \ud669\ud3d0\ud654\ud558\ub294 \ub300\ud45c\uc801\uc778 \uc778\uc704\uc801 \uc6d0\uc778\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc778\uacf5\uc704\uc131\uc744 \ud65c\uc6a9\ud558\uc5ec \uc9c0\uad6c \ud658\uacbd \ubcc0\ud654\ub97c \uc9c0\uc18d\ud574\uc11c \uac10\uc2dc\ud558\ub294 \ud589\uc704",
          "rationale": "\uc778\uacf5\uc704\uc131 \uac10\uc2dc\ub294 \uc0ac\ub9c9\ud654\uc758 \uc6d0\uc778\uc774 \uc544\ub2c8\ub77c \uc0ac\ub9c9\ud654\uc640 \uac19\uc740 \uae30\ud6c4 \ubcc0\ud654\ub97c \uc608\uce21\ud558\uace0 \ub300\ube44\ud558\uae30 \uc704\ud55c \ubc29\uc548\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0ac\ub9c9\ud654\ub97c \uacaa\ub294 \uc9c0\uc5ed\uc5d0 \ub098\ubb34\ub97c \uc2ec\ub294 \uc778\uacf5 \uc870\ub9bc \uc2dc\ud589",
          "rationale": "\uc778\uacf5 \uc870\ub9bc\uc740 \uc0ac\ub9c9\ud654\ub97c \ub9c9\uace0 \uc9c0\uad6c \ud658\uacbd\uc744 \ubcf4\uc804\ud558\uae30 \uc704\ud55c \ub300\ucc98 \ub178\ub825\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac00\uc815 \ub0b4 \uc804\ub825 \uc18c\ube44 \uc808\uc57d\uc744 \uc704\ud574 \ub300\uae30 \uc804\ub825\uc744 \ucc28\ub2e8\ud558\ub294 \ub178\ub825",
          "rationale": "\ub300\uae30 \uc804\ub825 \ucc28\ub2e8\uc740 \uc9c0\uad6c \uc628\ub09c\ud654\ub97c \uc644\ud654\ud558\uae30 \uc704\ud55c \uc77c\uc0c1\uc0dd\ud65c\uc5d0\uc11c\uc758 \uc5d0\ub108\uc9c0 \uc808\uc57d \ud589\ub3d9\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc778\uad6c \uc99d\uac00\ub098 \uac00\ucd95 \uc0ac\uc721 \ub4f1 \uc778\uac04\uc758 \ubb34\ubd84\ubcc4\ud55c \ud65c\ub3d9\uacfc \uad00\ub828\ub41c \ud56d\ubaa9\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "\ud3c9\uc0c1\uc2dc \uc801\ub3c4 \ubd80\uadfc \ud0dc\ud3c9\uc591 \ud574\uc5ed\uc758 \ub300\uae30\uc640 \ud574\uc591 \uc0c1\ud0dc\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb34\uc5ed\ud48d\uc774 \ubd88\uc5b4 \ub530\ub73b\ud55c \ud45c\uce35 \ud574\uc218\uac00 \ub3d9\uc5d0\uc11c \uc11c\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uace0, \ub3d9\ud0dc\ud3c9\uc591\uc5d0\uc11c\ub294 \ucc28\uac00\uc6b4 \ubb3c\uc774 \uc0c1\uc2b9\ud55c\ub2e4.",
          "rationale": "\ud3c9\uc0c1\uc2dc\uc5d0\ub294 \ubb34\uc5ed\ud48d\uc5d0 \uc758\ud574 \ub3d9\ud0dc\ud3c9\uc591\uc758 \ub530\ub73b\ud55c \ud45c\uce35 \ud574\uc218\uac00 \uc11c\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uba70, \uadf8 \ube48\uc790\ub9ac\ub97c \ucc44\uc6b0\uae30 \uc704\ud574 \ub3d9\ud0dc\ud3c9\uc591\uc5d0\uc11c \ucc28\uac00\uc6b4 \uc2ec\uce35\uc218\uac00 \uc0c1\uc2b9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubb34\uc5ed\ud48d\uc774 \uc57d\ud574\uc838 \uc11c\ud0dc\ud3c9\uc591\uc73c\ub85c \uc774\ub3d9\ud558\ub294 \ud45c\uce35 \ud574\uc218\uc758 \ud750\ub984\uc774 \uc57d\ud574\uc9c4\ub2e4.",
          "rationale": "\ubb34\uc5ed\ud48d \uc57d\ud654\uc640 \ud45c\uce35 \ud574\uc218 \uc774\ub3d9 \uac10\uc18c\ub294 \ud3c9\uc0c1\uc2dc\uac00 \uc544\ub2c8\ub77c \uc5d8\ub2c8\ub1e8\uac00 \ubc1c\uc0dd\ud588\uc744 \ub54c\uc758 \ud2b9\uc9d5\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc11c\ud0dc\ud3c9\uc591 \uc801\ub3c4 \ubd80\uadfc\uc740 \ud558\uac15 \uae30\ub958\uac00 \ubc1c\uc0dd\ud558\uc5ec \ube44\uac00 \uc801\uac8c \ub0b4\ub9b0\ub2e4.",
          "rationale": "\ud3c9\uc0c1\uc2dc \uc11c\ud0dc\ud3c9\uc591\uc740 \ub530\ub73b\ud55c \ud45c\uce35 \ud574\uc218\uac00 \ubaa8\uc5ec \uc0c1\uc2b9 \uae30\ub958\uac00 \ubc1c\ub2ec\ud558\ubbc0\ub85c \uad6c\ub984\uc774 \ud615\uc131\ub418\uc5b4 \ube44\uac00 \ub9ce\uc774 \ub0b4\ub9bd\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3d9\ud0dc\ud3c9\uc591 \uc5f0\uc548\uc5d0\uc11c\ub294 \uc218\uc628\uc774 \ub192\uc544 \uac15\ud55c \uc0c1\uc2b9 \uae30\ub958\ub85c \ud3ed\uc6b0\uc640 \ud64d\uc218\uac00 \uc790\uc8fc \uc77c\uc5b4\ub09c\ub2e4.",
          "rationale": "\ud3c9\uc0c1\uc2dc \ub3d9\ud0dc\ud3c9\uc591\uc740 \uc2ec\uce35\uc758 \ucc28\uac00\uc6b4 \ubb3c\uc774 \uc0c1\uc2b9\ud558\uc5ec \ud45c\uce35 \uc218\uc628\uc774 \ub0ae\uace0 \uc0c1\ub300\uc801\uc73c\ub85c \ube44\uac00 \uc801\uac8c \ub0b4\ub9bd\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubc14\ub78c\uc758 \ubc29\ud5a5\uacfc \uadf8\ub85c \uc778\ud574 \ud398\ub8e8 \uc5f0\uc548(\ub3d9\ud0dc\ud3c9\uc591) \uc2ec\uce35\uc218\uac00 \uc5b4\ub5bb\uac8c \uc6c0\uc9c1\uc774\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc5d8\ub2c8\ub1e8\uac00 \ubc1c\uc0dd\ud560 \ub54c \uc801\ub3c4 \ubd80\uadfc \ud0dc\ud3c9\uc591\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubb34\uc5ed\ud48d\uc774 \uc57d\ud574\uc9c0\uba74\uc11c \ub3d9\ud0dc\ud3c9\uc591\uc758 \ud45c\uce35 \uc218\uc628\uc774 \ud3c9\ub144\uc5d0 \ube44\ud574 \ub192\uc544\uc9c4\ub2e4.",
          "rationale": "\ubb34\uc5ed\ud48d \uc57d\ud654\ub85c \uc11c\ud0dc\ud3c9\uc591 \uc774\ub3d9 \ud45c\uce35\uc218\uac00 \uc904\uace0 \ub3d9\ud0dc\ud3c9\uc591\uc758 \ucc28\uac00\uc6b4 \ubb3c \uc0c1\uc2b9\uc774 \uc904\uc5b4\ub4e4\uc5b4 \ub3d9\ud0dc\ud3c9\uc591 \uc218\uc628\uc774 \uc0c1\uc2b9\ud558\ub294 \ud604\uc0c1\uc744 \uc5d8\ub2c8\ub1e8\ub77c\uace0 \ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubb34\uc5ed\ud48d\uc774 \uac15\ud654\ub418\uc5b4 \ub3d9\ud0dc\ud3c9\uc591 \uc5f0\uc548\uc758 \uc2ec\uce35\uc218 \uc0c1\uc2b9\ub7c9\uc774 \ud06c\uac8c \ub298\uc5b4\ub09c\ub2e4.",
          "rationale": "\ubb34\uc5ed\ud48d\uc774 \uc57d\ud574\uc9c8 \ub54c \ucc28\uac00\uc6b4 \uc2ec\uce35\uc218\uc758 \uc0c1\uc2b9\ub7c9\uc774 \uc904\uc5b4\ub4ed\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub3d9\ud0dc\ud3c9\uc591\uc758 \uc218\uc628 \uc0c1\uc2b9\uc73c\ub85c \uc778\ud574 \uc0c1\uc2b9 \uae30\ub958\uc758 \uc911\uc2ec\uc774 \uc11c\ucabd\uc73c\ub85c \ub354 \uc774\ub3d9\ud55c\ub2e4.",
          "rationale": "\ub3d9\ud0dc\ud3c9\uc591 \uc218\uc628\uc774 \uc0c1\uc2b9\ud558\uba74 \uc0c1\uc2b9 \uae30\ub958\uc758 \uc911\uc2ec\uc740 \uc11c\ucabd\uc774 \uc544\ub2c8\ub77c \ub3d9\ucabd\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc11c\ud0dc\ud3c9\uc591 \ud45c\uce35 \uc218\uc628\uc774 \ud3c9\ub144\ubcf4\ub2e4 \ub192\uc544\uc9c0\uba74\uc11c \ud3ed\uc6b0\uc640 \ud64d\uc218\uac00 \uc77c\uc5b4\ub09c\ub2e4.",
          "rationale": "\uc5d8\ub2c8\ub1e8 \ubc1c\uc0dd \uc2dc \uc11c\ud0dc\ud3c9\uc591\uc740 \uac15\uc218\ub7c9\uc774 \uac10\uc18c\ud558\uc5ec \uac00\ubb44\uc774\ub098 \ub300\uaddc\ubaa8 \uc0b0\ubd88\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubb34\uc5ed\ud48d\uc758 \uc138\uae30\uac00 \uc57d\ud574\uc9c8 \ub54c \ub3d9\ud0dc\ud3c9\uc591 \ud45c\uce35 \uc218\uc628\uc5d0 \uc77c\uc5b4\ub098\ub294 \ubcc0\ud654\ub97c \ud655\uc778\ud558\uc138\uc694."
    },
    {
      "question": "\uc5d8\ub2c8\ub1e8 \ubc1c\uc0dd \uc2dc \ub098\ud0c0\ub098\ub294 \ud658\uacbd \ubcc0\ud654 \ubc0f \uae30\uc0c1 \uc774\ubcc0\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc54c\ub9de\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub3d9\ud0dc\ud3c9\uc591\uc5d0\uc11c\ub294 \ud64d\uc218\uc640 \ud3ed\uc6b0\uac00 \ubc1c\uc0dd\ud558\uace0, \uc11c\ud0dc\ud3c9\uc591\uc5d0\uc11c\ub294 \uac15\uc218\ub7c9\uc774 \uac10\uc18c\ud558\uc5ec \uac00\ubb44\uc774\ub098 \uc0b0\ubd88\uc774 \uc77c\uc5b4\ub0a0 \uc218 \uc788\ub2e4.",
          "rationale": "\uc0c1\uc2b9 \uae30\ub958 \uc911\uc2ec\uc774 \ub3d9\ucabd\uc73c\ub85c \uc774\ub3d9\ud568\uc5d0 \ub530\ub77c \ub3d9\ud0dc\ud3c9\uc591\uc5d0\ub294 \ud3ed\uc6b0\uc640 \ud64d\uc218\uac00, \uc11c\ud0dc\ud3c9\uc591\uc5d0\ub294 \uac00\ubb44\uacfc \uc0b0\ubd88 \uc704\ud5d8\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
