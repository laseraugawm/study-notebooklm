{
  "title": "\uacfc\ud559\uc724\ub9ac \ud034\uc988",
  "questions": [
    {
      "question": "\uc544\uc774\uc791 \uc544\uc2dc\ubaa8\ud504\uac00 \uc4f4 \uc18c\uc124 \u300e\uc544\uc774, \ub85c\ubd07\u300f\uc5d0\uc11c \uc81c\uc2dc\ub41c '\ub85c\ubd07 3\uc6d0\uce59'\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uccab\uc9f8 \uc6d0\uce59\uc740 \ub85c\ubd07\uc774 \uc790\uc2e0\uc758 \uc548\uc804\uc744 \ucd5c\uc6b0\uc120\uc73c\ub85c \ubcf4\ud638\ud574\uc57c \ud55c\ub2e4\ub294 \uac83\uc774\ub2e4.",
          "rationale": "\uc790\uc2e0\uc744 \ubcf4\ud638\ud558\ub294 \ud56d\ubaa9\uc740 \uc14b\uc9f8 \uc6d0\uce59\uc774\uba70, \uccab\uc9f8\uc640 \ub458\uc9f8 \uc6d0\uce59\uc5d0 \uc5b4\uae0b\ub098\uc9c0 \uc54a\uc544\uc57c \uc791\ub3d9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub458\uc9f8 \uc6d0\uce59\uc778 '\uc0ac\ub78c\uc758 \uba85\ub839\uc744 \ub530\ub978\ub2e4'\ub294 \uccab\uc9f8 \uc6d0\uce59\uc5d0 \uc5b4\uae0b\ub098\uc9c0 \uc54a\ub294 \ud55c\uc5d0\uc11c\ub9cc \uc801\uc6a9\ub41c\ub2e4.",
          "rationale": "\ub85c\ubd07 3\uc6d0\uce59\uc5d0\uc11c \uba85\ub839 \ubcf5\uc885 \uc6d0\uce59\uc740 \uc0ac\ub78c\uc744 \ud574\uce58\uc9c0 \uc54a\uc544\uc57c \ud55c\ub2e4\ub294 \uccab\uc9f8 \uc6d0\uce59\uc758 \ubc94\uc704 \uc548\uc5d0\uc11c\ub9cc \uc131\ub9bd\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc14b\uc9f8 \uc6d0\uce59\uc5d0 \ub530\ub77c \ub85c\ubd07\uc740 \uba85\ub839\uc744 \ubc1b\uc73c\uba74 \uc790\uc2e0\uc744 \ud574\uce58\ub354\ub77c\ub3c4 \ubb34\uc870\uac74 \uba85\ub839\uc744 \uc218\ud589\ud574\uc57c \ud55c\ub2e4.",
          "rationale": "\uc14b\uc9f8 \uc6d0\uce59\uc740 \uccab\uc9f8 \ubc0f \ub458\uc9f8 \uc6d0\uce59\uc5d0 \uc704\ubc30\ub418\uc9c0 \uc54a\ub294 \ud55c \uc790\uae30 \ubcf4\ud638 \uc758\ubb34\ub97c \ubd80\uc5ec\ud558\ub294 \uc870\ud56d\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub85c\ubd07 3\uc6d0\uce59\uc740 \uc0ac\ub78c\uc758 \uc0dd\uba85 \ubcf4\ud638\ubcf4\ub2e4 \ub85c\ubd07\uc758 \uc790\uae30 \ubcf4\uc874\uc744 \uc0c1\uc704 \uc6d0\uce59\uc73c\ub85c \uaddc\uc815\ud55c\ub2e4.",
          "rationale": "\uc778\uac04\uc5d0\uac8c \ud574\ub97c \uc785\ud788\uc9c0 \uc54a\ub294 \uc0dd\uba85 \ubcf4\ud638 \uc6d0\uce59\uc774 \ubaa8\ub4e0 \uc6d0\uce59 \uc911 \ucd5c\uc6b0\uc120 \uc21c\uc704\uc778 \uccab\uc9f8 \uc6d0\uce59\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc0c1\uc704 \uc6d0\uce59\uacfc \ud558\uc704 \uc6d0\uce59 \uac04\uc758 \uc6b0\uc120\uc21c\uc704 \ubc0f \uc801\uc6a9 \uc870\uac74\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uacfc\ud559 \uad00\ub828 \uc0ac\ud68c\uc801 \uc7c1\uc810(SSI)\uc758 \uac1c\ub150 \ubc0f \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uacfc\ud559\uae30\uc220 \ubc1c\uc804 \uacfc\uc815\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ub2e4\uc591\ud55c \uc0ac\ud68c\u00b7\ubb38\ud654\uc801 \uc7c1\uc810\uc744 \ub73b\ud55c\ub2e4.",
          "rationale": "\uacfc\ud559\uae30\uc220\uc774 \uc0ac\ud68c\uc5d0 \ubbf8\uce58\ub294 \uae0d\uc815\uc801\u00b7\ubd80\uc815\uc801 \uc601\ud5a5\uacfc \uad00\ub828\ub41c \ubcf5\ud569\uc801\uc778 \uac08\ub4f1 \uc8fc\uc81c\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud558\ub098\uc758 \uc815\ub2f5\uc774 \ubd84\uba85\ud558\uac8c \uc815\ud574\uc838 \uc788\uc5b4 \uad6c\uc131\uc6d0 \uac04\uc758 \uc0ac\ud68c\uc801 \ud569\uc758\ub098 \ud1a0\ub860\uc774 \ubd88\ud544\uc694\ud558\ub2e4.",
          "rationale": "SSI\ub294 \uc774\ud574\uad00\uacc4\uc790 \uac04 \uc785\uc7a5\uc774 \ub2e4\uc591\ud558\uace0 \ubcf5\uc7a1\ud558\uac8c \uc5bd\ud600 \uc788\uc5b4 \ud1a0\ub860\uacfc \ud611\uc758\ub97c \ud1b5\ud55c \ud569\ub9ac\uc801 \uc758\uc0ac \uacb0\uc815\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubc29\uce58\ud560 \uacbd\uc6b0 \uc0ac\ud68c\uc801 \uac08\ub4f1\uc744 \uc720\ubc1c\ud560 \uc218 \uc788\uc5b4 \ub2e4\uac01\uc801 \uad00\uc810\uc5d0\uc11c\uc758 \uc774\ud574\uac00 \uc694\uad6c\ub41c\ub2e4.",
          "rationale": "\uc11c\ub85c \ub2e4\ub978 \uc774\ud574\uad00\uacc4\uc640 \uac00\uce58\uad00\uc774 \ub300\ub9bd\ud558\ubbc0\ub85c \ud569\uc758 \uacfc\uc815\uc774 \uc5c6\uc744 \uacbd\uc6b0 \uac08\ub4f1\uc774 \uc2ec\ud654\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uae30\ud6c4 \uc704\uae30, \uc6d0\uc790\ub825 \ubc1c\uc804\uc18c \uc548\uc804\uc131, \uc778\uacf5\uc9c0\ub2a5 \uc724\ub9ac \ubb38\uc81c \ub4f1\uc774 \ub300\ud45c\uc801\uc778 \uc608\uc774\ub2e4.",
          "rationale": "\ud658\uacbd, \uc5d0\ub108\uc9c0, \uae30\uc220 \uc724\ub9ac \ub4f1 \ud604\ub300 \uacfc\ud559\uae30\uc220\uacfc \uad00\ub828\ub41c \uc8fc\uc694 \uc0ac\ud68c\uc801 \uc7c1\uc810\ub4e4\uc774 \uc774\uc5d0 \ud3ec\ud568\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc7c1\uc810\uc758 \ud2b9\uc131\uc0c1 \uba85\ud655\ud55c \ub2e8 \ud558\ub098\uc758 \uc815\ub2f5\uc774 \uc874\uc7ac\ud558\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uacfc\ud559 \uc5f0\uad6c\ub97c \uc218\ud589\ud558\uac70\ub098 \uacfc\ud559\uae30\uc220\uc744 \uc774\uc6a9\ud560 \ub54c \uc9c0\ucf1c\uc57c \ud560 \uc6d0\uce59\uc778 '\uacfc\ud559 \uc724\ub9ac'\uc758 \uae30\ubcf8 \uc6d0\uce59\uc73c\ub85c \ubcf8\ubb38\uc5d0 \uc5b8\uae09\ub41c \ub0b4\uc6a9\uc774 \uc544\ub2cc \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0dd\uba85 \uc874\uc911",
          "rationale": "\uacfc\ud559 \uc724\ub9ac\uac00 \uc778\ub958\uc640 \uc0dd\uba85\uccb4 \uc804\uccb4\uc758 \uc774\uc775\uc744 \ub3c4\ubaa8\ud558\uae30 \uc704\ud574 \uc9c0\ucf1c\uc57c \ud560 \ucd5c\uc18c\ud55c\uc758 \ud575\uc2ec \uc6d0\uce59\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc548\uc804",
          "rationale": "\uacfc\ud559\uae30\uc220 \uc774\uc6a9 \uc2dc \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc704\ud5d8\uacfc \uc704\ud574\ub85c\ubd80\ud130 \uc0ac\ud68c\ub97c \ubcf4\ud638\ud558\uae30 \uc704\ud55c \ud544\uc218 \uc724\ub9ac \uae30\uc900\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uacbd\uc81c\uc801 \uc774\uc724 \uadf9\ub300\ud654",
          "rationale": "\uacbd\uc81c\uc801 \uc774\uc724 \uadf9\ub300\ud654\ub294 \uc724\ub9ac\uc801 \uc6d0\uce59\uc774\ub77c\uae30\ubcf4\ub2e4 \uc0b0\uc5c5\uc801\u00b7\uc0c1\uc5c5\uc801 \ubaa9\ud45c\uc5d0 \uac00\uae5d\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud658\uacbd\uc801 \ucc45\uc784",
          "rationale": "\uc9c0\uad6c \uc0dd\ud0dc\uacc4 \ubcf4\ud638 \ubc0f \uc9c0\uc18d \uac00\ub2a5\uc131\uc744 \ub3c4\ubaa8\ud558\ub294 \uacfc\ud559 \uc724\ub9ac\uc758 \uc8fc\uc694 \uc6d0\uce59 \uc911 \ud558\ub098\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uacfc\ud559\uae30\uc220\uc774 \uc778\ub958 \uc804\uccb4\uc5d0\uac8c \uc774\uc775\uc774 \ub418\ub3c4\ub85d \ud558\ub294 \uc724\ub9ac\uc801 \uac00\uce58\uac00 \uc544\ub2cc \ud56d\ubaa9\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    },
    {
      "question": "\uad50\uacfc\uc11c\uc5d0 \uc81c\uc2dc\ub41c \uacfc\ud559 \uad00\ub828 \uc0ac\ud68c\uc801 \uc7c1\uc810\uc758 \ubd84\uc57c\ubcc4 \ubd84\ub958 \uc911 \uc608\uc2dc\uac00 \uc62c\ubc14\ub974\uac8c \uc5f0\uacb0\ub41c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0dd\uba85\uc724\ub9ac - \uc6d0\uc790\ub825 \ubc1c\uc804\uc18c, \ubc29\uc0ac\uc131 \ud3d0\uae30\ubb3c, \ud574\uc591 \uc790\uc6d0 \uc774\uc6a9",
          "rationale": "\uc6d0\uc790\ub825 \ubc1c\uc804\uc774\ub098 \uc790\uc6d0 \uc774\uc6a9\uc740 \uc5d0\ub108\uc9c0 \ubd84\uc57c\uc5d0 \uc18d\ud558\ub294 \uc7c1\uc810\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc5d0\ub108\uc9c0 \ubd84\uc57c - \uc548\ub77d\uc0ac, \ubc30\uc544 \uc5f0\uad6c, \ub9de\ucda4 \uc544\uae30, \uc778\uac04 \ubcf5\uc81c",
          "rationale": "\uc548\ub77d\uc0ac\ub098 \ub9de\ucda4 \uc544\uae30, \uc778\uac04 \ubcf5\uc81c \ub4f1\uc740 \uc0dd\uba85\uc724\ub9ac \ubd84\uc57c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac74\uac15 \ubd84\uc57c - \uc2dd\ud488 \ucca8\uac00\ubb3c, \uac00\uc2b5\uae30 \uc0b4\uade0\uc81c, \ud56d\uc0dd\uc81c \ub0a8\uc6a9, \ube44\ub9cc\uacfc \ub2e4\uc774\uc5b4\ud2b8",
          "rationale": "\uc778\uccb4 \uac74\uac15 \ubc0f \uc9c8\ubcd1, \uc57d\ubb3c \uc624\ub0a8\uc6a9\uacfc \uad00\ub828\ub41c \uc7c1\uc810\ub4e4\uc774 \uac74\uac15 \ubd84\uc57c\ub85c \uc62c\ubc14\ub974\uac8c \ubb36\uc5ec \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud658\uacbd \ubd84\uc57c - \ubbf8\uc138 \uba3c\uc9c0, \uac04\ucc99 \uc0ac\uc5c5, \uc778\uac04 \ubcf5\uc81c, \ub3d9\ubb3c \uc2e4\ud5d8",
          "rationale": "\uc778\uac04 \ubcf5\uc81c\uc640 \ub3d9\ubb3c \uc2e4\ud5d8\uc740 \uc0dd\uba85\uc724\ub9ac \ubd84\uc57c\uc5d0 \uc18d\ud558\ub294 \uc608\uc2dc\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uac01 \uc8fc\uc81c\uac00 \uc0dd\uba85, \uc5d0\ub108\uc9c0, \uac74\uac15, \ud658\uacbd \uc911 \uc5b4\ub290 \uc601\uc5ed\uacfc \uc9c1\uc811 \uad00\ub828\ub418\ub294\uc9c0 \ud30c\uc545\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc778\uacf5\uc9c0\ub2a5\uacfc \ub85c\ubd07 \uae30\uc220\uc758 \ubc1c\uc804\uc73c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc0ac\ud68c\uc801 \ubb38\uc81c\ub85c \ubcf8\ubb38\uc5d0\uc11c \ub358\uc9c4 \uc9c8\ubb38\uc774 \uc544\ub2cc \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\uac00 \uc0ac\uace0\ub97c \ub0b4\uba74 \ub204\uad6c\uc758 \ucc45\uc784\uc77c\uae4c?",
          "rationale": "\uc778\uacf5\uc9c0\ub2a5 \uc791\ub3d9 \uacb0\uacfc\uc5d0 \ub300\ud55c \ubc95\uc801\u00b7\uc724\ub9ac\uc801 \ucc45\uc784 \uc18c\uc7ac\ub97c \ubb3b\ub294 \uc9c8\ubb38\uc73c\ub85c \ubcf8\ubb38\uc5d0 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc778\uacf5\uc9c0\ub2a5\uc774 \uc131\ubcc4\uc774\ub098 \uc778\uc885 \ucc28\ubcc4\uc801\uc778 \ud559\uc2b5\uc744 \ubc1b\uc73c\uba74 \uc5b4\ub5bb\uac8c \ub420\uae4c?",
          "rationale": "\ud559\uc2b5 \ub370\uc774\ud130\uc758 \ud3b8\ud5a5\uc131\uc5d0 \ub530\ub978 \uc724\ub9ac\uc801 \uc704\ud5d8\uc131\uc744 \uc9c0\uc801\ud558\ub294 \uc608\uc2dc\ub85c \uc5b8\uae09\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub85c\ubd07\uc774 \uc2a4\uc2a4\ub85c \ubb34\uc131 \uc0dd\uc2dd\uc744 \ud1b5\ud574 \uc0c8\ub85c\uc6b4 \uc720\uc804\uccb4\ub97c \ubcf5\uc81c\ud574 \ub0bc \uac83\uc778\uac00?",
          "rationale": "\uc774 \ub0b4\uc6a9\uc740 \ubcf8\ubb38\uc5d0 \uc81c\uc2dc\ub41c \uc778\uacf5\uc9c0\ub2a5/\ub85c\ubd07 \uad00\ub828 \uc0ac\ud68c\uc801 \ubb38\uc81c \uc608\uc2dc \uc9c8\ubb38\uc5d0 \ud574\ub2f9\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubc95 \uc9d1\ud589\uc774\ub098 \uc758\ub8cc \uc9c4\ub2e8\uc5d0\uc11c \uc778\uacf5\uc9c0\ub2a5\uc758 \ud310\ub2e8\uc744 \uc5bc\ub9c8\ub098 \uc2e0\ub8b0\ud560 \uc218 \uc788\uc744\uae4c?",
          "rationale": "\uc804\ubb38 \uc601\uc5ed\uc5d0\uc11c AI \ud310\uc815\uc758 \uc2e0\ub8b0\ub3c4 \ubc0f \uc218\uc6a9 \ubc94\uc704\uc5d0 \uad00\ud55c \uc9c8\ubb38\uc73c\ub85c \ubcf8\ubb38\uc5d0 \uc218\ub85d\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubcf8\ubb38 \ub9d0\ud48d\uc120 \uadf8\ub9bc \uc18d\uc5d0\uc11c \uc81c\uc2dc\ub41c 6\uac00\uc9c0 \uc8fc\uc694 \uc6b0\ub824 \uc0ac\ud56d\uc744 \ub418\uc9da\uc5b4 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uacfc\ud559\uae30\uc220\uacfc \uad00\ub828\ub41c \uc601\ud654 \ubc0f \ud574\ub2f9 \uc791\ud488\uc5d0\uc11c \uc8fc\uc694 \uc7c1\uc810\uc73c\ub85c \ub2e4\ub8e8\ub294 \ub0b4\uc6a9\uc758 \uc5f0\uacb0\uc774 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub9c8\uc774 \uc2dc\uc2a4\ud130\uc988 \ud0a4\ud37c - \uc5b8\ub2c8\uc758 \ubcd1\uc744 \uce58\ub8cc\ud558\uae30 \uc704\ud574 \ub9de\ucda4\ud615 \uc544\uae30\ub85c \ud0dc\uc5b4\ub09c \uc548\ub098\uc758 \uc0b6",
          "rationale": "\ub9de\ucda4\ud615 \uc544\uae30 \ucd9c\uc0dd\uacfc \uad00\ub828\ub41c \uc0dd\uba85\uc724\ub9ac\uc801 \ubb38\uc81c\ub97c \ub2e4\ub8ec \uc601\ud654\ub85c \uad50\uacfc\uc11c \uc608\uc2dc\uc640 \uc815\ud655\ud788 \uc77c\uce58\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "2001 \uc2a4\ud398\uc774\uc2a4 \uc624\ub514\uc138\uc774 - \uacfc\ud559 \ubc1c\uc804\uc744 \uc704\ud55c\ub2e4\ub294 \uc774\uc720\ub85c \ud2b9\ubcc4\ud55c \ub3fc\uc9c0 \uc625\uc790\ub97c \ucc28\uc9c0\ud558\ub824\ub294 \uc0ac\ub78c\ub4e4",
          "rationale": "\ud2b9\ubcc4\ud55c \ub3fc\uc9c0 \uc625\uc790\ub97c \ub458\ub7ec\uc2fc \uac08\ub4f1\uc744 \ub2e4\ub8ec \uc601\ud654\ub294 '\uc625\uc790'\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ube44\ud3ec \ub354 \ud50c\ub7ec\ub4dc - \uc232\uc774 \uc0ac\ub77c\uc9c4 \uc9c0\uad6c\uc640 \uc6b0\uc8fc \uc4f0\ub808\uae30\ub85c \ubab8\uc0b4\uc744 \uc553\ub294 \uc6b0\uc8fc \uc774\uc57c\uae30",
          "rationale": "\uc6b0\uc8fc \uc4f0\ub808\uae30\uc640 \ud669\ud3d0\ud574\uc9c4 \uc9c0\uad6c \ud658\uacbd\uc744 \ub2e4\ub8ec \uc601\ud654\ub294 '\uc2b9\ub9ac\ud638'\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2b9\ub9ac\ud638 - \uc804 \uc138\uacc4\uac00 \uc9c1\uba74\ud55c \uae30\ud6c4 \ubcc0\ud654\uc640 \uc774\uc5d0 \ub300\ucc98\ud558\uae30 \uc704\ud55c \uc138\uacc4 \uac01\uad6d\uc758 \ud65c\ub3d9",
          "rationale": "\uae30\ud6c4 \ubcc0\ud654 \ubb38\uc81c\uc640 \uadf8 \ub300\ucc98 \ud65c\ub3d9\uc744 \ub2e4\ub8ec \ub2e4\ud050\uba58\ud130\ub9ac \uc601\ud654\ub294 '\ube44\ud3ec \ub354 \ud50c\ub7ec\ub4dc'\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub9de\ucda4\ud615 \uc544\uae30, \uc6b0\uc8fc \uc4f0\ub808\uae30, \uae30\ud6c4 \ubcc0\ud654 \ub4f1 \uc904\uac70\ub9ac \uc694\uc57d\uacfc \uc601\ud654 \uc81c\ubaa9\uc744 \uc9dd\uc9c0\uc5b4 \ubcf4\uc138\uc694."
    },
    {
