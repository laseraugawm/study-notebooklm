    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ub41c \ucc28\ub7c9\uc5d0 \uc2e4\uc2dc\uac04 \uad50\ud1b5 \uc815\ubcf4\ub97c \uc804\uc1a1\ud558\uc5ec \uc548\uc804\ud558\uace0 \ud3b8\uc548\ud55c \uc6b4\uc804\uc744 \ub3d5\ub294 \uae30\uc220\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
