    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ub0c9\uc7a5\uace0\uac00 \uc0ac\uc6a9\uc790\uc758 \uc2dd\uc0dd\ud65c\uc744 \ub3d5\uae30 \uc704\ud574 \ud30c\uc545\ud558\uace0 \uc548\ub0b4\ud558\ub294 \uc815\ubcf4\ub294 \ubb34\uc5c7\uc778\uac00?"
