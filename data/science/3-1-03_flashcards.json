    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc544\ub798 \uadf8\ub9bc\uacfc \uac19\uc740 \ubbf8\ub798 \uc2a4\ub9c8\ud2b8 \ud648\uc744 \uad6c\uc131\ud558\ub294 \uc8fc\uc694 \uae30\ubc18 \uae30\uc220 2\uac00\uc9c0\ub294?"
