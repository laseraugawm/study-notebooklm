      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ud488\uc758 \uc2e0\uc120\ub3c4\ub97c \ud30c\uc545\ud558\uc5ec \ub9de\ucda4\ud615 \uc694\ub9ac\ubc95\uc744 \uc548\ub0b4\ud55c\ub2e4."
