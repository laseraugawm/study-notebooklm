    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648\uc758 '\uc5d0\ub108\uc9c0 \uad00\ub9ac \uc2dc\uc2a4\ud15c'\uc774 \uc218\ud589\ud558\ub294 \ud575\uc2ec \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00?"
