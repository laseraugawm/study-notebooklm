    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648 \uccad\uc18c \ub85c\ubd07\uc774 \uc0ac\ub78c\uc758 \uc9c1\uc811 \uc870\uc791 \uc5c6\uc774 \uc2a4\uc2a4\ub85c \uccad\uc18c\ud560 \uc218 \uc788\ub294 \uc774\uc720\ub294?"
