      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\uac04\uc758 \ud615\ud0dc\ub97c \uc2a4\uc2a4\ub85c \uc778\uc9c0\ud560 \uc218 \uc788\uae30 \ub54c\ubb38"
