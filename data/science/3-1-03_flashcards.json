      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\ub108\uc9c0 \uc0ac\uc6a9\ub7c9\uc744 \ubd84\uc11d\ud558\uc5ec \uc5d0\ub108\uc9c0 \uc808\uc57d\uc744 \ub3d5\ub294\ub2e4."
