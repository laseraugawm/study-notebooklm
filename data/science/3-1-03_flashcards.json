    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c4\uc2dc \uc804\uccb4\uc758 \uc0ac\ubb3c\uacfc \uc2dc\ubbfc\uc774 \ud6a8\uc728\uc801\uc73c\ub85c \uc0c1\ud638\uc791\uc6a9\ud558\ub3c4\ub85d \ub3d5\ub294 \ub3c4\uc2dc \uad00\ub9ac \uc2dc\uc2a4\ud15c \uad6c\ucd95\uc5d0 \uc218\uc9d1\u00b7\ubd84\uc11d\ub418\ub294 \ub3c4\uc2dc \ub370\uc774\ud130 4\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c4\uc2dc\uc758 \ub300\uae30 \uc0c1\ud0dc, \uc4f0\ub808\uae30\ud1b5\uc758 \ud3ec\ud654 \uc815\ub3c4, \uad50\ud1b5\ub7c9, \uc2e4\uc2dc\uac04 \uc8fc\ucc28 \uacf5\uac04"
