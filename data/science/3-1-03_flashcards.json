      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137(IoT) \ubc0f \uc778\uacf5\uc9c0\ub2a5(AI) \uae30\uc220"
