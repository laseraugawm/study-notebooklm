{
  "title": "\uacfc\ud559\uae30\uc220 \ud50c\ub798\uc2dc\uce74\uc778\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01\uc885 \uc0ac\ubb3c\uc5d0 \uc13c\uc11c\uc640 \ud1b5\uc2e0 \uae30\ub2a5\uc744 \ub0b4\uc7a5\ud55c \ub4a4 \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ud558\ub294 \uae30\uc220\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137(IoT, Internet of Things)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137(IoT)\uc5d0 \uc5f0\uacb0\ub41c \ubb3c\uac74\ub4e4\uc774 \uc218\ud589\ud558\ub294 \uc8fc\uc694 \uc791\ub3d9 \uacfc\uc815 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\uc2a4\ub85c \uc815\ubcf4 \uc218\uc9d1 \ubc0f \uad50\ud658, \uc2a4\uc2a4\ub85c \uc791\ub3d9, \uc0ac\uc6a9\uc790\uc758 \uc6d0\uaca9 \uc870\uc808"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04\uc758 \ucd94\ub860\uc774\ub098 \ud559\uc2b5 \ub2a5\ub825\uc744 \ucef4\ud4e8\ud130\uc5d0 \uad6c\ud604\ud55c \uae30\uc220\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5(AI)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \uae30\uc220\uc774 \uc0ac\ubb3c \uc778\ud130\ub137\uacfc \uacb0\ud569\ud560 \ub54c \ub370\uc774\ud130 \ucc98\ub9ac \ubc29\uc2dd\uc740 \uc5b4\ub5bb\uac8c \uc774\ub8e8\uc5b4\uc9c0\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ubb3c \uc778\ud130\ub137\uc774 \uc218\uc9d1\ud55c \ub370\uc774\ud130\ub97c \uc778\uacf5\uc9c0\ub2a5\uc774 \ubd84\uc11d\ud558\uc5ec \ubb38\uc81c\ub97c \ud574\uacb0\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70\uc758 \uc77c\ubc18 \ub85c\ubd07\uacfc '\uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07'\uc758 \uac00\uc7a5 \ud070 \ub3d9\uc791 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70 \ub85c\ubd07\uc740 \uc815\ud574\uc9c4 \ub3d9\uc791\ub9cc \uc218\ud589\ud588\uc9c0\ub9cc, \uc778\uacf5\uc9c0\ub2a5 \ub85c\ubd07\uc740 \uc8fc\ubcc0 \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0 \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uc5ec \uc6c0\uc9c1\uc778\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8\uc6cc\uce58\uac00 \uac1c\uc778\uc758 \uac74\uac15\uc744 \uc99d\uc9c4\ud558\uae30 \uc704\ud574 \uc790\ub3d9\uc73c\ub85c \uc218\ud589\ud558\ub294 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0b4 \ubab8\uc758 \uc774\uc0c1 \uac10\uc9c0 \uc2dc \uad6c\uc870 \uc2e0\ud638 \ubc1c\uc1a1, \uc2ec\uc7a5\ubc15\ub3d9\uc218 \ubc0f \uc6b4\ub3d9\ub7c9 \uc790\ub3d9 \uce21\uc815"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud587\ube5b\uc758 \uc138\uae30\ub97c \uace0\ub824\ud558\uc5ec \uc790\ub3d9\uc73c\ub85c \ub3d9\uc791\ud558\ub294 \uc2a4\ub9c8\ud2b8 \ud648 \uc7a5\uce58\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ube14\ub77c\uc778\ub4dc (\ud587\ube5b\uc758 \uc138\uae30\uc5d0 \ub530\ub77c \uc790\ub3d9\uc73c\ub85c \uc5f4\ub9ac\uace0 \ub2eb\ud798)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648\uc5d0\uc11c \uc0ac\ub78c\uc758 \uc218\uba74 \ud328\ud134\uc744 \ud559\uc2b5\ud558\uc5ec \uc791\ub3d9\ud558\ub294 \uc0ac\ubb3c \uc778\ud130\ub137 \uae30\uae30\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\ub3d9 \uad00\ub9ac \uc870\uba85 \uc2dc\uc2a4\ud15c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648\uc758 \ub0c9\ub09c\ubc29 \uc7a5\uce58\uac00 \ucf8c\uc801\ud55c \uc2e4\ub0b4 \ud658\uacbd\uc744 \uc790\ub3d9 \uad00\ub9ac\ud558\uae30 \uc704\ud574 \uc2e4\uc2dc\uac04 \uce21\uc815\ud558\ub294 2\uac00\uc9c0 \uc694\uc18c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc628\uacfc \uc2b5\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \ud648\uc5d0\uc11c \uc0ac\ub78c\uc758 \ubaa9\uc18c\ub9ac\ub97c \uc778\uc2dd\ud558\uc5ec \ub2e4\uc591\ud55c \uba85\ub839\uc744 \uc218\ud589\ud558\ub294 \uae30\uae30\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 \ube44\uc11c"
