        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3ec\uc720\ub958\uac00 \uacf5\ub8e1 \uba78\uc885 \ud6c4 \uae09\uaca9\ud55c \uae30\ud6c4 \ubcc0\ud654\uc5d0\ub3c4 \uc0b4\uc544\ub0a8\uc544 \uc2e0\uc0dd\ub300\uc5d0 \ubc88\uc131\ud560 \uc218 \uc788\uc5c8\ub358 \uc0dd\ub9ac\uc801 \uc7a5\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccb4\uc628\uc744 \uc77c\uc815\ud558\uac8c \uc720\uc9c0\ud560 \uc218 \uc788\ub294 \ub2a5\ub825(\uc815\uc628\uc131)\uc744 \uac00\uc84c\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc0dd\ub300 \ubc14\ub2e4\uc5d0\uc11c \ubc88\uc131\ud55c \ub300\ud45c\uc801\uc778 \ub2e8\uc138\ud3ec \ud574\uc591 \uc0dd\ubb3c \ud45c\uc900\ud654\uc11d\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ud3d0\uc11d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc0dd\ub300\uc5d0 \uaf43\uc744 \ud53c\uc6b0\uba70 \uc9c0\ubc30\uc801\uc778 \uc2dd\ubb3c\uc774 \ub41c \ubd84\ub958\uad70\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18d\uc528\uc2dd\ubb3c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc0dd\ub300\uc5d0 \uc778\ub3c4 \ub300\ub959\uacfc \uc720\ub77c\uc2dc\uc544 \ub300\ub959\uc774 \ucda9\ub3cc\ud558\uba74\uc11c \ud615\uc131\ub41c \ub300\uaddc\ubaa8 \uc0b0\ub9e5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud788\ub9d0\ub77c\uc57c\uc0b0\ub9e5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc0dd\ub300 \ud6c4\uae30 \uc0dd\ubb3c\uacc4\uc758 \uc8fc\uc694 \uc0ac\uac74 \uc911 \uc778\ub958\uc640 \uad00\ub828\ub41c \uc0ac\uac74\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ub958\uc758 \uc870\uc0c1\uc774 \ucd9c\ud604\ud558\uc600\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uba78\uc885(Mass Extinction)\uc774\ub780 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc9c8 \uc2dc\ub300 \ub3d9\uc548 \ub300\ub7c9\uc758 \uc0dd\ubb3c\uc885\uc774 \ud55c\uaebc\ubc88\uc5d0 \uba78\uc885\ud558\ub294 \uc0ac\uac74."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "30a04c8e-ca9c-4bd5-ae2e-99b8867ba177",
            "alt": "\uc9c0\uc9c8 \uc2dc\ub300\ubcc4 \ud574\uc591 \uc0dd\ubb3c \uacfc\uc758 \uc218 \ubcc0\ud654\uc640 \ub300\uba78\uc885 \uc2dc\uae30\ub97c \ubcf4\uc5ec\uc8fc\ub294 \uadf8\ub798\ud504"
          },
          {
            "type": "text",
            "content": "\uc704 \uadf8\ub798\ud504\uc5d0 \uc81c\uc2dc\ub41c \ub300\uba78\uc885 \uc911 \uc9c0\uad6c\uc0c1 \uc0dd\ubb3c\uc885\uc758 90 % \uc774\uc0c1\uc774 \uba78\uc885\ud55c \uac00\uc7a5 \ub300\uaddc\ubaa8\uc758 \ub300\uba78\uc885\uc740 \uc5b8\uc81c \uc77c\uc5b4\ub0ac\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc0dd\ub300 \ub9d0 \ub300\uba78\uc885"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc0dd\ub300 \ub9d0 \ub300\uba78\uc885 \ub2f9\uc2dc \uc0ac\ub77c\uc9c4 \ub300\ud45c\uc801\uc778 \uc0dd\ubb3c\uad70 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub8e1, \uc554\ubaa8\ub098\uc774\ud2b8 (50% \uc774\uc0c1\uc758 \ud574\uc591 \uc0dd\ubb3c \ubc0f \uc721\uc0c1 \ub3d9\ubb3c \ud3ec\ud568)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uba78\uc885\uc774 \uc0dd\ubb3c\ub2e4\uc591\uc131\uc5d0 \ubbf8\uce58\ub294 \uc9c4\ud654\uc801/\uc0dd\ud0dc\uc801 \uae0d\uc815\uc801 \uc601\ud5a5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud658\uacbd \ubcc0\ud654\uc5d0 \uc801\uc751\ud574 \uc0b4\uc544\ub0a8\uc740 \uc0dd\ubb3c\uc885\uc774 \ube48 \uc0dd\ud0dc\uc801 \uc9c0\uc704\ub97c \ucc28\uc9c0\ud558\uba70 \uc0c8\ub85c\uc6b4 \ud658\uacbd\uc5d0 \ub9de\ucdb0 \ub2e4\uc591\ud55c \uc885\uc73c\ub85c \uc9c4\ud654\ud560 \uae30\ud68c\ub97c \uc5bb\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "image",
            "reference": "3306adef-ae78-4d00-995e-b0c3314afb9a",
            "alt": "\uacf5\ub8e1 \uba78\uc885\uc5d0 \ub300\ud55c \uc18c\ud589\uc131 \ucda9\ub3cc\uc124\uacfc \ud654\uc0b0 \ud3ed\ubc1c\uc124\uc744 \ube44\uad50\ud55c \ud45c"
          },
          {
            "type": "text",
            "content": "\uc704 \ud45c\uc758 '\uc18c\ud589\uc131 \ucda9\ub3cc\uc124'\uc5d0\uc11c \uba3c\uc9c0 \uad6c\ub984\uc774 \ud587\ube5b\uc744 \ucc28\ub2e8\ud588\uc744 \ub54c \uc0dd\ubb3c\uacc4\uc5d0 \uc9c1\uc811 \ubbf8\uce5c \uc601\ud5a5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ubb3c\uc758 \uad11\ud569\uc131\ub7c9\uc774 \uac10\uc18c\ud558\uace0 \uc9c0\uad6c \uae30\uc628\uc774 \ub0b4\ub824\uac14\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacf5\ub8e1 \uba78\uc885 \uac00\uc124 \uc911 '\ud654\uc0b0 \ud3ed\ubc1c\uc124'\uc5d0\uc11c \uc2dd\ubb3c\uc758 \uc131\uc7a5\uc744 \uc5b5\uc81c\ud55c \ud1a0\uc591 \ubc0f \ub300\uae30 \ubcc0\ud654 \ud658\uacbd 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc131\ube44\ub85c \uc778\ud55c \ud1a0\uc591 \uc0b0\uc131\ud654, \ud654\uc0b0\uc7ac \ucc28\ub2e8\uc73c\ub85c \uc778\ud55c \uc2dd\ubb3c \uc790\ub78c \ubc29\ud574"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0bc\uc5fd\ucda9(Trilobite)\uc740 \uc5b4\ub290 \uc9c0\uc9c8 \uc2dc\ub300, \uc5b4\ub290 \ud658\uacbd\uc758 \ud45c\uc900\ud654\uc11d\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc0dd\ub300, \ubc14\ub2e4 \ud658\uacbd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc554\ubaa8\ub098\uc774\ud2b8(Ammonite)\ub294 \uc5b4\ub290 \uc9c0\uc9c8 \uc2dc\ub300, \uc5b4\ub290 \ud658\uacbd\uc758 \ud45c\uc900\ud654\uc11d\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc0dd\ub300, \ubc14\ub2e4 \ud658\uacbd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ud3d0\uc11d(Nummulite)\uc740 \uc5b4\ub290 \uc9c0\uc9c8 \uc2dc\ub300, \uc5b4\ub290 \ud658\uacbd\uc758 \ud45c\uc900\ud654\uc11d\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc0dd\ub300, \ubc14\ub2e4 \ud658\uacbd"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub9e4\uba38\ub4dc(Mammoth)\ub294 \uc5b4\ub290 \uc9c0\uc9c8 \uc2dc\ub300\uc758 \uc721\uc0c1 \ud3ec\uc720\ub958 \ud45c\uc900\ud654\uc11d\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc0dd\ub300"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc0ac\ub9ac\uc640 \uac19\uc740 \uc591\uce58\uc2dd\ubb3c\uc774 \uac70\ub300 \uad70\ub77d\uc744 \uc774\ub8ec \uc2dc\ub300\uc640, \uc740\ud589\ub098\ubb34\u00b7\uc18c\ucca0\uacfc \uac19\uc740 \uac89\uc528\uc2dd\ubb3c\uc774 \ubc88\uc131\ud55c \uc2dc\ub300\ub97c \uc21c\uc11c\ub300\ub85c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc0dd\ub300, \uc911\uc0dd\ub300"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3ec\uc720\ub958\uac00 \ucd5c\ucd08\ub85c \ucd9c\ud604\ud55c \uc9c0\uc9c8 \uc2dc\ub300\ub294 \uc5b8\uc81c\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc0dd\ub300 \uc911\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc0dd\ub300 \ud6c4\uae30 \ud638\uc8fc \ub300\ub959\uc774 \ub0a8\uadf9\uc5d0\uc11c \uba40\uc5b4\uc9d0\uc73c\ub85c\uc368 \ub0a8\uadf9 \uc8fc\ubcc0 \uae30\ud6c4\uc5d0 \ubbf8\uce5c \uc601\ud5a5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0a8\uadf9 \uc8fc\ubcc0\uc73c\ub85c \ucc28\uac00\uc6b4 \ud574\ub958\uac00 \ud615\uc131\ub418\uc5b4 \ub0a8\uadf9\uc758 \uae30\ud6c4\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc644\uc871\ub958(Brachiopod)\uc758 \ud615\ud0dc\uc801 \ud2b9\uc9d5\uacfc \ubc88\uc131\ud55c \uc9c0\uc9c8 \uc2dc\ub300\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \uc7a5\uc758 \uaecd\ub370\uae30\ub97c \uac00\uc9c4 \ubc14\ub2e4 \uc0dd\ubb3c\ub85c, \uace0\uc0dd\ub300\uc5d0 \ubc88\uc131\ud558\uc600\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc9c8 \uc2dc\ub300\ub97c \uc2dc\uac04\uc774 \uc624\ub798\ub41c \uc21c\uc11c\ub300\ub85c \uc815\ub82c\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uce84\ube0c\ub9ac\uc544\uc2dc\ub300 $\\rightarrow$ \uace0\uc0dd\ub300 $\\rightarrow$ \uc911\uc0dd\ub300 $\\rightarrow$ \uc2e0\uc0dd\ub300"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uc9c0\uc9c8 \uc2dc\ub300\uc758 \uc8fc\ub41c \uc9c0\ubc30\uc801 \uc2dd\ubb3c\uad70 \ubcc0\ud654 \uacfc\uc815\uc744 \uc21c\uc11c\ub300\ub85c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uce84\ube0c\ub9ac\uc544\uc2dc\ub300(\ub0a8\uc138\uade0 \ub4f1 \uad11\ud569\uc131 \uc0dd\ubb3c) $\\rightarrow$ \uace0\uc0dd\ub300(\uc591\uce58\uc2dd\ubb3c) $\\rightarrow$ \uc911\uc0dd\ub300(\uac89\uc528\uc2dd\ubb3c) $\\rightarrow$ \uc2e0\uc0dd\ub300(\uc18d\uc528\uc2dd\ubb3c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uc9c0\uc9c8 \uc2dc\ub300\uc758 \uc8fc\ub41c \ub300\ud45c \ucc99\ucd94/\ub3d9\ubb3c\uad70 \ubcc0\ud654 \uacfc\uc815\uc744 \uc21c\uc11c\ub300\ub85c \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uce84\ube0c\ub9ac\uc544\uc2dc\ub300(\ubb34\ucc99\ucd94 \ub2e4\uc138\ud3ec \uc0dd\ubb3c) $\\rightarrow$ \uace0\uc0dd\ub300(\uc0bc\uc5fd\ucda9/\uc5b4\ub958/\uc591\uc11c\ub958) $\\rightarrow$ \uc911\uc0dd\ub300(\ud30c\ucda9\ub958/\uacf5\ub8e1) $\\rightarrow$ \uc2e0\uc0dd\ub300(\ud3ec\uc720\ub958)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uc0dd\ub300 \ub9d0 \ub300\uba78\uc885\uacfc \uc911\uc0dd\ub300 \ub9d0 \ub300\uba78\uc885\uc758 \uc6d0\uc778\uc744 \ube44\uad50\ud560 \ub54c, \uace0\uc0dd\ub300 \ub9d0\uc758 \ud575\uc2ec\uc801 \ub300\ub959 \uc9c0\uac01 \uc6d0\uc778\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ub959 \uc774\ub3d9\uc73c\ub85c \uc778\ud55c \ucd08\ub300\ub959 \ud310\uac8c\uc544(Pangea)\uc758 \ud615\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc911\uc0dd\ub300 \ucd08 \ud310\uac8c\uc544\uc758 \ubd84\ub9ac\uac00 \uc911\uc0dd\ub300 \uc0dd\ubb3c \ubc88\uc131\uc5d0 \ubbf8\uce5c \uae0d\uc815\uc801 \uc601\ud5a5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ub959\uacfc \ud574\uc591\uc758 \ubd84\ud3ec\uac00 \ub2e4\uc591\ud574\uc9c0\uace0 \ud574\uc548\uc120\uc774 \ub298\uc5b4\ub098\uba74\uc11c \ub2e4\uc591\ud55c \uc0dd\ubb3c\uc774 \uc11c\uc2dd\ud558\uace0 \ubc88\uc131\ud560 \uc218 \uc788\uc5c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559\uc790\ub4e4\uc774 \uacfc\uac70 \uc9c0\uc9c8 \uc2dc\ub300\uc758 \uae09\uaca9\ud55c \ub300\uba78\uc885\uc744 \ucd94\uc815\ud560 \ub54c \uc81c\uc2dc\ud558\ub294 \uc9c0\uad6c \ud658\uacbd \ubcc0\ud654 \uc694\uc778 3\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uaddc\ubaa8 \ud654\uc0b0 \ubd84\ud654, \uc6b4\uc11d(\uc18c\ud589\uc131) \ucda9\ub3cc, \uae09\uaca9\ud55c \uae30\ud6c4 \ubcc0\ud654"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c \ud654\uc131\uc2dc\uc640 \ubcf4\uc131\uad70\uc5d0\uc11c \ucd5c\ucd08\ub85c \ud654\uc11d\uc774 \ubc1c\uacac\ub418\uc5b4 \uc9c0\uba85\uc774 \ubd99\uc740 \uacf5\ub8e1\uc758 \uc774\ub984\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucf54\ub9ac\uc544\ucf00\ub77c\ud1b1\uc2a4 \ud654\uc131\uc5d4\uc2dc\uc2a4, \ucf54\ub9ac\uc544\ub178\uc0ac\uc6b0\ub8e8\uc2a4 \ubcf4\uc131\uc5d4\uc2dc\uc2a4"
          }
        ]
      }
    }
  ]
}