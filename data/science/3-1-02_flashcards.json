    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc0ac\ud55c \uc131\uc9c8\uc744 \uac00\uc9c4 \ub370\uc774\ud130\ub97c \uac80\uc0c9\uc774\ub098 \uc0ac\uc6a9\uc774 \ud3b8\ub9ac\ud558\ub3c4\ub85d \uc815\ub3c8\ud574 \ub193\uc740 \ub370\uc774\ud130 \ubaa8\uc74c\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
          }
        ]
