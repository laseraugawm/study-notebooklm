      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\uc11d \uacb0\uacfc\uc758 \uc624\ub958\uac00 \uc0dd\uaca8 \uc798\ubabb\ub41c \uacb0\ub860\uc744 \ub3c4\ucd9c\ud560 \uc218 \uc788\ub2e4."
