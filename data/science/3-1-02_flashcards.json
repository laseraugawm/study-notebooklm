        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub370\uc774\ud130\ub97c \uc801\uc808\ud558\uac8c \uc120\ubcc4\ud558\uace0 \uc2e0\ub8b0\ub3c4\ub97c \ud3c9\uac00\ud558\uc5ec \ub2e4\ub8e8\ub294 \uac83"
