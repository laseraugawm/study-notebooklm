    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1 \uc720\ud589 \uc2dc \uce74\ub4dc \uc774\uc6a9 \uc815\ubcf4 \ub370\uc774\ud130\uc14b\uc744 \uc774\uc6a9\ud574 \ub3c4\ucd9c\ud558\ub294 \uc704\ud5d8 \uc815\ubcf4\ub294?"
