    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc0c1 \uc790\ub8cc \uac1c\ubc29 \ud3ec\ud138\uc5d0\uc11c \uc774\uc6a9\ud560 \uc218 \uc788\ub294 \uae30\uc0c1 \ub370\uc774\ud130 $3$\uac00\uc9c0 \uc608\uc2dc\ub294?"
