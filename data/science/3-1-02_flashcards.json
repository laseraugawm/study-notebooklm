      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uaca9\ub9ac \ubc0f \uce58\ub8cc \ubcd1\uc0c1 \ubd80\uc871 \uc5ec\ubd80\ub97c \uc0ac\uc804\uc5d0 \ud30c\uc545\ud558\uc5ec \ucd94\uac00 \uc758\ub8cc \uc790\uc6d0\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574"
