      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1\uc774 \uc804\ud30c\ub418\uac70\ub098 \ud37c\uc9c8 \uc704\ud5d8\uc774 \ub192\uc544\uc11c \uc8fc\uc758\ud574\uc57c \ud558\ub294 \uad6d\uac00"
