          {
            "type": "text",
            "content": "\uc9c0\uc5ed\ubcc4 \ubc31\uc2e0 \uc811\uc885 \ud604\ud669 \ub370\uc774\ud130\uc14b\uc744 \ubc14\ud0d5\uc73c\ub85c \uc2dc\ud589\ud560 \uc218 \uc788\ub294 \ubc29\uc5ed \ub300\ucc45\uc740?"
