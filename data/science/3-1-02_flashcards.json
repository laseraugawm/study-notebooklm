        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc9d1\ud558\ub294 \ub370\uc774\ud130\uc758 \uc591\uacfc \uc218\uc9d1 \uae30\uac04\uc774 \uc99d\uac00\ud560\uc218\ub85d \ucd94\ucd9c\ub418\ub294 \uc815\ubcf4\uc5d0\ub294 \uc5b4\ub5a4 \ubcc0\ud654\uac00 \uc0dd\uae30\ub294\uac00?"
