    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube45\ub370\uc774\ud130 \uc218\uc9d1 \ubc0f \ud65c\uc6a9 \uacfc\uc815\uc5d0\uc11c \uc624\u00b7\ub0a8\uc6a9\uc744 \ub9c9\uae30 \uc704\ud574 \ubc95\uc801\u00b7\uc724\ub9ac\uc801\uc73c\ub85c \uc8fc\uc758 \uae4a\uac8c \ubcf4\ud638\ud574\uc57c \ud560 \uc694\uc18c\ub294?"
