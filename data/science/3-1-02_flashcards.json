            "type": "text",
            "content": "\ub9c8\uc2a4\ud06c \uacf5\uae09\uc774 \ubd80\uc871\ud55c \uc9c0\uc5ed\uc5d0 \ubb3c\ub7c9\uc744 \uc9d1\uc911\uc801\uc73c\ub85c \uc6b0\uc120 \ubc30\ubd84"
