    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1 \ub300\uc751 \uc2dc '\ud658\uc790\ub97c \uc704\ud55c \ubcd1\uc0c1 \uc218 \ub370\uc774\ud130\uc14b'\uc744 \ud655\uc778\ud574\uc57c \ud558\ub294 \uc774\uc720\ub294?"
