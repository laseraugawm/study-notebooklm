      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\ub78c\ub4e4\uc774 \ubc00\uc9d1\ud558\ub294 \ubd90\ube44\ub294 \uc7a5\uc18c \ubc0f \uac10\uc5fc \uc704\ud5d8 \uc9c0\uc5ed"
