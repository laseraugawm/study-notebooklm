      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\ud558\ub294 \ub370\uc774\ud130\uc758 \uac80\uc0c9\uc774 \uc6a9\uc774\ud558\uace0 \uc0ac\uc6a9\uacfc \uac00\uacf5\uc774 \ud3b8\ub9ac\ud574\uc9c4\ub2e4."
