          {
            "type": "text",
            "content": "\uac70\ub300 \uc785\uc790 \uac00\uc18d\uae30, \uc778\uacf5\uc704\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac70\ub300 \uc785\uc790 \ucda9\ub3cc \uc2e4\ud5d8\uacfc \uac19\uc740 \ud604\ub300 \uacfc\ud559 \uc2e4\ud5d8 \uc5f0\uad6c\uc5d0\uc11c \ube45\ub370\uc774\ud130\uac00 \ucd95\uc801\u00b7\ud65c\uc6a9\ub418\ub294 \ubc29\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc29\ub300\ud55c \uc790\ub8cc\ub97c \ubd84\uc11d\ud558\uace0 \uc774\ub860\uc801 \ubaa8\ub378\uacfc \ube44\uad50\ud558\uc5ec \uc0c8\ub85c\uc6b4 \uacfc\ud559 \uc9c0\uc2dd\uc744 \uac80\uc99d \ubc0f \uc815\ub9bd\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc57d \uac1c\ubc1c\uc758 \uc18d\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud574 \ube45\ub370\uc774\ud130\ub85c \uad6c\ucd95\ud558\uc5ec \ubd84\uc11d\ud558\ub294 \uc790\ub8cc $3$\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ud559 \ubb3c\uc9c8\uc758 \uad6c\uc870\uc640 \uc131\uc9c8, \uc720\uc804\uc790 \ub370\uc774\ud130, \uc784\uc0c1 \uc2dc\ud5d8 \ub370\uc774\ud130"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\ubb3c\uc758 DNA \uc5fc\uae30\uc11c\uc5f4\uc744 \ubd84\uc11d\ud558\uc5ec \uc5bb\uc740 \ubc29\ub300\ud55c \uc815\ubcf4 \uc9d1\ud569\uc744 \ud65c\uc6a9\ud558\ub294 \uc5f0\uad6c \ubd84\uc57c\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc804\uccb4 \ubd84\uc11d"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uac04 \uc720\uc804\uccb4 \ubd84\uc11d \ub370\uc774\ud130\ub97c \ud65c\uc6a9\ud558\uc5ec \uae30\ub300\ud560 \uc218 \uc788\ub294 \uc758\ud559\uc801 \uc801\uc6a9 $2$\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc554\uc774\ub098 \ub09c\uce58\ubcd1 \uce58\ub8cc, \uac1c\uc778 \ub9de\ucda4\ud615 \uc758\ud559 \uc801\uc6a9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad00\uce21\uc18c\uc640 \uc778\uacf5\uc704\uc131\uc758 \uae30\uc0c1 \ube45\ub370\uc774\ud130\ub97c \ubd84\uc11d\ud560 \ub54c \uc5bb\ub294 \uacfc\ud559\uc801 \uc131\uacfc $2$\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uae30 \uc608\ubcf4\uc758 \uc815\ud655\ub3c4 \ud5a5\uc0c1, \uc7a5\uae30\uac04\uc758 \uae30\ud6c4 \ubcc0\ud654 \uc5f0\uad6c"
          }
        ]
