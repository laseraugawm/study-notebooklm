      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc811\uc885\ub960\uc774 \ub0ae\uace0 \uac10\uc5fc\uc5d0 \ucde8\uc57d\ud55c \uc9c0\uc5ed\uc744 \ud30c\uc545\ud558\uc5ec \uc0ac\uc804\uc5d0 \uc608\ubc29 \ubc0f \uc9d1\ub2e8 \uba74\uc5ed \ub300\ucc45 \uc218\ub9bd"
