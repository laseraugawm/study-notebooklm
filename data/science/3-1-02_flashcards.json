    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube45\ub370\uc774\ud130 \ubd84\uc11d \uc2dc \ud3b8\ud5a5\ub418\uc5c8\uac70\ub098 \uc2e0\ub8b0\uc131\uc774 \ub0ae\uc740 \ub370\uc774\ud130\ub97c \uc0ac\uc6a9\ud560 \uacbd\uc6b0 \uc77c\uc5b4\ub098\ub294 \ubb38\uc81c\uc810\uc740?"
