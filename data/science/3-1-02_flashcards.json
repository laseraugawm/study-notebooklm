    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1 \uad00\ub9ac\uc5d0\uc11c \uc804 \uc138\uacc4 \ud56d\uacf5\uad8c \ud310\ub9e4 \ub370\uc774\ud130\uc14b\uc744 \ubd84\uc11d\ud558\uc5ec \uc608\uce21\ud558\ub294 \uc815\ubcf4\ub294?"
