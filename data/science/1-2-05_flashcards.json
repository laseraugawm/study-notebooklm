    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\uc5b4\ucee8\uc758 \uc2e4\uc678\uae30\uc5d0\uc11c \ub530\ub73b\ud55c \ubc14\ub78c\uc774 \ub098\uc624\ub294 \uc6d0\uc778\uc744 \ub0c9\ub9e4\uc758 \uc0c1\ud0dc \ubcc0\ud654 \ubc0f \uc5d0\ub108\uc9c0 \ucd9c\uc785\uc73c\ub85c \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e4\uc678\uae30\uc5d0\uc11c \ub0c9\ub9e4\uac00 \ub2e4\uc2dc \uc561\ud654\ub418\uba74\uc11c \uc5f4\uc744 \uc2e4\uc678\ub85c \ubc29\ucd9c\ud558\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub208\uc774 \uc313\uc778 \ub3c4\ub85c\uc5d0 \uc5fc\ud654 \uce7c\uc298($CaCl_2$)\uc744 \ubfcc\ub9b4 \ub54c \ubc1c\uc0dd\ud558\ub294 \uc5d0\ub108\uc9c0 \ucd9c\uc785\uacfc \uadf8 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5fc\ud654 \uce7c\uc298\uc774 \ubb3c\uc5d0 \uc6a9\ud574\ub418\uba74\uc11c \uc5f4\uc744 \ubc29\ucd9c(\uc5d0\ub108\uc9c0 \ubc29\ucd9c)\ud558\uc5ec \uc8fc\ubcc0 \uc628\ub3c4\ub97c \ub192\uc774\uace0 \ub208\uc744 \ub179\uc778\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5fc\ud654 \uce7c\uc298\uc758 \uc6a9\ud574 \ubc18\uc751 \uc2dc \uc8fc\ubcc0 \uc628\ub3c4 \ubcc0\ud654\ub294 \uc0c1\uc2b9\uacfc \ud558\uac15 \uc911 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc8fc\ubcc0 \uc628\ub3c4 \uc0c1\uc2b9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \ud604\uc0c1 \uc911 \uc5d0\ub108\uc9c0 \ucd9c\uc785 \ubc29\ud5a5\uc774 \ub098\uba38\uc9c0\uc640 \ub2e4\ub978 \ud558\ub098\ub294? (\ub540\uc758 \uc99d\ubc1c, \ub4dc\ub77c\uc774\uc544\uc774\uc2a4 \uc2b9\ud654, \uc190\ub09c\ub85c \ubc1c\uc5f4, \ub0c9\ub9e4\uc758 \uae30\ud654)"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc190\ub09c\ub85c \ubc1c\uc5f4 (\uc5d0\ub108\uc9c0 \ubc29\ucd9c; \ub098\uba38\uc9c0\ub294 \ubaa8\ub450 \uc5d0\ub108\uc9c0 \ud761\uc218)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\uc74c \ud604\uc0c1 \uc911 \uc8fc\ubcc0 \uc628\ub3c4\ub97c \ub192\uc774\ub294 \uc6d0\uc778\uc758 \ubc18\uc751\uc740? (\uad11\ud569\uc131, \ub0c9\uac01 \ud329 \ubc18\uc751, \uc0b0\uacfc \uc5fc\uae30\uc758 \uc911\ud654 \ubc18\uc751, \uc18c\ud654\uae30 \uc561\uccb4 \ubd84\ud574)"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uacfc \uc5fc\uae30\uc758 \uc911\ud654 \ubc18\uc751 (\uc5d0\ub108\uc9c0 \ubc29\ucd9c \ubc18\uc751)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub8cc\uc758 \uc5f0\uc18c, \uc0b0\ud654 \uce7c\uc298\uacfc \ubb3c\uc758 \ubc18\uc751, \ucca0\uc758 \uc0b0\ud654 \ubc18\uc751\uc758 \uacf5\ud1b5\uc801\uc778 \uc5d0\ub108\uc9c0 \ucd9c\uc785 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\ub450 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\uc5ec \uc8fc\ubcc0 \uc628\ub3c4\ub97c \ub192\uc778\ub2e4 (\ubc1c\uc5f4 \ubc18\uc751)."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\ud569\uc131\uacfc \uc138\ud3ec\ud638\ud761\uc744 \uc5d0\ub108\uc9c0 \ucd9c\uc785 \uad00\uc810\uc5d0\uc11c \ube44\uad50 \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\ud569\uc131\uc740 \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\ub294 \ubc18\uc751\uc774\uace0, \uc138\ud3ec\ud638\ud761\uc740 \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\ub294 \ubc18\uc751\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c\uc774 \uc561\uccb4\uc5d0\uc11c \uae30\uccb4\ub85c \uae30\ud654\ud560 \ub54c\ub294 \uc5d0\ub108\uc9c0\ub97c _____, \uae30\uccb4\uc5d0\uc11c \uc561\uccb4\ub85c \uc561\ud654\ud560 \ub54c\ub294 \uc5d0\ub108\uc9c0\ub97c _____\ud55c\ub2e4."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud761\uc218, \ubc29\ucd9c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucca0 \uac00\ub8e8 \uc190\ub09c\ub85c\uc5d0\uc11c \uc5f4\uc774 \ubc1c\uc0dd\ud558\ub294 \ub370 \ud544\uc694\ud55c \uacf5\uae30 \uc911\uc758 \ud575\uc2ec \ubc18\uc751 \ubb3c\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc18c ($O_2$)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc18c\ud654\uae30 \uc18d \uc561\uccb4\ub294 \ubd88\uaf43\uc5d0 \ub2ff\uc558\uc744 \ub54c \uc5b4\ub5a4 \ubcc0\ud654\ub97c \uc77c\uc73c\ud0a4\uba70 \uc8fc\ubcc0 \uc628\ub3c4\ub97c \ub0ae\ucd94\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ud574\ub418\uba74\uc11c \uc8fc\ubcc0\uc758 \uc5f4\uc744 \ud761\uc218\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \uce7c\uc298\uacfc \ubb3c\uc758 \ubc18\uc751 \uc2e4\ud5d8\uc5d0\uc11c \uc0b0\ud654 \uce7c\uc298 10 g, 20 g, 30 g\uc744 \ube44\uad50\ud560 \ub54c \uc870\uc808 \ubcc0\uc778(\ub3c5\ub9bd\ubcc0\uc778)\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \uce7c\uc298\uc758 \uc591(\uc9c8\ub7c9)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c\uacfc \uc0b0\ud654 \uce7c\uc298\uc758 \ubc18\uc751 \uc2e4\ud5d8 \uc2dc \ud1b5\uc81c \ubcc0\uc778( \uc77c\uc815\ud558\uac8c \uc720\uc9c0\ud574\uc57c \ud558\ub294 \uc870\uac74)\uc758 \uc608\uc2dc 1\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub123\uc5b4\uc8fc\ub294 \ubb3c\uc758 \ubd80\ud53c (100 mL) \ub610\ub294 \ucc98\uc74c \ubb3c\uc758 \uc628\ub3c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uc758 \ube5b\uc5d0\ub108\uc9c0\ub294 \uc2dd\ubb3c\uc758 \uc5b4\ub5a4 \uc18c\uae30\uad00\uc5d0\uc11c \uc5b4\ub5a4 \uacfc\uc815\uc73c\ub85c \ud654\ud559 \uc5d0\ub108\uc9c0\uac00 \ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5fd\ub85d\uccb4\uc5d0\uc11c \uad11\ud569\uc131\uc744 \ud1b5\ud574 \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc5ec \uc800\uc7a5\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138\ud3ec\ud638\ud761 \ubc18\uc751\uc5d0\uc11c \ubc29\ucd9c\ub41c \uc5d0\ub108\uc9c0\ub294 \uc138\ud3ec \ub0b4\uc5d0\uc11c \uc5b4\ub5a4 \ud615\ud0dc\ub85c \ubcc0\ud658\ub418\uc5b4 \uc0dd\uba85 \ud65c\ub3d9\uc5d0 \uc4f0\uc774\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uccb4\uc628 \uc720\uc9c0\ub97c \uc704\ud55c \uc5f4\uc5d0\ub108\uc9c0 \ubc0f \uc6c0\uc9c1\uc784 \ub4f1\uc5d0 \ud544\uc694\ud55c \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub294 \ubb3c\ub860 \uc0dd\uba85 \uc720\uc9c0 \uc5d0\ub108\uc9c0\ub85c \ud65c\uc6a9\ub41c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub4dc\ub77c\uc774\uc544\uc774\uc2a4\uac00 \uace0\uccb4\uc5d0\uc11c \uae30\uccb4\ub85c \uc0c1\ud0dc \ubcc0\ud654\ud558\ub294 \ud604\uc0c1\uc758 \uba85\uce6d\uacfc \uc774\ub54c\uc758 \uc5d0\ub108\uc9c0 \ucd9c\uc785\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2b9\ud654, \uc5d0\ub108\uc9c0(\uc5f4) \ud761\uc218"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0c9\ub9e4\uac00 \uc21c\ud658\ud558\ub294 \ub0c9\uc7a5\uace0 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \uc5d0\ub108\uc9c0\uac00 \ud761\uc218\ub418\ub294 \uc7a5\uc18c\uc640 \ubc29\ucd9c\ub418\ub294 \uc7a5\uc18c\ub97c \uac01\uac01 \uc4f0\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud761\uc218: \ub0c9\uc7a5\uace0 \ub0b4\ubd80 (\ub0c9\ub9e4 \uae30\ud654), \ubc29\ucd9c: \ub0c9\uc7a5\uace0 \ub4a4 \ubc29\uc5f4\ud310 (\ub0c9\ub9e4 \uc561\ud654)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ud559 \ubc18\uc751 \uc2dc \uc5d0\ub108\uc9c0\ub97c \ubc29\ucd9c\ud558\ub294 \ud604\uc0c1\uc758 \uc2e4\uc0dd\ud65c \uc751\uc6a9 \uc7a5\uce58 2\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\uc5f4 \uc6a9\uae30(\uc0b0\ud654 \uce7c\uc298+\ubb3c), \ucca0 \uac00\ub8e8 \uc190\ub09c\ub85c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\ud559 \ubc18\uc751 \uc2dc \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\ub294 \ud604\uc0c1\uc758 \uc2e4\uc0dd\ud65c \uc751\uc6a9 \uc7a5\uce58 2\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0c9\uac01 \ud329, \uc18c\ud654\uae30(\uc561\uccb4 \ubd84\ud574)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \uce7c\uc298 \uc218\uc6a9\uc561\uc758 \uc131\uc9c8 \ub54c\ubb38\uc5d0 \uc54c\ub8e8\ubbf8\ub284 \uc6a9\uae30 \uc0ac\uc6a9\uc744 \uae08\ud558\ub294 \ud654\ud559\uc801 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \uce7c\uc298 \uc218\uc6a9\uc561\uc774 \uc5fc\uae30\uc131\uc744 \ub760\uc5b4 \uc54c\ub8e8\ubbf8\ub284\uacfc \ubc18\uc751\ud558\uc5ec \uc6a9\uae30\ub97c \uc190\uc0c1(\ubd80\uc2dd)\uc2dc\ud0a4\uae30 \ub54c\ubb38\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c\uc774 \uc218\uc99d\uae30\ub85c \uae30\ud654\ud560 \ub54c \ud0dc\uc591\uc758 \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc9c0 \ubabb\ud558\uba74 \uc9c0\uad6c \ud658\uacbd\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc774 \uc77c\uc5b4\ub098\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uad6c \uc2dc\uc2a4\ud15c \ub0b4\uc5d0\uc11c \ubb3c\uc758 \uc21c\ud658\uc774 \uc77c\uc5b4\ub098\uc9c0 \uc54a\ub294\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c\uc9c8 \ubcc0\ud654(\ud654\ud559 \ubcc0\ud654 \ubc0f \uc0c1\ud0dc \ubcc0\ud654)\uac00 \uc77c\uc5b4\ub0a0 \ub54c \ud544\uc218\uc801\uc73c\ub85c \uc218\ubc18\ub418\ub294 \ud604\uc0c1\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\ub108\uc9c0\uc758 \ucd9c\uc785 (\ud761\uc218 \ub610\ub294 \ubc29\ucd9c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5fc\ud654 \uce7c\uc298($CaCl_2$)\uc774 \ubb3c\uc5d0 \ub179\ub294 \uacfc\uc815\uc740 \ud654\ud559 \ubcc0\ud654\uc778\uac00, \uc6a9\ud574 \ud604\uc0c1\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c\uc9c8\uc774 \ubb3c\uc5d0 \ub179\ub294 \uc6a9\ud574 \ud604\uc0c1\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5fc\ud654 \uce7c\uc298 \uc6a9\ud574 \uc2dc \uc5d0\ub108\uc9c0\uac00 \ubc29\ucd9c\ub428\uc744 \uc54c \uc218 \uc788\ub294 \uc9c1\uc811\uc801\uc778 \uce21\uc815 \uc9c0\ud45c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6a9\uc561 \ubc0f \uc8fc\ubcc0\uc758 \ucd5c\uace0 \uc628\ub3c4 \uc0c1\uc2b9"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\uc5b4\ucee8\uacfc \ub0c9\uc7a5\uace0\uc5d0\uc11c \uc5f4\uc744 \ud761\uc218/\ubc29\ucd9c\ud558\uae30 \uc704\ud574 \uacf5\ud1b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uc5f4 \uc804\ub2ec \ubb3c\uc9c8\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub0c9\ub9e4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\ud654 \uce7c\uc298\uacfc \ubb3c\uc758 \ubc18\uc751\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc5f4\uc744 \uc774\uc6a9\ud558\uc5ec \ub9cc\ub4e0 \uc774\ub3d9\uc2dd \uac00\uc5f4 \uc6a9\uae30\uc758 \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\uc5f4 \uc6a9\uae30 (\ubc1c\uc5f4 \ud329)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uba85\uccb4 \ub0b4\ubd80\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \uc138\ud3ec\ud638\ud761\uacfc \uad11\ud569\uc131 \uc911 \ud0dc\uc591 \ube5b\uc5d0\ub108\uc9c0\ub97c \ud654\ud559 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud558\uc5ec \uc800\uc7a5\ud558\ub294 \ubc18\uc751\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uad11\ud569\uc131"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
