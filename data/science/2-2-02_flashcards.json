    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc11d\uc758 N\uadf9\uc744 \ucf54\uc77c\uc5d0 \uac00\uae4c\uc774 \ud560 \ub54c\uc640 S\uadf9\uc744 \ucf54\uc77c\uc5d0\uc11c \uba40\ub9ac \ud560 \ub54c \ud750\ub974\ub294 \uc720\ub3c4 \uc804\ub958\uc758 \ubc29\ud5a5\uc740 \ub3d9\uc77c\ud55c\uac00, \ubc18\ub300\uc778\uac00?"
