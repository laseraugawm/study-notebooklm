    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\uc804\uae30 \ub0b4\ubd80\uc5d0\uc11c \ud68c\uc804\ud558\ub294 \uc790\uc11d\uc774 \ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 _____\uc744/\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \ubcc0\ud654\uc2dc\ud0b4\uc73c\ub85c\uc368 \uc720\ub3c4 \uc804\ub958\uac00 \ubc1c\uc0dd\ud55c\ub2e4."
          }
        ]
