      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd88\ube5b\uc774 \ub354 \ubc1d\uc544\uc9c4\ub2e4. \ud68c\uc804 \uc18d\ub3c4\uac00 \ube60\ub97c\uc218\ub85d \uc790\uae30\uc7a5\uc758 \ubcc0\ud654\uac00 \uac00\ud314\ub77c\uc838 \ub354 \uac15\ud55c \uc720\ub3c4 \uc804\ub958\uac00 \ud750\ub974\uae30 \ub54c\ubb38\uc774\ub2e4."
