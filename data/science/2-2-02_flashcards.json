      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc678\ubd80 \uacf5\uae09 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \uc5c6\uc73c\uba74 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub420 \uc218 \uc788\ub294 \uc5d0\ub108\uc9c0\uac00 \uc18c\uc9c4\ub418\uae30 \ub54c\ubb38\uc774\ub2e4."
