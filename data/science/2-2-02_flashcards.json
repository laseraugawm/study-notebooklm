      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "400\ud68c \uac10\uc740 \ucf54\uc77c (\ucf54\uc77c\uc744 \ub9ce\uc774 \uac10\uc744\uc218\ub85d \uc720\ub3c4 \uc804\ub958\uc758 \uc138\uae30\uac00 \ud07c)"
