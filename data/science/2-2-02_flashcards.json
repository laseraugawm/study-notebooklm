        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud750\ub974\uc9c0 \uc54a\ub294\ub2e4. (\uc0c1\ub300 \uc18d\ub3c4\uac00 0\uc774\uc5b4\uc11c \ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc758 \ubcc0\ud654\uac00 \uc5c6\uae30 \ub54c\ubb38)"
