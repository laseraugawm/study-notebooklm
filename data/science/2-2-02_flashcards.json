    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc11d\uc744 \ucf54\uc77c\uc5d0 \ube68\ub9ac \uc811\uadfc\uc2dc\ucf30\ub2e4\uac00 \ucc9c\ucc9c\ud788 \uba40\ub9ac\ud560 \ub54c \uc720\ub3c4 \uc804\ub958\uc758 \uc138\uae30 \ubcc0\ud654\ub294 \uc5b4\ub5a0\ud55c\uac00?"
