    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\uad11 \ud0a5\ubcf4\ub4dc\ub97c \ud0c8 \ub54c \ubc14\ud034\ub97c \ub354 \ube60\ub974\uac8c \ud68c\uc804\uc2dc\ud0a4\uba74 \ubd88\ube5b\uc758 \ubc1d\uae30\ub294 \uc5b4\ub5bb\uac8c \ubcc0\ud654\ud558\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
