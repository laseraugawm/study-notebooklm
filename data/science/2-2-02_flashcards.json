      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc811\uadfc\uc2dc\ud0ac \ub54c(\ube60\ub97c \ub54c) \uc720\ub3c4 \uc804\ub958\uac00 \ub354 \uc138\uace0, \uba40\ub9ac\ud560 \ub54c(\ucc9c\ucc9c\ud788 \ud560 \ub54c) \uc720\ub3c4 \uc804\ub958\uac00 \ub354 \uc57d\ud558\ub2e4."
