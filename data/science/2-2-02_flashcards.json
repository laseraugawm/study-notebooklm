    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc11d\uc758 N\uadf9\uc744 \ucf54\uc77c\uc5d0 \uac00\uae4c\uc774 \uc811\uadfc\uc2dc\ud0ac \ub54c \uac80\ub958\uacc4 \ubc14\ub298\uc774 \uc624\ub978\ucabd\uc73c\ub85c \uc6c0\uc9c1\uc600\ub2e4\uba74, S\uadf9\uc744 \ucf54\uc77c\uc5d0 \uac00\uae4c\uc774 \uc811\uadfc\uc2dc\ud0ac \ub54c \uac80\ub958\uacc4 \ubc14\ub298\uc740 \uc5b4\ub290 \ubc29\ud5a5\uc73c\ub85c \uc6c0\uc9c1\uc774\ub294\uac00?"
