      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\uad11 \ub2e4\uc774\uc624\ub4dc(LED)\uc5d0 \ubd88\uc774 \ucf1c\uc9c4\ub2e4."
