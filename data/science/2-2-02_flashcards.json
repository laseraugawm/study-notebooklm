          {
            "type": "text",
            "content": "\ub124\uc624\ub514\ubbb4 \uc790\uc11d (\uc790\uc11d\uc758 \uc790\uae30\uc7a5\uc774 \uc140\uc218\ub85d \uc720\ub3c4 \uc804\ub958\uc758 \uc138\uae30\uac00 \ud07c)"
