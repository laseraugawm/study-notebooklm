    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc11d\uc744 \ucf54\uc77c\uc5d0 \ub611\uac19\uc740 \uc18d\ub3c4\ub85c \uac00\uae4c\uc774 \ud560 \ub54c, 100\ud68c \uac10\uc740 \ucf54\uc77c\uacfc 400\ud68c \uac10\uc740 \ucf54\uc77c \uc911 \uc720\ub3c4 \uc804\ub958\uac00 \ub354 \uc138\uac8c \ud750\ub974\ub294 \uac83\uc740 \uc5b4\ub290 \uac83\uc778\uac00?"
