            "type": "text",
            "content": "\uc790\uae30\uc7a5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc11d\uc758 N\uadf9\uc744 \uc811\uadfc\uc2dc\ud0ac \ub54c\uc640 S\uadf9\uc744 \uba40\ub9ac\ud560 \ub54c \ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc758 \ubcc0\ud654 \ubc29\ud5a5\uc740 \uc5b4\ub5a0\ud55c\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc77c\ud558\ub2e4. (\ub458 \ub2e4 N\uadf9 \uc790\uae30\uc7a5\uc774 \uac15\ud574\uc9c0\ub294 \ubc29\ud5a5\uacfc \uac19\uc740 \ud6a8\uacfc\ub97c \uac00\uc9d0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac04\uc774 \ubc1c\uc804\uae30 \uc81c\uc791 \uc2dc \ubc1c\uad11 \ub2e4\uc774\uc624\ub4dc(LED) \ub300\uc2e0 \uac80\ub958\uacc4\ub97c \uc5f0\uacb0\ud574\ub3c4 \uc804\ub958 \ubc1c\uc0dd \uc5ec\ubd80\ub97c \ud655\uc778\ud560 \uc218 \uc788\ub294\uac00?"
          }
