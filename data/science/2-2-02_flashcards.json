      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc11d\uacfc \ucf54\uc77c \uc0ac\uc774\uc758 \uac70\ub9ac\uac00 \ubcc0\ud654\ud558\uc5ec \ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uae30\uc7a5\uc758 \uc138\uae30\uac00 \ubcc0\ud558\ub294 \uc6b4\ub3d9\uc744 \ud55c\ub2e4\ub294 \uc758\ubbf8\uc774\ub2e4."
