        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc790\uae30 \uc720\ub3c4 \ud604\uc0c1\uc744 \uc774\uc6a9\ud574 \ub9cc\ub4e0 \uac04\uc774 \ubc1c\uc804\uae30\uc5d0\uc11c \uc790\uc11d\uc744 \ub3cc\ub9ac\ub294 \ud798(\ud68c\uc804 \uc6b4\ub3d9)\uc740 \ucd5c\uc885\uc801\uc73c\ub85c \uc5b4\ub5a4 \ud615\ud0dc\uc758 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\ub294\uac00?"
