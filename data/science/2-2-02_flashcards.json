    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc11d\uacfc \ucf54\uc77c\uc774 \uac19\uc740 \uc18d\ub3c4\uc640 \uac19\uc740 \ubc29\ud5a5\uc73c\ub85c \ud568\uaed8 \uc774\ub3d9\ud55c\ub2e4\uba74 \ucf54\uc77c\uc5d0 \uc720\ub3c4 \uc804\ub958\uac00 \ud750\ub974\ub294\uac00?"
