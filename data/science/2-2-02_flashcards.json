      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucf54\uc77c\uc758 \uac10\uc740 \uc218\ub97c \ub298\ub9ac\uac70\ub098, \ub354 \uc13c \uc790\uc11d\uc744 \uc0ac\uc6a9\ud558\uac70\ub098, \ud130\ube48\uc744 \uac00\ub3d9\ud574 \uc790\uc11d\uc744 \ub9e4\uc6b0 \ube60\ub974\uac8c \ud68c\uc804\uc2dc\ud0a8\ub2e4."
