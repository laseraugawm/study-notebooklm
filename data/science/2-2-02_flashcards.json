      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6c0\uc9c1\uc774\uc9c0 \uc54a\uc744 \ub54c\ub294 \uac80\ub958\uacc4 \ubc14\ub298\uc774 0(\uc815\uc9c0)\uc744 \uac00\ub9ac\ud0a4\uace0, \uc6c0\uc9c1\uc77c \ub54c\ub294 \ubc14\ub298\uc774 \uc88c\uc6b0\ub85c \uae30\uc6b8\uc5b4\uc9c0\uba70 \uc804\ub958\uac00 \ud750\ub984\uc744 \ub098\ud0c0\ub0b8\ub2e4."
