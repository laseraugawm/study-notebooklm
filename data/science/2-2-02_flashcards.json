    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac04\uc774 \ubc1c\uc804\uae30 \uc2e4\ud5d8\uc5d0\uc11c \uc190\uc73c\ub85c \ud68c\uc804\uc2dc\ud0a4\ub294 \uc18d\ub3c4\ub97c \ub290\ub9ac\uac8c \ud560 \ub54c LED \ube5b\uc758 \ubc1d\uae30\ub294 \uc5b4\ub5bb\uac8c \ubcc0\ud654\ud558\ub294\uac00?"
