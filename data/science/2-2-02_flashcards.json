      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud655\uc778\ud560 \uc218 \uc788\ub2e4. (\uac80\ub958\uacc4 \ubc14\ub298\uc758 \uc6c0\uc9c1\uc784\uc744 \ud1b5\ud574 \uc720\ub3c4 \uc804\ub958 \ubc1c\uc0dd\uc744 \uce21\uc815 \uac00\ub2a5)"
          }
        ]
