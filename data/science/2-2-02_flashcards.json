        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc11d\uc744 \ucf54\uc77c \uadfc\ucc98\uc5d0\uc11c \uc6c0\uc9c1\uc5ec \uc720\ub3c4 \uc804\ub958\uc758 \uc138\uae30\ub97c 2\ubc30\ub85c \uc99d\uac00\uc2dc\ud0a4\uae30 \uc704\ud55c \uad6c\uccb4\uc801\uc778 \ubc29\ubc95 \ud55c \uac00\uc9c0\ub97c \ub9d0\ud558\uc2dc\uc624."
