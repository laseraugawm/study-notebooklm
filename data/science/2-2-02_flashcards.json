    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\uc804\uc18c\uc5d0\uc11c \ub300\uaddc\ubaa8 \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc5bb\uae30 \uc704\ud574 \ubc1c\uc804\uae30 \ub0b4\ubd80 \uad6c\uc870\uc0c1 \uc870\uc808\ud560 \uc218 \uc788\ub294 \uc694\uc18c\ub97c \uc4f0\uc2dc\uc624."
