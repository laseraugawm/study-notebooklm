    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac04\uc774 \ubc1c\uc804\uae30 \uc2e4\ud5d8\uc5d0\uc11c \ub098\ubb34\uc813\uac00\ub77d\uc744 \ube60\ub974\uac8c \ud68c\uc804\uc2dc\ud0a4\uba74 \ubc1c\uad11 \ub2e4\uc774\uc624\ub4dc(LED)\uc5d0 \uc5b4\ub5a4 \ud604\uc0c1\uc774 \uc77c\uc5b4\ub098\ub294\uac00?"
