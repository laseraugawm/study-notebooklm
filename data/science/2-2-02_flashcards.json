        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3d9\uc77c\ud55c \ucf54\uc77c\uc5d0 \ub3d9\uc77c\ud55c \uc790\uc11d\uc744 1 m/s\ub85c \uac00\uae4c\uc774 \ud560 \ub54c\uc640 3 m/s\ub85c \uac00\uae4c\uc774 \ud560 \ub54c, \uc720\ub3c4 \uc804\ub958\uc758 \uc138\uae30\ub97c \ube44\uad50\ud558\uc2dc\uc624."
