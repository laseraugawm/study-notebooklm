    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc11d\uc758 N\uadf9\uc774 \ucf54\uc77c\uc5d0 \uac00\uae4c\uc6cc\uc9c8 \ub54c, \ucf54\uc77c\uc744 \ud1b5\uacfc\ud558\ub294 \uc790\uc11d\uc5d0 \uc758\ud55c \uc790\uae30\uc120\uc18d(\uc790\uae30\uc7a5)\uc740 \uc99d\uac00\ud558\ub294\uac00, \uac10\uc18c\ud558\ub294\uac00?"
