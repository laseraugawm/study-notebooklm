        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc6d0 \uc5f0\uacb0 \uc5c6\uc774\ub3c4 \ud68c\uc804\ub9cc\uc73c\ub85c \ube5b\uc774\ub098 \uc804\uae30\ub97c \ub0b4\ub294 \ubc1c\uad11 \ud0a5\ubcf4\ub4dc\uc640 \uc790\uc804\uac70 \ubc1c\uc804\uae30\ub294 \uacf5\ud1b5\uc801\uc73c\ub85c \uc5b4\ub5a4 \ubb3c\ub9ac \ud604\uc0c1\uc744 \uc774\uc6a9\ud558\ub294\uac00?"
