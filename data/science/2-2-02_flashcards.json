    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\uc804\uae30\uc5d0\uc11c \uc190\uc774\ub098 \ud130\ube48\uc744 \uba48\ucd94\uba74 \uc804\uae30\uac00 \ub354 \uc774\uc0c1 \uc0dd\uc0b0\ub418\uc9c0 \uc54a\ub294 \uc5d0\ub108\uc9c0 \ubcf4\uc874\uc801 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00?"
