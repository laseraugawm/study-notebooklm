    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uc790\uae30 \uc720\ub3c4\uc5d0\uc11c \ucf54\uc77c\uacfc \uc790\uc11d\uc774 \uc0c1\ub300 \uc6b4\ub3d9\uc744 \ud55c\ub2e4\ub294 \uac83\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc778\uac00?"
