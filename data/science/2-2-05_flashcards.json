{
  "title": "\uc2e0\uc7ac\uc0dd\uc5d0\ub108\uc9c0 \ud50c\ub798\uc2dc\uce74\ub4dc\ub85c",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub780 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud587\ube5b, \ubc14\ub78c, \ud574\uc591 \ub4f1\uc744 \ubcc0\ud658\ud558\uc5ec \uc774\uc6a9\ud558\ub294 \uc5d0\ub108\uc9c0\uc640 \uc11d\ud0c4\uc758 \uc561\ud654\u00b7\uac00\uc2a4\ud654 \ub610\ub294 \uc218\uc18c, \uc0b0\uc18c \ub4f1\uc758 \ud654\ud559 \ubc18\uc751\uc5d0\uc11c \ubc1c\uc0dd\ud55c \uc5d0\ub108\uc9c0\ub97c \ud569\uccd0 \ubd80\ub974\ub294 \ub9d0\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\uac00 \ud654\uc11d \uc5f0\ub8cc\uc640 \uad6c\ubd84\ub418\ub294 \uac00\uc7a5 \ud070 \ud2b9\uc9d5 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uace0\uac08\ub418\uc9c0 \uc54a\uace0 \uc9c0\uc18d\ud574\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub2e4\ub294 \uc810\uacfc \ud658\uacbd\ubb38\uc81c\ub97c \uc77c\uc73c\ud0a4\uc9c0 \uc54a\ub294\ub2e4\ub294 \uc810\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uad11 \ubc1c\uc804\uc758 \uc5d0\ub108\uc9c0 \ubcc0\ud658 \uacfc\uc815\uc740 \uc5b4\ub5bb\uac8c \ub418\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591 \uc804\uc9c0\ub97c \uc774\uc6a9\ud574 \ube5b\uc5d0\ub108\uc9c0\ub97c \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc9c1\uc811 \uc804\ud658\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591 \uc804\uc9c0\uc5d0 \ube5b\uc744 \ube44\ucd94\uc5c8\uc744 \ub54c \uc804\ub958\uac00 \ud750\ub974\ub294 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591 \uc804\uc9c0\uc5d0 \ube5b\uc744 \ube44\ucd94\uba74 \uc804\uc790\uac00 \uc6c0\uc9c1\uc774\uba74\uc11c \uc804\ub958\uac00 \ud750\ub974\uac8c \ub429\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uad11 \ubc1c\uc804\uc758 \uc7a5\uc810 3\uac00\uc9c0\ub97c \uc81c\uc2dc\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc6d0\uc774 \uace0\uac08\ub420 \uc5fc\ub824\uac00 \uc5c6\uace0, \ud658\uacbd\uc624\uc5fc \ubb3c\uc9c8\uc744 \ubc30\ucd9c\ud558\uc9c0 \uc54a\uc73c\uba70, \ube44\uad50\uc801 \uc800\ub834\ud558\uac8c \uc804\ub825\uc744 \uc0dd\uc0b0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uad11 \ubc1c\uc804\uc758 \ub2e8\uc810 2\uac00\uc9c0\uc5d0 \ub300\ud574 \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc0ac\ub7c9 \ubcc0\ub3d9\uc5d0 \ub530\ub77c \ubc1c\uc804\ub7c9\uc774 \ub2ec\ub77c\uc9c0\uace0, \ub300\uaddc\ubaa8\ub85c \ubc1c\uc804\ud558\ub824\uba74 \ub113\uc740 \uba74\uc801\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\ub825 \ubc1c\uc804\uc758 \uae30\ubcf8 \uc791\ub3d9 \uc6d0\ub9ac\uc640 \uc5d0\ub108\uc9c0 \ubcc0\ud658 \uacfc\uc815\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub78c\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \ub0a0\uac1c\uc640 \uc5f0\uacb0\ub41c \ubc1c\uc804\uae30\ub97c \ub3cc\ub824 \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc0dd\uc0b0\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\ub825 \ubc1c\uc804\uc758 \uc8fc\uc694 \uc7a5\uc810 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub78c \uc790\uc6d0\uc774 \ud48d\ubd80\ud558\uace0, \uacf5\ud574 \ubb3c\uc9c8 \ubc30\ucd9c\uc774 \uc5c6\uc5b4 \uce5c\ud658\uacbd\uc801\uc774\uba70, \ube44\uad50\uc801 \uc800\ub834\ud558\uac8c \uc804\ub825\uc744 \uc0dd\uc0b0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\ub825 \ubc1c\uc804\uc774 \uac00\uc9c4 \ub2e8\uc810 3\uac00\uc9c0\ub97c \uc124\uba85\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc1c\uc804 \uc9c0\uc5ed\uc774 \uc81c\ud55c\uc801\uc774\uace0, \ubc14\ub78c\uc5d0 \ub530\ub77c \ubc1c\uc804\ub7c9\uc744 \uc608\uce21\ud558\uae30 \uc5b4\ub824\uc6b0\uba70, \ub0a0\uac1c \ud68c\uc804 \uc2dc \uc18c\uc74c\uc774 \ubc1c\uc0dd\ud558\uc5ec \uc8fc\ubcc0\uc5d0 \ud53c\ud574\ub97c \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub8cc \uc804\uc9c0\ub294 \uc5b4\ub5a4 \uc5d0\ub108\uc9c0 \ubcc0\ud658\uc744 \uac70\uccd0 \uc804\uae30\ub97c \uc0dd\uc0b0\ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc18c\uc640 \uc0b0\uc18c\uc5d0 \uc800\uc7a5\ub41c \ud654\ud559 \uc5d0\ub108\uc9c0\ub97c \ud654\ud559 \ubc18\uc751\uc744 \uc774\uc6a9\ud574 \uc9c1\uc811 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub8cc \uc804\uc9c0 \ub0b4\ubd80\uc5d0\uc11c \uc804\ub958\uac00 \ud750\ub974\ub294 \ud654\ud559\uc801 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc18c\uac00 \uc0b0\ud654\ub418\uba74\uc11c \ub0b4\ub193\uc740 \uc804\uc790\uac00 \uc774\ub3d9\ud558\uc5ec \uc804\ub958\uac00 \ud750\ub985\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub8cc \uc804\uc9c0\uc758 \uc8fc\uc694 \uc7a5\uc810 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\ub108\uc9c0 \ud6a8\uc728\uc774 \ub192\uace0 \ud658\uacbd\uc624\uc5fc\uc744 \uac70\uc758 \uc77c\uc73c\ud0a4\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub8cc \uc804\uc9c0\ub97c \uc2e4\uc6a9\ud654\ud558\uae30 \uc704\ud574 \uc694\uad6c\ub418\ub294 \uae30\uc220\uc801 \ub2e8\uc810 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud6a8\uc728\uc801\uc778 \uc218\uc18c \uc800\uc7a5 \uae30\uc220\uacfc \uc548\uc815\uc131 \ud655\ubcf4\ub97c \uc704\ud55c \uae30\uc220\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\ub825 \ubc1c\uc804\uc758 \uc6d0\ub9ac\uc640 \uc804\ub825 \uc0dd\uc0b0 \uacfc\uc815\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc00\ubb3c\uacfc \uc370\ubb3c\ub85c \uc0dd\uae30\ub294 \ud574\uc218\uba74\uc758 \ub192\uc774 \ucc28(\uc870\ucc28)\ub97c \uc774\uc6a9\ud558\uc5ec \ubc14\ub2f7\ubb3c\ub85c \ubc1c\uc804\uae30\ub97c \ub3cc\ub824 \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc0dd\uc0b0\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\ub825 \ubc1c\uc804\uc758 \ub300\ud45c\uc801\uc778 \uc7a5\uc810 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uae30\ub97c \ub300\ub7c9\uc73c\ub85c \uc0dd\uc0b0\ud560 \uc218 \uc788\uace0, \uc870\uc11d \uc8fc\uae30\uc5d0 \ub530\ub77c \ubc1c\uc804\ub7c9\uc744 \uc608\uce21\ud558\uae30 \uc27d\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\ub825 \ubc1c\uc804\uc774 \uac00\uc9c0\ub294 \uc785\uc9c0\uc801 \ubc0f \uacbd\uc81c\uc801 \ub2e8\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud574\uc218\uba74\uc758 \ub192\uc774 \ucc28\uac00 \ud070 \uc9c0\uc5ed\uc5d0\ub9cc \uc124\uce58\ud574\uc57c \ud558\ub294 \uc81c\ud55c\uc774 \uc788\uc73c\uba70, \ucd08\uae30 \uc124\uce58 \ube44\uc6a9\uc774 \ub9ce\uc774 \ub4ed\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\uc774\uc624 \uc5d0\ub108\uc9c0\ub294 \ubb34\uc5c7\uc744 \uc5f0\ub8cc\ub85c \ud558\uc5ec \uc5bb\ub294 \uc5d0\ub108\uc9c0\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ubb3c, \ubbf8\uc0dd\ubb3c, \uc720\uae30\uc131 \ud3d0\uc790\uc6d0 \ub4f1 \uc0dd\ubb3c \uc790\uc6d0(\ubc14\uc774\uc624\ub9e4\uc2a4)\uc744 \uc5f0\ub8cc\ub85c \ud558\uc5ec \uc5bb\ub294 \uc5d0\ub108\uc9c0\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\uc774\uc624 \uc5d0\ub108\uc9c0\uac00 \uac00\uc9c0\ub294 \uc7a5\uc810 3\uac00\uc9c0\ub97c \uc11c\uc220\ud558\uc2dc\uc624."
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5f0\ub8cc\uc5d0 \ube44\ud574 \uc774\uc0b0\ud654 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \uc801\uace0 \uc800\ub834\ud558\uba70, \uace0\uccb4\u00b7\uc561\uccb4 \uc5f0\ub8cc \ub4f1 \ub2e4\uc591\ud55c \ud615\ud0dc\ub85c \ud65c\uc6a9\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\uc774\uc624 \uc5d0\ub108\uc9c0 \uc790\uc6d0\uc744 \uc0dd\uc0b0\ud558\uace0 \ud65c\uc6a9\ud560 \ub54c \ubc1c\uc0dd\ud558\ub294 \ub2e8\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\ub8cc\uac00 \ub418\ub294 \uc2dd\ubb3c\uc744 \uc7ac\ubc30\ud558\ub294 \ub370 \ub113\uc740 \ud1a0\uc9c0\uac00 \ud544\uc694\ud558\uba70, \uc7ac\ubc30 \uacfc\uc815\uc5d0 \uc2dc\uac04\uc774 \uc624\ub798 \uac78\ub9ac\uace0 \uc5d0\ub108\uc9c0\uac00 \uc18c\ubaa8\ub429\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc0c1 \ud0dc\uc591\uad11 \ubc1c\uc804\uc740 \uae30\uc874 \uc721\uc0c1 \ud0dc\uc591\uad11 \ubc1c\uc804\uc758 \uc5b4\ub5a4 \ud55c\uacc4\uc810\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \uc81c\uc548\ub418\uc5c8\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub113\uc740 \ubd80\uc9c0 \ud655\ubcf4 \ubb38\uc81c\uc640 \uc2dc\uc124 \uc124\uce58\uc5d0 \ub530\ub978 \uc0b0\ub9bc \ud6fc\uc190 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc81c\uc548\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc0c1 \ud0dc\uc591\uad11 \ubc1c\uc804\uc774 \uc6b0\ub9ac\ub098\ub77c \uc790\uc5f0\ud658\uacbd\uc5d0 \uc801\ud569\ud55c \uc9c0\ud615\uc801 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6b0\ub9ac\ub098\ub77c\ub294 3\uba74\uc774 \ubc14\ub2e4\ub85c \ub458\ub7ec\uc2f8\uc5ec \uc788\uace0 \uac15\uacfc \uc800\uc218\uc9c0\uac00 \ub9ce\uc544 \uc218\uc0c1 \uc124\uce58 \uacf5\uac04\uc774 \ud48d\ubd80\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc0c1 \ud0dc\uc591\uad11 \ubc1c\uc804\uc774 \uc721\uc0c1 \ud0dc\uc591\uad11 \ubc1c\uc804\ubcf4\ub2e4 \ubc1c\uc804 \ud6a8\uc728\uc774 \ub192\uc544\uc9c0\ub294 \uacfc\ud559\uc801 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uba74\uc758 \ub0c9\uac01 \ud6a8\uacfc \ub355\ubd84\uc5d0 \ud328\ub110 \uc628\ub3c4\uac00 \ub0ae\uac8c \uc720\uc9c0\ub418\uc5b4 \ubc1c\uc804 \ud6a8\uc728\uc774 \uc57d $10\\%$ \uc815\ub3c4 \ud5a5\uc0c1\ub429\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc0c1 \ud0dc\uc591\uad11 \ubc1c\uc804 \uad6c\uc870\ubb3c\uc774 \uc218\uc9c8 \ubc0f \uc218\uc0dd \uc0dd\ud0dc\uacc4 \ud658\uacbd\uc5d0 \ub3c4\uc6c0\uc744 \uc8fc\ub294 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uba74\uc5d0 \uc124\uce58\ub41c \uad6c\uc870\ubb3c\uc774 \uc9c1\uc0ac\uad11\uc120\uc744 \ucc28\ub2e8\ud558\uc5ec \ub179\uc870\uc758 \ubc1c\uc0dd\uacfc \ud655\uc0b0\uc744 \uc5b5\uc81c\ud574 \uc90d\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uad11, \ud48d\ub825, \uc870\ub825 \ubc1c\uc804 \uc911 '\uc804\uc790\uae30 \uc720\ub3c4 \ud604\uc0c1'\uc744 \uc774\uc6a9\ud558\uc5ec \uc804\uae30\ub97c \uc0dd\uc0b0\ud558\ub294 \ubc1c\uc804 \ubc29\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\ub825 \ubc1c\uc804\uacfc \uc870\ub825 \ubc1c\uc804\uc785\ub2c8\ub2e4. (\ubc14\ub78c\uc774\ub098 \ubc14\ub2f7\ubb3c\ub85c \ubc1c\uc804\uae30/\ud130\ube48\uc744 \ud68c\uc804\uc2dc\ucf1c \uc0dd\uc0b0)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uad11 \ubc1c\uc804\uacfc \uc5f0\ub8cc \uc804\uc9c0\uc758 \uacf5\ud1b5\uc810 \uc911 '\ubc1c\uc804\uae30 \uad6c\uc870'\uc640 \uad00\ub828\ub41c \ud2b9\uc131\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud68c\uc804\ud558\ub294 \ud130\ube48\uc774\ub098 \ubc1c\uc804\uae30\ub97c \ub3cc\ub9ac\uc9c0 \uc54a\uace0(\uc804\uc790\uae30 \uc720\ub3c4\ub97c \uc774\uc6a9\ud558\uc9c0 \uc54a\uace0) \uc9c1\uc811 \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc0dd\uc0b0\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\uc7ac \ub300\uae30 \uc911 \uc774\uc0b0\ud654 \ud0c4\uc18c($CO_2$) \ub18d\ub3c4\uac00 \uae09\uaca9\ud788 \ub192\uc544\uc9c4 \uc8fc\uc694 \uc6d0\uc778\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5f0\ub8cc\uc758 \uacfc\ub3c4\ud55c \uc0ac\uc6a9\uc73c\ub85c \uc778\ud55c \uc628\uc2e4\uae30\uccb4 \ubc30\ucd9c\uc774 \uc8fc\uc694 \uc6d0\uc778\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uad6c \ud658\uacbd \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574 \ud654\uc11d \uc5f0\ub8cc \ub300\uc2e0 \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub97c \uac1c\ubc1c\ud574\uc57c \ud558\ub294 \uadfc\ubcf8\uc801 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5f0\ub8cc \uc0ac\uc6a9\uc73c\ub85c \uc778\ud55c \uc628\uc2e4\uae30\uccb4 \ubc30\ucd9c\uacfc \uc9c0\uad6c \uc628\ub09c\ud654\ub97c \uc904\uc774\uace0, \uc790\uc6d0 \uace0\uac08 \ubb38\uc81c\uc5d0 \ub300\ube44\ud574 \uc9c0\uc18d \uac00\ub2a5\ud55c \ubc1c\uc804\uc744 \ub3c4\ubaa8\ud558\uae30 \uc704\ud568\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uad11 \ubc1c\uc804\uacfc \ud48d\ub825 \ubc1c\uc804\uc758 \uacf5\ud1b5\uc801\uc778 \uc7a5\uc810 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5d0\ub108\uc9c0 \uc790\uc6d0\uc774 \uace0\uac08\ub420 \uc5fc\ub824\uac00 \uc5c6\uc73c\uba70, \uc804\ub825 \uc0dd\uc0b0 \uacfc\uc815\uc5d0\uc11c \ud658\uacbd\uc624\uc5fc \ubb3c\uc9c8\uc744 \ubc30\ucd9c\ud558\uc9c0 \uc54a\ub294 \uce5c\ud658\uacbd \ubc1c\uc804\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uad11 \ubc1c\uc804\uacfc \ubc14\uc774\uc624 \uc5d0\ub108\uc9c0\uac00 \uacf5\ud1b5\uc73c\ub85c \uc548\uace0 \uc788\ub294 \uc785\uc9c0\uc801 \ub2e8\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uaddc\ubaa8 \ubc1c\uc804 \uc2dc\uc124 \ub2e8\uc9c0 \uc870\uc131\uc774\ub098 \uc6d0\ub8cc \uc2dd\ubb3c \uc7ac\ubc30\ub97c \uc704\ud574 \ub113\uc740 \uba74\uc801\uc758 \ud1a0\uc9c0\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub8cc \uc804\uc9c0 \ub0b4\ubd80\uc5d0\uc11c \uc804\uc790\ub97c \uc804\ub2ec\ubc1b\uc544 \ud658\uc6d0 \ubc18\uc751\uc774 \uc77c\uc5b4\ub098\ub294 \ubb3c\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc18c($O_2$)\uc785\ub2c8\ub2e4. (\uc218\uc18c\ub294 \uc0b0\ud654\ud558\uc5ec \uc804\uc790\ub97c \ub0b4\ub193\uace0, \uc0b0\uc18c\ub294 \uc804\uc790\ub97c \ubc1b\uc74c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\ub825 \ubc1c\uc804\uacfc \uc870\ub825 \ubc1c\uc804\uc758 \ucc28\uc774\uc810 \uc911 '\ubc1c\uc804\ub7c9 \uc608\uce21' \uce21\uba74 \ube44\uad50"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\ub825 \ubc1c\uc804\uc740 \ubc14\ub78c \uc138\uae30 \ubcc0\ud654\ub85c \ubc1c\uc804\ub7c9 \uc608\uce21\uc774 \uc5b4\ub824\uc6b4 \ubc18\uba74, \uc870\ub825 \ubc1c\uc804\uc740 \uc77c\uc815\ud55c \uc870\uc11d \uc8fc\uae30 \ub355\ubd84\uc5d0 \ubc1c\uc804\ub7c9 \uc608\uce21\uc774 \uc27d\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591 \uc804\uc9c0\uc5d0 \ube5b\uc744 \ube44\ucd94\uc5c8\uc744 \ub54c \uc9c1\uc811\uc801\uc73c\ub85c \uc804\ud658\ub418\ub294 \uc5d0\ub108\uc9c0 \ud615\ud0dc\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ube5b\uc5d0\ub108\uc9c0 $\\rightarrow$ \uc804\uae30 \uc5d0\ub108\uc9c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\ub78c\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \ucd5c\uc885\uc801\uc73c\ub85c \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \ubc14\ub00c\ub294 \ubc1c\uc804 \ubc29\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\ub825 \ubc1c\uc804"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc18c\uc640 \uc0b0\uc18c\uc758 \ubc18\uc751\uc73c\ub85c \uc800\uc7a5\ub41c \ud654\ud559 \uc5d0\ub108\uc9c0\ub97c \uc9c1\uc811 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \ubc14\uafb8\ub294 \uc7a5\uce58\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub8cc \uc804\uc9c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc00\ubb3c\uacfc \uc370\ubb3c\uc5d0 \uc758\ud55c \ud574\uc218\uba74 \ub192\uc774 \ucc28\uc774\ub97c \uc774\uc6a9\ud558\ub294 \ud574\uc591 \uc5d0\ub108\uc9c0 \ubc1c\uc804 \ubc29\uc2dd\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\ub825 \ubc1c\uc804"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ubb3c, \ubbf8\uc0dd\ubb3c, \uc720\uae30\uc131 \ud3d0\uc790\uc6d0 \ub4f1\uc758 \uc0dd\ubb3c \uc790\uc6d0\uc744 \uc774\uc6a9\ud558\ub294 \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\uc774\uc624 \uc5d0\ub108\uc9c0"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud0dc\uc591\uad11 \ubc1c\uc804 \uc2dc \ud587\ube5b \uc591\uc758 \ubcc0\ud654\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc544 \uc77c\uc5b4\ub098\ub294 \ubc1c\uc804\ub7c9\uc758 \ud2b9\uc9d5\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc77c\uc0ac\ub7c9 \ubcc0\ub3d9\uc5d0 \ub530\ub77c \ubc1c\uc804\ub7c9\uc774 \ub2ec\ub77c\uc838 \uc548\uc815\uc774 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\ub825 \ubc1c\uc804\uae30 \uc124\uce58 \uc2dc \uc8fc\ubcc0 \uc8fc\ubbfc \ubc0f \uc0dd\ud0dc\uacc4\uc5d0 \uc18c\uc74c \ubb38\uc81c\ub97c \uc77c\uc73c\ud0a4\ub294 \uc694\uc778\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud48d\ub825 \ubc1c\uc804\uae30 \ub0a0\uac1c(\ube14\ub808\uc774\ub4dc) \ud68c\uc804 \uc2dc \ubc1c\uc0dd\ud558\ub294 \uc18c\uc74c\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub8cc \uc804\uc9c0\uc758 \uc0c1\uc6a9\ud654\ub97c \uc704\ud574 \uc548\uc804 \uce21\uba74\uc5d0\uc11c \ud544\uc218\uc801\uc73c\ub85c \ud655\ubcf4\ud574\uc57c \ud558\ub294 \uae30\uc220\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc18c \uac00\uc2a4\uc758 \ud6a8\uc728\uc801\uc778 \uc800\uc7a5 \uae30\uc220 \ubc0f \uc218\uc18c \ud3ed\ubc1c \ubc29\uc9c0 \ub4f1 \ud3ed\ubc1c/\ub204\ucd9c \uc548\uc815\uc131 \ud655\ubcf4 \uae30\uc220\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\ub825 \ubc1c\uc804\uc18c\ub97c \uac74\uc124\ud558\uae30 \uc704\ud574 \ud544\uc218\uc801\uc73c\ub85c \uac16\ucd94\uc5b4\uc57c \ud558\ub294 \uc790\uc5f0 \uc870\uac74\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc00\ubb3c\uacfc \uc370\ubb3c \ub54c \ud574\uc218\uba74\uc758 \ub192\uc774 \ucc28(\uc870\ucc28)\uac00 \ud070 \ud574\uc548 \uc9c0\uc5ed\uc774\uc5b4\uc57c \ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\uc774\uc624 \uc5d0\ub108\uc9c0\uac00 \uae30\uc874 \uc11d\uc720\u00b7\uc11d\ud0c4 \ub4f1\uc758 \ud654\uc11d \uc5f0\ub8cc\ubcf4\ub2e4 \ud658\uacbd\uc801\uc73c\ub85c \uc720\ub9ac\ud55c \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\uc18c \uc2dc \ubc30\ucd9c\ub418\ub294 \uc774\uc0b0\ud654 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \ud654\uc11d \uc5f0\ub8cc\ubcf4\ub2e4 \uc0c1\ub300\uc801\uc73c\ub85c \uc801\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc800\uc218\uc9c0\ub098 \uac15 \uc704\uc5d0 \ub5a0 \uc788\ub294 \uad6c\uc870\ubb3c \ud615\ud0dc\ub85c \uc124\uce58\ud558\ub294 \ud0dc\uc591\uad11 \ubc1c\uc804 \ubc29\uc2dd\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub098\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc0c1 \ud0dc\uc591\uad11 \ubc1c\uc804"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc0c1 \ud0dc\uc591\uad11 \ubc1c\uc804 \uc2dc\uc124\uc774 \ubb3c \uc704\uc5d0 \ub738\uc73c\ub85c\uc368 \uc5bb\ub294 \ub0c9\uac01 \ud6a8\uacfc\uc758 \uc774\uc810\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc628\ub3c4\uac00 \uacfc\ub3c4\ud558\uac8c \uc624\ub974\ub294 \uac83\uc744 \ub9c9\uc544 \uc721\uc0c1 \ud0dc\uc591\uad11\ubcf4\ub2e4 \uc57d $10\\%$ \ud5a5\uc0c1\ub41c \ubc1c\uc804 \ud6a8\uc728\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc0c1 \ud0dc\uc591\uad11 \ubc1c\uc804\uc774 \ub179\uc870 \uc608\ubc29\uc5d0 \ub3c4\uc6c0\uc744 \uc8fc\ub294 \ub9e4\ucee4\ub2c8\uc998\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uba74\uc5d0 \ucc28\uc591\ub9c9 \uc5ed\ud560\uc744 \ud558\ub294 \ubc1c\uc804 \ud328\ub110\uc774 \uc9c1\uc0ac\uad11\uc120\uc744 \ucc28\ub2e8\ud558\uc5ec \ub179\uc870\ub958\uc758 \uad11\ud569\uc131\uacfc \uc99d\uc2dd\uc744 \ucc28\ub2e8\ud569\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub97c \uad6c\uc131\ud558\ub294 \ub450 \uac00\uc9c0 \ubc94\uc8fc\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc5d0\ub108\uc9c0(\uc218\uc18c, \uc5f0\ub8cc\uc804\uc9c0, \uc11d\ud0c4\uc561\ud654\uac00\uc2a4\ud654 \ub4f1)\uc640 \uc7ac\uc0dd\uc5d0\ub108\uc9c0(\ud0dc\uc591, \ud48d\ub825, \ubc14\uc774\uc624, \uc870\ub825 \ub4f1)\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5f0\ub8cc \uc804\uc9c0 \ubc84\uc2a4\uac00 \ub3c4\ub85c\ub97c \ub2ec\ub9b4 \ub54c \ubc30\ucd9c\ud558\ub294 \uc720\uc77c\ud55c \ubd80\uc0b0\ubb3c\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb3c($H_2O$)\uc785\ub2c8\ub2e4. (\ud658\uacbd\uc624\uc5fc \ubb3c\uc9c8\uc744 \uac70\uc758 \ubc30\ucd9c\ud558\uc9c0 \uc54a\uc74c)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc870\ub825 \ubc1c\uc804\uc18c \uac74\uc124 \uc2dc \ub300\uaddc\ubaa8 \uacf5\uc0ac\ub85c \uc778\ud55c \ub2e8\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ucd08\uae30 \uc124\uce58 \ube44\uc6a9\uc774 \ub9ce\uc774 \ub4e4\uace0 \ud574\uc591 \uc0dd\ud0dc\uacc4 \ubcc0\ud654\ub97c \uc720\ubc1c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc14\uc774\uc624 \uc5d0\ub108\uc9c0\ub97c \uc561\uccb4 \uc5f0\ub8cc\ub098 \uace0\uccb4 \uc5f0\ub8cc \ub4f1 \ub2e4\uc591\ud55c \ud615\ud0dc\ub85c \ub9cc\ub4e4\uc5b4 \uc0ac\uc6a9\ud558\ub294 \ubaa9\uc801\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc1a1\uc6a9 \uc5f0\ub8cc\ub098 \ub09c\ubc29\uc6a9 \ub4f1 \uc6a9\ub3c4\uc5d0 \ub9de\uac8c \ub2e4\uc591\ud558\uace0 \ud6a8\uc728\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uae30 \uc704\ud574\uc11c\uc785\ub2c8\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uad6c \uc628\ub09c\ud654\uc640 \uae30\ud6c4 \ubcc0\ud654 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uae30\uc220\uc744 \ud65c\uc6a9\ud574\uc57c \ud558\ub294 \uc774\uc720\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
