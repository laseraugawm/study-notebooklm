{
  "title": "\ub370\uc774\ud130 \ube45\ub370\uc774\ud130 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\ub2e8\uc21c\ud55c \uc0ac\uc2e4\uc778 \ub370\uc774\ud130(Data)\uc640 \uc815\ubcf4(Information)\uc758 \uad00\uacc4\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud544\uc694\ud55c \ub370\uc774\ud130\ub97c \ubaa8\uc73c\uace0 \ubaa9\uc801\uc5d0 \ub9de\uac8c \ubd84\uc11d\ud568\uc73c\ub85c\uc368 \uc758\ubbf8 \uc788\ub294 \uc815\ubcf4\uac00 \uc0dd\uc131\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ub370\uc774\ud130 \uc790\uccb4\ub294 \ub2e8\uc21c\ud55c \uc0ac\uc2e4\uc774\ub098 \uad00\uce21 \uac12\uc5d0 \ubd88\uacfc\ud558\uc9c0\ub9cc, \uc774\ub97c \uc218\uc9d1\ud558\uace0 \ubd84\uc11d\ud558\ub294 \uacfc\uc815\uc744 \ud1b5\ud574 \uc758\ubbf8 \uc788\ub294 \uc815\ubcf4\ub85c \ubcc0\ud658\ub41c\ub2e4."
        },
        {
          "text": "\ub370\uc774\ud130\ub294 \uc774\ubbf8 \uacb0\ub860\uc774 \ub3c4\ucd9c\ub41c \uc0c1\ud0dc\uc774\ubbc0\ub85c \ucd94\uac00\uc801\uc778 \ubd84\uc11d\uc774\ub098 \uac00\uacf5 \uacfc\uc815\uc774 \ubd88\ud544\uc694\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub370\uc774\ud130\ub294 \ub2e8\uc21c\ud55c \uc0ac\uc2e4\uc77c \ubfd0\uc774\ubbc0\ub85c \uac00\uce58 \uc788\ub294 \uc815\ubcf4\ub97c \uc5bb\uae30 \uc704\ud574\uc11c\ub294 \ubc18\ub4dc\uc2dc \ubd84\uc11d \uacfc\uc815\uc774 \ud544\uc694\ud558\ub2e4."
        },
        {
          "text": "\ub514\uc9c0\ud138 \ub370\uc774\ud130\ub294 \uc2dc\uac04\ub300\ubcc4 \uae30\uc628\uacfc \uac19\uc740 \uacf5\uacf5 \uc218\uce58\ub9cc\uc744 \ub73b\ud558\uba70, \uac78\uc74c \uc218\ub098 \uc2a4\ub9c8\ud2b8\ud3f0 \uc0ac\uc6a9 \uc2dc\uac04\uc740 \ud3ec\ud568\ub418\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uac1c\uc778\uc758 \ud558\ub8e8 \uac78\uc74c \uc218\ub098 \uc2a4\ub9c8\ud2b8\ud3f0 \uc0ac\uc6a9 \uc2dc\uac04\uacfc \uac19\uc740 \uc2e4\uc2dc\uac04 \uc0dd\ud65c \uae30\ub85d \uc5ed\uc2dc \ubaa8\ub450 \ub514\uc9c0\ud138 \ub370\uc774\ud130\uc5d0 \ud574\ub2f9\ud55c\ub2e4."
        },
        {
          "text": "\uc218\uc9d1\ud55c \ub370\uc774\ud130\uc758 \uc591\uacfc \uc0c1\uad00\uc5c6\uc774 \uc5b8\uc81c\ub098 \ub3d9\uc77c\ud55c \uae4a\uc774\uc758 \uc815\ubcf4\ub9cc\uc744 \ub3c4\ucd9c\ud560 \uc218 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub370\uc774\ud130\uc758 \uc591\uacfc \uce21\uc815 \ubc94\uc704\uac00 \ud655\ub300\ub420\uc218\ub85d \uc5bb\uc744 \uc218 \uc788\ub294 \uc815\ubcf4\uc758 \uae4a\uc774\uc640 \ud65c\uc6a9 \uac00\uce58\uac00 \ub2ec\ub77c\uc9c4\ub2e4."
        }
      ],
      "hint": "\ub2e8\uc21c\ud55c \uc0ac\uc2e4 \uc0c1\ud0dc\uc758 \uc218\uce58\ub098 \uae30\ub85d\uc774 \uac00\uce58\ub97c \uac16\uac8c \ub418\ub294 \uc815\uc81c \ubc0f \uac00\uacf5 \uacfc\uc815\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uad50\uc2e4 \ub0b4\ubd80\uc758 \uc774\uc0b0\ud654 \ud0c4\uc18c($CO_2$) \ub18d\ub3c4\ub97c \uce21\uc815\ud558\ub294 \ud0d0\uad6c \ud65c\ub3d9 \uc2dc, \uc81c\uc791\ud55c \uce21\uc815 \uc7a5\uce58\uac00 \uc815\uc0c1 \uc791\ub3d9\ud558\ub294\uc9c0 \ud655\uc778\ud558\ub294 \ubc29\ubc95\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc6b4\ub3d9\uc7a5\uacfc \uac19\uc774 \uac1c\ubc29\ub41c \ud658\uacbd\uc5d0\uc11c \uc774\uc0b0\ud654 \ud0c4\uc18c \ub18d\ub3c4\ub97c \uce21\uc815\ud55c \ub4a4 \uae30\uc0c1\uccad \uad00\uce21 \ud3c9\uade0\uac12\uacfc \ube44\uad50\ud55c\ub2e4.",
          "isCorrect": true,
          "rationale": "\uac1c\ubc29\ub41c \ud658\uacbd\uc5d0\uc11c \uce21\uc815\uac12\uc744 \uc5bb\uace0 \ud45c\uc900 \uae30\ud6c4 \uad00\uce21 \uc815\ubcf4\uc758 \uc6b0\ub9ac\ub098\ub77c \ud3c9\uade0 \uc774\uc0b0\ud654 \ud0c4\uc18c \ub18d\ub3c4\uc640 \ube44\uad50\ud558\uc5ec \uc13c\uc11c \uc791\ub3d9 \uc5ec\ubd80\ub97c \uac80\uc99d\ud55c\ub2e4."
        },
        {
          "text": "\ubc00\ud3d0\ub41c \ucc3d\uace0\uc5d0 \uc7a5\uce58\ub97c \ub193\uc544\ub450\uace0 \uc218\uce58\uac00 \uc218\ucc9c ppm \uc774\uc0c1 \uc9c0\uc18d\uc801\uc73c\ub85c \uc0c1\uc2b9\ud558\ub294\uc9c0 \ud655\uc778\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\uc900 \ube44\uad50 \ub300\uc0c1\uc774 \uc5c6\ub294 \ubc00\ud3d0 \uacf5\uac04\uc5d0\uc11c\ub294 \uc7a5\uce58 \uc791\ub3d9\uc758 \uc815\ud655\uc131\uc744 \ud45c\uc900\uac12\uacfc \ube44\uad50\ud558\uc5ec \uac80\uc99d\ud558\uae30 \uc5b4\ub835\ub2e4."
        },
        {
          "text": "\uc13c\uc11c\uc5d0 \uc9c1\uc811 \uc228\uc744 \uc5f0\uc18d\uc73c\ub85c \ubd88\uc5b4\ub123\uc5b4 \uc218\uce58\uac00 \ucd5c\ub300 \uce21\uc815 \ud55c\uacc4\uce58\uc5d0 \ub2e4\ub2e4\ub974\ub294\uc9c0\ub9cc \ud655\uc778\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub0a0\uc228\uc744 \uc9c1\uc811 \ubd88\uc5b4\ub123\ub294 \uac83\uc740 \uc13c\uc11c\uc758 \ubc18\uc751 \uc5ec\ubd80\ub9cc \ubcfc \uc218 \uc788\uc744 \ubfd0 \uc815\ud655\ud55c \ub18d\ub3c4 \uce21\uc815 \uc815\ud655\uc131\uc744 \uac80\uc99d\ud558\ub294 \uc62c\ubc14\ub978 \ubc29\ubc95\uc774 \uc544\ub2c8\ub2e4."
        },
        {
          "text": "\ubcc4\ub3c4\uc758 \ud45c\uc900 \ub370\uc774\ud130 \ube44\uad50 \uc5c6\uc774 \uce21\uc815 \uc7a5\uce58\ub97c \uace7\ubc14\ub85c \uad50\uc2e4\uc5d0 \uc124\uce58\ud558\uc5ec \ub370\uc774\ud130 \uc218\uc9d1\uc744 \uc2dc\uc791\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uae30\uae30\uc758 \uc601\uc810\uc774\ub098 \uc815\uc0c1 \uc791\ub3d9 \uc5ec\ubd80\ub97c \ud655\uc778\ud558\uae30 \uc704\ud574 \uc678\ubd80 \uac1c\ubc29 \ud658\uacbd\uc5d0\uc11c \ud45c\uc900 \ub370\uc774\ud130\uc640 \ube44\uad50\ud558\ub294 \uc0ac\uc804 \uac80\uc99d \ub2e8\uacc4\uac00 \ud544\uc218\uc801\uc774\ub2e4."
        }
      ],
      "hint": "\uc13c\uc11c\uc758 \uc815\ud655\ub3c4\ub97c \uac80\uc99d\ud558\uae30 \uc704\ud574 \uae30\uc900\uc774 \ub418\ub294 \uacf5\uacf5 \uae30\ud6c4 \uc815\ubcf4 \ub370\uc774\ud130\ub97c \uc5b4\ub514\uc11c \uce21\uc815\ud55c \uac12\uacfc \ube44\uad50\ud588\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ube45\ub370\uc774\ud130(Big Data)\uc758 \uac1c\ub150\uacfc \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ube45\ub370\uc774\ud130\ub294 \ub2e8\uc9c0 \uacfc\uac70\uc758 \uc0ac\uac74\uc744 \uae30\ub85d\u00b7\ubcf4\uad00\ud558\ub294 \uc6a9\ub3c4\ub85c\ub9cc \uc4f0\uc774\uba70 \ubbf8\ub798 \uc608\uce21\uc5d0\ub294 \uc0ac\uc6a9\ub418\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": true,
          "rationale": "\ube45\ub370\uc774\ud130\ub294 \uacfc\uac70 \uae30\ub85d \ubcf4\uad00\ubfd0\ub9cc \uc544\ub2c8\ub77c \ub300\uc6a9\ub7c9 \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uc5ec \ubbf8\ub798\uc758 \ubcc0\ud654\ub97c \uc608\uce21\ud558\uace0 \ud569\ub9ac\uc801\uc778 \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ub370 \ub113\uac8c \ud65c\uc6a9\ub41c\ub2e4."
        },
        {
          "text": "\uae30\uc874 \ub370\uc774\ud130\uc5d0 \ube44\ud574 \uc218\uc9d1\ub418\ub294 \ub370\uc774\ud130\uc758 \uc591\uc774 \ub9e4\uc6b0 \ubc29\ub300\ud558\uace0 \uad6c\uc870\uac00 \ubcf5\uc7a1\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube45\ub370\uc774\ud130\ub294 \uc7a5\uc18c\uc640 \uae30\uac04 \ub4f1\uc758 \ubc94\uc704\uac00 \ub113\uc5b4\uc9d0\uc5d0 \ub530\ub77c \ubc29\ub300\ud574\uc9c0\uace0 \ubcf5\uc7a1\ud574\uc9c4 \ub370\uc774\ud130\uc758 \uc9d1\ud569\uc744 \uc758\ubbf8\ud55c\ub2e4."
        },
        {
          "text": "\uc22b\uc790\ub85c \uc774\ub8e8\uc5b4\uc9c4 \uc218\uce58 \uc790\ub8cc\ubfd0\ub9cc \uc544\ub2c8\ub77c \uae00, \uc601\uc0c1, \uc74c\uc131 \ub4f1 \ub2e4\uc591\ud55c \ud615\ud0dc\uc758 \ube44\uc815\ud615 \ub370\uc774\ud130\ub3c4 \ud3ec\ud568\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\ube45\ub370\uc774\ud130\ub294 \uc218\uce58 \ub370\uc774\ud130\uc5d0 \uad6d\ud55c\ub418\uc9c0 \uc54a\uace0 \ubb38\ub9e5, \uc774\ubbf8\uc9c0, \uc74c\uc131 \ub4f1 \ub2e4\ucc44\ub85c\uc6b4 \ud615\ud0dc\uc758 \uc790\ub8cc\ub97c \ud3ec\ud568\ud55c\ub2e4."
        },
        {
          "text": "\uc13c\uc11c\uc758 \uac1c\ubc1c\uacfc \uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220(ICT)\uc758 \ubc1c\ub2ec\ub85c \uc2e4\uc2dc\uac04 \ub370\uc774\ud130 \uc218\uc9d1\uc774 \uac00\ub2a5\ud574\uc9c0\uba74\uc11c \ub4f1\uc7a5\ud558\uc600\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc815\ubc00 \uc13c\uc11c\uc640 \uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220\uc758 \ube44\uc57d\uc801 \ubc1c\uc804\uc774 \ube45\ub370\uc774\ud130\uc758 \uc218\uc9d1\uacfc \uc804\ud658\uc744 \uac00\ub2a5\ud558\uac8c \ud55c \uc8fc\uc694 \ubc30\uacbd\uc774\ub2e4."
        }
      ],
      "hint": "\ube45\ub370\uc774\ud130\uac00 \ubcc0\ud654\ub97c \uac10\uc9c0\ud558\uace0 \ud5a5\ud6c4 \uc77c\uc5b4\ub0a0 \uc0c1\ud669\uc5d0 \ub300\ucc98\ud558\ub294 \ub370 \uc5b4\ub5a4 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \uc81c\uc2dc\ub41c \ube45\ub370\uc774\ud130\uc758 \ubd84\uc57c\ubcc4 \ud65c\uc6a9 \uc0ac\ub840 \uc5f0\uacb0\uc774 \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uae30\uc220 \u2013 \uc5ec\ud589\uc9c0 \uc120\ud638\ub3c4 \ube45\ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uc5ec \uc790\ub3d9 \ubc88\uc5ed \uae30\uc220\uc758 \uc815\ud655\ub3c4 \ud5a5\uc0c1",
          "isCorrect": true,
          "rationale": "\uc5ec\ud589\uc9c0 \uc120\ud638\ub3c4 \ube45\ub370\uc774\ud130 \ubd84\uc11d\uc740 '\uc5ec\ud589' \ubd84\uc57c\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ub178\uc120\uc744 \uac1c\ubc1c\ud558\ub294 \ub370 \ud65c\uc6a9\ub418\uba70, \uc790\ub3d9 \ubc88\uc5ed \uae30\uc220 \ud5a5\uc0c1\uc740 '\uae30\uc220' \ubd84\uc57c\uc758 \ub3c5\ub9bd\ub41c \uc0ac\ub840\uc774\ub2e4."
        },
        {
          "text": "\uc815\ubd80 \uae30\uad00 \u2013 \ud1b5\ud654\ub7c9, \ubc1c\uc2e0 \uc9c0\uc5ed, \uad50\ud1b5\uce74\ub4dc \ub370\uc774\ud130 \ubd84\uc11d \ud6c4 \uc2ec\uc57c \ubc84\uc2a4 \ub178\uc120 \uacb0\uc815",
          "isCorrect": false,
          "rationale": "\uc815\ubd80 \ubc0f \uc9c0\uc790\uccb4\uac00 \uc2ec\uc57c \uc720\ub3d9 \uc778\uad6c\ub97c \ubd84\uc11d\ud558\uc5ec \ub300\uc911\uad50\ud1b5 \ub178\uc120\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ub300\ud45c\uc801\uc778 \uacf5\uacf5 \ud65c\uc6a9 \uc0ac\ub840\uc774\ub2e4."
        },
        {
          "text": "\uac74\uac15 \u2013 \uac74\uac15 \uad00\ub828 \ub0b4\uc6a9 \uac80\uc0c9\ub7c9 \ubcc0\ud654\ub97c \ubd84\uc11d\ud558\uc5ec \ub3c5\uac10 \uc720\ud589 \uc608\uce21",
          "isCorrect": false,
          "rationale": "\ud3ec\ud138 \uc0ac\uc774\ud2b8\uc758 \uc9c8\ubcd1 \uac80\uc0c9 \ud2b8\ub80c\ub4dc \ube45\ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uc5ec \uc9c8\ubcd1 \uc720\ud589\uc744 \ubbf8\ub9ac \uc608\uce21\ud558\ub294 \uac74\uac15 \ubd84\uc57c\uc758 \ud65c\uc6a9 \uc0ac\ub840\uc774\ub2e4."
        },
        {
          "text": "\ub18d\uc5c5 \u2013 \ud658\uacbd \uc815\ubcf4 \ube45\ub370\uc774\ud130\ub97c \uae30\ubc18\uc73c\ub85c \uc2dd\ubb3c \uc131\uc7a5\uc5d0 \uc801\uc808\ud55c \ud658\uacbd \uc81c\uc5b4",
          "isCorrect": false,
          "rationale": "\uc628\ub3c4, \uc2b5\ub3c4, \uc77c\uc870\ub7c9 \ub4f1\uc758 \ub370\uc774\ud130\ub85c \uc2a4\ub9c8\ud2b8\ud31c \ud658\uacbd\uc744 \uc81c\uc5b4\ud558\ub294 Agricultural Big Data \ud65c\uc6a9 \uc0ac\ub840\uc774\ub2e4."
        }
      ],
      "hint": "\uc790\ub3d9 \ubc88\uc5ed \uae30\uc220 \uac1c\ubc1c\uc5d0 \uc0ac\uc6a9\ub418\ub294 \ub370\uc774\ud130\uc640 \uc5ec\ud589\uc9c0 \uc120\ud638\ub3c4 \ub370\uc774\ud130\uac00 \uc11c\ub85c \uc5b4\uc6b8\ub9ac\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc911 \uacfc\ud559 \uc5f0\uad6c \ubc0f \ud0d0\uad6c \ubd84\uc57c\uc5d0\uc11c \ube45\ub370\uc774\ud130\uac00 \ud65c\ubc1c\ud558\uac8c \ud65c\uc6a9\ub418\ub294 \uc0ac\ub840\ub85c \uc633\uc740 \uac83\ub9cc\uc744 \ubaa8\ub450 \uace0\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\u3131, \u3134, \u3137",
          "isCorrect": true,
          "rationale": "\uac70\ub300 \uc785\uc790 \uac00\uc18d\uae30/\uc704\uc131 \uad00\uce21, \uc2e0\uc57d \uac1c\ubc1c, \uc720\uc804\uccb4 \ubd84\uc11d \ubaa8\ub450 \ud604\ub300 \uacfc\ud559\uc5d0\uc11c \ube45\ub370\uc774\ud130\ub97c \ud65c\uc6a9\ud558\ub294 \ud575\uc2ec \uc0ac\ub840\ub4e4\uc774\ub2e4."
        },
        {
          "text": "\u3131, \u3134",
          "isCorrect": false,
          "rationale": "\uc774\ubbf8 \uac1c\ubc1c\ub41c \ud654\ud559 \ubb3c\uc9c8 \ubc0f \uc784\uc0c1 \ub370\uc774\ud130\ub97c \ud65c\uc6a9\ud558\ub294 \uc2e0\uc57d \uac1c\ubc1c \ubd84\uc57c \uc5ed\uc2dc \uacfc\ud559\uc758 \uc8fc\uc694 \ube45\ub370\uc774\ud130 \ud65c\uc6a9 \uc0ac\ub840\uc774\ub2e4."
        },
        {
          "text": "\u3134, \u3137",
          "isCorrect": false,
          "rationale": "\uac70\ub300 \uc785\uc790 \uac00\uc18d\uae30 \ub4f1 \uc2e4\ud5d8 \uc7a5\ube44\uc5d0\uc11c \uc218\uc9d1\ub41c \ubc29\ub300\ud55c \uc790\ub8cc\ub97c \uc774\ub860 \ubaa8\ub378\uacfc \ube44\uad50\ud558\ub294 \uc2e4\ud5d8 \uacfc\ud559 \ubd84\uc57c\ub3c4 \ud3ec\ud568\ub41c\ub2e4."
        },
        {
          "text": "\u3131, \u3137",
          "isCorrect": false,
          "rationale": "DNA \uc5fc\uae30\uc11c\uc5f4 \ube45\ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uc5ec \ub09c\uce58\ubcd1 \uce58\ub8cc \ubc0f \ub9de\ucda4\ud615 \uc758\ud559\uc5d0 \uc774\uc6a9\ud558\ub294 \uc720\uc804\uccb4 \ubd84\uc11d \ubd84\uc57c\ub3c4 \ud3ec\ud568\ub41c\ub2e4."
        }
      ],
      "hint": "\uc785\uc790 \ucda9\ub3cc \uc2e4\ud5d8, \uc57d\ubb3c \uac1c\ubc1c, DNA \uc5fc\uae30\uc11c\uc5f4 \ubd84\uc11d\uc774 \ubaa8\ub450 \ub300\uc6a9\ub7c9 \ub514\uc9c0\ud138 \ub370\uc774\ud130 \ucc98\ub9ac\ub97c \ud544\uc694\ub85c \ud558\ub294\uc9c0 \uac80\ud1a0\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub370\uc774\ud130\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\uc6a9\ud558\uae30 \uc704\ud574 \uc720\uc0ac\ud55c \uc131\uc9c8\uc744 \uac00\uc9c4 \ub370\uc774\ud130\ub4e4\uc744 \ubaa8\uc544 \uac80\uc0c9\uc774\ub098 \uc0ac\uc6a9\uc774 \ud3b8\ub9ac\ud558\ub3c4\ub85d \uc815\ub9ac\ud55c \uc9d1\ud569\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?",
      "answerOptions": [
        {
          "text": "\ub370\uc774\ud130\uc14b (Dataset)",
