        {
          "text": "\uace0\uc18d \uc8fc\ud589\uc744 \ud560 \ub54c \uc5d4\uc9c4\uc744 \uc644\uc804\ud788 \ub044\uace0 \uc804\uae30 \ubaa8\ud130\ub9cc \uad6c\ub3d9\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
