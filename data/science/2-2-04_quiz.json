      "hint": "\ubc1c\uc804\uc18c\uc5d0\uc11c \uc804\uae30\ub97c \ub9cc\ub4e4 \ub54c \ubd80\uc0b0\ubb3c\ub85c \ub098\uc624\ub294 \ubc84\ub824\uc9c0\ub294 \uc5f4\uc744 \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud558\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc790\uc5f0\uacc4\uc5d0\uc11c \uc5d0\ub108\uc9c0 \ucd1d\ub7c9\uc774 \ubcf4\uc874\ub428\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \uc77c\uc0c1\uc0dd\ud65c\uc5d0\uc11c \uc5d0\ub108\uc9c0\ub97c \uc544\uaef4 \uc368\uc57c \ud558\ub294 \uc774\uc720\ub85c \uac00\uc7a5 \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5d0\ub108\uc9c0\uac00 \uc804\ud658\ub418\ub294 \uacfc\uc815\uc5d0\uc11c \ub2e4\uc2dc \uc720\uc6a9\ud558\uac8c \uc0ac\uc6a9\ud558\uae30 \uc5b4\ub824\uc6b4 \uc5f4\uc5d0\ub108\uc9c0 \ub4f1\uc73c\ub85c \ubc14\ub00c\uc5b4 \ubc84\ub824\uc9c0\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc5d0\ub108\uc9c0 \ucd1d\ub7c9\uc740 \uc77c\uc815\ud558\uc9c0\ub9cc, \uc0ac\uc6a9 \uacfc\uc815\uc5d0\uc11c \uc5d0\ub108\uc9c0\uac00 \ubb34\uc9c8\uc11c\ud55c \uc5f4\uc5d0\ub108\uc9c0\ub85c \ud37c\uc838\ub098\uac00 \uc7ac\uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc720\uc6a9\ud55c \uc5d0\ub108\uc9c0\uac00 \uc904\uc5b4\ub4ed\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc5d0\ub108\uc9c0\ub97c \uc0ac\uc6a9\ud560 \ub54c\ub9c8\ub2e4 \uc6b0\uc8fc \uc804\uccb4\uc758 \uc5d0\ub108\uc9c0 \ucd1d\ub7c9\uc774 \uac10\uc18c\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc5d0\ub108\uc9c0 \ubcf4\uc874 \ubc95\uce59\uc5d0 \ub530\ub77c \uc5d0\ub108\uc9c0 \uc804\uccb4\uc758 \ucd1d\ub7c9 \uc790\uccb4\ub294 \uc808\ub300 \uac10\uc18c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
