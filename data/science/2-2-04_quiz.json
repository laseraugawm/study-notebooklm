    },
    {
      "question": "\ub2e4\uc74c \uc790\uc5f0 \ud604\uc0c1 \ubc0f \uc77c\uc0c1 \ud604\uc0c1\uc5d0\uc11c\uc758 \uc5d0\ub108\uc9c0 \uc804\ud658 \uacfc\uc815 \uc5f0\uacb0 \uc911 \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
