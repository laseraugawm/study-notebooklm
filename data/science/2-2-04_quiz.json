      ],
      "hint": "\uc2dd\ubb3c\uc774 \ud587\ube5b\uc744 \ubc1b\uc544 \uc720\uae30\ubb3c(\uc601\uc591\ubd84)\uc744 \ud569\uc131\ud560 \ub54c \uc2dc\uc791\ub418\ub294 \uc5d0\ub108\uc9c0\uc640 \uc800\uc7a5\ub418\ub294 \uc5d0\ub108\uc9c0 \ud615\ud0dc\ub97c \ud655\uc778\ud558\uc138\uc694."
    },
    {
      "question": "\uc77c\uc0c1\uc0dd\ud65c\uc5d0\uc11c \uc5d0\ub108\uc9c0\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uac70\ub098 \ub192\uc774\uae30 \uc704\ud574 \uc0ac\uc6a9\ub418\ub294 \ubc29\uc548\uc73c\ub85c \ubcf8\ubb38\uc5d0 \uc5b8\uae09\ub41c \uae30\uc220 \ubc0f \uc81c\ub3c4\ub294?",
      "answerOptions": [
        {
          "text": "\uc804\uae30 \uc81c\ud488\uc758 \uc5d0\ub108\uc9c0 \uc18c\ube44 \ud6a8\uc728 \ub4f1\uae09 \ud45c\uc2dc\uc81c\uc640 \uc2a4\ub9c8\ud2b8 \ud50c\ub7ec\uadf8 \ud65c\uc6a9",
          "rationale": "\uc5d0\ub108\uc9c0 \uc18c\ube44 \ud6a8\uc728 \ub4f1\uae09 \ud45c\uc2dc\ub294 \ud6a8\uc728 \ub192\uc740 \uc81c\ud488 \uad6c\ub9e4\ub97c \uc720\ub3c4\ud558\uba70, \uc2a4\ub9c8\ud2b8 \ud50c\ub7ec\uadf8\ub294 \uc6d0\uaca9 \uc81c\uc5b4\ub85c \uc804\ub825\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub3c4\ub85d \ub3d5\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
