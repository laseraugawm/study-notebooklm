{
  "title": "\uc5d0\ub108\uc9c0 \uc804\ud658 \ud034\uc988",
  "questions": [
    {
      "question": "\ud734\ub300 \uc804\ud654\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \uc5d0\ub108\uc9c0 \uc804\ud658 \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubc30\ud130\ub9ac\ub97c \ucda9\uc804\ud560 \ub54c\ub294 \uc804\uae30 \uc5d0\ub108\uc9c0\uac00 \ud654\ud559 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\uc5b4 \uc800\uc7a5\ub41c\ub2e4.",
          "rationale": "\ucda9\uc804 \uacfc\uc815\uc740 \uc678\ubd80\uc5d0\uc11c \uacf5\uae09\ub41c \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \ubc30\ud130\ub9ac \ub0b4\ubd80\uc758 \ud654\ud559 \uc5d0\ub108\uc9c0 \ud615\ud0dc\ub85c \ucd95\uc801\ud558\ub294 \uacfc\uc815\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc2a4\ud53c\ucee4\uc5d0\uc11c \uc18c\ub9ac\uac00 \ub098\uc62c \ub54c\ub294 \uc5f4\uc5d0\ub108\uc9c0\uac00 \uc18c\ub9ac \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub41c\ub2e4.",
          "rationale": "\uc2a4\ud53c\ucee4 \uc791\ub3d9 \uc2dc\uc5d0\ub294 \uc5f4\uc774 \uc544\ub2cc \ubc30\ud130\ub9ac\uc5d0\uc11c \uacf5\uae09\ub41c \uc804\uae30 \uc5d0\ub108\uc9c0\uac00 \uc18c\ub9ac \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud654\uba74\uc5d0\uc11c \ube5b\uc774 \ub098\uc62c \ub54c\ub294 \ud654\ud559 \uc5d0\ub108\uc9c0\uac00 \uc911\uac04 \uacfc\uc815 \uc5c6\uc774 \uc9c1\uc811 \ube5b\uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub41c\ub2e4.",
          "rationale": "\ubc30\ud130\ub9ac\uc5d0 \uc800\uc7a5\ub41c \ud654\ud559 \uc5d0\ub108\uc9c0\ub294 \uba3c\uc800 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub41c \ub4a4 \ub514\uc2a4\ud50c\ub808\uc774 \ud654\uba74\uc5d0\uc11c \ube5b\uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud734\ub300 \uc804\ud654\uac00 \uc9c4\ub3d9\ud560 \ub54c\ub294 \uc18c\ub9ac \uc5d0\ub108\uc9c0\uac00 \ubaa8\ud130\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub41c\ub2e4.",
          "rationale": "\uc9c4\ub3d9\ud560 \ub54c\ub294 \uc18c\ub9ac \uc5d0\ub108\uc9c0\uac00 \uc544\ub2c8\ub77c \uacf5\uae09\ub41c \uc804\uae30 \uc5d0\ub108\uc9c0\uac00 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\ub294 \uac83\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubc30\ud130\ub9ac\ub97c \uc804\uc6d0\uc5d0 \uc5f0\uacb0\ud558\uc5ec \uc5d0\ub108\uc9c0\ub97c \ub123\uc744 \ub54c \uc5b4\ub5a4 \ud615\ud0dc\uc758 \uc5d0\ub108\uc9c0\ub85c \ubcf4\uad00\ub418\ub294\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc5d0\ub108\uc9c0 \ubcf4\uc874 \ubc95\uce59\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5d0\ub108\uc9c0\uac00 \uc5ec\ub7ec \ud615\ud0dc\ub85c \uc804\ud658\ub420 \ub54c \uc804\uccb4 \uc5d0\ub108\uc9c0\uc758 \ucd1d\ub7c9\uc740 \ubcc0\ud558\uc9c0 \uc54a\uace0 \uc77c\uc815\ud558\uac8c \uc720\uc9c0\ub41c\ub2e4.",
          "rationale": "\uc5d0\ub108\uc9c0\ub294 \uc0c8\ub85c \uc0dd\uc131\ub418\uac70\ub098 \uc18c\uba78\ud558\uc9c0 \uc54a\uace0 \ud615\ud0dc\ub9cc \ubc14\ub014 \ubfd0 \uc804\uccb4 \ucd1d\ub7c9\uc740 \ud56d\uc0c1 \ubcf4\uc874\ub429\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc5d0\ub108\uc9c0\uac00 \uc804\ud658\ub418\uba74 \uc778\uac04\uc774 \uc720\uc6a9\ud558\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc5d0\ub108\uc9c0\uc758 \uc591\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uc99d\uac00\ud55c\ub2e4.",
          "rationale": "\uc5d0\ub108\uc9c0\uac00 \uc804\ud658\ub420\uc218\ub85d \ub2e4\ub8e8\uae30 \ud798\ub4e0 \uc5f4\uc5d0\ub108\uc9c0 \ub4f1\uc73c\ub85c \ubc14\ub00c\ubbc0\ub85c \uc720\uc6a9\ud55c \uc5d0\ub108\uc9c0\ub294 \uc624\ud788\ub824 \uc904\uc5b4\ub4ed\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0ac\uc6a9\uc744 \ub9c8\uce5c \uc5d0\ub108\uc9c0\ub294 \uc644\uc804\ud788 \uc18c\uba78\ud558\uc5ec \uc6b0\uc8fc \uacf5\uac04\uc5d0\uc11c \uc0ac\ub77c\uc9c4\ub2e4.",
          "rationale": "\uc5d0\ub108\uc9c0\ub294 \uc18c\uba78\ud558\uc5ec \uc5c6\uc5b4\uc9c0\uc9c0 \uc54a\uc73c\uba70 \ub2e4\ub978 \uc5d0\ub108\uc9c0 \ud615\ud0dc\ub85c \uacf5\uae30 \uc911 \ub4f1\uc5d0 \uc874\uc7ac\ud558\uac8c \ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ub9c8\ucc30\uc774\ub098 \uacf5\uae30 \uc800\ud56d\uc774 \uc788\ub294 \uc2e4\uc81c \uc790\uc5f0\uc5d0\uc11c\ub294 \uc5d0\ub108\uc9c0 \ucd1d\ub7c9\uc774 \uc810\ucc28 \uac10\uc18c\ud55c\ub2e4.",
          "rationale": "\ub9c8\ucc30\uc774\ub098 \uc800\ud56d\uc5d0 \uc758\ud574 \uc5f4\uc774\ub098 \uc18c\ub9ac \uc5d0\ub108\uc9c0\ub85c \ud769\uc5b4\uc9c8 \ubfd0, \uc774\ub4e4\uc744 \ubaa8\ub450 \ud569\ud55c \uc804\uccb4 \uc5d0\ub108\uc9c0 \ucd1d\ub7c9\uc740 \uc77c\uc815\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc5d0\ub108\uc9c0\uc758 \ud615\ud0dc\uac00 \ubc14\ub00c\ub294 \uacfc\uc815\uc5d0\uc11c \uc804\uccb4 \uc5d0\ub108\uc9c0 \uc591\uc5d0 \uc5b4\ub5a4 \ubcc0\ud654\uac00 \uc0dd\uae30\ub294\uc9c0 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uc5b4\ub5a4 \uc5f4\uae30\uad00\uc774 \uace0\uc5f4\uc6d0\uc5d0\uc11c $1000\\text{ kJ}$\uc758 \uc5f4\uc744 \ud761\uc218\ud558\uc5ec \uc678\ubd80\uc5d0 $300\\text{ kJ}$\uc758 \uc77c\uc744 \ud558\uc600\ub2e4. \uc774 \uc5f4\uae30\uad00\uc758 \uc5f4\ud6a8\uc728\uacfc \uc800\uc5f4\uc6d0\uc73c\ub85c \ubc29\ucd9c\ud55c \uc5f4\ub7c9($Q_2$)\uc73c\ub85c \ubc14\ub974\uac8c \uc9dd\uc9c0\uc5b4\uc9c4 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5f4\ud6a8\uc728: $0.3$ ($30\\%$), \uc800\uc5f4\uc6d0 \ubc29\ucd9c \uc5f4\ub7c9: $700\\text{ kJ}$",
          "rationale": "\uc5d0\ub108\uc9c0 \ubcf4\uc874\uc5d0 \uc758\ud574 \ubc29\ucd9c \uc5f4\ub7c9\uc740 \ud761\uc218 \uc5f4\ub7c9\uc5d0\uc11c \uc77c\uc744 \ube80 $1000\\text{ kJ} - 300\\text{ kJ} = 700\\text{ kJ}$\uc774\uba70, \uc5f4\ud6a8\uc728\uc740 $\\frac{300\\text{ kJ}}{1000\\text{ kJ}} = 0.3$\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc5f4\ud6a8\uc728: $0.7$ ($70\\%$), \uc800\uc5f4\uc6d0 \ubc29\ucd9c \uc5f4\ub7c9: $300\\text{ kJ}$",
          "rationale": "\uc678\ubd80\uc5d0 \ud55c \uc77c\uc774 $300\\text{ kJ}$\uc774\ubbc0\ub85c \ubc29\ucd9c\ud55c \uc5f4\ub7c9\uc774 $700\\text{ kJ}$\uac00 \ub418\uc5b4\uc57c \ud558\uba70, \uc5f4\ud6a8\uc728\uc740 \ud761\uc218\ud55c \uc5f4\uc5d0 \ub300\ube44\ud55c \uc77c\uc758 \ube44\uc728\ub85c \uacc4\uc0b0\ud574\uc57c \ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc5f4\ud6a8\uc728: $0.3$ ($30\\%$), \uc800\uc5f4\uc6d0 \ubc29\ucd9c \uc5f4\ub7c9: $300\\text{ kJ}$",
          "rationale": "\uc5f4\ud6a8\uc728\uc740 \ub9de\uac8c \uad6c\ud574\uc84c\uc73c\ub098, \uace0\uc5f4\uc6d0\uc5d0\uc11c \uacf5\uae09\ub41c \uc5f4\ub7c9\uacfc \uc77c, \ubc29\ucd9c \uc5f4\ub7c9 \uc0ac\uc774\uc758 \uad00\uacc4($Q_1 = W + Q_2$)\ub97c \uc801\uc6a9\ud558\uba74 \ubc29\ucd9c \uc5f4\ub7c9\uc740 $700\\text{ kJ}$\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc5f4\ud6a8\uc728: $0.7$ ($70\\%$), \uc800\uc5f4\uc6d0 \ubc29\ucd9c \uc5f4\ub7c9: $700\\text{ kJ}$",
          "rationale": "\ubc29\ucd9c \uc5f4\ub7c9 \uacc4\uc0b0\uc740 \uc62c\ubc14\ub974\ub098, \uc5f4\ud6a8\uc728\uc740 \ud55c \uc77c\uc744 \uacf5\uae09\ub41c \uc5f4\ub7c9\uc73c\ub85c \ub098\ub208 \uac12\uc778 $0.3$\uc774 \ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uacf5\uae09\ub41c \uc804\uccb4 \uc5f4\ub7c9\uc740 '\uc678\ubd80\uc5d0 \ud55c \uc77c'\uacfc '\uc800\uc5f4\uc6d0\uc73c\ub85c \ubc84\ub824\uc9c4 \uc5f4\ub7c9'\uc758 \ud569\uacfc \uac19\uc2b5\ub2c8\ub2e4."
    },
    {
      "question": "\uc5f4\uae30\uad00\uc758 \uc5f4\ud6a8\uc728\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc9c0 \uc54a\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc5f4\uae30\uad00\uc758 \uad6c\uc870\ub97c \uc815\ubc00\ud558\uac8c \uac1c\uc120\ud558\uba74 \ud761\uc218\ud55c \uc5f4\uc744 $100\\%$ \uc77c\ub85c \ubc14\uafb8\ub294 \uc5f4\ud6a8\uc728 $1$\uc758 \uc5f4\uae30\uad00\uc744 \ub9cc\ub4e4 \uc218 \uc788\ub2e4.",
          "rationale": "\uc5f4\uae30\uad00\uc740 \uc791\ub3d9 \uacfc\uc815\uc5d0\uc11c \ubc18\ub4dc\uc2dc \uc77c\ubd80 \uc5f4\uc774 \uc800\uc5f4\uc6d0\uc73c\ub85c \ubc29\ucd9c\ub418\ubbc0\ub85c \uc5f4\ud6a8\uc728\uc774 \uc808\ub300\ub85c $1$($100\\%$)\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc5f4\uae30\uad00\uc5d0 \uacf5\uae09\ub41c \uc5f4\uc5d0\ub108\uc9c0 \uc911 \uc678\ubd80\uc5d0 \uc720\uc6a9\ud558\uac8c \ud55c \uc77c\uc758 \ube44\uc728\uc744 \uc5f4\ud6a8\uc728\uc774\ub77c\uace0 \ud55c\ub2e4.",
          "rationale": "\uc5f4\ud6a8\uc728\uc740 \uacf5\uae09\ud55c \uc5f4\ub7c9 \ub300\ube44 \uc720\uc6a9\ud558\uac8c \uc0ac\uc6a9\ub41c \uc77c\uc758 \ube44\uc728\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc5f4\uae30\uad00\uc5d0\uc11c\ub3c4 \uc5d0\ub108\uc9c0\uac00 \ubcf4\uc874\ub418\ubbc0\ub85c \uacf5\uae09\ub41c \uc5f4\ub7c9\uc740 \ud55c \uc77c\uacfc \ubc29\ucd9c\ub41c \uc5f4\ub7c9\uc758 \ud569\uacfc \uac19\ub2e4.",
          "rationale": "\uc5f4\uae30\uad00 \ub0b4\ubd80\uc5d0\uc11c\ub3c4 \uc5d0\ub108\uc9c0 \ubcf4\uc874 \ubc95\uce59($Q_1 = W + Q_2$)\uc774 \uadf8\ub300\ub85c \uc801\uc6a9\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uac00\uc194\ub9b0 \uc790\ub3d9\ucc28\uc758 \uc5d4\uc9c4\uc740 \uacf5\uae09\ub41c \uc5d0\ub108\uc9c0\uc758 \ub300\ubd80\ubd84\uc774 \uc5f4 \ub4f1\uc73c\ub85c \ubc84\ub824\uc838 \uc5f4\ud6a8\uc728\uc774 \ub0ae\uc740 \ud3b8\uc774\ub2e4.",
          "rationale": "\uac00\uc194\ub9b0 \uc790\ub3d9\ucc28 \uc5d4\uc9c4\uc740 \ud3d0\uc5f4\uacfc \ub9c8\ucc30 \ub4f1\uc73c\ub85c \uc778\ud574 \uc0c1\ub2f9\uc218\uc758 \uc5d0\ub108\uc9c0\ub97c \uc783\uace0 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c\ub294 \uc57d $20\\%$\ub9cc \uc804\ud658\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc5f4\uae30\uad00\uc774 \uc791\ub3d9\ud560 \ub54c \uc800\uc5f4\uc6d0\uc73c\ub85c \ube60\uc838\ub098\uac00\ub294 \uc5f4\ub7c9\uc744 \uc644\uc804\ud788 \uc5c6\uc560\ub294 \uac83\uc774 \uac00\ub2a5\ud55c\uc9c0 \uace0\ub824\ud574 \ubcf4\uc138\uc694."
    },
    {
      "question": "\uac00\uc194\ub9b0 \uc790\ub3d9\ucc28\uc758 \uc5d0\ub108\uc9c0 \uc0ac\uc6a9 \ud604\ud669\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud718\ubc1c\uc720\uc758 \ud654\ud559 \uc5d0\ub108\uc9c0 \uc911 \uc2e4\uc81c \uc790\ub3d9\ucc28 \ubc14\ud034\ub97c \uc6c0\uc9c1\uc774\ub294 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\ub294 \uac83\uc740 \uc57d $20\\%$\uc774\ub2e4.",
          "rationale": "\uac00\uc194\ub9b0 \uc790\ub3d9\ucc28\ub294 \uacf5\uae09\ub41c \uc5f0\ub8cc \uc5d0\ub108\uc9c0\uc758 \uc57d $20\\%$\ub9cc\uc744 \ubc14\ud034\ub97c \uc6c0\uc9c1\uc774\ub294 \uc5ed\ud559\uc801 \uc77c\uc5d0 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc5f0\ub8cc\uc5d0 \ud3ec\ud568\ub41c \uc5d0\ub108\uc9c0\uc758 \ub300\ubd80\ubd84\uc740 \uc18c\ub9ac \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\uc5b4 \uc8fc\ub85c \uc18c\uc2e4\ub41c\ub2e4.",
          "rationale": "\ubc84\ub824\uc9c0\ub294 \uc5d0\ub108\uc9c0\ub294 \uc18c\ub9ac \uc5d0\ub108\uc9c0\ubcf4\ub2e4 \uc5d4\uc9c4 \ud3d0\uc5f4\uc774\ub098 \ub0c9\uac01 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud55c \uc5f4\uc5d0\ub108\uc9c0\uac00 \ub300\ubd80\ubd84\uc744 \ucc28\uc9c0\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uae30\uacc4\uc801 \ub9c8\ucc30\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \uc5f4\uc740 \uc720\uc6a9\ud558\uac8c \uc0ac\uc6a9\ub41c \uc5d0\ub108\uc9c0 \ubc94\uc8fc\uc5d0 \ud3ec\ud568\ub41c\ub2e4.",
          "rationale": "\ub9c8\ucc30\ub85c \ubc1c\uc0dd\ud558\ub294 \uc5f4\uc740 \uc790\ub3d9\ucc28 \uc791\ub3d9 \ubaa9\uc801\uc5d0 \ub9de\uc9c0 \uc54a\uac8c \ubc84\ub824\uc9c0\ub294 \ubd88\ud544\uc694\ud55c \uc5d0\ub108\uc9d1\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud718\ubc1c\uc720\uc5d0 \ud3ec\ud568\ub41c \uc5d0\ub108\uc9c0\ub294 \uc57d $80\\%$\uac00 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\uc5b4 \uc5d0\ub108\uc9c0 \ud6a8\uc728\uc774 \ub192\ub2e4.",
          "rationale": "\uc57d $80\\%$\ub294 \uc5f4 \ubc0f \ub9c8\ucc30 \ub4f1\uc73c\ub85c \ubc84\ub824\uc9c0\uace0, \ubc14\ud034\ub97c \uc6c0\uc9c1\uc774\ub294 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub294 \uc57d $20\\%$\uc5d0 \ubd88\uacfc\ud569\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uac00\uc194\ub9b0 \uc790\ub3d9\ucc28\uc5d0 \uc8fc\uc785\ub41c \uc5f0\ub8cc \uc5d0\ub108\uc9c0 \uc911 \uc2e4\uc81c\ub85c \uc774\ub3d9\uc5d0 \uc0ac\uc6a9\ub418\ub294 \ube44\uc728\uacfc \ubc84\ub824\uc9c0\ub294 \ube44\uc728\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "question": "\ud558\uc774\ube0c\ub9ac\ub4dc \uc790\ub3d9\ucc28\uac00 \uc77c\ubc18 \uac00\uc194\ub9b0 \uc790\ub3d9\ucc28\ubcf4\ub2e4 \uc5d0\ub108\uc9c0 \ud6a8\uc728\uc774 \ub354 \ub192\uc740 \uc774\uc720\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uac10\uc18d\uc774\ub098 \ub0b4\ub9ac\ub9c9 \uc8fc\ud589 \uc2dc \uc804\uae30 \ubaa8\ud130\uac00 \ubc1c\uc804\uae30\ub85c \uc791\uc6a9\ud558\uc5ec \ubc84\ub824\uc9c0\ub358 \uc5d0\ub108\uc9c0\ub97c \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc800\uc7a5\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ud558\uc774\ube0c\ub9ac\ub4dc \uc790\ub3d9\ucc28\ub294 \uac10\uc18d \uc2dc \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub97c \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud574 \ubc30\ud130\ub9ac\uc5d0 \ucda9\uc804\ud558\uc5ec \uc7ac\uc0ac\uc6a9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud654\uc11d \uc5f0\ub8cc\ub97c \uc804\ud600 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uace0 \uc624\uc9c1 \ud0dc\uc591\uad11 \uc5d0\ub108\uc9c0\ub9cc\uc73c\ub85c \uc8fc\ud589\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ud558\uc774\ube0c\ub9ac\ub4dc \uc790\ub3d9\ucc28\ub294 \ud654\uc11d \uc5f0\ub8cc\ub97c \uc0ac\uc6a9\ud558\ub294 \uc5d4\uc9c4\uacfc \uc804\uae30 \ubaa8\ud130\ub97c \ud63c\uc6a9\ud558\uc5ec \uac00\ub3d9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
