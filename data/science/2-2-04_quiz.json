    {
      "question": "\uc5f4\ubcd1\ud569 \ubc1c\uc804 \ubc29\uc2dd\uc774 \uc77c\ubc18 \ubc1c\uc804 \ubc29\uc2dd\uc5d0 \ube44\ud574 \uc5d0\ub108\uc9c0 \uc774\uc6a9 \ud6a8\uc728\uc774 \ud06c\uac8c \ub192\uc740 \uae4c\ub2ed\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc804\ub825 \uc0dd\uc0b0 \uacfc\uc815\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ud3d0\uc5f4\uc744 \ubc84\ub9ac\uc9c0 \uc54a\uace0 \ub09c\ubc29 \ub4f1\uc5d0 \ud568\uaed8 \uc774\uc6a9\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc5f4\ubcd1\ud569 \ubc1c\uc804\uc740 \uc804\ub825 \uc0dd\uc0b0\uacfc \ub354\ubd88\uc5b4 \uc190\uc2e4\ub418\ub358 \uc5f4\uc744 \ub09c\ubc29\uc6a9\uc73c\ub85c \uc7ac\ud65c\uc6a9\ud568\uc73c\ub85c\uc368 \uc804\uccb4 \uc5d0\ub108\uc9c0 \uc774\uc6a9 \ud6a8\uc728\uc744 $80\\%$ \uc774\uc0c1\uc73c\ub85c \ub192\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc5f0\ub8cc\uc758 \ud654\ud559 \uc5d0\ub108\uc9c0\ub97c \uc5f4\uc5d0\ub108\uc9c0\ub97c \uac70\uce58\uc9c0 \uc54a\uace0 \uc9c1\uc811 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc5f4\ubcd1\ud569 \ubc1c\uc804 \uc5ed\uc2dc \ud654\uc11d \uc5f0\ub8cc \ub4f1\uc758 \uc5f4\uc5d0\ub108\uc9c0\ub97c \uac70\uccd0 \uc804\uae30\ub97c \uc0dd\uc0b0\ud558\uc9c0\ub9cc \ubc84\ub824\uc9c0\ub294 \uc5f4\uc744 \ub09c\ubc29\uc73c\ub85c \ud68c\uc218\ud558\ub294 \ubc29\uc2dd\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc1a1\uc804\uc120\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc800\ud56d\uc5d0 \uc758\ud55c \uc804\ub825 \uc190\uc2e4\uc744 \uc644\uc804\ud788 \ucc28\ub2e8\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc5f4\ubcd1\ud569 \ubc1c\uc804\uc740 \ubc1c\uc804\uc18c \ud3d0\uc5f4\uc758 \ud68c\uc218 \uc774\uc6a9\uc5d0 \ucd08\uc810\uc774 \ub9de\ucdb0\uc838 \uc788\uc73c\uba70 \uc1a1\uc804 \uc800\ud56d \uc190\uc2e4\uc744 \uc644\uc804\ud788 \uc5c6\uc560\ub294 \uae30\uc220\uc740 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud130\ube48\uc744 \ub3cc\ub9ac\uc9c0 \uc54a\uace0 \uc18c\ub9ac \uc5d0\ub108\uc9c0\ub9cc\uc73c\ub85c \uc804\uae30\ub97c \uc0dd\uc0b0\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\ubc1c\uc804\uae30\ub294 \uc5f4\uc744 \uc774\uc6a9\ud574 \ud130\ube48\uc744 \ub3cc\ub824 \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc0dd\uc0b0\ud569\ub2c8\ub2e4.",
          "isCorrect": false
