          "rationale": "\uc5d0\ub108\uc9c0\ub294 \ud30c\uad34\ub418\uc9c0 \uc54a\uc73c\uba70 \ub2e4\ub978 \ud615\ud0dc\ub85c \uc804\ud658\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc804\uae30 \uc5d0\ub108\uc9c0\ub294 \uc0ac\uc6a9 \uc2dc \uc9c8\ub7c9\uc744 \uac00\uc9c4 \ubb3c\uc9c8\ub85c \uc644\uc804\ud788 \ubcc0\ud658\ub418\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc77c\uc0c1\uc801\uc778 \uc5d0\ub108\uc9c0 \uc804\ud658 \uacfc\uc815\uc740 \uc0c1\ud638 \ud615\ud0dc \ubcc0\ud658\uc774\uba70 \ubb3c\uc9c8\ub85c \uc18c\uba78/\ubcc0\ud658\ub418\uc5b4 \uc5c6\uc5b4\uc9c0\ub294 \uac1c\ub150\uc774 \uc544\ub2d9\ub2c8\ub2e4.",
