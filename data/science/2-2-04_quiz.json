          "text": "\uc2dd\ubb3c\uc758 \uad11\ud569\uc131: \ud0dc\uc591\uc758 \ube5b\uc5d0\ub108\uc9c0 $\\rightarrow$ \uc2dd\ubb3c\uc758 \ud654\ud559 \uc5d0\ub108\uc9c0",
          "rationale": "\uad11\ud569\uc131\uc740 \ud0dc\uc591\uc758 \ube5b\uc5d0\ub108\uc9c0\ub97c \ud3ec\ub3c4\ub2f9\uacfc \uac19\uc740 \ud654\ud559 \uacb0\ud569 \ud615\ud0dc\uc758 \ud654\ud559 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud558\ub294 \ub300\ud45c\uc801 \uacfc\uc815\uc785\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ub864\ub7ec\ucf54\uc2a4\ud130\uac00 \ub192\uc740 \uacf3\uc5d0\uc11c \ub0b4\ub824\uc62c \ub54c: \uc6b4\ub3d9 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc704\uce58 \uc5d0\ub108\uc9c0",
          "rationale": "\ub864\ub7ec\ucf54\uc2a4\ud130\uac00 \ub0b4\ub824\uc62c \ub54c\ub294 \ub192\uc740 \uacf3\uc758 \uc704\uce58 \uc5d0\ub108\uc9c0\uac00 \ube60\ub974\uac8c \uc6c0\uc9c1\uc774\ub294 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub429\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0c8\uac00 \uc6b8\uba70 \uc9c0\uc800\uadc8 \ub54c: \uc0c8 \ubab8\uc758 \uc18c\ub9ac \uc5d0\ub108\uc9c0 $\\rightarrow$ \ud654\ud559 \uc5d0\ub108\uc9c0",
          "rationale": "\uc0c8\uc758 \ubab8\uc5d0 \uc800\uc7a5\ub418\uc5b4 \uc788\ub358 \ud654\ud559 \uc5d0\ub108\uc9c0\uac00 \uc131\ub300\uc758 \uc9c4\ub3d9\uc744 \ud1b5\ud55c \uc18c\ub9ac \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub418\ub294 \uac83\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ucef4\ud4e8\ud130\ub97c \ucf1c\uc11c \uc790\ub8cc\ub97c \uc870\uc0ac\ud560 \ub54c \ud654\uba74: \uc5f4\uc5d0\ub108\uc9c0 $\\rightarrow$ \ud654\ud559 \uc5d0\ub108\uc9c0",
          "rationale": "\ucef4\ud4e8\ud130 \ud654\uba74\uc5d0\uc11c\ub294 \uacf5\uae09\ub41c \uc804\uae30 \uc5d0\ub108\uc9c0\uac00 \ubaa8\ub2c8\ud130\ub97c \ud1b5\ud574 \ube5b\uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub429\ub2c8\ub2e4.",
          "isCorrect": false
