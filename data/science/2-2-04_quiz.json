        {
          "text": "\ubaa8\ub4e0 \uac00\uc804\uc81c\ud488\uc758 \uc2a4\ud53c\ucee4 \uae30\ub2a5\uc744 \uc81c\uac70\ud558\uc5ec \uc18c\ub9ac \uc190\uc2e4 \ubc29\uc9c0",
          "rationale": "\uc18c\ub9ac \uae30\ub2a5 \uc81c\uac70\ub294 \uc5d0\ub108\uc9c0\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubcf8\ubb38\uc758 \uc0ac\ub840\uac00 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
