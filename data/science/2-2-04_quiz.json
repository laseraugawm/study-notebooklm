          "isCorrect": false
        },
        {
          "text": "\uc5f4\uae30\uad00 \ub0b4\ubd80\uc5d0\uc11c \uc800\uc5f4\uc6d0\uc73c\ub85c \ubc29\ucd9c\ub418\ub294 \uc5f4\uc744 $100\\%$ \ud761\uc218\ud558\uc5ec \ub2e4\uc2dc \uc77c\ub85c \ubc14\uafb8\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "rationale": "\uc5f4\uae30\uad00\uc758 \uc5f4 \uc190\uc2e4\uc744 \uc644\uc804\ud788 \ub9c9\ub294 \uac83\uc740 \ubb3c\ub9ac\uc801\uc73c\ub85c \ubd88\uac00\ub2a5\ud558\uba70, \uc8fc\ud589 \uc0c1\ud669\uc5d0 \ub9de\ucd98 \ubaa8\ud130 \ubcf4\uc870\uc640 \uc5d0\ub108\uc9c0 \ud68c\uc218\ub97c \ud1b5\ud574 \ud6a8\uc728\uc744 \ub192\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc790\ub3d9\ucc28\uc758 \uc18d\ub3c4\ub97c \uc904\uc774\uac70\ub098 \uc5b8\ub355\uc744 \ub0b4\ub824\uac08 \ub54c \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\uac00 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ub418\ub294\uc9c0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
