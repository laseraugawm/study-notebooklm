        {
          "text": "\uac00\uc194\ub9b0 \uc790\ub3d9\ucc28 \uc5d4\uc9c4\uc758 \ub0c9\uac01\uc218\ub97c \uc644\uc804\ud788 \uc81c\uac70\ud558\uc5ec \uc5f4 \ubc29\ucd9c \uc5b5\uc81c",
          "rationale": "\uc5d4\uc9c4 \ub0c9\uac01 \uc2dc\uc2a4\ud15c\uc744 \uc81c\uac70\ud558\uba74 \uc5d4\uc9c4\uc774 \uacfc\uc5f4\ub418\uc5b4 \uacfc\ubd80\ud558 \ubc0f \uace0\uc7a5\uc774 \ubc1c\uc0dd\ud558\ubbc0\ub85c \uc62c\ubc14\ub978 \ud6a8\uc728 \ud5a5\uc0c1\ubc95\uc774 \uc544\ub2d9\ub2c8\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud654\ub825 \ubc1c\uc804\uc18c\ub97c \uc5f4\uae30\uad6c\ub85c \ub300\uccb4\ud558\uc5ec \ubc1c\uc804 \ud6a8\uc728 100% \ub2ec\uc131",
          "rationale": "\ubcf8\ubb38\uc5d0 \uc81c\uc2dc\ub41c \uc5f4\ud6a8\uc728 \ud5a5\uc0c1 \ubc29\uc548\uc740 \uc5f4\ubcd1\ud569 \ubc1c\uc804, \ud558\uc774\ube0c\ub9ac\ub4dc \uae30\uc220, \uc2a4\ub9c8\ud2b8 \ud50c\ub7ec\uadf8 \ub4f1\uc785\ub2c8\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc81c\ud488\uc5d0 \ubd99\uc5b4 \uc788\ub294 efficiency \ub77c\ubca8\uc774\ub098 \uc2a4\ub9c8\ud2b8 \uae30\uae30\ub85c \uc804\uc6d0\uc744 \uc81c\uc5b4\ud558\ub294 \uc7a5\uce58\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
