    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub178\uba3c \ubcfc\ub85c\uadf8\uac00 \uac1c\ubc1c\ud55c \ud488\uc885 \uac1c\ub7c9 \ubc00\uc774 \uc804 \uc138\uacc4 \uc778\ub958 \uc0ac\ud68c\uc5d0 \uac00\uc838\uc628 \ud575\uc2ec\uc801 \ubcc0\ud654\ub294 \ubb34\uc5c7\uc778\uac00?"
