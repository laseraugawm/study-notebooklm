    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\ud559 \uc5f0\uad6c\uac00 \uc778\ub958\uc758 \uc2dd\ub7c9 \ubd80\uc871 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uace0 \uc138\uacc4 \ud3c9\ud654\uc5d0 \uae30\uc5ec\ud558\uc600\uc74c\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ub300\ud45c\uc801\uc778 \ub178\ubca8\uc0c1 \uc218\uc0c1 \uc0ac\ub840\uc758 \uc778\ubb3c\uc740 \ub204\uad6c\uc778\uac00?"
