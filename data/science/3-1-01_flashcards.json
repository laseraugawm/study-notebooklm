        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c4\ub2e8 \uac80\uc0ac\ubc95 \uc911 \uac80\uccb4 \ucd94\ucd9c \ud45c\uc801\uc73c\ub85c '\uc720\uc804\ubb3c\uc9c8'\uc744 \uc0ac\uc6a9\ud558\ub294 \uac80\uc0ac\uc640 '\ub2e8\ubc31\uc9c8'\uc744 \uc0ac\uc6a9\ud558\ub294 \uac80\uc0ac\ub294 \uac01\uac01 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\uc804\ubb3c\uc9c8: PCR \uac80\uc0ac / \ub2e8\ubc31\uc9c8: \ud56d\uc6d0 \uac80\uc0ac (\uc2e0\uc18d \ud56d\uc6d0 \uac80\uc0ac)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud56d\uccb4 \uac80\uc0ac\uc5d0\uc11c \uc9c4\ub2e8\uc744 \uc704\ud574 \uc778\uccb4\ub85c\ubd80\ud130 \ucc44\ucde8\ud558\ub294 \uc8fc\uc694 \uac80\uccb4\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud608\uc561"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1 \uc9c4\ub2e8 \ubaa8\uc758\uc2e4\ud5d8 \uc2dc \uc2dc\uc57d\uc774 \uc778\uccb4\uc5d0 \ub2ff\uac70\ub098 \uc637\uc5d0 \ubb3b\ub294 \uac83\uc744 \ub9c9\uae30 \uc704\ud574 \ucc29\uc6a9\ud558\ub294 3\uac00\uc9c0 \ubcf4\ud638 \uc7a5\uad6c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e4\ud5d8\uc6a9 \uc7a5\uac11, \ubcf4\uc548\uacbd, \uc2e4\ud5d8\ubcf5"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1 \uc9c4\ub2e8 \ubaa8\uc758\uc2e4\ud5d8 \uc2dc \ubaa8\uc758 \ud658\uc790 \uac80\uccb4 \uacb0\uacfc\uc758 \uac10\uc5fc \uc5ec\ubd80\ub97c \uc815\ud655\ud788 \ud310\ub2e8\ud558\uae30 \uc704\ud574 \ud568\uaed8 \ube44\uad50\ud574\uc57c \ud558\ub294 \ub300\uc870\uad70 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\uc758 \uc591\uc131 \ub300\uc870\uad70, \ubaa8\uc758 \uc74c\uc131 \ub300\uc870\uad70"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e4\ud5d8\uc774 \ub05d\ub09c \ub4a4 \uc0ac\uc6a9\ud55c \ubaa8\uc758 \uac80\uccb4\ub098 \ud654\ud559 \uc2dc\uc57d\uc740 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud574\uc57c \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc120\uc0dd\ub2d8\uc758 \uc548\ub0b4\uc5d0 \ub530\ub77c \uc815\ud574\uc9c4 \ud3d0\uae30 \uc7a5\uc18c\uc5d0 \ubc84\ub824\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubaa8\uc758 \uac10\uc5fc\ubcd1 \uc9c4\ub2e8 \uc2e4\ud5d8\uc5d0\uc11c \ud2b9\uc815 \uac80\uccb4\uac00 \uac10\uc5fc\uc790\uc758 \uac83\uc778\uc9c0 \ud310\ub2e8\ud560 \uc218 \uc788\ub294 \uc2e4\ud5d8\uc801 \uae30\uc900\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc591\uc131 \ub300\uc870\uad70 \ubc0f \uc74c\uc131 \ub300\uc870\uad70\uacfc \uc2e4\ud5d8\uad70 \ud658\uc790 \uac80\uccb4\uc758 \uc0c9 \ubcc0\ud654(\ubc18\uc751 \uacb0\uacfc)\ub97c \ube44\uad50\ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1 \ud655\uc0b0 \ubc29\uc9c0\ub97c \uc704\ud574 \ud658\uc790\uc758 \uc774\ub3d9 \uacbd\ub85c\ub97c \ud30c\uc545\ud558\uace0, \uc811\ucd09\uc790\ub97c \ud655\uc778\ud558\uba70 \uac10\uc5fc \uc6d0\uc778\uc744 \ubc1d\ud600\ub0b4\ub294 \uacfc\uc815\uc744 \ubb34\uc5c7\uc774\ub77c\uace0 \ud558\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ed\ud559 \uc870\uc0ac"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70\uc758 \uc5ed\ud559 \uc870\uc0ac \ubc29\uc2dd\uc774 \ud604\ub300\uc5d0 \ube44\ud574 \uac00\uc84c\ub358 \uc8fc\uc694 \ud55c\uacc4\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\ubd80\ubd84 \uc5ed\ud559 \uc870\uc0ac\uad00\uc758 \uc9c1\uc811 \uc870\uc0ac\uc5d0 \uc758\uc874\ud558\uc5ec \uc815\ubcf4 \uc218\uc9d1 \ubc0f \ubd84\uc11d \uc18d\ub3c4\uac00 \ub290\ub838\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud604\ub300 \uc5ed\ud559 \uc870\uc0ac\uc5d0\uc11c \uacfc\uac70\ubcf4\ub2e4 \ubc29\ub300\ud55c \ub370\uc774\ud130\ub97c \ube60\ub974\uac8c \uc218\uc9d1\ud558\uace0 \ubd84\uc11d\ud560 \uc218 \uc788\uac8c \ub9cc\ub4e0 \ucca8\ub2e8 \uacfc\ud559\uae30\uc220 \ubd84\uc57c 2\uac00\uc9c0\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220 (ICT) \ubc0f \uc778\uacf5\uc9c0\ub2a5 (AI) \uae30\uc220"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5ed\ud559 \uc870\uc0ac \uc2dc \uac10\uc5fc\uc790\uc758 \uc774\ub3d9 \uacbd\ub85c, \uccb4\uc628, \uc778\uad6c\uc218 \ub4f1\uc758 \ub2e4\uc591\ud55c \uc815\ubcf4\ub97c \ud604\uc7a5\uc5d0\uc11c \ube60\ub974\uac8c \uc218\uc9d1\ud558\ub294 \ub370 \ud65c\uc6a9\ub418\ub294 \uae30\uc220 \uc7a5\uce58\ub294?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2a4\ub9c8\ud2b8 \uae30\uae30"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc218\uc9d1\ub41c \uac10\uc5fc\ubcd1 \ud655\uc9c4\uc790 \uc218\uc640 \uc9c0\uc5ed\ubcc4 \ubd84\ud3ec \uc815\ubcf4\ub97c \ucde8\ud569\ud558\uc5ec \uc2dc\ubbfc\ub4e4\uc5d0\uac8c \uc2e4\uc2dc\uac04\uc73c\ub85c \uacf5\uc720\u00b7\uc804\ub2ec\ud558\ub294 \ub370 \ud65c\uc6a9\ub418\ub294 \uae30\uc220\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220 (ICT)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud56d\uacf5\ud3b8 \uc815\ubcf4, \ud574\uc678 \ubc0f \uad6d\ub0b4 \uac10\uc5fc\uc790 \uc218, \uc785\uad6d\uc790 \uc218 \ub4f1\uc758 \ubc29\ub300\ud55c \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uc5ec \uac10\uc5fc\ubcd1\uc758 \ud574\uc678 \uc720\uc785 \uc5ec\ubd80\ub97c \uc608\uce21\ud558\ub294 \uacfc\ud559\uae30\uc220\uc740?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 (AI)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804\uad6d \uc0c1\ud669\ud310\uc744 \ud1b5\ud574 \uc2dc\ubbfc\ub4e4\uc5d0\uac8c \uac10\uc5fc\uc790 \uc815\ubcf4\ub098 \ub3d9\uc120\uc744 \uc2e0\uc18d\ud788 \uc548\ub0b4\ud560 \uc218 \uc788\uc5c8\ub358 \ubc14\ud0d5\uc774 \ub41c \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\ubcf4 \ud1b5\uc2e0 \uae30\uc220 (ICT)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc29\ub300\ud55c \uc591\uc758 \ube45\ub370\uc774\ud130\ub97c \ube60\ub978 \uc18d\ub3c4\ub85c \ucc98\ub9ac\ud558\uace0 \uc815\ud655\ud788 \ubd84\uc11d\ud558\uc5ec \uac10\uc5fc \uacbd\ub85c\ub97c \ucd94\uc801\ud558\ub3c4\ub85d \ub3d5\ub294 \ub300\ud45c\uc801 \uacfc\ud559\uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 (AI)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uad6c \uae30\uc628 \uc0c1\uc2b9\uc73c\ub85c \uc778\ud574 \uc790\uc5f0\uc7ac\ud574\uc640 \ud658\uacbd \ubcc0\ud654\uac00 \uac00\uc18d\ud654\ub418\uc5b4 \uc778\ub958 \uc0dd\uc874\uc744 \uc704\ud611\ud558\ub294 \ubc94\uc9c0\uad6c\uc801 \ud658\uacbd \ubb38\uc81c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4 \uc704\uae30 (\uae30\ud6c4 \ubcc0\ud654)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\ud6c4 \uc704\uae30\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \uacfc\ud559\uae30\uc220\uc744 \ud65c\uc6a9\ud574 \ucd94\uc9c4 \uc911\uc778 \ub300\ud45c\uc801\uc778 \ub300\uc751 \ubc29\uc548 2\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc628\uc2e4 \uae30\uccb4(\uc628\uc2e4\uac00\uc2a4) \ubc30\ucd9c \uac10\ucd95 \uae30\uc220 \uac1c\ubc1c, \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uac1c\ubc1c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae09\uaca9\ud55c \uc138\uacc4 \uc778\uad6c \uc99d\uac00\ub85c \uc778\ud574 \ubbf8\ub798 \uc0ac\ud68c\uc5d0\uc11c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc8fc\uc694 \ubb38\uc81c\uc810 3\uac00\uc9c0\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd\ub7c9 \ubd80\uc871, \uc790\uc6d0 \uace0\uac08, \uac70\uc8fc \uacf5\uac04(\uc8fc\ud0dd) \ubd80\uc871"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\ud130\ub137\uacfc \ucef4\ud4e8\ud130 \uae30\uc220\uc774 \ub354\uc6b1 \uace0\ub3c4\ud654\ub428\uc5d0 \ub530\ub77c \ubbf8\ub798 \uc0ac\ud68c\uc5d0\uc11c \ud06c\uac8c \uc6b0\ub824\ub418\ub294 \ubc94\uc8c4 \uc720\ud615\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0ac\uc774\ubc84 \ubc94\uc8c4"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c\uc5d0\uc11c \ub178\uc778 \uc778\uad6c \ube44\uc728\uc774 \uc99d\uac00\ud568\uc5d0 \ub530\ub77c \uad6d\uac00 \ubc0f \uc0ac\ud68c\uc801\uc73c\ub85c \uc911\uc694\ub3c4\uac00 \ub354\uc6b1 \ucee4\uc9c8 \ubd84\uc57c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac74\uac15 \ubc0f \uc758\ub8cc(\uc0dd\uccb4 \ud5ec\uc2a4\ucf00\uc5b4) \ubb38\uc81c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubbf8\ub798 \uc0ac\ud68c\uc758 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uacfc\ud559\uae30\uc220\uc744 \uac1c\ubc1c\ud558\uace0 \uc801\uc6a9\ud560 \ub54c \ubc18\ub4dc\uc2dc \uacac\uc9c0\ud574\uc57c \ud560 \uc2e0\uc911\ud55c \uc790\uc138\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae30\uc220 \uc801\uc6a9 \uc2dc \uc0dd\uae38 \uc218 \uc788\ub294 \ubd80\uc791\uc6a9\uc774\ub098 \uc704\ud5d8\uc131\uc744 \uc810\uac80\ud558\uace0, \uc0ac\ud68c\uc801 \ud569\uc758\ub97c \uac70\uccd0 \ubb38\uc81c\ub97c \ud574\uacb0\ud574\uc57c \ud55c\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70 \uc544\uc2a4\ud14c\uce74 \uc81c\uad6d\uc758 \ucc9c\uc5f0\ub450 \ub300\uc720\ud589 \uc0ac\ub840\uc640 \ud604\ub300\uc758 \ucf54\ub85c\ub09819 \ub300\uc751 \uc0ac\ub840\ub97c \ube44\uad50\ud560 \ub54c \uc5bb\uc744 \uc218 \uc788\ub294 \uc2dc\uc0ac\uc810\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac10\uc5fc\ubcd1 \ub300\uc720\ud589 \uc2dc \ube60\ub978 \uc9c4\ub2e8\uacfc \ucd94\uc801\uc744 \uac00\ub2a5\ud558\uac8c \ud558\ub294 \uacfc\ud559\uae30\uc220\uc758 \ubc1c\uc804\uc774 \uc778\ub958\uc758 \uc0dd\uc874\uacfc \ubb38\uba85 \uc720\uc9c0\uc5d0 \ud544\uc218\uc801\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uacfc\uac70 \uc778\ud130\ub137\uacfc \uc2a4\ub9c8\ud2b8\ud3f0\uc774 \uc0ac\ud68c \ud615\ud0dc\ub97c \ubcc0\ud654\uc2dc\ucf30\ub4ef, \ubbf8\ub798 \uc0ac\ud68c \ubcc0\ud654\ub97c \uc8fc\ub3c4\ud560 \ud575\uc2ec\uc801\uc778 \uc0c8\ub85c\uc6b4 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc778\uacf5\uc9c0\ub2a5 (AI)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud654\uc11d \uc5f0\ub8cc \ub300\uccb4 \ubc0f \uae30\ud6c4 \uc704\uae30 \uadf9\ubcf5\uc744 \ubaa9\uc801\uc73c\ub85c \uc5f0\uad6c\ub418\uace0 \uc788\ub294 \uce5c\ud658\uacbd \uc5d0\ub108\uc9c0 \uae30\uc220 \ubd84\uc57c\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0 \uac1c\ubc1c"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uae00\ub85c\ubc8c\ud654\ub85c \uc804 \uc138\uacc4\uac00 \uc5f0\uacb0\ub41c \ud604\ub300 \ud658\uacbd\uc5d0\uc11c \uad6d\uacbd\uc744 \ub118\uc5b4 \ubc1c\uc0dd\ud558\ub294 \uac10\uc5fc\ubcd1 \uc704\uae30\uc758 \ud30c\uae09\uc801 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud55c \uc9c0\uc5ed\uc758 \uc704\uae30\uac00 \uc804 \uc138\uacc4\ub85c \uc2e0\uc18d\ud788 \ud655\uc0b0\ub418\uc5b4 \uc778\ub958 \uc804\uccb4\uc5d0 \ucee4\ub2e4\ub780 \uc601\ud5a5\uc744 \uc900\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub3c4\uc2dc\ud654 \ubc0f \uc8fc\ud0dd \ubd80\uc871, \uc790\uc6d0 \uace0\uac08\uacfc \uac19\uc740 \uc0ac\ud68c\uc801 \ubb38\uc81c\ub97c \ub2e4\ub8e8\uae30 \uc704\ud574 \ud544\uc694\ud55c \uacfc\ud559\uad50\uc721\uc801 \ud0d0\uad6c \ud65c\ub3d9\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
