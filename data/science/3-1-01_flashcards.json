      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc804 \uc138\uacc4 \uc2dd\ub7c9 \uc0dd\uc0b0\ub7c9\uc744 \ud06c\uac8c \ub298\ub824 \uc218\ub9ce\uc740 \uc0ac\ub78c\ub4e4\uc744 \uad76\uc8fc\ub9bc(\uc2dd\ub7c9 \ubd80\uc871)\uc5d0\uc11c \ubc97\uc5b4\ub098\uac8c \ud558\uc600\ub2e4."
