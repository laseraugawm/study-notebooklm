    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac1c\ubbf8\ub098 \ubc8c\uc5d0 \uc3d8\uc600\uc744 \ub54c \ubd84\ube44\ub418\ub294 \uc0b0\uc131 \ubb3c\uc9c8\uc744 \uc644\ud654\ud558\uae30 \uc704\ud574 \ubc14\ub974\ub294 \uc57d\uc758 \uc561\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
