    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0b0\uc131\ud654\ub41c \ud1a0\uc591\uc774\ub098 \ud638\uc218\uc5d0 \uc11d\ud68c \uac00\ub8e8\ub97c \ubfcc\ub824 \uc911\ud654\uc2dc\ud0a4\ub294 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
