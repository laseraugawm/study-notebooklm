      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubca0\uc774\ud0b9\ud30c\uc6b0\ub354 \uc18d \uc0b0\uc131 \ubb3c\uc9c8\uacfc \uc5fc\uae30\uc131 \ubb3c\uc9c8 \uc0ac\uc774\uc758 \uc911\ud654 \ubc18\uc751"
