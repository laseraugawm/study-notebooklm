    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc704\uc561\uc758 \uc5fc\uc0b0\uc5d0 \uc758\ud574 \uc704 \uc810\ub9c9\uc774 \uc190\uc0c1\ub418\uc5b4 \uc18d\uc774 \uc4f0\ub9b4 \ub54c \ubcf5\uc6a9\ud558\ub294 \uc81c\uc0b0\uc81c\uc758 \uc561\uc131\uc740 \ubb34\uc5c7\uc778\uac00?"
