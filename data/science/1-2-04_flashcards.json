      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\uc778 \ubb3c\uc9c8\uc740 \uc5fc\uae30\uc131\uc774\uba70, \ub808\ubaac\uc999(\uc0b0\uc131)\uc774 \uc774\ub97c \uc911\ud654\ud558\uc5ec \ube44\ub9b0\ub0b4\ub97c \uc904\uc778\ub2e4."
