        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubca0\uc774\ud0b9\ud30c\uc6b0\ub354\ub97c \ubc00\uac00\ub8e8 \ubc18\uc8fd\uc5d0 \ub123\uc744 \ub54c \ubc18\uc8fd \ub0b4\ubd80\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \ubc18\uc751\uc740 \ubb34\uc5c7\uc778\uac00?"
