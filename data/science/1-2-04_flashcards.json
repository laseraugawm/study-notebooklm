    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc0dd\uc120 \ube44\ub9b0\ub0b4\uc758 \uc6d0\uc778 \ubb3c\uc9c8\uc740 \uc5b4\ub5a0\ud55c \uc561\uc131\uc744 \ub760\uba70, \ub808\ubaac\uc999\uc744 \ubfcc\ub824 \uc774\ub97c \uc904\uc774\ub294 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00?"
