    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c \uc2e4\uc0dd\ud65c \ubb3c\ud488 \ub610\ub294 \uc57d\ud488\uacfc \uadf8 \uc18d\uc5d0 \ud3ec\ud568\ub418\uc5b4 \uc788\ub294 \uc0b0\u00b7\uc5fc\uae30 \uc131\ubd84\uc758 \uc5f0\uacb0\uc774 \uc62c\ubc14\ub978 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc720\ub9ac \uc138\uc815\uc81c - \uae30\ub984 \uc131\ubd84\uc744 \uc81c\uac70\ud558\uae30 \uc704\ud55c \uc5fc\uae30 \uc131\ubd84",
