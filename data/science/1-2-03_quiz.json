        {
          "text": "\ud0c4\uc0b0 \uce7c\uc298\uc744 \ub123\uc5c8\uc744 \ub54c \uc774\uc0b0\ud654 \ud0c4\uc18c \uae30\uccb4\ub97c \ubc1c\uc0dd\uc2dc\ud0a8\ub2e4.",
