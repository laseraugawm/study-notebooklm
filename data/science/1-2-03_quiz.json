        {
          "text": "\ub450\ubd80 \uc870\uac01\uc744 \ub123\uc5c8\uc744 \ub54c \ub450\ubd80(\ub2e8\ubc31\uc9c8)\ub97c \ub179\uc774\ub294 \uc131\uc9c8\uc774 \uc788\ub2e4.",
