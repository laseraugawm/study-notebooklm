          "rationale": "\uc218\uc0b0\ud654 \uc774\uc628($OH^-$)\uc740 \uc591\uc774\uc628\uc774 \uc544\ub2c8\ub77c \uc74c\uc804\ud558\ub97c \ub760\ub294 \uc74c\uc774\uc628\uc774\ub2e4."
        },
        {
          "text": "\uc218\uc0b0\ud654 \uce7c\uc298 \uc218\uc6a9\uc561\uc5d0 \ub9c8\uadf8\ub124\uc298 \uc870\uac01\uc744 \ub123\uc73c\uba74 \uc218\uc18c \uae30\uccb4\uac00 \ubc1c\uc0dd\ud55c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5fc\uae30\ub294 \ub9c8\uadf8\ub124\uc298 \ub4f1\uc758 \uae08\uc18d\uacfc \ubc18\uc751\ud558\uc5ec \uc218\uc18c \uae30\uccb4\ub97c \ubc1c\uc0dd\uc2dc\ud0a4\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\uc5fc\uae30 \uc885\ub958\ub9c8\ub2e4 \uc591\uc774\uc628\uc774 \ubaa8\ub450 \ub3d9\uc77c\ud558\ubbc0\ub85c \uacf5\ud1b5 \uc131\uc9c8\uc774 \ub098\ud0c0\ub09c\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc5fc\uae30\uc758 \uc885\ub958\uc5d0 \ub530\ub77c \uc591\uc774\uc628\uc758 \uc885\ub958\ub294 \ub2ec\ub77c\uc9c0\uba70, \uacf5\ud1b5 \uc131\uc9c8\uc740 \uc218\uc0b0\ud654 \uc774\uc628($OH^-$) \ub54c\ubb38\uc774\ub2e4."
        }
      ],
      "hint": "\ud654\ud559\uc2dd $Ca(OH)_2$\uac00 \uc774\uc628\ud654\ub420 \ub54c \ub098\uc624\ub294 \uc591\uc774\uc628($Ca^{2+}$)\uacfc \uc74c\uc774\uc628($OH^-$)\uc758 \uacc4\uc218\ub97c \uc0b4\ud3b4\ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ubb3d\uc740 \uc5fc\uc0b0($HCl$) \uc218\uc6a9\uc561\uacfc \uc218\uc0b0\ud654 \ub098\ud2b8\ub968($NaOH$) \uc218\uc6a9\uc561\uc758 \uacf5\ud1b5\uc810\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
