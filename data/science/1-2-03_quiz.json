        },
        {
          "text": "\uc218\uc0b0\ud654 \uce7c\uc298 \uc218\uc6a9\uc561\uc774 \uc5fc\uae30\uc131\uc744 \ub760\ub294 \uc774\uc720\ub294 \uc591\uc774\uc628\uc778 \uc218\uc0b0\ud654 \uc774\uc628 \ub54c\ubb38 \uc774\ub2e4.",
