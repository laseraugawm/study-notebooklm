        }
      ],
      "hint": "\uc5fc\uae30\uc131 \uc138\uc81c\uac00 \ucc0c\ub4e0 \ub54c\ub098 \ud53c\ubd80(\ub2e8\ubc31\uc9c8) \uc791\uc6a9 \uc2dc \ub098\ud0c0\ub0b4\ub294 \ud2b9\uc9d5\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc218\uc0b0\ud654 \uce7c\uc298($Ca(OH)_2$) \uc218\uc6a9\uc561\uc758 \uc774\uc628\ud654 \ubc0f \uc5fc\uae30\uc131\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
