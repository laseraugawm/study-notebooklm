        },
        {
          "text": "\ub9c8\uadf8\ub124\uc298 \uc870\uac01\uc744 \ub123\uc73c\uba74 \uc218\uc18c($H_2$) \uae30\uccb4\uac00 \ud65c\ubc1c\ud788 \ubc1c\uc0dd\ud55c\ub2e4.",
