        {
          "text": "\uc5fc\uae30 \uc218\uc6a9\uc561\uc5d0\ub294 \uc774\uc628\uc774 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc73c\ubbc0\ub85c \uc804\ub958\uac00 \ud750\ub974\uc9c0 \uc54a\ub294\ub2e4.",
