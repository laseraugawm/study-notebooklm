{
  "title": "\uc0b0\uacfc\uc5fc\uae30 \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\uc0b0(Acid) \uc218\uc6a9\uc561\uc774 \uac00\uc9c0\ub294 \uacf5\ud1b5\uc801\uc778 \uc131\uc9c8(\uc0b0\uc131)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud0c4\uc0b0 \uce7c\uc298($CaCO_3$)\uacfc \ubc18\uc751\ud558\uc5ec \uc774\uc0b0\ud654 \ud0c4\uc18c($CO_2$) \uae30\uccb4\ub97c \ubc1c\uc0dd\uc2dc\ud0a8\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0b0\uc740 \ud0c4\uc0b0 \uce7c\uc298\uacfc \ubc18\uc751\ud560 \ub54c \uc774\uc0b0\ud654 \ud0c4\uc18c \uae30\uccb4\ub97c \uc0dd\uc131\ud558\ub294 \ud654\ud559\uc801 \uc131\uc9c8\uc744 \ubcf4\uc778\ub2e4."
        },
        {
          "text": "\ub450\ubd80\uc640 \uac19\uc740 \ub2e8\ubc31\uc9c8 \ubb3c\uc9c8\uc5d0 \ub123\uc73c\uba74 \ub2e8\ubc31\uc9c8\uc744 \ub179\uc774\ub294 \uc131\uc9c8\uc774 \uc788\ub2e4.",
          "isCorrect": false,
          "rationale": "\ub2e8\ubc31\uc9c8\uc744 \ub179\uc774\ub294 \ubc18\uc751\uc740 \uc0b0\uc774 \uc544\ub2c8\ub77c \uc5fc\uae30\uc758 \uacf5\ud1b5\uc801\uc778 \uc131\uc9c8\uc774\ub2e4."
        },
        {
          "text": "\uad6c\ub9ac($Cu$), \uc740($Ag$)\uacfc \uac19\uc740 \uae08\uc18d\uacfc \ubc18\uc751\ud558\uc5ec \uc218\uc18c($H_2$) \uae30\uccb4\ub97c \uc798 \ubc1c\uc0dd\uc2dc\ud0a8\ub2e4.",
          "isCorrect": false,
          "rationale": "\uad6c\ub9ac, \uc740, \uae08, \ubc31\uae08 \ub4f1\uc758 \uae08\uc18d\uc740 \uc0b0\uacfc \ubc18\uc751\ud558\uc5ec \uc218\uc18c \uae30\uccb4\ub97c \ubc1c\uc0dd\uc2dc\ud0a4\uc9c0 \uc54a\ub294\ub2e4."
        },
        {
          "text": "\uc218\uc6a9\uc561\uc5d0 \uc804\uadf9\uc744 \ub2f4\uac14\uc744 \ub54c \uc774\uc628\uc774 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc73c\ubbc0\ub85c \uc804\ub958\uac00 \ud750\ub974\uc9c0 \uc54a\ub294\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc740 \uc218\uc6a9\uc561\uc5d0\uc11c \uc591\uc774\uc628\uacfc \uc74c\uc774\uc628\uc73c\ub85c \uc774\uc628\ud654\ud558\ubbc0\ub85c \uc804\ub958\uac00 \uc798 \ud750\ub978\ub2e4."
        }
      ],
      "hint": "\uc0b0\uc740 \uacc4\ub780 \uaecd\ub370\uae30\ub098 \uc870\uac1c\uaecd\ub370\uae30\uc758 \uc8fc\uc131\ubd84\uc778 \ud0c4\uc0b0 \uce7c\uc298\uacfc \ubc18\uc751\ud560 \ub54c \ud2b9\uc815 \uae30\uccb4\ub97c \ub0b4\ub193\uc2b5\ub2c8\ub2e4."
    },
    {
      "type": "multiple_choice",
      "question": "\uc5ec\ub7ec \uac00\uc9c0 \uc0b0\uc774 \uc218\uc6a9\uc561 \uc0c1\ud0dc\uc5d0\uc11c \uacf5\ud1b5\uc801\uc778 \uc131\uc9c8(\uc0b0\uc131)\uc744 \ub098\ud0c0\ub0b4\ub294 \uae4c\ub2ed\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc0b0\uc774 \ubb3c\uc5d0 \ub179\uc544 \uc774\uc628\ud654\ud560 \ub54c \uacf5\ud1b5\uc801\uc73c\ub85c \uc218\uc18c \uc774\uc628($H^+$)\uc744 \ub0b4\ub193\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": true,
          "rationale": "\uc0b0\uc758 \uacf5\ud1b5\uc801\uc778 \uc131\uc9c8\uc740 \uc218\uc6a9\uc561 \uc0c1\ud0dc\uc5d0\uc11c \uc591\uc774\uc628\uc73c\ub85c \uc218\uc18c \uc774\uc628($H^+$)\uc744 \ub0b4\ub193\uae30 \ub54c\ubb38\uc5d0 \ub098\ud0c0\ub09c\ub2e4."
        },
        {
          "text": "\ubaa8\ub4e0 \uc0b0 \uc218\uc6a9\uc561\uc774 \uc11c\ub85c \uac19\uc740 \uc885\ub958\uc758 \uc74c\uc774\uc628\uc744 \ud3ec\ud568\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc758 \uc885\ub958\uc5d0 \ub530\ub77c \uc218\uc6a9\uc561 \uc18d\uc5d0 \uc874\uc7ac\ud558\ub294 \uc74c\uc774\uc628\uc758 \uc885\ub958\ub294 \uc11c\ub85c \ub2e4\ub974\ub2e4."
        },
        {
          "text": "\uc218\uc6a9\uc561\uc5d0\uc11c \uacf5\ud1b5\uc801\uc73c\ub85c \uc218\uc0b0\ud654 \uc774\uc628($OH^-$)\uc744 \ub0b4\ub193\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc218\uc0b0\ud654 \uc774\uc628($OH^-$)\uc740 \uc0b0\uc774 \uc544\ub2cc \uc5fc\uae30\uac00 \uc218\uc6a9\uc561\uc5d0\uc11c \ub0b4\ub193\ub294 \uacf5\ud1b5 \uc774\uc628\uc774\ub2e4."
        },
        {
          "text": "\uc0b0 \ubd84\uc790\uac00 \ubb3c\uc18d\uc5d0\uc11c \uc774\uc628\uc73c\ub85c \uac08\ub77c\uc9c0\uc9c0 \uc54a\uace0 \ubd84\uc790 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc740 \uc218\uc6a9\uc561 \uc0c1\ud0dc\uc5d0\uc11c \uc591\uc774\uc628\uacfc \uc74c\uc774\uc628\uc73c\ub85c \uc774\uc628\ud654\ub41c\ub2e4."
        }
      ],
      "hint": "\uc0b0 \uc218\uc6a9\uc561\uc5d0\uc11c \uc885\ub958\uc5d0 \uad00\uacc4\uc5c6\uc774 \uacf5\ud1b5\uc73c\ub85c \uc874\uc7ac\ud558\ub294 \uc591\uc774\uc628\uc5d0 \uc8fc\ubaa9\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ub2e4\uc74c\uc740 \uba87 \uac00\uc9c0 \uc0b0 \ubb3c\uc9c8\uc758 \uc774\uc628\ud654 \ubc18\uc751\uc2dd\uc774\ub2e4.\n\n- \uc5fc\ud654 \uc218\uc18c: $HCl \\rightarrow H^+ + Cl^-$\n- \uc9c8\uc0b0: $HNO_3 \\rightarrow H^+ + NO_3^-$\n- \ud669\uc0b0: $H_2SO_4 \\rightarrow 2H^+ + SO_4^{2-}$\n- \uc544\uc138\ud2b8\uc0b0: $CH_3COOH \\rightarrow H^+ + CH_3COO^-$\n\n\uc774\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud669\uc0b0($H_2SO_4$) $1$\ubd84\uc790\uac00 \uc644\uc804\ud788 \uc774\uc628\ud654\ud558\uba74 $2$\uac1c\uc758 \uc218\uc18c \uc774\uc628($H^+$)\uacfc $1$\uac1c\uc758 \ud669\uc0b0 \uc774\uc628($SO_4^{2-}$)\uc774 \uc0dd\uc131\ub41c\ub2e4.",
          "isCorrect": true,
          "rationale": "\ud669\uc0b0 \ud654\ud559\uc2dd\uc758 \uacc4\uc218\ube44\uc5d0 \ub530\ub77c $H_2SO_4$ $1$\ubd84\uc790\ub2f9 $2H^+$\uc640 $1SO_4^{2-}$\ub85c \uc774\uc628\ud654\ud55c\ub2e4."
        },
        {
          "text": "\uc544\uc138\ud2b8\uc0b0($CH_3COOH$)\uc740 \uc774\uc628\ud654\ud560 \ub54c \ubd84\uc790 \ub0b4 $4$\uac1c\uc758 \uc218\uc18c \uc6d0\uc790\uac00 \ubaa8\ub450 \uc218\uc18c \uc774\uc628($H^+$)\uc73c\ub85c \ub0b4\ub193\uc544\uc9c4\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc544\uc138\ud2b8\uc0b0 \ubd84\uc790\uc5d0 \ud3ec\ud568\ub41c \uc218\uc18c \uc6d0\uc790 $4$\uac1c \uc911 $1$\uac1c\ub9cc \uc218\uc18c \uc774\uc628($H^+$)\uc73c\ub85c \uc774\uc628\ud654\ub41c\ub2e4."
        },
        {
          "text": "\uc9c8\uc0b0($HNO_3$)\uc774 \uc774\uc628\ud654\ub420 \ub54c \uc0dd\uc131\ub418\ub294 \uc74c\uc774\uc628\uc740 $NO_3^{2-}$\uc774\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc9c8\uc0b0\uc774 \uc774\uc628\ud654\ub420 \ub54c \uc0dd\uc131\ub418\ub294 \uc74c\uc774\uc628\uc740 $1$\uac00 \uc74c\uc774\uc628\uc778 \uc9c8\uc0b0 \uc774\uc628($NO_3^-$)\uc774\ub2e4."
        },
        {
          "text": "\uc0b0 \ubb3c\uc9c8\uc774 \uc218\uc6a9\uc561\uc5d0\uc11c \uc774\uc628\ud654\ud560 \ub54c \ub0b4\ub193\ub294 \uc74c\uc774\uc628\uc758 \uc885\ub958\ub294 \ubaa8\ub4e0 \uc0b0\uc5d0\uc11c \ub3d9\uc77c\ud558\ub2e4.",
          "isCorrect": false,
          "rationale": "\uc0b0\uc758 \uc885\ub958\uc5d0 \ub530\ub77c \uc74c\uc774\uc628\uc758 \uc885\ub958\ub294 \uac01\uae30 \ub2ec\ub77c\uc9c4\ub2e4."
        }
      ],
      "hint": "\uac01 \uc0b0 \ubd84\uc790 $1$\uac1c\uac00 \uc774\uc628\ud654\ub420 \ub54c \uc0dd\uc131\ub418\ub294 \uc218\uc18c \uc774\uc628\uacfc \uc74c\uc774\uc628\uc758 \uac1c\uc218\ube44 \ubc0f \ud654\ud559\uc2dd\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\uc5fc\uae30(Base) \uc218\uc6a9\uc561\uc774 \uac00\uc9c0\ub294 \uacf5\ud1b5\uc801\uc778 \uc131\uc9c8(\uc5fc\uae30\uc131)\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ub450\ubd80\uc640 \uac19\uc740 \ub2e8\ubc31\uc9c8 \uc131\ubd84\uc744 \ub179\uc774\ub294 \uc131\uc9c8\uc774 \uc788\ub2e4.",
          "isCorrect": true,
