        {
          "text": "\ub9c8\uadf8\ub124\uc298 \uc870\uac01\uc744 \ub123\uc5c8\uc744 \ub54c \uc218\uc18c \uae30\uccb4\ub97c \ubc1c\uc0dd\uc2dc\ud0a8\ub2e4.",
