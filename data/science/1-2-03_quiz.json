        },
        {
          "text": "\ud0c4\uc0b0 \uce7c\uc298\uacfc \ubc18\uc751\ud558\uc5ec \uc774\uc0b0\ud654 \ud0c4\uc18c \uae30\uccb4\ub97c \uc0dd\uc131\ud55c\ub2e4.",
