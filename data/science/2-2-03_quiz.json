        {
          "text": "\uc218\uc18c \uc6d0\uc790\ud575\ub4e4\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uc735\ud569\ud558\uba70 \ud5ec\ub968 \uc6d0\uc790\ud575\uc73c\ub85c \ubcc0\ud558\uae30 \ub54c\ubb38\uc774\ub2e4.",
