{
  "title": "\ubc1c\uc804\uc18c \ud034\uc988",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "2022\ub144 \ud55c\uad6d\uc804\ub825\uacf5\uc0ac \uc790\ub8cc\uc5d0 \ub530\ub978 \uc6b0\ub9ac\ub098\ub77c \uc5d0\ub108\uc9c0\uc6d0\ubcc4 \ubc1c\uc804\ub7c9 \ube44\uc911\uc5d0 \uad00\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc11d\ud0c4\uc774 32.5%\ub85c \uac00\uc7a5 \ub192\uc740 \ube44\uc911\uc744 \ucc28\uc9c0\ud558\uba70, \uadf8 \ub2e4\uc74c\uc740 LNG(29.5%)\uc774\ub2e4.",
          "rationale": "2022\ub144 \uc5d0\ub108\uc9c0\uc6d0\ubcc4 \ubc1c\uc804\ub7c9 \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \uc11d\ud0c4 \ubc1c\uc804\ub7c9\uc774 32.5%\ub85c \uac00\uc7a5 \ub192\uace0, LNG\uac00 29.5%\ub85c \ub450 \ubc88\uc9f8\ub85c \ub192\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc6d0\uc790\ub825(\ud575\uc5d0\ub108\uc9c0)\uc758 \ubc1c\uc804\ub7c9 \ube44\uc911\uc774 \uc11d\ud0c4\uacfc LNG\ubcf4\ub2e4 \ubaa8\ub450 \ub192\ub2e4.",
          "rationale": "\uc6d0\uc790\ub825 \ubc1c\uc804\ub7c9 \ube44\uc911\uc740 27.5%\ub85c, \uc11d\ud0c4(32.5%)\uacfc LNG(29.5%)\ubcf4\ub2e4 \ub0ae\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\ub294 \uc804\uccb4 \ubc1c\uc804\ub7c9\uc758 20% \uc774\uc0c1\uc744 \ucc28\uc9c0\ud558\uace0 \uc788\ub2e4.",
          "rationale": "2022\ub144 \uae30\uc900 \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\uac00 \ucc28\uc9c0\ud558\ub294 \ubc1c\uc804\ub7c9 \ube44\uc911\uc740 8.9%\uc774\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "LNG\ubcf4\ub2e4 \uc6d0\uc790\ub825(\ud575\uc5d0\ub108\uc9c0)\uc758 \ubc1c\uc804\ub7c9 \ube44\uc911\uc774 \ub354 \ub192\ub2e4.",
          "rationale": "LNG \ubc1c\uc804\ub7c9 \ube44\uc911\uc740 29.5%\ub85c \uc6d0\uc790\ub825 \ubc1c\uc804\ub7c9 \ube44\uc911\uc778 27.5%\ubcf4\ub2e4 \ub192\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\uc11d\ud0c4, LNG, \uc6d0\uc790\ub825, \uc2e0\uc7ac\uc0dd \uc5d0\ub108\uc9c0\uc758 \ube44\uc728 \uc21c\uc11c\ub97c \ucc28\ub840\ub300\ub85c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud654\ub825 \ubc1c\uc804\uc18c\uc5d0\uc11c \uc804\uae30 \uc5d0\ub108\uc9c0\uac00 \ucd5c\uc885 \uc0dd\uc0b0\ub418\uae30\uae4c\uc9c0 \uc77c\uc5b4\ub098\ub294 \uc8fc\uc694 \uc5d0\ub108\uc9c0 \uc804\ud658 \uacfc\uc815\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ud654\ud559 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc5f4\uc5d0\ub108\uc9c0 $\\rightarrow$ \uc6b4\ub3d9 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc804\uae30 \uc5d0\ub108\uc9c0",
          "rationale": "\ud654\uc11d \uc5f0\ub8cc\uc758 \ud654\ud559 \uc5d0\ub108\uc9c0\ub97c \uc5f0\uc18c\uc2dc\ucf1c \uc5f4\uc5d0\ub108\uc9c0\ub85c \ubc14\uafbc \ub4a4, \ubb3c\uc744 \ub053\uc5ec \ubc1c\uc0dd\ud55c \uc99d\uae30\uc640 \ud130\ube48\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub97c \uac70\uccd0 \ubc1c\uc804\uae30\uc5d0\uc11c \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub41c\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc5f4\uc5d0\ub108\uc9c0 $\\rightarrow$ \ud654\ud559 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc6b4\ub3d9 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc804\uae30 \uc5d0\ub108\uc9c0",
          "rationale": "\ud654\uc11d \uc5f0\ub8cc \uc790\uccb4\uc5d0 \uc800\uc7a5\ub418\uc5b4 \uc788\ub294 \ucd08\uae30 \uc5d0\ub108\uc9c0 \ud615\ud0dc\ub294 \uc5f4\uc5d0\ub108\uc9c0\uac00 \uc544\ub2cc \ud654\ud559 \uc5d0\ub108\uc9c0\uc774\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud654\ud559 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc6b4\ub3d9 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc5f4\uc5d0\ub108\uc9c0 $\\rightarrow$ \uc804\uae30 \uc5d0\ub108\uc9c0",
          "rationale": "\uc5f0\uc18c\ub97c \ud1b5\ud574 \uc5f4\uc5d0\ub108\uc9c0\uac00 \uba3c\uc800 \ubc1c\uc0dd\ud558\uc5ec \ubb3c\uc744 \ub053\uc778 \ud6c4 \uc218\uc99d\uae30 \ubc0f \ud130\ube48\uc758 \uc6b4\ub3d9 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ub41c\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud575\uc5d0\ub108\uc9c0 $\\rightarrow$ \uc5f4\uc5d0\ub108\uc9c0 $\\rightarrow$ \uc6b4\ub3d9 \uc5d0\ub108\uc9c0 $\\rightarrow$ \uc804\uae30 \uc5d0\ub108\uc9c0",
          "rationale": "\ud575\uc5d0\ub108\uc9c0\uc5d0\uc11c \uc2dc\uc791\ud558\ub294 \uc804\ud658 \uacfc\uc815\uc740 \ud654\ub825 \ubc1c\uc804\uc774 \uc544\ub2cc \ud575\ubc1c\uc804(\uc6d0\uc790\ub825 \ubc1c\uc804)\uc758 \uc5d0\ub108\uc9c0 \uc804\ud658 \uc21c\uc11c\uc774\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ud654\uc11d \uc5f0\ub8cc\uc758 \ucd08\uae30 \uc800\uc7a5 \uc5d0\ub108\uc9c0 \ud615\ud0dc\ubd80\ud130 \ubcf4\uc77c\ub7ec, \uc218\uc99d\uae30/\ud130\ube48, \ubc1c\uc804\uae30 \uc21c\uc11c\ub85c \uc77c\uc5b4\ub098\ub294 \ubcc0\ud654\ub97c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud575\ubc1c\uc804\uc18c\uc758 \uc6d0\uc790\ub85c \ub0b4\ubd80\uc5d0\uc11c \uc77c\uc5b4\ub098\ub294 \ubc18\uc751 \ubc0f \uc5d0\ub108\uc9c0 \uc0dd\uc131 \uacfc\uc815\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc6b0\ub77c\ub284 \uc6d0\uc790\ud575\uc5d0 \uc911\uc131\uc790\uac00 \ucda9\ub3cc\ud558\uc5ec \uc6d0\uc790\ud575\uc774 \ucabc\uac1c\uc9c8 \ub54c \uc9c8\ub7c9\uc774 \uac10\uc18c\ud558\uba74\uc11c \ub9c9\ub300\ud55c \uc5f4\uc5d0\ub108\uc9c0\uac00 \ubc29\ucd9c\ub41c\ub2e4.",
          "rationale": "\ud575\ubc1c\uc804\uc740 \uc6b0\ub77c\ub284 \uc6d0\uc790\ud575\uc758 \ud575\ubd84\uc5f4 \ubc18\uc751 \uacfc\uc815\uc5d0\uc11c \uc9c8\ub7c9\uc774 \uac10\uc18c\ud558\uba74\uc11c \ubc1c\uc0dd\ud558\ub294 \uc5f4\uc5d0\ub108\uc9c0\ub97c \uc774\uc6a9\ud55c\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc218\uc18c \uc6d0\uc790\ud575\uc774 \uc735\ud569\ud558\uc5ec \ud5ec\ub968 \uc6d0\uc790\ud575\uc73c\ub85c \ubcc0\ud558\ub294 \ud575\uc735\ud569 \ubc18\uc751\uc744 \ud1b5\ud574 \uc5f4\uc5d0\ub108\uc9c0\ub97c \uc5bb\ub294\ub2e4.",
          "rationale": "\uc218\uc18c \uc6d0\uc790\ud575\uc758 \ud575\uc735\ud569 \ubc18\uc751\uc740 \ud0dc\uc591 \ub4f1\uc5d0\uc11c \uc77c\uc5b4\ub098\uba70, \ud575\ubc1c\uc804\uc18c\uc5d0\uc11c\ub294 \uc6b0\ub77c\ub284 \uc6d0\uc790\ud575\uc774 \ucabc\uac1c\uc9c0\ub294 \ud575\ubd84\uc5f4 \ubc18\uc751\uc744 \uc774\uc6a9\ud55c\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc6d0\uc790\ud575 \ubd84\uc5f4 \uc2dc \ubc29\ucd9c\ub41c \uc804\uc790\ub4e4\uc774 \ub2e4\ub978 \uc6d0\uc790\ud575\uacfc \uc5f0\uc1c4 \ucda9\ub3cc\uc744 \uc77c\uc73c\ud0a8\ub2e4.",
          "rationale": "\uc6b0\ub77c\ub284 \uc6d0\uc790\ud575\uc774 \ucabc\uac1c\uc9c8 \ub54c \ubc29\ucd9c\ub418\uc5b4 \ub2e4\ub978 \uc6b0\ub77c\ub284 \uc6d0\uc790\ud575\uacfc \uc5f0\uc1c4 \ucda9\ub3cc\uc744 \uc77c\uc73c\ud0a4\ub294 \uc785\uc790\ub294 \uc911\uc131\uc790\uc774\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc6b0\ub77c\ub284\uc774 \uc5f0\uc18c\ud558\uba74\uc11c \ubc1c\uc0dd\ud558\ub294 \ud654\ud559 \uc5d0\ub108\uc9c0\ub97c \uc9c1\uc811 \uc804\uae30 \uc5d0\ub108\uc9c0\ub85c \uc804\ud658\ud55c\ub2e4.",
          "rationale": "\uc6b0\ub77c\ub284\uc740 \ud654\uc11d \uc5f0\ub8cc\ucc98\ub7fc \uc5f0\uc18c\ud558\ub294 \uac83\uc774 \uc544\ub2c8\uba70, \ud654\ud559 \ubc18\uc751\uc774 \uc544\ub2cc \uc6d0\uc790\ud575\uc758 \ubd84\uc5f4 \ubc18\uc751\uc744 \uac70\uce5c\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ubb34\uac70\uc6b4 \uc6d0\uc790\ud575\uc774 \ucda9\ub3cc\ud558\ub294 \uc785\uc790\uc758 \uc885\ub958\uc640 \ucabc\uac1c\uc9c8 \ub54c \ubc1c\uc0dd\ud558\ub294 \uc9c8\ub7c9 \ubcc0\ud654\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud654\ub825 \ubc1c\uc804\uacfc \ud575\ubc1c\uc804\uc758 \uacf5\ud1b5\uc810\uc73c\ub85c \uac00\uc7a5 \uc801\uc808\ud55c \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubc1c\uc0dd\ud55c \uc5f4\uc5d0\ub108\uc9c0\ub85c \ubb3c\uc744 \ub053\uc5ec \ub9cc\ub4e0 \uc99d\uae30\ub85c \ud130\ube48\uc744 \ub3cc\ub824 \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc0dd\uc0b0\ud55c\ub2e4.",
          "rationale": "\ub450 \ubc1c\uc804 \ubc29\uc2dd \ubaa8\ub450 \uc5f4\uc5d0\ub108\uc9c0\ub97c \ubc1c\uc0dd\uc2dc\ucf1c \ubb3c\uc744 \ub053\uc774\uace0, \uc218\uc99d\uae30\ub85c \ud130\ube48\uc744 \ub3cc\ub824 \ubc1c\uc804\uae30\ub97c \uac00\ub3d9\ud55c\ub2e4\ub294 \uc5d0\ub108\uc9c0 \uc0dd\uc0b0 \uba54\ucee4\ub2c8\uc998\uc774 \ub3d9\uc77c\ud558\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubc1c\uc804 \uacfc\uc815\uc5d0\uc11c \uc774\uc0b0\ud654 \ud0c4\uc18c\uc640 \ubbf8\uc138 \uba3c\uc9c0\ub97c \ub300\ub7c9\uc73c\ub85c \ubc30\ucd9c\ud55c\ub2e4.",
          "rationale": "\uc774\uc0b0\ud654 \ud0c4\uc18c\uc640 \ubbf8\uc138 \uba3c\uc9c0 \ubc30\ucd9c\uc740 \ud654\uc11d \uc5f0\ub8cc\ub97c \uc5f0\uc18c\ud558\ub294 \ud654\ub825 \ubc1c\uc804\uc758 \ubb38\uc81c\uc810\uc774\uba70, \ud575\ubc1c\uc804\uc740 \ubc1c\uc804 \uacfc\uc815\uc5d0\uc11c \uc774\uc0b0\ud654 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \uc801\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ud654\uc11d \uc5f0\ub8cc\uc758 \ud654\ud559 \uc5d0\ub108\uc9c0\ub97c \uadfc\ubcf8\uc801\uc778 \uc5d0\ub108\uc9c0\uc6d0\uc73c\ub85c \uc0ac\uc6a9\ud55c\ub2e4.",
          "rationale": "\ud654\ub825 \ubc1c\uc804\uc740 \ud654\uc11d \uc5f0\ub8cc\uc758 \ud654\ud559 \uc5d0\ub108\uc9c0\ub97c \uc0ac\uc6a9\ud558\uc9c0\ub9cc, \ud575\ubc1c\uc804\uc740 \uc6b0\ub77c\ub284\uacfc \uac19\uc740 \ubc29\uc0ac\uc131 \ubb3c\uc9c8\uc758 \ud575\uc5d0\ub108\uc9c0\ub97c \uc6d0\ub8cc\ub85c \uc0ac\uc6a9\ud55c\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\ubc1c\uc804 \uc6d0\ub8cc\uc758 \ub9e4\uc7a5\ub7c9\uc774 \ubb34\ud55c\ud558\uc5ec \uace0\uac08 \uc6b0\ub824\uac00 \uc5c6\ub2e4.",
          "rationale": "\ud654\ub825 \ubc1c\uc804\uc758 \uc6d0\ub8cc\uc778 \ud654\uc11d \uc5f0\ub8cc\ub294 \ub9e4\uc7a5\ub7c9\uc5d0 \ud55c\uacc4\uac00 \uc788\uc73c\uba70 \ub9e4\uc7a5 \uc9c0\uc5ed\ub3c4 \ud3b8\uc911\ub418\uc5b4 \uc788\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ub450 \ubc1c\uc804 \ubc29\uc2dd \ubaa8\ub450 \ucd5c\uc885\uc801\uc73c\ub85c \ud130\ube48\uacfc \ubc1c\uc804\uae30\ub97c \uc6c0\uc9c1\uc774\uac8c \ub9cc\ub4dc\ub294 \uacf5\ud1b5 \ubb3c\uc9c8 \ubc0f \uc791\uc6a9\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud654\ub825 \ubc1c\uc804\uc758 \uc7a5\uc810 \ubc0f \ud2b9\uc9d5\uc5d0 \ub300\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\ubc1c\uc804 \ud6a8\uc728\uc774 \ub192\uc740 \ud3b8\uc774\uace0 \ubc1c\uc804\ub7c9\uc744 \uc870\uc808\ud558\uae30 \uc26c\uc6b0\uba70 \ube44\uad50\uc801 \uc881\uc740 \ubd80\uc9c0\uc5d0\ub3c4 \uac74\uc124\ud560 \uc218 \uc788\ub2e4.",
          "rationale": "\ud654\ub825 \ubc1c\uc804\uc740 \ubc1c\uc804 \ud6a8\uc728\uc774 \ub192\uace0 \uc804\ub825 \uc218\uc694\uc5d0 \ub9de\ucdb0 \ubc1c\uc804\ub7c9\uc744 \uc870\uc808\ud558\uae30 \uc6a9\uc774\ud558\uba70 \uc881\uc740 \ubd80\uc9c0 \uac74\uc124\uc774 \uac00\ub2a5\ud558\ub2e4\ub294 \uc7a5\uc810\uc774 \uc788\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ubc1c\uc804 \uacfc\uc815\uc5d0\uc11c \ubc29\uc0ac\uc120 \uc720\ucd9c \uc704\ud5d8\uacfc \ud575\ud3d0\uae30\ubb3c\uc774 \ubc1c\uc0dd\ud558\ub294 \ub2e8\uc810\uc774 \uc788\ub2e4.",
          "rationale": "\ubc29\uc0ac\ub2a5 \uc720\ucd9c \ubc0f \ud575\ud3d0\uae30\ubb3c \ucc98\ub9ac \uad00\ub828 \ubb38\uc81c\ub294 \ud654\ub825 \ubc1c\uc804\uc774 \uc544\ub2cc \ud575\ubc1c\uc804\uc758 \ub2e8\uc810\uc774\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc774\uc0b0\ud654 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \ud575\ubc1c\uc804\uc5d0 \ube44\ud574 \uc6d4\ub4f1\ud788 \uc801\uc5b4 \uce5c\ud658\uacbd\uc801\uc774\ub2e4.",
          "rationale": "\ud654\ub825 \ubc1c\uc804\uc740 \ud654\uc11d \uc5f0\ub8cc\ub97c \uc5f0\uc18c\uc2dc\ud0a4\ubbc0\ub85c \uc628\uc2e4 \uae30\uccb4\uc778 \uc774\uc0b0\ud654 \ud0c4\uc18c\ub97c \ub9ce\uc774 \ubc30\ucd9c\ud558\uc5ec \ud575\ubc1c\uc804\uc5d0 \ube44\ud574 \uc774\uc0b0\ud654 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \ub9ce\ub2e4.",
          "isCorrect": false
        },
        {
          "text": "\uc0ac\uc6a9\ub418\ub294 \uc6d0\ub8cc\ub294 \uc9c0\uc5ed\uc801 \ud3b8\uc911 \uc5c6\uc774 \uc9c0\uad6c \uc804\uc5ed\uc5d0 \uade0\uc77c\ud558\uac8c \ub9e4\uc7a5\ub418\uc5b4 \uc788\ub2e4.",
          "rationale": "\ud654\ub825 \ubc1c\uc804\uc758 \uc6d0\ub8cc\uc778 \ud654\uc11d \uc5f0\ub8cc\ub294 \ub9e4\uc7a5 \uc9c0\uc5ed\uc774 \ud2b9\uc815 \uad6c\uc870\ub098 \uc9c0\uc5ed\uc5d0 \ud3b8\uc911\ub418\uc5b4 \uc788\ub2e4\ub294 \ud55c\uacc4\uac00 \uc788\ub2e4.",
          "isCorrect": false
        }
      ],
      "hint": "\ud654\ub825 \ubc1c\uc804\uc758 \ubd80\uc9c0 \uba74\uc801 \uc870\uac74, \ud6a8\uc728\uc131, \uadf8\ub9ac\uace0 \ucd9c\ub825 \uc870\uc808\uc758 \uc6a9\uc774\uc131\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    },
    {
      "type": "multiple_choice",
      "question": "\ud575\ubc1c\uc804\uc758 \uc7a5\uc810\uacfc \ub2e8\uc810\uc744 \ube44\uad50\ud55c \uc124\uba85\uc73c\ub85c \uc633\uc740 \uac83\uc740?",
      "answerOptions": [
        {
          "text": "\uc801\uc740 \uc591\uc758 \uc6d0\ub8cc\ub85c \ub9ce\uc740 \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc0dd\uc0b0\ud560 \uc218 \uc788\uc9c0\ub9cc, \ubc29\uc0ac\uc120\uacfc \ud575\ud3d0\uae30\ubb3c\uc774 \uc778\uccb4\uc640 \ud658\uacbd\uc5d0 \uc704\ud611\uc774 \ub41c\ub2e4.",
          "rationale": "\ud575\ubc1c\uc804\uc740 \uc6d0\ub8cc \ube44\uc6a9\uc774 \uc800\ub834\ud558\uace0 \uc801\uc740 \uc591\uc73c\ub85c \ub300\ub7c9 \uc0dd\uc0b0\uc774 \uac00\ub2a5\ud558\uc9c0\ub9cc, \ubc29\uc0ac\uc120 \ubc1c\uc0dd \ubc0f \ud575\ud3d0\uae30\ubb3c \uc720\ucd9c \uc704\ud5d8\uc774\ub77c\ub294 \uacb0\uc815\uc801 \ub2e8\uc810\uc774 \uc788\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\ud654\ub825 \ubc1c\uc804\ubcf4\ub2e4 \uc774\uc0b0\ud654 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \ub9ce\uc9c0\ub9cc, \ubbf8\uc138 \uba3c\uc9c0 \ubc1c\uc0dd\uc774 \uc801\ub2e4.",
          "rationale": "\ud575\ubc1c\uc804\uc740 \ud654\ub825 \ubc1c\uc804\ubcf4\ub2e4 \uc774\uc0b0\ud654 \ud0c4\uc18c \ubc30\ucd9c\ub7c9\uc774 \uc801\ub2e4.",
          "isCorrect": false
        },
        {
