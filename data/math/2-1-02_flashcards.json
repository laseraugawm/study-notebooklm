    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \uc720\ud55c\uc9d1\ud569 $A, B$\uc5d0 \ub300\ud558\uc5ec \ud569\uc9d1\ud569\uc758 \uc6d0\uc18c\uc758 \uac1c\uc218 $n(A \\cup B)$\ub97c \uad6c\ud558\ub294 \uc77c\ubc18\uc801\uc778 \uacf5\uc2dd\uc744 \uc368\uc2dc\uc624."
