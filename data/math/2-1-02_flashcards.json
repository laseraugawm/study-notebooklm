    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138 \uc9d1\ud569 $A, B, C$\uc5d0 \ub300\ud55c \uacb0\ud569\ubc95\uce59 \ub4f1\uc2dd \ub450 \uac00\uc9c0\ub97c \uc4f0\uc2dc\uc624."
