        {
          "text": "\uba85\uc81c\uc758 \uac00\uc815\uacfc \uacb0\ub860\uc744 \uc11c\ub85c \ubc14\uafb8\uc5b4 \uc0c8\ub85c\uc6b4 \uba85\uc81c\uac00 \ucc38\uc784\uc744 \uc785\uc99d\ud558\ub294 \ubc29\ubc95\uc774\ub2e4.",
