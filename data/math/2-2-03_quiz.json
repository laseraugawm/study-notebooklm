      ],
      "hint": "\uc6a9\uc5b4\uc758 \ub73b\uc744 \uc815\ud55c \ubb38\uc7a5\uc778\uc9c0, \uc774\ubbf8 \uc99d\uba85\ub41c \uc131\uc9c8\uc744 \ub098\ud0c0\ub0b4\ub294 \ubb38\uc7a5\uc778\uc9c0 \uad6c\ubd84\ud574 \ubcf4\uc138\uc694."
