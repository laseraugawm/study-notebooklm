{
  "title": "\uc218\ud559 \ud034\uc988",
  "questions": [
    {
      "question": "\ub2e4\uc74c \uc911 \uc218\ud559\uc5d0\uc11c \ub9d0\ud558\ub294 '\uc815\uc758(Definition)'\uc5d0 \ud574\ub2f9\ud558\ub294 \ubb38\uc7a5\uc740 \ubb34\uc5c7\uc778\uac00?",
      "answerOptions": [
        {
          "text": "\uc138 \ubcc0\uc758 \uae38\uc774\uac00 \uac19\uc740 \uc0bc\uac01\ud615\uc744 \uc815\uc0bc\uac01\ud615\uc774\ub77c\uace0 \ud55c\ub2e4.",
          "rationale": "\uc6a9\uc5b4\uc758 \ub73b\uc744 \uac04\uacb0\ud558\uace0 \uba85\ud655\ud558\uac8c \uc815\ud55c \ubb38\uc7a5\uc774\ubbc0\ub85c \uc815\uc758\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": true
        },
        {
          "text": "\uc774\ub4f1\ubcc0\uc0bc\uac01\ud615\uc758 \ub450 \ubc11\uac01\uc758 \ud06c\uae30\ub294 \uac19\ub2e4.",
          "rationale": "\ucc38\uc784\uc774 \uc99d\uba85\ub41c \uba85\uc81c \uc911 \uae30\ubcf8\uc774 \ub418\ub294 \uc131\uc9c8\uc774\ubbc0\ub85c \uc815\uc758\uac00 \uc544\ub2cc '\uc815\ub9ac'\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4.",
          "isCorrect": false
