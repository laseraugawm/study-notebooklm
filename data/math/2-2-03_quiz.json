        {
          "text": "$ab \\ge 0$",
          "rationale": "\uc591\ubcc0\uc744 \uc81c\uacf1\ud558\uc5ec \ube80 \uc2dd $2(|ab| - ab)$\uac00 $0$\uc774 \ub418\ub824\uba74 $|ab| = ab$, \uc989 $ab \\ge 0$\uc774\uc5b4\uc57c \ud569\ub2c8\ub2e4.",
          "isCorrect": true
