        {
          "text": "\uba85\uc81c\uc758 \ub300\uc6b0\uac00 \ucc38\uc784\uc744 \ubcf4\uc5ec \uc6d0\ub798\uc758 \uba85\uc81c\uac00 \ucc38\uc784\uc744 \uc99d\uba85\ud558\ub294 \ubc29\ubc95\uc774\ub2e4.",
