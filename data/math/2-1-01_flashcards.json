      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uac01 \uc6d0\uc18c\ub9c8\ub2e4 \ubd80\ubd84\uc9d1\ud569\uc5d0 \ud3ec\ud568\ub418\ub294\uc9c0 \uc5ec\ubd80(\ud3ec\ud568 $\\bigcirc$, \ubbf8\ud3ec\ud568 $\\times$) \uc120\ud0dd\uad8c\uc774 \uac01\uac01 2\uac00\uc9c0\uc529 \uc874\uc7ac\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4 ($2 \\times 2 \\times \\dots \\times 2 = 2^k$)."
