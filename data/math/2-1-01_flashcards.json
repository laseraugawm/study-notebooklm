    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\uc18c\uc758 \uac1c\uc218\uac00 $k$\uac1c\uc778 \uc9d1\ud569\uc758 \ubd80\ubd84\uc9d1\ud569\uc758 \uac1c\uc218\uac00 $2^k$\uac00 \ub418\ub294 \ub3c4\ucd9c \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
