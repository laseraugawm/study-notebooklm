        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\uc18c\uac00 0\uac1c\uc778 \uc9d1\ud569(\uacf5\uc9d1\ud569), \uc6d0\uc18c\uac00 1\uac1c\uc778 \uc9d1\ud569, \uc6d0\uc18c\uac00 2\uac1c\uc778 \uc9d1\ud569, $\\dots$ \uc21c\uc11c\ub85c \ubd84\ub958\ud558\uc5ec \uad6c\ud569\ub2c8\ub2e4."
