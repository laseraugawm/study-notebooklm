          {
            "type": "text",
            "content": "'\uc9c4\ubd80\ubd84\uc9d1\ud569'\uc758 \uc815\ud655\ud55c \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00\uc694?"
