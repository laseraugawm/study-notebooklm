    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \uc9d1\ud569 $A, B$\uac00 '\uc11c\ub85c \uac19\ub2e4 ($A = B$)'\uc758 \uc815\uc758\ub294 \ud3ec\ud568 \uad00\uacc4\ub97c \uc774\uc6a9\ud558\uc5ec \uc5b4\ub5bb\uac8c \ud45c\ud604\ub418\ub098\uc694?"
          }
