      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$A \\subseteq B$\uc774\uace0 $A \\ne B$\uc77c \ub54c, \uc9d1\ud569 $A$\ub97c \uc9d1\ud569 $B$\uc758 \uc9c4\ubd80\ubd84\uc9d1\ud569\uc774\ub77c\uace0 \ud569\ub2c8\ub2e4."
