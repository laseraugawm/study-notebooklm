    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc6d0\uc18c\uc758 \uac1c\uc218\uac00 $k$\uac1c\uc778 \uc9d1\ud569\uc758 \uc9c4\ubd80\ubd84\uc9d1\ud569\uc758 \uac1c\uc218\ub97c \uad6c\ud558\ub294 \uacf5\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00\uc694?"
