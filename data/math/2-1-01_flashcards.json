      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$A \\subseteq B$\uc774\uace0 $B \\subseteq A$\uc77c \ub54c \ub450 \uc9d1\ud569 $A, B$\ub294 \uc11c\ub85c \uac19\uc2b5\ub2c8\ub2e4 ($A = B$)."
