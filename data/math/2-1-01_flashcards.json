    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9d1\ud569 $A = \\{a, b, c\\}$\uc758 \ubd80\ubd84\uc9d1\ud569\uc758 \uac1c\uc218\ub294 \uba87 \uac1c\uc778\uac00\uc694?"
