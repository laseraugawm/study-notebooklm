    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \uc9d1\ud569 $A, B$\uac00 \uc11c\ub85c \uac19\uc9c0 \uc54a\uc74c\uc744 \uae30\ud638\ub85c \uc5b4\ub5bb\uac8c \ub098\ud0c0\ub0b4\ub098\uc694?"
