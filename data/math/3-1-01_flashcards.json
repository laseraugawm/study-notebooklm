    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\uc5ed\uacfc \uacf5\uc5ed\uc774 \uac01\uac01 \uac19\uc740 \ub450 \ud568\uc218 $f, g$\uac00 '\uc11c\ub85c \uac19\ub2e4'\uace0 \ud560 \ub54c, \ub9cc\uc871\ud574\uc57c \ud558\ub294 \ud568\uc22b\uac12 \uc870\uac74\uc740 \ubb34\uc5c7\uc778\uac00?"
