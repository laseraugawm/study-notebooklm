        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218 $f : X \\to Y$\uc5d0\uc11c \ud568\uc22b\uac12 \uc804\uccb4\uc758 \uc9d1\ud569\uc744 \ub098\ud0c0\ub0b4\ub294 \uc870\uac74\uc81c\uc2dc\ubc95 \ud45c\ud604\uacfc \uba85\uce6d\uc740 \ubb34\uc5c7\uc778\uac00?"
