    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubc18\uc9c0\ub984\uc758 \uae38\uc774\uac00 $x$\uc778 \uc6d0\uc758 \ub458\ub808\uc758 \uae38\uc774\ub97c $y$\ub77c\uace0 \ud560 \ub54c, \ub450 \ubcc0\uc218 $x, y$ \uc0ac\uc774\uc758 \uad00\uacc4\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
