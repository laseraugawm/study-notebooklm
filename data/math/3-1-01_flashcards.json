    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218 $y = f(x)$\uc758 \uadf8\ub798\ud504\ub97c \uc870\uac74\uc81c\uc2dc\ubc95 \uc9d1\ud569\uc73c\ub85c \ud45c\ud604\ud558\uba74 \uc5b4\ub5bb\uac8c \ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$\\{(x, f(x)) \\mid x \\in X\\}$"
