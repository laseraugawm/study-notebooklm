    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218 $f : X \\to Y$\uc5d0\uc11c \uce58\uc5ed\uacfc \uacf5\uc5ed $Y$ \uc0ac\uc774\uc758 \ud3ec\ud568 \uad00\uacc4\ub294 \uc5b4\ub5a0\ud55c\uac00?"
