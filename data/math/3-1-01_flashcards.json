    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub300\uc751 \uad00\uacc4\uc5d0\uc11c \uc815\uc758\uc5ed $X$\uc758 \ud55c \uc6d0\uc18c\uc5d0 \uacf5\uc5ed $Y$\uc758 \uc6d0\uc18c\uac00 2\uac1c \uc774\uc0c1 \ub300\uc751\ud55c\ub2e4\uba74, \uc774 \ub300\uc751\uc740 \ud568\uc218\uc778\uac00?"
