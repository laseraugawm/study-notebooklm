        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \ud568\uc218 $f$\uc640 $g$\uc758 \uc815\uc758\uc5ed\uacfc \uacf5\uc5ed\uc774 \uac01\uac01 \uc11c\ub85c \uac19\uc544\uc57c \ud55c\ub2e4."
