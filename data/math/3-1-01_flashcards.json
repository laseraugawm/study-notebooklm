    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \ud568\uc218 $f$\uc640 $g$\uac00 \uc11c\ub85c \uac19\uae30 \uc704\ud55c \uccab \ubc88\uc9f8 \uc870\uac74(\uc815\uc758\uc5ed\uacfc \uacf5\uc5ed \uce21\uba74)\uc740 \ubb34\uc5c7\uc778\uac00?"
