      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218\uac00 \uc544\ub2c8\ub2e4. (\uc815\uc758\uc5ed\uc758 \uac01 \uc6d0\uc18c\uc5d0\ub294 \uacf5\uc5ed\uc758 \uc6d0\uc18c\uac00 '\uc624\uc9c1 \ud558\ub098\uc529'\ub9cc \ub300\uc751\ud574\uc57c \ud568)"
