      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc815\uc758\uc5ed\uc758 \ubaa8\ub4e0 \uc6d0\uc18c $x$\uc5d0 \ub300\ud558\uc5ec $f(x) = g(x)$ \uc774\uc5b4\uc57c \ud55c\ub2e4."
