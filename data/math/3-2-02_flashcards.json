        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218 $y=\\sqrt{ax}$\uc758 \uadf8\ub798\ud504\ub97c $x$\ucd95 \ubc29\ud5a5\uc73c\ub85c $-3$\ub9cc\ud07c, $y$\ucd95 \ubc29\ud5a5\uc73c\ub85c $1$\ub9cc\ud07c \ud3c9\ud589\uc774\ub3d9\ud55c \uadf8\ub798\ud504\uac00 \uc810 $(-1, 7)$\uc744 \uc9c0\ub0a0 \ub54c, \uc0c1\uc218 $a$\uc758 \uac12\uc744 \uad6c\ud558\uc2dc\uc624."
          }
