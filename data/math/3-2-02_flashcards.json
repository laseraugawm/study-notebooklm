    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ub9ac\ud568\uc218 $y=\\sqrt{ax+b}$\uc758 \uadf8\ub798\ud504\uac00 $y$\uc808\ud3b8 $(0, 2)$\ub97c \uac00\uc9c4\ub2e4\uace0 \ud560 \ub54c, \uc0c1\uc218 $b$\uc758 \uac12\uc740 \uc5bc\ub9c8\uc778\uac00?"
