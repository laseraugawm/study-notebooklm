    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ub9ac\ud568\uc218 $y=\\sqrt{ax+4}$\uc758 \uadf8\ub798\ud504\uac00 \uc810 $(4, 5)$\ub97c \uc9c0\ub0a0 \ub54c, \uc0c1\uc218 $a$\uc758 \uac12\uc744 \uad6c\ud558\uc2dc\uc624."
