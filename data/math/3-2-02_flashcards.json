    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc9c0\uc9c4 \ud574\uc77c\uc758 \uc804\ud30c \uc18d\ub825 $v\\text{ m/s}$\uc640 \uc218\uc2ec $h\\text{ m}$ \uc0ac\uc774\uc758 \uad00\uacc4\uc2dd $h=\\frac{v^2}{9.8}$\uc5d0\uc11c $v$\ub97c \uc218\uc2ec $x$\uc5d0 \ub300\ud55c \ubb34\ub9ac\uc2dd\uc73c\ub85c \ub098\ud0c0\ub0b4\uc2dc\uc624."
          }
