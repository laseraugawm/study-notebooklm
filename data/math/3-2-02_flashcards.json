    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ub9ac\ud568\uc218 $y=\\sqrt{ax}\\ (a \\ne 0)$\uc5d0\uc11c \uc5ed\ud568\uc218\ub97c \uad6c\ud560 \ub54c, $x$\uc640 $y$\ub97c \ubc14\uafb8\uae30 \uc804 $x$\ub97c $y$\uc5d0 \ub300\ud558\uc5ec \ub098\ud0c0\ub0b8 \uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
