        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud568\uc218 $y=\\sqrt{ax}$\uc758 \uadf8\ub798\ud504\ub97c $x$\ucd95\uc758 \ubc29\ud5a5\uc73c\ub85c $-3$\ub9cc\ud07c, $y$\ucd95\uc758 \ubc29\ud5a5\uc73c\ub85c $1$\ub9cc\ud07c \ud3c9\ud589\uc774\ub3d9\ud55c \ud568\uc218\uc758 \uc2dd\uc744 \uc791\uc131\ud558\uc2dc\uc624."
