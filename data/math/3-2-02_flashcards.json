        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubb34\ub9ac\ud568\uc218 $y=\\sqrt{-2x+8}+3$\uc758 \uc815\uc758\uc5ed\uacfc \uce58\uc5ed\uc744 \uad6c\ud558\uc2dc\uc624."
