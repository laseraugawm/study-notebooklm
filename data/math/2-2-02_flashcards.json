      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$p \\to q$ ($p \\Longrightarrow r$\uc774\uace0 $r \\Longrightarrow q$\uc774\ubbc0\ub85c $p \\Longrightarrow q$)"
