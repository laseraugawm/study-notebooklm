          {
            "type": "text",
            "content": "\ub450 \uc804\uc81c\ub85c\ubd80\ud130 \uacb0\ub860\uc744 \uc774\ub04c\uc5b4 \ub0b4\ub294 \ub17c\ub9ac \uc804\uac1c \ubc29\uc2dd\uc744 \ubb34\uc5c7\uc774\ub77c \ud558\ub294\uac00?"
