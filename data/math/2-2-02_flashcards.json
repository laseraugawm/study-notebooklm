    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138 \uc870\uac74 $p, q, r$\uc5d0 \ub300\ud558\uc5ec $p \\Longrightarrow r$\uc774\uace0 $r \\Longrightarrow q$\uc77c \ub54c, \uba85\uc81c $p \\to q$\uc758 \ub300\uc6b0\ub85c \ucc38\uc778 \uac83\uc740?"
