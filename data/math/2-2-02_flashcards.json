          {
            "type": "text",
            "content": "\uba85\uc81c '$a^2 > 0$\uc774\uba74 $a > 0$\uc774\ub2e4'\uc758 \ucc38, \uac70\uc9d3\uc744 \ud310\ubcc4\ud558\uc2dc\uc624."
