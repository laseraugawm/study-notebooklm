        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc790\uc74c\uc774 \uc801\ud78c \uce74\ub4dc\uc640 \ud640\uc218\uac00 \uc801\ud78c \uce74\ub4dc (\ub300\uc6b0: '\ud640\uc218\uac00 \uc801\ud600 \uc788\uc73c\uba74 \uc790\uc74c\uc774 \uc544\ub2c8\ub2e4(\ubaa8\uc74c\uc774\ub2e4)'\ub97c \ud655\uc778\ud574\uc57c \ud558\ubbc0\ub85c)"
