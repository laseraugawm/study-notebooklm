{
  "title": "\uc720\ub9ac\uc2dd \ud50c\ub798\uc2dc\uce74\ub4dc",
  "cards": [
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\ub9ac\uc2dd\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub450 \ub2e4\ud56d\uc2dd $A, B(B \\ne 0)$\uc5d0 \ub300\ud558\uc5ec $\\frac{A}{B}$ \uaf34\ub85c \ub098\ud0c0\ub0b4\uc5b4\uc9c0\ub294 \uc2dd\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ub2e4\ud56d\uc2dd\uc740 \uc720\ub9ac\uc2dd\uc5d0 \ud3ec\ud568\ub418\ub294\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud3ec\ud568\ub41c\ub2e4. $B$\uac00 \uc0c1\uc218\uc778 \uacbd\uc6b0 $\\frac{A}{B}$\ub294 \ub2e4\ud56d\uc2dd\uc774 \ub418\ubbc0\ub85c \ub2e4\ud56d\uc2dd\ub3c4 \uc720\ub9ac\uc2dd\uc758 \uc77c\uc885\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd $\\frac{x^2-4}{3}$\ub294 \ub2e4\ud56d\uc2dd\uc778\uac00, \ub2e4\ud56d\uc2dd\uc774 \uc544\ub2cc \uc720\ub9ac\uc2dd\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ubaa8\uac00 \uc0c1\uc218\uac00 \ub418\ubbc0\ub85c \ub2e4\ud56d\uc2dd(\ub3d9\uc2dc\uc5d0 \uc720\ub9ac\uc2dd)\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc2dd $\\frac{3}{x-1}$\uc740 \ub2e4\ud56d\uc2dd\uc778\uac00, \ub2e4\ud56d\uc2dd\uc774 \uc544\ub2cc \uc720\ub9ac\uc2dd\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ubd84\ubaa8\uc5d0 \ubcc0\uc218 $x$\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc73c\ubbc0\ub85c \ub2e4\ud56d\uc2dd\uc774 \uc544\ub2cc \uc720\ub9ac\uc2dd\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138 \ub2e4\ud56d\uc2dd $A, B, C$\uc5d0 \ub300\ud558\uc5ec \uc720\ub9ac\uc2dd\uc758 \uacf1\uc148\uc5d0 \uad00\ud55c \uae30\ubcf8 \uc131\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$\\frac{A}{B} = \\frac{A \\cdot C}{B \\cdot C}$ (\ub2e8, $B C \\ne 0$)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc138 \ub2e4\ud56d\uc2dd $A, B, C$\uc5d0 \ub300\ud558\uc5ec \ubd84\ubaa8\uac00 \uac19\uc740 \uc720\ub9ac\uc2dd\uc758 \ub367\uc148 \uc131\uc9c8\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$\\frac{A}{C} + \\frac{B}{C} = \\frac{A+B}{C}$ (\ub2e8, $C \\ne 0$)"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc774\uc9d1\ud2b8 \ubd84\uc218(Egyptian fraction)\uc758 \uc815\uc758\ub294 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc5b4\ub5a4 \ubd84\uc218\ub97c \ubd84\uc790\uac00 1\uc778 \ubd84\uc218(\ub2e8\uc704\ubd84\uc218)\ub4e4\uc758 \ud569\uc73c\ub85c \ub098\ud0c0\ub0b8 \uac83\uc774\ub2e4."
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\ud558\ub098\uc758 \ubd84\uc218\ub97c \uc774\uc9d1\ud2b8 \ubd84\uc218\ub85c \ubcc0\ud615\ud560 \ub54c \uc774\uc6a9\ud558\ub294 $\\frac{1}{x}$\uc758 \ud56d\ub4f1\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00?"
          }
        ]
      },
      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "$\\frac{1}{x} = \\frac{1}{x+1} + \\frac{1}{x(x+1)}$"
          }
        ]
      }
    },
    {
      "front": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\ub9ac\uc2dd\uc758 \ub367\uc148\uacfc \ube84\uc148\uc744 \uacc4\uc0b0\ud560 \ub54c\uc758 \uae30\ubcf8 \uc6d0\uce59\uc740 \ubb34\uc5c7\uc778\uac00?"
