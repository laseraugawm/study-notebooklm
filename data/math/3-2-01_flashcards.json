      "back": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "\uc720\ub9ac\uc218\uc5d0\uc11c\uc640 \ub9c8\ucc2c\uac00\uc9c0\ub85c \ubd84\ubaa8\ub97c \ud1b5\ubd84\ud558\uc5ec \ubd84\ubaa8\ub97c \uac19\uac8c \ud55c \ud6c4 \uacc4\uc0b0\ud55c\ub2e4."
